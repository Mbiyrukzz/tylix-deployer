PORT=
# 32+ random characters, required in production: openssl rand -base64 48
AUTH_SECRET=
DATABASE_DRIVER=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=typloy

# Set to true only when this app runs behind a reverse proxy you control
# (nginx, Caddy, a load balancer). Leave false otherwise, because clients
# could fake their IP address through the X-Forwarded-For header.
TRUST_PROXY=

# Set to true only if you're developing @tylix/compiler itself
TYLIX_HOT_RELOAD_COMPILER=

# 32-byte base64 key that encrypts stored SSH keys and env vars.
# Generate with: openssl rand -base64 32
APP_KEY=

# Flux admins: the people who run this install. They get Admin -> Users in
# the sidebar and can sign in as any user (not another Flux admin) to fix
# something on their behalf. Comma separated; the account's email must be
# verified, and two-factor must be on to sign in as anyone.
FLUX_ADMIN_EMAILS=

# Public address of the app: the base of Google/GitHub sign-in callbacks.
APP_URL=http://localhost:3000

# Passkeys work only on this exact origin (scheme + host + port), so APP_URL
# must be the address people open. PASSKEY_ORIGIN overrides it if needed.
# PASSKEY_ORIGIN=https://flux.example.com

# Optional "Continue with Google / GitHub" on the login page. The buttons
# appear only for providers that are filled in.
# callback: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# callback: <APP_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Seller details printed on invoice PDFs (app/documents/InvoicePdf.ts).
# Separate address lines with "|".
INVOICE_COMPANY_NAME="Tylix Deploy"
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_EMAIL=
INVOICE_TAX_ID=

# Logs: console plus daily files in storage/logs (deploys.log and
# provisioning.log get their own). LOG_STACK=console turns files off.
LOG_CHANNEL=stack
LOG_STACK=console,daily
LOG_DAILY_DAYS=14
