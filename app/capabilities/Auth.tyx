capability Auth

state
  user: null
  loading: true

action
  async login(email, password, code, sendSms) {
    const result = await useApi("/api/login", { method: "POST", body: { email: email, password: password, code: code or "", send_sms: Boolean(sendSms) } })
    if result.ok {
      this.user = result.data.user or result.data
    }
    return result
  }

  async logout() {
    await useApi("/api/auth/logout", { method: "POST" })
    this.user = null
    window.location.href = "/"
  }

  // True while a Flux admin is signed in as this user (Admin → Users).
  impersonating() {
    return Boolean(this.user and this.user.impersonation)
  }

  // Ends the "sign in as" session and goes back to the admin's own account.
  // A full page load, so nothing of the user's account stays on screen.
  async stopImpersonating() {
    const result = await useApi("/api/admin/impersonation/stop", { method: "POST" })
    const to = result.ok and result.data and result.data.redirect ? String(result.data.redirect) : "/login"
    const flux = Reflect.get(window, "__flux")
    if flux and flux.hard {
      flux.hard(to)
    } else {
      window.location.replace(to)
    }
  }

init
  async {
    const me = await useApi("/api/me")
    if me.ok {
      this.user = me.data
    } else {
      // Pages anyone can open signed out. Everything else sends them to sign in.
      const path = window.location.pathname
      const publicPages = ["/", "/login", "/register", "/forgot-password", "/reset-password", "/pricing", "/status", "/changelog", "/terms", "/privacy", "/docs"]
      const publicSections = ["/docs/", "/accept-invite"]
      const isPublic = publicPages.includes(path) or publicSections.some((p) => path.startsWith(p))
      if not isPublic {
        // Come back to this page after signing in (see Login.nextUrl).
        window.location.replace("/login?next=" + encodeURIComponent(path + window.location.search))
        await new Promise(() => setTimeout(() => 0, 60000))
      }
    }
    this.loading = false
  }