capability Registrars

state
data: []
loading: false

action
   async load() {
this.loading = true
const result = await useApi("/api/registrars")
if result.ok and Array.isArray(result.data) {
this.data = result.data
} else {
this.data = []
}
this.loading = false
}

add(registrar) {
this.data = [registrar, ...this.data]
}

async replace(registrar) {
await this.load()
}

async remove(id) {
const result = await useApi("/api/registrars/" + id, { method: "DELETE" })
if result.ok {
await this.load()
}
return result
}

init
  async {
await this.load()
}
