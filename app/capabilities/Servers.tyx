capability Servers

state
  data: []
  loading: false
  siteServerIds: []

action
  async load() {
    this.loading = true
    const result = await useApi("/api/servers")
    this.data = result.ok and Array.isArray(result.data) ? result.data : []
    this.loading = false
  }

  async loadSites() {
    const result = await useApi("/api/sites")
    this.siteServerIds = result.ok and Array.isArray(result.data) ? result.data.map((x) => x.server_id) : []
  }

  add(server) {
    this.data = [server, ...this.data]
  }

  async replace(server) {
    await this.load()
  }

  async remove(id) {
    const result = await useApi("/api/servers/" + id, { method: "DELETE" })
    if result.ok {
      await this.load()
    }
    return result
  }

init
  async {
    await this.load()
  }