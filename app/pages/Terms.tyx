page Terms

title "Terms of Service"

import { IconCode, IconCloud, IconArchive, IconCreditCard, IconMail, IconArrowRight } from "tylix-icons"

// The binding text is the numbered sections. "The short version" only
// restates them in plain words and links to the clause each comes from;
// keep it in step when a section changes. The section list for
// "On this page" lives in components/LegalToc.tyx.

state
  effective: "26 October 2026"

template
<div class="min-h-[calc(100vh-4rem)] bg-page transition-colors">

  <LegalHero kind="terms" title="Terms of Service" effective="{{ effective }}" readTime="About 14 min read" lead="The agreement between you and Ashmif Office Solutions Ltd for using Tylix Flux: what we provide, what you're responsible for, and how billing, cancellation and disputes work." />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-10 sm:py-14">

    <section aria-labelledby="short-version" class="mb-12 sm:mb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
        <h2 id="short-version" class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">The short version</h2>
        <p class="text-xs text-zinc-500">A plain summary. The full terms below are what apply.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="#content" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconCode class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Your content stays yours</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Code, databases and domains remain yours. We only use them to run the service for you.</p>
        </a>
        <a href="#infrastructure" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconCloud class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Provider costs are separate</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Servers and domains are billed to you by your cloud provider and registrar, not by your plan.</p>
        </a>
        <a href="#backups" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconArchive class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Keep your own backups</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Flux is not a backup service, and deleting a server or database is permanent.</p>
        </a>
        <a href="#billing" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconCreditCard class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Cancel any time</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Plans renew monthly. Cancelling keeps access until the end of the period you paid for.</p>
        </a>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)] gap-6 lg:gap-14">

      <LegalToc kind="terms" />

      <article data-legal class="min-w-0 max-w-3xl break-words">
        <div class="legal-prose">

        <section id="agreement" class="legal-section">
          <h2><span class="legal-num">01</span><span>Agreement<a href="#agreement" class="legal-anchor" aria-label="Link to Agreement">#</a></span></h2>
          <p>These Terms of Service ("Terms") are a contract between you and Ashmif Office Solutions Ltd, a company registered in Kenya ("we", "us", "Tylix"). They govern your access to and use of Tylix Flux, including the website, dashboard, APIs and everything we provide through them (the "Service").</p>
          <p>By creating an account, ticking the agreement box, or using the Service, you accept these Terms and our <a href="/privacy">Privacy Policy</a>. If you use the Service for a company or team, you confirm you have authority to bind it, and "you" includes that organisation. You must be at least 18 years old.</p>
        </section>

        <section id="service" class="legal-section">
          <h2><span class="legal-num">02</span><span>The service<a href="#service" class="legal-anchor" aria-label="Link to The service">#</a></span></h2>
          <p>Tylix Flux is a server management and deployment platform. Depending on your plan, you can:</p>
          <ul>
            <li>provision servers at connected cloud providers, or connect your own servers over SSH;</li>
            <li>create sites (Tylix, Laravel, PHP, Node.js, WordPress, MERN, Angular and others), connect Git repositories, and deploy them with editable scripts and environment variables;</li>
            <li>manage databases and database users, issue SSL certificates, view server statistics and logs, reboot servers and open a web terminal;</li>
            <li>connect domain registrar accounts, and invite team members to work alongside you.</li>
          </ul>
          <p>The Service acts on your servers and accounts with the access you give it. It does what you or your team members tell it to do.</p>
        </section>

        <section id="accounts" class="legal-section">
          <h2><span class="legal-num">03</span><span>Accounts<a href="#accounts" class="legal-anchor" aria-label="Link to Accounts">#</a></span></h2>
          <ul>
            <li>Give us accurate information and keep it up to date. You must verify your email address before you can log in.</li>
            <li>Keep your password confidential. You are responsible for everything done through your account until you tell us it has been compromised.</li>
            <li>Tell us promptly at the address in section 20 if you suspect unauthorised access.</li>
            <li>One person per login. Do not share credentials; invite teammates instead.</li>
          </ul>
        </section>

        <section id="teams" class="legal-section">
          <h2><span class="legal-num">04</span><span>Teams and roles<a href="#teams" class="legal-anchor" aria-label="Link to Teams and roles">#</a></span></h2>
          <p>Servers, sites, databases and connections belong to a team, not to an individual. Team members with the admin role can create, change and delete resources, and can view database passwords. Members with the member role can view. The team owner and admins are responsible for who they invite and what roles they assign, and for everything their team members do in the Service. When someone leaves a team, they lose access to its resources, but anything they already did remains in effect.</p>
        </section>

        <section id="billing" class="legal-section">
          <h2><span class="legal-num">05</span><span>Plans, billing and renewal<a href="#billing" class="legal-anchor" aria-label="Link to Plans, billing and renewal">#</a></span></h2>
          <ul>
            <li><strong>Plans.</strong> We offer paid plans (currently Personal, Pro and Business) with limits on team members, servers, sites and connections. Current prices and limits are on the <a href="/pricing">pricing page</a>.</li>
            <li><strong>Currency.</strong> Prices are shown in US dollars and charged in Kenyan shillings (KES) at checkout. The amount in KES may vary with exchange rates, and your bank or card issuer may add its own fees.</li>
            <li><strong>Payment processing.</strong> Payments are handled by Paystack. We do not see or store your full card details.</li>
            <li><strong>Renewal.</strong> Subscriptions renew automatically each month until you cancel. By subscribing you authorise us and Paystack to charge you each period.</li>
            <li><strong>Cancelling.</strong> You can cancel at any time from your billing page. Cancellation takes effect at the end of the period you have paid for. We do not refund partial periods, except where the law requires it or where we say otherwise in writing.</li>
            <li><strong>Price changes.</strong> We may change prices or plan limits. We will give you at least 30 days' notice before a change applies to your subscription, and you may cancel before it does.</li>
            <li><strong>Failed payments.</strong> If a payment fails we may retry it, and your subscription may end if it keeps failing. Section 6 explains what happens then.</li>
            <li><strong>Taxes.</strong> Prices exclude any taxes that apply, which are added where required.</li>
          </ul>
        </section>

        <section id="viewonly" class="legal-section">
          <h2><span class="legal-num">06</span><span>View only mode<a href="#viewonly" class="legal-anchor" aria-label="Link to View only mode">#</a></span></h2>
          <p>When a team's subscription ends or lapses, the team becomes view only. While view only, nothing can be created, edited, deployed, rebooted or deleted through the Service, and deletion is blocked as well. You can still log in, read your data, and use the billing pages to pay and restore full access.</p>
          <p>View only mode does not switch off your servers or sites. They keep running at your cloud provider, and you remain responsible for any charges that provider makes. If a team stays unpaid for a long time, we may delete its data from the Service after giving notice (see section 14).</p>
        </section>

        <section id="infrastructure" class="legal-section">
          <h2><span class="legal-num">07</span><span>Your infrastructure and connected accounts<a href="#infrastructure" class="legal-anchor" aria-label="Link to Your infrastructure and connected accounts">#</a></span></h2>
          <p>The Service works through accounts and machines that you control. You acknowledge and agree that:</p>
          <ul>
            <li><strong>Provider accounts are yours.</strong> You connect cloud providers (for example Linode, Hetzner, DigitalOcean, Vultr or UpCloud), domain registrars and source control accounts by giving us API tokens or authorising access. You must have the right to do so, and you agree to the provider's own terms.</li>
            <li><strong>Provider costs are yours.</strong> Servers, snapshots, bandwidth, domains and anything else created at a provider are billed by that provider to you. Our subscription fee does not include them. A server created through the Service continues to cost money until it is deleted at the provider.</li>
            <li><strong>Server access.</strong> To manage a server we store its SSH credentials, encrypted, and connect to it over SSH. We run commands on it only to do what you or your team ask (such as setting up software, deploying, creating databases, issuing certificates or rebooting).</li>
            <li><strong>Actions can be destructive.</strong> Deleting a server, site or database, resetting a password, running a deployment script or rebooting can cause downtime or permanent data loss. Deployment scripts and terminal commands run with the privileges of the SSH user you provide. You are responsible for what you run and what your team members run.</li>
            <li><strong>Keep access working.</strong> Provisioning and management can fail if tokens expire, a provider has an outage, a firewall blocks us, or the SSH user lacks the needed permissions. We are not responsible for failures caused by your configuration or by a provider.</li>
            <li><strong>Revoking access.</strong> You can remove a connection or server at any time. Revoking tokens at the provider also stops our access.</li>
          </ul>
        </section>

        <section id="content" class="legal-section">
          <h2><span class="legal-num">08</span><span>Your content<a href="#content" class="legal-anchor" aria-label="Link to Your content">#</a></span></h2>
          <p>"Your content" means your code, repositories, environment variables, deployment scripts, databases, files, domains and anything else you deploy, store or process through the Service. You keep all rights in it. You give us a limited licence to host, copy, transmit and process it only as needed to run the Service for you and to meet our legal obligations. You are responsible for your content, for having the rights to it, and for the lawfulness of the sites and applications you run.</p>
          <p>Do not put secrets in places where they should not be. Environment variables and database passwords that you save in the Service are stored encrypted, but anyone with the right role on your team can use or view them.</p>
        </section>

        <section id="acceptable" class="legal-section">
          <h2><span class="legal-num">09</span><span>Acceptable use<a href="#acceptable" class="legal-anchor" aria-label="Link to Acceptable use">#</a></span></h2>
          <p>You agree not to use the Service, or let anyone else use it, to:</p>
          <ul>
            <li>break any law, or host content that is unlawful, infringing, fraudulent, defamatory or that exploits children;</li>
            <li>distribute malware, run phishing sites, send spam, or attack, scan or probe systems you do not own or have permission to test;</li>
            <li>mine cryptocurrency, run open proxies or botnets, or launch denial of service attacks;</li>
            <li>access servers or accounts you are not authorised to use, or use credentials that are not yours;</li>
            <li>interfere with, overload or reverse engineer the Service, bypass plan limits, or circumvent view only mode or security controls;</li>
            <li>resell or white-label the Service without our written agreement;</li>
            <li>use automated means to create accounts or flood our systems or other people's inboxes.</li>
          </ul>
          <p>Your cloud provider's acceptable use rules also apply to anything you run on its infrastructure.</p>
        </section>

        <section id="backups" class="legal-section">
          <h2><span class="legal-num">10</span><span>Backups and your data<a href="#backups" class="legal-anchor" aria-label="Link to Backups and your data">#</a></span></h2>
          <p>Tylix Flux is not a backup service. Unless we expressly state otherwise for a specific feature, we do not back up the contents of your servers, sites or databases. Keep your own backups of anything you cannot afford to lose. Deleting a server or database through the Service is permanent.</p>
        </section>

        <section id="availability" class="legal-section">
          <h2><span class="legal-num">11</span><span>Availability and changes to the service<a href="#availability" class="legal-anchor" aria-label="Link to Availability and changes to the service">#</a></span></h2>
          <p>We work to keep the Service available, but we do not promise it will be uninterrupted or error free. We may carry out maintenance, and the Service may be affected by providers, networks and other things outside our control. We continue to develop the Service and may add, change or remove features, supported frameworks or providers. If we remove a feature you pay for in a way that materially harms you, we will tell you in advance where we reasonably can. Server statistics and status shown in the dashboard are informational and may be delayed or inaccurate.</p>
        </section>

        <section id="thirdparty" class="legal-section">
          <h2><span class="legal-num">12</span><span>Third-party services<a href="#thirdparty" class="legal-anchor" aria-label="Link to Third-party services">#</a></span></h2>
          <p>The Service connects to third-party services such as Paystack, cloud providers, domain registrars, Git hosting providers and Let's Encrypt. They are not under our control, and your use of them is governed by their own terms and privacy policies. We are not responsible for their availability, pricing, conduct or changes to their APIs.</p>
        </section>

        <section id="ip" class="legal-section">
          <h2><span class="legal-num">13</span><span>Intellectual property<a href="#ip" class="legal-anchor" aria-label="Link to Intellectual property">#</a></span></h2>
          <p>We and our licensors own the Service, including its software, design, names and logos. Subject to these Terms, we grant you a limited, non-exclusive, non-transferable, revocable right to use the Service for your own business or personal purposes while you have an account. Nothing in these Terms transfers any of our intellectual property to you. If you send us feedback or suggestions, we may use them without obligation to you. The open source frameworks and packages that the Service builds on stay under their own licences.</p>
        </section>

        <section id="termination" class="legal-section">
          <h2><span class="legal-num">14</span><span>Suspension and termination<a href="#termination" class="legal-anchor" aria-label="Link to Suspension and termination">#</a></span></h2>
          <ul>
            <li><strong>By you.</strong> You can stop using the Service and close your account at any time. Remove your servers and connections first if you want us to stop accessing them. Closing your account does not delete anything at your cloud providers.</li>
            <li><strong>By us.</strong> We may suspend or terminate access, with or without notice, if you breach these Terms, if your use puts the Service or other people at risk, if we are required to by law or a provider, or if payment fails and stays unpaid. Where it is reasonable and lawful to do so, we will tell you why and give you a chance to fix the problem.</li>
            <li><strong>Data after termination.</strong> After termination or a long period of non-payment, we may delete your account data, including stored connections, keys and logs, on 30 days' notice to your account email. Some information may be kept longer where the law requires it, as described in the Privacy Policy.</li>
            <li><strong>What survives.</strong> Sections that by their nature should continue (including payment obligations, intellectual property, disclaimers, liability, indemnity and governing law) survive termination.</li>
          </ul>
        </section>

        <section id="disclaimer" class="legal-section">
          <h2><span class="legal-num">15</span><span>Disclaimers<a href="#disclaimer" class="legal-anchor" aria-label="Link to Disclaimers">#</a></span></h2>
          <p>To the fullest extent the law allows, the Service is provided "as is" and "as available", without warranties of any kind, whether express or implied, including warranties of merchantability, fitness for a particular purpose, accuracy and non-infringement. We do not warrant that deployments, provisioning, SSL issuance or other operations will always succeed, that the Service will meet your requirements, or that it will be secure or free of errors or harmful components. Nothing in these Terms limits rights you have under consumer protection law that cannot be excluded.</p>
        </section>

        <section id="liability" class="legal-section">
          <h2><span class="legal-num">16</span><span>Limitation of liability<a href="#liability" class="legal-anchor" aria-label="Link to Limitation of liability">#</a></span></h2>
          <p>To the fullest extent the law allows, we are not liable for any indirect, incidental, special, consequential or punitive damages, or for loss of profits, revenue, data, goodwill or business, arising from or related to the Service, even if we were told they were possible. This includes losses from downtime, failed or partial deployments, deleted servers or databases, provider charges, expired certificates, or actions taken by your team members.</p>
          <p>Our total liability for all claims relating to the Service in any 12 month period is limited to the amount you paid us for the Service in the 12 months before the event that gave rise to the claim. Nothing in these Terms limits liability that cannot be limited by law, such as liability for fraud or for death or personal injury caused by negligence.</p>
        </section>

        <section id="indemnity" class="legal-section">
          <h2><span class="legal-num">17</span><span>Indemnity<a href="#indemnity" class="legal-anchor" aria-label="Link to Indemnity">#</a></span></h2>
          <p>You agree to defend and indemnify us, our directors, employees and contractors against claims, losses and costs (including reasonable legal fees) arising from your content, the sites and applications you run, your breach of these Terms or the law, or your infringement of anyone's rights.</p>
        </section>

        <section id="changes" class="legal-section">
          <h2><span class="legal-num">18</span><span>Changes to these Terms<a href="#changes" class="legal-anchor" aria-label="Link to Changes to these Terms">#</a></span></h2>
          <p>We may update these Terms from time to time. When we make a material change we will update the effective date above and notify you by email or in the dashboard at least 14 days before it takes effect, unless the change is needed sooner for legal or security reasons. If you keep using the Service after a change takes effect, you accept the updated Terms. If you do not agree, you should stop using the Service and cancel your subscription.</p>
        </section>

        <section id="law" class="legal-section">
          <h2><span class="legal-num">19</span><span>Governing law and disputes<a href="#law" class="legal-anchor" aria-label="Link to Governing law and disputes">#</a></span></h2>
          <p>These Terms are governed by the laws of Kenya. Please contact us first so we can try to resolve any dispute informally. If we cannot, the courts of Kenya, sitting in Mombasa have exclusive jurisdiction, except that either of us may seek urgent relief from any competent court. If any part of these Terms is found unenforceable, the rest stays in effect. Our failure to enforce a provision is not a waiver. You may not transfer your rights under these Terms without our consent; we may transfer ours as part of a merger, acquisition or sale of the business. These Terms and the Privacy Policy are the whole agreement between us about the Service.</p>
        </section>

        <section id="contact" class="legal-section">
          <h2><span class="legal-num">20</span><span>Contact<a href="#contact" class="legal-anchor" aria-label="Link to Contact">#</a></span></h2>
          <p>Ashmif Office Solutions Ltd, Mombasa, Kenya. Website: <a href="https://ashmif.com" target="_blank" rel="noopener">ashmif.com</a>. Questions about these Terms: <a href="mailto:legal@tylix.dev">legal@tylix.dev</a>.</p>
        </section>

        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 legal-noprint">
          <a href="mailto:legal@tylix.dev" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
            <IconMail class="w-5 h-5 text-zinc-400 mb-3" />
            <p class="mb-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Questions about these terms?</p>
            <p class="text-[13px] leading-relaxed text-zinc-500">Write to legal@tylix.dev and a person will reply.</p>
          </a>
          <a href="/privacy" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
            <IconArrowRight class="w-5 h-5 text-zinc-400 mb-3 group-hover:translate-x-0.5 transition-transform" />
            <p class="mb-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Read the Privacy Policy</p>
            <p class="text-[13px] leading-relaxed text-zinc-500">What we collect, why, and the rights you have over it.</p>
          </a>
        </div>

      </article>
    </div>
  </div>
</div>
