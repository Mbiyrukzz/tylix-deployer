component RegistrarSidebar

import { IconGlobe, IconCalendar, IconCreditCard, IconMail, IconArrowLeft } from "tylix-icons"

props
  active: String
  registrarId: String

state
  collapsed: false
  asideCls: "flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-stone-200/40 dark:bg-white/[0.03] p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200 lg:w-[230px] lg:p-5"
  topCls: "hidden lg:flex items-center mb-1 justify-between px-1"
  titleCls: "text-slate-500 text-[11px] font-semibold uppercase tracking-wider"
  onCls: "relative shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl bg-panel border border-line shadow-sm dark:shadow-none text-slate-900 dark:text-slate-100 text-sm font-medium"
  offCls: "group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:bg-stone-200/60 dark:hover:bg-white/[0.05] hover:text-slate-900 dark:hover:text-slate-200 transition-colors"
  footCls: "shrink-0 flex flex-col ml-auto lg:ml-0 lg:mt-auto lg:pt-3 lg:border-t border-line"
  labelCls: ""
  chevCls: "w-4 h-4 transition-transform"

action
  applyLayout() {
    const asideBase = "flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-stone-200/40 dark:bg-white/[0.03] p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200"
    const on = "relative shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl bg-panel border border-line shadow-sm dark:shadow-none text-slate-900 dark:text-slate-100 text-sm font-medium"
    const off = "group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:bg-stone-200/60 dark:hover:bg-white/[0.05] hover:text-slate-900 dark:hover:text-slate-200 transition-colors"
    const foot = "shrink-0 flex flex-col ml-auto lg:ml-0 lg:mt-auto lg:pt-3 lg:border-t border-line"
    const title = "text-slate-500 text-[11px] font-semibold uppercase tracking-wider"

    if this.collapsed {
      this.asideCls = asideBase + " lg:w-16 lg:p-2.5"
      this.topCls = "hidden lg:flex items-center mb-1 justify-center"
      this.titleCls = "hidden"
      this.onCls = on + " lg:justify-center"
      this.offCls = off + " lg:justify-center"
      this.footCls = foot
      this.labelCls = "lg:hidden"
      this.chevCls = "w-4 h-4 transition-transform rotate-180"
    } else {
      this.asideCls = asideBase + " lg:w-[230px] lg:p-5"
      this.topCls = "hidden lg:flex items-center mb-1 justify-between px-1"
      this.titleCls = title
      this.onCls = on
      this.offCls = off
      this.footCls = foot
      this.labelCls = ""
      this.chevCls = "w-4 h-4 transition-transform"
    }
  }

  toggle() {
    this.collapsed = not this.collapsed
    this.applyLayout()
    window.localStorage.setItem("tylix-registrar-sidebar", this.collapsed ? "1" : "0")
  }

onMount
  async {
    const saved = window.localStorage.getItem("tylix-registrar-sidebar")
    if saved is "1" {
      this.collapsed = true
      this.applyLayout()
    }
  }

template
<aside class="{{ asideCls }}">

  <div class="{{ topCls }}">
    <p class="{{ titleCls }}">This provider</p>
    <button onclick="{{ toggle() }}" title="Collapse or expand sidebar" aria-label="Collapse or expand sidebar" class="flex items-center justify-center w-6 h-6 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="{{ chevCls }}">
        <path d="M12 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

{{#if active is "domains"}}
  <a href="{{ '/registrars/registrar-domains?id=' + registrarId }}" title="Domains" aria-current="page" class="{{ onCls }}">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
    <IconGlobe class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Domains</span>
  </a>
{{/if}}
{{#if active is not "domains"}}
  <a href="{{ '/registrars/registrar-domains?id=' + registrarId }}" title="Domains" class="{{ offCls }}">
    <IconGlobe class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Domains</span>
  </a>
{{/if}}

{{#if active is "renewals"}}
  <a href="{{ '/registrars/registrar-renewals?id=' + registrarId }}" title="Renewals" aria-current="page" class="{{ onCls }}">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
    <IconCalendar class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Renewals</span>
  </a>
{{/if}}
{{#if active is not "renewals"}}
  <a href="{{ '/registrars/registrar-renewals?id=' + registrarId }}" title="Renewals" class="{{ offCls }}">
    <IconCalendar class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Renewals</span>
  </a>
{{/if}}

{{#if active is "billing"}}
  <a href="{{ '/registrars/registrar-billing?id=' + registrarId }}" title="Billing" aria-current="page" class="{{ onCls }}">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
    <IconCreditCard class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Billing</span>
  </a>
{{/if}}
{{#if active is not "billing"}}
  <a href="{{ '/registrars/registrar-billing?id=' + registrarId }}" title="Billing" class="{{ offCls }}">
    <IconCreditCard class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Billing</span>
  </a>
{{/if}}

{{#if active is "email"}}
  <a href="{{ '/registrars/registrar-email?id=' + registrarId }}" title="Email forwarding" aria-current="page" class="{{ onCls }}">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
    <IconMail class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Email forwarding</span>
  </a>
{{/if}}
{{#if active is not "email"}}
  <a href="{{ '/registrars/registrar-email?id=' + registrarId }}" title="Email forwarding" class="{{ offCls }}">
    <IconMail class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Email forwarding</span>
  </a>
{{/if}}

  <div class="{{ footCls }}">
    <a href="/registrars" title="All domain providers" class="{{ offCls }}">
      <IconArrowLeft class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">All domain providers</span>
    </a>
  </div>
</aside>