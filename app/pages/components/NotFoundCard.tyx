component NotFoundCard

import { IconArrowLeft } from "tylix-icons"

// The "this thing doesn't exist" screen for detail pages (a server, site,
// provider or member that was removed, or a wrong link).
//
// Pages track it in a state field called `isMissing`, never `notFound`:
// `notFound` is a Tylix runtime helper, so `{{#if notFound}}` in a template
// reads the (always truthy) function instead of the page's state.

props
  heading: String
  body: String
  link: String
  linkLabel: String

template
<div role="status" class="max-w-xl mx-auto mt-4 sm:mt-10 rounded-2xl border border-line bg-panel px-6 py-10 sm:px-10 sm:py-12 text-center shadow-sm dark:shadow-none">
  <span class="w-12 h-12 mx-auto mb-5 rounded-2xl bg-zinc-100 dark:bg-white/[0.06] text-zinc-500 dark:text-zinc-400 flex items-center justify-center">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" />
      <path d="M8.5 8.5l5 5M13.5 8.5l-5 5" />
    </svg>
  </span>
  <h2 class="text-zinc-900 dark:text-zinc-50 text-lg font-semibold tracking-tight mb-1.5">{{ heading }}</h2>
  <p class="text-zinc-500 text-sm max-w-sm mx-auto mb-6">{{ body }}</p>
  <a href="{{ link }}" class="inline-flex items-center gap-1.5 h-9 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 px-4 text-sm font-semibold hover:opacity-90 transition-opacity">
    <IconArrowLeft class="w-4 h-4" /> {{ linkLabel }}
  </a>
</div>
