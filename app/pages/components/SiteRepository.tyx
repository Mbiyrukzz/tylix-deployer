component SiteRepository

import { IconGithub, IconGitBranch, IconCode, IconExternalLink, IconUnlink, IconPencilSquare, IconLink } from "tylix-icons"

props
  site: Object
  onChanged: Function
  message: String

uses
  Billing
  TwoFactor

state
  editing: false
  opening: false
  connections: []
  connectionsLoaded: false
  choice: null
  saving: false
  error: ""
  needsReset: ""
  resetOk: false
  codeOpen: false
  code: ""
  codeError: ""
  log: ""
  askingDisconnect: false

action
  async loadConnections() {
    const result = await useApi("/api/source-controls")
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    if result.ok and Array.isArray(result.data) {
      this.connections = result.data
    }
    this.connectionsLoaded = true
  }

  connection() {
    const id = Number(this.site.source_control_id or 0)
    return id ? (this.connections.find((c) => Number(c.id) is id) or null) : null
  }

  isGithub() {
    const c = this.connection()
    return c ? c.kind is "github" : false
  }

  repoUrl() {
    const c = this.connection()
    if not c or not this.site.repository {
      return ""
    }
    const host = c.kind is "github" ? "https://github.com/" : "https://gitlab.com/"
    return host + this.site.repository
  }

  connectionText() {
    const c = this.connection()
    if not c {
      return ""
    }
    const kind = c.kind is "github" ? "GitHub" : "GitLab"
    return kind + " · " + c.label + (c.username ? " (" + c.username + ")" : "")
  }

  async start() {
    if this.opening {
      return null
    }
    this.askingDisconnect = false
    this.choice = null
    this.error = ""
    this.needsReset = ""
    this.resetOk = false
    this.log = ""
    if not this.connectionsLoaded {
      this.opening = true
      await this.loadConnections()
      this.opening = false
    }
    this.editing = true
  }

  stop() {
    this.editing = false
    this.choice = null
    this.error = ""
    this.needsReset = ""
    this.resetOk = false
    this.codeOpen = false
    this.code = ""
    this.codeError = ""
    this.log = ""
    TwoFactor.reset()
  }

  picked(value) {
    this.choice = value
    this.needsReset = ""
    this.resetOk = false
    this.error = ""
    this.log = ""
  }

  ready() {
    const c = this.choice
    return Boolean(c and c.source_control_id and c.repository and c.branch)
  }

  unchanged() {
    const c = this.choice
    if not c {
      return false
    }
    return Number(c.source_control_id) is Number(this.site.source_control_id or 0) and c.repository is this.site.repository and c.branch is this.site.branch
  }

  async save() {
    if Billing.locked or this.saving or not this.ready() {
      return null
    }
    if this.needsReset and not this.resetOk {
      this.error = "Tick the box to let Flux match the folder to the branch, or pick another branch."
      return null
    }

    this.saving = true
    this.error = ""
    this.codeError = ""
    this.log = ""

    const body = {
      source_control_id: this.choice.source_control_id,
      repository: this.choice.repository,
      branch: this.choice.branch,
      reset: Boolean(this.needsReset and this.resetOk),
      code: this.code.trim()
    }
    const result = await useApi("/api/sites/" + this.site.id + "/source", { method: "PUT", body: body })
    this.saving = false

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      const notice = result.data.commit ? "Connected. The folder is at " + result.data.commit.slice(0, 7) + (result.data.message ? " (" + result.data.message + ")" : "") + ". Deploy to update it." : "Connected."
      this.stop()
      this.onChanged({ ...result.data, notice: notice })
      return null
    }

    if result.status is 403 and result.data?.two_factor_required {
      TwoFactor.apply(result.data.methods or [])
      this.codeOpen = true
      this.codeError = this.code.trim() ? "" : "Enter a verification code to change the repository."
      if TwoFactor.sms and not TwoFactor.totp {
        await TwoFactor.sendCode()
      }
      return null
    }

    const errors = result.data?.errors
    if errors and errors.code {
      this.codeOpen = true
      this.codeError = errors.code[0]
      return null
    }

    if result.status is 409 and result.data?.needs_reset {
      // The amber box explains it and asks; no separate error line.
      this.needsReset = result.data.needs_reset
      return null
    }
    this.error = result.data?.error or "Couldn't connect the repository."
    this.log = result.data?.log or ""
  }

  askDisconnect() {
    this.askingDisconnect = true
  }

  keepConnected() {
    this.askingDisconnect = false
  }

  async disconnect() {
    if Billing.locked or this.saving {
      return null
    }
    this.saving = true
    this.error = ""
    const result = await useApi("/api/sites/" + this.site.id + "/source", { method: "PUT", body: { source_control_id: 0 } })
    this.saving = false
    this.askingDisconnect = false

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    if result.ok {
      this.onChanged({ ...result.data, notice: "Disconnected. Flux won't deploy this site until a repository is connected again." })
    } else {
      this.error = result.data?.error or "Couldn't disconnect the repository."
    }
  }

onMount
  async {
    await this.loadConnections()
  }

template
  <section id="repository" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
      <div class="min-w-0">
        <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Repository</h2>
        <p class="text-zinc-500 text-[13px] mt-0.5">Where deploys pull the code from.</p>
      </div>
{{#if not editing}}
{{#if site.repository}}
{{#if not Billing.locked}}
      <div class="flex flex-wrap gap-2 shrink-0">
        <button type="button" disabled="{{ opening }}" onclick="{{ start() }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors disabled:opacity-60">
          <IconPencilSquare class="w-4 h-4" /> {{ opening ? "Opening…" : "Change" }}
        </button>
{{#if not askingDisconnect}}
        <button type="button" onclick="{{ askDisconnect() }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-medium text-rose-600 dark:text-rose-400 border border-rose-500/30 rounded-full px-4 hover:bg-rose-500/[0.06] transition-colors">
          <IconUnlink class="w-4 h-4" /> Disconnect
        </button>
{{/if}}
      </div>
{{/if}}
{{/if}}
{{/if}}
    </div>

{{#if not editing}}
{{#if site.repository}}
    <div class="px-5 sm:px-6 py-5">
      <div class="flex items-start gap-4">
        <span class="w-11 h-11 shrink-0 rounded-xl border border-line bg-sunken flex items-center justify-center text-zinc-700 dark:text-zinc-200">
{{#if isGithub()}}
          <IconGithub class="w-5 h-5" />
{{/if}}
{{#if not isGithub()}}
          <IconCode class="w-5 h-5" />
{{/if}}
        </span>
        <div class="min-w-0 flex-1">
{{#if repoUrl()}}
          <a href="{{ repoUrl() }}" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 max-w-full text-zinc-900 dark:text-zinc-50 text-[15px] font-mono font-medium hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            <span class="break-all">{{ site.repository }}</span>
            <IconExternalLink class="w-3.5 h-3.5 shrink-0 text-zinc-400 group-hover:text-current" />
          </a>
{{/if}}
{{#if not repoUrl()}}
          <p class="text-zinc-900 dark:text-zinc-50 text-[15px] font-mono font-medium break-all">{{ site.repository }}</p>
{{/if}}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-line-strong px-2.5 py-1 text-xs font-mono text-zinc-700 dark:text-zinc-300">
              <IconGitBranch class="w-3.5 h-3.5 opacity-70" /> {{ site.branch }}
            </span>
{{#if connectionText()}}
            <span class="text-zinc-500 text-xs">{{ connectionText() }}</span>
{{/if}}
          </div>
        </div>
      </div>
    </div>
{{/if}}

{{#if not site.repository}}
    <div class="px-5 sm:px-6 py-8 sm:py-10 flex flex-col items-center text-center">
      <span class="w-12 h-12 rounded-2xl border border-line bg-sunken flex items-center justify-center text-zinc-500 mb-4">
        <IconLink class="w-5 h-5" />
      </span>
      <p class="text-zinc-900 dark:text-zinc-100 text-sm font-semibold">No repository connected</p>
      <p class="text-zinc-500 text-[13px] mt-1 max-w-sm leading-relaxed">Flux can't deploy this site yet. Connect it to one of your GitHub or GitLab repositories.</p>
{{#if not Billing.locked}}
      <button type="button" disabled="{{ opening }}" onclick="{{ start() }}" class="inline-flex items-center gap-1.5 mt-5 h-10 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-5 shadow-sm transition-colors disabled:opacity-60">
        <IconLink class="w-4 h-4" /> {{ opening ? "Opening…" : "Connect repository" }}
      </button>
{{/if}}
    </div>
{{/if}}

{{#if askingDisconnect}}
    <div class="mx-5 sm:mx-6 mb-5 rounded-xl border border-rose-500/30 bg-rose-500/[0.05] p-4">
      <p class="text-zinc-800 dark:text-zinc-200 text-sm font-medium">Stop deploying from {{ site.repository }}?</p>
      <p class="text-zinc-500 text-[13px] mt-0.5 mb-3">Nothing on the server changes. You can connect a repository again any time.</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" disabled="{{ saving }}" onclick="{{ disconnect() }}" class="h-9 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 transition-colors disabled:opacity-50">{{ saving ? "Disconnecting…" : "Disconnect" }}</button>
        <button type="button" onclick="{{ keepConnected() }}" class="h-9 text-sm font-medium text-zinc-600 dark:text-zinc-300 rounded-full px-4 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors">Keep it</button>
      </div>
    </div>
{{/if}}

{{#if message}}
    <p role="status" class="mx-5 sm:mx-6 mb-5 rounded-xl border border-emerald-500/30 bg-emerald-500/[0.06] px-4 py-3 text-emerald-700 dark:text-emerald-400 text-sm break-words">{{ message }}</p>
{{/if}}
{{#if error}}
    <p role="alert" class="mx-5 sm:mx-6 mb-5 text-rose-600 dark:text-rose-400 text-sm break-words">{{ error }}</p>
{{/if}}
{{/if}}

{{#if editing}}
    <div class="px-5 sm:px-6 py-5 sm:py-6">
      <div class="max-w-2xl">
        <RepositoryPicker connections="{{ connections }}" current="{{ site }}" onChange="{{ picked }}" />

        <p class="text-zinc-500 text-xs mt-5 leading-relaxed">Flux points the site folder's git checkout at this repository and checks that the connection can read it. Untracked files (like .env, uploads and storage) are never touched.</p>

{{#if needsReset}}
        <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/[0.06] p-4">
          <p class="text-amber-800 dark:text-amber-300 text-sm leading-relaxed">{{ needsReset is "no_git" ? "The site folder isn't a git checkout yet." : "The code in the folder isn't part of this branch, so a deploy couldn't fast-forward it." }}</p>
          <label class="mt-3 flex items-start gap-3 text-sm text-zinc-800 dark:text-zinc-200 cursor-pointer">
            <input type="checkbox" checked="{{ resetOk }}" onchange="{{ resetOk = $event.target.checked }}" class="w-5 h-5 mt-0.5 shrink-0 accent-brand-500" />
            <span>Match the folder to the latest commit of {{ choice ? choice.branch : "the branch" }} now. Files tracked by git take that version (files only the old code tracked are removed); untracked files like .env and uploads stay.</span>
          </label>
        </div>
{{/if}}

{{#if codeOpen}}
        <div class="mt-4 rounded-xl border border-line bg-sunken p-4 max-w-sm">
          <label for="repo-step-up-code" class="block text-zinc-700 dark:text-zinc-300 text-sm font-medium mb-1.5">Verification code</label>
          <input id="repo-step-up-code" type="text" inputmode="text" autocomplete="one-time-code" maxlength="12" value="{{ code }}" oninput="{{ code = $event.target.value }}" class="w-full rounded-lg border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-center text-lg font-mono tracking-[0.3em] px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500" />
          <p class="text-zinc-500 text-xs mt-2">{{ TwoFactor.totp ? "Enter a code from your authenticator app, or a recovery code." : "Enter the code texted to " + TwoFactor.smsHint + "." }}</p>
{{#if TwoFactor.notice}}
          <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ TwoFactor.notice }}</p>
{{/if}}
{{#if codeError}}
          <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if TwoFactor.sms}}
          <button type="button" disabled="{{ TwoFactor.sending }}" onclick="{{ TwoFactor.sendCode() }}" class="mt-3 text-xs text-zinc-600 dark:text-zinc-300 border border-line rounded-full px-3 py-1 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors disabled:opacity-50">{{ TwoFactor.sending ? "Sending…" : "Text me a code" }}</button>
{{/if}}
        </div>
{{/if}}

{{#if error}}
        <p role="alert" class="mt-4 text-rose-600 dark:text-rose-400 text-sm break-words">{{ error }}</p>
{{/if}}
{{#if log}}
        <div class="mt-2 max-h-40 overflow-auto rounded-lg bg-zinc-950 text-zinc-300 text-xs font-mono p-3 whitespace-pre-wrap [overflow-wrap:anywhere]">{{ log }}</div>
{{/if}}
      </div>
    </div>

    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 py-3.5 border-t border-line bg-sunken">
      <p class="min-w-0 text-zinc-500 text-xs truncate">
{{#if ready()}}
        <span class="font-mono text-zinc-800 dark:text-zinc-200">{{ choice.repository }}</span> on <span class="font-mono text-zinc-800 dark:text-zinc-200">{{ choice.branch }}</span>{{ unchanged() ? " (no change)" : "" }}
{{/if}}
{{#if not ready()}}
        Pick a connection, a repository and a branch.
{{/if}}
      </p>
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" onclick="{{ stop() }}" class="flex-1 sm:flex-none h-10 sm:h-9 text-sm font-medium text-zinc-600 dark:text-zinc-300 rounded-full px-4 hover:bg-zinc-200/60 dark:hover:bg-white/[0.05] transition-colors">Cancel</button>
        <button type="button" disabled="{{ saving or not ready() }}" onclick="{{ save() }}" class="flex-1 sm:flex-none h-10 sm:h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-5 shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed">{{ saving ? "Connecting…" : (site.repository ? "Save repository" : "Connect") }}</button>
      </div>
    </div>
{{/if}}
  </section>
