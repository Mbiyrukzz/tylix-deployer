component InstallSnippet

import { IconCheck, IconClipboard } from "tylix-icons"

state
  copied: false
  installing: false
  codeSample: `$ npx create-tylix my-app

page Post

state
  posts: []
  query: ""

computed
  visiblePosts() {
    return this.posts.filter(p => p.title has this.query or this.query is "")
  }

onMount
  async {
    const result = await getApi("posts")
    this.posts = result.data
  }

// renders:
  <input value="{{ query }}" oninput="{{ query = $event.target.value }}" placeholder="Search posts…" />

  <ul>
{{#each p in visiblePosts}}
    <li>{{ p.title }}</li>
{{/each}}
  </ul>`

action
  async copyInstallCommand() {
    if not this.copied and not this.installing {
      await navigator.clipboard.writeText("npx create-tylix my-app")
      this.copied = true
    }
  }

template
  <section class="px-6 pb-24 max-w-3xl mx-auto">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 overflow-hidden shadow-sm">
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-200 dark:border-slate-800 bg-slate-200 dark:bg-slate-950/40">
        <div class="flex gap-1.5">
          <span class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700"></span>
          <span class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700"></span>
          <span class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-700"></span>
        </div>
        <button
          onclick="{{ copyInstallCommand() }}"
          aria-label="Copy install command"
          class="inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 hover:text-emerald-500 transition-colors px-2 py-1 rounded-full hover:bg-slate-200 dark:hover:bg-slate-800"
        >
          <span class="inline-flex items-center gap-1.5" aria-live="polite">
{{#if copied}}
            <IconCheck class="w-3.5 h-3.5" /> Copied
{{/if}}
{{#if not copied}}
            <IconClipboard class="w-3.5 h-3.5" /> Copy
{{/if}}
          </span>
        </button>
      </div>
      <pre class="text-slate-600 dark:text-slate-300 text-[13px] font-mono p-6 overflow-x-auto leading-relaxed">{{ codeSample }}</pre>
    </div>
  </section>