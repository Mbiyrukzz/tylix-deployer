component PageLoader

// What a page shows while its data loads: the loader (LoaderMark, the same
// as Ashmif Hub's) centred in the page column. The sidebar and top bar are
// already on screen (they belong to the layout). data-page-loader tells
// public/app-shell.js the page isn't ready yet: during in-place navigation
// the previous page stays up for a moment instead of flashing this.
// bare="true" fills the whole window (pages without the app shell).

props
  label: String
  bare: String

template
{{#if bare}}
<div data-page-loader="true" style="min-height: calc(100vh - 4rem)" class="flex items-center justify-center bg-page">
  <LoaderMark label="{{ label }}" />
</div>
{{/if}}
{{#if not bare}}
<div data-page-loader="true" style="min-height: calc(100vh - 4rem)" class="min-w-0 flex items-center justify-center px-4">
  <LoaderMark label="{{ label }}" />
</div>
{{/if}}
