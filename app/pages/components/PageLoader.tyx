component PageLoader

// What a page shows while its data loads. The sidebar and top bar are
// already on screen (they belong to the layout), so this only fills the
// page column. data-page-loader tells public/app-shell.js the page isn't
// ready yet: during in-place navigation the previous page stays up for a
// moment instead of flashing this skeleton.

props
  label: String
  bare: String

template
{{#if bare}}
<div role="status" aria-live="polite" data-page-loader="true" style="min-height: calc(100vh - 4rem)" class="flex items-center justify-center bg-page">
  <div class="flex flex-col items-center justify-center py-14">
    <div class="relative w-14 h-14 flex items-center justify-center">
      <span class="absolute inset-0 rounded-2xl bg-brand-500/20 animate-loader-ring"></span>
      <img src="/flux-mark.svg" alt="" class="relative w-14 h-14 rounded-2xl" />
    </div>
    <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium mt-6">{{ label }}</p>
    <div class="w-40 h-1 rounded-full bg-zinc-200 dark:bg-white/[0.06] overflow-hidden mt-3">
      <div class="w-1/3 h-full rounded-full bg-brand-500 animate-loader-slide"></div>
    </div>
  </div>
</div>
{{/if}}
{{#if not bare}}
<div role="status" aria-live="polite" aria-label="{{ label }}" data-page-loader="true" class="min-w-0 px-4 sm:px-6 lg:px-10 py-6 sm:py-10">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div class="space-y-3">
        <div class="h-3 w-28 rounded-full bg-zinc-200/80 dark:bg-white/[0.05] animate-pulse"></div>
        <div class="h-7 w-64 rounded-lg bg-zinc-200/80 dark:bg-white/[0.06] animate-pulse"></div>
        <div class="h-3 w-80 max-w-full rounded-full bg-zinc-200/60 dark:bg-white/[0.04] animate-pulse"></div>
      </div>
      <div class="hidden sm:block h-9 w-32 rounded-full bg-zinc-200/80 dark:bg-white/[0.05] animate-pulse"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
      <div class="h-28 rounded-2xl border border-line bg-panel animate-pulse"></div>
      <div class="h-28 rounded-2xl border border-line bg-panel animate-pulse"></div>
      <div class="h-28 rounded-2xl border border-line bg-panel animate-pulse"></div>
    </div>
    <div class="h-64 rounded-2xl border border-line bg-panel animate-pulse"></div>
    <p class="sr-only">{{ label }}</p>
  </div>
</div>
{{/if}}
