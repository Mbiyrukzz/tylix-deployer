component Hero

import { IconArrowRight, IconLockClosed } from "tylix-icons"

// The top of the home page: the pitch, the two calls to action, a row of
// the stacks it deploys (real logos, see BrandLogo) and a live-looking
// server page (DeployPreview).

uses
  Auth

computed
  stacks() {
    return [
      { id: "tylix", name: "Tylix" },
      { id: "laravel", name: "Laravel" },
      { id: "nextjs", name: "Next.js" },
      { id: "nodejs", name: "Node.js" },
      { id: "wordpress", name: "WordPress" },
      { id: "django", name: "Django" },
      { id: "go", name: "Go" },
      { id: "rust", name: "Rust" }
    ]
  }

  // Keep in step with PROVIDER_KINDS, REGISTRAR_KINDS and the StackGrid list.
  stats() {
    return [
      { value: "16", label: "stacks, ready to deploy" },
      { value: "7", label: "cloud providers" },
      { value: "8", label: "domain registrars" },
      { value: "Live", label: "CPU, memory and disk" }
    ]
  }

template
<section class="relative overflow-hidden border-b border-line px-4 sm:px-6 pt-14 sm:pt-24 pb-16 sm:pb-24">

  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 h-[44rem] bg-[radial-gradient(ellipse_55%_60%_at_50%_0%,rgb(224_57_63/0.16),transparent_70%)] dark:bg-[radial-gradient(ellipse_55%_60%_at_50%_0%,rgb(240_79_84/0.18),transparent_70%)]"></div>
    <div class="absolute -top-32 left-[8%] w-[30rem] max-w-[90vw] h-[30rem] rounded-full bg-brand-500/[0.16] dark:bg-brand-500/[0.14] blur-[110px] motion-safe:animate-hero-drift"></div>
    <div class="absolute top-0 right-[6%] w-[26rem] max-w-[80vw] h-[26rem] rounded-full bg-amber-400/[0.14] dark:bg-amber-500/[0.08] blur-[110px] motion-safe:animate-hero-drift-alt"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/50 to-transparent"></div>
  </div>

  <div class="relative max-w-6xl mx-auto text-center">

    <a href="/pricing" class="group inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 pl-3 pr-1.5 py-1 text-xs font-semibold text-brand-700 dark:text-brand-400 mb-7 hover:bg-brand-500/15 transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
      14-day free trial for new accounts
      <span class="w-5 h-5 rounded-full bg-brand-500/15 flex items-center justify-center group-hover:translate-x-0.5 transition-transform">
        <IconArrowRight class="w-3 h-3" />
      </span>
    </a>

    <h1 class="text-[2.6rem] sm:text-6xl lg:text-7xl font-bold max-w-4xl mx-auto leading-[1.04] mb-6 tracking-tight text-slate-900 dark:text-slate-100 text-balance">
      Ship any stack,
      <br class="hidden sm:block" />
      <span class="text-brand-500">manage it all in one place</span>
    </h1>

    <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mb-9 leading-relaxed">
      Create or connect a server, deploy your app, then point the domain at it and edit its DNS from the same dashboard. Watch CPU, memory and disk live.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 max-w-sm sm:max-w-none mx-auto min-h-[48px]">
{{#if Auth.user}}
      <a href="/dashboard" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-brand-500 text-white font-semibold shadow-lg shadow-brand-500/25 hover:bg-brand-400 transition-colors">
        Go to dashboard
        <IconArrowRight class="w-4 h-4" />
      </a>
      <a href="/servers" class="inline-flex items-center justify-center px-7 h-12 rounded-full border border-line-strong bg-panel/70 text-slate-700 dark:text-slate-200 font-medium hover:bg-panel hover:border-slate-400 dark:hover:border-white/25 transition-colors">
        My servers
      </a>
{{/if}}
{{#if not Auth.loading}}
{{#if not Auth.user}}
      <a href="/register" class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-brand-500 text-white font-semibold shadow-lg shadow-brand-500/25 hover:bg-brand-400 transition-colors">
        Start free trial
        <IconArrowRight class="w-4 h-4" />
      </a>
      <a href="/docs" class="inline-flex items-center justify-center px-7 h-12 rounded-full border border-line-strong bg-panel/70 text-slate-700 dark:text-slate-200 font-medium hover:bg-panel hover:border-slate-400 dark:hover:border-white/25 transition-colors">
        Read the docs
      </a>
{{/if}}
{{/if}}
    </div>

    <p class="mt-5 text-slate-500 text-xs">
      <IconLockClosed class="inline w-3.5 h-3.5 -mt-0.5 mr-1" />SSH keys stored encrypted · Your servers, your provider account
    </p>

    <div class="mt-12">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500 mb-4">Deploys the stack you already use</p>
      <ul class="flex flex-wrap items-center justify-center gap-2 max-w-5xl mx-auto">
{{#each s in stacks}}
        <li>
          <a href="#stacks" class="flex items-center gap-2 rounded-xl border border-line bg-panel/80 backdrop-blur pl-1 pr-3 py-1 text-sm font-medium text-slate-700 dark:text-slate-300 hover:border-brand-500/40 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
            <BrandLogo kind="{{ s.id }}" size="sm" />
            {{ s.name }}
          </a>
        </li>
{{/each}}
        <li>
          <a href="#stacks" class="flex items-center h-9 rounded-xl border border-dashed border-line-strong px-3 text-sm text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-500/40 transition-colors">+8 more</a>
        </li>
      </ul>
    </div>

    <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-px max-w-4xl mx-auto rounded-2xl border border-line bg-line overflow-hidden">
{{#each st in stats}}
      <div class="bg-panel px-4 py-5 text-center">
        <p class="text-2xl sm:text-[1.7rem] font-bold tracking-tight text-slate-900 dark:text-slate-100 tabular-nums">{{ st.value }}</p>
        <p class="text-slate-500 text-xs mt-0.5">{{ st.label }}</p>
      </div>
{{/each}}
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto mt-14 sm:mt-16">
    <DeployPreview />
  </div>
</section>
