component Hero

import { IconArrowRight } from "tylix-icons"

uses
  Auth

state
  stacks: []
  stats: []

onMount
  async {
    this.stacks = ["Tylix", "Laravel", "PHP", "Node.js", "Next.js", "MERN", "WordPress", "Angular"]
    this.stats = [
      { value: "5", label: "cloud providers" },
      { value: "15+", label: "frameworks" },
      { value: "Live", label: "CPU, RAM and disk" },
      { value: "1-click", label: "SSL and DNS" }
    ]
  }

template
<section class="relative overflow-hidden px-4 sm:px-6 pt-16 sm:pt-24 pb-12 sm:pb-20 bg-slate-200 dark:bg-slate-950 transition-colors">

  <div class="relative max-w-6xl mx-auto text-center">

    <a href="/pricing" class="group inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 pl-3 pr-2 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 mb-7 hover:bg-emerald-500/15 transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      14-day free trial for new accounts
      <span class="w-5 h-5 rounded-full bg-emerald-500/15 flex items-center justify-center group-hover:translate-x-0.5 transition-transform">
        <IconArrowRight class="w-3 h-3" />
      </span>
    </a>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold max-w-4xl mx-auto leading-[1.05] mb-6 tracking-tight text-slate-900 dark:text-slate-100">
      Ship any stack,
      <br class="hidden sm:block" />
      <span class="text-emerald-500">manage it all in one place</span>
    </h1>

    <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mb-9 leading-relaxed">
      Create or connect a server, deploy your app, then point the domain at it and edit its DNS from the same dashboard. Watch CPU, memory and disk live.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 max-w-md sm:max-w-none mx-auto mb-5 min-h-[48px]">
{{#if Auth.user}}
      <a href="/dashboard" class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-emerald-500 text-white dark:text-slate-950 font-semibold shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-all">
        Go to Dashboard
        <IconArrowRight class="w-4 h-4" />
      </a>
      <a href="/servers" class="inline-flex items-center justify-center px-7 py-3 rounded-full border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors">
        My Servers
      </a>
      <a href="/registrars" class="inline-flex items-center justify-center px-7 py-3 rounded-full border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors">
        My Domains
      </a>
{{/if}}
{{#if not Auth.loading}}
{{#if not Auth.user}}
      <a href="/register" class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-emerald-500 text-white dark:text-slate-950 font-semibold shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 transition-all">
        Start free trial
        <IconArrowRight class="w-4 h-4" />
      </a>
      <a href="/pricing" class="inline-flex items-center justify-center px-7 py-3 rounded-full border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors">
        See pricing
      </a>
{{/if}}
{{/if}}
    </div>

    <p class="text-slate-500 text-xs font-mono mb-10">SSH keys stored encrypted · Your machine, your rules</p>

    <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto mb-12">
{{#each s in stacks}}
      <span class="rounded-full border border-slate-300 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 px-3.5 py-1 text-xs sm:text-sm text-slate-700 dark:text-slate-300">{{ s }}</span>
{{/each}}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px max-w-4xl mx-auto mb-14 sm:mb-16 rounded-2xl overflow-hidden border border-slate-300 dark:border-slate-800 bg-slate-300 dark:bg-slate-800">
{{#each st in stats}}
      <div class="bg-white/80 dark:bg-slate-900 px-4 py-5">
        <p class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100">{{ st.value }}</p>
        <p class="text-slate-500 text-xs mt-0.5">{{ st.label }}</p>
      </div>
{{/each}}
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto">
    <DeployPreview />
  </div>
</section>