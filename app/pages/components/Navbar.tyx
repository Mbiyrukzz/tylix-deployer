component Navbar

import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Auth
  Theme

state
  mobileMenuOpen: false
  showDashboardLink: true
  path: "/"

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  // Updates the active link and closes the mobile menu.
  go(href) {
    this.path = href
    this.mobileMenuOpen = false
  }

  refresh() {
    const p = window.location.pathname
    const inApp = p.startsWith("/dashboard") or p.startsWith("/server")
    this.path = p
    this.showDashboardLink = not inApp
  }

  desktopLink(href) {
    const base = "text-sm font-medium rounded-full px-4 py-1.5 transition-colors "
    if this.path is href {
      return base + "text-brand-700 dark:text-brand-400 bg-brand-500/10"
    }
    return base + "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-stone-200/60 dark:hover:bg-white/[0.05]"
  }

  mobileLink(href) {
    const base = "block text-sm font-medium rounded-xl px-3 py-3 transition-colors "
    if this.path is href {
      return base + "text-brand-700 dark:text-brand-400 bg-brand-500/10"
    }
    return base + "text-slate-700 dark:text-slate-300 hover:bg-stone-200/60 dark:hover:bg-white/[0.05]"
  }

  initial(user) {
    if not user {
      return "?"
    }
    const source = user.name or user.email or "?"
    return source.charAt(0).toUpperCase()
  }

  async callLogout() {
    return Auth.logout()
  }

  async logout() {
    this.mobileMenuOpen = false
    await this.callLogout().catch((err) => console.error("logout failed:", err))
    window.location.replace("/login")
  }

onMount
  async {
    this.refresh()
    window.addEventListener("popstate", () => this.refresh())
  }

template
<header class="sticky top-0 z-40 border-b border-line bg-[#f5f5f4]/85 dark:bg-[#0a0a0b]/85 backdrop-blur-xl transition-colors">
  <nav class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 flex items-center justify-between gap-4">

    <div class="flex items-center gap-8 min-w-0">
      <a href="/" onclick="{{ go('/') }}" class="flex items-center gap-2.5 group shrink-0">
        <img src="/logo-mark.png" alt="Tylix" class="w-8 h-8 group-hover:scale-105 transition-transform" />
        <span class="text-slate-900 dark:text-slate-100 font-semibold tracking-tight">Tylix Deploy</span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        <a href="/pricing" onclick="{{ go('/pricing') }}" class="{{ desktopLink('/pricing') }}">Pricing</a>
        <a href="https://tylix.dev/docs" target="_blank" rel="noopener" class="{{ desktopLink('') }}">Docs</a>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">

      <button
        onclick="{{ Theme.toggle() }}"
        aria-label="Toggle color theme"
        class="w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors"
      >
{{#if Theme.mode is "dark"}}
        <IconSun class="w-[18px] h-[18px]" />
{{/if}}
{{#if Theme.mode is not "dark"}}
        <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
      </button>

{{#if Auth.user}}
{{#if showDashboardLink}}
      <a href="/dashboard" class="hidden md:inline-flex text-sm font-semibold bg-brand-500 text-white dark:text-slate-950 rounded-full px-4 py-1.5 shadow-sm hover:bg-brand-400 transition-all">
        Dashboard
      </a>
{{/if}}
      <div class="hidden md:flex items-center gap-2.5 rounded-full border border-line bg-panel pl-1 pr-3 py-1">
        <div class="w-7 h-7 rounded-full bg-brand-500 flex items-center justify-center text-white text-xs font-semibold">
          {{ initial(Auth.user) }}
        </div>
        <span class="hidden lg:block text-sm text-slate-700 dark:text-slate-200 max-w-[120px] truncate">{{ Auth.user.name }}</span>
      </div>
      <button onclick="{{ logout() }}" class="hidden md:block text-sm text-slate-600 dark:text-slate-300 border border-stone-300 dark:border-white/15 rounded-full px-4 py-1.5 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors">
        Log out
      </button>
{{/if}}

{{#if not Auth.loading}}
{{#if not Auth.user}}
      <a href="/login" class="hidden md:block text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 transition-colors px-3 py-1.5">
        Login
      </a>
      <a href="/register" class="hidden md:block text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-1.5 shadow-sm hover:bg-brand-400 transition-all">
        Get Started
      </a>
{{/if}}
{{/if}}

      <button
        onclick="{{ toggleMobileMenu() }}"
        aria-label="Toggle menu"
        aria-expanded="{{ mobileMenuOpen }}"
        aria-controls="mobile-menu"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-full text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors"
      >
{{#if mobileMenuOpen}}
        <IconX class="w-[18px] h-[18px]" />
{{/if}}
{{#if not mobileMenuOpen}}
        <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
      </button>
    </div>
  </nav>

{{#if mobileMenuOpen}}
  <div id="mobile-menu" class="md:hidden border-t border-line bg-page px-4 sm:px-6 py-4 max-h-[calc(100vh-4rem)] overflow-y-auto">

{{#if Auth.user}}
    <div class="flex items-center gap-3 rounded-2xl border border-line bg-panel px-4 py-3 mb-3">
      <div class="w-10 h-10 shrink-0 rounded-full bg-brand-500 flex items-center justify-center text-white text-sm font-semibold">
        {{ initial(Auth.user) }}
      </div>
      <div class="min-w-0">
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ Auth.user.name }}</p>
        <p class="text-slate-500 dark:text-slate-400 text-xs truncate">{{ Auth.user.email }}</p>
      </div>
    </div>
{{/if}}

    <div class="space-y-1">
{{#if Auth.user}}
{{#if showDashboardLink}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="block text-sm font-semibold text-brand-700 dark:text-brand-400 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] rounded-xl px-3 py-3 transition-colors">Dashboard</a>
{{/if}}
{{/if}}
      <a href="/pricing" onclick="{{ go('/pricing') }}" class="{{ mobileLink('/pricing') }}">Pricing</a>
      <a href="https://tylix.dev/docs" target="_blank" rel="noopener" onclick="{{ closeMobileMenu() }}" class="{{ mobileLink('') }}">Docs</a>
    </div>

{{#if Auth.user}}
    <div class="h-px bg-stone-200 dark:bg-white/10 my-3"></div>
    <button onclick="{{ logout() }}" class="w-full text-left text-sm text-slate-700 dark:text-slate-300 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] rounded-xl px-3 py-3 transition-colors">Log out</button>
{{/if}}

{{#if not Auth.loading}}
{{#if not Auth.user}}
    <div class="grid grid-cols-2 gap-3 mt-4">
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-center text-sm font-medium text-slate-700 dark:text-slate-300 border border-stone-300 dark:border-white/15 rounded-full px-4 py-2.5 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors">Login</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-center text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2.5 shadow-sm hover:bg-brand-400 transition-all">Get Started</a>
    </div>
{{/if}}
{{/if}}

  </div>
{{/if}}
</header>