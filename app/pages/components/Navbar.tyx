component Navbar

import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Auth
  Theme

state
  mobileMenuOpen: false
  showDashboardLink: true
  path: "/"

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  // Updates the active link and closes the mobile menu.
  go(href) {
    this.path = href
    this.mobileMenuOpen = false
  }

  refresh() {
    const p = window.location.pathname
    const inApp = p.startsWith("/dashboard") or p.startsWith("/server")
    this.path = p
    this.showDashboardLink = not inApp
  }

  desktopLink(href) {
    const base = "text-base font-medium rounded-full px-4 py-1.5 transition-colors "
    if this.path is href {
      return base + "text-brand-700 dark:text-brand-400 bg-brand-500/10"
    }
    return base + "text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-stone-200/60 dark:hover:bg-white/[0.05]"
  }

  mobileLink(href) {
    const base = "block text-base font-medium rounded-2xl px-4 py-3 transition-colors "
    if this.path is href {
      return base + "text-brand-700 dark:text-brand-400 bg-brand-500/10"
    }
    return base + "text-zinc-700 dark:text-zinc-300 hover:bg-stone-200/60 dark:hover:bg-white/[0.05]"
  }

  initial(user) {
    if not user {
      return "?"
    }
    const source = user.name or user.email or "?"
    return source.charAt(0).toUpperCase()
  }

  async callLogout() {
    return Auth.logout()
  }

  async logout() {
    this.mobileMenuOpen = false
    await this.callLogout().catch((err) => console.error("logout failed:", err))
    window.location.replace("/login")
  }

onMount
  async {
    this.refresh()
    window.addEventListener("popstate", () => this.refresh())
  }

template
<header class="sticky top-0 z-40 px-4 sm:px-6 lg:px-10 py-2">
  <nav class="relative max-w-7xl mx-auto h-12 rounded-full border border-line bg-white/80 dark:bg-[#131315]/80 backdrop-blur-xl pl-4 pr-1.5 flex items-center justify-between gap-4 shadow-sm shadow-black/[0.03] transition-colors">

    <div class="flex items-center gap-4 min-w-0">
      <a href="/" onclick="{{ go('/') }}" class="flex items-center gap-2.5 group shrink-0">
        <img src="/logo-mark.png" alt="Tylix" class="w-9 h-9 rounded-lg group-hover:scale-105 transition-transform" />
        <span class="text-zinc-900 dark:text-zinc-100 text-base font-semibold uppercase tracking-[0.14em]">Tylix <span class="text-brand-500">Deploy</span></span>
      </a>

      <div class="hidden md:block w-px h-5 bg-line"></div>

      <div class="hidden md:flex items-center gap-1">
        <a href="https://tylix.dev/docs" target="_blank" rel="noopener" class="{{ desktopLink('') }}">Docs</a>
      </div>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">

      <button
        onclick="{{ Theme.toggle() }}"
        aria-label="Toggle color theme"
        class="w-9 h-9 flex items-center justify-center rounded-full text-zinc-500 dark:text-zinc-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors"
      >
{{#if Theme.mode is "dark"}}
        <IconSun class="w-5 h-5" />
{{/if}}
{{#if Theme.mode is not "dark"}}
        <IconMoon class="w-5 h-5" />
{{/if}}
      </button>

{{#if Auth.user}}
      <div class="hidden md:flex items-center gap-2 rounded-full bg-stone-100 dark:bg-white/[0.05] pl-1 pr-3 py-1">
        <div class="w-7 h-7 rounded-full bg-brand-500 flex items-center justify-center text-white text-xs font-semibold">
          {{ initial(Auth.user) }}
        </div>
        <span class="hidden lg:block text-sm font-medium text-zinc-700 dark:text-zinc-200 max-w-[140px] truncate">{{ Auth.user.name }}</span>
      </div>
      <button onclick="{{ logout() }}" class="hidden md:block text-sm font-medium text-zinc-600 dark:text-zinc-300 rounded-full px-3 py-2 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors">
        Log out
      </button>
{{#if showDashboardLink}}
      <a href="/dashboard" class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold bg-brand-500 text-white rounded-full pl-4 pr-3.5 h-9 hover:bg-brand-400 transition-colors">
        Dashboard <span>&rarr;</span>
      </a>
{{/if}}
{{/if}}

{{#if not Auth.loading}}
{{#if not Auth.user}}
      <a href="/login" class="hidden md:inline-flex items-center text-sm font-medium text-zinc-700 dark:text-zinc-200 rounded-full px-4 h-9 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] transition-colors">
        Login
      </a>
      <a href="/register" class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold bg-brand-500 text-white rounded-full pl-4 pr-3.5 h-9 hover:bg-brand-400 transition-colors">
        Get started <span>&rarr;</span>
      </a>
{{/if}}
{{/if}}

      <button
        onclick="{{ toggleMobileMenu() }}"
        aria-label="Toggle menu"
        aria-expanded="{{ mobileMenuOpen }}"
        aria-controls="mobile-menu"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-full bg-stone-100 dark:bg-white/[0.06] text-zinc-700 dark:text-zinc-200 transition-colors"
      >
{{#if mobileMenuOpen}}
        <IconX class="w-5 h-5" />
{{/if}}
{{#if not mobileMenuOpen}}
        <IconMenu class="w-5 h-5" />
{{/if}}
      </button>
    </div>
  </nav>

{{#if mobileMenuOpen}}
  <div id="mobile-menu" class="md:hidden absolute inset-x-4 sm:inset-x-6 top-[calc(100%-0.25rem)] rounded-3xl border border-line bg-panel p-3 shadow-xl shadow-black/10 max-h-[calc(100vh-5rem)] overflow-y-auto">

{{#if Auth.user}}
    <div class="flex items-center gap-3 rounded-2xl bg-stone-50 dark:bg-white/[0.03] px-4 py-3 mb-2">
      <div class="w-10 h-10 shrink-0 rounded-full bg-brand-500 flex items-center justify-center text-white text-base font-semibold">
        {{ initial(Auth.user) }}
      </div>
      <div class="min-w-0">
        <p class="text-zinc-900 dark:text-zinc-100 text-base font-medium truncate">{{ Auth.user.name }}</p>
        <p class="text-zinc-500 text-sm truncate">{{ Auth.user.email }}</p>
      </div>
    </div>
{{/if}}

    <div class="space-y-1">
{{#if Auth.user}}
{{#if showDashboardLink}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="block text-base font-semibold text-brand-700 dark:text-brand-400 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] rounded-2xl px-4 py-3 transition-colors">Dashboard</a>
{{/if}}
{{/if}}
      <a href="https://tylix.dev/docs" target="_blank" rel="noopener" onclick="{{ closeMobileMenu() }}" class="{{ mobileLink('') }}">Docs</a>
    </div>

{{#if Auth.user}}
    <div class="h-px bg-line my-2"></div>
    <button onclick="{{ logout() }}" class="w-full text-left text-base text-zinc-700 dark:text-zinc-300 hover:bg-stone-200/60 dark:hover:bg-white/[0.05] rounded-2xl px-4 py-3 transition-colors">Log out</button>
{{/if}}

{{#if not Auth.loading}}
{{#if not Auth.user}}
    <div class="grid grid-cols-2 gap-2 mt-3">
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-center text-base font-medium text-zinc-700 dark:text-zinc-200 border border-stone-300 dark:border-white/15 rounded-full px-4 py-2.5 hover:bg-white dark:hover:bg-white/5 transition-colors">Login</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-center text-base bg-brand-500 text-white font-semibold rounded-full px-4 py-2.5 hover:bg-brand-400 transition-colors">Get started</a>
    </div>
{{/if}}
{{/if}}

  </div>
{{/if}}
</header>