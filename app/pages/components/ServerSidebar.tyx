component ServerSidebar

props
  active: String
  serverId: String

template
  <aside class="flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-slate-300 dark:border-slate-800 bg-slate-300/30 dark:bg-slate-900/40 p-3 lg:p-5 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)]">
    <p class="hidden lg:block text-slate-500 text-[11px] font-semibold uppercase tracking-wider mb-2 px-3">This server</p>
{{#if active is "server"}}
    <a href="{{ '/servers/server-detail?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      Overview
    </a>
{{/if}}
{{#if active is not "server"}}
    <a href="{{ '/servers/server-detail?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      Overview
    </a>
{{/if}}
    {{#if active is "databases"}}
    <a href="{{ '/servers/server-databases?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      Database
    </a>
{{/if}}
{{#if active is not "databases"}}
    <a href="{{ '/servers/server-databases?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      Database
    </a>
{{/if}}
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>Backups</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
{{#if active is "sites"}}
    <a href="{{ '/servers/server-sites?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      Sites
    </a>
{{/if}}
{{#if active is not "sites"}}
    <a href="{{ '/servers/server-sites?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      Sites
    </a>
{{/if}}
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>Firewall</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>CronJobs</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
   {{#if active is "workers"}}
    <a href="{{ '/servers/server-workers?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      Workers
    </a>
{{/if}}
{{#if active is not "workers"}}
    <a href="{{ '/servers/server-workers?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      Workers
    </a>
{{/if}}
    {{#if active is "ssh-keys"}}
    <a href="{{ '/servers/server-ssh-keys?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      SSH Keys
    </a>
{{/if}}
{{#if active is not "ssh-keys"}}
    <a href="{{ '/servers/server-ssh-keys?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      SSH Keys
    </a>
{{/if}}
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>Services</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
{{#if active is "packages"}}
    <a href="{{ '/servers/server-packages?id=' + serverId }}" aria-current="page" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500/15 to-transparent text-emerald-700 dark:text-emerald-400 text-sm font-medium">
      Packages
    </a>
{{/if}}
{{#if active is not "packages"}}
    <a href="{{ '/servers/server-packages?id=' + serverId }}" class="shrink-0 flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      Packages
    </a>
{{/if}}
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>Logs</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
    <span class="shrink-0 flex items-center justify-between gap-3 px-3 py-2 rounded-xl text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Coming soon">
      <span>Settings</span>
      <span class="text-[10px] font-semibold uppercase tracking-wider">Soon</span>
    </span>
  </aside>