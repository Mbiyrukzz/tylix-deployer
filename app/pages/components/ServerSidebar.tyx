component ServerSidebar

import { IconGauge, IconDatabase, IconArchive, IconGlobe, IconShieldCheck, IconClock, IconCpuChip, IconKey, IconPackage, IconDocumentText, IconTerminal, IconCog } from "tylix-icons"

props
  active: String
  serverId: String

state
  collapsed: false
  // The server these pages belong to, for the header.
  infoName: ""
  infoHost: ""
  infoStatus: ""
  asideCls: "app-subnav flex lg:flex-col gap-1 overflow-x-auto no-scrollbar lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-transparent p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200 lg:w-[240px] lg:px-3 lg:py-4"
  topCls: "hidden lg:flex items-center justify-between gap-2 mb-5"
  headCls: "hidden lg:flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 text-[11px] font-semibold uppercase tracking-[0.14em] pt-2 pb-1.5 px-3 transition-colors"
  onCls: "relative shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl bg-white text-zinc-900 text-[13.5px] font-medium shadow-sm ring-1 ring-black/[0.06] dark:ring-0"
  offCls: "group shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl text-zinc-600 dark:text-zinc-400 text-[13.5px] font-medium hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
  labelCls: ""
  titleCls: "min-w-0"
  btnCls: "flex items-center justify-center w-8 h-8 shrink-0 rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.05] transition-colors"
  chevCls: "w-4 h-4 transition-transform"

action
  // The page passes its id once it has read the URL; fall back to ?id=.
  async loadInfo() {
    const id = this.serverId or new URLSearchParams(window.location.search).get("id") or ""
    if not id {
      return null
    }
    const result = await useApi("/api/servers/" + id)
    if result.ok and result.data {
      this.infoName = String(result.data.name or "")
      this.infoHost = String(result.data.host or "")
      this.infoStatus = String(result.data.status or "")
    }
  }

  statusLabel() {
    if this.infoStatus is "online" {
      return "Online"
    }
    if this.infoStatus is "offline" {
      return "Offline"
    }
    if this.infoStatus is "pending" {
      return "Not tested"
    }
    return ""
  }

  applyLayout() {
    const asideBase = "app-subnav flex lg:flex-col gap-1 overflow-x-auto no-scrollbar lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-transparent p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200"
    const on = "relative shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl bg-white text-zinc-900 text-[13.5px] font-medium shadow-sm ring-1 ring-black/[0.06] dark:ring-0"
    const off = "group shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl text-zinc-600 dark:text-zinc-400 text-[13.5px] font-medium hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
    const head = "hidden lg:flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 text-[11px] font-semibold uppercase tracking-[0.14em] pt-2 pb-1.5 px-3 transition-colors"

    if this.collapsed {
      this.asideCls = asideBase + " lg:w-16 lg:p-2.5"
      this.topCls = "hidden lg:flex flex-col items-center gap-3 mb-5"
      this.headCls = "hidden"
      this.onCls = on + " lg:justify-center lg:px-0"
      this.offCls = off + " lg:justify-center lg:px-0"
      this.labelCls = "lg:hidden"
      this.titleCls = "hidden"
      this.chevCls = "w-4 h-4 transition-transform rotate-180"

      const sections = document.querySelectorAll("details.tylix-sec")
      sections.forEach((el) => Reflect.set(el, "open", true))
    } else {
      this.asideCls = asideBase + " lg:w-[240px] lg:px-3 lg:py-4"
      this.topCls = "hidden lg:flex items-center justify-between gap-2 mb-5"
      this.headCls = head
      this.onCls = on
      this.offCls = off
      this.labelCls = ""
      this.titleCls = "min-w-0"
      this.chevCls = "w-4 h-4 transition-transform"
    }
  }

  toggle() {
    this.collapsed = not this.collapsed
    this.applyLayout()

    if this.collapsed {
      window.localStorage.setItem("tylix-server-sidebar", "1")
    } else {
      window.localStorage.setItem("tylix-server-sidebar", "0")
    }
  }

onMount
  async {
    this.loadInfo()
    const saved = window.localStorage.getItem("tylix-server-sidebar")
    if saved is "1" {
      this.collapsed = true
      this.applyLayout()
    }
  }

template
<aside class="{{ asideCls }}">

  <div class="{{ topCls }}">
    <div class="flex items-center gap-3 min-w-0">
      <span title="{{ statusLabel() }}" class="relative w-9 h-9 shrink-0 rounded-[10px] border border-line bg-panel text-zinc-700 dark:text-zinc-200 flex items-center justify-center">
        <IconCpuChip class="w-5 h-5" />
{{#if infoStatus is "online"}}
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-page"></span>
{{/if}}
{{#if infoStatus is "offline"}}
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-page"></span>
{{/if}}
{{#if infoStatus is "pending"}}
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-amber-500 ring-2 ring-page"></span>
{{/if}}
      </span>
      <div class="{{ titleCls }}">
        <p title="{{ infoName }}" class="text-zinc-900 dark:text-zinc-50 text-[15px] font-semibold tracking-tight leading-tight truncate">{{ infoName or "Server" }}</p>
        <p class="text-zinc-500 text-[11px] leading-tight font-mono truncate">{{ infoHost or "Manage this server" }}</p>
      </div>
    </div>
    <button onclick="{{ toggle() }}" title="Collapse or expand sidebar" aria-label="Collapse or expand sidebar" class="{{ btnCls }}">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="{{ chevCls }}"><rect x="3" y="3.5" width="14" height="13" rx="3" /><path d="M8 3.5v13" /><path d="M13 8l-2 2 2 2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

{{#if infoName}}
  <span class="lg:hidden shrink-0 flex items-center gap-2 pr-3 mr-1 border-r border-line">
    <IconCpuChip class="w-4 h-4 shrink-0 text-zinc-500" />
    <span class="text-sm font-semibold text-slate-900 dark:text-slate-100 max-w-[9rem] truncate">{{ infoName }}</span>
  </span>
{{/if}}

  <details open class="tylix-sec group/sec flex shrink-0 items-center gap-1 lg:flex-col lg:items-stretch lg:shrink">
    <summary class="{{ headCls }}">
      This server
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

{{#if active is "server"}}
    <a href="{{ '/servers/server-detail?id=' + serverId }}" title="Overview" aria-current="page" class="{{ onCls }}">
      <IconGauge class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Overview</span>
    </a>
{{/if}}
{{#if active is not "server"}}
    <a href="{{ '/servers/server-detail?id=' + serverId }}" title="Overview" class="{{ offCls }}">
      <IconGauge class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Overview</span>
    </a>
{{/if}}

{{#if active is "sites"}}
    <a href="{{ '/servers/server-sites?id=' + serverId }}" title="Sites" aria-current="page" class="{{ onCls }}">
      <IconGlobe class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Sites</span>
    </a>
{{/if}}
{{#if active is not "sites"}}
    <a href="{{ '/servers/server-sites?id=' + serverId }}" title="Sites" class="{{ offCls }}">
      <IconGlobe class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Sites</span>
    </a>
{{/if}}

{{#if active is "databases"}}
    <a href="{{ '/servers/server-databases?id=' + serverId }}" title="Databases" aria-current="page" class="{{ onCls }}">
      <IconDatabase class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Databases</span>
    </a>
{{/if}}
{{#if active is not "databases"}}
    <a href="{{ '/servers/server-databases?id=' + serverId }}" title="Databases" class="{{ offCls }}">
      <IconDatabase class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Databases</span>
    </a>
{{/if}}

{{#if active is "backups"}}
    <a href="{{ '/servers/server-backups?id=' + serverId }}" title="Backups" aria-current="page" class="{{ onCls }}">
      <IconArchive class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Backups</span>
    </a>
{{/if}}
{{#if active is not "backups"}}
    <a href="{{ '/servers/server-backups?id=' + serverId }}" title="Backups" class="{{ offCls }}">
      <IconArchive class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Backups</span>
    </a>
{{/if}}
  </details>

  <div class="hidden lg:block h-3"></div>

  <details open class="tylix-sec group/sec flex shrink-0 items-center gap-1 lg:flex-col lg:items-stretch lg:shrink">
    <summary class="{{ headCls }}">
      Automation
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

{{#if active is "cron"}}
    <a href="{{ '/servers/server-cron-jobs?id=' + serverId }}" title="Cron jobs" aria-current="page" class="{{ onCls }}">
      <IconClock class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Cron jobs</span>
    </a>
{{/if}}
{{#if active is not "cron"}}
    <a href="{{ '/servers/server-cron-jobs?id=' + serverId }}" title="Cron jobs" class="{{ offCls }}">
      <IconClock class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Cron jobs</span>
    </a>
{{/if}}

{{#if active is "workers"}}
    <a href="{{ '/servers/server-workers?id=' + serverId }}" title="Workers" aria-current="page" class="{{ onCls }}">
      <IconCpuChip class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Workers</span>
    </a>
{{/if}}
{{#if active is not "workers"}}
    <a href="{{ '/servers/server-workers?id=' + serverId }}" title="Workers" class="{{ offCls }}">
      <IconCpuChip class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Workers</span>
    </a>
{{/if}}

{{#if active is "packages"}}
    <a href="{{ '/servers/server-packages?id=' + serverId }}" title="Packages" aria-current="page" class="{{ onCls }}">
      <IconPackage class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Packages</span>
    </a>
{{/if}}
{{#if active is not "packages"}}
    <a href="{{ '/servers/server-packages?id=' + serverId }}" title="Packages" class="{{ offCls }}">
      <IconPackage class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Packages</span>
    </a>
{{/if}}
  </details>

  <div class="hidden lg:block h-3"></div>

  <details open class="tylix-sec group/sec flex shrink-0 items-center gap-1 lg:flex-col lg:items-stretch lg:shrink">
    <summary class="{{ headCls }}">
      Security
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

{{#if active is "firewall"}}
    <a href="{{ '/servers/server-firewall?id=' + serverId }}" title="Firewall" aria-current="page" class="{{ onCls }}">
      <IconShieldCheck class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Firewall</span>
    </a>
{{/if}}
{{#if active is not "firewall"}}
    <a href="{{ '/servers/server-firewall?id=' + serverId }}" title="Firewall" class="{{ offCls }}">
      <IconShieldCheck class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Firewall</span>
    </a>
{{/if}}

{{#if active is "ssh-keys"}}
    <a href="{{ '/servers/server-ssh-keys?id=' + serverId }}" title="SSH Keys" aria-current="page" class="{{ onCls }}">
      <IconKey class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">SSH Keys</span>
    </a>
{{/if}}
{{#if active is not "ssh-keys"}}
    <a href="{{ '/servers/server-ssh-keys?id=' + serverId }}" title="SSH Keys" class="{{ offCls }}">
      <IconKey class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">SSH Keys</span>
    </a>
{{/if}}
  </details>

  <div class="hidden lg:block h-3"></div>

  <details open class="tylix-sec group/sec flex shrink-0 items-center gap-1 lg:flex-col lg:items-stretch lg:shrink">
    <summary class="{{ headCls }}">
      Monitor
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

{{#if active is "logs"}}
    <a href="{{ '/servers/server-logs?id=' + serverId }}" title="Logs" aria-current="page" class="{{ onCls }}">
      <IconDocumentText class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Logs</span>
    </a>
{{/if}}
{{#if active is not "logs"}}
    <a href="{{ '/servers/server-logs?id=' + serverId }}" title="Logs" class="{{ offCls }}">
      <IconDocumentText class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Logs</span>
    </a>
{{/if}}

{{#if active is "terminal"}}
    <a href="{{ '/servers/server-terminal?id=' + serverId }}" title="Terminal" aria-current="page" class="{{ onCls }}">
      <IconTerminal class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Terminal</span>
    </a>
{{/if}}
{{#if active is not "terminal"}}
    <a href="{{ '/servers/server-terminal?id=' + serverId }}" title="Terminal" class="{{ offCls }}">
      <IconTerminal class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Terminal</span>
    </a>
{{/if}}
  </details>

  <div class="shrink-0 flex flex-col ml-auto lg:ml-0 lg:mt-auto lg:pt-3 lg:border-t border-line">
{{#if active is "settings"}}
    <a href="{{ '/servers/server-settings?id=' + serverId }}" title="Settings" aria-current="page" class="{{ onCls }}">
      <IconCog class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Settings</span>
    </a>
{{/if}}
{{#if active is not "settings"}}
    <a href="{{ '/servers/server-settings?id=' + serverId }}" title="Settings" class="{{ offCls }}">
      <IconCog class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Settings</span>
    </a>
{{/if}}
  </div>
</aside>