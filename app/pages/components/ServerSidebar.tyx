{{/if}}

{{#if active is "terminal"}}
  <a href="{{ '/servers/server-terminal?id=' + serverId }}" title="Terminal" aria-current="page" class="{{ onCls }}">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-emerald-500"></span>
    <IconTerminal class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" /> <span class="{{ labelCls }}">Terminal</span>
  </a>
{{/if}}
{{#if active is not "terminal"}}
  <a href="{{ '/servers/server-terminal?id=' + serverId }}" title="Terminal" class="{{ offCls }}">
    <IconTerminal class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> <span class="{{ labelCls }}">Terminal</span>
  </a>
{{/if}}
  </details>

  <div class="shrink-0 flex flex-col ml-auto lg:ml-0 lg:mt-auto lg:pt-3 lg:border-t border-slate-300 dark:border-slate-800">
{{#if active is "settings"}}
    <a href="{{ '/servers/server-settings?id=' + serverId }}" title="Settings" aria-current="page" class="{{ onCls }}">
      <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-emerald-500"></span>
      <IconCog class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" /> <span class="{{ labelCls }}">Settings</span>
    </a>
{{/if}}
{{#if active is not "settings"}}
    <a href="{{ '/servers/server-settings?id=' + serverId }}" title="Settings" class="{{ offCls }}">
      <IconCog class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> <span class="{{ labelCls }}">Settings</span>
    </a>
{{/if}}
  </div>
</aside>