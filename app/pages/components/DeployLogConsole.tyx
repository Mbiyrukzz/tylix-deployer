component DeployLogConsole

import { IconX, IconCopy, IconMaximize, IconMinimize, IconDocumentText } from "tylix-icons"

// The deployment log, popped over the deployment page in the same console
// window as the terminal (ConsoleDock): steps down the side, the log in a
// glowing well with a minimap of errors, and a status bar. The page owns
// the log and its filtering and scrolling; this works out the step list,
// the minimap and the window chrome from what it's given.
//
// The scrolling element is #deploy-log-scroll: the page follows the end
// of a live log and jumps to lines through it.

props
  site: Object
  viewId: any
  logStatus: String
  lines: any
  shown: any
  tabs: any
  filter: String
  text: String
  loading: Boolean
  atBottom: Boolean
  copied: Boolean
  errors: any
  warns: any
  stages: any
  queuedText: String
  elapsed: String
  deployedText: String
  canCancel: Boolean
  cancelling: Boolean
  onClose: Function
  onCopy: Function
  onFilter: Function
  onJumpLine: Function
  onJumpError: Function
  onJumpBottom: Function
  onCancel: Function

state
  full: false

computed
  live() {
    return this.viewId is "" and this.logStatus is "deploying"
  }

  nav() {
    const stages = this.lines.filter((l) => l.isStage)
    const last = stages.length - 1
    return stages.map((s, i) => this.navItem(s, i, last, i < last ? stages[i + 1].n : Number.MAX_SAFE_INTEGER))
  }

  map() {
    const lines = this.lines
    const total = lines.length
    if total < 12 {
      return []
    }
    const count = Math.min(80, total)
    const size = total / count
    return Array.from({ length: count }, (x, i) => this.mapCell(lines.slice(Math.floor(i * size), Math.floor((i + 1) * size))))
  }

  statusText() {
    const st = this.logStatus
    if st is "queued" {
      return "Queued"
    }
    if st is "deploying" {
      return this.cancelling ? "Cancelling" : "Deploying"
    }
    if st is "success" {
      return "Deployed"
    }
    if st is "failed" {
      return "Failed"
    }
    if st is "cancelled" {
      return "Cancelled"
    }
    return "Not deployed"
  }

  orbCls() {
    const base = "relative w-2.5 h-2.5 shrink-0 rounded-full "
    const st = this.logStatus
    if st is "deploying" {
      return base + "bg-amber-400 animate-pulse shadow-[0_0_10px_rgb(251_191_36/0.7)]"
    }
    if st is "queued" {
      return base + "bg-sky-400 animate-pulse shadow-[0_0_10px_rgb(56_189_248/0.6)]"
    }
    if st is "success" {
      return base + "bg-emerald-400 shadow-[0_0_10px_rgb(52_211_153/0.7)]"
    }
    if st is "failed" {
      return base + "bg-brand-500 shadow-[0_0_10px_rgb(240_103_107/0.7)]"
    }
    if st is "cancelled" {
      return base + "bg-orange-400 shadow-[0_0_10px_rgb(251_146_60/0.6)]"
    }
    return base + "bg-zinc-600"
  }

  outerCls() {
    if this.full {
      return "cx-root fixed inset-0 z-[70] flex"
    }
    return "cx-root fixed inset-0 z-[70] flex items-stretch sm:items-center justify-center sm:p-5 lg:p-8"
  }

  windowCls() {
    const base = "cx-shell cx-grain cx-pop relative flex w-full overflow-hidden text-zinc-200 "
    if this.full {
      return base + "h-full"
    }
    return base + "h-full sm:h-[min(880px,calc(100vh-2.5rem))] max-w-[1380px] sm:rounded-[22px]"
  }

action
  // One step in the side list: its state comes from where it sits (only the
  // last step can be running, failed or cancelled) and the run's status.
  navItem(s, i, last, nextN) {
    const st = this.logStatus
    let state = "done"
    if i is last and st is "deploying" {
      state = "running"
    }
    if i is last and st is "failed" {
      state = "failed"
    }
    if i is last and st is "cancelled" {
      state = "cancelled"
    }

    const errors = this.lines.filter((l) => l.kind is "error" and l.n > s.n and l.n < nextN).length

    let badge = "bg-emerald-400/10 text-emerald-300 shadow-[inset_0_0_0_1px_rgb(52_211_153/0.25)]"
    let icon = "✓"
    if state is "running" {
      badge = "bg-amber-400/10 text-amber-300 shadow-[inset_0_0_0_1px_rgb(251_191_36/0.35)]"
      icon = ""
    }
    if state is "failed" or (state is "done" and errors > 0) {
      badge = "bg-brand-500/15 text-brand-300 shadow-[inset_0_0_0_1px_rgb(240_103_107/0.35)]"
      icon = state is "failed" ? "✕" : "!"
    }
    if state is "cancelled" {
      badge = "bg-orange-400/10 text-orange-300 shadow-[inset_0_0_0_1px_rgb(251_146_60/0.3)]"
      icon = "■"
    }

    return {
      n: s.n,
      step: i + 1,
      text: s.text,
      icon: icon,
      running: state is "running",
      errors: errors,
      on: state is "running" or state is "failed" or state is "cancelled",
      badgeCls: "w-6 h-6 shrink-0 inline-flex items-center justify-center rounded-lg text-[10.5px] font-semibold " + badge
    }
  }

  // One minimap cell: the worst thing in its slice of the log wins.
  mapCell(chunk) {
    const err = chunk.find((l) => l.kind is "error")
    const warn = chunk.find((l) => l.kind is "warn")
    const stage = chunk.find((l) => l.isStage)
    let n = chunk.length > 0 ? chunk[0].n : 0
    let cls = "bg-white/[0.05]"
    if stage {
      n = stage.n
      cls = "bg-zinc-500/50"
    }
    if warn {
      n = warn.n
      cls = "bg-amber-400/70"
    }
    if err {
      n = err.n
      cls = "bg-brand-400 shadow-[0_0_6px_rgb(240_103_107/0.6)]"
    }
    return { n: n, cls: "flex-1 min-h-[2px] w-full rounded-[1px] hover:brightness-150 transition " + cls }
  }

  toggleFull() {
    this.full = not this.full
  }

  dismiss() {
    this.onClose()
  }

  copy() {
    this.onCopy()
  }

  pick(key) {
    this.onFilter(key)
  }

  jumpLine(n) {
    this.onJumpLine(n)
  }

  jumpError() {
    this.onJumpError()
  }

  bottom() {
    this.onJumpBottom()
  }

  cancel() {
    this.onCancel()
  }

template
<div class="{{ outerCls }}">
  <div onclick="{{ dismiss() }}" aria-hidden="true" class="cx-fade cx-grain absolute inset-0 bg-[#050506]/75 backdrop-blur-md"></div>

  <div role="dialog" aria-modal="true" aria-label="Deployment log" class="{{ windowCls }}">

    <!-- rail -->
    <nav aria-label="Console" class="hidden md:flex w-[64px] shrink-0 flex-col items-center gap-2 py-3 border-r border-white/[0.05] bg-black/25">
      <span aria-hidden="true" class="mb-2 w-10 h-10 rounded-xl flex items-center justify-center bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-[0_0_24px_-4px_rgb(240_103_107/0.7),inset_0_1px_0_rgb(255_255_255/0.25)]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </span>
      <span title="Deployment log" class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-white/[0.08] text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)]">
        <IconDocumentText class="w-5 h-5" />
{{#if errors is not 0}}
        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-brand-500 text-white text-[10px] font-bold leading-[18px] text-center ring-2 ring-[#111113]">{{ errors > 99 ? "99+" : errors }}</span>
{{/if}}
      </span>
      <div class="mt-auto flex flex-col items-center gap-1">
        <button onclick="{{ toggleFull() }}" title="{{ full ? 'Exit full screen' : 'Full screen' }}" aria-label="Toggle full screen" class="cx-icon-btn">
{{#if full}}
          <IconMinimize class="w-4 h-4" />
{{#else}}
          <IconMaximize class="w-4 h-4" />
{{/if}}
        </button>
      </div>
    </nav>

    <div class="flex-1 min-w-0 flex flex-col">

      <!-- header -->
      <header class="flex items-center gap-2 sm:gap-3 h-14 shrink-0 px-2.5 sm:px-4 border-b border-white/[0.05]">
        <div class="min-w-0 flex items-center gap-3 pl-2 pr-2.5 py-1.5">
          <span class="{{ orbCls }}"></span>
          <span class="min-w-0">
            <span class="block font-mono text-[13px] sm:text-[13.5px] text-zinc-100 truncate leading-tight">{{ site.domain }}</span>
            <span class="block text-[11px] text-zinc-300 truncate leading-tight mt-0.5">{{ viewId ? "Deployment #" + viewId : "Latest deployment" }} · {{ statusText }}{{#if live}}{{#if elapsed}} · {{ elapsed }}{{/if}}{{/if}}</span>
          </span>
        </div>

        <div class="ml-auto flex items-center gap-1">
{{#if errors is not 0}}
          <button onclick="{{ jumpError() }}" class="inline-flex shrink-0 items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-brand-300 hover:text-white bg-brand-500/10 hover:bg-brand-500/25 shadow-[inset_0_0_0_1px_rgb(240_103_107/0.3)] transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400 shadow-[0_0_8px_rgb(240_103_107/0.9)]"></span> First error
          </button>
{{/if}}
{{#if canCancel}}
{{#if cancelling}}
          <span class="hidden sm:inline-flex items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-orange-300 bg-orange-400/10 shadow-[inset_0_0_0_1px_rgb(251_146_60/0.3)]">
            <span class="w-3 h-3 rounded-full border-2 border-current border-t-transparent animate-spin"></span> Cancelling…
          </span>
{{#else}}
          <button onclick="{{ cancel() }}" title="Cancel this deployment" class="inline-flex items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-zinc-200 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
            Cancel
          </button>
{{/if}}
{{/if}}
          <button onclick="{{ copy() }}" title="Copy the log" aria-label="Copy the log" class="cx-icon-btn">
{{#if copied}}
            <span class="text-[11px] font-medium text-emerald-300">Copied</span>
{{#else}}
            <IconCopy class="w-4 h-4" />
{{/if}}
          </button>
          <span class="hidden sm:block w-px h-5 mx-1.5 bg-white/[0.07]"></span>
          <button onclick="{{ toggleFull() }}" title="Full screen" aria-label="Toggle full screen" class="cx-icon-btn md:hidden">
{{#if full}}
            <IconMinimize class="w-4 h-4" />
{{#else}}
            <IconMaximize class="w-4 h-4" />
{{/if}}
          </button>
          <button onclick="{{ dismiss() }}" title="Close (Esc)" aria-label="Close" class="cx-icon-btn hover:!bg-brand-500/20 hover:!text-brand-200"><IconX class="w-4 h-4" /></button>
        </div>
      </header>

      <!-- body -->
      <div class="relative flex-1 min-h-0 flex">

        <!-- steps -->
        <aside class="hidden lg:flex w-[264px] shrink-0 flex-col gap-1 p-3 pr-0 overflow-y-auto cx-scroll">
          <p class="px-2.5 pt-1 pb-2 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-300">Steps</p>
{{#each s in nav}}
          <button onclick="{{ jumpLine(s.n) }}" title="{{ s.text }}" class="{{ s.on ? 'w-full flex items-center gap-3 rounded-xl px-2.5 py-2 text-left bg-white/[0.06] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.06)] transition-colors' : 'w-full flex items-center gap-3 rounded-xl px-2.5 py-2 text-left hover:bg-white/[0.04] transition-colors' }}">
{{#if s.running}}
            <span class="{{ s.badgeCls }}"><span class="w-3 h-3 rounded-full border-2 border-amber-300 border-t-transparent animate-spin"></span></span>
{{#else}}
            <span class="{{ s.badgeCls }}">{{ s.icon }}</span>
{{/if}}
            <span class="min-w-0 flex-1">
              <span class="block text-[12.5px] font-medium text-zinc-100 truncate">{{ s.text }}</span>
              <span class="block text-[11px] text-zinc-400 font-mono">
                step {{ s.step }}{{#if s.running}} · running{{/if}}{{#if s.errors is not 0}} · <span class="text-brand-300">{{ s.errors }} {{ s.errors is 1 ? "error" : "errors" }}</span>{{/if}}
              </span>
            </span>
          </button>
{{#else}}
          <p class="px-2.5 text-[12px] text-zinc-400">{{ loading ? "Reading the log…" : "No steps yet." }}</p>
{{/each}}

          <div class="mt-auto pt-4 px-2.5">
            <div class="cx-well rounded-xl p-3">
              <p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-300 mb-2">This run</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-3">
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums {{ errors > 0 ? 'text-brand-300' : 'text-emerald-300' }}">{{ errors }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">errors</p>
                </div>
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums {{ warns > 0 ? 'text-amber-300' : 'text-zinc-100' }}">{{ warns }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">warnings</p>
                </div>
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums text-zinc-100">{{ stages }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">steps</p>
                </div>
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums text-zinc-100">{{ lines.length }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">lines</p>
                </div>
              </div>
            </div>
          </div>
        </aside>

        <div class="flex-1 min-w-0 flex flex-col gap-2 p-2 sm:p-3">
          <!-- toolbar -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
{{#each t in tabs}}
            <button onclick="{{ pick(t.key) }}" aria-pressed="{{ t.key is filter }}" class="cx-chip">
              {{ t.label }}
              <span class="font-mono text-[11px] opacity-70 tabular-nums">{{ t.count }}</span>
            </button>
{{/each}}
{{#if live}}
            <span class="ml-auto shrink-0 inline-flex items-center gap-1.5 text-[11.5px] text-zinc-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> {{ atBottom ? "Following output" : "Paused, scrolled up" }}
            </span>
{{/if}}
          </div>

          <!-- stream -->
          <div class="cx-frame cx-well relative z-[1] flex-1 min-h-0 rounded-2xl overflow-hidden flex" data-live="{{ live }}" data-tone="{{ logStatus is 'failed' ? 'warn' : 'ok' }}">
{{#if logStatus is "deploying"}}
            <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px z-[3] overflow-hidden">
              <div class="cx-scanline h-full w-full bg-gradient-to-r from-transparent via-brand-400 to-transparent"></div>
            </div>
{{/if}}
            <div id="deploy-log-scroll" class="flex-1 min-w-0 overflow-auto overscroll-contain cx-scroll py-3 font-mono font-medium text-[12.5px] leading-6">
              <p class="px-3 sm:px-4 pb-2 text-zinc-300 break-all"><span class="text-brand-300">{{ site.isolated_user ? site.isolated_user + "@" + site.domain : site.domain }}</span><span class="text-zinc-400">:~$</span> <span class="text-zinc-200">deploy {{ site.branch }}{{ viewId ? " #" + viewId : "" }}</span></p>

{{#if loading}}
              <div class="px-3 sm:px-4 space-y-2 pt-1" aria-label="Loading">
                <p class="flex items-center gap-2 text-zinc-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span> Reading the log…</p>
                <div class="h-3 w-2/3 rounded bg-white/[0.04] animate-pulse"></div>
                <div class="h-3 w-1/2 rounded bg-white/[0.04] animate-pulse"></div>
                <div class="h-3 w-3/4 rounded bg-white/[0.04] animate-pulse"></div>
              </div>
{{/if}}

{{#if not loading}}
{{#if text}}
{{#if shown.length is 0}}
              <div class="px-3 sm:px-4 py-6">
                <p class="text-emerald-300">Nothing matches this filter.</p>
                <p class="text-zinc-400">Pick All to see every line.</p>
              </div>
{{/if}}
{{#each l in shown}}
{{#if l.isStage}}
              <div id="log-line-{{ l.n }}" class="mt-5 mb-1.5 flex items-center gap-3 px-3 sm:px-4 scroll-mt-4">
                <span class="w-1.5 h-1.5 shrink-0 rounded-[2px] bg-brand-400 shadow-[0_0_8px_rgb(240_103_107/0.8)]"></span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-200 [overflow-wrap:anywhere]">{{ l.text }}</span>
                <span class="h-px flex-1 bg-gradient-to-r from-white/[0.08] to-transparent"></span>
              </div>
{{/if}}
{{#if not l.isStage}}
              <div id="log-line-{{ l.n }}" class="flex items-start border-l-2 hover:bg-white/[0.03] {{ l.rowCls }}">
                <span class="w-12 shrink-0 pr-3 text-right text-zinc-600 tabular-nums select-none">{{ l.n }}</span>
                <span class="w-4 shrink-0 text-center select-none opacity-80 {{ l.cls }}">{{ l.icon }}</span>
                <span class="min-w-0 flex-1 pl-2 pr-4 whitespace-pre-wrap [overflow-wrap:anywhere] {{ l.cls }}">{{#if l.ts}}<span class="text-zinc-500 mr-2">{{ l.ts }}</span>{{/if}}{{ l.text }}</span>
              </div>
{{/if}}
{{/each}}
{{/if}}
{{#if not text}}
{{#if logStatus is "queued"}}
              <p class="px-3 sm:px-4 flex items-center gap-2 text-sky-300"><span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span> {{ queuedText or "Waiting in the queue…" }}</p>
{{#else}}
              <p class="px-3 sm:px-4 text-zinc-400">No output yet.</p>
{{/if}}
{{/if}}
{{#if live}}
              <p class="px-3 sm:px-4 pt-2 text-zinc-300"><span class="inline-block w-[7px] h-[14px] -mb-[2px] bg-brand-400/80 animate-pulse"></span></p>
{{/if}}
{{/if}}
            </div>

            <!-- minimap -->
{{#if map.length is not 0}}
{{#if filter is "all"}}
            <div class="hidden sm:flex w-4 shrink-0 flex-col gap-px py-3 pr-1.5 pl-0.5 border-l border-white/[0.03]" aria-hidden="true">
{{#each m in map}}
              <button tabindex="-1" onclick="{{ jumpLine(m.n) }}" class="{{ m.cls }}"></button>
{{/each}}
            </div>
{{/if}}
{{/if}}

{{#if not atBottom}}
            <button onclick="{{ bottom() }}" class="cx-pop absolute bottom-3 right-6 z-[4] inline-flex items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-semibold text-white bg-brand-500 hover:bg-brand-400 shadow-[0_0_24px_-6px_rgb(240_103_107/0.8)] transition-colors">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M10 4v12M5 11l5 5 5-5" /></svg>
              Jump to bottom
            </button>
{{/if}}
          </div>
        </div>
      </div>

      <!-- status bar -->
      <footer class="shrink-0 flex items-center gap-3 h-9 px-3 sm:px-4 border-t border-white/[0.05] bg-black/20 text-[11px] text-zinc-300">
        <span class="flex items-center gap-1.5 shrink-0"><span class="{{ orbCls }} !w-1.5 !h-1.5"></span>{{ statusText }}</span>
        <span><span class="font-mono text-zinc-200">{{ shown.length }}</span> shown</span>
        <span><span class="font-mono {{ errors > 0 ? 'text-brand-300' : 'text-zinc-200' }}">{{ errors }}</span> errors</span>
        <span class="hidden sm:inline"><span class="font-mono {{ warns > 0 ? 'text-amber-300' : 'text-zinc-200' }}">{{ warns }}</span> warnings</span>
{{#if deployedText}}
        <span class="hidden md:inline truncate">last deployed <span class="font-mono text-zinc-200">{{ deployedText }} UTC</span></span>
{{/if}}
        <span class="ml-auto hidden sm:flex items-center gap-1.5"><span class="cx-kbd">Esc</span> close</span>
      </footer>
    </div>
  </div>
</div>
