component DeployStatusCard

// The top card on the deployment page: where the site stands, the Deploy
// now / Cancel button, and a strip with the branch, the live commit, the
// success rate and the Script / Environment buttons. The page owns all the
// state; this only shows it and reports clicks.

props
  title: String
  sub: String
  dotCls: String
  elapsed: String
  idle: String
  busy: Boolean
  cancelling: Boolean
  locked: Boolean
  saved: Boolean
  branch: String
  commit: Object
  runs: any
  successRate: any
  rateStyle: String
  hasEnv: Boolean
  onDeploy: Function
  onCancel: Function
  onScript: Function
  onEnv: Function

action
  deploy() {
    this.onDeploy()
  }

  cancel() {
    this.onCancel()
  }

  script() {
    this.onScript()
  }

  env() {
    this.onEnv()
  }

template
<div class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
  <div class="p-6 sm:p-7">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 shrink-0 rounded-full {{ dotCls }}"></span>
          <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100">{{ title }}</h2>
{{#if elapsed}}
          <span class="text-xs font-mono text-slate-500">{{ elapsed }}</span>
{{/if}}
        </div>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500 [overflow-wrap:anywhere]">{{ sub }}</p>
      </div>

      <div class="shrink-0">
{{#if busy}}
        <div class="flex flex-wrap items-center gap-3">
{{#if cancelling}}
          <button disabled class="inline-flex items-center gap-2 text-sm text-orange-600 dark:text-orange-400 border border-orange-500/40 rounded-full px-5 py-2.5 opacity-70">
            <span class="w-3.5 h-3.5 rounded-full border-2 border-current border-t-transparent animate-spin"></span> Cancelling…
          </button>
{{#else}}
          <button onclick="{{ cancel() }}" class="inline-flex items-center gap-2 text-sm text-rose-600 dark:text-rose-400 border border-rose-500/40 rounded-full px-5 py-2.5 hover:bg-rose-500/10 transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
            Cancel
          </button>
{{/if}}
        </div>
{{#else}}
{{#if locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-6 py-2.5 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Deploy now
        </button>
{{#else}}
        <button onclick="{{ deploy() }}" class="inline-flex items-center gap-2 text-sm bg-brand-500 text-white font-semibold rounded-full px-6 py-2.5 shadow-sm hover:bg-brand-400 hover:shadow transition-all">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
          Deploy now
        </button>
{{/if}}
{{/if}}
      </div>
    </div>

{{#if idle}}
    <p class="mt-5 max-w-2xl rounded-lg border border-amber-500/30 bg-amber-500/5 px-3.5 py-2.5 text-xs leading-relaxed text-amber-700 dark:text-amber-400">No output for {{ idle }}. If the app was restarted, this deployment is marked failed automatically within a couple of minutes. You can also cancel it.</p>
{{/if}}
{{#if saved}}
    <p class="mt-4 text-sm text-brand-700 dark:text-brand-500">Saved.</p>
{{/if}}
  </div>

  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-line bg-slate-50/70 dark:bg-slate-950/30 px-6 sm:px-7 py-3.5">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-500">
      <span class="inline-flex items-center gap-1.5 font-mono max-w-[16rem]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 shrink-0"><circle cx="6" cy="6" r="2.5" /><circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="8" r="2.5" /><path d="M6 8.5v7M18 10.5c0 4-12 2-12 5.5" /></svg>
        <span class="truncate">{{ branch }}</span>
      </span>
{{#if commit}}
{{#if commit.commitUrl}}
      <a href="{{ commit.commitUrl }}" target="_blank" rel="noopener noreferrer" title="{{ commit.commitTitle }}" class="inline-flex items-center gap-1 font-mono text-slate-600 dark:text-slate-300 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
        {{ commit.shortCommit }}
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 opacity-60"><path d="M6 14L14 6M7 6h7v7" /></svg>
      </a>
{{#else}}
      <span class="font-mono text-slate-600 dark:text-slate-300">{{ commit.shortCommit }}</span>
{{/if}}
{{/if}}
{{#if runs is not 0}}
      <span class="inline-flex items-center gap-2">
        <span class="h-1.5 w-16 overflow-hidden rounded-full bg-rose-500/20"><span class="block h-full rounded-full bg-brand-500 transition-all" style="{{ rateStyle }}"></span></span>
        {{ successRate }}% success
      </span>
{{/if}}
    </div>
    <div class="flex items-center gap-1">
      <button onclick="{{ script() }}" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition-colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M4 17l6-6-6-6M12 19h8" /></svg>
        Script
      </button>
{{#if hasEnv}}
      <button onclick="{{ env() }}" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-800 transition-colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        Environment
      </button>
{{/if}}
    </div>
  </div>
</div>
