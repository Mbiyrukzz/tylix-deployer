component ProviderForm

import { IconPlus, IconX } from "tylix-icons"

props
  provider: Object
  onSaved: Function

state
  showModal: false
  kind: "linode"
  kinds: []
  label: ""
  apiToken: ""
  saving: false
  error: ""
  labelError: ""
  tokenError: ""
  tokenPlaceholder: ""

action
  clearErrors() {
    this.error = ""
    this.labelError = ""
    this.tokenError = ""
  }

  reset() {
    this.kind = "linode"
    this.label = ""
    this.apiToken = ""
    this.tokenPlaceholder = ""
    this.saving = false
    this.clearErrors()
  }

  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  // The provider choices shown in create mode. Adding a provider = one more entry here.
  buildKinds() {
    this.kinds = [
      {
        id: "linode",
        name: "Linode",
        sub: "Akamai",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-emerald-500/10 text-emerald-700 dark:text-emerald-500 flex items-center justify-center font-bold",
        letter: "L"
      },
      {
        id: "hetzner",
        name: "Hetzner",
        sub: "Cloud",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold",
        letter: "H"
      },
      {
        id: "digitalocean",
        name: "DigitalOcean",
        sub: "Droplets",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold",
        letter: "D"
      }
    ]
  }

  // Create mode only: the provider type is fixed once the connection exists.
  pick(kind) {
    this.kind = kind
    this.tokenError = ""
    this.error = ""
  }

  open() {
    this.reset()
    this.buildKinds()
    if this.provider {
      this.label = this.provider.label
      this.kind = this.provider.kind
      this.tokenPlaceholder = "Leave blank to keep the current token"
    }
    this.showModal = true
  }

  close() {
    this.showModal = false
    this.reset()
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()
    this.saving = true

    // When editing, the existing connection's kind is sent. The server ignores
    // it anyway and verifies against the stored kind.
    const payload = {
      kind: this.provider ? this.provider.kind : this.kind,
      label: this.label,
      api_token: this.apiToken
    }
    const url = this.provider ? "/api/providers/" + this.provider.id : "/api/providers"
    const method = this.provider ? "PUT" : "POST"

    const result = await useApi(url, { method: method, body: payload })

    if result.ok {
      this.onSaved(result.data)
      this.close()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.labelError = this.firstError(errors, "label")
      this.tokenError = this.firstError(errors, "api_token")
      this.error = result.data?.error or result.error or ""
      if not this.labelError and not this.tokenError and not this.error {
        this.error = "Couldn't save the connection. Try again."
      }
      this.saving = false
    }
  }

template
{{#if provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center text-sm font-medium text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
    Edit
  </button>
{{/if}}
{{#if not provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
    <IconPlus class="w-4 h-4" /> Connect provider
  </button>
{{/if}}

{{#if showModal}}
  <div role="dialog" aria-modal="true" aria-labelledby="provider-form-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm px-6">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl p-6">

      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h3 id="provider-form-title" class="text-slate-900 dark:text-slate-100 text-lg font-semibold">
{{#if provider}}
            Edit connection
{{/if}}
{{#if not provider}}
            Connect a cloud provider
{{/if}}
          </h3>
{{#if provider}}
          <p class="text-slate-500 text-sm mt-0.5">Rename it, or paste a new token to replace the stored one.</p>
{{/if}}
{{#if not provider}}
          <p class="text-slate-500 text-sm mt-0.5">The deployer creates servers in this account for you.</p>
{{/if}}
        </div>
        <button onclick="{{ close() }}" aria-label="Close" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <IconX class="w-4 h-4" />
        </button>
      </div>

{{#if not provider}}
      <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Provider</p>
      <div class="grid grid-cols-2 gap-3 mb-5">
{{#each k in kinds}}
{{#if kind is k.id}}
        <button onclick="{{ pick(k.id) }}" aria-pressed="true" class="flex items-center gap-3 rounded-xl border-2 border-emerald-500 bg-emerald-500/5 px-4 py-3 text-left transition-colors">
          <span class="{{ k.tileClass }}">{{ k.letter }}</span>
          <span class="min-w-0">
            <span class="block text-slate-900 dark:text-slate-100 text-sm font-semibold">{{ k.name }}</span>
            <span class="block text-slate-500 text-xs">{{ k.sub }}</span>
          </span>
        </button>
{{/if}}
{{#if kind is not k.id}}
        <button onclick="{{ pick(k.id) }}" aria-pressed="false" class="flex items-center gap-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 px-4 py-3 text-left hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <span class="{{ k.tileClass }}">{{ k.letter }}</span>
          <span class="min-w-0">
            <span class="block text-slate-900 dark:text-slate-100 text-sm font-semibold">{{ k.name }}</span>
            <span class="block text-slate-500 text-xs">{{ k.sub }}</span>
          </span>
        </button>
{{/if}}
{{/each}}
      </div>
{{/if}}

      <label for="provider-label" class="block text-slate-500 text-xs font-medium mb-1.5">Connection name</label>
      <input
        id="provider-label"
        type="text"
        autofocus
        value="{{ label }}"
        oninput="{{ label = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="e.g. Production account"
      />
{{#if labelError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ labelError }}</p>
{{/if}}

      <label for="provider-token" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API token</label>
      <input
        id="provider-token"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ apiToken }}"
        oninput="{{ apiToken = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if tokenError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ tokenError }}</p>
{{/if}}

{{#if not provider}}
      <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 p-4 mt-4">
{{#if kind is "linode"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a Linode token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://cloud.linode.com/profile/tokens" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-500 hover:underline">Profile &rarr; API Tokens</a> in Linode Cloud Manager.</li>
          <li>Create a personal access token.</li>
          <li>Give it <span class="font-mono">Linodes: Read/Write</span>. Everything else can stay on No Access.</li>
        </ol>
{{/if}}
{{#if kind is "hetzner"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a Hetzner token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open your project in the <a href="https://console.hetzner.cloud/" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-500 hover:underline">Hetzner Cloud Console</a>.</li>
          <li>Go to Security &rarr; API tokens and generate one.</li>
          <li>Give it <span class="font-mono">Read &amp; Write</span> permission. A Read-only token connects fine but can't create servers.</li>
        </ol>
{{/if}}
{{#if kind is "digitalocean"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a DigitalOcean token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://cloud.digitalocean.com/account/api/tokens" target="_blank" rel="noopener noreferrer" class="text-emerald-700 dark:text-emerald-500 hover:underline">API &rarr; Tokens</a> in the DigitalOcean control panel.</li>
          <li>Generate a new personal access token.</li>
          <li>Give it <span class="font-mono">Full Access</span>, or a custom scope that can create, read and delete droplets and read regions, sizes and images. A read-only token connects fine but can't create servers.</li>
        </ol>
{{/if}}
        <p class="text-slate-400 text-xs mt-3">The token is checked with the provider, encrypted before it is stored, and never shown again.</p>
      </div>
{{/if}}

{{#if provider}}
      <p class="text-slate-400 text-xs mt-3">The current token is stored encrypted and is never shown.</p>
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3 mt-6">
        <button onclick="{{ close() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">
          Cancel
        </button>
{{#if saving}}
        <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">
          Verifying…
        </button>
{{/if}}
{{#if not saving}}
        <button onclick="{{ submit() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
          Save
        </button>
{{/if}}
      </div>

    </div>
  </div>
{{/if}}