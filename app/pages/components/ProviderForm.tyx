component ProviderForm

import { IconPlus, IconX } from "tylix-icons"

props
  provider: Object
  onSaved: Function

state
  showModal: false
  kind: "linode"
  kinds: []
  label: ""
  apiToken: ""
  accessKeyId: ""
  secretKey: ""
  saving: false
  error: ""
  labelError: ""
  tokenError: ""
  accessKeyError: ""
  secretKeyError: ""
  tokenPlaceholder: ""
  mode: "token"
  username: ""
  password: ""
  clientId: ""
  clientSecret: ""
  apiUser: ""
  apiPassword: ""
  usernameError: ""
  passwordError: ""
  clientIdError: ""
  clientSecretError: ""
  apiUserError: ""
  apiPasswordError: ""
  twoFactorOn: false
  tfTotp: false
  tfSms: false
  smsHint: ""
  codeOpen: false
  code: ""
  codeError: ""
  smsSending: false
  smsNotice: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  syncMode() {
    let m = "token"
    if this.kind is "aws" {
      m = "aws"
    }
    if this.kind is "upcloud" {
      m = "upcloud"
    }
    if this.kind is "contabo" {
      m = "contabo"
    }
    this.mode = m
  }

  clearErrors() {
    this.error = ""
    this.labelError = ""
    this.tokenError = ""
    this.accessKeyError = ""
    this.secretKeyError = ""
    this.usernameError = ""
    this.passwordError = ""
    this.clientIdError = ""
    this.clientSecretError = ""
    this.apiUserError = ""
    this.apiPasswordError = ""
    this.codeError = ""
  }

  reset() {
    this.kind = "linode"
    this.mode = "token"
    this.label = ""
    this.apiToken = ""
    this.accessKeyId = ""
    this.secretKey = ""
    this.username = ""
    this.password = ""
    this.clientId = ""
    this.clientSecret = ""
    this.apiUser = ""
    this.apiPassword = ""
    this.tokenPlaceholder = ""
    this.saving = false
    this.codeOpen = false
    this.code = ""
    this.codeError = ""
    this.smsNotice = ""
    this.smsSending = false
    this.clearErrors()
  }

  // True when any credential input has something typed in. Only then is a code needed.
  hasCredentials() {
    return this.apiToken.trim() is not "" or this.accessKeyId.trim() is not "" or this.secretKey.trim() is not "" or this.username.trim() is not "" or this.password.trim() is not "" or this.clientId.trim() is not "" or this.clientSecret.trim() is not "" or this.apiUser.trim() is not "" or this.apiPassword.trim() is not ""
  }

  // Which second factors this account has on.
  async loadTwoFactor() {
    const result = await useApi("/api/account")
    if result.ok and result.data and result.data.two_factor {
      const tf = result.data.two_factor
      const sms = tf.sms
      this.tfTotp = Boolean(tf.enabled)
      this.tfSms = Boolean(sms and sms.enabled)
      this.smsHint = (sms and sms.phone_hint) or ""
      this.twoFactorOn = this.tfTotp or this.tfSms
    }
  }

  async sendCode() {
    if this.smsSending {
      return null
    }

    this.smsSending = true
    this.codeError = ""
    this.smsNotice = ""

    const result = await useApi("/api/account/two-factor/sms/send-code", { method: "POST" })

    this.smsSending = false

    if result.ok {
      this.smsNotice = "Code sent to " + this.smsHint + "."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.codeError = result.data?.error or "Couldn't send the code."
    }
  }

  // Shows the code box. When SMS is the only method, the code is texted right away.
  async openCodeStep() {
    this.codeOpen = true
    this.codeError = ""
    this.smsNotice = ""

    if this.tfSms and not this.tfTotp {
      await this.sendCode()
    }
  }

  // True when the form must NOT be sent yet (the code box was just opened,
  // or the code is still empty).
  async needsCode() {
    if not this.provider or not this.hasCredentials() or not this.twoFactorOn {
      return false
    }

    if not this.codeOpen {
      await this.openCodeStep()
      return true
    }

    if this.code.trim() is "" {
      this.codeError = "Enter a verification code to continue."
      return true
    }

    return false
  }

  // The server says a code is needed (status call failed or was stale).
  applyTwoFactorRequired(data) {
    const methods = data.methods or []
    this.twoFactorOn = true
    this.tfTotp = methods.includes("totp")
    this.tfSms = methods.includes("sms")
    this.codeOpen = true
    this.codeError = data.error or "Enter a verification code to continue."
  }

  // The provider choices shown in create mode. Adding a provider = one more entry here.
  buildKinds() {
    this.kinds = [
      {
        id: "linode",
        name: "Linode",
        sub: "Akamai",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center font-bold",
        letter: "L"
      },
      {
        id: "hetzner",
        name: "Hetzner",
        sub: "Cloud",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold",
        letter: "H"
      },
      {
        id: "digitalocean",
        name: "DigitalOcean",
        sub: "Droplets",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold",
        letter: "D"
      },
      {
        id: "vultr",
        name: "Vultr",
        sub: "Cloud Compute",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-violet-500/10 text-violet-600 dark:text-violet-400 flex items-center justify-center font-bold",
        letter: "V"
      },
      {
        id: "aws",
        name: "AWS",
        sub: "EC2",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold",
        letter: "A"
      },
      {
        id: "upcloud",
        name: "UpCloud",
        sub: "Cloud Servers",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold",
        letter: "U"
      },
      {
        id: "contabo",
        name: "Contabo",
        sub: "Cloud VPS",
        tileClass: "w-9 h-9 shrink-0 rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold",
        letter: "C"
      }
    ]
  }

  // Create mode only: the provider type is fixed once the connection exists.
  pick(kind) {
    this.kind = kind
    this.syncMode()
    const label = this.labelError
    this.clearErrors()
    this.labelError = label
  }

  async open() {
    this.reset()
    this.buildKinds()
    if this.provider {
      this.label = this.provider.label
      this.kind = this.provider.kind
      this.tokenPlaceholder = "Leave blank to keep the current token"
      if this.provider.kind is "aws" {
        this.tokenPlaceholder = "Leave blank to keep the current keys"
      }
      if this.provider.kind is "upcloud" {
        this.tokenPlaceholder = "Leave blank to keep the current credentials"
      }
      if this.provider.kind is "contabo" {
        this.tokenPlaceholder = "Leave blank to keep the current credentials"
      }
    }
    this.syncMode()
    this.showModal = true

    if this.provider {
      await this.loadTwoFactor()
    }
  }

  close() {
    this.showModal = false
    this.reset()
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()

    const stop = await this.needsCode()
    if stop {
      return null
    }

    this.saving = true

    // When editing, the existing connection's kind is sent. The server ignores
    // it anyway and verifies against the stored kind. The credential fields
    // that don't belong to the kind are sent blank and ignored.
    const payload = {
      kind: this.provider ? this.provider.kind : this.kind,
      label: this.label,
      api_token: this.apiToken,
      access_key_id: this.accessKeyId,
      secret_access_key: this.secretKey,
      username: this.username,
      password: this.password,
      client_id: this.clientId,
      client_secret: this.clientSecret,
      api_user: this.apiUser,
      api_password: this.apiPassword,
      code: this.code.trim()
    }
    const url = this.provider ? "/api/providers/" + this.provider.id : "/api/providers"
    const method = this.provider ? "PUT" : "POST"

    const result = await useApi(url, { method: method, body: payload })

    if result.ok {
      this.onSaved(result.data)
      this.close()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data and result.data.two_factor_required {
      this.applyTwoFactorRequired(result.data)
      this.saving = false
    } else {
      const errors = result.data?.errors
      this.labelError = this.firstError(errors, "label")
      this.tokenError = this.firstError(errors, "api_token")
      this.accessKeyError = this.firstError(errors, "access_key_id")
      this.secretKeyError = this.firstError(errors, "secret_access_key")
      this.usernameError = this.firstError(errors, "username")
      this.passwordError = this.firstError(errors, "password")
      this.clientIdError = this.firstError(errors, "client_id")
      this.clientSecretError = this.firstError(errors, "client_secret")
      this.apiUserError = this.firstError(errors, "api_user")
      this.apiPasswordError = this.firstError(errors, "api_password")
      this.codeError = this.firstError(errors, "code")
      this.error = result.data?.error or result.error or ""
      if not this.labelError and not this.tokenError and not this.accessKeyError and not this.secretKeyError and not this.usernameError and not this.passwordError and not this.clientIdError and not this.clientSecretError and not this.apiUserError and not this.apiPasswordError and not this.codeError and not this.error {
        this.error = "Couldn't save the connection. Try again."
      }
      this.saving = false
    }
  }

template
{{#if provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center text-sm font-medium text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
    Edit
  </button>
{{/if}}
{{#if not provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-brand-400 hover:shadow transition-all">
    <IconPlus class="w-4 h-4" /> Connect provider
  </button>
{{/if}}

{{#if showModal}}
  <div role="dialog" aria-modal="true" aria-labelledby="provider-form-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm px-6">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl border border-line bg-panel shadow-xl p-6">

      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h3 id="provider-form-title" class="text-slate-900 dark:text-slate-100 text-lg font-semibold">
{{#if provider}}
            Edit connection
{{/if}}
{{#if not provider}}
            Connect a cloud provider
{{/if}}
          </h3>
{{#if provider}}
          <p class="text-slate-500 text-sm mt-0.5">Rename it, or paste new credentials to replace the stored ones.</p>
{{/if}}
{{#if not provider}}
          <p class="text-slate-500 text-sm mt-0.5">The deployer creates servers in this account for you.</p>
{{/if}}
        </div>
        <button onclick="{{ close() }}" aria-label="Close" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <IconX class="w-4 h-4" />
        </button>
      </div>

{{#if not provider}}
      <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Provider</p>
      <div class="grid grid-cols-2 gap-3 mb-5">
{{#each k in kinds}}
{{#if kind is k.id}}
        <button onclick="{{ pick(k.id) }}" aria-pressed="true" class="flex items-center gap-3 rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-left transition-colors">
          <span class="{{ k.tileClass }}">{{ k.letter }}</span>
          <span class="min-w-0">
            <span class="block text-slate-900 dark:text-slate-100 text-sm font-semibold">{{ k.name }}</span>
            <span class="block text-slate-500 text-xs">{{ k.sub }}</span>
          </span>
        </button>
{{/if}}
{{#if kind is not k.id}}
        <button onclick="{{ pick(k.id) }}" aria-pressed="false" class="flex items-center gap-3 rounded-xl border-2 border-line px-4 py-3 text-left hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
          <span class="{{ k.tileClass }}">{{ k.letter }}</span>
          <span class="min-w-0">
            <span class="block text-slate-900 dark:text-slate-100 text-sm font-semibold">{{ k.name }}</span>
            <span class="block text-slate-500 text-xs">{{ k.sub }}</span>
          </span>
        </button>
{{/if}}
{{/each}}
      </div>
{{/if}}

      <label for="provider-label" class="block text-slate-500 text-xs font-medium mb-1.5">Connection name</label>
      <input
        id="provider-label"
        type="text"
        autofocus
        value="{{ label }}"
        oninput="{{ label = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="e.g. Production account"
      />
{{#if labelError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ labelError }}</p>
{{/if}}

{{#if mode is "token"}}
      <label for="provider-token" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API token</label>
      <input
        id="provider-token"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ apiToken }}"
        oninput="{{ apiToken = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if tokenError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ tokenError }}</p>
{{/if}}
{{/if}}

{{#if mode is "upcloud"}}
      <label for="provider-up-user" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API username</label>
      <input
        id="provider-up-user"
        type="text"
        autocomplete="off"
        spellcheck="false"
        value="{{ username }}"
        oninput="{{ username = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if usernameError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ usernameError }}</p>
{{/if}}

      <label for="provider-up-pass" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API password</label>
      <input
        id="provider-up-pass"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ password }}"
        oninput="{{ password = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if passwordError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ passwordError }}</p>
{{/if}}
{{/if}}

{{#if mode is "contabo"}}
      <label for="provider-cb-client-id" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">Client ID</label>
      <input
        id="provider-cb-client-id"
        type="text"
        autocomplete="off"
        spellcheck="false"
        value="{{ clientId }}"
        oninput="{{ clientId = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if clientIdError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ clientIdError }}</p>
{{/if}}

      <label for="provider-cb-client-secret" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">Client secret</label>
      <input
        id="provider-cb-client-secret"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ clientSecret }}"
        oninput="{{ clientSecret = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if clientSecretError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ clientSecretError }}</p>
{{/if}}

      <label for="provider-cb-api-user" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API user</label>
      <input
        id="provider-cb-api-user"
        type="text"
        autocomplete="off"
        spellcheck="false"
        value="{{ apiUser }}"
        oninput="{{ apiUser = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if apiUserError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ apiUserError }}</p>
{{/if}}

      <label for="provider-cb-api-password" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">API password</label>
      <input
        id="provider-cb-api-password"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ apiPassword }}"
        oninput="{{ apiPassword = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if apiPasswordError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ apiPasswordError }}</p>
{{/if}}
{{/if}}

{{#if kind is "aws"}}
      <label for="provider-access-key" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">Access key ID</label>
      <input
        id="provider-access-key"
        type="text"
        autocomplete="off"
        spellcheck="false"
        value="{{ accessKeyId }}"
        oninput="{{ accessKeyId = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if accessKeyError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ accessKeyError }}</p>
{{/if}}

      <label for="provider-secret-key" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">Secret access key</label>
      <input
        id="provider-secret-key"
        type="password"
        autocomplete="off"
        spellcheck="false"
        value="{{ secretKey }}"
        oninput="{{ secretKey = $event.target.value }}"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="{{ tokenPlaceholder }}"
      />
{{#if secretKeyError}}
      <p class="text-rose-500 text-xs mt-1.5">{{ secretKeyError }}</p>
{{/if}}
{{/if}}

{{#if not provider}}
      <div class="rounded-xl border border-line bg-slate-50 dark:bg-slate-950/60 p-4 mt-4">
{{#if kind is "linode"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a Linode token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://cloud.linode.com/profile/tokens" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">Profile &rarr; API Tokens</a> in Linode Cloud Manager.</li>
          <li>Create a personal access token.</li>
          <li>Give it <span class="font-mono">Linodes: Read/Write</span> to create servers, <span class="font-mono">Domains: Read/Write</span> to manage DNS, and <span class="font-mono">Account: Read Only</span> to see billing. Everything else can stay on No Access.</li>
        </ol>
{{/if}}
{{#if kind is "hetzner"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a Hetzner token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open your project in the <a href="https://console.hetzner.cloud/" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">Hetzner Cloud Console</a>.</li>
          <li>Go to Security &rarr; API tokens and generate one.</li>
          <li>Give it <span class="font-mono">Read &amp; Write</span> permission. A Read-only token connects fine but can't create servers.</li>
        </ol>
{{/if}}
{{#if kind is "digitalocean"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a DigitalOcean token</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://cloud.digitalocean.com/account/api/tokens" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">API &rarr; Tokens</a> in the DigitalOcean control panel.</li>
          <li>Generate a new personal access token.</li>
          <li>Give it <span class="font-mono">Full Access</span>, or a custom scope that can create, read and delete droplets and read regions, sizes and images. A read-only token connects fine but can't create servers.</li>
        </ol>
{{/if}}
{{#if kind is "vultr"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create a Vultr API key</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://my.vultr.com/settings/#settingsapi" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">Account &rarr; API</a> and enable the API.</li>
          <li>Copy the API key.</li>
          <li>Under Access Control, allow this deployer's server IP, or choose Allow all IPv4. Otherwise Vultr rejects every request.</li>
        </ol>
{{/if}}
{{#if kind is "aws"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create an AWS access key</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://console.aws.amazon.com/iam/" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">IAM</a> and create a user. It does not need console access.</li>
          <li>Attach a policy that allows the EC2 actions listed below.</li>
          <li>Open the user, go to Security credentials and create an access key for an application running outside AWS.</li>
          <li>Paste the Access key ID and the Secret access key here. AWS shows the secret only once.</li>
        </ol>
        <p class="text-slate-500 text-xs mt-3">EC2 actions needed:</p>
        <p class="text-slate-500 text-[11px] font-mono leading-relaxed mt-1 break-words">DescribeRegions, DescribeInstances, DescribeInstanceTypes, DescribeInstanceTypeOfferings, DescribeImages, DescribeVpcs, DescribeSecurityGroups, CreateSecurityGroup, AuthorizeSecurityGroupIngress, RunInstances, TerminateInstances, CreateTags</p>
        <p class="text-slate-500 text-xs mt-3">Use a long-term key (it starts with AKIA). Servers are created in your default VPC, with a security group named tylix-deploy that leaves every port open. Each server's own firewall decides what is reachable.</p>
{{/if}}
{{#if kind is "upcloud"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Create an UpCloud API account</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://hub.upcloud.com/" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">UpCloud Control Panel</a> and go to People. Create a sub-account just for the deployer.</li>
          <li>Allow API connections for it, and give it access to servers and storage.</li>
          <li>Under allowed IP addresses, add this deployer's server IP. Otherwise UpCloud rejects every request.</li>
          <li>Paste the sub-account's username and password here.</li>
        </ol>
{{/if}}
{{#if kind is "contabo"}}
        <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1.5">Get your Contabo API credentials</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-500 text-xs">
          <li>Open <a href="https://my.contabo.com/api/details" target="_blank" rel="noopener noreferrer" class="text-brand-700 dark:text-brand-500 hover:underline">Account &rarr; Security &amp; Access &rarr; API</a> in the Contabo Customer Control Panel.</li>
          <li>Copy the Client ID and Client Secret.</li>
          <li>The API user is your account email. Set an API password there; it is separate from your login password.</li>
        </ol>
        <p class="text-slate-500 text-xs mt-3">Contabo bills monthly. Deleting a server here cancels it at the end of the billing period, and it stays online until then.</p>
{{/if}}
        <p class="text-slate-400 text-xs mt-3">The credentials are checked with the provider, encrypted before they are stored, and never shown again.</p>
      </div>
{{/if}}

{{#if provider}}
      <p class="text-slate-400 text-xs mt-3">The current credentials are stored encrypted and are never shown.</p>
{{/if}}

{{#if codeOpen}}
      <div class="mt-5 rounded-xl border border-line bg-slate-50 dark:bg-slate-950/60 p-4">
        <label for="step-up-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Verification code</label>
        <p class="text-slate-500 text-xs mb-2">Replacing credentials needs a second-factor code.</p>
        <input
          id="step-up-code"
          type="text"
          inputmode="text"
          autocomplete="one-time-code"
          maxlength="12"
          value="{{ code }}"
          oninput="{{ code = $event.target.value }}"
          class="w-full sm:w-56 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        />
{{#if tfTotp}}
        <p class="text-slate-500 text-xs mt-2">Enter a code from your authenticator app, or a recovery code.</p>
{{/if}}
{{#if not tfTotp}}
        <p class="text-slate-500 text-xs mt-2">Enter the code texted to {{ smsHint }}.</p>
{{/if}}
{{#if smsNotice}}
        <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ smsNotice }}</p>
{{/if}}
{{#if codeError}}
        <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if tfSms}}
{{#if smsSending}}
        <button disabled class="mt-3 text-xs text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1 opacity-50">Sending…</button>
{{/if}}
{{#if not smsSending}}
        <button onclick="{{ sendCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Text me a code</button>
{{/if}}
{{/if}}
      </div>
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3 mt-6">
        <button onclick="{{ close() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">
          Cancel
        </button>
{{#if saving}}
        <button disabled class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">
          Verifying…
        </button>
{{/if}}
{{#if not saving}}
        <button onclick="{{ submit() }}" class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-brand-400 hover:shadow transition-all">
          Save
        </button>
{{/if}}
      </div>

    </div>
  </div>
{{/if}}