component DeployEditorModal

import { IconX } from "tylix-icons"

uses
  Syntax

// The deployment page's full-page code editor, for the deploy script
// (kind="script") or the .env file (kind="env"). The textarea keeps the
// page's ids (script-input / env-input): the page reads its value on input.
//
// A coloured copy of the text (Syntax.html) sits under the see-through
// textarea, with a line gutter beside it; all three scroll together. The
// coloured copy is a div: Tylix shows a pre element's content as plain
// text, so it can't hold rendered HTML. Tab indents, Ctrl/Cmd+S saves, and
// Esc closes (the page handles Esc).

props
  kind: String
  value: String
  envPath: String
  error: String
  saving: Boolean
  locked: Boolean
  onInput: Function
  onSave: Function
  onReset: Function
  onClose: Function

computed
  isEnv() {
    return this.kind is "env"
  }

  inputId() {
    return this.isEnv ? "env-input" : "script-input"
  }

  lineCount() {
    return (this.value or "").split(String.fromCharCode(10)).length
  }

  lineNums() {
    return Array.from({ length: this.lineCount }, (x, i) => i + 1).join(String.fromCharCode(10))
  }

  coloured() {
    return Syntax.html(this.value, this.isEnv ? "env" : "bash")
  }

  fileName() {
    if not this.isEnv {
      return "deploy.sh"
    }
    const path = this.envPath or ".env"
    const cut = path.lastIndexOf("/")
    return cut >= 0 ? path.slice(cut + 1) : path
  }

action
  input() {
    this.onInput()
  }

  save() {
    if this.saving or this.locked {
      return null
    }
    this.onSave()
  }

  reset() {
    this.onReset()
  }

  dismiss() {
    this.onClose()
  }

  onKey(e) {
    const pressed = (e.key or "").toLowerCase()
    const modifier = e.ctrlKey or e.metaKey
    if modifier and pressed is "s" {
      e.preventDefault()
      this.save()
      return null
    }

    if e.key is "Tab" and not e.shiftKey {
      e.preventDefault()
      const ta = e.target
      const start = ta.selectionStart
      const end = ta.selectionEnd
      const pad = "    "
      ta.value = ta.value.slice(0, start) + pad + ta.value.slice(end)
      ta.selectionStart = start + pad.length
      ta.selectionEnd = start + pad.length
      this.onInput()
    }
  }

  syncScroll(e) {
    const ta = e.target
    const layer = document.getElementById(this.inputId + "-hl")
    if layer {
      layer.scrollTop = ta.scrollTop
      layer.scrollLeft = ta.scrollLeft
    }
    const gutter = document.getElementById(this.inputId + "-gutter")
    if gutter {
      gutter.scrollTop = ta.scrollTop
    }
  }

template
<div role="dialog" aria-modal="true" aria-labelledby="{{ kind + '-title' }}" class="cx-root fixed inset-0 z-[80] flex items-stretch sm:items-center justify-center sm:p-5 lg:p-8">
  <div onclick="{{ dismiss() }}" aria-hidden="true" class="cx-fade absolute inset-0 bg-[#050506]/75 backdrop-blur-md"></div>

  <div class="cx-shell cx-pop relative flex flex-col w-full h-full sm:h-[min(900px,calc(100vh-2.5rem))] max-w-[1200px] sm:rounded-[22px] overflow-hidden text-zinc-200">

    <!-- header -->
    <header class="shrink-0 flex items-center gap-3 px-3 sm:px-5 h-16 border-b border-white/[0.05]">
      <span aria-hidden="true" class="w-9 h-9 shrink-0 rounded-xl flex items-center justify-center bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-[0_0_20px_-4px_rgb(240_103_107/0.7),inset_0_1px_0_rgb(255_255_255/0.25)]">
{{#if isEnv}}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
{{#else}}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M4 17l6-6-6-6M12 19h8" /></svg>
{{/if}}
      </span>
      <div class="min-w-0">
        <h3 id="{{ kind + '-title' }}" class="text-[14px] font-medium text-zinc-100 truncate leading-tight">{{ isEnv ? "Environment" : "Deployment script" }}</h3>
        <p class="font-mono text-[11.5px] text-zinc-400 truncate leading-tight mt-0.5">{{ isEnv ? envPath : fileName }}</p>
      </div>
      <span class="hidden sm:inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-[10.5px] font-semibold uppercase tracking-[0.12em] {{ isEnv ? 'bg-emerald-400/10 text-emerald-300 shadow-[inset_0_0_0_1px_rgb(52_211_153/0.25)]' : 'bg-sky-400/10 text-sky-300 shadow-[inset_0_0_0_1px_rgb(56_189_248/0.25)]' }}">{{ isEnv ? "dotenv" : "bash" }}</span>
      <button onclick="{{ dismiss() }}" title="Close (Esc)" aria-label="Close" class="ml-auto inline-flex items-center gap-1.5 h-8 rounded-lg px-2.5 sm:px-3 text-[12px] text-zinc-300 hover:text-white bg-white/[0.03] hover:bg-brand-500/20 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] transition-colors">
        <IconX class="w-4 h-4" />
        <span class="hidden sm:inline">Close</span>
        <span class="hidden sm:inline cx-kbd">Esc</span>
      </button>
    </header>

    <p class="shrink-0 px-4 sm:px-5 pt-3 text-[12px] leading-relaxed text-zinc-400">
{{#if isEnv}}
      Written to the server on every deploy (permissions 600). Stored encrypted. Leave empty to keep the file on the server as it is.
{{#else}}
      Runs as the isolated user after the latest code is pulled, starting in the site folder. A failing command stops the deployment. Variables: <span class="font-mono text-violet-300">$SITE_ROOT $DOMAIN $BRANCH $PHP_VERSION $APP_DIR $BACKEND_DIR $PORT</span>
{{/if}}
    </p>

{{#if error}}
    <div role="alert" class="shrink-0 mx-3 sm:mx-5 mt-3 rounded-xl px-3.5 py-2.5 bg-brand-500/[0.08] shadow-[inset_0_0_0_1px_rgb(240_103_107/0.3)]">
      <p class="text-brand-200 text-[12.5px] break-words">{{ error }}</p>
    </div>
{{/if}}

    <!-- editor -->
    <div class="flex-1 min-h-0 p-2 sm:p-3 sm:px-5">
      <div class="cx-frame cx-well h-full flex rounded-2xl overflow-hidden">
        <div
          id="{{ inputId + '-gutter' }}"
          aria-hidden="true"
          class="shrink-0 w-10 sm:w-14 overflow-hidden select-none text-right pr-2.5 sm:pr-3 pt-3 pb-10 bg-white/[0.015] border-r border-white/[0.05] text-zinc-600 text-base sm:text-[13px] leading-6 font-mono whitespace-pre"
        >{{ lineNums }}</div>
        <div class="relative flex-1 min-w-0">
          <div
            id="{{ inputId + '-hl' }}"
            aria-hidden="true"
            class="absolute inset-0 overflow-hidden pointer-events-none text-zinc-200 text-base sm:text-[13px] leading-6 font-mono font-normal pl-3 sm:pl-4 pr-4 pt-3 pb-10 whitespace-pre [tab-size:4]"
          >{{@html coloured }}</div>
{{#if isEnv}}
          <textarea
            id="env-input"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            wrap="off"
            value="{{ value }}"
            oninput="{{ input() }}"
            onkeydown="{{ onKey($event) }}"
            onscroll="{{ syncScroll($event) }}"
            aria-label="Environment file"
            placeholder="APP_ENV=production"
            style="color: transparent; -webkit-text-fill-color: transparent; caret-color: #f6a8a6"
            class="absolute inset-0 w-full h-full resize-none bg-transparent text-transparent selection:bg-brand-500/30 placeholder:text-zinc-600 text-base sm:text-[13px] leading-6 font-mono font-normal pl-3 sm:pl-4 pr-4 pt-3 pb-10 overflow-auto whitespace-pre [tab-size:4] cx-scroll focus:outline-none"
          ></textarea>
{{#else}}
          <textarea
            id="script-input"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            wrap="off"
            value="{{ value }}"
            oninput="{{ input() }}"
            onkeydown="{{ onKey($event) }}"
            onscroll="{{ syncScroll($event) }}"
            aria-label="Deployment script"
            style="color: transparent; -webkit-text-fill-color: transparent; caret-color: #f6a8a6"
            class="absolute inset-0 w-full h-full resize-none bg-transparent text-transparent selection:bg-brand-500/30 text-base sm:text-[13px] leading-6 font-mono font-normal pl-3 sm:pl-4 pr-4 pt-3 pb-10 overflow-auto whitespace-pre [tab-size:4] cx-scroll focus:outline-none"
          ></textarea>
{{/if}}
        </div>
      </div>
    </div>

    <!-- footer -->
    <footer class="shrink-0 flex flex-col sm:flex-row sm:items-center gap-3 px-3 sm:px-5 py-3 border-t border-white/[0.05] bg-black/20">
      <p class="text-[11.5px] text-zinc-400">
        <span class="font-mono text-zinc-200 tabular-nums">{{ lineCount }}</span> {{ lineCount is 1 ? "line" : "lines" }}
        <span class="hidden sm:inline"><span class="mx-1.5 text-zinc-700">&bull;</span><span class="cx-kbd">Ctrl</span> <span class="cx-kbd">S</span> to save<span class="mx-1.5 text-zinc-700">&bull;</span><span class="cx-kbd">Tab</span> indents</span>
      </p>
      <div class="sm:ml-auto flex items-center gap-2">
{{#if not isEnv}}
        <button onclick="{{ reset() }}" class="h-9 rounded-xl px-3.5 text-[12.5px] text-zinc-300 hover:text-white bg-white/[0.03] hover:bg-white/[0.07] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] transition-colors">Reset to default</button>
{{/if}}
        <button onclick="{{ dismiss() }}" class="ml-auto sm:ml-0 h-9 rounded-xl px-4 text-[12.5px] text-zinc-300 hover:text-white transition-colors">Cancel</button>
{{#if saving}}
        <button disabled class="h-9 rounded-xl px-5 text-[13px] font-semibold text-white bg-brand-500 opacity-60">Saving…</button>
{{#else}}
{{#if locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 h-9 rounded-xl px-5 text-[13px] text-zinc-400 bg-white/[0.04] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Save
        </button>
{{#else}}
        <button onclick="{{ save() }}" class="h-9 rounded-xl px-6 text-[13px] font-semibold text-white bg-brand-500 hover:bg-brand-400 shadow-[0_0_24px_-6px_rgb(240_103_107/0.8)] transition-colors">Save</button>
{{/if}}
{{/if}}
      </div>
    </footer>
  </div>
</div>
