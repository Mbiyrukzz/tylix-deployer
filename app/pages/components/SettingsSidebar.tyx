component SettingsSidebar

import { IconCog, IconKey, IconShieldCheck } from "tylix-icons"

props
  active: String

state
  collapsed: false
  asideCls: "app-subnav flex lg:flex-col gap-1 overflow-x-auto no-scrollbar lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-transparent p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200 lg:w-[240px] lg:px-3 lg:py-4"
  topCls: "hidden lg:flex items-center justify-between gap-2 mb-5"
  titleCls: "min-w-0"
  btnCls: "flex items-center justify-center w-8 h-8 shrink-0 rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.05] transition-colors"
  headCls: "hidden lg:block text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.14em] pt-2 pb-1.5 px-3"
  onCls: "relative shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl bg-white text-zinc-900 text-[13.5px] font-medium shadow-sm ring-1 ring-black/[0.06] dark:ring-0"
  offCls: "group shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl text-zinc-600 dark:text-zinc-400 text-[13.5px] font-medium hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
  labelCls: ""
  chevCls: "w-4 h-4 transition-transform"

action
  applyLayout() {
    const asideBase = "app-subnav flex lg:flex-col gap-1 overflow-x-auto no-scrollbar lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-transparent p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200"
    const on = "relative shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl bg-white text-zinc-900 text-[13.5px] font-medium shadow-sm ring-1 ring-black/[0.06] dark:ring-0"
    const off = "group shrink-0 flex items-center gap-3 h-9 px-3 rounded-xl text-zinc-600 dark:text-zinc-400 text-[13.5px] font-medium hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
    const head = "hidden lg:block text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.14em] pt-2 pb-1.5 px-3"

    if this.collapsed {
      this.asideCls = asideBase + " lg:w-16 lg:p-2.5"
      this.topCls = "hidden lg:flex flex-col items-center gap-3 mb-5"
      this.titleCls = "hidden"
      this.headCls = "hidden"
      this.onCls = on + " lg:justify-center lg:px-0"
      this.offCls = off + " lg:justify-center lg:px-0"
      this.labelCls = "lg:hidden"
      this.chevCls = "w-4 h-4 transition-transform rotate-180"
    } else {
      this.asideCls = asideBase + " lg:w-[240px] lg:px-3 lg:py-4"
      this.topCls = "hidden lg:flex items-center justify-between gap-2 mb-5"
      this.titleCls = "min-w-0"
      this.headCls = head
      this.onCls = on
      this.offCls = off
      this.labelCls = ""
      this.chevCls = "w-4 h-4 transition-transform"
    }
  }

  toggle() {
    this.collapsed = not this.collapsed
    this.applyLayout()

    if this.collapsed {
      window.localStorage.setItem("tylix-settings-sidebar", "1")
    } else {
      window.localStorage.setItem("tylix-settings-sidebar", "0")
    }
  }

onMount
  async {
    const saved = window.localStorage.getItem("tylix-settings-sidebar")
    if saved is "1" {
      this.collapsed = true
      this.applyLayout()
    }
  }

template
<aside class="{{ asideCls }}">

  <div class="{{ topCls }}">
    <div class="flex items-center gap-3 min-w-0">
      <span class="w-9 h-9 shrink-0 rounded-[10px] border border-line bg-panel text-zinc-700 dark:text-zinc-200 flex items-center justify-center">
        <IconCog class="w-5 h-5" />
      </span>
      <div class="{{ titleCls }}">
        <p class="text-zinc-900 dark:text-zinc-50 text-[15px] font-semibold tracking-tight leading-tight truncate">Settings</p>
        <p class="text-zinc-500 text-[11px] leading-tight truncate">Account and team</p>
      </div>
    </div>
    <button onclick="{{ toggle() }}" title="Collapse or expand sidebar" aria-label="Collapse or expand sidebar" class="{{ btnCls }}">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="{{ chevCls }}"><rect x="3" y="3.5" width="14" height="13" rx="3" /><path d="M8 3.5v13" /><path d="M13 8l-2 2 2 2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

  <p class="{{ headCls }}">Your account</p>

{{#if active is "account"}}
  <a href="/settings" title="Account" aria-current="page" class="{{ onCls }}">
    <IconCog class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Account</span>
  </a>
{{/if}}
{{#if active is not "account"}}
  <a href="/settings" title="Account" class="{{ offCls }}">
    <IconCog class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Account</span>
  </a>
{{/if}}

  <div class="hidden lg:block h-3"></div>
  <p class="{{ headCls }}">Security</p>

{{#if active is "password"}}
  <a href="/settings/password" title="Password" aria-current="page" class="{{ onCls }}">
    <IconKey class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Password</span>
  </a>
{{/if}}
{{#if active is not "password"}}
  <a href="/settings/password" title="Password" class="{{ offCls }}">
    <IconKey class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Password</span>
  </a>
{{/if}}

{{#if active is "two-factor"}}
  <a href="/settings/two-factor" title="Two-factor" aria-current="page" class="{{ onCls }}">
    <IconShieldCheck class="w-[18px] h-[18px] shrink-0 text-zinc-900" /> <span class="{{ labelCls }}">Two-factor</span>
  </a>
{{/if}}
{{#if active is not "two-factor"}}
  <a href="/settings/two-factor" title="Two-factor" class="{{ offCls }}">
    <IconShieldCheck class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /> <span class="{{ labelCls }}">Two-factor</span>
  </a>
{{/if}}

  <div class="hidden lg:block h-3"></div>
  <p class="{{ headCls }}">Team</p>

{{#if active is "team"}}
  <a href="/settings/team" title="Members" aria-current="page" class="{{ onCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-900"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg> <span class="{{ labelCls }}">Members</span>
  </a>
{{/if}}
{{#if active is not "team"}}
  <a href="/settings/team" title="Members" class="{{ offCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg> <span class="{{ labelCls }}">Members</span>
  </a>
{{/if}}

{{#if active is "billing"}}
  <a href="/settings/billing" title="Billing" aria-current="page" class="{{ onCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-900"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg> <span class="{{ labelCls }}">Billing</span>
  </a>
{{/if}}
{{#if active is not "billing"}}
  <a href="/settings/billing" title="Billing" class="{{ offCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg> <span class="{{ labelCls }}">Billing</span>
  </a>
{{/if}}

{{#if active is "invoices"}}
  <a href="/settings/invoices" title="Invoices" aria-current="page" class="{{ onCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-900"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></svg> <span class="{{ labelCls }}">Invoices</span>
  </a>
{{/if}}
{{#if active is not "invoices"}}
  <a href="/settings/invoices" title="Invoices" class="{{ offCls }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="8" y1="13" x2="16" y2="13" /><line x1="8" y1="17" x2="16" y2="17" /></svg> <span class="{{ labelCls }}">Invoices</span>
  </a>
{{/if}}

</aside>