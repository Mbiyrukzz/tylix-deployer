component ProviderSidebar

import { IconGauge, IconGlobe, IconDocumentText, IconCog, IconArrowLeft } from "tylix-icons"

props
  active: String
  providerId: String

template
<aside class="flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-slate-300 dark:border-slate-800 bg-slate-300/30 dark:bg-slate-900/40 p-3 lg:p-5 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)]">

  <p class="hidden lg:block text-slate-500 text-[11px] font-semibold uppercase tracking-wider mb-1 px-1">This provider</p>

{{#if active is "overview"}}
  <a href="{{ '/providers/provider-detail?id=' + providerId }}" aria-current="page" class="relative shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm dark:shadow-none text-slate-900 dark:text-slate-100 text-sm font-medium">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-emerald-500"></span>
    <IconGauge class="w-4 h-4 text-emerald-600 dark:text-emerald-400" /> Overview
  </a>
{{/if}}
{{#if active is not "overview"}}
  <a href="{{ '/providers/provider-detail?id=' + providerId }}" class="group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900/70 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
    <IconGauge class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> Overview
  </a>
{{/if}}

{{#if active is "domains"}}
  <a href="{{ '/providers/provider-domains?id=' + providerId }}" aria-current="page" class="relative shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm dark:shadow-none text-slate-900 dark:text-slate-100 text-sm font-medium">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-emerald-500"></span>
    <IconGlobe class="w-4 h-4 text-emerald-600 dark:text-emerald-400" /> Domains
  </a>
{{/if}}
{{#if active is not "domains"}}
  <a href="{{ '/providers/provider-domains?id=' + providerId }}" class="group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900/70 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
    <IconGlobe class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> Domains
  </a>
{{/if}}

{{#if active is "billing"}}
  <a href="{{ '/providers/provider-billing?id=' + providerId }}" aria-current="page" class="relative shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-300/80 dark:border-slate-800 shadow-sm dark:shadow-none text-slate-900 dark:text-slate-100 text-sm font-medium">
    <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-emerald-500"></span>
    <IconDocumentText class="w-4 h-4 text-emerald-600 dark:text-emerald-400" /> Billing
  </a>
{{/if}}
{{#if active is not "billing"}}
  <a href="{{ '/providers/provider-billing?id=' + providerId }}" class="group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:bg-slate-300/50 dark:hover:bg-slate-900/70 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
    <IconDocumentText class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> Billing
  </a>
{{/if}}

  <div class="shrink-0 flex flex-col ml-auto lg:ml-0 lg:mt-auto lg:pt-3 lg:border-t border-slate-300 dark:border-slate-800">
    <a href="/providers" class="group shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-600 dark:text-slate-400 text-sm hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
      <IconArrowLeft class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" /> All providers
    </a>
    <span class="shrink-0 flex items-center gap-2.5 px-1 py-1 rounded-xl border border-transparent text-slate-400 dark:text-slate-600 text-sm cursor-not-allowed select-none" aria-disabled="true" title="Firewalls, volumes, images and more">
      <IconCog class="w-4 h-4 text-slate-300 dark:text-slate-700" />
      <span>More</span>
      <span class="ml-auto text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-slate-300 dark:border-slate-800 text-slate-400 dark:text-slate-600">Soon</span>
    </span>
  </div>
</aside>