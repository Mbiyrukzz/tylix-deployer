component HowItWorks

template
  <section class="relative overflow-hidden px-6 py-24 bg-slate-200 dark:bg-slate-950 transition-colors">
    <div class="pointer-events-none absolute -bottom-32 right-0 w-[520px] h-[280px] rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto">
      <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-2">How it works</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-800 dark:text-slate-200 mb-3">From a bare server to live in three steps</h2>
      <p class="text-slate-500 max-w-2xl mb-12">No SSH sessions and no copy-pasted scripts. Bring a server, pick a stack, and press deploy.</p>

      <div class="relative">
        <div class="hidden md:block absolute top-[22px] left-[16%] right-[16%] border-t border-dashed border-slate-400 dark:border-slate-700" aria-hidden="true"></div>

        <div class="relative grid grid-cols-1 md:grid-cols-3 gap-5">

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel p-6 shadow-sm dark:shadow-none flex flex-col">
            <div class="w-11 h-11 rounded-full border border-brand-500/40 bg-slate-200 dark:bg-slate-950 text-brand-700 dark:text-brand-400 font-mono text-sm font-semibold flex items-center justify-center mb-5">01</div>
            <h3 class="text-slate-800 dark:text-slate-200 font-semibold mb-2">Connect your server</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-5">Provision one at Linode, Hetzner, DigitalOcean or Vultr, or add the host, SSH port and user of your own. Your key is stored encrypted and never leaves the platform.</p>

            <div class="mt-auto rounded-xl border border-slate-300 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-3 font-mono text-[11px] space-y-1.5" aria-hidden="true">
              <div class="flex items-center justify-between"><span class="text-slate-500">host</span><span class="text-slate-700 dark:text-slate-300">203.0.113.24</span></div>
              <div class="flex items-center justify-between"><span class="text-slate-500">port</span><span class="text-slate-700 dark:text-slate-300">22</span></div>
              <div class="flex items-center justify-between"><span class="text-slate-500">user</span><span class="text-slate-700 dark:text-slate-300">deploy</span></div>
              <div class="flex items-center justify-between"><span class="text-slate-500">key</span><span class="text-slate-700 dark:text-slate-300">encrypted</span></div>
              <div class="flex items-center gap-1.5 pt-2 border-t border-line text-brand-700 dark:text-brand-400"><span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> connected</div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel p-6 shadow-sm dark:shadow-none flex flex-col">
            <div class="w-11 h-11 rounded-full border border-brand-500/40 bg-slate-200 dark:bg-slate-950 text-brand-700 dark:text-brand-400 font-mono text-sm font-semibold flex items-center justify-center mb-5">02</div>
            <h3 class="text-slate-800 dark:text-slate-200 font-semibold mb-2">Choose your stack</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-5">Sixteen site types: Tylix, Laravel, PHP, WordPress, Node.js, Next.js, MERN, Angular, FastAPI, Django, Java, Go, Ruby, .NET, Rust and static. Then point it at your repository.</p>

            <div class="mt-auto rounded-xl border border-slate-300 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-3 font-mono text-[11px]" aria-hidden="true">
              <div class="flex flex-wrap gap-1.5 mb-3">
                <span class="rounded-full border border-brand-500/50 bg-brand-500/10 px-2 py-0.5 text-brand-700 dark:text-brand-400">laravel</span>
                <span class="rounded-full border border-slate-300 dark:border-slate-700 px-2 py-0.5 text-slate-500">django</span>
                <span class="rounded-full border border-slate-300 dark:border-slate-700 px-2 py-0.5 text-slate-500">go</span>
                <span class="rounded-full border border-slate-300 dark:border-slate-700 px-2 py-0.5 text-slate-500">rust</span>
                <span class="rounded-full border border-slate-300 dark:border-slate-700 px-2 py-0.5 text-slate-500">+12</span>
              </div>
              <div class="flex items-center justify-between pt-2 border-t border-line"><span class="text-slate-500">repo</span><span class="text-slate-700 dark:text-slate-300">acme/shop</span></div>
              <div class="flex items-center justify-between mt-1.5"><span class="text-slate-500">branch</span><span class="text-slate-700 dark:text-slate-300">main</span></div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel p-6 shadow-sm dark:shadow-none flex flex-col">
            <div class="w-11 h-11 rounded-full border border-brand-500/40 bg-slate-200 dark:bg-slate-950 text-brand-700 dark:text-brand-400 font-mono text-sm font-semibold flex items-center justify-center mb-5">03</div>
            <h3 class="text-slate-800 dark:text-slate-200 font-semibold mb-2">Deploy and watch</h3>
