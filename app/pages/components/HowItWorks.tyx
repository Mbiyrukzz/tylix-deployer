            <div class="mt-auto rounded-xl border border-slate-300 dark:border-slate-800 bg-slate-950 p-3 font-mono text-[11px] leading-relaxed" aria-hidden="true">
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">pulled main</span></p>
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">installed dependencies</span></p>
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">built and restarted</span></p>
              <div class="h-1 w-full rounded-full bg-slate-800 overflow-hidden my-2"><div class="h-full w-full rounded-full bg-brand-500"></div></div>
