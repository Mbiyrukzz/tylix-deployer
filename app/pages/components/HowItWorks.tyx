component HowItWorks

import { IconShieldCheck, IconCode, IconTerminal, IconGauge } from "tylix-icons"

// Home page: bare server to live site in three steps, each with a small
// picture of that step (decorative, hidden from screen readers).

computed
  clouds() {
    return ["hetzner", "digitalocean", "vultr", "linode", "aws"]
  }

  picks() {
    return [
      { id: "laravel", name: "Laravel", on: true },
      { id: "nextjs", name: "Next.js", on: false },
      { id: "django", name: "Django", on: false },
      { id: "go", name: "Go", on: false }
    ]
  }

  extras() {
    return [
      { key: "ssl", text: "Free SSL in one click" },
      { key: "env", text: "Editable env and deploy script" },
      { key: "term", text: "Web terminal on every server" },
      { key: "stats", text: "Live server stats" }
    ]
  }

action
  pickCls(on) {
    const base = "flex items-center gap-2 rounded-lg border px-2 py-1.5 "
    if on {
      return base + "border-brand-500/50 bg-brand-500/10 text-slate-900 dark:text-slate-100"
    }
    return base + "border-line text-slate-500"
  }

template
<section class="px-4 sm:px-6 py-20 sm:py-24 border-b border-line">
  <div class="max-w-6xl mx-auto">

    <div class="max-w-2xl mb-12">
      <p class="text-brand-700 dark:text-brand-400 text-xs font-semibold uppercase tracking-[0.16em] mb-3">How it works</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-4 text-balance">From a bare server to live in three steps</h2>
      <p class="text-slate-500 leading-relaxed">No SSH sessions and no copy-pasted scripts. Bring a server, pick a stack, and press deploy.</p>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <li class="relative rounded-2xl border border-line bg-panel p-6 flex flex-col">
        <span class="relative w-9 h-9 rounded-full bg-brand-500 text-white font-mono text-sm font-semibold flex items-center justify-center mb-5">1</span>
        <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-2">Connect your server</h3>
        <p class="text-slate-500 text-sm leading-relaxed mb-6">Create one at your cloud provider from the dashboard, or add any server you can reach over SSH. Keys are stored encrypted.</p>

        <div class="mt-auto rounded-xl border border-line bg-sunken p-3.5" aria-hidden="true">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-1">
{{#each id in clouds}}
              <BrandLogo kind="{{ id }}" size="sm" />
{{/each}}
            </div>
            <span class="text-[11px] text-slate-500">+2 more</span>
          </div>
          <div class="font-mono text-[11px] space-y-1.5 pt-3 border-t border-line">
            <div class="flex items-center justify-between"><span class="text-slate-500">host</span><span class="text-slate-700 dark:text-slate-300">203.0.113.24</span></div>
            <div class="flex items-center justify-between"><span class="text-slate-500">user</span><span class="text-slate-700 dark:text-slate-300">deploy</span></div>
            <div class="flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> connected</div>
          </div>
        </div>
      </li>

      <li class="relative rounded-2xl border border-line bg-panel p-6 flex flex-col">
        <span class="relative w-9 h-9 rounded-full bg-brand-500 text-white font-mono text-sm font-semibold flex items-center justify-center mb-5">2</span>
        <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-2">Choose your stack</h3>
        <p class="text-slate-500 text-sm leading-relaxed mb-6">Sixteen site types, from Laravel and Next.js to Django, Go and Rust. Point the site at your repository and branch.</p>

        <div class="mt-auto rounded-xl border border-line bg-sunken p-3.5" aria-hidden="true">
          <div class="grid grid-cols-2 gap-1.5 mb-3 text-xs font-medium">
{{#each p in picks}}
            <span class="{{ pickCls(p.on) }}"><BrandLogo kind="{{ p.id }}" size="xs" /> {{ p.name }}</span>
{{/each}}
          </div>
          <div class="font-mono text-[11px] space-y-1.5 pt-3 border-t border-line">
            <div class="flex items-center justify-between"><span class="text-slate-500">repo</span><span class="text-slate-700 dark:text-slate-300">acme/shop</span></div>
            <div class="flex items-center justify-between"><span class="text-slate-500">branch</span><span class="text-slate-700 dark:text-slate-300">main</span></div>
          </div>
        </div>
      </li>

      <li class="relative rounded-2xl border border-line bg-panel p-6 flex flex-col">
        <span class="relative w-9 h-9 rounded-full bg-brand-500 text-white font-mono text-sm font-semibold flex items-center justify-center mb-5">3</span>
        <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-2">Deploy and watch</h3>
        <p class="text-slate-500 text-sm leading-relaxed mb-6">Follow the release step by step, then keep an eye on CPU, memory, disk and uptime from the server page.</p>

        <div class="mt-auto rounded-xl border border-line bg-zinc-950 p-3.5 font-mono text-[11px] leading-relaxed" aria-hidden="true">
          <p class="text-zinc-400"><span class="text-emerald-400">✓</span> pulled main</p>
          <p class="text-zinc-400"><span class="text-emerald-400">✓</span> installed dependencies</p>
          <p class="text-zinc-400"><span class="text-emerald-400">✓</span> built and restarted</p>
          <div class="h-1 w-full rounded-full bg-zinc-800 overflow-hidden my-2.5"><div class="h-full w-full rounded-full bg-emerald-500"></div></div>
          <p class="text-emerald-400 flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> live in 38s</p>
        </div>
      </li>
    </ol>

    <div class="mt-4 rounded-2xl border border-line bg-panel px-5 sm:px-6 py-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[auto_1fr_1fr_1fr_1fr] items-center gap-x-6 gap-y-3">
      <p class="text-slate-900 dark:text-slate-100 text-sm font-semibold sm:col-span-2 lg:col-span-1">Once it's live</p>
{{#each x in extras}}
      <span class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
{{#if x.key is "ssl"}}
        <IconShieldCheck class="w-4 h-4 shrink-0 text-brand-500" />
{{/if}}
{{#if x.key is "env"}}
        <IconCode class="w-4 h-4 shrink-0 text-brand-500" />
{{/if}}
{{#if x.key is "term"}}
        <IconTerminal class="w-4 h-4 shrink-0 text-brand-500" />
{{/if}}
{{#if x.key is "stats"}}
        <IconGauge class="w-4 h-4 shrink-0 text-brand-500" />
{{/if}}
        {{ x.text }}
      </span>
{{/each}}
    </div>
  </div>
</section>
