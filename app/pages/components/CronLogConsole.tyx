component CronLogConsole

import { IconX, IconCopy, IconMaximize, IconMinimize, IconDocumentText, IconClock, IconCalendarClock, IconPlay } from "tylix-icons"

// A cron job's log, popped over the Cron jobs page in the same console window
// as the worker log: when the job runs next (and the runs after that) down
// the side, the log tail in a glowing well that follows new output while
// "live" is on, a "Run now" result above it, and a status bar. The page owns
// the log, the polling and the scrolling; this draws it.
//
// The scrolling element is #cron-log-scroll.
//
// info is the /cron-jobs/:cid/log reply without the log: { server_time,
// timezone { name, offset, minutes }, last_output_at, size, cron,
// schedule { expression, text, reboot, next[] } }. now ticks with every poll
// so "in 4 min" stays current.

props
  job: Object
  host: String
  info: any
  now: any
  lines: any
  shown: any
  tabs: any
  filter: String
  loading: Boolean
  error: String
  live: Boolean
  atBottom: Boolean
  copied: Boolean
  errors: any
  warns: any
  running: Boolean
  runOutput: String
  runCode: any
  onClose: Function
  onCopy: Function
  onFilter: Function
  onToggleLive: Function
  onJumpBottom: Function
  onRun: Function
  onClearRun: Function

state
  full: false

computed
  cronState() {
    return this.info ? String(this.info.cron or "unknown") : "loading"
  }

  upcoming() {
    return this.info and this.info.schedule and Array.isArray(this.info.schedule.next) ? this.info.schedule.next : []
  }

  isReboot() {
    return Boolean(this.info and this.info.schedule and this.info.schedule.reboot)
  }

  scheduleText() {
    if not this.job {
      return ""
    }
    const text = this.info and this.info.schedule ? this.info.schedule.text : (this.job.schedule_text or "")
    return text or "Custom schedule"
  }

  zoneText() {
    if not this.info or not this.info.timezone {
      return ""
    }
    const z = String(this.info.timezone.offset or "+0000")
    const pretty = "UTC" + z.slice(0, 3) + ":" + z.slice(3)
    const name = String(this.info.timezone.name or "")
    return name and name is not "UTC" ? name + ", " + pretty : pretty
  }

  sameZone() {
    if not this.info or not this.info.timezone {
      return true
    }
    return -new Date().getTimezoneOffset() is Number(this.info.timezone.minutes or 0)
  }

  nextText() {
    if this.isReboot {
      return "Runs when the server starts"
    }
    if this.upcoming.length is 0 {
      return this.info ? "This schedule never matches a date" : ""
    }
    return "Next run " + this.rel(this.upcoming[0])
  }

  statusText() {
    const st = this.cronState
    if st is "loading" {
      return "Connecting"
    }
    if st is "active" {
      return "Cron is running"
    }
    if st is "unknown" {
      return "Cron status unknown"
    }
    return "Cron is " + st + ": jobs won't run"
  }

  orbCls() {
    const base = "relative w-2.5 h-2.5 shrink-0 rounded-full "
    const st = this.cronState
    if st is "active" {
      return base + "bg-emerald-400 animate-pulse shadow-[0_0_10px_rgb(52_211_153/0.7)]"
    }
    if st is "loading" or st is "unknown" {
      return base + "bg-sky-400 animate-pulse shadow-[0_0_10px_rgb(56_189_248/0.6)]"
    }
    return base + "bg-brand-500 shadow-[0_0_10px_rgb(240_103_107/0.7)]"
  }

  lastOutput() {
    if not this.info or not this.info.last_output_at {
      return "Never"
    }
    return this.ago(this.info.last_output_at)
  }

  sizeText() {
    const b = this.info ? Number(this.info.size or 0) : 0
    if b < 1024 {
      return b + " B"
    }
    if b < 1048576 {
      return (b / 1024).toFixed(1) + " KB"
    }
    return (b / 1048576).toFixed(1) + " MB"
  }

  runFailed() {
    return this.runCode is not null and this.runCode is not undefined and Number(this.runCode) is not 0
  }

  outerCls() {
    if this.full {
      return "cx-root fixed inset-0 z-[70] flex"
    }
    return "cx-root fixed inset-0 z-[70] flex items-stretch sm:items-center justify-center sm:p-5 lg:p-8"
  }

  windowCls() {
    const base = "cx-shell cx-grain cx-pop relative flex w-full overflow-hidden text-zinc-200 "
    if this.full {
      return base + "h-full"
    }
    return base + "h-full sm:h-[min(880px,calc(100vh-2.5rem))] max-w-[1380px] sm:rounded-[22px]"
  }

action
  // "in 4 min", "in 2 h 10 min", "in 3 days". now comes from the page.
  rel(iso) {
    const diff = Date.parse(iso) - Number(this.now or Date.now())
    if Number.isNaN(diff) {
      return ""
    }
    if diff < 60000 {
      return diff <= 0 ? "now" : "in under a minute"
    }
    const mins = Math.round(diff / 60000)
    if mins < 60 {
      return "in " + mins + " min"
    }
    const hours = Math.floor(mins / 60)
    if hours < 24 {
      const rest = mins % 60
      return "in " + hours + " h" + (rest ? " " + rest + " min" : "")
    }
    const days = Math.round(hours / 24)
    return "in " + days + (days is 1 ? " day" : " days")
  }

  ago(iso) {
    const diff = Number(this.now or Date.now()) - Date.parse(iso)
    if Number.isNaN(diff) {
      return ""
    }
    if diff < 60000 {
      return "just now"
    }
    const mins = Math.round(diff / 60000)
    if mins < 60 {
      return mins + " min ago"
    }
    const hours = Math.round(mins / 60)
    if hours < 24 {
      return hours + " h ago"
    }
    const days = Math.round(hours / 24)
    return days + (days is 1 ? " day ago" : " days ago")
  }

  // A run time as the server's clock shows it (cron reads the schedule in
  // server time), so it lines up with the expression the user wrote.
  serverTime(iso) {
    const minutes = this.info and this.info.timezone ? Number(this.info.timezone.minutes or 0) : 0
    const d = new Date(Date.parse(iso) + minutes * 60000)
    return d.toLocaleString(undefined, { timeZone: "UTC", weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })
  }

  localTime(iso) {
    return new Date(iso).toLocaleString(undefined, { weekday: "short", hour: "2-digit", minute: "2-digit" })
  }

  toggleFull() {
    this.full = not this.full
  }

  dismiss() {
    this.onClose()
  }

  copy() {
    this.onCopy()
  }

  pick(key) {
    this.onFilter(key)
  }

  toggleLive() {
    this.onToggleLive()
  }

  bottom() {
    this.onJumpBottom()
  }

  run() {
    this.onRun()
  }

  clearRun() {
    this.onClearRun()
  }

template
<div class="{{ outerCls }}">
  <div onclick="{{ dismiss() }}" aria-hidden="true" class="cx-fade cx-grain absolute inset-0 bg-[#050506]/75 backdrop-blur-md"></div>

  <div role="dialog" aria-modal="true" aria-label="Cron job log" class="{{ windowCls }}">

    <!-- rail -->
    <nav aria-label="Console" class="hidden md:flex w-[64px] shrink-0 flex-col items-center gap-2 py-3 border-r border-white/[0.05] bg-black/25">
      <span aria-hidden="true" class="mb-2 w-10 h-10 rounded-xl flex items-center justify-center bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-[0_0_24px_-4px_rgb(240_103_107/0.7),inset_0_1px_0_rgb(255_255_255/0.25)]">
        <IconClock class="w-5 h-5" />
      </span>
      <span title="Cron log" class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-white/[0.08] text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)]">
        <IconDocumentText class="w-5 h-5" />
{{#if errors is not 0}}
        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 rounded-full bg-brand-500 text-white text-[10px] font-bold leading-[18px] text-center ring-2 ring-[#111113]">{{ errors > 99 ? "99+" : errors }}</span>
{{/if}}
      </span>
      <div class="mt-auto flex flex-col items-center gap-1">
        <button onclick="{{ toggleFull() }}" title="{{ full ? 'Exit full screen' : 'Full screen' }}" aria-label="Toggle full screen" class="cx-icon-btn">
{{#if full}}
          <IconMinimize class="w-4 h-4" />
{{#else}}
          <IconMaximize class="w-4 h-4" />
{{/if}}
        </button>
      </div>
    </nav>

    <div class="flex-1 min-w-0 flex flex-col">

      <!-- header -->
      <header class="flex items-center gap-2 sm:gap-3 h-14 shrink-0 px-2.5 sm:px-4 border-b border-white/[0.05]">
        <div class="min-w-0 flex items-center gap-3 pl-2 pr-2.5 py-1.5">
          <span class="{{ orbCls }}"></span>
          <span class="min-w-0">
            <span class="block text-[13px] sm:text-[13.5px] font-medium text-zinc-100 truncate leading-tight">{{ job.name }}</span>
            <span class="block text-[11px] text-zinc-300 truncate leading-tight mt-0.5"><span class="font-mono text-brand-300">{{ job.schedule }}</span> · {{ scheduleText }}</span>
          </span>
        </div>

        <div class="ml-auto flex items-center gap-1">
          <button onclick="{{ toggleLive() }}" title="{{ live ? 'Pause live updates' : 'Follow new output' }}" class="inline-flex shrink-0 items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-zinc-200 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] transition-colors">
{{#if live}}
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgb(52_211_153/0.9)]"></span> Live
{{#else}}
            <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Paused
{{/if}}
          </button>
{{#if running}}
          <span class="inline-flex shrink-0 items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-amber-300 bg-amber-400/10 shadow-[inset_0_0_0_1px_rgb(251_191_36/0.3)]">
            <span class="w-3 h-3 rounded-full border-2 border-current border-t-transparent animate-spin"></span><span class="hidden sm:inline">Running…</span>
          </span>
{{#else}}
          <button onclick="{{ run() }}" title="Run the command once now" class="inline-flex shrink-0 items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-medium text-zinc-200 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.08)] transition-colors">
            <IconPlay class="w-3.5 h-3.5" /><span class="hidden sm:inline">Run now</span>
          </button>
{{/if}}
          <button onclick="{{ copy() }}" title="Copy the log" aria-label="Copy the log" class="cx-icon-btn">
{{#if copied}}
            <span class="text-[11px] font-medium text-emerald-300">Copied</span>
{{#else}}
            <IconCopy class="w-4 h-4" />
{{/if}}
          </button>
          <span class="hidden sm:block w-px h-5 mx-1.5 bg-white/[0.07]"></span>
          <button onclick="{{ toggleFull() }}" title="Full screen" aria-label="Toggle full screen" class="cx-icon-btn md:hidden">
{{#if full}}
            <IconMinimize class="w-4 h-4" />
{{#else}}
            <IconMaximize class="w-4 h-4" />
{{/if}}
          </button>
          <button onclick="{{ dismiss() }}" title="Close (Esc)" aria-label="Close" class="cx-icon-btn hover:!bg-brand-500/20 hover:!text-brand-200"><IconX class="w-4 h-4" /></button>
        </div>
      </header>

      <!-- body -->
      <div class="relative flex-1 min-h-0 flex">

        <!-- schedule -->
        <aside class="hidden lg:flex w-[288px] shrink-0 flex-col gap-1 p-3 pr-0 overflow-y-auto cx-scroll">
          <p class="px-2.5 pt-1 pb-2 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-300">Schedule</p>

          <div class="cx-well rounded-xl p-3.5">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 shrink-0 rounded-lg flex items-center justify-center bg-brand-500/15 text-brand-300 shadow-[inset_0_0_0_1px_rgb(240_103_107/0.35)]">
                <IconCalendarClock class="w-4 h-4" />
              </span>
              <span class="min-w-0">
                <span class="block font-mono text-[13px] text-zinc-100 truncate">{{ job.schedule }}</span>
                <span class="block text-[11.5px] text-zinc-300 truncate">{{ scheduleText }}</span>
              </span>
            </div>

{{#if not info}}
            <div class="mt-4 space-y-2" aria-label="Loading">
              <div class="h-6 w-2/3 rounded bg-white/[0.05] animate-pulse"></div>
              <div class="h-3 w-1/2 rounded bg-white/[0.04] animate-pulse"></div>
            </div>
{{/if}}
{{#if info}}
{{#if isReboot}}
            <p class="mt-4 text-[13px] text-zinc-200">Runs once each time the server boots, not on a clock.</p>
{{/if}}
{{#if not isReboot}}
{{#if upcoming.length is 0}}
            <p class="mt-4 text-[13px] text-amber-300">This schedule never matches a real date, so the job never runs.</p>
{{/if}}
{{#if upcoming.length is not 0}}
            <p class="mt-4 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-400">Next run</p>
            <p class="mt-1 text-[22px] leading-tight font-semibold tracking-tight text-white">{{ rel(upcoming[0]) }}</p>
            <p class="mt-1 font-mono text-[12px] text-emerald-300">{{ serverTime(upcoming[0]) }}</p>
{{#if not sameZone}}
            <p class="text-[11px] text-zinc-400">{{ localTime(upcoming[0]) }} your time</p>
{{/if}}
{{/if}}
{{/if}}
{{/if}}
          </div>

{{#if upcoming.length > 1}}
          <p class="px-2.5 pt-4 pb-1.5 text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-300">After that</p>
{{#each t, i in upcoming}}
{{#if i > 0}}
          <div class="w-full flex items-center gap-3 rounded-xl px-2.5 py-2 bg-white/[0.03]">
            <span class="w-6 h-6 shrink-0 inline-flex items-center justify-center rounded-lg text-[10.5px] font-semibold bg-white/[0.06] text-zinc-300 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.1)]">{{ i + 1 }}</span>
            <span class="min-w-0 flex-1 font-mono text-[12px] text-zinc-100 truncate">{{ serverTime(t) }}</span>
            <span class="shrink-0 text-[11px] text-zinc-400">{{ rel(t) }}</span>
          </div>
{{/if}}
{{/each}}
{{/if}}

{{#if zoneText}}
          <p class="px-2.5 pt-2 text-[11px] text-zinc-400">Server time, {{ zoneText }}. Cron reads the schedule in this timezone.</p>
{{/if}}

          <div class="mt-3 px-2.5 space-y-1 text-[11px] text-zinc-400 font-mono">
            <p class="truncate" title="{{ job.command }}"><span class="text-zinc-500">$</span> {{ job.command }}</p>
            <p class="truncate"><span class="text-zinc-500">as</span> {{ job.ssh_user }}</p>
          </div>

          <div class="mt-auto pt-4 px-2.5">
            <div class="cx-well rounded-xl p-3">
              <p class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-zinc-300 mb-2">Last {{ lines.length }} lines</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-3">
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums {{ errors > 0 ? 'text-brand-300' : 'text-emerald-300' }}">{{ errors }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">errors</p>
                </div>
                <div>
                  <p class="font-mono text-[20px] leading-none tabular-nums {{ warns > 0 ? 'text-amber-300' : 'text-zinc-100' }}">{{ warns }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">warnings</p>
                </div>
                <div>
                  <p class="font-mono text-[15px] leading-tight text-zinc-100 truncate">{{ lastOutput }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">last output</p>
                </div>
                <div>
                  <p class="font-mono text-[15px] leading-tight tabular-nums text-zinc-100">{{ sizeText }}</p>
                  <p class="text-[11px] text-zinc-300 mt-1">log size</p>
                </div>
              </div>
            </div>
          </div>
        </aside>

        <div class="flex-1 min-w-0 flex flex-col gap-2 p-2 sm:p-3">
          <!-- next run, for screens without the side panel -->
{{#if nextText}}
          <div class="lg:hidden flex items-center gap-2.5 rounded-xl px-3 py-2 bg-white/[0.04] shadow-[inset_0_0_0_1px_rgb(255_255_255/0.06)]">
            <IconCalendarClock class="w-4 h-4 shrink-0 text-brand-300" />
            <span class="min-w-0 flex-1 text-[12.5px] text-zinc-100 truncate">{{ nextText }}</span>
{{#if upcoming.length is not 0}}
            <span class="shrink-0 font-mono text-[11.5px] text-emerald-300">{{ serverTime(upcoming[0]) }}</span>
{{/if}}
          </div>
{{/if}}

          <!-- run now result -->
{{#if running}}
          <div class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 bg-amber-400/[0.07] shadow-[inset_0_0_0_1px_rgb(251_191_36/0.25)] text-[12.5px] text-amber-200">
            <span class="w-3 h-3 rounded-full border-2 border-current border-t-transparent animate-spin"></span> Running the command once as {{ job.ssh_user }}…
          </div>
{{/if}}
{{#if runOutput}}
{{#if not running}}
          <div class="rounded-xl overflow-hidden {{ runFailed ? 'bg-brand-500/[0.07] shadow-[inset_0_0_0_1px_rgb(240_103_107/0.3)]' : 'bg-emerald-400/[0.05] shadow-[inset_0_0_0_1px_rgb(52_211_153/0.22)]' }}">
            <div class="flex items-center gap-2 px-3 py-2 text-[12px]">
              <span class="font-semibold {{ runFailed ? 'text-brand-300' : 'text-emerald-300' }}">{{ runFailed ? "✕ Manual run failed" : "✓ Manual run finished" }}</span>
{{#if runCode is not null}}
              <span class="font-mono text-zinc-400">exit {{ runCode }}</span>
{{/if}}
              <button onclick="{{ clearRun() }}" title="Hide" aria-label="Hide the run output" class="ml-auto cx-icon-btn !w-7 !h-7"><IconX class="w-3.5 h-3.5" /></button>
            </div>
            <div class="max-h-48 overflow-auto cx-scroll px-3 pb-3 font-mono text-[12px] leading-5 text-zinc-200 whitespace-pre-wrap [overflow-wrap:anywhere]">{{ runOutput }}</div>
          </div>
{{/if}}
{{/if}}

          <!-- toolbar -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
{{#each t in tabs}}
            <button onclick="{{ pick(t.key) }}" aria-pressed="{{ t.key is filter }}" class="cx-chip">
              {{ t.label }}
              <span class="font-mono text-[11px] opacity-70 tabular-nums">{{ t.count }}</span>
            </button>
{{/each}}
            <span class="ml-auto shrink-0 inline-flex items-center gap-1.5 text-[11.5px] text-zinc-300">
{{#if live}}
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> {{ atBottom ? "Following output" : "Paused, scrolled up" }}
{{#else}}
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Live updates paused
{{/if}}
            </span>
          </div>

          <!-- stream -->
          <div class="cx-frame cx-well relative z-[1] flex-1 min-h-0 rounded-2xl overflow-hidden flex" data-live="{{ live }}" data-tone="{{ errors > 0 ? 'warn' : 'ok' }}">
{{#if live}}
            <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px z-[3] overflow-hidden">
              <div class="cx-scanline h-full w-full bg-gradient-to-r from-transparent via-brand-400 to-transparent"></div>
            </div>
{{/if}}
            <div id="cron-log-scroll" class="flex-1 min-w-0 overflow-auto overscroll-contain cx-scroll py-3 font-mono font-medium text-[12.5px] leading-6">
              <p class="px-3 sm:px-4 pb-2 text-zinc-300 break-all"><span class="text-brand-300">root@{{ host }}</span><span class="text-zinc-400">:~$</span> <span class="text-zinc-200">tail -f /var/log/tylix-cron-{{ job.id }}.log</span></p>

{{#if error}}
              <p class="px-3 sm:px-4 py-1 text-brand-300">{{ error }}</p>
{{/if}}

{{#if loading}}
              <div class="px-3 sm:px-4 space-y-2 pt-1" aria-label="Loading">
                <p class="flex items-center gap-2 text-zinc-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span> Reading the log…</p>
                <div class="h-3 w-2/3 rounded bg-white/[0.04] animate-pulse"></div>
                <div class="h-3 w-1/2 rounded bg-white/[0.04] animate-pulse"></div>
                <div class="h-3 w-3/4 rounded bg-white/[0.04] animate-pulse"></div>
              </div>
{{/if}}

{{#if not loading}}
{{#if lines.length is 0}}
              <div class="px-3 sm:px-4 text-zinc-400">
                <p>No output yet. Whatever the job prints each run is appended here.</p>
{{#if upcoming.length is not 0}}
                <p class="mt-1">The next run is {{ rel(upcoming[0]) }}, at {{ serverTime(upcoming[0]) }}. Or use Run now to try it.</p>
{{/if}}
              </div>
{{/if}}
{{#if lines.length is not 0}}
{{#if shown.length is 0}}
              <div class="px-3 sm:px-4 py-6">
                <p class="text-emerald-300">Nothing matches this filter.</p>
                <p class="text-zinc-400">Pick All to see every line.</p>
              </div>
{{/if}}
{{#each l in shown}}
              <div class="flex items-start border-l-2 hover:bg-white/[0.03] {{ l.rowCls }}">
                <span class="w-12 shrink-0 pr-3 text-right text-zinc-600 tabular-nums select-none">{{ l.n }}</span>
                <span class="w-4 shrink-0 text-center select-none opacity-80 {{ l.cls }}">{{ l.icon }}</span>
                <span class="min-w-0 flex-1 pl-2 pr-4 whitespace-pre-wrap [overflow-wrap:anywhere] {{ l.cls }}">{{#if l.ts}}<span class="text-zinc-500 mr-2">{{ l.ts }}</span>{{/if}}{{ l.text }}</span>
              </div>
{{/each}}
{{/if}}
{{#if live}}
              <p class="px-3 sm:px-4 pt-2 text-zinc-300"><span class="inline-block w-[7px] h-[14px] -mb-[2px] bg-brand-400/80 animate-pulse"></span></p>
{{/if}}
{{/if}}
            </div>

{{#if not atBottom}}
            <button onclick="{{ bottom() }}" class="cx-pop absolute bottom-3 right-6 z-[4] inline-flex items-center gap-1.5 h-8 rounded-lg px-3 text-[12px] font-semibold text-white bg-brand-500 hover:bg-brand-400 shadow-[0_0_24px_-6px_rgb(240_103_107/0.8)] transition-colors">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M10 4v12M5 11l5 5 5-5" /></svg>
              Jump to bottom
            </button>
{{/if}}
          </div>
        </div>
      </div>

      <!-- status bar -->
      <footer class="shrink-0 flex items-center gap-3 h-9 px-3 sm:px-4 border-t border-white/[0.05] bg-black/20 text-[11px] text-zinc-300">
        <span class="flex items-center gap-1.5 shrink-0 min-w-0"><span class="{{ orbCls }} !w-1.5 !h-1.5"></span><span class="truncate">{{ statusText }}</span></span>
        <span class="hidden sm:inline"><span class="font-mono text-zinc-200">{{ shown.length }}</span> shown</span>
        <span><span class="font-mono {{ errors > 0 ? 'text-brand-300' : 'text-zinc-200' }}">{{ errors }}</span> errors</span>
        <span class="hidden md:inline">{{ live ? "refreshes every 5s" : "paused" }}</span>
        <span class="ml-auto hidden sm:flex items-center gap-1.5"><span class="cx-kbd">Esc</span> close</span>
      </footer>
    </div>
  </div>
</div>
