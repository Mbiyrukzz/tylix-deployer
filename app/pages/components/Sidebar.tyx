component Sidebar

import { IconLayoutDashboard, IconServer, IconCloud, IconCode, IconCog, IconGlobe, IconDotsHorizontal, IconUsers, IconBookOpen, IconX, IconSearch, IconShieldCheck } from "tylix-icons"

// The main navigation. It lives in app/pages/_layout.tyx and stays mounted
// while you move between app pages (public/app-shell.js swaps only the page),
// so the current item follows the URL instead of a prop.
//
// Large screens: a fixed column that collapses to icons ([ or the button at
// the bottom). Its width is a CSS variable set before first paint, so the
// page never jumps. Phones and tablets: a bottom tab bar plus a "More" sheet.

uses
  Auth

state
  // The signed-in user after a change on Settings -> Account (flux:user),
  // which the shell's own Auth capability doesn't see.
  me: null
  path: "/"
  moreOpen: false
  serverCount: ""
  providerCount: ""
  domainCount: ""
  status: "unknown"
  countsAt: 0

action
  // The app shell (public/app-shell.js). Read through Reflect so the .tyx
  // typechecker, which doesn't know about it, types it as any.
  shell() {
    return Reflect.get(window, "__flux")
  }

  sectionOf(path) {
    if path.startsWith("/dashboard") {
      return "overview"
    }
    if path.startsWith("/servers") {
      return "servers"
    }
    if path.startsWith("/providers") {
      return "providers"
    }
    if path.startsWith("/registrars") {
      return "registrars"
    }
    if path.startsWith("/source-control") {
      return "source-control"
    }
    if path.startsWith("/team") {
      return "team"
    }
    if path.startsWith("/settings") {
      return "settings"
    }
    if path.startsWith("/admin") {
      return "admin"
    }
    return ""
  }

  isOn(key) {
    return this.sectionOf(this.path) is key
  }

  cur(key) {
    return this.isOn(key) ? "page" : "false"
  }

  itemCls(key) {
    const base = "flux-sb-item group relative flex items-center gap-3 h-9 px-3 rounded-xl text-[13.5px] font-medium transition-colors "
    if this.isOn(key) {
      return base + "bg-white text-zinc-900 shadow-sm ring-1 ring-black/[0.06] dark:ring-0"
    }
    return base + "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.04]"
  }

  iconCls(key) {
    if this.isOn(key) {
      return "w-[18px] h-[18px] shrink-0 text-zinc-900"
    }
    return "w-[18px] h-[18px] shrink-0 text-zinc-400 dark:text-zinc-500 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors"
  }

  badgeCls(key) {
    const base = "flux-sb-badge ml-auto min-w-[22px] text-center text-[11px] font-medium tabular-nums rounded-md px-1.5 py-px "
    if this.isOn(key) {
      return base + "bg-zinc-100 text-zinc-600"
    }
    return base + "bg-zinc-200/60 text-zinc-500 dark:bg-white/[0.06] dark:text-zinc-400"
  }

  tabCls(key) {
    const base = "flex-1 min-w-0 flex flex-col items-center justify-center gap-1 h-14 rounded-2xl text-[11px] font-medium transition-colors "
    if this.isOn(key) {
      return base + "text-zinc-900 dark:text-white"
    }
    return base + "text-zinc-500 active:bg-zinc-200/60 dark:active:bg-white/[0.06]"
  }

  tabIconCls(key) {
    if this.isOn(key) {
      return "flex items-center justify-center w-12 h-7 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
    }
    return "flex items-center justify-center w-12 h-7 rounded-full"
  }

  inMore() {
    const s = this.sectionOf(this.path)
    return s is "team" or s is "source-control" or s is "settings" or s is "admin"
  }

  // Flux admins (FLUX_ADMIN_EMAILS) see the Admin section. Read from Auth,
  // not `me`: flux:user carries the profile only. The API checks it again.
  isFluxAdmin() {
    return Boolean(Auth.user and Auth.user.flux_admin)
  }

  moreTabCls() {
    const base = "flex-1 min-w-0 flex flex-col items-center justify-center gap-1 h-14 rounded-2xl text-[11px] font-medium transition-colors "
    if this.inMore() or this.moreOpen {
      return base + "text-zinc-900 dark:text-white"
    }
    return base + "text-zinc-500 active:bg-zinc-200/60 dark:active:bg-white/[0.06]"
  }

  moreIconCls() {
    if this.inMore() or this.moreOpen {
      return "flex items-center justify-center w-12 h-7 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
    }
    return "flex items-center justify-center w-12 h-7 rounded-full"
  }

  sheetLink(key) {
    const base = "flex items-center gap-3 rounded-2xl px-4 py-3 text-[15px] font-medium transition-colors "
    if this.isOn(key) {
      return base + "bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
    }
    return base + "text-zinc-700 dark:text-zinc-200 active:bg-zinc-200/60 dark:active:bg-white/[0.06]"
  }

  statusDot() {
    if this.status is "operational" {
      return "w-2 h-2 shrink-0 rounded-full bg-emerald-500"
    }
    if this.status is "outage" {
      return "w-2 h-2 shrink-0 rounded-full bg-brand-500 animate-flux-pulse"
    }
    return "w-2 h-2 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600"
  }

  statusText() {
    if this.status is "operational" {
      return "All systems normal"
    }
    if this.status is "outage" {
      return "Service disruption"
    }
    return "System status"
  }

  initial() {
    const u = this.me or Auth.user
    if not u {
      return "?"
    }
    const source = u.name or u.email or "?"
    return String(source).charAt(0).toUpperCase()
  }

  avatar() {
    const u = this.me or Auth.user
    return u and u.avatar_url ? String(u.avatar_url) : ""
  }

  userName() {
    const u = this.me or Auth.user
    return u ? (u.name or "Your account") : "Your account"
  }

  userEmail() {
    const u = this.me or Auth.user
    return u ? (u.email or "") : ""
  }

  toggleMore() {
    this.moreOpen = not this.moreOpen
  }

  closeMore() {
    this.moreOpen = false
  }

  collapse() {
    if this.shell() {
      this.shell().sidebar()
    }
  }

  openPalette() {
    this.moreOpen = false
    if this.shell() {
      this.shell().emit("flux:palette", {})
    }
  }

  countOf(res) {
    if res.ok and Array.isArray(res.data) {
      return String(res.data.length)
    }
    if res.ok and res.data and Array.isArray(res.data.data) {
      return String(res.data.data.length)
    }
    return ""
  }

  // Counts load once, then refresh at most once a minute as you move around.
  async loadCounts(force) {
    if not force and Date.now() - this.countsAt < 60000 {
      return null
    }
    this.countsAt = Date.now()
    const all = await Promise.all([
      useApi("/api/servers"),
      useApi("/api/providers"),
      useApi("/api/registrars")
    ])
    this.serverCount = this.countOf(all[0])
    this.providerCount = this.countOf(all[1])
    this.domainCount = this.countOf(all[2])
  }

  async loadStatus() {
    const res = await useApi("/api/status")
    if res.ok and res.data and res.data.state {
      this.status = res.data.state
    }
  }

  onNavigated() {
    this.path = window.location.pathname
    this.moreOpen = false
    this.loadCounts(false)
  }

onMount
  async {
    this.path = window.location.pathname
    const flux = this.shell()
    if flux {
      flux.on(window, "flux:user", (e) => {
        this.me = e.detail
      })
      flux.on(window, "flux:navigated", () => this.onNavigated())
      flux.on(window, "popstate", () => this.onNavigated())
      flux.on(window, "flux:counts", () => this.loadCounts(true))
      flux.every(5 * 60 * 1000, () => this.loadStatus())
    }
    this.loadCounts(true)
    this.loadStatus()
  }

template
<div class="contents">
<aside aria-label="Main" class="flux-sidebar hidden lg:flex flex-col fixed inset-y-0 left-0 z-40 border-r border-line">

  <div class="h-16 shrink-0 flex items-center gap-3 px-4">
    <a href="/dashboard" class="flex items-center gap-3 min-w-0 rounded-xl" title="Tylix Flux">
      <img src="/flux-mark.svg" alt="" class="w-9 h-9 shrink-0 rounded-[10px]" />
      <span class="flux-sb-label min-w-0 flex flex-col leading-tight">
        <span class="text-[15px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">Tylix Flux</span>
        <span class="text-[11px] text-zinc-500 truncate">Servers · sites · domains</span>
      </span>
    </a>
  </div>

  <div class="px-3 pt-1">
    <button onclick="{{ openPalette() }}" title="Search (Ctrl K)" class="flux-sb-item w-full flex items-center gap-2.5 h-9 px-3 rounded-xl border border-line bg-panel text-[13px] text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 hover:border-line-strong transition-colors">
      <IconSearch class="w-4 h-4 shrink-0" />
      <span class="flux-sb-label flex-1 text-left">Search</span>
      <span class="flux-sb-wide flux-kbd">⌘K</span>
    </button>
  </div>

  <nav class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden px-3 pb-3 no-scrollbar">
    <p class="flux-sb-section px-3 pt-5 pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">Workspace</p>
    <div class="flex flex-col gap-0.5">
      <a href="/dashboard" title="Overview" aria-current="{{ cur('overview') }}" class="{{ itemCls('overview') }}">
        <IconLayoutDashboard class="{{ iconCls('overview') }}" />
        <span class="flux-sb-label truncate">Overview</span>
      </a>
      <a href="/servers" title="Servers" aria-current="{{ cur('servers') }}" class="{{ itemCls('servers') }}">
        <IconServer class="{{ iconCls('servers') }}" />
        <span class="flux-sb-label truncate">Servers</span>
{{#if serverCount}}
        <span class="{{ badgeCls('servers') }}">{{ serverCount }}</span>
{{/if}}
      </a>
    </div>

    <p class="flux-sb-section px-3 pt-6 pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">Connections</p>
    <div class="flex flex-col gap-0.5">
      <a href="/providers" title="Cloud providers" aria-current="{{ cur('providers') }}" class="{{ itemCls('providers') }}">
        <IconCloud class="{{ iconCls('providers') }}" />
        <span class="flux-sb-label truncate">Cloud providers</span>
{{#if providerCount}}
        <span class="{{ badgeCls('providers') }}">{{ providerCount }}</span>
{{/if}}
      </a>
      <a href="/registrars" title="Domains" aria-current="{{ cur('registrars') }}" class="{{ itemCls('registrars') }}">
        <IconGlobe class="{{ iconCls('registrars') }}" />
        <span class="flux-sb-label truncate">Domains</span>
{{#if domainCount}}
        <span class="{{ badgeCls('registrars') }}">{{ domainCount }}</span>
{{/if}}
      </a>
      <a href="/source-control" title="Source control" aria-current="{{ cur('source-control') }}" class="{{ itemCls('source-control') }}">
        <IconCode class="{{ iconCls('source-control') }}" />
        <span class="flux-sb-label truncate">Source control</span>
      </a>
    </div>

    <p class="flux-sb-section px-3 pt-6 pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">Organization</p>
    <div class="flex flex-col gap-0.5">
      <a href="/team" title="Team &amp; roles" aria-current="{{ cur('team') }}" class="{{ itemCls('team') }}">
        <IconUsers class="{{ iconCls('team') }}" />
        <span class="flux-sb-label truncate">Team &amp; roles</span>
      </a>
      <a href="/settings" title="Settings" aria-current="{{ cur('settings') }}" class="{{ itemCls('settings') }}">
        <IconCog class="{{ iconCls('settings') }}" />
        <span class="flux-sb-label truncate">Settings</span>
      </a>
    </div>

{{#if isFluxAdmin()}}
    <p class="flux-sb-section px-3 pt-6 pb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">Flux admin</p>
    <div class="flex flex-col gap-0.5">
      <a href="/admin" title="Users" aria-current="{{ cur('admin') }}" class="{{ itemCls('admin') }}">
        <IconShieldCheck class="{{ iconCls('admin') }}" />
        <span class="flux-sb-label truncate">Users</span>
      </a>
    </div>
{{/if}}
  </nav>

  <div class="shrink-0 px-3 pb-3 pt-2 border-t border-line flex flex-col gap-0.5">
    <a href="/docs" title="Documentation" class="flux-sb-item group flex items-center gap-3 h-9 px-3 rounded-xl text-[13px] text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] transition-colors">
      <IconBookOpen class="w-[18px] h-[18px] shrink-0" />
      <span class="flux-sb-label truncate">Documentation</span>
    </a>
    <a href="/status" title="{{ statusText() }}" class="flux-sb-item group flex items-center gap-3 h-9 px-3 rounded-xl text-[13px] text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] transition-colors">
      <span class="w-[18px] h-[18px] shrink-0 flex items-center justify-center"><span class="{{ statusDot() }}"></span></span>
      <span class="flux-sb-label truncate">{{ statusText() }}</span>
    </a>

    <div class="mt-2 flex items-center gap-2">
      <a href="/settings" title="{{ userName() }}" class="flux-sb-wide min-w-0 flex-1 flex items-center gap-2.5 rounded-xl p-1.5 hover:bg-zinc-200/50 dark:hover:bg-white/[0.04] transition-colors">
{{#if avatar()}}
        <img src="{{ avatar() }}" alt="" class="w-8 h-8 shrink-0 rounded-full object-cover border border-line" />
{{/if}}
{{#if not avatar()}}
        <span class="w-8 h-8 shrink-0 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-xs font-semibold flex items-center justify-center">{{ initial() }}</span>
{{/if}}
        <span class="min-w-0 flex flex-col leading-tight">
          <span class="text-[13px] font-medium text-zinc-900 dark:text-zinc-100 truncate">{{ userName() }}</span>
          <span class="text-[11px] text-zinc-500 truncate">{{ userEmail() }}</span>
        </span>
      </a>
      <button onclick="{{ collapse() }}" title="Collapse sidebar ( [ )" aria-label="Collapse or expand the sidebar" class="flux-sb-collapse w-8 h-8 shrink-0 mx-auto flex items-center justify-center rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/50 dark:hover:bg-white/[0.05] transition-colors">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" class="w-4 h-4 transition-transform">
          <rect x="3" y="3.5" width="14" height="13" rx="3" />
          <path d="M8 3.5v13" />
          <path d="M13 8l-2 2 2 2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</aside>

<nav aria-label="Main" class="app-tabbar lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/90 dark:bg-[#0c0c0d]/90 backdrop-blur-xl" style="padding-bottom: env(safe-area-inset-bottom)">
  <div class="flex items-stretch gap-1 px-2 py-1">
    <a href="/dashboard" class="{{ tabCls('overview') }}" aria-current="{{ cur('overview') }}">
      <span class="{{ tabIconCls('overview') }}"><IconLayoutDashboard class="w-[18px] h-[18px]" /></span>
      Overview
    </a>
    <a href="/servers" class="{{ tabCls('servers') }}" aria-current="{{ cur('servers') }}">
      <span class="{{ tabIconCls('servers') }}"><IconServer class="w-[18px] h-[18px]" /></span>
      Servers
    </a>
    <a href="/providers" class="{{ tabCls('providers') }}" aria-current="{{ cur('providers') }}">
      <span class="{{ tabIconCls('providers') }}"><IconCloud class="w-[18px] h-[18px]" /></span>
      Clouds
    </a>
    <a href="/registrars" class="{{ tabCls('registrars') }}" aria-current="{{ cur('registrars') }}">
      <span class="{{ tabIconCls('registrars') }}"><IconGlobe class="w-[18px] h-[18px]" /></span>
      Domains
    </a>
    <button onclick="{{ toggleMore() }}" aria-expanded="{{ moreOpen }}" aria-controls="tabbar-more" class="{{ moreTabCls() }}">
      <span class="{{ moreIconCls() }}"><IconDotsHorizontal class="w-[18px] h-[18px]" /></span>
      More
    </button>
  </div>
</nav>

{{#if moreOpen}}
<div class="lg:hidden fixed inset-0 z-[45]" role="dialog" aria-modal="true" aria-label="More">
  <button onclick="{{ closeMore() }}" aria-label="Close" class="absolute inset-0 w-full h-full bg-black/50 backdrop-blur-[2px] cursor-default"></button>
  <div id="tabbar-more" class="absolute inset-x-2 bottom-2 rounded-2xl border border-line bg-panel p-2 shadow-pop animate-flux-sheet" style="margin-bottom: env(safe-area-inset-bottom)">
    <div class="flex items-center justify-between px-4 pt-2 pb-1">
      <p class="flux-eyebrow">Workspace</p>
      <button onclick="{{ closeMore() }}" aria-label="Close" class="w-9 h-9 -mr-2 flex items-center justify-center rounded-full text-zinc-500 active:bg-zinc-200/60 dark:active:bg-white/[0.06]"><IconX class="w-5 h-5" /></button>
    </div>
    <button onclick="{{ openPalette() }}" class="w-full flex items-center gap-3 rounded-2xl px-4 py-3 text-[15px] font-medium text-zinc-700 dark:text-zinc-200 active:bg-zinc-200/60 dark:active:bg-white/[0.06]"><IconSearch class="w-5 h-5 text-zinc-400" /> Search</button>
    <a href="/source-control" class="{{ sheetLink('source-control') }}"><IconCode class="w-5 h-5 opacity-70" /> Source control</a>
    <a href="/team" class="{{ sheetLink('team') }}"><IconUsers class="w-5 h-5 opacity-70" /> Team &amp; roles</a>
    <a href="/settings" class="{{ sheetLink('settings') }}"><IconCog class="w-5 h-5 opacity-70" /> Settings</a>
{{#if isFluxAdmin()}}
    <a href="/admin" class="{{ sheetLink('admin') }}"><IconShieldCheck class="w-5 h-5 opacity-70" /> Admin · Users</a>
{{/if}}
    <div class="h-px bg-line my-1.5 mx-3"></div>
    <a href="/docs" class="{{ sheetLink('docs') }}"><IconBookOpen class="w-5 h-5 opacity-70" /> Documentation</a>
    <a href="/status" class="{{ sheetLink('status') }}"><span class="w-5 h-5 flex items-center justify-center"><span class="{{ statusDot() }}"></span></span> {{ statusText() }}</a>
  </div>
</div>
{{/if}}
</div>
