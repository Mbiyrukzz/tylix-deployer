component LoaderMark

props
  label: String

template
<div class="flex flex-col items-center justify-center py-14">
  <div class="relative w-14 h-14 flex items-center justify-center">
    <span class="absolute inset-0 rounded-full bg-brand-500/30 animate-loader-ring motion-reduce:animate-none"></span>
    <img src="/logo-mark.png" alt="" class="relative w-12 h-12" />
  </div>
  <p class="text-slate-600 dark:text-slate-300 text-sm font-medium mt-5">{{ label }}</p>
  <div class="w-40 h-1.5 rounded-full bg-slate-300 dark:bg-slate-800 overflow-hidden mt-3">
    <div class="w-1/3 h-full rounded-full bg-brand-500 animate-loader-slide motion-reduce:animate-none"></div>
  </div>
</div>