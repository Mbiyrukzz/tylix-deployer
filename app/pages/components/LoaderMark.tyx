component LoaderMark

// The loader, the same as Ashmif Hub's: the Tylix mark lit stroke by stroke
// over a sliding bar (styles: .tx-loader in app/tailwind-input.css). It
// fades in after 150ms, so a quick load never flashes it.
//   <LoaderMark label="Loading servers…" />     a whole page column
//   <LoaderMark label="Loading…" size="sm" />   a card or a section

props
  label: String
  size: String

template
{{#if size is "sm"}}
<div class="tx-loader tx-loader-sm" role="status" aria-live="polite">
  <svg class="tx-loader-mark" viewBox="0 0 552 366" aria-hidden="true" focusable="false"><path class="tx-loader-s1" d="M0 96 74 22Q96 0 120 0H552L482 77Q462 96 436 96Z"/><path class="tx-loader-s2" d="M34 366 148 151Q160 127 190 127H290L163 366Z"/><path class="tx-loader-s3" d="M218 339 294 192Q304 171 334 171H442L378 264Q368 277 353 283Z"/></svg>
  <div class="tx-loader-track" aria-hidden="true"><div class="tx-loader-bar"></div></div>
  <span class="tx-loader-label">{{ label or "Loading…" }}</span>
</div>
{{/if}}
{{#if size is not "sm"}}
<div class="tx-loader" role="status" aria-live="polite">
  <svg class="tx-loader-mark" viewBox="0 0 552 366" aria-hidden="true" focusable="false"><path class="tx-loader-s1" d="M0 96 74 22Q96 0 120 0H552L482 77Q462 96 436 96Z"/><path class="tx-loader-s2" d="M34 366 148 151Q160 127 190 127H290L163 366Z"/><path class="tx-loader-s3" d="M218 339 294 192Q304 171 334 171H442L378 264Q368 277 353 283Z"/></svg>
  <div class="tx-loader-track" aria-hidden="true"><div class="tx-loader-bar"></div></div>
  <span class="tx-loader-label">{{ label or "Loading…" }}</span>
</div>
{{/if}}
