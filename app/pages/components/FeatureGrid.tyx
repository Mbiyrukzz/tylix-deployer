component FeatureGrid

import { IconBolt, IconDatabase, IconAdjustments, IconLockClosed, IconFire, IconDocument } from "tylix-icons"

template
  <section class="px-6 py-24 max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-semibold text-slate-200 mb-3 tracking-tight">Everything wired up on day one</h2>
      <p class="text-slate-500">Auth, database, styling — pick your stack in the wizard, get a working app.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconBolt class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">No virtual DOM</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Templates compile to targeted effects — state changes update
          only the text, attribute, or list that depends on them.
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconDatabase class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">One ORM, four drivers</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          SQLite, PostgreSQL, MySQL, or MongoDB — swap the driver
          in <code class="text-emerald-400">tylix.config.js</code>.
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconAdjustments class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">Generator-first CLI</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          <code class="text-emerald-400">tylix make:feature</code> scaffolds a model,
          migration, and full CRUD API in one command.
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconLockClosed class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">Auth out of the box</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Register, login, and session middleware, scaffolded
          automatically when you opt in during setup.
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconFire class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">Instant hot reload</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Edit a page or component and see it update in the browser
          without losing state.
        </p>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <IconDocument class="w-5 h-5 text-emerald-400" />
        </div>
        <h3 class="text-slate-200 font-medium mb-2">Readable syntax</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Word operators like <code class="text-emerald-400">and</code>, <code class="text-emerald-400">or</code>,
          and <code class="text-emerald-400">not</code> instead of symbols.
        </p>
      </div>
    </div>
  </section>