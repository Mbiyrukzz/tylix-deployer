component TeamSidebar

import { IconUsers, IconClock, IconCog } from "tylix-icons"

props
  active: String

state
  collapsed: false
  asideCls: "flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-stone-200/40 dark:bg-white/[0.03] p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200 lg:w-[240px] lg:p-5"
  topCls: "hidden lg:flex items-center justify-between gap-2 mb-5"
  headCls: "hidden lg:flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 text-[11px] font-semibold uppercase tracking-wider mb-1.5 px-3 transition-colors"
  onCls: "relative shrink-0 flex items-center gap-3 px-3 py-2 rounded-xl bg-brand-500/10 text-brand-700 dark:text-brand-400 text-sm font-semibold"
  offCls: "group shrink-0 flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-stone-200/70 dark:hover:bg-white/[0.06] hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
  labelCls: ""
  titleCls: "min-w-0"
  btnCls: "flex items-center justify-center w-6 h-6 shrink-0 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-stone-200/70 dark:hover:bg-white/[0.06] transition-colors"
  chevCls: "w-4 h-4 transition-transform"

action
  applyLayout() {
    const asideBase = "flex lg:flex-col gap-1 overflow-x-auto lg:overflow-y-auto lg:overflow-x-visible border-b lg:border-b-0 lg:border-r border-line bg-stone-200/40 dark:bg-white/[0.03] p-3 lg:sticky lg:top-16 lg:self-start lg:h-[calc(100vh-4rem)] lg:transition-[width] lg:duration-200"
    const on = "relative shrink-0 flex items-center gap-3 px-3 py-2 rounded-xl bg-brand-500/10 text-brand-700 dark:text-brand-400 text-sm font-semibold"
    const off = "group shrink-0 flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 text-sm hover:bg-stone-200/70 dark:hover:bg-white/[0.06] hover:text-slate-900 dark:hover:text-slate-100 transition-colors"
    const head = "hidden lg:flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 text-[11px] font-semibold uppercase tracking-wider mb-1.5 px-3 transition-colors"

    if this.collapsed {
      this.asideCls = asideBase + " lg:w-16 lg:p-2.5"
      this.topCls = "hidden lg:flex flex-col items-center gap-3 mb-5"
      this.headCls = "hidden"
      this.onCls = on + " lg:justify-center lg:px-0"
      this.offCls = off + " lg:justify-center lg:px-0"
      this.labelCls = "lg:hidden"
      this.titleCls = "hidden"
      this.chevCls = "w-4 h-4 transition-transform rotate-180"

      const sections = document.querySelectorAll("details.tylix-sec")
      sections.forEach((el) => Reflect.set(el, "open", true))
    } else {
      this.asideCls = asideBase + " lg:w-[240px] lg:p-5"
      this.topCls = "hidden lg:flex items-center justify-between gap-2 mb-5"
      this.headCls = head
      this.onCls = on
      this.offCls = off
      this.labelCls = ""
      this.titleCls = "min-w-0"
      this.chevCls = "w-4 h-4 transition-transform"
    }
  }

  toggle() {
    this.collapsed = not this.collapsed
    this.applyLayout()

    if this.collapsed {
      window.localStorage.setItem("tylix-team-sidebar", "1")
    } else {
      window.localStorage.setItem("tylix-team-sidebar", "0")
    }
  }

onMount
  async {
    const saved = window.localStorage.getItem("tylix-team-sidebar")
    if saved is "1" {
      this.collapsed = true
      this.applyLayout()
    }
  }

template
<aside class="{{ asideCls }}">

  <div class="{{ topCls }}">
    <div class="flex items-center gap-3 min-w-0">
      <span class="w-9 h-9 shrink-0 rounded-xl bg-brand-500 text-white flex items-center justify-center shadow-sm">
        <IconUsers class="w-5 h-5" />
      </span>
      <div class="{{ titleCls }}">
        <p class="text-slate-900 dark:text-slate-100 text-sm font-semibold leading-tight truncate">Team</p>
        <p class="text-slate-500 text-xs leading-tight truncate">Members and activity</p>
      </div>
    </div>
    <button onclick="{{ toggle() }}" title="Collapse or expand sidebar" aria-label="Collapse or expand sidebar" class="{{ btnCls }}">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="{{ chevCls }}">
        <path d="M12 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <details open class="tylix-sec group/sec contents lg:flex lg:flex-col lg:gap-1">
    <summary class="{{ headCls }}">
      Overview
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

{{#if active is "members"}}
    <a href="/team" title="Members" aria-current="page" class="{{ onCls }}">
      <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
      <IconUsers class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Members</span>
    </a>
{{/if}}
{{#if active is not "members"}}
    <a href="/team" title="Members" class="{{ offCls }}">
      <IconUsers class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Members</span>
    </a>
{{/if}}

{{#if active is "activity"}}
    <a href="/team/activity" title="Activity" aria-current="page" class="{{ onCls }}">
      <span class="hidden lg:block absolute left-0 top-2 bottom-2 w-0.5 rounded-full bg-brand-500"></span>
      <IconClock class="w-4 h-4 shrink-0 text-brand-600 dark:text-brand-400" /> <span class="{{ labelCls }}">Activity</span>
    </a>
{{/if}}
{{#if active is not "activity"}}
    <a href="/team/activity" title="Activity" class="{{ offCls }}">
      <IconClock class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Activity</span>
    </a>
{{/if}}
  </details>

  <div class="hidden lg:block h-px bg-stone-200 dark:bg-white/10 my-3 mx-1"></div>

  <details open class="tylix-sec group/sec contents lg:flex lg:flex-col lg:gap-1">
    <summary class="{{ headCls }}">
      Manage
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 transition-transform group-open/sec:rotate-90">
        <path d="M7.5 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

    <a href="/settings/team" title="Invites and roles" class="{{ offCls }}">
      <IconCog class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors" /> <span class="{{ labelCls }}">Invites and roles</span>
    </a>
  </details>

</aside>