component ServerForm

import { IconPlus, IconX } from "tylix-icons"

props
  server: Object
  onSaved: Function

state
  showModal: false
  name: ""
  host: ""
  port: "22"
  sshUser: "root"
  sshKey: ""
  saving: false
  error: ""
  nameError: ""
  hostError: ""
  portError: ""
  userError: ""
  keyError: ""

action
  clearErrors() {
    this.error = ""
    this.nameError = ""
    this.hostError = ""
    this.portError = ""
    this.userError = ""
    this.keyError = ""
  }

  reset() {
    this.name = ""
    this.host = ""
    this.port = "22"
    this.sshUser = "root"
    this.sshKey = ""
    this.saving = false
    this.clearErrors()
  }

  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  open() {
    this.reset()
    if this.server {
      this.name = this.server.name
      this.host = this.server.host
      this.port = String(this.server.port)
      this.sshUser = this.server.ssh_user
    }
    this.showModal = true
  }

  close() {
    this.showModal = false
    this.reset()
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()
    this.saving = true

    const payload = {
      name: this.name,
      host: this.host,
      port: this.port,
      ssh_user: this.sshUser,
      ssh_key: this.sshKey
    }
    const url = this.server ? "/api/servers/" + this.server.id : "/api/servers"
    const method = this.server ? "PUT" : "POST"

    const result = await useApi(url, { method: method, body: payload })

    if result.ok {
      this.onSaved(result.data)
      this.close()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.nameError = this.firstError(errors, "name")
      this.hostError = this.firstError(errors, "host")
      this.portError = this.firstError(errors, "port")
      this.userError = this.firstError(errors, "ssh_user")
      this.keyError = this.firstError(errors, "ssh_key")
      this.error = result.data?.error or result.error or "Couldn't save the server. Check the form and try again."
      this.saving = false
    }
  }

template
{{#if server}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-200 dark:hover:bg-slate-900 transition-colors">
    Edit
  </button>
{{/if}}
{{#if not server}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
    <IconPlus class="w-4 h-4" /> Add server
  </button>
{{/if}}

{{#if showModal}}
  <div role="dialog" aria-modal="true" aria-labelledby="server-form-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm px-6">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-900 shadow-xl p-6">
      <div class="flex items-center justify-between mb-5">
        <h3 id="server-form-title" class="text-slate-900 dark:text-slate-200 font-medium">
{{#if server}}
          Edit server
{{/if}}
{{#if not server}}
          Add server
{{/if}}
        </h3>
        <button onclick="{{ close() }}" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
          <IconX class="w-4 h-4" />
        </button>
      </div>

      <label for="server-name" class="block text-slate-500 text-xs mb-1.5">Name</label>
      <input
        id="server-name"
        type="text"
        autofocus
        value="{{ name }}"
        oninput="{{ name = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="e.g. Production web 1"
      />
{{#if nameError}}
      <p class="text-rose-500 text-xs mb-3">{{ nameError }}</p>
{{/if}}
{{#if not nameError}}
      <div class="mb-3"></div>
{{/if}}

      <label for="server-host" class="block text-slate-500 text-xs mb-1.5">Host</label>
      <input
        id="server-host"
        type="text"
        value="{{ host }}"
        oninput="{{ host = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="203.0.113.10 or server.example.com"
      />
{{#if hostError}}
      <p class="text-rose-500 text-xs mb-3">{{ hostError }}</p>
{{/if}}
{{#if not hostError}}
      <div class="mb-3"></div>
{{/if}}

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="server-port" class="block text-slate-500 text-xs mb-1.5">SSH port</label>
          <input
            id="server-port"
            type="text"
            inputmode="numeric"
            value="{{ port }}"
            oninput="{{ port = $event.target.value }}"
            class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          />
{{#if portError}}
          <p class="text-rose-500 text-xs mb-3">{{ portError }}</p>
{{/if}}
        </div>
        <div>
          <label for="server-user" class="block text-slate-500 text-xs mb-1.5">SSH user</label>
          <input
            id="server-user"
            type="text"
            value="{{ sshUser }}"
            oninput="{{ sshUser = $event.target.value }}"
            class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          />
{{#if userError}}
          <p class="text-rose-500 text-xs mb-3">{{ userError }}</p>
{{/if}}
        </div>
      </div>

      <label for="server-key" class="block text-slate-500 text-xs mb-1.5 mt-3">SSH private key</label>
      <textarea
        id="server-key"
        rows="6"
        spellcheck="false"
        autocomplete="off"
        value="{{ sshKey }}"
        oninput="{{ sshKey = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-xs font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 resize-none transition-colors"
        placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
      ></textarea>
{{#if keyError}}
      <p class="text-rose-500 text-xs mb-2">{{ keyError }}</p>
{{/if}}
{{#if server}}
      <p class="text-slate-500 text-xs mb-4">Leave blank to keep the current key.</p>
{{/if}}
{{#if not server}}
      <p class="text-slate-500 text-xs mb-4">Use a dedicated key without a passphrase. It is encrypted before it is stored and is never shown again.</p>
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3">
        <button onclick="{{ close() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
          Cancel
        </button>
{{#if saving}}
        <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 opacity-50">
          Saving…
        </button>
{{/if}}
{{#if not saving}}
{{#if server}}
        <button onclick="{{ submit() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
          Save changes
        </button>
{{/if}}
{{#if not server}}
        <button onclick="{{ submit() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
          <IconPlus class="w-4 h-4" /> Add server
        </button>
{{/if}}
{{/if}}
      </div>
    </div>
  </div>
{{/if}}
