component SourceProviderForm

import { IconPlus, IconX } from "tylix-icons"

props
  provider: Object
  onSaved: Function

state
  showModal: false
  kind: "github"
  label: ""
  token: ""
  saving: false
  error: ""
  kindError: ""
  labelError: ""
  tokenError: ""
  twoFactorOn: false
  tfTotp: false
  tfSms: false
  smsHint: ""
  codeOpen: false
  code: ""
  codeError: ""
  smsSending: false
  smsNotice: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  clearErrors() {
    this.error = ""
    this.kindError = ""
    this.labelError = ""
    this.tokenError = ""
    this.codeError = ""
  }

  reset() {
    this.kind = "github"
    this.label = ""
    this.token = ""
    this.saving = false
    this.codeOpen = false
    this.code = ""
    this.codeError = ""
    this.smsNotice = ""
    this.smsSending = false
    this.clearErrors()
  }

  pickKind(k) {
    this.kind = k
  }

  // True when the edit form has a new token typed in. Only then is a code needed.
  hasCredentials() {
    return this.token.trim() is not ""
  }

  // Which second factors this account has on.
  async loadTwoFactor() {
    const result = await useApi("/api/account")
    if result.ok and result.data and result.data.two_factor {
      const tf = result.data.two_factor
      const sms = tf.sms
      this.tfTotp = Boolean(tf.enabled)
      this.tfSms = Boolean(sms and sms.enabled)
      this.smsHint = (sms and sms.phone_hint) or ""
      this.twoFactorOn = this.tfTotp or this.tfSms
    }
  }

  async sendCode() {
    if this.smsSending {
      return null
    }

    this.smsSending = true
    this.codeError = ""
    this.smsNotice = ""

    const result = await useApi("/api/account/two-factor/sms/send-code", { method: "POST" })

    this.smsSending = false

    if result.ok {
      this.smsNotice = "Code sent to " + this.smsHint + "."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.codeError = result.data?.error or "Couldn't send the code."
    }
  }

  // Shows the code box. When SMS is the only method, the code is texted right away.
  async openCodeStep() {
    this.codeOpen = true
    this.codeError = ""
    this.smsNotice = ""

    if this.tfSms and not this.tfTotp {
      await this.sendCode()
    }
  }

  // True when the form must NOT be sent yet (the code box was just opened,
  // or the code is still empty).
  async needsCode() {
    if not this.provider or not this.hasCredentials() or not this.twoFactorOn {
      return false
    }

    if not this.codeOpen {
      await this.openCodeStep()
      return true
    }

    if this.code.trim() is "" {
      this.codeError = "Enter a verification code to continue."
      return true
    }

    return false
  }

  // The server says a code is needed (status call failed or was stale).
  applyTwoFactorRequired(data) {
    const methods = data.methods or []
    this.twoFactorOn = true
    this.tfTotp = methods.includes("totp")
    this.tfSms = methods.includes("sms")
    this.codeOpen = true
    this.codeError = data.error or "Enter a verification code to continue."
  }

  async open() {
    this.reset()
    if this.provider {
      this.kind = this.provider.kind
      this.label = this.provider.label
    }
    this.showModal = true

    if this.provider {
      await this.loadTwoFactor()
    }
  }

  close() {
    this.showModal = false
    this.reset()
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()

    const stop = await this.needsCode()
    if stop {
      return null
    }

    this.saving = true

    const payload = { kind: this.kind, label: this.label, token: this.token, code: this.code.trim() }
    const url = this.provider ? "/api/sourceproviders/" + this.provider.id : "/api/sourceproviders"
    const method = this.provider ? "PUT" : "POST"

    const result = await useApi(url, { method: method, body: payload })

    if result.ok {
      this.onSaved(result.data)
      this.close()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data and result.data.two_factor_required {
      this.applyTwoFactorRequired(result.data)
      this.saving = false
    } else {
      const errors = result.data?.errors
      this.kindError = this.firstError(errors, "kind")
      this.labelError = this.firstError(errors, "label")
      this.tokenError = this.firstError(errors, "token")
      this.codeError = this.firstError(errors, "code")
      this.error = result.data?.error or result.error or ""
      if this.error is "" and not errors {
        this.error = "Couldn't save the connection. Check the form and try again."
      }
      this.saving = false
    }
  }

template
{{#if provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-200 dark:hover:bg-slate-900 transition-colors">
    Edit
  </button>
{{/if}}
{{#if not provider}}
  <button onclick="{{ open() }}" class="inline-flex items-center gap-1.5 text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-brand-400 hover:shadow transition-all">
    <IconPlus class="w-4 h-4" /> Connect account
  </button>
{{/if}}

{{#if showModal}}
  <div role="dialog" aria-modal="true" aria-labelledby="source-form-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm px-6">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-xl border border-line bg-panel shadow-xl p-6">
      <div class="flex items-center justify-between mb-5">
        <h3 id="source-form-title" class="text-slate-900 dark:text-slate-200 font-medium">
{{#if provider}}
          Edit connection
{{/if}}
{{#if not provider}}
          Connect a source control account
{{/if}}
        </h3>
        <button onclick="{{ close() }}" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
          <IconX class="w-4 h-4" />
        </button>
      </div>

{{#if not provider}}
      <p class="block text-slate-500 text-xs mb-1.5">Provider</p>
      <div class="grid grid-cols-2 gap-3 mb-1">
{{#if kind is "github"}}
        <button onclick="{{ pickKind('github') }}" class="text-left rounded-xl border px-4 py-3 text-sm border-brand-500 bg-brand-500/10 text-slate-800 dark:text-slate-200">GitHub</button>
{{/if}}
{{#if kind is not "github"}}
        <button onclick="{{ pickKind('github') }}" class="text-left rounded-xl border px-4 py-3 text-sm border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-950 text-slate-600 dark:text-slate-400 hover:border-brand-500/40">GitHub</button>
{{/if}}
{{#if kind is "gitlab"}}
        <button onclick="{{ pickKind('gitlab') }}" class="text-left rounded-xl border px-4 py-3 text-sm border-brand-500 bg-brand-500/10 text-slate-800 dark:text-slate-200">GitLab</button>
{{/if}}
{{#if kind is not "gitlab"}}
        <button onclick="{{ pickKind('gitlab') }}" class="text-left rounded-xl border px-4 py-3 text-sm border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-950 text-slate-600 dark:text-slate-400 hover:border-brand-500/40">GitLab</button>
{{/if}}
      </div>
{{#if kindError}}
      <p class="text-rose-500 text-xs mb-2">{{ kindError }}</p>
{{/if}}
      <div class="mb-3"></div>
{{/if}}

      <label for="source-label" class="block text-slate-500 text-xs mb-1.5">Name</label>
      <input
        id="source-label"
        type="text"
        autofocus
        value="{{ label }}"
        oninput="{{ label = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        placeholder="e.g. Ashmif GitHub"
      />
{{#if labelError}}
      <p class="text-rose-500 text-xs mb-3">{{ labelError }}</p>
{{/if}}
{{#if not labelError}}
      <div class="mb-3"></div>
{{/if}}

      <label for="source-token" class="block text-slate-500 text-xs mb-1.5">Personal access token</label>
      <input
        id="source-token"
        type="password"
        autocomplete="off"
        value="{{ token }}"
        oninput="{{ token = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
      />
{{#if tokenError}}
      <p class="text-rose-500 text-xs mb-2">{{ tokenError }}</p>
{{/if}}
{{#if provider}}
      <p class="text-slate-500 text-xs mb-4">Leave blank to keep the current token.</p>
{{/if}}
{{#if not provider}}
      <p class="text-slate-500 text-xs mb-4">GitHub needs a token with repo access. GitLab needs read_repository and read_api. The token is checked now, encrypted, and never shown again.</p>
{{/if}}

{{#if codeOpen}}
      <div class="mt-5 rounded-xl border border-line bg-slate-50 dark:bg-slate-950/60 p-4">
        <label for="step-up-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Verification code</label>
        <p class="text-slate-500 text-xs mb-2">Replacing credentials needs a second-factor code.</p>
        <input
          id="step-up-code"
          type="text"
          inputmode="text"
          autocomplete="one-time-code"
          maxlength="12"
          value="{{ code }}"
          oninput="{{ code = $event.target.value }}"
          class="w-full sm:w-56 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
        />
{{#if tfTotp}}
        <p class="text-slate-500 text-xs mt-2">Enter a code from your authenticator app, or a recovery code.</p>
{{/if}}
{{#if not tfTotp}}
        <p class="text-slate-500 text-xs mt-2">Enter the code texted to {{ smsHint }}.</p>
{{/if}}
{{#if smsNotice}}
        <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ smsNotice }}</p>
{{/if}}
{{#if codeError}}
        <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if tfSms}}
{{#if smsSending}}
        <button disabled class="mt-3 text-xs text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1 opacity-50">Sending…</button>
{{/if}}
{{#if not smsSending}}
        <button onclick="{{ sendCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Text me a code</button>
{{/if}}
{{/if}}
      </div>
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3">
        <button onclick="{{ close() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">Cancel</button>
{{#if saving}}
        <button disabled class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 opacity-50">Checking…</button>
{{/if}}
{{#if not saving}}
        <button onclick="{{ submit() }}" class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-brand-400 hover:shadow transition-all">Save</button>
{{/if}}
      </div>
    </div>
  </div>
{{/if}}