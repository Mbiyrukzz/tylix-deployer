component CTASection

import { IconArrowRight } from "tylix-icons"

uses
  Auth

template
  <section class="px-6 py-20 bg-slate-200 dark:bg-slate-950 transition-colors">
    <div class="max-w-5xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel shadow-sm dark:shadow-none p-10 md:p-14 text-center">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> Ready when you are
      </span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-800 dark:text-slate-200 mb-3">Deploy your first app today</h2>
      <p class="text-slate-500 max-w-xl mx-auto mb-8">Connect a server and ship your next release in minutes.</p>
      <div class="min-h-[52px]">
{{#if Auth.user}}
        <a href="/servers" class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-brand-500 text-white dark:text-slate-950 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
          Open my servers
          <IconArrowRight class="w-4 h-4" />
        </a>
{{/if}}
{{#if not Auth.loading}}
{{#if not Auth.user}}
        <a href="/register" class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-brand-500 text-white dark:text-slate-950 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
          Create your account
          <IconArrowRight class="w-4 h-4" />
        </a>
{{/if}}
{{/if}}
      </div>
    </div>
  </section>