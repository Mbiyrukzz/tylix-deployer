component CTASection

import { IconArrowRight } from "tylix-icons"

props
  loggedIn: boolean

template
  <section class="px-6 py-28 text-center bg-slate-200 dark:bg-slate-950 transition-colors">
{{#if not loggedIn}}
    <h2 class="text-4xl font-semibold text-slate-900 dark:text-slate-200 mb-4 tracking-tight">Ready to build something real?</h2>
    <p class="text-slate-500 mb-10 max-w-md mx-auto">
      Scaffold a full project — auth, database, and styling included — in under a minute.
    </p>
    <a href="/register" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-emerald-500 text-white dark:text-slate-950 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
      Get Started for Free
      <IconArrowRight class="w-4 h-4" />
    </a>
{{/if}}
{{#if loggedIn}}
    <h2 class="text-4xl font-semibold text-slate-900 dark:text-slate-200 mb-4 tracking-tight">Keep building</h2>
    <p class="text-slate-500 mb-10 max-w-md mx-auto">
      Jump back into your dashboard to manage your data and features.
    </p>
    <a href="/dashboard" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-emerald-500 text-white dark:text-slate-950 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
      Go to Dashboard
      <IconArrowRight class="w-4 h-4" />
    </a>
{{/if}}
  </section>