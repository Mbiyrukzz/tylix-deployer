component PricingTeaser

template
  <section class="px-6 py-20 bg-slate-200 dark:bg-slate-950 transition-colors">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-2">Pricing</p>
