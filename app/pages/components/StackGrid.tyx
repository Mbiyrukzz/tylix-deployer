                <span>Type</span><span>Name and value</span><span>TTL</span>
              </div>
              <div class="px-4 py-2.5 grid grid-cols-[48px_1fr_auto] gap-3 items-center border-t border-slate-100 dark:border-slate-800/60 text-xs">
                <span class="font-mono font-semibold text-emerald-700 dark:text-emerald-400">A</span>
                <span class="font-mono text-slate-600 dark:text-slate-400 truncate">example.com to 203.0.113.10</span>
                <span class="font-mono text-slate-400">300</span>
              </div>
              <div class="px-4 py-2.5 grid grid-cols-[48px_1fr_auto] gap-3 items-center border-t border-slate-100 dark:border-slate-800/60 text-xs">
                <span class="font-mono font-semibold text-sky-600 dark:text-sky-400">CNAME</span>
                <span class="font-mono text-slate-600 dark:text-slate-400 truncate">www to example.com</span>
                <span class="font-mono text-slate-400">300</span>
              </div>
              <div class="px-4 py-2.5 grid grid-cols-[48px_1fr_auto] gap-3 items-center border-t border-slate-100 dark:border-slate-800/60 text-xs">
                <span class="font-mono font-semibold text-amber-600 dark:text-amber-400">MX</span>
                <span class="font-mono text-slate-600 dark:text-slate-400 truncate">mail.example.com, priority 10</span>
                <span class="font-mono text-slate-400">3600</span>
              </div>
              <div class="px-4 py-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <span class="text-xs text-slate-500">Renews in 41 days</span>
                <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">Manage DNS</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="text-slate-500 text-xs mr-1">Servers on</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">Linode</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">Hetzner</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">DigitalOcean</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">Vultr</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">AWS</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">UpCloud</span>
        <span class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs text-slate-700 dark:text-slate-300">Contabo</span>
        <span class="rounded-full border border-dashed border-slate-400 dark:border-slate-700 px-3 py-1 text-xs text-slate-500">or any server over SSH</span>
      </div>

    </div>
  </section>