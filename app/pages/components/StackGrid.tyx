component StackGrid

import { IconPlus } from "tylix-icons"

// Home page: every site type Tylix Flux deploys, with its logo, filtered by
// language family. Keep in step with the site types in SiteProvisioner.

state
  group: "all"

computed
  groups() {
    return [
      { id: "all", name: "All", note: "Pick a stack, point it at your repo and server, and Tylix Flux handles the build and release steps." },
      { id: "js", name: "JavaScript", note: "Node apps run as systemd services and restart if they crash." },
      { id: "php", name: "PHP", note: "nginx and PHP-FPM, with the PHP version you pick per site." },
      { id: "python", name: "Python", note: "Each site gets its own virtualenv and installs requirements.txt." },
      { id: "compiled", name: "Compiled", note: "Built on the server, then run as a service on the port you set." },
      { id: "other", name: "Ruby and static", note: "Ruby apps run under Puma; static sites are served straight from nginx." }
    ]
  }

  stacks() {
    return [
      { id: "tylix", name: "Tylix", group: "js", cmd: "compile · build · serve", note: "Your own framework, first class." },
      { id: "nodejs", name: "Node.js", group: "js", cmd: "npm ci · start", note: "Any npm app, kept running for you." },
      { id: "nextjs", name: "Next.js", group: "js", cmd: "build · start · proxy", note: "Built on the server, proxied by nginx." },
      { id: "mern", name: "MERN", group: "js", cmd: "client build · api · /api/", note: "React client and Node API in one site." },
      { id: "angular", name: "Angular", group: "js", cmd: "npm ci · build · SPA", note: "Build output is detected for you." },
      { id: "laravel", name: "Laravel", group: "php", cmd: "composer · build · php-fpm", note: "Vite assets and your own build command." },
      { id: "php", name: "PHP", group: "php", cmd: "composer · php-fpm 8.1 to 8.5", note: "Any web directory you choose." },
      { id: "wordpress", name: "WordPress", group: "php", cmd: "core · MySQL · php-fpm", note: "Installs the latest and creates its database." },
      { id: "fastapi", name: "FastAPI", group: "python", cmd: "venv · pip · uvicorn", note: "Behind nginx with proxy headers set." },
      { id: "django", name: "Django", group: "python", cmd: "venv · gunicorn · collectstatic", note: "Static files served by nginx." },
      { id: "java", name: "Java", group: "compiled", cmd: "Maven or Gradle · jar", note: "Spring Boot APIs, built and run as a jar." },
      { id: "go", name: "Go", group: "compiled", cmd: "go build · binary", note: "One binary that listens on its port." },
      { id: "dotnet", name: ".NET", group: "compiled", cmd: "dotnet publish · run", note: "ASP.NET Core behind nginx." },
      { id: "rust", name: "Rust", group: "compiled", cmd: "cargo build --release", note: "Compiled on the server, run as a binary." },
      { id: "ruby", name: "Ruby", group: "other", cmd: "bundler · puma", note: "Rails, Sinatra and Rack apps." },
      { id: "static", name: "Static", group: "other", cmd: "web directory · nginx", note: "Plain HTML, CSS and JavaScript." }
    ]
  }

  shown() {
    if this.group is "all" {
      return this.stacks
    }
    return this.stacks.filter((s) => s.group is this.group)
  }

  current() {
    return this.groups.find((g) => g.id is this.group) or this.groups[0]
  }

action
  pick(id) {
    this.group = id
  }

  count(id) {
    if id is "all" {
      return this.stacks.length
    }
    return this.stacks.filter((s) => s.group is id).length
  }

  tabCls(id) {
    const base = "shrink-0 inline-flex items-center gap-1.5 rounded-full px-3.5 h-9 text-sm font-medium border transition-colors "
    if this.group is id {
      return base + "border-brand-500/50 bg-brand-500/10 text-brand-700 dark:text-brand-400"
    }
    return base + "border-line bg-panel text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:border-line-strong"
  }

  groupName(id) {
    const g = this.groups.find((x) => x.id is id)
    return g ? g.name : ""
  }

template
<section id="stacks" class="scroll-mt-24 px-4 sm:px-6 py-20 sm:py-24 border-b border-line">
  <div class="max-w-6xl mx-auto">

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">
      <div class="max-w-2xl">
        <p class="text-brand-700 dark:text-brand-400 text-xs font-semibold uppercase tracking-[0.16em] mb-3">Stacks</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-4 text-balance">Every stack you run, one deploy flow</h2>
        <p class="text-slate-500 leading-relaxed min-h-[3rem]">{{ current.note }}</p>
      </div>
    </div>

    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap mb-6">
{{#each g in groups}}
      <button type="button" onclick="{{ pick(g.id) }}" aria-pressed="{{ group is g.id ? 'true' : 'false' }}" class="{{ tabCls(g.id) }}">
        {{ g.name }} <span class="tabular-nums text-xs opacity-60">{{ count(g.id) }}</span>
      </button>
{{/each}}
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">
{{#each s in shown}}
      <li class="group rounded-2xl border border-line bg-panel p-3 sm:p-4 hover:-translate-y-0.5 hover:border-brand-500/40 hover:shadow-lg hover:shadow-black/[0.04] dark:hover:shadow-black/30 transition-all duration-200">
        <div class="flex items-center gap-2.5 sm:gap-3 sm:mb-3.5">
          <BrandLogo kind="{{ s.id }}" label="{{ s.name }}" />
          <div class="min-w-0">
            <h3 class="text-slate-900 dark:text-slate-100 text-sm font-semibold truncate">{{ s.name }}</h3>
            <p class="text-slate-500 text-[11px]">{{ groupName(s.group) }}</p>
          </div>
        </div>
        <p class="hidden sm:block rounded-lg bg-sunken border border-line px-2.5 py-1.5 text-slate-600 dark:text-slate-400 text-[11px] font-mono truncate">{{ s.cmd }}</p>
        <p class="hidden sm:block text-slate-500 text-xs mt-2.5 leading-relaxed">{{ s.note }}</p>
      </li>
{{/each}}
      <li class="col-span-2 lg:col-span-4 rounded-2xl border border-dashed border-line-strong p-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
        <span class="w-9 h-9 shrink-0 rounded-xl bg-slate-500/10 text-slate-600 dark:text-slate-400 flex items-center justify-center"><IconPlus class="w-5 h-5" /></span>
        <div class="min-w-0 flex-1">
          <h3 class="text-slate-900 dark:text-slate-100 text-sm font-semibold">Something not on the list?</h3>
          <p class="text-slate-500 text-xs mt-0.5 leading-relaxed">Every app site has editable build and start commands, so anything that runs on Linux can deploy.</p>
        </div>
        <p class="shrink-0 self-start sm:self-auto rounded-lg border border-dashed border-line px-2.5 py-1.5 text-slate-500 text-[11px] font-mono">your build · your start</p>
      </li>
    </ul>
  </div>
</section>
