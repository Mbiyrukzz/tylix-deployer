page SourceControl

import { IconFolder, IconArrowLeft, IconChevronRight } from "tylix-icons"

title "Source control"

needs
  Auth

uses
  SourceProviders

state
  checkedAuth: false
  removing: 0
  removeError: ""

action
  // The saved picture, or GitHub's public one for connections saved before
  // pictures were kept (github.com/<user>.png needs no token).
  avatarFor(p) {
    if p.avatar_url {
      return String(p.avatar_url)
    }
    if p.kind is "github" and p.username {
      return "https://github.com/" + encodeURIComponent(p.username) + ".png?size=96"
    }
    return ""
  }

  addProvider(item) {
    SourceProviders.add(item)
  }

  updateProvider(item) {
    SourceProviders.replace(item)
  }

  askRemove(id) {
    this.removeError = ""
    this.removing = id
  }

  cancelRemove() {
    this.removing = 0
  }

  async confirmRemove(id) {
    const result = await SourceProviders.remove(id)
    if not result.ok {
      this.removeError = result.data?.error or "Couldn't remove that connection."
    }
    this.removing = 0
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await SourceProviders.load()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-1 bg-page transition-colors">
    <div class="min-w-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-12 py-6 sm:py-10">

        <a href="/dashboard" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
          <IconArrowLeft class="w-4 h-4" /> Dashboard
        </a>

        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-800 dark:text-slate-200">Source control</h1>
            <p class="text-slate-500 text-sm mt-1">Accounts your sites can deploy code from</p>
          </div>
          <SourceProviderForm onSaved="{{ addProvider }}" />
        </div>

{{#if removeError}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ removeError }}</p>
{{/if}}

{{#if SourceProviders.data.length is 0}}
        <div class="rounded-2xl border border-dashed border-slate-400 dark:border-slate-800 bg-panel p-10 text-center">
          <div class="w-14 h-14 rounded-2xl bg-brand-500/10 flex items-center justify-center mx-auto mb-4">
            <IconFolder class="w-6 h-6 text-brand-700 dark:text-brand-500" />
          </div>
          <h3 class="text-slate-800 dark:text-slate-200 font-medium mb-1.5">No accounts connected</h3>
          <p class="text-slate-500 text-sm max-w-sm mx-auto">Connect GitHub or GitLab to create sites from your repositories.</p>
        </div>
{{/if}}

{{#if SourceProviders.data.length is not 0}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
{{#each p in SourceProviders.data}}
          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel p-6 shadow-sm dark:shadow-none">
            <a href="{{ '/source-control/connection?id=' + p.id }}" class="group flex items-center gap-3.5 mb-5 -m-2 p-2 rounded-xl hover:bg-zinc-100 dark:hover:bg-white/[0.03] transition-colors">
              <span class="relative shrink-0">
                <BrandLogo kind="{{ p.kind }}" label="{{ p.username }}" src="{{ avatarFor(p) }}" size="lg" />
{{#if avatarFor(p)}}
                <span class="absolute -bottom-1 -right-1 rounded-md ring-2 ring-[var(--panel)]">
                  <BrandLogo kind="{{ p.kind }}" size="xs" />
                </span>
{{/if}}
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-2">
                  <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">{{ p.label }}</span>
                  <span class="shrink-0 text-[10px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500">{{ p.status }}</span>
                </span>
                <span class="block text-slate-500 text-sm truncate">{{ p.display_name ? p.display_name + " · " : "" }}<span class="font-mono">@{{ p.username }}</span></span>
                <span class="block text-slate-400 dark:text-slate-500 text-[11px] font-semibold uppercase tracking-wider mt-0.5">{{ p.kind is "gitlab" ? "GitLab" : "GitHub" }}</span>
              </span>
              <IconChevronRight class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition-colors" />
            </a>
            <div class="flex items-center gap-3">
              <SourceProviderForm provider="{{ p }}" onSaved="{{ updateProvider }}" />
{{#if removing is p.id}}
              <button onclick="{{ confirmRemove(p.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 py-2 transition">Yes, remove</button>
              <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">Cancel</button>
{{/if}}
{{#if removing is not p.id}}
              <button onclick="{{ askRemove(p.id) }}" class="text-sm text-rose-500 hover:text-rose-400 border border-rose-900/50 rounded-full px-4 py-2 hover:bg-rose-950/30 transition">Remove</button>
{{/if}}
            </div>
          </div>
{{/each}}
        </div>
{{/if}}

      </div>
    </div>
  </div>
{{/if}}
{{#if not checkedAuth}}
<PageLoader label="Loading source providers..." />
{{/if}}