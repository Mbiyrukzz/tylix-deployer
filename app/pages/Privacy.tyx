      <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Legal</p>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-2">Privacy Policy</h1>
      <p class="text-slate-500 text-sm mb-10">Effective {{ effective }}</p>

      <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-6 lg:gap-10">

        <nav class="hidden lg:block">
          <div class="sticky top-24 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-3">On this page</p>
            <ul class="space-y-1.5 text-sm">
              <li><a href="#who" class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400">1. Who we are</a></li>
              <li><a href="#collect" class="text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400">2. What we collect</a></li>
