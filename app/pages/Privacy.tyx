page Privacy

title "Privacy Policy"

import { IconShieldCheck, IconKey, IconEye, IconUserGroup, IconMail, IconArrowRight } from "tylix-icons"

// The binding text is the numbered sections. "The short version" only
// restates them in plain words and links to the clause each comes from;
// keep it in step when a section changes. The section list for
// "On this page" lives in components/LegalToc.tyx.

state
  effective: "26 October 2026"

template
<div class="min-h-[calc(100vh-4rem)] bg-page transition-colors">

  <LegalHero kind="privacy" title="Privacy Policy" effective="{{ effective }}" readTime="About 9 min read" lead="What personal data Tylix Flux collects, why we need it, who it is shared with, how long we keep it, and the rights you have under Kenya's Data Protection Act, 2019." />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-10 sm:py-14">

    <section aria-labelledby="short-version" class="mb-12 sm:mb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-5">
        <h2 id="short-version" class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">The short version</h2>
        <p class="text-xs text-zinc-500">A plain summary. The full policy below is what applies.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="#use" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconShieldCheck class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">We don't sell your data</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Nor do we use your credentials or server contents for advertising.</p>
        </a>
        <a href="#security" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconKey class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Secrets are encrypted</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">SSH keys, provider tokens and database passwords are encrypted; passwords are hashed.</p>
        </a>
        <a href="#cookies" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconEye class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">No advertising cookies</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Only what keeps you signed in and remembers your theme.</p>
        </a>
        <a href="#rights" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
          <span class="w-9 h-9 mb-4 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center"><IconUserGroup class="w-[18px] h-[18px]" /></span>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">You're in control</h3>
          <p class="text-[13px] leading-relaxed text-zinc-500">Ask to see, correct, export or delete your data at privacy@tylix.dev.</p>
        </a>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)] gap-6 lg:gap-14">

      <LegalToc kind="privacy" />

      <article data-legal class="min-w-0 max-w-3xl break-words">
        <div class="legal-prose">

        <section id="who" class="legal-section">
          <h2><span class="legal-num">01</span><span>Who we are<a href="#who" class="legal-anchor" aria-label="Link to Who we are">#</a></span></h2>
          <p>Ashmif Office Solutions Ltd, based in Mombasa, Kenya, runs Tylix Flux and is the data controller for personal data processed through it. This policy explains what we collect, why, who we share it with, and the choices you have. We process personal data in line with the Kenya Data Protection Act, 2019. It sits alongside our <a href="/terms">Terms of Service</a>.</p>
          <p>Content you deploy or store on your own servers (for example, your customers' data in your databases) is yours. For that content you are the controller and we only act on your instructions to provide the Service.</p>
        </section>

        <section id="collect" class="legal-section">
          <h2><span class="legal-num">02</span><span>What we collect<a href="#collect" class="legal-anchor" aria-label="Link to What we collect">#</a></span></h2>
          <ul>
            <li><strong>Account data:</strong> your name, email address and password (stored only as a hash), your email verification status, and your team memberships, roles and invitations.</li>
            <li><strong>Billing data:</strong> your plan, subscription status, payment history and the identifiers Paystack gives us for your customer and subscription. Card and mobile money details are entered with Paystack and are not stored by us.</li>
            <li><strong>Infrastructure data you give us:</strong> server hostnames, IP addresses, ports and SSH usernames; SSH private keys; cloud provider and registrar API tokens; repository and branch details; database user names and generated passwords; environment variables and deployment scripts.</li>
            <li><strong>Operational data:</strong> server statistics (CPU, memory, disk, load, uptime), deployment and provisioning logs, server event logs, and the commands and actions taken through the Service, with who took them and when.</li>
            <li><strong>Technical data:</strong> IP address, browser and device information, and request logs created when you use the Service, used for security and troubleshooting.</li>
            <li><strong>Messages:</strong> anything you send us for support.</li>
          </ul>
        </section>

        <section id="use" class="legal-section">
          <h2><span class="legal-num">03</span><span>How we use it<a href="#use" class="legal-anchor" aria-label="Link to How we use it">#</a></span></h2>
          <ul>
            <li>to create and secure your account, and to authenticate you;</li>
            <li>to provide the Service: provisioning and managing servers, deploying sites, issuing certificates, showing statistics and logs;</li>
            <li>to take payment, manage your subscription and apply plan limits;</li>
            <li>to send service emails such as verification, password reset, team invitations, receipts and billing or security notices;</li>
            <li>to detect, prevent and investigate abuse, fraud and security incidents;</li>
            <li>to fix bugs, support you, and improve the Service;</li>
            <li>to meet legal, tax and accounting obligations.</li>
          </ul>
          <p>We do not sell your personal data, and we do not use your stored credentials or server contents for advertising.</p>
        </section>

        <section id="basis" class="legal-section">
          <h2><span class="legal-num">04</span><span>Legal basis<a href="#basis" class="legal-anchor" aria-label="Link to Legal basis">#</a></span></h2>
          <p>We process personal data where it is necessary to perform our contract with you (providing the Service), where we have a legitimate interest that is not outweighed by your rights (security, fraud prevention, product improvement), where we must comply with the law, and where you have given consent, for example to optional communications. You can withdraw consent at any time, and that does not affect processing that already happened.</p>
        </section>

        <section id="sharing" class="legal-section">
          <h2><span class="legal-num">05</span><span>Who we share it with<a href="#sharing" class="legal-anchor" aria-label="Link to Who we share it with">#</a></span></h2>
          <p>We share personal data only where needed to run the Service:</p>
          <ul>
            <li><strong>Paystack</strong>, to process payments and manage subscriptions.</li>
            <li><strong>Cloud providers, registrars and Git hosts you connect</strong> (such as Linode, Hetzner, DigitalOcean, Vultr, UpCloud, Porkbun, Cloudflare, GoDaddy and GitHub). We send them the requests, tokens and details needed to do what you ask, under your own account with them.</li>
            <li><strong>Your own servers</strong>, over SSH, to carry out your instructions.</li>
            <li><strong>Let's Encrypt</strong>, when you request a certificate (domain names are sent to it).</li>
            <li><strong>Infrastructure and email providers</strong> that host the Service and deliver our emails, under contracts that require them to protect the data.</li>
            <li><strong>Your team.</strong> Other members of your team can see the resources, activity and logs of that team, according to their roles.</li>
            <li><strong>Authorities and advisers</strong>, where the law requires it, to enforce our terms, or to protect rights and safety, and to professional advisers under confidentiality. If the business is sold or restructured, data may transfer to the new owner under this policy.</li>
          </ul>
        </section>

        <section id="security" class="legal-section">
          <h2><span class="legal-num">06</span><span>Security<a href="#security" class="legal-anchor" aria-label="Link to Security">#</a></span></h2>
          <p>We take steps to protect your data. SSH keys, provider tokens and database passwords are encrypted before they are stored. Passwords are hashed. Access is scoped by team and role, traffic uses HTTPS, and sign-in is rate limited. No system is perfectly secure, so we cannot guarantee absolute security. Please use strong, unique passwords, give team members only the roles they need, and use provider tokens with the narrowest permissions that work. If a breach affects your personal data, we will notify you and the Data Commissioner where the law requires, and without undue delay.</p>
        </section>

        <section id="cookies" class="legal-section">
          <h2><span class="legal-num">07</span><span>Cookies and similar technologies<a href="#cookies" class="legal-anchor" aria-label="Link to Cookies and similar technologies">#</a></span></h2>
          <p>We use a small number of cookies and browser storage items that the Service needs to work: authentication cookies (access and refresh tokens) that keep you signed in, and a setting that remembers your light or dark theme. We do not use advertising cookies. You can block cookies in your browser, but you will not be able to sign in.</p>
        </section>

        <section id="retention" class="legal-section">
          <h2><span class="legal-num">08</span><span>Retention<a href="#retention" class="legal-anchor" aria-label="Link to Retention">#</a></span></h2>
          <p>We keep personal data while your account is active and as long as needed to provide the Service. When you delete a server, connection or site, we remove its stored credentials and configuration. After you close your account, we delete or anonymise your data within a reasonable period, normally within 90 days, except what we must keep to meet legal, tax, accounting or dispute-resolution requirements (for example, payment records, which we keep for the period the law requires). Backups and logs may take a little longer to age out.</p>
        </section>

        <section id="transfers" class="legal-section">
          <h2><span class="legal-num">09</span><span>International transfers<a href="#transfers" class="legal-anchor" aria-label="Link to International transfers">#</a></span></h2>
          <p>Our providers, and the cloud and registrar services you connect, may process data outside Kenya. Where we transfer personal data out of Kenya, we do so as the Data Protection Act allows, with appropriate safeguards such as contractual protections or your consent.</p>
        </section>

        <section id="rights" class="legal-section">
          <h2><span class="legal-num">10</span><span>Your rights<a href="#rights" class="legal-anchor" aria-label="Link to Your rights">#</a></span></h2>
          <p>Under the Data Protection Act, 2019, you have the right to:</p>
          <ul>
            <li>be informed about how we use your data (this policy);</li>
            <li>access the personal data we hold about you;</li>
            <li>object to certain processing, and withdraw consent you have given;</li>
            <li>have inaccurate data corrected;</li>
            <li>have data deleted where we no longer need it, subject to legal duties to keep it;</li>
            <li>receive a copy of data you provided in a portable format, where applicable.</li>
          </ul>
          <p>To use these rights, email <a href="mailto:privacy@tylix.dev">privacy@tylix.dev</a>. We may need to verify your identity first and we will respond within the time the law sets. You also have the right to complain to the Office of the Data Protection Commissioner of Kenya (odpc.go.ke), though we would appreciate the chance to fix the problem first.</p>
        </section>

        <section id="children" class="legal-section">
          <h2><span class="legal-num">11</span><span>Children<a href="#children" class="legal-anchor" aria-label="Link to Children">#</a></span></h2>
          <p>The Service is for people aged 18 and over. We do not knowingly collect personal data from children. If you believe a child has given us data, contact us and we will delete it.</p>
        </section>

        <section id="changes" class="legal-section">
          <h2><span class="legal-num">12</span><span>Changes to this policy<a href="#changes" class="legal-anchor" aria-label="Link to Changes to this policy">#</a></span></h2>
          <p>We may update this policy as the Service or the law changes. We will update the effective date above and, for material changes, tell you by email or in the dashboard before they take effect.</p>
        </section>

        <section id="contact" class="legal-section">
          <h2><span class="legal-num">13</span><span>Contact<a href="#contact" class="legal-anchor" aria-label="Link to Contact">#</a></span></h2>
          <p>Ashmif Office Solutions Ltd, Mombasa, Kenya. Website: <a href="https://ashmif.com" target="_blank" rel="noopener">ashmif.com</a>. Privacy questions and requests: <a href="mailto:privacy@tylix.dev">privacy@tylix.dev</a>.</p>
        </section>

        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 legal-noprint">
          <a href="mailto:privacy@tylix.dev" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
            <IconMail class="w-5 h-5 text-zinc-400 mb-3" />
            <p class="mb-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100">A privacy question or request?</p>
            <p class="text-[13px] leading-relaxed text-zinc-500">Write to privacy@tylix.dev to access, correct or delete your data.</p>
          </a>
          <a href="/terms" class="group rounded-2xl border border-line bg-panel p-5 hover:border-line-strong transition-colors">
            <IconArrowRight class="w-5 h-5 text-zinc-400 mb-3 group-hover:translate-x-0.5 transition-transform" />
            <p class="mb-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100">Read the Terms of Service</p>
            <p class="text-[13px] leading-relaxed text-zinc-500">The agreement for using Tylix Flux, billing and cancellation.</p>
          </a>
        </div>

      </article>
    </div>
  </div>
</div>
