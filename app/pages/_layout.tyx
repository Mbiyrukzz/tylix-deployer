<script>
import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Auth
  Theme

state
  mobileMenuOpen: false
  showDashboardLink: true

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  checkRoute() {
    const path = window.location.pathname
    const inApp = path.startsWith("/dashboard") or path.startsWith("/server")
    this.showDashboardLink = not inApp
  }

  initial(user) {
    if not user {
      return "?"
    }
    const source = user.email or user.name or "?"
    return source.charAt(0).toUpperCase()
  }

    async callLogout() {
    return Auth.logout()
  }

  async logout() {
    this.mobileMenuOpen = false
    await this.callLogout().catch((err) => console.error("logout failed:", err))
    window.location.replace("/login")
  }

onMount
  async {
    this.checkRoute()
  }
</script>
<template>
  <div class="bg-slate-200 dark:bg-slate-950 text-slate-800 dark:text-slate-200 min-h-screen transition-colors">
    <nav class="px-6 md:px-10 h-16 flex items-center justify-between sticky top-0 z-40 bg-slate-200/90 dark:bg-slate-950/90 backdrop-blur-xl border-b border-slate-300 dark:border-slate-800">
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/logo-mark.png" alt="Tylix" class="w-8 h-8 group-hover:scale-105 transition-transform" />
        <span class="text-slate-900 dark:text-slate-100 font-semibold tracking-tight">Tylix Deploy</span>
      </a>

      <div class="flex items-center gap-2">
{{#if Auth.user}}
{{#if showDashboardLink}}
        <a href="/dashboard" class="hidden sm:inline-flex text-sm font-medium text-emerald-700 dark:text-emerald-400 rounded-full px-4 py-1.5 hover:bg-emerald-500/10 transition-colors">
          Dashboard
        </a>
{{/if}}
{{/if}}

        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{/if}}
{{#if Theme.mode is not "dark"}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <div class="hidden sm:flex items-center gap-2.5 rounded-full border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 pl-1 pr-3 py-1">
          <div class="w-7 h-7 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white text-xs font-semibold">
            {{ initial(Auth.user) }}
          </div>
          <span class="hidden lg:block text-sm text-slate-700 dark:text-slate-200 max-w-[120px] truncate">{{ Auth.user.name }}</span>
        </div>
        <button onclick="{{ logout() }}" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors">
          Log out
        </button>
{{/if}}
{{#if not Auth.user}}
        <a href="/login" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 transition-colors px-3 py-1.5">
          Login
        </a>
        <a href="/register" class="hidden sm:block text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-1.5 shadow-sm hover:bg-emerald-400 transition-all">
          Get Started
        </a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="sm:hidden w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{/if}}
{{#if not mobileMenuOpen}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="sm:hidden border-b border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-950 px-6 py-4 flex flex-col gap-1">
{{#if Auth.user}}
      <div class="flex items-center gap-3 px-3 py-2 mb-1">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white text-sm font-semibold">
          {{ initial(Auth.user) }}
        </div>
        <div class="min-w-0">
          <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ Auth.user.name }}</p>
          <p class="text-slate-500 dark:text-slate-400 text-xs truncate">{{ Auth.user.email }}</p>
        </div>
      </div>
      <div class="h-px bg-slate-300 dark:bg-slate-800 my-1"></div>
{{#if showDashboardLink}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="text-sm font-medium text-emerald-700 dark:text-emerald-400 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Dashboard</a>
{{/if}}
      <button onclick="{{ logout() }}" class="text-sm text-left text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Log out</button>
{{/if}}
{{#if not Auth.user}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Login</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-sm text-center bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2.5 mt-1 shadow-sm hover:bg-emerald-400 transition-all">Get Started</a>
{{/if}}
    </div>
{{/if}}

    <div data-tylix-slot="true"></div>
  </div>
</template>