<script>
import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Auth
  Theme

state
  mobileMenuOpen: false

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }
</script>
<template>
  <div class="bg-slate-200 dark:bg-slate-950 min-h-screen transition-colors">
    <nav class="px-6 md:px-10 h-16 flex items-center justify-between sticky top-0 z-40 bg-slate-200/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-300 dark:border-slate-800">
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/logo-mark.png" alt="Tylix" class="w-8 h-8 group-hover:scale-105 transition-transform" />
        <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
      </a>

{{#if Auth.user}}
      <div class="hidden md:flex items-center gap-1 rounded-full border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 p-1">
        <a href="/dashboard" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 px-4 py-1.5 rounded-full transition-colors">Dashboard</a>
        <a href="/servers" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-800 px-4 py-1.5 rounded-full transition-colors">Servers</a>
      </div>
{{/if}}

      <div class="flex items-center gap-2">
        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-500 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{/if}}
{{#if Theme.mode is not "dark"}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <button onclick="{{ Auth.logout() }}" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors">
          Log out
        </button>
{{/if}}
{{#if not Auth.user}}
        <a href="/login" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 transition-colors px-3 py-1.5">
          Login
        </a>
        <a href="/register" class="hidden sm:block text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-1.5 shadow-sm hover:bg-emerald-400 transition-all">
          Get Started
        </a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-300/50 dark:hover:bg-slate-900 transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{/if}}
{{#if not mobileMenuOpen}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="md:hidden border-b border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-950 px-6 py-4 flex flex-col gap-1">
{{#if Auth.user}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Dashboard</a>
      <a href="/servers" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Servers</a>
      <div class="h-px bg-slate-300 dark:bg-slate-800 my-2"></div>
      <button onclick="{{ Auth.logout() }}" class="text-sm text-left text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Log out</button>
{{/if}}
{{#if not Auth.user}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-300/50 dark:hover:bg-slate-900 rounded-xl px-3 py-2.5 transition-colors">Login</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-sm text-center bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2.5 mt-1 shadow-sm hover:bg-emerald-400 transition-all">Get Started</a>
{{/if}}
    </div>
{{/if}}

    <div data-tylix-slot="true"></div>
  </div>
</template>