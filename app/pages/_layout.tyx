<script>
import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Auth
  Theme

state
  mobileMenuOpen: false

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }
</script>
<template>
  <div class="bg-slate-50 dark:bg-slate-950 min-h-screen transition-colors">
    <nav class="px-6 md:px-10 h-16 flex items-center justify-between sticky top-0 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/logo-mark.png" alt="Tylix" class="w-8 h-8 group-hover:scale-105 transition-transform" />
        <span class="text-slate-900 dark:text-slate-200 font-semibold tracking-tight">Tylix</span>
      </a>

      <div class="hidden md:flex items-center gap-1 bg-slate-200 dark:bg-slate-900 rounded-full px-1.5 py-1.5">
        <a href="https://tylix.dev/docs" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-white dark:hover:bg-slate-800 px-4 py-1.5 rounded-full transition-all">Docs</a>
        <a href="https://github.com/tylixjs" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-white dark:hover:bg-slate-800 px-4 py-1.5 rounded-full transition-all">GitHub</a>
        <a href="https://discord.gg/tylix" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-white dark:hover:bg-slate-800 px-4 py-1.5 rounded-full transition-all">Discord</a>
      </div>

      <div class="flex items-center gap-2">
        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-emerald-500 hover:bg-slate-200 dark:hover:bg-slate-900 transition-colors"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{/if}}
{{#if Theme.mode is not "dark"}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <a href="/dashboard" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 transition-colors px-3 py-1.5">
          Dashboard
        </a>
        <button onclick="{{ Auth.logout() }}" class="hidden sm:block text-sm px-4 py-1.5 rounded-full border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-600 transition-colors">
          Log out
        </button>
{{/if}}
{{#if not Auth.user}}
        <a href="/login" class="hidden sm:block text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 transition-colors px-3 py-1.5">
          Login
        </a>
        <a href="/register" class="hidden sm:block text-sm px-4 py-1.5 rounded-full bg-gradient-to-r from-emerald-400 to-emerald-600 text-white font-semibold shadow-sm shadow-emerald-500/30 hover:shadow-md hover:shadow-emerald-500/40 hover:-translate-y-0.5 transition-all">
          Get Started
        </a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-full text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{/if}}
{{#if not mobileMenuOpen}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-6 py-6 flex flex-col gap-1 shadow-lg">
      <a href="https://tylix.dev/docs" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">Docs</a>
      <a href="https://github.com/tylixjs" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">GitHub</a>
      <a href="https://discord.gg/tylix" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">Discord</a>
      <div class="h-px bg-slate-200 dark:bg-slate-800 my-2"></div>
{{#if Auth.user}}
      <a href="/dashboard" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">Dashboard</a>
      <button onclick="{{ Auth.logout() }}" class="text-sm text-left text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">Log out</button>
{{/if}}
{{#if not Auth.user}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-900 rounded-lg px-3 py-2.5 transition-colors">Login</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-sm text-white bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-lg px-3 py-2.5 font-medium text-center mt-1">Get Started</a>
{{/if}}
    </div>
{{/if}}

    <div data-tylix-slot="true"></div>
  </div>
</template>