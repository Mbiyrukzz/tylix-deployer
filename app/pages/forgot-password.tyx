page ForgotPassword

title "Forgot password"

needs
  Auth

state
  ready: false
  signedIn: false
  showForm: false
  email: ""
  error: ""
  submitting: false
  submitLabel: "Send reset link"
  submitDim: ""
  sent: false
  sentMessage: ""

action
  setField(field, value) {
    this[field] = value
  }

  onKey(event) {
    if event.key is "Enter" and event.target.tagName is "INPUT" {
      this.submit()
    }
  }

  async submit() {
    if not this.submitting {
      if not this.email {
        this.error = "Enter your email address."
        return null
      }

      this.submitting = true
      this.submitLabel = "Sending…"
      this.submitDim = "opacity-50 pointer-events-none"
      this.error = ""

      const result = await useApi("/api/auth/forgot-password", {
        method: "POST",
        body: { email: this.email }
      })

      this.submitting = false
      this.submitLabel = "Send reset link"
      this.submitDim = ""

      if result.ok {
        this.sentMessage = result.data?.message or "If that email is registered, a reset link has been sent."
        this.showForm = false
        this.sent = true
      } else if result.status is 422 and result.data.errors {
        const firstField = Object.keys(result.data.errors)[0]
        this.error = result.data.errors[firstField][0]
      } else {
        this.error = result.data?.error or result.error or "Could not send the reset link. Try again."
      }
    }
  }

onMount
  async {
    document.addEventListener("keydown", (event) => this.onKey(event))
    if Auth.user {
      this.signedIn = true
    } else {
      this.showForm = true
    }
    this.ready = true
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-page transition-colors px-6 py-16">
    <div class="w-full max-w-md rounded-3xl border border-line bg-panel shadow-xl shadow-slate-300/40 dark:shadow-none px-8 py-10">

      <a href="/" class="flex items-center gap-2.5 justify-center mb-8">
        <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
        <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
      </a>

{{#if not ready}}
      <p class="text-slate-500 text-sm text-center">Loading…</p>
{{/if}}

{{#if signedIn}}
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">You're already signed in</h1>
      <p class="text-slate-500 text-sm mb-8">To change your password, use your account settings.</p>
      <a href="/settings/password" class="inline-block w-full text-center bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
        Go to password settings
      </a>
{{/if}}

{{#if sent}}
      <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center text-lg mb-5 text-brand-700 dark:text-brand-400">✓</div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Check your email</h1>
      <p class="text-slate-500 text-sm mb-3">{{ sentMessage }}</p>
      <p class="text-slate-400 dark:text-slate-600 text-xs mb-8">The link is valid for 1 hour. Check your spam folder if you don't see it.</p>
      <a href="/login" class="inline-block w-full text-center bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
        Back to login
      </a>
{{/if}}

{{#if showForm}}
      <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-1">Account recovery</p>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Forgot your password?</h1>
      <p class="text-slate-500 text-sm mb-8">Enter your email and we'll send you a link to choose a new one.</p>

{{#if error}}
      <div role="alert" aria-live="polite" class="flex items-start gap-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
        <span class="mt-0.5 text-rose-600 dark:text-rose-400 text-sm font-bold" aria-hidden="true">!</span>
        <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
      </div>
{{/if}}

      <label for="email" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        autofocus
        placeholder="you@example.com"
        value="{{ email }}"
        oninput="{{ setField('email', event.target.value) }}"
        class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-5 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
      />

      <button onclick="{{ submit() }}" class="w-full bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all {{ submitDim }}">
        {{ submitLabel }}
      </button>

      <p class="text-sm text-slate-500 text-center mt-6">
        Remembered it? <a href="/login" class="text-brand-700 dark:text-brand-400 hover:underline">Log in</a>
      </p>
{{/if}}

    </div>
  </div>