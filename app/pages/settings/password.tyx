page SettingsPassword

title "Password"

state
  busy: false
  error: ""
  currentError: ""
  passwordError: ""
  confirmError: ""
  confirmSignOut: false
  signingOut: false
  signOutError: ""

action
  readValue(id) {
    const el = document.getElementById(id)
    if not el {
      return ""
    }
    return String(Reflect.get(el, "value"))
  }

  firstError(data, field) {
    const errors = (data and data.errors) or {}
    const list = errors[field]
    if Array.isArray(list) and list.length > 0 {
      return list[0]
    }
    return ""
  }

  async changePassword() {
    if this.busy {
      return null
    }

    const current = this.readValue("pw-current")
    const next = this.readValue("pw-new")
    const again = this.readValue("pw-confirm")

    this.busy = true
    this.error = ""
    this.currentError = ""
    this.passwordError = ""
    this.confirmError = ""

    const result = await useApi("/api/account/password", {
      method: "PUT",
      body: { current_password: current, password: next, password_confirmation: again }
    })

    this.busy = false

    if result.ok {
      window.location.href = "/login"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 422 {
      this.currentError = this.firstError(result.data, "current_password")
      this.passwordError = this.firstError(result.data, "password")
      this.confirmError = this.firstError(result.data, "password_confirmation")
    } else {
      this.error = result.data?.error or "Couldn't change your password."
    }
  }

  askSignOut() {
    this.signOutError = ""
    this.confirmSignOut = true
  }

  cancelSignOut() {
    this.confirmSignOut = false
  }

  async signOutEverywhere() {
    if this.signingOut {
      return null
    }

    this.signingOut = true
    this.signOutError = ""

    const result = await useApi("/api/account/sign-out-everywhere", { method: "POST" })

    if result.ok or result.status is 401 {
      window.location.href = "/login"
    } else {
      this.signOutError = result.data?.error or "Couldn't sign you out."
      this.signingOut = false
      this.confirmSignOut = false
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="settings" />
    <SettingsSidebar active="password" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Password</h1>
      <p class="text-slate-500 text-sm mb-8">Use a long, unique password. You'll be signed out everywhere after changing it.</p>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-5">Change password</h2>

        <label for="pw-current" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Current password</label>
        <input id="pw-current" type="password" autocomplete="current-password" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
{{#if currentError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ currentError }}</p>
{{/if}}

        <label for="pw-new" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mt-5 mb-1.5">New password</label>
        <input id="pw-new" type="password" autocomplete="new-password" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
        <p class="text-slate-500 text-xs mt-2">8 to 128 characters.</p>
{{#if passwordError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ passwordError }}</p>
{{/if}}

        <label for="pw-confirm" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mt-5 mb-1.5">Confirm new password</label>
        <input id="pw-confirm" type="password" autocomplete="new-password" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />
{{#if confirmError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ confirmError }}</p>
{{/if}}

{{#if error}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}

        <div class="mt-6">
{{#if busy}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 opacity-50">
            Updating…
          </button>
{{/if}}
{{#if not busy}}
          <button onclick="{{ changePassword() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">
            Update password
          </button>
{{/if}}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Sign out everywhere</h2>
        <p class="text-slate-500 text-sm mb-4">Ends every session on every device, including this one. Use it if you think someone else has access to your account.</p>

{{#if signOutError}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ signOutError }}</p>
{{/if}}

{{#if not confirmSignOut}}
        <button onclick="{{ askSignOut() }}" class="text-sm text-amber-700 dark:text-amber-500 border border-amber-200 dark:border-amber-900/50 rounded-lg px-4 py-2 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition">
          Sign out everywhere
        </button>
{{/if}}

{{#if confirmSignOut}}
        <div class="flex items-center gap-3">
{{#if signingOut}}
          <button disabled class="text-sm text-white bg-amber-600 rounded-lg px-4 py-2 opacity-50">
            Signing out…
          </button>
{{/if}}
{{#if not signingOut}}
          <button onclick="{{ signOutEverywhere() }}" class="text-sm text-white bg-amber-600 hover:bg-amber-500 rounded-lg px-4 py-2 transition">
            Yes, sign me out
          </button>
          <button onclick="{{ cancelSignOut() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
            Cancel
          </button>
{{/if}}
        </div>
{{/if}}
      </div>

    </div>
    </div>
  </div>
