page SettingsPassword

title "Password"

needs
  Auth

state
  busy: false
  error: ""
  currentPassword: ""
  password: ""
  confirmPassword: ""
  currentError: ""
  passwordError: ""
  confirmError: ""
  showPassword: false
  passwordType: "password"
  toggleLabel: "Show"
  pwLength: false
  pwLetter: false
  pwNumber: false
  pwSymbol: false
  pwLabel: ""
  pwPct: 0
  pwColor: "#f43f5e"
  pwTouched: false
  matchYes: false
  matchNo: false
  confirmSignOut: false
  signingOut: false
  signOutError: ""

action
  setField(field, value) {
    this[field] = value
  }

  firstError(data, field) {
    const errors = (data and data.errors) or {}
    const list = errors[field]
    if Array.isArray(list) and list.length > 0 {
      return list[0]
    }
    return ""
  }

  togglePassword() {
    this.showPassword = not this.showPassword
    if this.showPassword {
      this.passwordType = "text"
      this.toggleLabel = "Hide"
    } else {
      this.passwordType = "password"
      this.toggleLabel = "Show"
    }
  }

  updateMatch() {
    if not this.confirmPassword {
      this.matchYes = false
      this.matchNo = false
    } else if this.password is this.confirmPassword {
      this.matchYes = true
      this.matchNo = false
    } else {
      this.matchYes = false
      this.matchNo = true
    }
  }

  updatePassword(value) {
    this.password = value
    this.pwTouched = true
    this.passwordError = ""
    const c = authUi.passwordChecks(value)
    this.pwLength = c.length
    this.pwLetter = c.letter
    this.pwNumber = c.number
    this.pwSymbol = c.symbol
    this.pwLabel = c.label
    this.pwPct = c.pct
    this.pwColor = c.color
    this.updateMatch()
  }

  updateConfirm(value) {
    this.confirmPassword = value
    this.confirmError = ""
    this.updateMatch()
  }

  async changePassword() {
    if this.busy {
      return null
    }

    this.error = ""
    this.currentError = ""
    this.passwordError = ""
    this.confirmError = ""

    if not this.currentPassword {
      this.currentError = "Enter your current password."
      return null
    }

    const c = authUi.passwordChecks(this.password)
    if not c.ok {
      this.pwTouched = true
      this.passwordError = "Password must be 10 or more characters with a letter, a number and a symbol."
      return null
    }

    if this.password is this.currentPassword {
      this.passwordError = "Your new password must be different from the current one."
      return null
    }

    if this.password is not this.confirmPassword {
      this.confirmError = "Passwords don't match."
      return null
    }

    this.busy = true

    const result = await useApi("/api/account/password", {
      method: "PUT",
      body: {
        current_password: this.currentPassword,
        password: this.password,
        password_confirmation: this.confirmPassword
      }
    })

    this.busy = false

    if result.ok {
      window.location.href = "/login"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 422 {
      this.currentError = this.firstError(result.data, "current_password")
      this.passwordError = this.firstError(result.data, "password")
      this.confirmError = this.firstError(result.data, "password_confirmation")
    } else {
      this.error = result.data?.error or "Couldn't change your password."
    }
  }

  askSignOut() {
    this.signOutError = ""
    this.confirmSignOut = true
  }

  cancelSignOut() {
    this.confirmSignOut = false
  }

  async signOutEverywhere() {
    if this.signingOut {
      return null
    }

    this.signingOut = true
    this.signOutError = ""

    const result = await useApi("/api/account/sign-out-everywhere", { method: "POST" })

    if result.ok or result.status is 401 {
      window.location.href = "/login"
    } else {
      this.signOutError = result.data?.error or "Couldn't sign you out."
      this.signingOut = false
      this.confirmSignOut = false
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-page transition-colors">
    <Sidebar active="settings" />
    <SettingsSidebar active="password" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Password</h1>
      <p class="text-slate-500 text-sm mb-8">Use a long, unique password. You'll be signed out everywhere after changing it.</p>

      <div class="rounded-2xl border border-line bg-panel p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-5">Change password</h2>

        <label for="pw-current" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Current password</label>
        <div class="relative">
          <input
            id="pw-current"
            type="{{ passwordType }}"
            autocomplete="current-password"
            value="{{ currentPassword }}"
            oninput="{{ setField('currentPassword', event.target.value) }}"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 pl-3.5 pr-16 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
          />
          <button type="button" onclick="{{ togglePassword() }}" aria-label="Show or hide passwords" class="absolute inset-y-0 right-3 text-xs font-medium text-slate-500 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            {{ toggleLabel }}
          </button>
        </div>
{{#if currentError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ currentError }}</p>
{{/if}}

        <label for="pw-new" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mt-5 mb-1.5">New password</label>
        <div class="relative">
          <input
            id="pw-new"
            type="{{ passwordType }}"
            autocomplete="new-password"
            placeholder="At least 10 characters"
            value="{{ password }}"
            oninput="{{ updatePassword(event.target.value) }}"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 pl-3.5 pr-16 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
          />
          <button type="button" onclick="{{ togglePassword() }}" aria-label="Show or hide passwords" class="absolute inset-y-0 right-3 text-xs font-medium text-slate-500 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            {{ toggleLabel }}
          </button>
        </div>

{{#if pwTouched}}
        <div class="mt-3 mb-3">
          <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
            <div class="h-full rounded-full transition-all duration-300" style="width: {{ pwPct }}%; background: {{ pwColor }}"></div>
          </div>
          <p class="text-xs text-slate-500 mt-1.5">{{ pwLabel }}</p>
        </div>

        <ul class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
          <li class="flex items-center gap-1.5">
{{#if pwLength}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">10+ characters</span>{{/if}}
{{#if not pwLength}}<span class="text-slate-400">○</span><span class="text-slate-500">10+ characters</span>{{/if}}
          </li>
          <li class="flex items-center gap-1.5">
{{#if pwLetter}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A letter</span>{{/if}}
{{#if not pwLetter}}<span class="text-slate-400">○</span><span class="text-slate-500">A letter</span>{{/if}}
          </li>
          <li class="flex items-center gap-1.5">
{{#if pwNumber}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A number</span>{{/if}}
{{#if not pwNumber}}<span class="text-slate-400">○</span><span class="text-slate-500">A number</span>{{/if}}
          </li>
          <li class="flex items-center gap-1.5">
{{#if pwSymbol}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A symbol</span>{{/if}}
{{#if not pwSymbol}}<span class="text-slate-400">○</span><span class="text-slate-500">A symbol</span>{{/if}}
          </li>
        </ul>
{{/if}}
{{#if not pwTouched}}
        <p class="text-slate-500 text-xs mt-2">At least 10 characters, with a letter, a number and a symbol. Avoid common words and anything containing your name or email.</p>
{{/if}}
{{#if passwordError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ passwordError }}</p>
{{/if}}

        <label for="pw-confirm" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mt-5 mb-1.5">Confirm new password</label>
        <div class="relative">
          <input
            id="pw-confirm"
            type="{{ passwordType }}"
            autocomplete="new-password"
            placeholder="Repeat your new password"
            value="{{ confirmPassword }}"
            oninput="{{ updateConfirm(event.target.value) }}"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 pl-3.5 pr-16 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
          />
          <button type="button" onclick="{{ togglePassword() }}" aria-label="Show or hide passwords" class="absolute inset-y-0 right-3 text-xs font-medium text-slate-500 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            {{ toggleLabel }}
          </button>
        </div>
{{#if matchYes}}
        <p class="text-brand-600 dark:text-brand-400 text-xs mt-2">Passwords match.</p>
{{/if}}
{{#if matchNo}}
        <p class="text-rose-600 dark:text-rose-400 text-xs mt-2">Passwords don't match yet.</p>
{{/if}}
{{#if confirmError}}
        <p role="alert" class="text-rose-500 text-sm mt-2">{{ confirmError }}</p>
{{/if}}

{{#if error}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}

        <div class="mt-6">
{{#if busy}}
          <button disabled class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 opacity-50">
            Updating…
          </button>
{{/if}}
{{#if not busy}}
          <button onclick="{{ changePassword() }}" class="text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-brand-400 transition-all">
            Update password
          </button>
{{/if}}
        </div>
      </div>

      <div class="rounded-2xl border border-line bg-panel p-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Sign out everywhere</h2>
        <p class="text-slate-500 text-sm mb-4">Ends every session on every device, including this one. Use it if you think someone else has access to your account.</p>

{{#if signOutError}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ signOutError }}</p>
{{/if}}

{{#if not confirmSignOut}}
        <button onclick="{{ askSignOut() }}" class="text-sm text-amber-700 dark:text-amber-500 border border-amber-200 dark:border-amber-900/50 rounded-lg px-4 py-2 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition">
          Sign out everywhere
        </button>
{{/if}}

{{#if confirmSignOut}}
        <div class="flex items-center gap-3">
{{#if signingOut}}
          <button disabled class="text-sm text-white bg-amber-600 rounded-lg px-4 py-2 opacity-50">
            Signing out…
          </button>
{{/if}}
{{#if not signingOut}}
          <button onclick="{{ signOutEverywhere() }}" class="text-sm text-white bg-amber-600 hover:bg-amber-500 rounded-lg px-4 py-2 transition">
            Yes, sign me out
          </button>
          <button onclick="{{ cancelSignOut() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
            Cancel
          </button>
{{/if}}
        </div>
{{/if}}
      </div>

    </div>
    </div>
  </div>