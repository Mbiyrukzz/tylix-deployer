page SettingsTeam

title "Team"

state
  loading: true
  teamName: ""
  role: ""
  canManage: false
  members: []
  invites: []
  busy: false
  error: ""
  notice: ""
  link: ""
   renaming: false
  renameError: ""

action
  readValue(id) {
    const el = document.getElementById(id)
    if not el {
      return ""
    }
    return String(Reflect.get(el, "value"))
  }

    clearValue(id) {
    const el = document.getElementById(id)
    if el {
      Reflect.set(el, "value", "")
    }
  }

  async loadInvites() {
    const result = await useApi("/api/team/invitations")
    if result.ok and Array.isArray(result.data) {
      this.invites = result.data.map((i) => ({
        id: i.id,
        email: i.email,
        role: i.role,
        expires: String(i.expires_at).slice(0, 10)
      }))
    }
  }

    async rename() {
    if this.renaming {
      return null
    }

    const name = this.readValue("team-name").trim()

    this.renaming = true
    this.renameError = ""
    this.notice = ""

    const result = await useApi("/api/team", { method: "PUT", body: { name: name } })

    this.renaming = false

    if result.ok {
      this.teamName = result.data.team.name
      this.notice = "Team renamed."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.data?.errors?.name {
      this.renameError = result.data.errors.name[0]
    } else {
      this.renameError = result.data?.error or "Couldn't rename the team."
    }
  }

  async load() {
    const result = await useApi("/api/team")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.teamName = result.data.team.name
      this.role = result.data.role
      this.canManage = result.data.role is "owner" or result.data.role is "admin"
      this.members = result.data.members.map((m) => ({
        id: m.id,
        name: m.name,
        email: m.email,
        role: m.role,
        joined: String(m.joined_at).slice(0, 10)
      }))

      if this.canManage {
        await this.loadInvites()
      }
    }

    this.loading = false
  }

  async invite() {
    if this.busy {
      return null
    }

    const email = this.readValue("invite-email")
    const role = this.readValue("invite-role")

    this.busy = true
    this.error = ""
    this.notice = ""
    this.link = ""

    const result = await useApi("/api/team/invitations", { method: "POST", body: { email: email, role: role } })

    this.busy = false

    if result.ok {
      if result.data.email_sent {
        this.notice = "Invitation sent to " + result.data.invitation.email + "."
      } else {
        this.notice = "The email couldn't be sent. Copy this link and send it yourself:"
        this.link = result.data.link
      }
      this.clearValue("invite-email")
      await this.loadInvites()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't send the invitation."
    }
  }

  async revoke(id) {
    this.error = ""
    this.notice = ""
    this.link = ""

    const result = await useApi("/api/team/invitations/" + id, { method: "DELETE" })

    if result.ok {
      await this.loadInvites()
    } else {
      this.error = result.data?.error or "Couldn't revoke that invitation."
    }
  }

onMount
  async {
    await this.load()
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="settings" />
    <SettingsSidebar active="team" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Members</h1>
      <p class="text-slate-500 text-sm mb-8">Everyone on your team sees the same servers, providers and sites.</p>

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if not loading}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">{{ teamName }}</h2>
        <p class="text-slate-500 text-sm mb-5">Your role: <span class="font-semibold text-slate-700 dark:text-slate-300">{{ role }}</span></p>

        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each m in members}}
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ m.name }}</p>
              <p class="text-slate-500 text-xs font-mono truncate">{{ m.email }}</p>
            </div>
            <div class="text-right shrink-0">
              <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">{{ m.role }}</span>
              <p class="text-slate-500 text-xs mt-1">Joined {{ m.joined }}</p>
            </div>
          </div>
{{/each}}
        </div>
      </div>

{{#if canManage}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
              <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Team name</h2>
        <p class="text-slate-500 text-sm mb-5">Shown to everyone on the team and in invitation emails.</p>

        <label for="team-name" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Name</label>
        <input id="team-name" type="text" maxlength="100" value="{{ teamName }}" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />

{{#if renameError}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ renameError }}</p>
{{/if}}

        <div class="mt-6">
{{#if renaming}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 opacity-50">Saving…</button>
{{/if}}
{{#if not renaming}}
          <button onclick="{{ rename() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">Save name</button>
{{/if}}
        </div>
      </div>
        
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Invite someone</h2>
        <p class="text-slate-500 text-sm mb-5">They get an email with a link that works once and expires in 7 days. If they already have servers or connections of their own, they'll be asked to bring them into this team.</p>

        <label for="invite-email" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Email</label>
        <input id="invite-email" type="email" autocomplete="off" placeholder="name@example.com" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20" />

        <label for="invite-role" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mt-5 mb-1.5">Role</label>
        <select id="invite-role" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20">
          <option value="member">Member</option>
          <option value="admin">Admin (can invite and manage the team)</option>
        </select>

{{#if error}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}
{{#if notice}}
        <p role="status" class="text-emerald-700 dark:text-emerald-500 text-sm mt-4">{{ notice }}</p>
{{/if}}
{{#if link}}
        <div class="rounded-xl bg-slate-950 px-4 py-3 mt-2">
          <code class="block text-emerald-400 text-xs font-mono break-all">{{ link }}</code>
        </div>
{{/if}}

        <div class="mt-6">
{{#if busy}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 opacity-50">Sending…</button>
{{/if}}
{{#if not busy}}
          <button onclick="{{ invite() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">Send invitation</button>
{{/if}}
        </div>
      </div>

{{#if invites.length is not 0}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Pending invitations</h2>
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each i in invites}}
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono truncate">{{ i.email }}</p>
              <p class="text-slate-500 text-xs">{{ i.role }} · expires {{ i.expires }}</p>
            </div>
            <button onclick="{{ revoke(i.id) }}" class="text-sm text-rose-500 hover:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-lg px-3 py-1.5 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition shrink-0">Revoke</button>
          </div>
{{/each}}
        </div>
      </div>
{{/if}}
{{/if}}
{{/if}}

    </div>
    </div>
  </div>