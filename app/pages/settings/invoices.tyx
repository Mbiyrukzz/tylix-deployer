page SettingsInvoices

title "Invoices"

needs
  Auth

state
  loading: true
  rows: []
  unpaid: 0
  error: ""

action
  badgeFor(status) {
    if status is "paid" {
      return "inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500"
    }
    if status is "failed" {
      return "inline-flex items-center rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500"
    }
    return "inline-flex items-center rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-500"
  }

  async load() {
    const result = await useApi("/api/billing/invoices")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.rows = result.data.map((i) => ({
        id: i.id,
        number: i.number,
        description: i.description,
        amountText: i.amountText,
        dateText: i.dateText,
        status: i.status,
        badge: this.badgeFor(i.status)
      }))
      this.unpaid = result.data.filter((i) => i.status is not "paid").length
    } else {
      this.error = result.data?.error or "Couldn't load invoices."
    }

    this.loading = false
  }

onMount
  async {
    await this.load()
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="settings" />
    <SettingsSidebar active="invoices" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Invoices</h1>
      <p class="text-slate-500 text-sm mb-8">What your team has been billed, and what is coming due.</p>

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if not loading}}
{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

{{#if unpaid is not 0}}
      <div role="alert" class="rounded-2xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-5 py-4 mb-6 flex items-center justify-between gap-4">
        <p class="text-amber-800 dark:text-amber-400 text-sm">You have an invoice that isn't paid yet.</p>
        <a href="/settings/billing" class="shrink-0 text-sm font-medium text-amber-800 dark:text-amber-400 hover:underline">Go to billing</a>
      </div>
{{/if}}

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
{{#if rows.length is 0}}
        <p class="text-slate-500 text-sm">No invoices yet. They appear here after your first payment.</p>
{{/if}}
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each r in rows}}
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">{{ r.number }} · {{ r.description }}</p>
              <p class="text-slate-500 text-xs">{{ r.dateText }}</p>
            </div>
            <div class="flex items-center gap-4 shrink-0">
              <span class="text-slate-700 dark:text-slate-300 text-sm font-mono">{{ r.amountText }}</span>
              <span class="{{ r.badge }}">{{ r.status }}</span>
            </div>
          </div>
{{/each}}
        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>