page SettingsBilling

title "Billing"

state
  loading: true
  enforced: false
  canManage: false
  stateName: ""
  planName: ""
  statusText: ""
  periodEnd: ""
  cancelNote: false
  rows: []
  plans: []
  error: ""
  busy: ""
  message: ""
  dueCount: 0
  dueText: ""
  currentPlanId: ""

action
  describe(limit) {
    if limit is null {
      return "Unlimited"
    }
    return String(limit)
  }

  row(label, used, limit) {
    let percent = 0
    if limit is null {
      percent = 0
    } else if limit is 0 {
      percent = 100
    } else {
      percent = Math.min(100, Math.round((used / limit) * 100))
    }

    let bar = "h-2 rounded-full bg-emerald-500"
    if limit is not null and used >= limit {
      bar = "h-2 rounded-full bg-amber-500"
    }
    if limit is not null and used > limit {
      bar = "h-2 rounded-full bg-rose-500"
    }

    return {
      label: label,
      used: used,
      limitText: this.describe(limit),
      barClass: bar,
      style: "width: " + percent + "%"
    }
  }

  planSummary(limits) {
    return this.describe(limits.members) + " members · " + this.describe(limits.servers) + " servers · " + this.describe(limits.sites) + " sites · " + this.describe(limits.providers) + " connections"
  }

  async choose(planId) {
    this.busy = planId
    this.error = ""
    this.message = ""
    const result = await useApi("/api/billing/checkout", { method: "POST", body: { plan: planId } })
    if result.ok {
      window.location.href = result.data.url
      return null
    }
    this.error = result.data?.error or "Couldn't start the payment."
    this.busy = ""
  }

  async cancelPlan() {
    this.busy = "cancel"
    this.error = ""
    const result = await useApi("/api/billing/cancel", { method: "POST" })
    if result.ok {
      this.message = "Cancelled. Your plan stays active until the period ends."
      await this.load()
    } else {
      this.error = result.data?.error or "Couldn't cancel."
    }
    this.busy = ""
  }

  async confirmReturn() {
    const ref = new URLSearchParams(window.location.search).get("reference")
    if ref {
      const result = await useApi("/api/billing/verify?reference=" + ref)
      if result.ok {
        this.message = "Payment received. Your plan is active."
      }
      window.history.replaceState({}, "", "/settings/billing")
    }
  }

    async loadInvoices() {
    const result = await useApi("/api/billing/invoices")
    if result.ok {
      const open = result.data.filter((i) => i.status is not "paid")
      this.dueCount = open.length
      if open.length > 0 {
        this.dueText = open[0].amountText + " (" + open[0].number + ")"
      }
    }
  }

  async payNow() {
    if this.currentPlanId is not "" {
      await this.choose(this.currentPlanId)
    }
  }

  async load() {
    const result = await useApi("/api/billing")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      const data = result.data
      const ent = data.entitlement
      const usage = data.usage
      const limits = ent.limits

      this.enforced = data.enforced
      this.canManage = data.can_manage
      this.stateName = ent.state
      this.planName = ent.planName
      this.statusText = ent.status
      this.periodEnd = String(ent.periodEnd).slice(0, 10)
      this.cancelNote = ent.cancelAtPeriodEnd

      this.rows = [
        this.row("Team members", usage.members, limits.members),
        this.row("Servers", usage.servers, limits.servers),
        this.row("Sites", usage.sites, limits.sites),
        this.row("Provider connections", usage.providers, limits.providers)
      ]

      this.plans = data.plans.map((p) => ({
        id: p.id,
        name: p.name,
        priceText: "$" + p.price_usd + "/month",
        summary: this.planSummary(p.limits),
        current: p.id is ent.plan and ent.status is not "trialing"
      }))
    } else {
      this.error = result.data?.error or "Couldn't load billing."
    }

    this.loading = false
  }


onMount
  async {
    await this.confirmReturn()
    await this.load()
    await this.loadInvoices()
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="settings" />
    <SettingsSidebar active="billing" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Billing</h1>
      <p class="text-slate-500 text-sm mb-8">Your team's plan and what it uses.</p>

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if not loading}}
{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}
{{#if message}}
      <p class="text-emerald-700 dark:text-emerald-500 text-sm mb-4">{{ message }}</p>
{{/if}}
{{#if dueCount is not 0}}
      <div role="alert" class="rounded-2xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-5 py-4 mb-6 flex items-center justify-between gap-4">
        <p class="text-amber-800 dark:text-amber-400 text-sm">You have an unpaid invoice: {{ dueText }}.</p>
        <div class="flex items-center gap-4 shrink-0">
          <a href="/settings/invoices" class="text-sm text-amber-800 dark:text-amber-400 hover:underline">View</a>
{{#if canManage}}
          <button onclick="{{ payNow() }}" class="rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium px-4 py-2 transition-colors">Pay now</button>
{{/if}}
        </div>
      </div>
{{/if}}

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">{{ planName }}</h2>
{{#if stateName is "active"}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> {{ statusText }}
          </span>
{{/if}}
{{#if stateName is "lapsed"}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Ended
          </span>
{{/if}}
{{#if stateName is "legacy"}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> No limits
          </span>
{{/if}}
        </div>

{{#if stateName is "legacy"}}
        <p class="text-slate-500 text-sm">Your team has no plan yet, so nothing is limited. Choose a plan below to get started.</p>
{{/if}}
{{#if stateName is "active"}}
{{#if statusText is "trialing"}}
        <p class="text-slate-500 text-sm">Free trial. It ends {{ periodEnd }}. Choose a plan below to keep adding servers and sites after that.</p>
{{/if}}
{{#if statusText is not "trialing"}}
        <p class="text-slate-500 text-sm">Current period ends {{ periodEnd }}.</p>
{{/if}}
{{/if}}
{{#if cancelNote}}
        <p class="text-amber-700 dark:text-amber-500 text-sm mt-2">This plan won't renew. It stays active until the date above.</p>
{{/if}}
{{#if stateName is "lapsed"}}
        <p class="text-rose-600 dark:text-rose-500 text-sm">Your plan has ended. Everything you have keeps running, but you can't add new servers, sites, connections or members until you renew.</p>
{{/if}}
{{#if not enforced}}
        <p class="text-slate-500 text-xs mt-3">Limits are shown but not enforced yet.</p>
{{/if}}
{{#if canManage}}
{{#if statusText is "active"}}
{{#if not cancelNote}}
{{#if busy is "cancel"}}
        <button disabled class="mt-4 text-sm text-rose-600 dark:text-rose-500 opacity-50">Cancelling…</button>
{{/if}}
{{#if busy is not "cancel"}}
        <button onclick="{{ cancelPlan() }}" class="mt-4 text-sm text-rose-600 dark:text-rose-500 hover:underline">Cancel plan</button>
{{/if}}
{{/if}}
{{/if}}
{{/if}}
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-5">Usage</h2>
        <div class="space-y-5">
{{#each r in rows}}
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-slate-700 dark:text-slate-300 text-sm font-medium">{{ r.label }}</span>
              <span class="text-slate-500 text-sm font-mono">{{ r.used }} / {{ r.limitText }}</span>
            </div>
            <div class="h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
              <div class="{{ r.barClass }}" style="{{ r.style }}"></div>
            </div>
          </div>
{{/each}}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Plans</h2>
                <p class="text-slate-500 text-xs mt-4">Prices are shown in USD. You are charged the equivalent in KES at checkout. Payments are processed by Paystack, and plans renew monthly until cancelled.</p>
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each p in plans}}
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">{{ p.name }} · {{ p.priceText }}</p>
              <p class="text-slate-500 text-xs">{{ p.summary }}</p>
            </div>
{{#if p.current}}
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500 shrink-0">Current</span>
{{/if}}
{{#if not p.current}}
{{#if canManage}}
{{#if busy is p.id}}
            <button disabled class="shrink-0 rounded-xl bg-emerald-600 text-white text-sm font-medium px-4 py-2 opacity-50">Opening…</button>
{{/if}}
{{#if busy is not p.id}}
            <button onclick="{{ choose(p.id) }}" class="shrink-0 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium px-4 py-2 transition-colors">Choose</button>
{{/if}}
{{/if}}
{{/if}}
          </div>
{{/each}}
        </div>
        <p class="text-slate-500 text-xs mt-4">Payments are processed by Paystack. Plans renew monthly until cancelled.</p>
      </div>
{{/if}}

    </div>
    </div>
  </div>