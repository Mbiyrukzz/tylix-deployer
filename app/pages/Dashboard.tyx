page Dashboard

import { IconDatabase, IconUser, IconFolder, IconMail, IconCloud, IconCube, IconExclamationTriangle } from "tylix-icons"

title "Dashboard"

needs
  Auth

uses
  Servers
  Provisions
  Providers
  Registrars
  Mail
  Billing
  Insights

background
  Mail
  Billing

meta
  transition "fade"

state
  checkedAuth: false
  greeting: ""
  todayText: ""
  fleet: []
  recentSites: []
  baseAttention: []
  domainItems: []
  attention: []
  hasAttention: false
  newSiteHref: "/servers"
  onlineCount: 0
  offlineCount: 0
  pendingCount: 0
  totalServers: 0
  siteCount: 0
  readyCount: 0
  buildingCount: 0
  failedCount: 0
  healthState: "empty"
  healthText: ""
  sOnDash: "0 226.2"
  sOnOff: "0"
  sOffDash: "0 226.2"
  sOffOff: "0"
  sPenDash: "0 226.2"
  sPenOff: "0"
  readyStyle: "width: 0%"
  buildStyle: "width: 0%"
  failStyle: "width: 0%"
  stepsDone: 0
  setupDone: false
  progressStyle: "width: 0%"
  step1: false
  step2: false
  step3: false
  cloudReady: false
  providerCount: 0
  providerCards: []
  domainsReady: false
  registrarCount: 0
  registrarCards: []
  domainCount: 0
  domainsShown: []
  expiringCount: 0
  expiredCount: 0
  showAllDomains: false
  teamReady: false
  teamCount: 0
  teamStaff: 0
  teamMembers: []

action
  plural(n, word) {
    if n is 1 {
      return "1 " + word
    }
    return n + " " + word + "s"
  }

  typeLabel(t) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["fastapi", "FastAPI"],
      ["django", "Django"],
      ["java", "Java"],
      ["go", "Go"],
      ["ruby", "Ruby"],
      ["dotnet", ".NET"],
      ["rust", "Rust"],
      ["static", "Static"]
    ]
    const hit = labels.find((l) => l[0] is t)
    return hit ? hit[1] : t
  }

  siteHref(id) {
    return "/servers/site-detail?id=" + id
  }

  // Length of one donut segment, out of a ring that is 226.2 long.
  arcDash(v, total) {
    if total is 0 {
      return "0 226.2"
    }
    return (Math.round(v / total * 2262) / 10) + " 226.2"
  }

  // Where a segment starts: minus everything drawn before it.
  arcOffset(v, total) {
    if total is 0 {
      return "0"
    }
    return "-" + (Math.round(v / total * 2262) / 10)
  }

  rowsOf(res) {
    if res.ok and Array.isArray(res.data) {
      return res.data
    }
    return []
  }

  // Like rowsOf, but also accepts { domains: [...] }.
  listOf(res) {
    if not res.ok {
      return []
    }
    if Array.isArray(res.data) {
      return res.data
    }
    if res.data and Array.isArray(res.data.domains) {
      return res.data.domains
    }
    return []
  }

  // Flips the domain list between 5 rows and all rows.
  toggleDomains() {
    this.showAllDomains = this.showAllDomains ? false : true
  }

  decorateServer(s, sites) {
    const n = sites.filter((x) => x.server_id is s.id).length
    return Object.assign({}, s, {
      href: "/servers/server-detail?id=" + s.id,
      siteLabel: this.plural(n, "site")
    })
  }

  decorateSite(site, servers) {
    const host = servers.find((x) => x.id is site.server_id)
    return Object.assign({}, site, {
      href: this.siteHref(site.id),
      typeText: this.typeLabel(site.type),
      serverName: host ? host.name : "Unknown server"
    })
  }

  kindStyle(kind) {
    let name = "Linode (Akamai)"
    let letter = "L"
    let cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-brand-500/10 text-brand-700 dark:text-brand-500"

    if kind is "hetzner" {
      name = "Hetzner Cloud"
      letter = "H"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    if kind is "digitalocean" {
      name = "DigitalOcean"
      letter = "D"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    if kind is "vultr" {
      name = "Vultr"
      letter = "V"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    if kind is "aws" {
      name = "Amazon Web Services"
      letter = "A"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400"
    }
    if kind is "upcloud" {
      name = "UpCloud"
      letter = "U"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400"
    }

    return { name: name, letter: letter, cls: cls }
  }

  // Merges server and domain attention items into the list the page shows.
  rebuildAttention() {
    const all = this.baseAttention.concat(this.domainItems)
    this.attention = all.slice(0, 8)
    this.hasAttention = all.length > 0
  }

  // Provider cards come from the shared stores. No extra requests.
  async loadProviders() {
    await Promise.all([Providers.load(), Provisions.load()])

    const provRows = Provisions.data
    this.providerCount = Providers.data.length
    this.providerCards = Providers.data.map((p) => this.decorateProvider(p, provRows))
    this.cloudReady = true
  }

  decorateProvider(p, provRows) {
    const style = this.kindStyle(p.kind)
    const created = provRows.filter((r) => r.provider_id is p.id and r.has_instance and r.status is not "deleted").length

    return {
      id: p.id,
      label: p.label,
      kindName: style.name,
      tileLetter: style.letter,
      tileClass: style.cls,
      href: "/providers/provider-detail?id=" + p.id,
      createdText: this.plural(created, "server") + " created here"
    }
  }

  registrarName(kind) {
    const names = [
      ["porkbun", "Porkbun"],
      ["cloudflare", "Cloudflare"],
      ["godaddy", "GoDaddy"],
      ["namecheap", "Namecheap"],
      ["namecom", "Name.com"],
      ["name_com", "Name.com"],
      ["dynadot", "Dynadot"],
      ["route53", "Route 53"],
      ["spaceship", "Spaceship"]
    ]
    const hit = names.find((n) => n[0] is kind)
    return hit ? hit[1] : kind
  }

  registrarTile(i) {
    const base = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold "
    const tones = [
      "bg-brand-500/10 text-brand-700 dark:text-brand-500",
      "bg-sky-500/10 text-sky-600 dark:text-sky-400",
      "bg-violet-500/10 text-violet-600 dark:text-violet-400",
      "bg-amber-500/10 text-amber-600 dark:text-amber-400",
      "bg-rose-500/10 text-rose-600 dark:text-rose-400"
    ]
    return base + tones[i % tones.length]
  }

  daysUntil(raw) {
    if not raw {
      return null
    }
    const t = new Date(raw).getTime()
    if Number.isNaN(t) {
      return null
    }
    return Math.ceil((t - Date.now()) / 86400000)
  }

  // One domain row. A domain with no readable expiry date sorts last.
  decorateDomain(d, registrarLabel) {
    const name = d.name or d.domain or d.domain_name or ""
    const raw = d.expires_at or d.expires or d.expiry or d.expiration_date or d.expiresAt or ""
    const days = this.daysUntil(raw)

    let sortDays = 99999
    let label = "Active"
    let dayText = "-"
    let note = ""
    let badge = "bg-zinc-500/10 text-zinc-600 dark:text-zinc-400"

    if days is not null {
      sortDays = days
      if days < 0 {
        label = "Expired"
        dayText = "Expired " + Math.abs(days) + "d ago"
        note = "expired " + Math.abs(days) + " days ago"
        badge = "bg-rose-500/10 text-rose-600 dark:text-rose-500"
      } else if days <= 30 {
        label = "Expiring"
        dayText = days + " days left"
        note = "expires in " + this.plural(days, "day")
        badge = "bg-yellow-400/10 text-yellow-600 dark:text-yellow-400"
      } else {
        dayText = days + " days left"
        badge = "bg-brand-500/10 text-brand-600 dark:text-brand-500"
      }
    } else {
      label = "No expiry data"
    }

    return {
      name: name,
      registrar: registrarLabel,
      expiresText: raw ? String(raw).slice(0, 10) : "-",
      days: sortDays,
      dayText: dayText,
      label: label,
      note: note,
      badge: badge,
      href: "/registrars"
    }
  }

  async loadRegistrar(r) {
    const res = await useApi("/api/registrars/" + r.id + "/domains")
    return { registrar: r, res: res }
  }

  // One registrar card plus its decorated domain rows.
  registrarPart(l, i) {
    const r = l.registrar
    const name = r.label or this.registrarName(r.kind)
    const rows = this.listOf(l.res).map((d) => this.decorateDomain(d, name)).filter((d) => d.name is not "")

    return {
      card: {
        id: r.id,
        label: name,
        tileLetter: String(name).charAt(0).toUpperCase(),
        tileClass: this.registrarTile(i),
        href: "/registrars",
        countText: this.plural(rows.length, "domain"),
        failed: not l.res.ok,
        expiring: rows.filter((d) => d.days <= 30).length
      },
      rows: rows
    }
  }

  // The registrar list comes from the Registrars capability.
  // Only the per-registrar domain lookups still call the API directly.
  async loadDomains() {
    await Registrars.load()
    const list = Registrars.data
    this.registrarCount = list.length

    if list.length is 0 {
      this.domainsReady = true
      return null
    }

    const loaded = await Promise.all(list.map((r) => this.loadRegistrar(r)))
    const parts = loaded.map((l, i) => this.registrarPart(l, i))
    const rows = parts.reduce((acc, p) => acc.concat(p.rows), [])
    rows.sort((a, b) => a.days - b.days)

    this.registrarCards = parts.map((p) => p.card)
    this.domainCount = rows.length
    this.domainsShown = rows.slice(0, 8)
    this.expiredCount = rows.filter((d) => d.days < 0).length
    this.expiringCount = rows.filter((d) => d.days >= 0 and d.days <= 30).length
    this.domainItems = rows
      .filter((d) => d.days <= 30)
      .slice(0, 4)
      .map((d) => ({ text: d.name + " " + d.note, hint: "Renew it at " + d.registrar, href: d.href }))
    this.rebuildAttention()
    this.domainsReady = true
  }

  initial(m) {
    const source = m.name or m.email or "?"
    return String(source).charAt(0).toUpperCase()
  }

  roleText(role) {
    const r = String(role or "member")
    return r.charAt(0).toUpperCase() + r.slice(1)
  }

  async loadTeam() {
    const res = await useApi("/api/team/members")

    if res.ok and res.data and Array.isArray(res.data.members) {
      const members = res.data.members.map((m) => Object.assign({}, m, {
        initial: this.initial(m),
        roleLabel: this.roleText(m.role)
      }))
      this.teamCount = members.length
      this.teamStaff = members.filter((m) => m.role is "owner" or m.role is "admin").length
      this.teamMembers = members.slice(0, 6)
    }

    this.teamReady = true
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const now = new Date()
    this.todayText = now.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" })

    const hour = now.getHours()
    let greeting = "Good evening"
    if hour < 12 {
      greeting = "Good morning"
    } else if hour < 18 {
      greeting = "Good afternoon"
    }
    this.greeting = greeting

    const serversLoad = Servers.load()
    const sitesRes = await useApi("/api/sites")
    await serversLoad

    const list = Servers.data
    let sites = []
    if sitesRes.ok and Array.isArray(sitesRes.data) {
      sites = sitesRes.data
    }

    const total = list.length
    const online = list.filter((s) => s.status is "online").length
    const offline = list.filter((s) => s.status is "offline").length
    const pending = list.filter((s) => s.status is "pending").length

    const ready = sites.filter((x) => x.status is "ready").length
    const failed = sites.filter((x) => x.status is "failed").length
    const building = sites.filter((x) => x.status is "creating" or x.status is "pending").length

    this.totalServers = total
    this.onlineCount = online
    this.offlineCount = offline
    this.pendingCount = pending
    this.siteCount = sites.length
    this.readyCount = ready
    this.failedCount = failed
    this.buildingCount = building

    if total is 1 {
      this.newSiteHref = "/servers/server-sites?id=" + list[0].id
    } else {
      this.newSiteHref = "/servers"
    }

    this.fleet = list.map((s) => this.decorateServer(s, sites))

    Insights.analyze(list, sites)

    const sorted = sites.slice().sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
    this.recentSites = sorted.slice(0, 5).map((x) => this.decorateSite(x, list))

    const offlineItems = list
      .filter((s) => s.status is "offline")
      .map((s) => ({ text: s.name + " is offline", hint: "Check connectivity", href: "/servers/server-detail?id=" + s.id }))
    const failedItems = sites
      .filter((x) => x.status is "failed")
      .map((x) => ({ text: x.domain + " failed to deploy", hint: "View the deployment log", href: this.siteHref(x.id) }))

    this.baseAttention = offlineItems.concat(failedItems)
    this.rebuildAttention()

    if total is 0 {
      this.healthState = "empty"
      this.healthText = "No servers connected yet"
    } else if offline + failed > 0 {
      this.healthState = "warn"
      this.healthText = this.plural(offline + failed, "issue") + " need attention"
    } else {
      this.healthState = "ok"
      this.healthText = "All systems operational"
    }

    this.sOnDash = this.arcDash(online, total)
    this.sOnOff = this.arcOffset(0, total)
    this.sOffDash = this.arcDash(offline, total)
    this.sOffOff = this.arcOffset(online, total)
    this.sPenDash = this.arcDash(pending, total)
    this.sPenOff = this.arcOffset(online + offline, total)

    if sites.length > 0 {
      this.readyStyle = "width: " + Math.round(ready / sites.length * 100) + "%"
      this.buildStyle = "width: " + Math.round(building / sites.length * 100) + "%"
      this.failStyle = "width: " + Math.round(failed / sites.length * 100) + "%"
    }

    this.step1 = total > 0
    this.step2 = sites.length > 0
    this.step3 = ready > 0

    let done = 0
    if this.step1 {
      done = done + 1
    }
    if this.step2 {
      done = done + 1
    }
    if this.step3 {
      done = done + 1
    }
    this.stepsDone = done
    this.setupDone = done is 3
    this.progressStyle = "width: " + Math.round((done / 3) * 100) + "%"

    this.checkedAuth = true

    // These fill in after the page is already on screen.
    this.loadProviders()
    this.loadDomains()
    this.loadTeam()
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-page transition-colors">

    <Sidebar active="overview" />

    <div class="min-w-0 px-4 sm:px-6 lg:px-10 py-6 sm:py-10">
    <div class="max-w-7xl mx-auto">

      <LockedBanner />

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-6">
        <div class="min-w-0">
          <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.2em] mb-3 truncate">{{ todayText }}</p>
          <h1 class="text-3xl sm:text-5xl font-semibold uppercase tracking-tight leading-[1.05] text-zinc-900 dark:text-zinc-100 break-words">
            {{ greeting }},
            <br class="hidden sm:block" />
            <span class="text-brand-500">{{ Auth.user.name }}</span>
          </h1>
          <div class="mt-4 inline-flex items-center gap-2.5 rounded-full border border-stone-200 dark:border-white/10 bg-white dark:bg-white/[0.03] px-3.5 py-1.5">
{{#if healthState is "ok"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-brand-500"></span>
{{/if}}
{{#if healthState is "warn"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-yellow-400"></span>
{{/if}}
{{#if healthState is "empty"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-zinc-400"></span>
{{/if}}
            <span class="text-zinc-700 dark:text-zinc-300 text-sm font-medium">{{ healthText }}</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2.5 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            New server
          </button>
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2.5 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            New site
          </button>
{{/if}}
{{#if not Billing.locked}}
          <a href="/servers" class="inline-flex text-sm text-zinc-700 dark:text-zinc-200 border border-stone-300 dark:border-white/15 rounded-full px-5 py-2.5 hover:bg-white dark:hover:bg-white/5 transition-colors">
            New server
          </a>
          <a href="{{ newSiteHref }}" class="inline-flex text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2.5 hover:bg-brand-400 transition-colors">
            New site
          </a>
{{/if}}
        </div>
      </div>

{{#if hasAttention}}
      <div class="rounded-3xl border border-line bg-panel overflow-hidden mb-4">
        <div class="flex items-center justify-between gap-3 px-5 sm:px-6 py-4">
          <h2 class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
            <IconExclamationTriangle class="w-4 h-4 text-yellow-400" /> Needs attention
          </h2>
          <span class="text-zinc-500 text-xs hidden sm:inline">Things that stopped working or expire soon</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
{{#each item in attention}}
          <a href="{{ item.href }}" class="flex items-center justify-between gap-4 px-5 sm:px-6 py-3.5 border-t border-stone-100 dark:border-white/5 border-l-2 border-l-yellow-400 hover:bg-stone-50 dark:hover:bg-white/[0.03] transition-colors">
            <div class="min-w-0">
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ item.text }}</p>
              <p class="text-zinc-500 text-xs mt-0.5 truncate">{{ item.hint }}</p>
            </div>
            <span class="text-zinc-400 text-sm shrink-0">&rarr;</span>
          </a>
{{/each}}
        </div>
      </div>
{{/if}}

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-4 mb-4">

        <div class="relative overflow-hidden xl:col-span-8 rounded-3xl border border-line bg-panel p-5 sm:p-7">
          <svg class="pointer-events-none absolute inset-0 w-full h-full text-zinc-400/25 dark:text-white/[0.07]" aria-hidden="true">
            <defs>
              <pattern id="flowdots" width="22" height="22" patternUnits="userSpaceOnUse">
                <circle cx="1" cy="1" r="1" fill="currentColor" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#flowdots)" />
          </svg>

          <div class="relative">
            <div class="flex items-start justify-between gap-4 mb-6">
              <div class="min-w-0">
                <h2 class="text-3xl sm:text-4xl font-light uppercase tracking-wide leading-[1.05] text-zinc-900 dark:text-zinc-100">Fleet<br />flow</h2>
                <p class="text-zinc-500 text-xs mt-3">Where your servers are put to work.</p>
              </div>
{{#if Billing.locked}}
              <button disabled title="Pay to continue" class="shrink-0 inline-flex items-center gap-2 text-xs bg-stone-100 dark:bg-white/5 text-zinc-400 border border-stone-200 dark:border-white/10 rounded-full px-4 py-2 cursor-not-allowed select-none">
                Add server
              </button>
{{/if}}
{{#if not Billing.locked}}
              <a href="/servers" class="shrink-0 inline-flex items-center gap-2 text-xs text-zinc-700 dark:text-zinc-200 bg-stone-100 dark:bg-white/5 border border-stone-200 dark:border-white/10 rounded-full px-4 py-2 hover:bg-stone-200 dark:hover:bg-white/10 transition-colors">
                Add server <span class="text-brand-500">+</span>
              </a>
{{/if}}
            </div>

            <div class="flex flex-col md:flex-row md:items-stretch">

              <div class="flex items-center mb-4 md:mb-0 md:h-[288px] md:w-48 shrink-0">
                <div class="flex items-stretch h-16 w-full rounded-xl overflow-hidden">
                  <div class="flex-1 min-w-0 bg-zinc-200 dark:bg-zinc-800 px-4 flex flex-col justify-center">
                    <p class="text-[11px] uppercase tracking-widest text-zinc-500">Servers</p>
                    <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 truncate">{{ totalServers }} connected</p>
                  </div>
                  <div class="w-16 shrink-0 bg-brand-500 flex items-center justify-center text-white">
                    <IconDatabase class="w-6 h-6" />
                  </div>
                </div>
              </div>

              <svg viewBox="0 0 200 288" preserveAspectRatio="none" class="hidden md:block flex-1 min-w-0 h-[288px]" aria-hidden="true">
                <path vector-effect="non-scaling-stroke" fill="none" d="M0 144 C 100 144, 100 36, 200 36" stroke-width="{{ siteCount is 0 ? 3 : 10 }}" class="{{ siteCount is 0 ? 'stroke-zinc-300 dark:stroke-zinc-700' : 'stroke-brand-500' }}" />
                <path vector-effect="non-scaling-stroke" fill="none" d="M0 144 C 100 144, 100 108, 200 108" stroke-width="{{ domainCount is 0 ? 3 : 10 }}" class="{{ domainCount is 0 ? 'stroke-zinc-300 dark:stroke-zinc-700' : 'stroke-brand-500' }}" />
                <path vector-effect="non-scaling-stroke" fill="none" d="M0 144 C 100 144, 100 180, 200 180" stroke-width="{{ providerCount is 0 ? 3 : 10 }}" class="{{ providerCount is 0 ? 'stroke-zinc-300 dark:stroke-zinc-700' : 'stroke-brand-500' }}" />
                <path vector-effect="non-scaling-stroke" fill="none" d="M0 144 C 100 144, 100 252, 200 252" stroke-width="{{ teamCount is 0 ? 3 : 10 }}" class="{{ teamCount is 0 ? 'stroke-zinc-300 dark:stroke-zinc-700' : 'stroke-brand-500' }}" />
              </svg>

              <div class="md:w-56 shrink-0 space-y-2 md:space-y-0">

                <a href="/servers" class="flex items-center justify-between gap-3 md:h-[72px] py-3 md:py-0 pl-4 pr-1 border-l-2 {{ siteCount is 0 ? 'border-zinc-300 dark:border-zinc-700' : 'border-brand-500' }}">
                  <div class="min-w-0">
                    <p class="text-[11px] text-zinc-500">Sites</p>
                    <p class="text-sm font-semibold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">{{ siteCount }} total</p>
                    <p class="text-[11px] text-zinc-500">{{ readyCount }} live</p>
                  </div>
                  <span class="flex h-6 w-11 shrink-0 items-center justify-center rounded-full {{ siteCount is 0 ? 'bg-zinc-300 dark:bg-zinc-700' : 'bg-brand-500' }}">
                    <span class="h-0.5 w-3.5 rounded-full {{ siteCount is 0 ? 'bg-zinc-500 dark:bg-zinc-400' : 'bg-white' }}"></span>
                  </span>
                </a>

                <a href="/registrars" class="flex items-center justify-between gap-3 md:h-[72px] py-3 md:py-0 pl-4 pr-1 border-l-2 {{ domainCount is 0 ? 'border-zinc-300 dark:border-zinc-700' : 'border-brand-500' }}">
                  <div class="min-w-0">
                    <p class="text-[11px] text-zinc-500">Domains</p>
                    <p class="text-sm font-semibold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">{{ domainCount }} total</p>
                    <p class="text-[11px] text-zinc-500">{{ expiringCount }} expiring</p>
                  </div>
                  <span class="flex h-6 w-11 shrink-0 items-center justify-center rounded-full {{ domainCount is 0 ? 'bg-zinc-300 dark:bg-zinc-700' : 'bg-brand-500' }}">
                    <span class="h-0.5 w-3.5 rounded-full {{ domainCount is 0 ? 'bg-zinc-500 dark:bg-zinc-400' : 'bg-white' }}"></span>
                  </span>
                </a>

                <a href="/providers" class="flex items-center justify-between gap-3 md:h-[72px] py-3 md:py-0 pl-4 pr-1 border-l-2 {{ providerCount is 0 ? 'border-zinc-300 dark:border-zinc-700' : 'border-brand-500' }}">
                  <div class="min-w-0">
                    <p class="text-[11px] text-zinc-500">Cloud providers</p>
                    <p class="text-sm font-semibold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">{{ providerCount }} connected</p>
                    <p class="text-[11px] text-zinc-500">{{ registrarCount }} registrars</p>
                  </div>
                  <span class="flex h-6 w-11 shrink-0 items-center justify-center rounded-full {{ providerCount is 0 ? 'bg-zinc-300 dark:bg-zinc-700' : 'bg-brand-500' }}">
                    <span class="h-0.5 w-3.5 rounded-full {{ providerCount is 0 ? 'bg-zinc-500 dark:bg-zinc-400' : 'bg-white' }}"></span>
                  </span>
                </a>

                <a href="/team" class="flex items-center justify-between gap-3 md:h-[72px] py-3 md:py-0 pl-4 pr-1 border-l-2 {{ teamCount is 0 ? 'border-zinc-300 dark:border-zinc-700' : 'border-brand-500' }}">
                  <div class="min-w-0">
                    <p class="text-[11px] text-zinc-500">Team</p>
                    <p class="text-sm font-semibold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">{{ teamCount }} members</p>
                    <p class="text-[11px] text-zinc-500">{{ teamStaff }} owner or admin</p>
                  </div>
                  <span class="flex h-6 w-11 shrink-0 items-center justify-center rounded-full {{ teamCount is 0 ? 'bg-zinc-300 dark:bg-zinc-700' : 'bg-brand-500' }}">
                    <span class="h-0.5 w-3.5 rounded-full {{ teamCount is 0 ? 'bg-zinc-500 dark:bg-zinc-400' : 'bg-white' }}"></span>
                  </span>
                </a>

              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-line flex flex-wrap items-center gap-x-8 gap-y-3">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-light tracking-tight text-zinc-900 dark:text-zinc-100">{{ onlineCount }}</span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Servers online</span>
              </div>
              <div class="hidden sm:block w-px h-8 bg-stone-200 dark:bg-white/[0.08]"></div>
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-light tracking-tight text-zinc-900 dark:text-zinc-100">{{ readyCount }}</span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Sites live</span>
              </div>
              <p class="text-xs text-zinc-500 sm:ml-auto">{{ healthText }}</p>
            </div>
          </div>
        </div>

        <div class="xl:col-span-4 rounded-3xl border border-line bg-panel p-5 sm:p-7 flex flex-col">
          <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100 text-center">Fleet status</h2>

          <div class="relative w-44 h-44 mx-auto my-6">
            <svg viewBox="0 0 100 100" class="w-44 h-44">
              <circle cx="50" cy="50" r="36" fill="none" stroke="#71717a" stroke-opacity="0.2" stroke-width="10" />
              <circle cx="50" cy="50" r="36" fill="none" stroke="#f97316" stroke-width="10" stroke-dasharray="{{ sOnDash }}" stroke-dashoffset="{{ sOnOff }}" transform="rotate(-90 50 50)" />
              <circle cx="50" cy="50" r="36" fill="none" stroke="#f43f5e" stroke-width="10" stroke-dasharray="{{ sOffDash }}" stroke-dashoffset="{{ sOffOff }}" transform="rotate(-90 50 50)" />
              <circle cx="50" cy="50" r="36" fill="none" stroke="#facc15" stroke-width="10" stroke-dasharray="{{ sPenDash }}" stroke-dashoffset="{{ sPenOff }}" transform="rotate(-90 50 50)" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-4xl font-light text-zinc-900 dark:text-zinc-100">{{ totalServers }}</span>
              <span class="text-[10px] font-semibold uppercase tracking-widest text-zinc-500">servers</span>
            </div>
          </div>

          <div class="space-y-2.5 mt-auto">
            <div class="flex items-center justify-between rounded-xl bg-stone-50 dark:bg-white/[0.03] px-4 py-2.5 text-xs">
              <span class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-300"><span class="w-2 h-2 rounded-full bg-brand-500"></span> Online</span>
              <span class="font-mono text-zinc-900 dark:text-zinc-100">{{ onlineCount }}</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-stone-50 dark:bg-white/[0.03] px-4 py-2.5 text-xs">
              <span class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-300"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Offline</span>
              <span class="font-mono text-zinc-900 dark:text-zinc-100">{{ offlineCount }}</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-stone-50 dark:bg-white/[0.03] px-4 py-2.5 text-xs">
              <span class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-300"><span class="w-2 h-2 rounded-full bg-yellow-400"></span> Untested</span>
              <span class="font-mono text-zinc-900 dark:text-zinc-100">{{ pendingCount }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-4 mb-4">

        <div class="xl:col-span-4 rounded-3xl border border-line bg-panel p-5 sm:p-7">
          <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-5">Details</h2>

          <div class="grid grid-cols-2 gap-3">

            <div class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Online</p>
                  <p class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mt-1">{{ onlineCount }}<span class="text-zinc-500 text-xs font-normal"> / {{ totalServers }}</span></p>
                </div>
                <IconDatabase class="w-4 h-4 text-zinc-500 shrink-0 mt-0.5" />
              </div>
            </div>

            <div class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Sites live</p>
                  <p class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mt-1">{{ readyCount }}<span class="text-zinc-500 text-xs font-normal"> / {{ siteCount }}</span></p>
                </div>
                <IconFolder class="w-4 h-4 text-zinc-500 shrink-0 mt-0.5" />
              </div>
            </div>

            <div class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Building</p>
                  <p class="text-lg font-semibold text-yellow-600 dark:text-yellow-400 mt-1">{{ buildingCount }}</p>
                </div>
                <span class="w-2 h-2 rounded-full bg-yellow-400 shrink-0 mt-2"></span>
              </div>
            </div>

            <div class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Failed</p>
                  <p class="text-lg font-semibold text-rose-600 dark:text-rose-500 mt-1">{{ failedCount }}</p>
                </div>
                <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0 mt-2"></span>
              </div>
            </div>

            <a href="/registrars" class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4 hover:bg-stone-100 dark:hover:bg-white/[0.06] transition-colors">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Expiring domains</p>
                  <p class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mt-1">{{ expiringCount }}<span class="text-zinc-500 text-xs font-normal"> · {{ expiredCount }} expired</span></p>
                </div>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4 text-zinc-500 shrink-0 mt-0.5">
                  <circle cx="10" cy="10" r="7.5" />
                  <path d="M2.5 10h15M10 2.5c2.2 2.2 3.2 4.7 3.2 7.5S12.2 15.3 10 17.5C7.8 15.3 6.8 12.8 6.8 10S7.8 4.7 10 2.5z" stroke-linejoin="round" />
                </svg>
              </div>
            </a>

{{#if Mail.available}}
            <a href="/dashboard/mail" class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4 hover:bg-stone-100 dark:hover:bg-white/[0.06] transition-colors">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Unread mail</p>
                  <p class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mt-1">{{ Mail.unread }}</p>
                </div>
                <IconMail class="w-4 h-4 text-zinc-500 shrink-0 mt-0.5" />
              </div>
            </a>
{{/if}}
{{#if not Mail.available}}
            <div class="rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-[11px] text-zinc-500">Signed in</p>
                  <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mt-1 truncate">{{ Auth.user.name }}</p>
                </div>
                <IconUser class="w-4 h-4 text-zinc-500 shrink-0 mt-0.5" />
              </div>
            </div>
{{/if}}

          </div>
        </div>

        <div class="xl:col-span-8 rounded-3xl border border-line bg-panel overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-5 sm:px-6 pt-5 pb-4">
            <div class="min-w-0">
              <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Servers</h2>
              <p class="text-zinc-500 text-xs mt-1">{{ totalServers }} connected</p>
            </div>
            <a href="/servers" class="text-brand-600 dark:text-brand-500 text-sm hover:underline shrink-0">Manage all</a>
          </div>

          <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_100px_110px] gap-4 px-6 py-2 border-t border-stone-100 dark:border-white/5 bg-stone-50 dark:bg-white/[0.02] text-[11px] font-medium uppercase tracking-wider text-zinc-500">
            <span>Server</span>
            <span>Sites</span>
            <span>Status</span>
          </div>

{{#if not Servers.loading}}
{{#if Servers.data.length is 0}}
          <div class="px-6 py-12 text-center border-t border-stone-100 dark:border-white/5">
            <h3 class="text-zinc-900 dark:text-zinc-100 font-medium mb-1.5">No servers yet</h3>
            <p class="text-zinc-500 text-sm max-w-sm mx-auto mb-5">
              Provision a server at one of your cloud providers or connect your own over SSH, then start deploying to it.
            </p>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Add your first server
            </button>
{{/if}}
{{#if not Billing.locked}}
            <a href="/servers" class="inline-flex items-center text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2 hover:bg-brand-400 transition-colors">
              Add your first server
            </a>
{{/if}}
          </div>
{{/if}}
{{/if}}

{{#each s in fleet}}
          <a href="{{ s.href }}" class="grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[minmax(0,1fr)_100px_110px] items-center gap-4 px-5 sm:px-6 py-3.5 border-t border-stone-100 dark:border-white/5 hover:bg-stone-50 dark:hover:bg-white/[0.03] transition-colors">
            <div class="min-w-0">
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ s.name }}</p>
              <p class="text-zinc-500 text-xs font-mono truncate">{{ s.ssh_user }}@{{ s.host }}:{{ s.port }}</p>
            </div>
            <span class="hidden sm:inline text-sm text-zinc-600 dark:text-zinc-400">{{ s.siteLabel }}</span>
            <div>
{{#if s.status is "online"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-brand-600 dark:text-brand-500"><span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>Online</span>
{{/if}}
{{#if s.status is "offline"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-rose-600 dark:text-rose-500"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Offline</span>
{{/if}}
{{#if s.status is "pending"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-yellow-600 dark:text-yellow-400"><span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>Not tested</span>
{{/if}}
            </div>
          </a>
{{/each}}
        </div>
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-4 mb-4">

        <div class="xl:col-span-8 rounded-3xl border border-line bg-panel overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-5 sm:px-6 pt-5 pb-4">
            <div class="min-w-0">
              <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Recent sites</h2>
              <p class="text-zinc-500 text-xs mt-1">{{ siteCount }} total · latest deployments</p>
            </div>
          </div>

{{#if siteCount is not 0}}
          <div class="px-5 sm:px-6 pb-4">
            <div class="flex h-1.5 rounded-full bg-stone-200 dark:bg-white/10 overflow-hidden">
              <div class="h-full bg-brand-500 transition-all" style="{{ readyStyle }}"></div>
              <div class="h-full bg-yellow-400 transition-all" style="{{ buildStyle }}"></div>
              <div class="h-full bg-rose-500 transition-all" style="{{ failStyle }}"></div>
            </div>
            <p class="text-zinc-500 text-xs mt-2">{{ readyCount }} live · {{ buildingCount }} building · {{ failedCount }} failed</p>
          </div>
{{/if}}

          <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_160px_110px] gap-4 px-6 py-2 border-t border-stone-100 dark:border-white/5 bg-stone-50 dark:bg-white/[0.02] text-[11px] font-medium uppercase tracking-wider text-zinc-500">
            <span>Site</span>
            <span>Server</span>
            <span>Status</span>
          </div>

{{#if siteCount is 0}}
          <div class="px-6 py-12 text-center border-t border-stone-100 dark:border-white/5">
            <h3 class="text-zinc-900 dark:text-zinc-100 font-medium mb-1.5">Nothing deployed yet</h3>
            <p class="text-zinc-500 text-sm max-w-sm mx-auto mb-5">
              Sites are created on a server. Pick a server, then choose a framework and a repository.
            </p>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Create a site
            </button>
{{/if}}
{{#if not Billing.locked}}
{{#if totalServers is 0}}
            <a href="/servers" class="inline-flex items-center text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2 hover:bg-brand-400 transition-colors">
              Add a server first
            </a>
{{/if}}
{{#if totalServers is not 0}}
            <a href="{{ newSiteHref }}" class="inline-flex items-center text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2 hover:bg-brand-400 transition-colors">
              Create a site
            </a>
{{/if}}
{{/if}}
          </div>
{{/if}}

{{#each site in recentSites}}
          <a href="{{ site.href }}" class="grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[minmax(0,1fr)_160px_110px] items-center gap-4 px-5 sm:px-6 py-3.5 border-t border-stone-100 dark:border-white/5 hover:bg-stone-50 dark:hover:bg-white/[0.03] transition-colors">
            <div class="min-w-0">
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ site.domain }}</p>
              <p class="text-zinc-500 text-xs truncate">{{ site.typeText }}<span class="sm:hidden"> · {{ site.serverName }}</span></p>
            </div>
            <span class="hidden sm:inline text-sm text-zinc-600 dark:text-zinc-400 truncate">{{ site.serverName }}</span>
            <div>
{{#if site.status is "ready"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-brand-600 dark:text-brand-500"><span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>Ready</span>
{{/if}}
{{#if site.status is "failed"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-rose-600 dark:text-rose-500"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Failed</span>
{{/if}}
{{#if site.status is "creating"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-yellow-600 dark:text-yellow-400"><span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>Creating</span>
{{/if}}
{{#if site.status is "pending"}}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-yellow-600 dark:text-yellow-400"><span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>Queued</span>
{{/if}}
            </div>
          </a>
{{/each}}
        </div>

        <div class="xl:col-span-4 space-y-4 min-w-0">

{{#if not setupDone}}
          <div class="rounded-3xl border border-line bg-panel p-5 sm:p-7">
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Get deployed</h2>
              <span class="text-xs font-mono text-zinc-500">{{ stepsDone }}/3</span>
            </div>
            <p class="text-zinc-500 text-xs mb-4">Three steps to your first live site.</p>
            <div class="h-1.5 rounded-full bg-stone-200 dark:bg-white/10 mb-5 overflow-hidden">
              <div class="h-full rounded-full bg-brand-500 transition-all" style="{{ progressStyle }}"></div>
            </div>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
{{#if step1}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full bg-brand-500 text-white text-[11px] flex items-center justify-center">✓</span>
{{/if}}
{{#if not step1}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full border border-stone-300 dark:border-white/20 text-zinc-500 text-[11px] flex items-center justify-center">1</span>
{{/if}}
                <div>
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">Connect a server</p>
{{#if Billing.locked}}
                  <p class="text-zinc-400 text-xs">View only. Pay to continue.</p>
{{/if}}
{{#if not Billing.locked}}
                  <a href="/servers" class="text-brand-600 dark:text-brand-500 text-xs hover:underline">Add or provision a server</a>
{{/if}}
                </div>
              </div>

              <div class="flex items-start gap-3">
{{#if step2}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full bg-brand-500 text-white text-[11px] flex items-center justify-center">✓</span>
{{/if}}
{{#if not step2}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full border border-stone-300 dark:border-white/20 text-zinc-500 text-[11px] flex items-center justify-center">2</span>
{{/if}}
                <div>
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">Create a site</p>
{{#if Billing.locked}}
                  <p class="text-zinc-400 text-xs">View only. Pay to continue.</p>
{{/if}}
{{#if not Billing.locked}}
                  <a href="{{ newSiteHref }}" class="text-brand-600 dark:text-brand-500 text-xs hover:underline">Pick a framework and repo</a>
{{/if}}
                </div>
              </div>

              <div class="flex items-start gap-3">
{{#if step3}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full bg-brand-500 text-white text-[11px] flex items-center justify-center">✓</span>
{{/if}}
{{#if not step3}}
                <span class="w-5 h-5 mt-0.5 shrink-0 rounded-full border border-stone-300 dark:border-white/20 text-zinc-500 text-[11px] flex items-center justify-center">3</span>
{{/if}}
                <div>
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">Deploy and add SSL</p>
                  <p class="text-zinc-500 text-xs">Run your script, then enable Let's Encrypt.</p>
                </div>
              </div>
            </div>
          </div>
{{/if}}

{{#if teamReady}}
{{#if teamCount is not 0}}
          <div class="rounded-3xl border border-line bg-panel p-5 sm:p-7">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Team</h2>
              <a href="/team" class="text-brand-600 dark:text-brand-500 text-sm hover:underline">Manage</a>
            </div>
            <div class="space-y-3">
{{#each m in teamMembers}}
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 shrink-0 rounded-full bg-stone-200 dark:bg-white/10 flex items-center justify-center text-zinc-700 dark:text-zinc-200 text-xs font-semibold">{{ m.initial }}</div>
                  <div class="min-w-0">
                    <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ m.name }}</p>
                    <p class="text-zinc-500 text-xs truncate">{{ m.email }}</p>
                  </div>
                </div>
                <span class="shrink-0 text-[11px] font-medium text-zinc-500">{{ m.roleLabel }}</span>
              </div>
{{/each}}
            </div>
{{#if teamCount is 1}}
            <p class="text-zinc-500 text-xs mt-4 pt-3 border-t border-stone-100 dark:border-white/5">It's just you for now. Invite people from the team page.</p>
{{/if}}
          </div>
{{/if}}
{{/if}}

        </div>
      </div>

{{#if Insights.loaded}}
      <div class="rounded-3xl border border-line bg-panel overflow-hidden mb-4">
        <div class="flex items-center justify-between gap-4 px-5 sm:px-6 pt-5 pb-4">
          <div class="min-w-0">
            <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100 truncate">Fleet insights</h2>
            <p class="text-zinc-500 text-xs mt-1 truncate">{{ Insights.headline }}</p>
          </div>
{{#if Insights.rows.length > 2}}
          <button onclick="{{ Insights.toggle() }}" class="shrink-0 text-sm text-zinc-700 dark:text-zinc-200 border border-stone-300 dark:border-white/15 rounded-full px-4 py-1.5 hover:bg-stone-50 dark:hover:bg-white/5 transition-colors">
            {{ Insights.showAll ? "Show fewer" : "Show all " + Insights.rows.length }}
          </button>
{{/if}}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line border-t border-line">
          <div class="bg-panel p-5 sm:p-6">
            <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-wider mb-2">Fleet health</p>
            <p class="text-3xl font-light tracking-tight text-zinc-900 dark:text-zinc-100">{{ Insights.healthPct }}%</p>
            <div class="h-1.5 rounded-full bg-stone-200 dark:bg-white/10 mt-3 overflow-hidden">
              <div class="h-full rounded-full bg-brand-500 transition-all" style="{{ 'width: ' + Insights.healthPct + '%' }}"></div>
            </div>
            <p class="text-zinc-500 text-xs mt-2">{{ `${Insights.rows.filter((r) => r.label is "Online").length} of ${Insights.rows.length} servers online` }}</p>
          </div>

          <div class="bg-panel p-5 sm:p-6">
            <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-wider mb-2">Busiest server</p>
            <p class="text-3xl font-light tracking-tight text-zinc-900 dark:text-zinc-100 truncate">{{ Insights.busiest }}</p>
            <p class="text-zinc-500 text-xs mt-3">Hosting the most sites</p>
          </div>

          <div class="bg-panel p-5 sm:p-6">
            <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-wider mb-2">Idle servers</p>
            <p class="text-3xl font-light tracking-tight text-zinc-900 dark:text-zinc-100">{{ Insights.rows.filter((r) => r.count is 0).length }}</p>
            <p class="text-zinc-500 text-xs mt-3 truncate">{{ (Insights.rows.filter((r) => r.count is 0).length is 0) ? "Every server hosts a site" : Insights.rows.filter((r) => r.count is 0).map((r) => r.name).join(", ") + " have no sites" }}</p>
          </div>
        </div>

        <div>
{{#each r in (Insights.showAll ? Insights.rows : Insights.rows.slice(0, 2))}}
          <div class="flex items-center justify-between gap-4 px-5 sm:px-6 py-3.5 border-t border-stone-100 dark:border-white/5">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-2 h-2 shrink-0 rounded-full {{ r.dot }}"></span>
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ r.name }}</p>
            </div>
            <p class="text-zinc-500 text-xs shrink-0">{{ r.label }} · {{ r.count is 1 ? "1 site" : r.count + " sites" }}</p>
          </div>
{{/each}}
        </div>
      </div>
{{/if}}

      <div class="rounded-3xl border border-line bg-panel p-5 sm:p-7 mb-4">
        <div class="flex items-center justify-between gap-4 mb-5">
          <div class="min-w-0">
            <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Cloud providers</h2>
            <p class="text-zinc-500 text-xs mt-1">Open a provider to see its machines, volumes, IP addresses and spend.</p>
          </div>
          <a href="/providers" class="text-brand-600 dark:text-brand-500 text-sm hover:underline shrink-0">Manage all</a>
        </div>

{{#if not cloudReady}}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div class="h-20 rounded-2xl bg-stone-100 dark:bg-white/5 animate-pulse"></div>
          <div class="h-20 rounded-2xl bg-stone-100 dark:bg-white/5 animate-pulse"></div>
          <div class="h-20 rounded-2xl bg-stone-100 dark:bg-white/5 animate-pulse"></div>
        </div>
{{/if}}

{{#if cloudReady}}
{{#if providerCount is 0}}
        <div class="rounded-2xl border border-dashed border-stone-300 dark:border-white/15 p-8 text-center">
          <h3 class="text-zinc-900 dark:text-zinc-100 font-medium mb-1.5">No cloud providers connected</h3>
          <p class="text-zinc-500 text-sm max-w-md mx-auto mb-5">Connect a Linode, Hetzner, DigitalOcean, Vultr or UpCloud account to create servers from here.</p>
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            Connect a provider
          </button>
{{/if}}
{{#if not Billing.locked}}
          <a href="/providers" class="inline-flex items-center text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2 hover:bg-brand-400 transition-colors">Connect a provider</a>
{{/if}}
        </div>
{{/if}}
{{#if providerCount is not 0}}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
{{#each c in providerCards}}
          <a href="{{ c.href }}" class="group flex items-center justify-between gap-3 rounded-2xl bg-stone-50 dark:bg-white/[0.03] p-4 hover:bg-stone-100 dark:hover:bg-white/[0.06] transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <span class="{{ c.tileClass }}">{{ c.tileLetter }}</span>
              <div class="min-w-0">
                <h3 class="text-zinc-900 dark:text-zinc-100 text-sm font-semibold truncate">{{ c.label }}</h3>
                <p class="text-zinc-500 text-xs truncate">{{ c.kindName }} · {{ c.createdText }}</p>
              </div>
            </div>
            <span class="text-zinc-400 group-hover:text-brand-500 text-sm transition-colors">&rarr;</span>
          </a>
{{/each}}
        </div>
{{/if}}
{{/if}}
      </div>

      <div class="grid grid-cols-1 xl:grid-cols-12 gap-4">

        <div class="xl:col-span-8 rounded-3xl border border-line bg-panel overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-5 sm:px-6 pt-5 pb-4">
            <div class="min-w-0">
              <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Domains</h2>
              <p class="text-zinc-500 text-xs mt-1 truncate">{{ (domainCount is 0) ? "Closest to expiry first" : domainCount + " domains across " + registrarCount + (registrarCount is 1 ? " registrar" : " registrars") + ", closest to expiry first" }}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
{{#if domainsShown.length > 5}}
              <button onclick="{{ toggleDomains() }}" class="text-sm text-zinc-700 dark:text-zinc-200 border border-stone-300 dark:border-white/15 rounded-full px-4 py-1.5 hover:bg-stone-50 dark:hover:bg-white/5 transition-colors">
                {{ showAllDomains ? "Show fewer" : "Show all " + domainsShown.length }}
              </button>
{{/if}}
              <a href="/registrars" class="text-brand-600 dark:text-brand-500 text-sm hover:underline">Manage all</a>
            </div>
          </div>

{{#if not domainsReady}}
          <div class="px-5 sm:px-6 pb-6">
            <div class="h-44 rounded-2xl bg-stone-100 dark:bg-white/5 animate-pulse"></div>
          </div>
{{/if}}

{{#if domainsReady}}
{{#if registrarCount is 0}}
          <div class="px-6 py-12 text-center border-t border-stone-100 dark:border-white/5">
            <h3 class="text-zinc-900 dark:text-zinc-100 font-medium mb-1.5">No domain registrars connected</h3>
            <p class="text-zinc-500 text-sm max-w-md mx-auto mb-5">Connect Porkbun, Cloudflare, GoDaddy or another registrar to see your domains, expiry dates and DNS next to your servers.</p>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-stone-200 dark:bg-white/5 text-zinc-400 border border-stone-300 dark:border-white/10 rounded-full px-5 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Connect a registrar
            </button>
{{/if}}
{{#if not Billing.locked}}
            <a href="/registrars" class="inline-flex items-center text-sm font-semibold bg-brand-500 text-white rounded-full px-5 py-2 hover:bg-brand-400 transition-colors">Connect a registrar</a>
{{/if}}
          </div>
{{/if}}

{{#if registrarCount is not 0}}
{{#if domainCount is not 0}}
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1 px-5 sm:px-6 py-2.5 border-t border-stone-100 dark:border-white/5 text-xs">
            <span class="inline-flex items-center gap-1.5 text-rose-600 dark:text-rose-500"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>{{ expiredCount }} expired</span>
            <span class="inline-flex items-center gap-1.5 text-yellow-600 dark:text-yellow-400"><span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>{{ expiringCount }} expiring</span>
            <span class="inline-flex items-center gap-1.5 text-brand-600 dark:text-brand-500"><span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>{{ domainCount - expiredCount - expiringCount }} healthy</span>
          </div>

          <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_150px_110px] gap-4 px-6 py-2 border-t border-stone-100 dark:border-white/5 bg-stone-50 dark:bg-white/[0.02] text-[11px] font-medium uppercase tracking-wider text-zinc-500">
            <span>Domain</span>
            <span>Expires</span>
            <span>Status</span>
          </div>
{{/if}}

{{#if domainCount is 0}}
          <div class="px-6 py-12 text-center border-t border-stone-100 dark:border-white/5">
            <p class="text-zinc-900 dark:text-zinc-100 font-medium mb-1.5">No domains found</p>
            <p class="text-zinc-500 text-sm max-w-sm mx-auto">Your connected registrars returned no domains. Open the registrar to check the connection.</p>
          </div>
{{/if}}

{{#each d in (showAllDomains ? domainsShown : domainsShown.slice(0, 5))}}
          <a href="{{ d.href }}" class="grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[minmax(0,1fr)_150px_110px] items-center gap-4 px-5 sm:px-6 py-3.5 border-t border-stone-100 dark:border-white/5 hover:bg-stone-50 dark:hover:bg-white/[0.03] transition-colors">
            <div class="min-w-0">
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium font-mono truncate">{{ d.name }}</p>
              <p class="text-zinc-500 text-xs truncate">{{ d.registrar }}</p>
            </div>
            <div class="hidden sm:block min-w-0">
              <p class="text-zinc-700 dark:text-zinc-300 text-sm truncate">{{ d.expiresText }}</p>
              <p class="text-zinc-500 text-xs truncate">{{ d.dayText }}</p>
            </div>
            <span class="inline-flex justify-self-start rounded-md px-2 py-0.5 text-[11px] font-semibold {{ d.badge }}">{{ d.label }}</span>
          </a>
{{/each}}
{{/if}}
{{/if}}
        </div>

        <div class="xl:col-span-4 rounded-3xl border border-line bg-panel p-5 sm:p-7 content-start">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100">Registrars</h2>
            <a href="/registrars" class="text-brand-600 dark:text-brand-500 text-sm hover:underline">Manage</a>
          </div>

{{#if not domainsReady}}
          <div class="h-32 rounded-2xl bg-stone-100 dark:bg-white/5 animate-pulse"></div>
{{/if}}

{{#if domainsReady}}
{{#if registrarCount is 0}}
          <p class="text-zinc-500 text-sm">None connected yet.</p>
{{/if}}
          <div class="space-y-2">
{{#each r in registrarCards}}
            <a href="{{ r.href }}" class="flex items-center justify-between gap-3 rounded-2xl bg-stone-50 dark:bg-white/[0.03] px-3 py-3 hover:bg-stone-100 dark:hover:bg-white/[0.06] transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <span class="{{ r.tileClass }}">{{ r.tileLetter }}</span>
                <div class="min-w-0">
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-semibold truncate">{{ r.label }}</p>
{{#if r.failed}}
                  <p class="text-yellow-600 dark:text-yellow-400 text-xs">Couldn't load domains</p>
{{/if}}
{{#if not r.failed}}
                  <p class="text-zinc-500 text-xs">{{ r.countText }}</p>
{{/if}}
                </div>
              </div>
{{#if r.expiring is not 0}}
              <span class="shrink-0 inline-flex rounded-md bg-yellow-400/10 px-2 py-0.5 text-[11px] font-semibold text-yellow-600 dark:text-yellow-400">{{ r.expiring }} due</span>
{{/if}}
            </a>
{{/each}}
          </div>
{{/if}}
        </div>
      </div>

    </div>
    </div>
  </div>
{{/if}}

{{#if not checkedAuth}}
<PageLoader label="Loading dashboard" />
{{/if}}