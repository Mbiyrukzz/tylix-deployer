page Dashboard

import { IconDatabase, IconUser, IconFolder, IconMail, IconCloud, IconCube, IconExclamationTriangle } from "tylix-icons"

title "Dashboard"

needs
  Auth

uses
  Servers
  Provisions
  Providers
  Registrars
  Mail
  Billing
  Insights

background
  Mail
  Billing

meta
  transition "fade"

state
  checkedAuth: false
  greeting: ""
  todayText: ""
  fleet: []
  recentSites: []
  baseAttention: []
  domainItems: []
  attention: []
  hasAttention: false
  newSiteHref: "/servers"
  onlineCount: 0
  offlineCount: 0
  pendingCount: 0
  totalServers: 0
  siteCount: 0
  readyCount: 0
  buildingCount: 0
  failedCount: 0
  healthState: "empty"
  healthText: ""
  sOnDash: "0 226.2"
  sOnOff: "0"
  sOffDash: "0 226.2"
  sOffOff: "0"
  sPenDash: "0 226.2"
  sPenOff: "0"
  readyStyle: "width: 0%"
  buildStyle: "width: 0%"
  failStyle: "width: 0%"
  stepsDone: 0
  setupDone: false
  progressStyle: "width: 0%"
  step1: false
  step2: false
  step3: false
  cloudReady: false
  providerCount: 0
  providerCards: []
  domainsReady: false
  registrarCount: 0
  registrarCards: []
  domainCount: 0
  domainsShown: []
  expiringCount: 0
  expiredCount: 0
  showAllDomains: false
  teamReady: false
  teamCount: 0
  teamStaff: 0
  teamMembers: []

action
  plural(n, word) {
    if n is 1 {
      return "1 " + word
    }
    return n + " " + word + "s"
  }

  typeLabel(t) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["fastapi", "FastAPI"],
      ["django", "Django"],
      ["java", "Java"],
      ["go", "Go"],
      ["ruby", "Ruby"],
      ["dotnet", ".NET"],
      ["rust", "Rust"],
      ["static", "Static"]
    ]
    const hit = labels.find((l) => l[0] is t)
    return hit ? hit[1] : t
  }

  siteHref(id) {
    return "/servers/site-detail?id=" + id
  }

  // Length of one donut segment, out of a ring that is 226.2 long.
  arcDash(v, total) {
    if total is 0 {
      return "0 226.2"
    }
    return (Math.round(v / total * 2262) / 10) + " 226.2"
  }

  // Where a segment starts: minus everything drawn before it.
  arcOffset(v, total) {
    if total is 0 {
      return "0"
    }
    return "-" + (Math.round(v / total * 2262) / 10)
  }

  rowsOf(res) {
    if res.ok and Array.isArray(res.data) {
      return res.data
    }
    return []
  }

  // Like rowsOf, but also accepts { domains: [...] }.
  listOf(res) {
    if not res.ok {
      return []
    }
    if Array.isArray(res.data) {
      return res.data
    }
    if res.data and Array.isArray(res.data.domains) {
      return res.data.domains
    }
    return []
  }

  // Flips the domain list between 5 rows and all rows.
  toggleDomains() {
    this.showAllDomains = this.showAllDomains ? false : true
  }

  decorateServer(s, sites) {
    const n = sites.filter((x) => x.server_id is s.id).length
    return Object.assign({}, s, {
      href: "/servers/server-detail?id=" + s.id,
      siteLabel: this.plural(n, "site")
    })
  }

  decorateSite(site, servers) {
    const host = servers.find((x) => x.id is site.server_id)
    return Object.assign({}, site, {
      href: this.siteHref(site.id),
      typeText: this.typeLabel(site.type),
      serverName: host ? host.name : "Unknown server"
    })
  }

  kindStyle(kind) {
    let name = "Linode (Akamai)"
    let letter = "L"
    let cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-emerald-500/10 text-emerald-700 dark:text-emerald-500"

    if kind is "hetzner" {
      name = "Hetzner Cloud"
      letter = "H"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    if kind is "digitalocean" {
      name = "DigitalOcean"
      letter = "D"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    if kind is "vultr" {
      name = "Vultr"
      letter = "V"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    if kind is "aws" {
      name = "Amazon Web Services"
      letter = "A"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400"
    }
    if kind is "upcloud" {
      name = "UpCloud"
      letter = "U"
      cls = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400"
    }

    return { name: name, letter: letter, cls: cls }
  }

  // Merges server and domain attention items into the list the page shows.
  rebuildAttention() {
    const all = this.baseAttention.concat(this.domainItems)
    this.attention = all.slice(0, 8)
    this.hasAttention = all.length > 0
  }

  // Provider cards come from the shared stores. No extra requests.
  async loadProviders() {
    await Promise.all([Providers.load(), Provisions.load()])

    const provRows = Provisions.data
    this.providerCount = Providers.data.length
    this.providerCards = Providers.data.map((p) => this.decorateProvider(p, provRows))
    this.cloudReady = true
  }

  decorateProvider(p, provRows) {
    const style = this.kindStyle(p.kind)
    const created = provRows.filter((r) => r.provider_id is p.id and r.has_instance and r.status is not "deleted").length

    return {
      id: p.id,
      label: p.label,
      kindName: style.name,
      tileLetter: style.letter,
      tileClass: style.cls,
      href: "/providers/provider-detail?id=" + p.id,
      createdText: this.plural(created, "server") + " created here"
    }
  }

  registrarName(kind) {
    const names = [
      ["porkbun", "Porkbun"],
      ["cloudflare", "Cloudflare"],
      ["godaddy", "GoDaddy"],
      ["namecheap", "Namecheap"],
      ["namecom", "Name.com"],
      ["name_com", "Name.com"],
      ["dynadot", "Dynadot"],
      ["route53", "Route 53"],
      ["spaceship", "Spaceship"]
    ]
    const hit = names.find((n) => n[0] is kind)
    return hit ? hit[1] : kind
  }

  registrarTile(i) {
    const base = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold "
    const tones = [
      "bg-emerald-500/10 text-emerald-700 dark:text-emerald-500",
      "bg-sky-500/10 text-sky-600 dark:text-sky-400",
      "bg-violet-500/10 text-violet-600 dark:text-violet-400",
      "bg-amber-500/10 text-amber-600 dark:text-amber-400",
      "bg-rose-500/10 text-rose-600 dark:text-rose-400"
    ]
    return base + tones[i % tones.length]
  }

  daysUntil(raw) {
    if not raw {
      return null
    }
    const t = new Date(raw).getTime()
    if Number.isNaN(t) {
      return null
    }
    return Math.ceil((t - Date.now()) / 86400000)
  }

  // One domain row. A domain with no readable expiry date sorts last.
  decorateDomain(d, registrarLabel) {
    const name = d.name or d.domain or d.domain_name or ""
    const raw = d.expires_at or d.expires or d.expiry or d.expiration_date or d.expiresAt or ""
    const days = this.daysUntil(raw)

    let sortDays = 99999
    let label = "Active"
    let dayText = "-"
    let note = ""
    let badge = "bg-slate-500/10 text-slate-600 dark:text-slate-400"

    if days is not null {
      sortDays = days
      if days < 0 {
        label = "Expired"
        dayText = "Expired " + Math.abs(days) + "d ago"
        note = "expired " + Math.abs(days) + " days ago"
        badge = "bg-rose-500/10 text-rose-600 dark:text-rose-500"
      } else if days <= 30 {
        label = "Expiring"
        dayText = days + " days left"
        note = "expires in " + this.plural(days, "day")
        badge = "bg-amber-500/10 text-amber-600 dark:text-amber-500"
      } else {
        dayText = days + " days left"
        badge = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-500"
      }
    } else {
      label = "No expiry data"
    }

    return {
      name: name,
      registrar: registrarLabel,
      expiresText: raw ? String(raw).slice(0, 10) : "-",
      days: sortDays,
      dayText: dayText,
      label: label,
      note: note,
      badge: badge,
      href: "/registrars"
    }
  }

  async loadRegistrar(r) {
    const res = await useApi("/api/registrars/" + r.id + "/domains")
    return { registrar: r, res: res }
  }

  // One registrar card plus its decorated domain rows.
  registrarPart(l, i) {
    const r = l.registrar
    const name = r.label or this.registrarName(r.kind)
    const rows = this.listOf(l.res).map((d) => this.decorateDomain(d, name)).filter((d) => d.name is not "")

    return {
      card: {
        id: r.id,
        label: name,
        tileLetter: String(name).charAt(0).toUpperCase(),
        tileClass: this.registrarTile(i),
        href: "/registrars",
        countText: this.plural(rows.length, "domain"),
        failed: not l.res.ok,
        expiring: rows.filter((d) => d.days <= 30).length
      },
      rows: rows
    }
  }

  // The registrar list comes from the Registrars capability.
  // Only the per-registrar domain lookups still call the API directly.
  async loadDomains() {
    await Registrars.load()
    const list = Registrars.data
    this.registrarCount = list.length

    if list.length is 0 {
      this.domainsReady = true
      return null
    }

    const loaded = await Promise.all(list.map((r) => this.loadRegistrar(r)))
    const parts = loaded.map((l, i) => this.registrarPart(l, i))
    const rows = parts.reduce((acc, p) => acc.concat(p.rows), [])
    rows.sort((a, b) => a.days - b.days)

    this.registrarCards = parts.map((p) => p.card)
    this.domainCount = rows.length
    this.domainsShown = rows.slice(0, 8)
    this.expiredCount = rows.filter((d) => d.days < 0).length
    this.expiringCount = rows.filter((d) => d.days >= 0 and d.days <= 30).length
    this.domainItems = rows
      .filter((d) => d.days <= 30)
      .slice(0, 4)
      .map((d) => ({ text: d.name + " " + d.note, hint: "Renew it at " + d.registrar, href: d.href }))
    this.rebuildAttention()
    this.domainsReady = true
  }

  initial(m) {
    const source = m.name or m.email or "?"
    return String(source).charAt(0).toUpperCase()
  }

  roleText(role) {
    const r = String(role or "member")
    return r.charAt(0).toUpperCase() + r.slice(1)
  }

  async loadTeam() {
    const res = await useApi("/api/team/members")

    if res.ok and res.data and Array.isArray(res.data.members) {
      const members = res.data.members.map((m) => Object.assign({}, m, {
        initial: this.initial(m),
        roleLabel: this.roleText(m.role)
      }))
      this.teamCount = members.length
      this.teamStaff = members.filter((m) => m.role is "owner" or m.role is "admin").length
      this.teamMembers = members.slice(0, 6)
    }

    this.teamReady = true
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const now = new Date()
    this.todayText = now.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" })

    const hour = now.getHours()
    let greeting = "Good evening"
    if hour < 12 {
      greeting = "Good morning"
    } else if hour < 18 {
      greeting = "Good afternoon"
    }
    this.greeting = greeting

    const serversLoad = Servers.load()
    const sitesRes = await useApi("/api/sites")
    await serversLoad

    const list = Servers.data
    let sites = []
    if sitesRes.ok and Array.isArray(sitesRes.data) {
      sites = sitesRes.data
    }

    const total = list.length
    const online = list.filter((s) => s.status is "online").length
    const offline = list.filter((s) => s.status is "offline").length
    const pending = list.filter((s) => s.status is "pending").length

    const ready = sites.filter((x) => x.status is "ready").length
    const failed = sites.filter((x) => x.status is "failed").length
    const building = sites.filter((x) => x.status is "creating" or x.status is "pending").length

    this.totalServers = total
    this.onlineCount = online
    this.offlineCount = offline
    this.pendingCount = pending
    this.siteCount = sites.length
    this.readyCount = ready
    this.failedCount = failed
    this.buildingCount = building

    if total is 1 {
      this.newSiteHref = "/servers/server-sites?id=" + list[0].id
    } else {
      this.newSiteHref = "/servers"
    }

    this.fleet = list.map((s) => this.decorateServer(s, sites))

    Insights.analyze(list, sites)

    const sorted = sites.slice().sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
    this.recentSites = sorted.slice(0, 5).map((x) => this.decorateSite(x, list))

    const offlineItems = list
      .filter((s) => s.status is "offline")
      .map((s) => ({ text: s.name + " is offline", hint: "Check connectivity", href: "/servers/server-detail?id=" + s.id }))
    const failedItems = sites
      .filter((x) => x.status is "failed")
      .map((x) => ({ text: x.domain + " failed to deploy", hint: "View the deployment log", href: this.siteHref(x.id) }))

    this.baseAttention = offlineItems.concat(failedItems)
    this.rebuildAttention()

    if total is 0 {
      this.healthState = "empty"
      this.healthText = "No servers connected yet"
    } else if offline + failed > 0 {
      this.healthState = "warn"
      this.healthText = this.plural(offline + failed, "issue") + " need attention"
    } else {
      this.healthState = "ok"
      this.healthText = "All systems operational"
    }

    this.sOnDash = this.arcDash(online, total)
    this.sOnOff = this.arcOffset(0, total)
    this.sOffDash = this.arcDash(offline, total)
    this.sOffOff = this.arcOffset(online, total)
    this.sPenDash = this.arcDash(pending, total)
    this.sPenOff = this.arcOffset(online + offline, total)

    if sites.length > 0 {
      this.readyStyle = "width: " + Math.round(ready / sites.length * 100) + "%"
      this.buildStyle = "width: " + Math.round(building / sites.length * 100) + "%"
      this.failStyle = "width: " + Math.round(failed / sites.length * 100) + "%"
    }

    this.step1 = total > 0
    this.step2 = sites.length > 0
    this.step3 = ready > 0

    let done = 0
    if this.step1 {
      done = done + 1
    }
    if this.step2 {
      done = done + 1
    }
    if this.step3 {
      done = done + 1
    }
    this.stepsDone = done
    this.setupDone = done is 3
    this.progressStyle = "width: " + Math.round((done / 3) * 100) + "%"

    this.checkedAuth = true

    // These fill in after the page is already on screen.
    this.loadProviders()
    this.loadDomains()
    this.loadTeam()
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">

    <Sidebar active="overview" />

    <div class="min-w-0 px-6 lg:px-10 py-10">
    <div class="max-w-7xl mx-auto">

      <LockedBanner />

      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div class="min-w-0">
          <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">{{ todayText }}</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ greeting }}, {{ Auth.user.name }}</h1>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/registrars" class="inline-flex text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2.5 hover:bg-white dark:hover:bg-slate-900 transition-colors">
            My domains
          </a>
          <a href="/providers" class="inline-flex text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2.5 hover:bg-white dark:hover:bg-slate-900 transition-colors">
            Cloud providers
          </a>
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2.5 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            New server
          </button>
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2.5 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            New site
          </button>
{{/if}}
{{#if not Billing.locked}}
          <a href="/servers" class="inline-flex text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2.5 hover:bg-white dark:hover:bg-slate-900 transition-colors">
            New server
          </a>
          <a href="{{ newSiteHref }}" class="inline-flex text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2.5 shadow-sm hover:bg-emerald-400 transition-all">
            New site
          </a>
{{/if}}
        </div>
      </div>

{{#if hasAttention}}
      <div class="rounded-2xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-5 mb-6">
        <div class="flex items-center justify-between mb-3">
          <h2 class="inline-flex items-center gap-2 text-amber-800 dark:text-amber-400 font-semibold">
            <IconExclamationTriangle class="w-4 h-4" /> Needs attention
          </h2>
          <span class="text-amber-800/70 dark:text-amber-400/70 text-xs">Things that stopped working or expire soon</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2">
{{#each item in attention}}
          <a href="{{ item.href }}" class="block rounded-xl border border-amber-200 dark:border-amber-900/40 bg-white/70 dark:bg-slate-900/60 px-4 py-3 hover:border-amber-400 transition-colors">
            <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ item.text }}</p>
            <p class="text-slate-500 text-xs mt-0.5">{{ item.hint }}</p>
          </a>
{{/each}}
        </div>
      </div>
{{/if}}

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-4">

        <div class="md:col-span-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
          <div class="flex items-center gap-6">
            <div class="relative w-28 h-28 shrink-0">
              <svg viewBox="0 0 100 100" class="w-28 h-28">
                <circle cx="50" cy="50" r="36" fill="none" stroke="#64748b" stroke-opacity="0.2" stroke-width="10" />
                <circle cx="50" cy="50" r="36" fill="none" stroke="#10b981" stroke-width="10" stroke-dasharray="{{ sOnDash }}" stroke-dashoffset="{{ sOnOff }}" transform="rotate(-90 50 50)" />
                <circle cx="50" cy="50" r="36" fill="none" stroke="#f43f5e" stroke-width="10" stroke-dasharray="{{ sOffDash }}" stroke-dashoffset="{{ sOffOff }}" transform="rotate(-90 50 50)" />
                <circle cx="50" cy="50" r="36" fill="none" stroke="#f59e0b" stroke-width="10" stroke-dasharray="{{ sPenDash }}" stroke-dashoffset="{{ sPenOff }}" transform="rotate(-90 50 50)" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ totalServers }}</span>
                <span class="text-[10px] font-medium uppercase tracking-wider text-slate-500">servers</span>
              </div>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2.5 mb-3">
{{#if healthState is "ok"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.15)]"></span>
{{/if}}
{{#if healthState is "warn"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-amber-500 shadow-[0_0_0_4px_rgba(245,158,11,0.15)]"></span>
{{/if}}
{{#if healthState is "empty"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-slate-400 shadow-[0_0_0_4px_rgba(148,163,184,0.15)]"></span>
{{/if}}
                <p class="text-slate-900 dark:text-slate-100 font-semibold leading-tight truncate">{{ healthText }}</p>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Online</span>
                  <span class="font-mono text-slate-900 dark:text-slate-100">{{ onlineCount }}</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                  <span class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Offline</span>
                  <span class="font-mono text-slate-900 dark:text-slate-100">{{ offlineCount }}</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                  <span class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Untested</span>
                  <span class="font-mono text-slate-900 dark:text-slate-100">{{ pendingCount }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-4">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Sites</p>
            <IconFolder class="w-4 h-4 text-emerald-700 dark:text-emerald-500" />
          </div>
          <p class="text-4xl font-bold text-slate-900 dark:text-slate-100">{{ siteCount }}</p>
          <p class="text-slate-500 text-xs mt-1 mb-4">{{ readyCount }} live</p>
{{#if siteCount is not 0}}
          <div class="flex h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden mb-3">
            <div class="h-full bg-emerald-500 transition-all" style="{{ readyStyle }}"></div>
            <div class="h-full bg-amber-500 transition-all" style="{{ buildStyle }}"></div>
            <div class="h-full bg-rose-500 transition-all" style="{{ failStyle }}"></div>
          </div>
{{/if}}
{{#if siteCount is 0}}
          <div class="h-2 rounded-full bg-slate-200 dark:bg-slate-800 mb-3"></div>
{{/if}}
          <div class="space-y-1 text-xs text-slate-500">
            <p><span class="text-amber-600 dark:text-amber-500 font-medium">{{ buildingCount }}</span> building</p>
            <p><span class="text-rose-600 dark:text-rose-500 font-medium">{{ failedCount }}</span> failed</p>
          </div>
        </div>

{{#if Mail.available}}
        <a href="/dashboard/mail" class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center justify-between mb-4">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Mail</p>
            <IconMail class="w-4 h-4 text-emerald-700 dark:text-emerald-500" />
          </div>
          <p class="text-4xl font-bold text-slate-900 dark:text-slate-100">{{ Mail.unread }}</p>
          <p class="text-slate-500 text-xs mt-3">Unread messages</p>
        </a>
{{/if}}
{{#if not Mail.available}}
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-4">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Account</p>
            <IconUser class="w-4 h-4 text-emerald-700 dark:text-emerald-500" />
          </div>
          <p class="text-slate-900 dark:text-slate-100 text-sm font-semibold truncate">{{ Auth.user.email }}</p>
          <p class="text-slate-500 text-xs mt-3">Signed in</p>
        </div>
{{/if}}
      </div>

      <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-8">

        <a href="/providers" class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <p class="text-slate-500 text-xs">Cloud providers</p>
            <IconCloud class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" />
          </div>
{{#if cloudReady}}
          <p class="text-slate-900 dark:text-slate-100 text-2xl font-semibold">{{ providerCount }}</p>
{{/if}}
{{#if not cloudReady}}
          <p class="text-slate-400 text-2xl font-semibold">-</p>
{{/if}}
          <p class="text-slate-500 text-xs mt-0.5">{{ totalServers }} servers connected</p>
        </a>

        <a href="/registrars" class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <p class="text-slate-500 text-xs">Registrars</p>
            <IconCube class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" />
          </div>
{{#if domainsReady}}
          <p class="text-slate-900 dark:text-slate-100 text-2xl font-semibold">{{ registrarCount }}</p>
{{/if}}
{{#if not domainsReady}}
          <p class="text-slate-400 text-2xl font-semibold">-</p>
{{/if}}
          <p class="text-slate-500 text-xs mt-0.5">Domain providers connected</p>
        </a>

        <a href="/registrars" class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <p class="text-slate-500 text-xs">My domains</p>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              <circle cx="10" cy="10" r="7.5" />
              <path d="M2.5 10h15M10 2.5c2.2 2.2 3.2 4.7 3.2 7.5S12.2 15.3 10 17.5C7.8 15.3 6.8 12.8 6.8 10S7.8 4.7 10 2.5z" stroke-linejoin="round" />
            </svg>
          </div>
{{#if domainsReady}}
          <p class="text-slate-900 dark:text-slate-100 text-2xl font-semibold">{{ domainCount }}</p>
{{/if}}
{{#if not domainsReady}}
          <p class="text-slate-400 text-2xl font-semibold">-</p>
{{/if}}
{{#if expiredCount is not 0}}
          <p class="text-rose-600 dark:text-rose-500 text-xs mt-0.5">{{ expiredCount }} expired · {{ expiringCount }} expiring soon</p>
{{/if}}
{{#if expiredCount is 0}}
{{#if expiringCount is not 0}}
          <p class="text-amber-600 dark:text-amber-500 text-xs mt-0.5">{{ expiringCount }} expiring within 30 days</p>
{{/if}}
{{#if expiringCount is 0}}
          <p class="text-slate-500 text-xs mt-0.5">None expiring within 30 days</p>
{{/if}}
{{/if}}
        </a>

        <a href="/team" class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <p class="text-slate-500 text-xs">Team members</p>
            <IconUser class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" />
          </div>
{{#if teamReady}}
          <p class="text-slate-900 dark:text-slate-100 text-2xl font-semibold">{{ teamCount }}</p>
{{/if}}
{{#if not teamReady}}
          <p class="text-slate-400 text-2xl font-semibold">-</p>
{{/if}}
          <p class="text-slate-500 text-xs mt-0.5">{{ teamStaff }} owner or admin</p>
        </a>
      </div>

{{#if Insights.loaded}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm dark:shadow-none overflow-hidden mb-8">
        <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-200 dark:border-slate-800">
          <div class="min-w-0">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold truncate">Fleet insights</h2>
            <p class="text-slate-500 text-xs mt-0.5 truncate">{{ Insights.headline }}</p>
          </div>
{{#if Insights.rows.length > 2}}
          <button onclick="{{ Insights.toggle() }}" class="shrink-0 text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
            {{ Insights.showAll ? "Show fewer" : "Show all " + Insights.rows.length }}
          </button>
{{/if}}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-200 dark:bg-slate-800">
          <div class="bg-white dark:bg-slate-900 p-5">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Fleet health</p>
            <p class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ Insights.healthPct }}%</p>
            <div class="h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 mt-3 overflow-hidden">
              <div class="h-full rounded-full bg-emerald-500 transition-all" style="{{ 'width: ' + Insights.healthPct + '%' }}"></div>
            </div>
            <p class="text-slate-500 text-xs mt-2">{{ `${Insights.rows.filter((r) => r.label is "Online").length} of ${Insights.rows.length} servers online` }}</p>
          </div>

          <div class="bg-white dark:bg-slate-900 p-5">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Busiest server</p>
            <p class="text-2xl font-semibold text-slate-900 dark:text-slate-100 truncate">{{ Insights.busiest }}</p>
            <p class="text-slate-500 text-xs mt-3">Hosting the most sites</p>
          </div>

          <div class="bg-white dark:bg-slate-900 p-5">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Idle servers</p>
            <p class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ Insights.rows.filter((r) => r.count is 0).length }}</p>
            <p class="text-slate-500 text-xs mt-3 truncate">{{ (Insights.rows.filter((r) => r.count is 0).length is 0) ? "Every server hosts a site" : Insights.rows.filter((r) => r.count is 0).map((r) => r.name).join(", ") + " have no sites" }}</p>
          </div>
        </div>

        <div>
{{#each r in (Insights.showAll ? Insights.rows : Insights.rows.slice(0, 2))}}
          <div class="flex items-center justify-between gap-4 px-6 py-3.5 border-t border-slate-100 dark:border-slate-800/70">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-2 h-2 shrink-0 rounded-full {{ r.dot }}"></span>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ r.name }}</p>
            </div>
            <p class="text-slate-500 text-xs shrink-0">{{ r.label }} · {{ r.count is 1 ? "1 site" : r.count + " sites" }}</p>
          </div>
{{/each}}
        </div>
      </div>
{{/if}}

      <div class="flex items-end justify-between mb-4">
        <div>
          <h2 class="inline-flex items-center gap-2 text-slate-900 dark:text-slate-100 text-lg font-semibold">
            <IconCloud class="w-5 h-5 text-emerald-700 dark:text-emerald-500" /> Cloud providers
          </h2>
          <p class="text-slate-500 text-sm mt-0.5">Open a provider to see its machines, volumes, IP addresses and spend.</p>
        </div>
        <a href="/providers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium shrink-0">Manage all</a>
      </div>

{{#if not cloudReady}}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
        <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
        <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
      </div>
{{/if}}

{{#if cloudReady}}
{{#if providerCount is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center mb-8">
        <h3 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No cloud providers connected</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-5">Connect a Linode, Hetzner, DigitalOcean, Vultr or UpCloud account to create servers from here.</p>
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Connect a provider
        </button>
{{/if}}
{{#if not Billing.locked}}
        <a href="/providers" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">Connect a provider</a>
{{/if}}
      </div>
{{/if}}
{{#if providerCount is not 0}}
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-8">
{{#each c in providerCards}}
        <a href="{{ c.href }}" class="group flex items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none hover:border-emerald-500/50 transition-colors">
          <div class="flex items-center gap-3 min-w-0">
            <span class="{{ c.tileClass }}">{{ c.tileLetter }}</span>
            <div class="min-w-0">
              <h3 class="text-slate-900 dark:text-slate-100 text-sm font-semibold truncate">{{ c.label }}</h3>
              <p class="text-slate-500 text-xs truncate">{{ c.kindName }} · {{ c.createdText }}</p>
            </div>
          </div>
          <span class="text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 text-sm transition-colors">&rarr;</span>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

      <div class="flex items-end justify-between mb-4">
        <div>
          <h2 class="inline-flex items-center gap-2 text-slate-900 dark:text-slate-100 text-lg font-semibold">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5 text-emerald-700 dark:text-emerald-500">
              <circle cx="10" cy="10" r="7.5" />
              <path d="M2.5 10h15M10 2.5c2.2 2.2 3.2 4.7 3.2 7.5S12.2 15.3 10 17.5C7.8 15.3 6.8 12.8 6.8 10S7.8 4.7 10 2.5z" stroke-linejoin="round" />
            </svg>
            Domains
          </h2>
          <p class="text-slate-500 text-sm mt-0.5">Every domain in the registrars you connected, closest to expiry first.</p>
        </div>
        <a href="/registrars" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium shrink-0">Manage all</a>
      </div>

{{#if not domainsReady}}
      <div class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-4 mb-8">
        <div class="h-56 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
        <div class="h-56 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
      </div>
{{/if}}

{{#if domainsReady}}
{{#if registrarCount is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center mb-8">
        <h3 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No domain registrars connected</h3>
        <p class="text-slate-500 text-sm max-w-md mx-auto mb-5">Connect Porkbun, Cloudflare, GoDaddy or another registrar to see your domains, expiry dates and DNS next to your servers.</p>
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Connect a registrar
        </button>
{{/if}}
{{#if not Billing.locked}}
        <a href="/registrars" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">Connect a registrar</a>
{{/if}}
      </div>
{{/if}}

{{#if registrarCount is not 0}}
      <div class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-4 mb-8">

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm dark:shadow-none overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-200 dark:border-slate-800">
            <div class="min-w-0">
              <h3 class="text-slate-900 dark:text-slate-100 font-semibold truncate">Domains by expiry</h3>
              <p class="text-slate-500 text-xs mt-0.5 truncate">{{ (domainCount is 0) ? "No domains loaded" : domainCount + " domains across " + registrarCount + (registrarCount is 1 ? " registrar" : " registrars") }}</p>
            </div>
{{#if domainsShown.length > 5}}
            <button onclick="{{ toggleDomains() }}" class="shrink-0 text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              {{ showAllDomains ? "Show fewer" : "Show all " + domainsShown.length }}
            </button>
{{/if}}
          </div>

{{#if domainCount is not 0}}
          <div class="flex flex-wrap items-center gap-2 px-6 py-3 border-b border-slate-100 dark:border-slate-800/70">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> {{ expiredCount }} expired
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> {{ expiringCount }} expiring
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> {{ domainCount - expiredCount - expiringCount }} healthy
            </span>
          </div>
{{/if}}

{{#if domainCount is 0}}
          <div class="p-10 text-center">
            <p class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No domains found</p>
            <p class="text-slate-500 text-sm max-w-sm mx-auto">Your connected registrars returned no domains. Open the registrar to check the connection.</p>
          </div>
{{/if}}

{{#each d in (showAllDomains ? domainsShown : domainsShown.slice(0, 5))}}
          <a href="{{ d.href }}" class="flex items-center justify-between gap-4 px-6 py-3.5 border-b border-slate-100 dark:border-slate-800/70 last:border-b-0 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium font-mono truncate">{{ d.name }}</p>
              <p class="text-slate-500 text-xs truncate">{{ d.registrar }} · expires {{ d.expiresText }}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="hidden sm:inline text-xs text-slate-500">{{ d.dayText }}</span>
              <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider {{ d.badge }}">{{ d.label }}</span>
            </div>
          </a>
{{/each}}
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none content-start">
          <div class="flex items-center justify-between mb-4">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Registrars</p>
            <a href="/registrars" class="text-emerald-700 dark:text-emerald-500 text-xs hover:underline font-medium">Manage</a>
          </div>
          <div class="space-y-3">
{{#each r in registrarCards}}
            <a href="{{ r.href }}" class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 dark:border-slate-800 px-3 py-3 hover:border-emerald-500/50 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <span class="{{ r.tileClass }}">{{ r.tileLetter }}</span>
                <div class="min-w-0">
                  <p class="text-slate-900 dark:text-slate-100 text-sm font-semibold truncate">{{ r.label }}</p>
{{#if r.failed}}
                  <p class="text-amber-700 dark:text-amber-500 text-xs">Couldn't load domains</p>
{{/if}}
{{#if not r.failed}}
                  <p class="text-slate-500 text-xs">{{ r.countText }}</p>
{{/if}}
                </div>
              </div>
{{#if r.expiring is not 0}}
              <span class="shrink-0 inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-semibold text-amber-600 dark:text-amber-500">{{ r.expiring }} due</span>
{{/if}}
            </a>
{{/each}}
          </div>
        </div>
      </div>
{{/if}}
{{/if}}

      <div class="grid grid-cols-1 xl:grid-cols-[1fr_320px] gap-6">

        <div class="space-y-6 min-w-0">

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800">
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Your servers</h2>
              <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium">Manage all</a>
            </div>

{{#if not Servers.loading}}
{{#if Servers.data.length is 0}}
            <div class="p-10 text-center">
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 flex items-center justify-center mx-auto mb-4">
                <IconDatabase class="w-6 h-6 text-emerald-700 dark:text-emerald-500" />
              </div>
              <h3 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No servers yet</h3>
              <p class="text-slate-500 text-sm max-w-sm mx-auto mb-5">
                Provision a server at one of your cloud providers or connect your own over SSH, then start deploying to it.
              </p>
{{#if Billing.locked}}
              <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 cursor-not-allowed select-none">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
                Add your first server
              </button>
{{/if}}
{{#if not Billing.locked}}
              <a href="/servers" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">
                Add your first server
              </a>
{{/if}}
            </div>
{{/if}}
{{/if}}

{{#each s in fleet}}
            <a href="{{ s.href }}" class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-100 dark:border-slate-800/70 last:border-b-0 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              <div class="flex items-center gap-4 min-w-0">
{{#if s.status is "online"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.15)]"></span>
{{/if}}
{{#if s.status is "offline"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-rose-500 shadow-[0_0_0_4px_rgba(244,63,94,0.15)]"></span>
{{/if}}
{{#if s.status is "pending"}}
                <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-amber-500 shadow-[0_0_0_4px_rgba(245,158,11,0.15)]"></span>
{{/if}}
                <div class="min-w-0">
                  <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ s.name }}</p>
                  <p class="text-slate-500 text-xs font-mono truncate">{{ s.ssh_user }}@{{ s.host }}:{{ s.port }}</p>
                </div>
              </div>
              <div class="flex items-center gap-4 shrink-0">
                <span class="hidden sm:inline text-xs text-slate-500">{{ s.siteLabel }}</span>
{{#if s.status is "online"}}
                <span class="inline-flex rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">Online</span>
{{/if}}
{{#if s.status is "offline"}}
                <span class="inline-flex rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">Offline</span>
{{/if}}
{{#if s.status is "pending"}}
                <span class="inline-flex rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">Not tested</span>
{{/if}}
                <span class="text-slate-400 text-sm">&rarr;</span>
              </div>
            </a>
{{/each}}
          </div>

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800">
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Recent sites</h2>
              <span class="text-slate-500 text-xs">{{ siteCount }} total</span>
            </div>

{{#if siteCount is 0}}
            <div class="p-10 text-center">
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 flex items-center justify-center mx-auto mb-4">
                <IconFolder class="w-6 h-6 text-emerald-700 dark:text-emerald-500" />
              </div>
              <h3 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">Nothing deployed yet</h3>
              <p class="text-slate-500 text-sm max-w-sm mx-auto mb-5">
                Sites are created on a server. Pick a server, then choose a framework and a repository.
              </p>
{{#if Billing.locked}}
              <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 cursor-not-allowed select-none">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
                Create a site
              </button>
{{/if}}
{{#if not Billing.locked}}
{{#if totalServers is 0}}
              <a href="/servers" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">
                Add a server first
              </a>
{{/if}}
{{#if totalServers is not 0}}
              <a href="{{ newSiteHref }}" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">
                Create a site
              </a>
{{/if}}
{{/if}}
            </div>
{{/if}}

{{#each site in recentSites}}
            <a href="{{ site.href }}" class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-100 dark:border-slate-800/70 last:border-b-0 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              <div class="min-w-0">
                <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ site.domain }}</p>
                <p class="text-slate-500 text-xs truncate">{{ site.typeText }} · {{ site.serverName }}</p>
              </div>
              <div class="flex items-center gap-4 shrink-0">
{{#if site.status is "ready"}}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
                </span>
{{/if}}
{{#if site.status is "failed"}}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
                </span>
{{/if}}
{{#if site.status is "creating"}}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Creating
                </span>
{{/if}}
{{#if site.status is "pending"}}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Queued
                </span>
{{/if}}
                <span class="text-slate-400 text-sm">&rarr;</span>
              </div>
            </a>
{{/each}}
          </div>
        </div>

        <div class="space-y-6">

{{#if not setupDone}}
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Get deployed</h2>
              <span class="text-slate-500 text-xs font-mono">{{ stepsDone }}/3</span>
            </div>
            <p class="text-slate-500 text-xs mb-4">Three steps to your first live site.</p>
            <div class="h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 mb-5 overflow-hidden">
              <div class="h-full rounded-full bg-emerald-500 transition-all" style="{{ progressStyle }}"></div>
            </div>

            <div class="space-y-4">
              <div class="flex items-start gap-3">
{{#if step1}}
                <span class="w-6 h-6 shrink-0 rounded-full bg-emerald-500 text-white text-xs flex items-center justify-center">✓</span>
{{/if}}
{{#if not step1}}
                <span class="w-6 h-6 shrink-0 rounded-full border border-slate-300 dark:border-slate-700 text-slate-500 text-xs flex items-center justify-center">1</span>
{{/if}}
                <div>
                  <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">Connect a server</p>
{{#if Billing.locked}}
                  <p class="text-slate-400 text-xs">View only. Pay to continue.</p>
{{/if}}
{{#if not Billing.locked}}
                  <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-xs hover:underline">Add or provision a server</a>
{{/if}}
                </div>
              </div>

              <div class="flex items-start gap-3">
{{#if step2}}
                <span class="w-6 h-6 shrink-0 rounded-full bg-emerald-500 text-white text-xs flex items-center justify-center">✓</span>
{{/if}}
{{#if not step2}}
                <span class="w-6 h-6 shrink-0 rounded-full border border-slate-300 dark:border-slate-700 text-slate-500 text-xs flex items-center justify-center">2</span>
{{/if}}
                <div>
                  <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">Create a site</p>
{{#if Billing.locked}}
                  <p class="text-slate-400 text-xs">View only. Pay to continue.</p>
{{/if}}
{{#if not Billing.locked}}
                  <a href="{{ newSiteHref }}" class="text-emerald-700 dark:text-emerald-500 text-xs hover:underline">Pick a framework and repo</a>
{{/if}}
                </div>
              </div>

              <div class="flex items-start gap-3">
{{#if step3}}
                <span class="w-6 h-6 shrink-0 rounded-full bg-emerald-500 text-white text-xs flex items-center justify-center">✓</span>
{{/if}}
{{#if not step3}}
                <span class="w-6 h-6 shrink-0 rounded-full border border-slate-300 dark:border-slate-700 text-slate-500 text-xs flex items-center justify-center">3</span>
{{/if}}
                <div>
                  <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">Deploy and add SSL</p>
                  <p class="text-slate-500 text-xs">Run your script, then enable Let's Encrypt.</p>
                </div>
              </div>
            </div>
          </div>
{{/if}}

{{#if teamReady}}
{{#if teamCount is not 0}}
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Team</h2>
              <a href="/team" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium">Manage</a>
            </div>
            <div class="space-y-3">
{{#each m in teamMembers}}
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 shrink-0 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white text-xs font-semibold">{{ m.initial }}</div>
                  <div class="min-w-0">
                    <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ m.name }}</p>
                    <p class="text-slate-500 text-xs truncate">{{ m.email }}</p>
                  </div>
                </div>
                <span class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-slate-500">{{ m.roleLabel }}</span>
              </div>
{{/each}}
            </div>
{{#if teamCount is 1}}
            <p class="text-slate-500 text-xs mt-4">It's just you for now. Invite people from the team page.</p>
{{/if}}
          </div>
{{/if}}
{{/if}}

          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Quick actions</h2>
            <div class="grid grid-cols-1 gap-2">
{{#if Billing.locked}}
              <div title="Pay to continue" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-400 cursor-not-allowed select-none">
                New server
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
              </div>
              <div title="Pay to continue" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-400 cursor-not-allowed select-none">
                New site
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
              </div>
{{/if}}
{{#if not Billing.locked}}
              <a href="/servers" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                New server <span class="text-slate-400">&rarr;</span>
              </a>
              <a href="{{ newSiteHref }}" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                New site <span class="text-slate-400">&rarr;</span>
              </a>
{{/if}}
              <a href="/registrars" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                My domains <span class="text-slate-400">&rarr;</span>
              </a>
              <a href="/providers" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                Cloud providers <span class="text-slate-400">&rarr;</span>
              </a>
{{#if Mail.available}}
              <a href="/dashboard/mail" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                Open mail <span class="text-slate-400">&rarr;</span>
              </a>
{{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
{{/if}}

{{#if not checkedAuth}}
<PageLoader label="Loading dashboard" />
{{/if}}