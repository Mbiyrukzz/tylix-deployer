page Dashboard

import { IconServer, IconGlobe, IconPlus, IconArrowUpRight, IconGitCommit, IconMail, IconRocket } from "tylix-icons"

title "Overview"

needs
  Auth

uses
  Servers
  Providers
  Registrars
  Mail
  Billing
  Insights
  Logos

background
  Mail
  Billing

state
  checkedAuth: false
  greeting: ""
  firstName: ""
  todayText: ""
  summary: ""

  fleet: []
  recentSites: []
  attention: []
  baseAttention: []
  domainItems: []
  newSiteHref: "/servers"

  totalServers: 0
  onlineCount: 0
  offlineCount: 0
  pendingCount: 0
  siteCount: 0
  readyCount: 0
  buildingCount: 0
  failedCount: 0

  range: "weekly"
  chartReady: false
  chartFailed: false
  bars: []
  chartBusy: false
  yGrid: []
  avgShow: false
  avgStyle: ""
  avgText: ""
  chartEmpty: false
  yTicks: []
  deployTotal: 0
  deltaText: ""
  deltaUp: true
  hasDelta: false
  compareText: ""
  inProgress: 0
  successRate: -1
  attentionTotal: 0
  recentDeploys: []
  focusIndex: -1
  hoverIndex: -1

  donut: []

  cloudReady: false
  providerCards: []
  domainsReady: false
  registrarCount: 0
  domainCount: 0
  domainsShown: []
  expiringCount: 0
  expiredCount: 0
  teamReady: false
  teamCount: 0
  teamMembers: []

  step1: false
  step2: false
  step3: false
  stepsDone: 0
  setupDone: false

computed
  shownFocus() {
    return this.hoverIndex >= 0 ? this.hoverIndex : this.focusIndex
  }

action
  plural(n, word) {
    if n is 1 {
      return "1 " + word
    }
    return n + " " + word + "s"
  }

  typeLabel(t) {
    const labels = [
      ["tylix", "Tylix"], ["laravel", "Laravel"], ["php", "PHP"], ["nodejs", "Node.js"], ["nextjs", "Next.js"],
      ["wordpress", "WordPress"], ["mern", "MERN"], ["angular", "Angular"], ["fastapi", "FastAPI"], ["django", "Django"],
      ["java", "Java"], ["go", "Go"], ["ruby", "Ruby"], ["dotnet", ".NET"], ["rust", "Rust"], ["static", "Static"]
    ]
    const hit = labels.find((l) => l[0] is t)
    return hit ? hit[1] : (t or "App")
  }

  rows(res) {
    if res.ok and Array.isArray(res.data) {
      return res.data
    }
    if res.ok and res.data and Array.isArray(res.data.data) {
      return res.data.data
    }
    return []
  }

  // Two letters for a project tile: "mailinflow.com" -> "MA", "api.regilient.com" -> "RE".
  monogram(domain) {
    const parts = String(domain or "?").split(".").filter((p) => p.length > 0)
    let word = parts[0] or "?"
    const generic = word is "www" or word is "api" or word is "app" or word is "docs"
    if generic and parts.length > 2 {
      word = parts[1]
    }
    return word.slice(0, 2).toUpperCase()
  }

  tileTone(i) {
    const tones = [
      "bg-emerald-300 text-emerald-950",
      "bg-sky-300 text-sky-950",
      "bg-amber-300 text-amber-950",
      "bg-pink-300 text-pink-950",
      "bg-violet-300 text-violet-950",
      "bg-lime-300 text-lime-950"
    ]
    return tones[i % tones.length]
  }

  sitePill(status) {
    const base = "inline-flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset "
    if status is "ready" {
      return { text: "Ready", cls: base + "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 ring-emerald-500/20", dot: "w-1.5 h-1.5 rounded-full bg-emerald-500" }
    }
    if status is "failed" {
      return { text: "Failed", cls: base + "bg-brand-500/10 text-brand-600 dark:text-brand-400 ring-brand-500/20", dot: "w-1.5 h-1.5 rounded-full bg-brand-500" }
    }
    return { text: "Building", cls: base + "bg-amber-400/10 text-amber-600 dark:text-amber-300 ring-amber-400/25", dot: "w-1.5 h-1.5 rounded-full bg-amber-400 animate-flux-pulse" }
  }

  deployPill(status) {
    const base = "inline-flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset "
    if status is "success" {
      return { text: "Live", cls: base + "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 ring-emerald-500/20" }
    }
    if status is "failed" {
      return { text: "Failed", cls: base + "bg-brand-500/10 text-brand-600 dark:text-brand-400 ring-brand-500/20" }
    }
    if status is "cancelled" {
      return { text: "Cancelled", cls: base + "bg-zinc-500/10 text-zinc-500 ring-zinc-500/20" }
    }
    if status is "queued" {
      return { text: "Queued", cls: base + "bg-zinc-500/10 text-zinc-500 dark:text-zinc-400 ring-zinc-500/20" }
    }
    return { text: "Deploying", cls: base + "bg-amber-400/10 text-amber-600 dark:text-amber-300 ring-amber-400/25" }
  }

  serverDot(status) {
    if status is "online" {
      return "w-2 h-2 rounded-full bg-emerald-500"
    }
    if status is "offline" {
      return "w-2 h-2 rounded-full bg-brand-500"
    }
    return "w-2 h-2 rounded-full bg-amber-400 animate-flux-pulse"
  }

  serverLabel(status) {
    if status is "online" {
      return "Online"
    }
    if status is "offline" {
      return "Offline"
    }
    return "Setting up"
  }

  ago(value) {
    if not value {
      return ""
    }
    const raw = String(value)
    const t = new Date(raw.includes("T") ? raw : raw.replace(" ", "T") + "Z").getTime()
    if Number.isNaN(t) {
      return ""
    }
    const s = Math.max(0, Math.round((Date.now() - t) / 1000))
    if s < 60 {
      return "just now"
    }
    if s < 3600 {
      return Math.round(s / 60) + "m ago"
    }
    if s < 86400 {
      return Math.round(s / 3600) + "h ago"
    }
    return Math.round(s / 86400) + "d ago"
  }

  duration(sec) {
    if sec is null or sec is undefined {
      return ""
    }
    if sec < 60 {
      return sec + "s"
    }
    return Math.floor(sec / 60) + "m " + String(sec % 60).padStart(2, "0") + "s"
  }

  // ---------- deployments chart ----------

  rangeBtn(r) {
    return this.range is r ? "true" : "false"
  }

  async setRange(r) {
    if r is this.range and this.chartReady {
      return null
    }
    this.range = r
    this.chartBusy = true
    await this.loadChart()
    this.chartBusy = false
  }

  // Tap (phones) or hover (mouse) picks the bar the readout describes.
  pickBar(i) {
    this.hoverIndex = i
  }

  readout() {
    const b = this.bars[this.shownFocus]
    if not b {
      return null
    }
    return b
  }

  // Bucket labels from the bucket's ISO key, short enough for a phone:
  // days show the day number (the month only where it starts or changes),
  // weeks their ISO week, months three letters.
  bucketText(b, i, list) {
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    const longMonths = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    const key = String(b.key or "")
    const d = new Date(key.length is 7 ? key + "-01T00:00:00Z" : key + "T00:00:00Z")
    if isNaN(d.getTime()) {
      return { short: String(b.label or ""), sub: "", full: String(b.label or "") }
    }
    const day = d.getUTCDate()
    const mon = months[d.getUTCMonth()]
    if this.range is "daily" {
      const prev = i > 0 ? new Date(String(list[i - 1].key) + "T00:00:00Z") : null
      const newMonth = not prev or prev.getUTCMonth() is not d.getUTCMonth()
      const today = i is list.length - 1
      return {
        short: "" + day,
        sub: newMonth ? mon : "",
        full: (today ? "Today, " : days[d.getUTCDay()] + " ") + day + " " + mon
      }
    }
    if this.range is "monthly" {
      return { short: mon, sub: "", full: longMonths[d.getUTCMonth()] + " " + d.getUTCFullYear() }
    }
    const end = new Date(d.getTime() + 6 * 86400000)
    return {
      short: String(b.label or ""),
      sub: "",
      full: "Week of " + day + " " + mon + " – " + end.getUTCDate() + " " + months[end.getUTCMonth()]
    }
  }

  // On a phone the 14 daily labels don't fit: keep every other one,
  // counting back from today so today is always labelled.
  tickCls(i) {
    const base = "block leading-none whitespace-nowrap tabular-nums "
    const thin = this.range is "daily" and (this.bars.length - 1 - i) % 2 is 1
    return base + (thin ? "hidden sm:block" : "")
  }

  // A round top for the y axis that splits into thirds: 3, 6, 9, 12, 24, 48, 72...
  niceMax(n) {
    if n <= 3 {
      return 3
    }
    const steps = [3, 6, 9, 12, 15, 24, 30, 36, 48, 60, 72, 90, 120, 150, 240, 300, 480, 600, 900, 1200]
    const hit = steps.find((c) => c >= n)
    return hit or Math.ceil(n / 300) * 300
  }

  barCls(i, b) {
    const base = "flux-grow relative block w-[70%] max-w-[40px] overflow-hidden rounded-t-[5px] sm:rounded-t-[7px] rounded-b-[2px] transition-[height,background-color,box-shadow] duration-300 "
    if b.total is 0 {
      return base + "bg-zinc-300 dark:bg-white/[0.16]"
    }
    if i is this.shownFocus {
      return base + "bg-gradient-to-t from-brand-600 to-brand-400 shadow-[0_8px_24px_-8px_rgb(224_57_63/0.75)]"
    }
    return base + "bg-zinc-300 dark:bg-zinc-600 group-hover:bg-zinc-400 dark:group-hover:bg-zinc-500"
  }

  colCls(i) {
    const base = "absolute inset-y-0 -inset-x-px rounded-lg transition-colors "
    return base + (i is this.shownFocus ? "bg-zinc-100 dark:bg-white/[0.035]" : "")
  }

  labelCls(i) {
    if i is this.shownFocus {
      return "flex flex-col items-center gap-0.5 text-[10.5px] sm:text-[11px] font-semibold text-zinc-900 dark:text-zinc-50"
    }
    return "flex flex-col items-center gap-0.5 text-[10.5px] sm:text-[11px] text-zinc-500 dark:text-zinc-400"
  }

  async loadChart() {
    const res = await useApi("/api/insights/deployments?range=" + this.range)
    if not res.ok or not res.data or not Array.isArray(res.data.buckets) {
      this.chartFailed = true
      this.chartReady = true
      return null
    }
    const d = res.data
    const top = Math.max(0, ...d.buckets.map((b) => b.total))
    const max = this.niceMax(top)
    this.yTicks = [max, Math.round(max * 2 / 3), Math.round(max / 3), 0]
    // Grid lines and their labels share one position, so they always line up.
    this.yGrid = [0, 1, 2, 3].map((k) => ({
      v: Math.round(max * k / 3),
      pos: "bottom: " + (k * 100 / 3).toFixed(3) + "%",
      line: k is 0 ? "bg-zinc-300 dark:bg-white/[0.14]" : "bg-zinc-200/80 dark:bg-white/[0.06]"
    }))
    const avg = d.buckets.length ? d.buckets.reduce((a, b) => a + b.total, 0) / d.buckets.length : 0
    // The line only helps when it sits clear of the axis.
    this.avgShow = avg > 0 and avg / max >= 0.08
    this.avgStyle = "bottom: " + (avg / max * 100).toFixed(2) + "%"
    const per = this.range is "daily" ? "a day" : (this.range is "monthly" ? "a month" : "a week")
    this.avgText = (avg >= 10 ? Math.round(avg) : Math.round(avg * 10) / 10) + " " + per
    this.bars = d.buckets.map((b, i) => {
      const text = this.bucketText(b, i, d.buckets)
      const failed = b.failed or 0
      return Object.assign({}, b, text, {
        // Empty periods keep a short visible stub so the axis never looks blank.
        barStyle: (b.total > 0 ? "height: " + Math.max(4, Math.round(b.total / max * 100)) + "%" : "height: 4px") + "; animation-delay: " + (i * 28) + "ms",
        valueStyle: "bottom: calc(" + (b.total > 0 ? Math.max(4, Math.round(b.total / max * 100)) : 0) + "% + 6px)",
        failStyle: "height: " + (b.total > 0 ? Math.round(failed / b.total * 100) : 0) + "%",
        hasFailed: failed > 0,
        aria: text.full + ": " + this.plural(b.total, "deploy") + (failed > 0 ? ", " + failed + " failed" : "")
      })
    })
    this.chartEmpty = d.buckets.every((b) => b.total is 0)
    let focus = -1
    d.buckets.forEach((b, i) => {
      if b.total > 0 and (focus < 0 or b.total >= d.buckets[focus].total) {
        focus = i
      }
    })
    this.focusIndex = focus
    this.hoverIndex = -1
    this.deployTotal = d.total
    this.inProgress = d.in_progress or 0
    this.successRate = typeof d.success_rate is "number" ? d.success_rate : -1

    const prev = d.previous_total or 0
    this.hasDelta = prev > 0
    if prev > 0 {
      const pct = Math.round((d.total - prev) / prev * 1000) / 10
      this.deltaUp = pct >= 0
      this.deltaText = (pct >= 0 ? "▲ " : "▼ ") + Math.abs(pct) + "%"
    }
    let period = "previous 12 weeks"
    if this.range is "daily" {
      period = "previous 14 days"
    } else if this.range is "monthly" {
      period = "previous 12 months"
    }
    const parts = ["vs " + prev + " in the " + period]
    if typeof d.success_rate is "number" {
      parts.push(d.success_rate + "% succeeded")
    }
    this.compareText = parts.join(" · ")

    this.recentDeploys = (d.recent or []).slice(0, 6).map((x) => Object.assign({}, x, {
      pill: this.deployPill(x.status),
      when: this.ago(x.created_at),
      took: this.duration(x.duration_seconds),
      title: x.commit_message or ("Deploy of " + (x.branch or "the default branch")),
      href: "/servers/site-deploy?id=" + x.site_id
    }))
    this.chartFailed = false
    this.chartReady = true
  }

  // ---------- fleet donut ----------

  buildDonut() {
    const total = this.totalServers
    const C = 226.2
    const gap = total > 1 ? 3 : 0
    const parts = [
      { key: "online", label: "Online", value: this.onlineCount, stroke: "#10b981", dot: "bg-emerald-500" },
      { key: "pending", label: "Setting up", value: this.pendingCount, stroke: "#fbbf24", dot: "bg-amber-400" },
      { key: "offline", label: "Offline", value: this.offlineCount, stroke: "#e0393f", dot: "bg-brand-500" }
    ]
    let offset = 0
    this.donut = parts.map((p) => {
      const len = total is 0 ? 0 : p.value / total * C
      const seg = Object.assign({}, p, {
        pct: total is 0 ? 0 : Math.round(p.value / total * 100),
        dash: Math.max(0, len - (p.value > 0 ? gap : 0)) + " " + C,
        offset: String(-offset),
        show: p.value > 0
      })
      offset = offset + len
      return seg
    })
  }

  // ---------- attention ----------

  // Problems are listed in their own card further down the page; the
  // greeting stays a plain status line instead of leading with errors.
  rebuildAttention() {
    const all = this.baseAttention.concat(this.domainItems)
    this.attention = all.slice(0, 6)
    this.attentionTotal = all.length
    const n = all.length
    if this.totalServers is 0 {
      this.summary = "Connect a server to start deploying. It takes about two minutes."
      return null
    }
    const sitesText = this.siteCount is 0 ? "no sites yet" : this.readyCount + " of " + this.plural(this.siteCount, "site") + " live"
    const base = this.onlineCount + " of " + this.plural(this.totalServers, "server") + " online, " + sitesText + "."
    if n is 0 {
      this.summary = base + " Everything is running."
    } else {
      this.summary = base + " " + (n is 1 ? "1 item" : n + " items") + " to look at below."
    }
  }

  // Healthy sites first, then builds in progress, failed ones last; newest first within each.
  siteRank(status) {
    if status is "ready" {
      return 0
    }
    if status is "failed" {
      return 2
    }
    return 1
  }

  kpiSub(parts) {
    return parts.filter((p) => p).join(" · ")
  }

  bottomGridCls() {
    const cards = (this.setupDone ? 0 : 1) + (this.attentionTotal > 0 ? 1 : 0) + 2
    if cards is 3 {
      return "grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4"
    }
    if cards is 4 {
      return "grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-4 gap-4"
    }
    return "grid grid-cols-1 lg:grid-cols-2 gap-4"
  }

  // ---------- connections ----------

  async loadProviders() {
    await Providers.load()
    this.providerCards = Providers.data.slice(0, 4).map((p) => ({
      id: p.id,
      label: p.label or p.kind,
      kind: p.kind,
      logo: Logos.url(p.kind),
      letter: String(p.label or p.kind or "?").charAt(0).toUpperCase(),
      href: "/providers/provider-detail?id=" + p.id
    }))
    this.cloudReady = true
  }

  daysUntil(raw) {
    if not raw {
      return null
    }
    const t = new Date(raw).getTime()
    if Number.isNaN(t) {
      return null
    }
    return Math.ceil((t - Date.now()) / 86400000)
  }

  decorateDomain(d, registrar) {
    const name = d.name or d.domain or d.domain_name or ""
    const raw = d.expires_at or d.expires or d.expiry or d.expiration_date or d.expiresAt or ""
    const days = this.daysUntil(raw)
    let sortDays = 99999
    let text = "No expiry date"
    let cls = "text-zinc-500"
    let note = ""
    if days is not null {
      sortDays = days
      if days < 0 {
        text = "Expired " + Math.abs(days) + "d ago"
        cls = "text-brand-600 dark:text-brand-400"
        note = "expired " + this.plural(Math.abs(days), "day") + " ago"
      } else if days <= 30 {
        text = days + " days left"
        cls = "text-amber-600 dark:text-amber-300"
        note = "expires in " + this.plural(days, "day")
      } else {
        text = days + " days left"
      }
    }
    return { name: name, registrar: registrar, days: sortDays, text: text, cls: cls, note: note }
  }

  domainRows(res) {
    if res.ok and Array.isArray(res.data) {
      return res.data
    }
    if res.ok and res.data and Array.isArray(res.data.domains) {
      return res.data.domains
    }
    return []
  }

  async loadDomains() {
    await Registrars.load()
    const list = Registrars.data
    this.registrarCount = list.length
    if list.length is 0 {
      this.domainsReady = true
      return null
    }
    const loaded = await Promise.all(list.map((r) => useApi("/api/registrars/" + r.id + "/domains").then((res) => ({ r: r, res: res }))))
    const all = loaded.flatMap((l) => {
      const label = l.r.label or l.r.kind
      return this.domainRows(l.res).map((d) => this.decorateDomain(d, label)).filter((d) => d.name is not "")
    })
    all.sort((a, b) => a.days - b.days)
    this.domainCount = all.length
    this.domainsShown = all.slice(0, 5)
    this.expiredCount = all.filter((d) => d.days < 0).length
    this.expiringCount = all.filter((d) => d.days >= 0 and d.days <= 30).length
    this.domainItems = all
      .filter((d) => d.days <= 30)
      .slice(0, 3)
      .map((d) => ({ tone: d.days < 0 ? "error" : "warn", text: d.name + " " + d.note, hint: "Renew at " + d.registrar, short: d.name + " " + d.note, href: "/registrars" }))
    this.rebuildAttention()
    this.domainsReady = true
  }

  initial(m) {
    return String(m.name or m.email or "?").charAt(0).toUpperCase()
  }

  async loadTeam() {
    const res = await useApi("/api/team/members")
    if res.ok and res.data and Array.isArray(res.data.members) {
      this.teamCount = res.data.members.length
      this.teamMembers = res.data.members.slice(0, 5).map((m) => Object.assign({}, m, {
        letter: this.initial(m),
        roleText: String(m.role or "member").charAt(0).toUpperCase() + String(m.role or "member").slice(1)
      }))
    }
    this.teamReady = true
  }

  attentionDot(tone) {
    if tone is "error" {
      return "mt-1.5 w-2 h-2 shrink-0 rounded-full bg-brand-500"
    }
    return "mt-1.5 w-2 h-2 shrink-0 rounded-full bg-amber-400"
  }

  stepCls(done) {
    if done {
      return "w-6 h-6 shrink-0 rounded-full bg-emerald-500 text-white flex items-center justify-center"
    }
    return "w-6 h-6 shrink-0 rounded-full border border-line-strong text-zinc-400 flex items-center justify-center text-[11px] font-semibold"
  }

  progressStyle() {
    return "width:" + Math.round(this.stepsDone / 3 * 100) + "%"
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const now = new Date()
    this.todayText = now.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" })
    const hour = now.getHours()
    let greeting = "Good evening"
    if hour < 12 {
      greeting = "Good morning"
    } else if hour < 18 {
      greeting = "Good afternoon"
    }
    this.greeting = greeting
    this.firstName = String(Auth.user.name or "").split(" ")[0] or "there"

    const chartLoad = this.loadChart()
    const serversLoad = Servers.load()
    const sitesRes = await useApi("/api/sites")
    await serversLoad

    const list = Servers.data
    const sites = this.rows(sitesRes)

    this.totalServers = list.length
    this.onlineCount = list.filter((s) => s.status is "online").length
    this.offlineCount = list.filter((s) => s.status is "offline").length
    this.pendingCount = this.totalServers - this.onlineCount - this.offlineCount
    this.siteCount = sites.length
    this.readyCount = sites.filter((x) => x.status is "ready").length
    this.failedCount = sites.filter((x) => x.status is "failed").length
    this.buildingCount = sites.filter((x) => x.status is "creating" or x.status is "pending" or x.status is "deploying").length
    this.newSiteHref = list.length is 1 ? "/servers/server-sites?id=" + list[0].id : "/servers"

    this.fleet = list.slice(0, 6).map((s) => ({
      id: s.id,
      name: s.name,
      ip: s.ip_address or s.ip or "",
      status: s.status,
      dot: this.serverDot(s.status),
      label: this.serverLabel(s.status),
      sites: this.plural(sites.filter((x) => x.server_id is s.id).length, "site"),
      href: "/servers/server-detail?id=" + s.id
    }))

    Insights.analyze(list, sites)
    this.buildDonut()

    const byRecent = sites.slice().sort((a, b) => {
      const rank = this.siteRank(a.status) - this.siteRank(b.status)
      if rank is not 0 {
        return rank
      }
      return String(b.updated_at or b.created_at or "").localeCompare(String(a.updated_at or a.created_at or ""))
    })
    this.recentSites = byRecent.slice(0, 5).map((x, i) => {
      const host = list.find((s) => s.id is x.server_id)
      return {
        id: x.id,
        domain: x.domain,
        mono: this.monogram(x.domain),
        tone: this.tileTone(i),
        meta: this.typeLabel(x.type) + " · " + (host ? host.name : "Unknown server"),
        pill: this.sitePill(x.status),
        href: "/servers/site-detail?id=" + x.id
      }
    })

    const offline = list.filter((s) => s.status is "offline").map((s) => ({
      tone: "error", text: s.name + " is offline", hint: "Check the server's connection", short: s.name + " is offline", href: "/servers/server-detail?id=" + s.id
    }))
    const failed = sites.filter((x) => x.status is "failed").map((x) => ({
      tone: "error", text: x.domain + " failed to deploy", hint: "Open the deployment log", short: x.domain + " failed to deploy", href: "/servers/site-deploy?id=" + x.id
    }))
    const building = sites.filter((x) => x.status is "creating" or x.status is "pending").map((x) => ({
      tone: "warn", text: x.domain + " is being set up", hint: "It goes live on its own", short: "a build in progress on " + x.domain, href: "/servers/site-detail?id=" + x.id
    }))
    this.baseAttention = offline.concat(failed).concat(building)
    this.rebuildAttention()

    this.step1 = this.totalServers > 0
    this.step2 = sites.length > 0
    this.step3 = this.readyCount > 0
    this.stepsDone = [this.step1, this.step2, this.step3].filter((x) => x).length
    this.setupDone = this.stepsDone is 3

    await chartLoad
    this.checkedAuth = true

    this.loadProviders()
    this.loadDomains()
    this.loadTeam()
  }

template
{{#if checkedAuth}}
<div class="min-w-0 px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
  <div class="max-w-[1440px] mx-auto">

    <LockedBanner />

    <header class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-7">
      <div class="min-w-0">
        <p class="flux-eyebrow mb-2">{{ todayText }}</p>
        <h1 class="text-[26px] sm:text-[30px] leading-tight font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">{{ greeting }}, {{ firstName }}</h1>
        <p class="text-zinc-500 text-sm mt-1.5 max-w-2xl">{{ summary }}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
{{#if Billing.locked}}
        <span class="inline-flex items-center gap-1.5 h-9 rounded-full border border-line px-4 text-sm text-zinc-500 cursor-not-allowed" title="Pay to continue">New site</span>
        <span class="inline-flex items-center gap-1.5 h-9 rounded-full border border-line px-4 text-sm text-zinc-500 cursor-not-allowed" title="Pay to continue">Create server</span>
{{/if}}
{{#if not Billing.locked}}
        <a href="{{ newSiteHref }}" class="inline-flex items-center gap-1.5 h-9 rounded-full border border-line bg-panel px-4 text-sm font-medium text-zinc-800 dark:text-zinc-200 hover:border-line-strong transition-colors"><IconRocket class="w-4 h-4 text-zinc-400" /> New site</a>
        <a href="/servers/create" class="inline-flex items-center gap-1.5 h-9 rounded-full bg-brand-500 px-4 text-sm font-semibold text-white hover:bg-brand-600 transition-colors"><IconPlus class="w-4 h-4" /> Create server</a>
{{/if}}
      </div>
    </header>

    <section aria-label="At a glance" class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 mb-4">
      <a href="/servers" class="group rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 hover:border-line-strong transition-colors min-w-0">
        <p class="flex items-center justify-between text-xs text-zinc-500"><span>Servers online</span><IconServer class="w-4 h-4 text-zinc-400 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /></p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ onlineCount }}<span class="text-base font-medium text-zinc-400"> / {{ totalServers }}</span></p>
        <p class="mt-2 text-[11px] text-zinc-500 truncate">{{ kpiSub([pendingCount ? pendingCount + " setting up" : "", offlineCount ? offlineCount + " offline" : ""]) or (totalServers ? "All reachable" : "None connected yet") }}</p>
      </a>
      <a href="/servers" class="group rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 hover:border-line-strong transition-colors min-w-0">
        <p class="flex items-center justify-between text-xs text-zinc-500"><span>Sites live</span><IconRocket class="w-4 h-4 text-zinc-400 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /></p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ readyCount }}<span class="text-base font-medium text-zinc-400"> / {{ siteCount }}</span></p>
        <p class="mt-2 text-[11px] text-zinc-500 truncate">{{ kpiSub([buildingCount ? buildingCount + " building" : "", failedCount ? failedCount + " need a redeploy" : ""]) or (siteCount ? "All deployed" : "Nothing deployed yet") }}</p>
      </a>
      <div class="rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 min-w-0">
        <p class="flex items-center justify-between text-xs text-zinc-500"><span>Deploys this period</span><IconGitCommit class="w-4 h-4 text-zinc-400" /></p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ deployTotal }}</p>
        <p class="mt-2 text-[11px] text-zinc-500 truncate">{{ kpiSub([successRate >= 0 ? successRate + "% succeeded" : "", inProgress ? inProgress + " in progress" : ""]) or "No deploys yet" }}</p>
      </div>
      <a href="/registrars" class="group rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 hover:border-line-strong transition-colors min-w-0">
        <p class="flex items-center justify-between text-xs text-zinc-500"><span>Domains</span><IconGlobe class="w-4 h-4 text-zinc-400 group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors" /></p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ domainsReady ? domainCount : "–" }}</p>
        <p class="mt-2 text-[11px] text-zinc-500 truncate">{{ not domainsReady ? "Checking registrars…" : (kpiSub([expiringCount ? expiringCount + " renew soon" : "", expiredCount ? expiredCount + " expired" : ""]) or (registrarCount ? "Nothing due" : "No registrar connected")) }}</p>
      </a>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-4">

      <section class="xl:col-span-2 rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Deployments across projects</h2>
          <div class="flux-segmented" role="group" aria-label="Range">
            <button aria-pressed="{{ rangeBtn('daily') }}" onclick="{{ setRange('daily') }}">Daily</button>
            <button aria-pressed="{{ rangeBtn('weekly') }}" onclick="{{ setRange('weekly') }}">Weekly</button>
            <button aria-pressed="{{ rangeBtn('monthly') }}" onclick="{{ setRange('monthly') }}">Monthly</button>
          </div>
        </div>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mt-5">
          <p class="text-[40px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ deployTotal }}</p>
{{#if hasDelta}}
          <span class="{{ deltaUp ? 'flux-pill bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'flux-pill bg-brand-500/10 text-brand-600 dark:text-brand-400' }}">{{ deltaText }}</span>
{{/if}}
          <p class="text-xs text-zinc-500">{{ compareText }}</p>
{{#if inProgress > 0}}
          <span class="flux-pill bg-amber-400/10 text-amber-600 dark:text-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-flux-pulse"></span>{{ inProgress }} in progress</span>
{{/if}}
        </div>

{{#if chartFailed}}
        <div class="h-60 mt-6 rounded-xl border border-dashed border-line flex flex-col items-center justify-center text-center px-6">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Deployment history isn't available right now</p>
          <button onclick="{{ loadChart() }}" class="mt-2 text-sm text-brand-600 dark:text-brand-400 hover:underline">Try again</button>
        </div>
{{/if}}
{{#if not chartFailed}}
        <!-- What the picked bar holds: hover on desktop, tap on a phone. -->
        <div class="mt-6 flex items-center justify-between gap-3 min-h-[34px] rounded-xl bg-sunken px-3 py-2" aria-live="polite">
{{#if readout()}}
          <p class="min-w-0 truncate text-[12.5px] font-medium text-zinc-900 dark:text-zinc-100">{{ readout().full }}</p>
          <p class="shrink-0 flex items-center gap-3 text-[12px] tabular-nums">
            <span class="flex items-center gap-1.5 text-zinc-700 dark:text-zinc-200"><span class="w-2 h-2 rounded-[3px] bg-brand-500"></span>{{ plural(readout().total, "deploy") }}</span>
{{#if readout().hasFailed}}
            <span class="flex items-center gap-1.5 text-rose-600 dark:text-rose-400"><span class="w-2 h-2 rounded-[3px] bg-rose-950 dark:bg-rose-300"></span>{{ readout().failed }} failed</span>
{{/if}}
          </p>
{{#else}}
          <p class="text-[12.5px] text-zinc-500 dark:text-zinc-400">Tap or hover a bar for details</p>
{{/if}}
        </div>

        <!-- Every piece is absolutely placed inside a box of fixed height, so
             bar heights (percentages) resolve the same in every browser. -->
        <div class="{{ chartBusy ? 'relative mt-4 h-60 sm:h-72 opacity-50 transition-opacity' : 'relative mt-4 h-60 sm:h-72 transition-opacity' }}" onmouseleave="{{ hoverIndex = -1 }}">
          <div class="absolute left-8 sm:left-10 right-0 top-4 bottom-9">
{{#each g in yGrid}}
            <div class="absolute inset-x-0 h-px {{ g.line }}" style="{{ g.pos }}" aria-hidden="true"></div>
            <span class="absolute -left-8 sm:-left-10 w-6 sm:w-8 text-right translate-y-1/2 leading-none text-[10.5px] sm:text-[11px] text-zinc-500 dark:text-zinc-400 tabular-nums" style="{{ g.pos }}" aria-hidden="true">{{ g.v }}</span>
{{/each}}

            <div class="absolute inset-0 flex gap-1 sm:gap-2" role="group" aria-label="Deploys per period">
{{#each b, i in bars}}
              <div class="group relative flex-1 min-w-0 h-full">
                <span class="{{ colCls(i) }}" aria-hidden="true"></span>
                <span class="absolute inset-0 flex items-end justify-center" aria-hidden="true">
                  <span class="{{ barCls(i, b) }}" style="{{ b.barStyle }}">
{{#if b.hasFailed}}
                    <span class="absolute inset-x-0 top-0 bg-rose-950/75 dark:bg-rose-300/90" style="{{ b.failStyle }}"></span>
{{/if}}
                  </span>
                </span>
{{#if i is shownFocus}}
{{#if b.total > 0}}
                <span class="absolute inset-x-0 text-center leading-none text-[11px] font-semibold text-zinc-900 dark:text-zinc-50 tabular-nums pointer-events-none" style="{{ b.valueStyle }}" aria-hidden="true">{{ b.total }}</span>
{{/if}}
{{/if}}
                <button type="button" onclick="{{ pickBar(i) }}" onmouseenter="{{ pickBar(i) }}" onfocus="{{ pickBar(i) }}" aria-label="{{ b.aria }}" aria-pressed="{{ i is shownFocus }}" class="absolute inset-0 w-full h-full rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500/50"></button>
              </div>
{{/each}}
            </div>

{{#if avgShow}}
            <div class="absolute inset-x-0 border-t border-dashed border-zinc-400/80 dark:border-zinc-400/60 pointer-events-none" style="{{ avgStyle }}" aria-hidden="true"></div>
{{/if}}

{{#if chartEmpty}}
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <p class="rounded-full border border-line bg-panel px-3 py-1.5 text-xs text-zinc-600 dark:text-zinc-300 shadow-sm">No deploys in this period yet</p>
            </div>
{{/if}}
          </div>

          <div class="absolute left-8 sm:left-10 right-0 bottom-0 h-9 flex gap-1 sm:gap-2" aria-hidden="true">
{{#each b, i in bars}}
            <div class="flex-1 min-w-0 pt-2 {{ labelCls(i) }}">
              <span class="{{ tickCls(i) }}">{{ b.short }}</span>
              <span class="block leading-none text-[9.5px] uppercase tracking-wide text-zinc-400 dark:text-zinc-500">{{ b.sub }}</span>
            </div>
{{/each}}
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11.5px] text-zinc-600 dark:text-zinc-300">
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-[3px] bg-zinc-300 dark:bg-zinc-600"></span>Deploys</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-[3px] bg-rose-950/75 dark:bg-rose-300/90"></span>Failed</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-[3px] bg-gradient-to-t from-brand-600 to-brand-400"></span>Selected</span>
{{#if deployTotal > 0}}
          <span class="flex items-center gap-1.5"><span class="w-3.5 border-t border-dashed border-zinc-500"></span>Average <span class="font-medium text-zinc-900 dark:text-zinc-100 tabular-nums">{{ avgText }}</span></span>
{{/if}}
        </div>
{{/if}}
      </section>

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6 flex flex-col">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Fleet health</h2>
          <a href="/servers" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-4">View servers</a>
        </div>
        <div class="flex-1 flex flex-col sm:flex-row xl:flex-col items-center gap-6 mt-5">
          <div class="relative w-44 h-44 shrink-0">
            <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
              <circle cx="50" cy="50" r="36" fill="none" stroke-width="11" class="stroke-zinc-200 dark:stroke-white/[0.06]" />
{{#each seg in donut}}
{{#if seg.show}}
              <circle cx="50" cy="50" r="36" fill="none" stroke-width="11" stroke="{{ seg.stroke }}" stroke-dasharray="{{ seg.dash }}" stroke-dashoffset="{{ seg.offset }}" class="transition-all duration-500" />
{{/if}}
{{/each}}
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
              <span class="text-[28px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ Insights.healthPct }}%</span>
              <span class="text-[11px] text-zinc-500 mt-1">of {{ plural(totalServers, "server") }} online</span>
            </div>
          </div>
          <ul class="w-full space-y-2.5">
{{#each seg in donut}}
            <li class="flex items-center gap-2.5 text-sm">
              <span class="w-2 h-2 rounded-full {{ seg.dot }}"></span>
              <span class="text-zinc-700 dark:text-zinc-300">{{ seg.label }}</span>
              <span class="text-zinc-500 tabular-nums">{{ seg.pct }}%</span>
              <span class="ml-auto text-zinc-900 dark:text-zinc-100 font-medium tabular-nums">{{ seg.value }}</span>
            </li>
{{/each}}
            <li class="flex items-center gap-2.5 text-sm pt-2.5 border-t border-line">
              <span class="text-zinc-500">Busiest</span>
              <span class="ml-auto text-zinc-900 dark:text-zinc-100 font-medium truncate max-w-[70%] text-right">{{ Insights.busiest }}</span>
            </li>
          </ul>
        </div>
      </section>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4 mb-4">

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Recently active projects</h2>
          <a href="/servers" class="text-xs text-brand-600 dark:text-brand-400 underline underline-offset-4">View all</a>
        </div>
{{#if siteCount is 0}}
        <div class="rounded-xl border border-dashed border-line px-5 py-10 text-center">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Nothing deployed yet</p>
          <p class="text-xs text-zinc-500 mt-1">Create a site on a server and it shows up here.</p>
{{#if not Billing.locked}}
          <a href="{{ newSiteHref }}" class="inline-flex items-center gap-1.5 mt-4 h-8 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 px-3.5 text-xs font-semibold">New site</a>
{{/if}}
        </div>
{{/if}}
        <ul class="space-y-1">
{{#each p in recentSites}}
          <li>
            <a href="{{ p.href }}" class="flex items-center gap-3 rounded-xl -mx-2 px-2 py-2 hover:bg-zinc-50 dark:hover:bg-white/[0.03] transition-colors">
              <span class="w-9 h-9 shrink-0 rounded-[10px] text-[11px] font-bold flex items-center justify-center {{ p.tone }}">{{ p.mono }}</span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-zinc-900 dark:text-zinc-100 truncate">{{ p.domain }}</span>
                <span class="block text-xs text-zinc-500 font-mono truncate">{{ p.meta }}</span>
              </span>
              <span class="{{ p.pill.cls }}"><span class="{{ p.pill.dot }}"></span>{{ p.pill.text }}</span>
            </a>
          </li>
{{/each}}
        </ul>
      </section>

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Latest deployments</h2>
          <span class="text-xs text-zinc-500">{{ plural(deployTotal, "deploy") }} this period</span>
        </div>
{{#if recentDeploys.length is 0}}
        <div class="rounded-xl border border-dashed border-line px-5 py-10 text-center">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">No deployments yet</p>
          <p class="text-xs text-zinc-500 mt-1">Every push you deploy lands here with its commit.</p>
        </div>
{{/if}}
        <ul class="divide-y divide-line">
{{#each d in recentDeploys}}
          <li>
            <a href="{{ d.href }}" class="flex items-start gap-3 py-2.5 group">
              <span class="mt-0.5 w-7 h-7 shrink-0 rounded-lg border border-line bg-sunken flex items-center justify-center text-zinc-400"><IconGitCommit class="w-4 h-4" /></span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm text-zinc-900 dark:text-zinc-100 truncate group-hover:underline underline-offset-4">{{ d.title }}</span>
                <span class="flex items-center gap-1.5 text-[11px] text-zinc-500 mt-0.5 min-w-0">
                  <span class="truncate">{{ d.domain }}</span>
{{#if d.commit}}
                  <span class="text-zinc-400 dark:text-zinc-600">·</span>
                  <span class="font-mono">{{ d.commit }}</span>
{{/if}}
{{#if d.took}}
                  <span class="text-zinc-400 dark:text-zinc-600">·</span>
                  <span class="tabular-nums">{{ d.took }}</span>
{{/if}}
                </span>
              </span>
              <span class="flex flex-col items-end gap-1 shrink-0">
                <span class="{{ d.pill.cls }}">{{ d.pill.text }}</span>
                <span class="text-[11px] text-zinc-500">{{ d.when }}</span>
              </span>
            </a>
          </li>
{{/each}}
        </ul>
      </section>

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6 lg:col-span-2 xl:col-span-1">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Servers</h2>
          <a href="/servers" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-4">All {{ totalServers }}</a>
        </div>
{{#if totalServers is 0}}
        <div class="rounded-xl border border-dashed border-line px-5 py-10 text-center">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">No servers yet</p>
          <p class="text-xs text-zinc-500 mt-1">Create one on a connected cloud, or add one you already run.</p>
{{#if not Billing.locked}}
          <a href="/servers/create" class="inline-flex items-center gap-1.5 mt-4 h-8 rounded-full bg-brand-500 text-white px-3.5 text-xs font-semibold">Create server</a>
{{/if}}
        </div>
{{/if}}
        <ul class="space-y-1">
{{#each s in fleet}}
          <li>
            <a href="{{ s.href }}" class="flex items-center gap-3 rounded-xl -mx-2 px-2 py-2 hover:bg-zinc-50 dark:hover:bg-white/[0.03] transition-colors">
              <span class="relative w-9 h-9 shrink-0 rounded-[10px] border border-line bg-sunken flex items-center justify-center text-zinc-500">
                <IconServer class="w-4 h-4" />
                <span class="absolute -bottom-0.5 -right-0.5 p-[2px] rounded-full bg-panel"><span class="block {{ s.dot }}"></span></span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-zinc-900 dark:text-zinc-100 truncate">{{ s.name }}</span>
                <span class="block text-xs text-zinc-500 font-mono truncate">{{ s.ip or s.label }}</span>
              </span>
              <span class="text-xs text-zinc-500 shrink-0">{{ s.sites }}</span>
            </a>
          </li>
{{/each}}
        </ul>
      </section>
    </div>

    <div class="{{ bottomGridCls() }}">

{{#if attentionTotal > 0}}
      <section aria-label="Needs attention" class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Needs attention</h2>
          <span class="text-xs text-zinc-500 tabular-nums">{{ attentionTotal }}</span>
        </div>
        <ul class="divide-y divide-line">
{{#each item in attention}}
          <li>
            <a href="{{ item.href }}" class="group flex items-start gap-3 py-2.5">
              <span class="{{ attentionDot(item.tone) }}"></span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm text-zinc-900 dark:text-zinc-100 truncate group-hover:underline underline-offset-4">{{ item.text }}</span>
                <span class="block text-[11px] text-zinc-500 mt-0.5 truncate">{{ item.hint }}</span>
              </span>
              <IconArrowUpRight class="w-4 h-4 mt-0.5 shrink-0 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors" />
            </a>
          </li>
{{/each}}
        </ul>
{{#if attentionTotal > attention.length}}
        <p class="text-[11px] text-zinc-500 mt-2">And {{ attentionTotal - attention.length }} more.</p>
{{/if}}
      </section>
{{/if}}

{{#if not setupDone}}
      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Get to your first deploy</h2>
          <span class="text-xs text-zinc-500 tabular-nums">{{ stepsDone }} of 3</span>
        </div>
        <div class="h-1 rounded-full bg-zinc-200 dark:bg-white/[0.06] mt-4 overflow-hidden">
          <div class="h-full rounded-full bg-brand-500 transition-all duration-500" style="{{ progressStyle() }}"></div>
        </div>
        <ol class="mt-5 space-y-4">
          <li class="flex items-start gap-3">
            <span class="{{ stepCls(step1) }}">{{ step1 ? '✓' : '1' }}</span>
            <div class="min-w-0"><a href="/servers" class="text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4">Connect a server</a><p class="text-xs text-zinc-500 mt-0.5">Create one on a cloud provider or add your own.</p></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="{{ stepCls(step2) }}">{{ step2 ? '✓' : '2' }}</span>
            <div class="min-w-0"><a href="{{ newSiteHref }}" class="text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:underline underline-offset-4">Create a site</a><p class="text-xs text-zinc-500 mt-0.5">Point a domain at a repository.</p></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="{{ stepCls(step3) }}">{{ step3 ? '✓' : '3' }}</span>
            <div class="min-w-0"><p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Go live</p><p class="text-xs text-zinc-500 mt-0.5">Deploy once; SSL is set up for you.</p></div>
          </li>
        </ol>
      </section>
{{/if}}

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Domains</h2>
          <a href="/registrars" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-4">{{ domainCount ? 'All ' + domainCount : 'Registrars' }}</a>
        </div>
{{#if not domainsReady}}
        <div class="space-y-2">
          <div class="h-10 rounded-xl bg-zinc-100 dark:bg-white/[0.03] animate-pulse"></div>
          <div class="h-10 rounded-xl bg-zinc-100 dark:bg-white/[0.03] animate-pulse"></div>
        </div>
{{/if}}
{{#if domainsReady}}
{{#if registrarCount is 0}}
        <div class="rounded-xl border border-dashed border-line px-5 py-8 text-center">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">No registrar connected</p>
          <p class="text-xs text-zinc-500 mt-1">Connect one to manage DNS and renewals here.</p>
          <a href="/registrars" class="inline-block mt-3 text-xs text-brand-600 dark:text-brand-400 underline underline-offset-4">Connect a registrar</a>
        </div>
{{/if}}
{{#if registrarCount is not 0}}
        <div class="flex items-center gap-2 mb-3">
          <span class="flux-pill bg-amber-400/10 text-amber-600 dark:text-amber-300">{{ expiringCount }} expiring</span>
          <span class="flux-pill bg-brand-500/10 text-brand-600 dark:text-brand-400">{{ expiredCount }} expired</span>
        </div>
        <ul class="divide-y divide-line">
{{#each d in domainsShown}}
          <li class="flex items-center gap-3 py-2.5">
            <IconGlobe class="w-4 h-4 shrink-0 text-zinc-400" />
            <span class="min-w-0 flex-1">
              <span class="block text-sm text-zinc-900 dark:text-zinc-100 truncate">{{ d.name }}</span>
              <span class="block text-[11px] text-zinc-500 truncate">{{ d.registrar }}</span>
            </span>
            <span class="text-xs shrink-0 tabular-nums {{ d.cls }}">{{ d.text }}</span>
          </li>
{{#else}}
          <li class="py-6 text-center text-xs text-zinc-500">No domains found at your registrars.</li>
{{/each}}
        </ul>
{{/if}}
{{/if}}
      </section>

      <section class="rounded-2xl border border-line bg-panel p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">Cloud accounts</h2>
          <a href="/providers" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 underline underline-offset-4">Manage</a>
        </div>
{{#if not cloudReady}}
        <div class="grid grid-cols-2 gap-2">
          <div class="h-16 rounded-xl bg-zinc-100 dark:bg-white/[0.03] animate-pulse"></div>
          <div class="h-16 rounded-xl bg-zinc-100 dark:bg-white/[0.03] animate-pulse"></div>
        </div>
{{/if}}
{{#if cloudReady}}
{{#if providerCards.length is 0}}
        <div class="rounded-xl border border-dashed border-line px-5 py-8 text-center">
          <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">No cloud connected</p>
          <p class="text-xs text-zinc-500 mt-1">AWS, Hetzner, DigitalOcean, Vultr, Linode and more.</p>
          <a href="/providers" class="inline-block mt-3 text-xs text-brand-600 dark:text-brand-400 underline underline-offset-4">Connect a provider</a>
        </div>
{{/if}}
        <div class="grid grid-cols-2 gap-2">
{{#each c in providerCards}}
          <a href="{{ c.href }}" class="flex items-center gap-2.5 rounded-xl border border-line bg-sunken px-3 py-3 hover:border-line-strong transition-colors min-w-0">
{{#if c.logo}}
            <img src="{{ c.logo }}" alt="" class="w-7 h-7 shrink-0 rounded-md object-contain" />
{{/if}}
{{#if not c.logo}}
            <span class="w-7 h-7 shrink-0 rounded-md bg-zinc-200 dark:bg-white/[0.06] text-xs font-semibold flex items-center justify-center">{{ c.letter }}</span>
{{/if}}
            <span class="min-w-0">
              <span class="block text-sm font-medium text-zinc-900 dark:text-zinc-100 truncate">{{ c.label }}</span>
              <span class="block text-[11px] text-zinc-500 truncate">{{ c.kind }}</span>
            </span>
          </a>
{{/each}}
        </div>
{{/if}}
{{#if teamReady}}
{{#if teamCount > 0}}
        <div class="mt-5 pt-4 border-t border-line flex items-center gap-3">
          <div class="flex -space-x-2">
{{#each m in teamMembers}}
            <span title="{{ m.roleText }}" class="w-7 h-7 rounded-full ring-2 ring-white dark:ring-[#111113] bg-zinc-900 text-white dark:bg-zinc-200 dark:text-zinc-900 text-[11px] font-semibold flex items-center justify-center">{{ m.letter }}</span>
{{/each}}
          </div>
          <a href="/team" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100">{{ plural(teamCount, "member") }} on your team</a>
{{#if Mail.available}}
          <a href="/dashboard/mail" class="ml-auto inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100"><IconMail class="w-3.5 h-3.5" /> {{ Mail.unread }} mail</a>
{{/if}}
        </div>
{{/if}}
{{/if}}
      </section>
    </div>

  </div>
</div>
{{/if}}
{{#if not checkedAuth}}
<PageLoader label="Loading your overview" />
{{/if}}
