page ProviderList

import { IconArrowLeft } from "tylix-icons"

title "Cloud providers"

needs
  Auth

uses
  Providers

state
  checkedAuth: false
  items: []
  linodeCount: 0
  hetznerCount: 0
  doCount: 0
  vultrCount: 0
  awsCount: 0
  serverCount: 0
  removing: 0
  removeError: ""

action
  // Adds display-only fields to a connection: how many servers still use it,
  // plus the label and tile colours for its provider.
  decorate(p, rows) {
    // REF: has_instance comes from /api/provisions and works for numeric ids
    // (Linode, Hetzner, DigitalOcean), UUIDs (Vultr) and region/id refs (AWS). The old
    // Number(r.instance_id) > 0 test would miss Vultr and AWS machines.
    const used = rows.filter((r) => r.provider_id is p.id and r.has_instance and r.status is not "deleted").length

    let usageText = used + " servers"
    if used is 0 {
      usageText = "No servers yet"
    }
    if used is 1 {
      usageText = "1 server"
    }

    // Linode is the default; each other provider overrides name, letter and colour.
    let kindName = "Linode (Akamai)"
    let tileLetter = "L"
    let tileClass = "w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-lg font-bold bg-emerald-500/10 text-emerald-700 dark:text-emerald-500"
    if p.kind is "hetzner" {
      kindName = "Hetzner Cloud"
      tileLetter = "H"
      tileClass = "w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-lg font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    // DIGITALOCEAN
    if p.kind is "digitalocean" {
      kindName = "DigitalOcean"
      tileLetter = "D"
      tileClass = "w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-lg font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    // VULTR
    if p.kind is "vultr" {
      kindName = "Vultr"
      tileLetter = "V"
      tileClass = "w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-lg font-bold bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    // AWS
    if p.kind is "aws" {
      kindName = "Amazon Web Services"
      tileLetter = "A"
      tileClass = "w-11 h-11 shrink-0 rounded-xl flex items-center justify-center text-lg font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400"
    }

    let since = "-"
    if p.created_at {
      since = p.created_at.slice(0, 10)
    }

    return Object.assign({}, p, { inUse: used, usageText: usageText, kindName: kindName, tileLetter: tileLetter, tileClass: tileClass, since: since })
  }

  // Rebuilds the cards and the stat row from the loaded connections.
  async refresh() {
    const prov = await useApi("/api/provisions")
    let rows = []
    if prov.ok and Array.isArray(prov.data) {
      rows = prov.data
    }
    const list = Providers.data.map((p) => this.decorate(p, rows))

    this.items = list
    this.linodeCount = list.filter((p) => p.kind is "linode").length
    this.hetznerCount = list.filter((p) => p.kind is "hetzner").length
    // DIGITALOCEAN
    this.doCount = list.filter((p) => p.kind is "digitalocean").length
    // VULTR
    this.vultrCount = list.filter((p) => p.kind is "vultr").length
    // AWS
    this.awsCount = list.filter((p) => p.kind is "aws").length
    this.serverCount = list.reduce((n, p) => n + p.inUse, 0)
  }

  async addProvider(provider) {
    Providers.add(provider)
    await this.refresh()
  }

  async updateProvider(provider) {
    await Providers.replace(provider)
    await this.refresh()
  }

  askRemove(id) {
    this.removeError = ""
    this.removing = id
  }

  cancelRemove() {
    this.removing = 0
  }

  async confirmRemove(id) {
    const result = await Providers.remove(id)
    if not result.ok {
      this.removeError = result.data?.error or "Couldn't remove that connection."
    }
    this.removing = 0
    await this.refresh()
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Providers.load()
    await this.refresh()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
<div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
  <Sidebar active="providers" />
  <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Dashboard
      </a>

      <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Cloud providers</h1>
          <p class="text-slate-500 text-sm">Accounts the deployer can create servers in.</p>
        </div>
        <ProviderForm onSaved="{{ addProvider }}" />
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Connections</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ items.length }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Linode</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ linodeCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Hetzner</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ hetznerCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">DigitalOcean</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ doCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Vultr</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ vultrCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">AWS</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ awsCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Servers created</p>
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ serverCount }}</p>
        </div>
      </div>

{{#if removeError}}
      <div role="alert" class="rounded-xl border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-4">
        <p class="text-rose-800 dark:text-rose-400 text-sm">{{ removeError }}</p>
      </div>
{{/if}}

{{#if items.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-10 text-center">
        <div class="flex items-center justify-center gap-3 mb-4">
          <span class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-700 dark:text-emerald-500 flex items-center justify-center text-lg font-bold">L</span>
          <span class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg font-bold">H</span>
          <span class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-lg font-bold">D</span>
          <span class="w-12 h-12 rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-400 flex items-center justify-center text-lg font-bold">V</span>
          <span class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold">A</span>
        </div>
        <h2 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No providers connected</h2>
        <p class="text-slate-500 text-sm max-w-sm mx-auto mb-5">Connect a Linode, Hetzner, DigitalOcean, Vultr or AWS account to create servers from here. You only need an API token, or an access key for AWS.</p>
        <ProviderForm onSaved="{{ addProvider }}" />
      </div>
{{/if}}

{{#if items.length is not 0}}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
{{#each p in items}}
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">

          <div class="flex items-start justify-between gap-3 mb-5">
            <div class="flex items-center gap-3 min-w-0">
              <span class="{{ p.tileClass }}">{{ p.tileLetter }}</span>
              <div class="min-w-0">
                <h3 class="text-slate-900 dark:text-slate-100 font-semibold truncate">{{ p.label }}</h3>
                <p class="text-slate-500 text-xs">{{ p.kindName }}</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> {{ p.status }}
            </span>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-5">
            <div>
              <p class="text-slate-500 text-xs mb-1">Servers</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm">{{ p.usageText }}</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">Connected</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm">{{ p.since }}</p>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-5 border-t border-slate-200 dark:border-slate-800">
            
                        <a href="{{ '/providers/provider-detail?id=' + p.id }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">Manage</a>
            <ProviderForm provider="{{ p }}" onSaved="{{ updateProvider }}" />

{{#if removing is p.id}}
            <button onclick="{{ confirmRemove(p.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-2 transition">Yes, remove</button>
            <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">Cancel</button>
{{/if}}

{{#if removing is not p.id}}
{{#if p.inUse is 0}}
            <button onclick="{{ askRemove(p.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-full px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">Remove</button>
{{/if}}
{{#if p.inUse is not 0}}
            <span class="text-slate-400 text-xs">Delete its servers to remove this connection.</span>
{{/if}}
{{/if}}
          </div>

        </div>
{{/each}}
      </div>
{{/if}}

    </div>
  </div>
</div>
{{/if}}