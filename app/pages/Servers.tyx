page ServerList

import { IconDatabase, IconArrowLeft, IconX } from "tylix-icons"

title "Servers"

needs
  Auth

uses
  Servers
  Provisions

state
  checkedAuth: false
  confirmId: 0
  confirmText: ""
  actionError: ""
  doneCount: 0
  rows: []
  cards: []
  tabs: []
  siteServerIds: []
  query: ""
  filter: "all"
  onlineCount: 0
  busyCount: 0
  pwOpen: false
  pwName: ""
  pwIp: ""
  pwValue: ""
  pwCopied: false
  pwBusy: false

action
  addServer(server) {
    Servers.add(server)
    this.summarize()
  }

  setQuery(value) {
    this.query = value
    this.buildCards()
  }

  setFilter(key) {
    this.filter = key
    this.buildCards()
  }

  askDelete(id) {
    this.actionError = ""
    this.confirmText = ""
    this.confirmId = id
  }

  cancelDelete() {
    this.confirmId = 0
    this.confirmText = ""
  }

  decorate(p) {
    const keys = ["pending", "creating", "booting", "waiting_ssh", "installing", "install_base", "install_nginx", "install_mysql", "install_redis", "install_supervisor", "install_postgres", "install_mongo", "install_node", "install_tools", "install_ufw", "install_verify", "provisioned"]
    const pcts = [5, 20, 40, 65, 85, 72, 75, 79, 82, 85, 88, 91, 93, 95, 97, 99, 100]
    const labels = ["Queued", "Creating machine", "Booting", "Waiting for SSH", "Installing", "Installing base packages", "Installing nginx", "Installing MySQL 8.4", "Installing Redis", "Installing Supervisor", "Installing PostgreSQL", "Installing MongoDB", "Installing Node.js 22", "Installing git and build tools", "Configuring firewall", "Checking services", "Provisioned"]
    const i = keys.indexOf(p.step)

    return {
      id: p.id,
      name: p.name,
      region: p.region,
      plan: p.plan,
      "template": p.template,
      ip: p.ip,
      status: p.status,
      step: p.step,
      error: p.error,
      server_id: p.server_id,
      // REF: has_instance (from /api/provisions) is true for numeric ids and UUIDs alike.
      // The old instance_id is 0 for Vultr, which would have skipped the
      // type-the-name confirmation on delete.
      has_instance: p.has_instance,
      // REF: root passwords only exist on Linode and Hetzner, so the button is hidden
      // for DigitalOcean and Vultr servers. Needs has_root_password in ProvisionController.toPublic().
      has_root_password: p.has_root_password,
      pct: pcts[i] or 5,
      label: labels[i] or p.step
    }
  }

  decorateServer(s) {
    const prov = Provisions.data.find((p) => p.server_id is s.id)
    const sites = this.siteServerIds.filter((x) => x is s.id).length

    let label = "Not tested"
    let pillCls = "inline-flex shrink-0 items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500"
    let dotCls = "w-1.5 h-1.5 rounded-full bg-amber-500"

    if s.status is "online" {
      label = "Online"
      pillCls = "inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500"
      dotCls = "w-1.5 h-1.5 rounded-full bg-emerald-500"
    }
    if s.status is "offline" {
      label = "Offline"
      pillCls = "inline-flex shrink-0 items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500"
      dotCls = "w-1.5 h-1.5 rounded-full bg-rose-500"
    }

    let ssh = s.ssh_user + "@" + s.host
    if s.port is not 22 {
      ssh = ssh + " -p " + s.port
    }

    return {
      id: s.id,
      name: s.name,
      host: s.host,
      status: s.status,
      href: "/servers/server-detail?id=" + s.id,
      ssh: "ssh " + ssh,
      region: prov?.region or "Custom",
      plan: prov?.plan or "—",
      sites: sites,
      label: label,
      pillCls: pillCls,
      dotCls: dotCls,
      search: (s.name + " " + s.host + " " + s.ssh_user).toLowerCase()
    }
  }

  buildCards() {
    const q = this.query.toLowerCase().trim()
    const all = Servers.data.map((s) => this.decorateServer(s))

    this.cards = all.filter((c) => (this.filter is "all" or c.status is this.filter) and (q is "" or c.search.includes(q)))

    const activeCls = "inline-flex items-center gap-2 rounded-full bg-emerald-500 text-white dark:text-slate-950 text-sm font-semibold px-4 py-1.5 shadow-sm transition-all"
    const idleCls = "inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 text-sm font-medium px-4 py-1.5 hover:border-emerald-500/50 transition-all"

    const defs = [["all", "All"], ["online", "Online"], ["pending", "Not tested"], ["offline", "Offline"]]
    this.tabs = defs.map((d) => ({
      key: d[0],
      label: d[1],
      count: d[0] is "all" ? all.length : all.filter((c) => c.status is d[0]).length,
      cls: d[0] is this.filter ? activeCls : idleCls
    }))
  }

  summarize() {
    this.onlineCount = Servers.data.filter((s) => s.status is "online").length
    this.busyCount = this.rows.filter((r) => r.status is "running").length + this.rows.filter((r) => r.status is "pending").length
    this.buildCards()
  }

  async reload() {
    await Provisions.load()
    this.rows = Provisions.data.map((p) => this.decorate(p))
    this.summarize()
  }

  async refresh() {
    if this.confirmId is not 0 {
      return null
    }

    await this.reload()

    const done = Provisions.data.filter((p) => p.status is "done").length
    if done is not this.doneCount {
      this.doneCount = done
      await Servers.load()
      this.summarize()
    }
  }

  async retryProvision(id) {
    this.actionError = ""
    const result = await Provisions.retry(id)
    if not result.ok {
      this.actionError = result.data?.error or "Couldn't retry that server."
    }
    await this.reload()
  }

  async deleteProvision(id) {
    this.actionError = ""
    const result = await Provisions.destroy(id, this.confirmText)
    if result.ok {
      this.confirmId = 0
      this.confirmText = ""
      await Servers.load()
      await this.reload()
    } else {
      this.actionError = result.data?.error or "Couldn't delete that server."
    }
  }

  async showRootPassword(id, name, ip) {
    if this.pwBusy {
      return null
    }

    this.pwBusy = true
    this.actionError = ""
    this.pwCopied = false
    this.pwName = name
    this.pwIp = ip

    const result = await useApi("/api/provisions/" + id + "/root-password")
    this.pwBusy = false

    if result.ok {
      this.pwValue = result.data.password
      this.pwOpen = true
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.actionError = result.data?.error or "Couldn't load the root password."
    }
  }

  closePassword() {
    this.pwOpen = false
    this.pwValue = ""
  }

  async copyPassword() {
    await navigator.clipboard.writeText(this.pwValue)
    this.pwCopied = true
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Servers.load()

    const siteRes = await useApi("/api/sites")
    if siteRes.ok and Array.isArray(siteRes.data) {
      this.siteServerIds = siteRes.data.map((x) => x.server_id)
    }

    await this.reload()
    this.doneCount = Provisions.data.filter((p) => p.status is "done").length
    this.checkedAuth = true
    window.setInterval(() => this.refresh(), 5000)
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Dashboard
      </a>

      <div class="flex items-start justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Servers</h1>
          <p class="text-slate-500 text-sm mt-1">The machines you deploy to</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/servers/create" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Create server</a>
          <ServerForm onSaved="{{ addServer }}" />
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Servers</p>
          <p class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ Servers.data.length }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Online</p>
          <p class="text-2xl font-semibold text-emerald-700 dark:text-emerald-500">{{ onlineCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Provisioning</p>
          <p class="text-2xl font-semibold text-amber-600 dark:text-amber-500">{{ busyCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Sites</p>
          <p class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ siteServerIds.length }}</p>
        </div>
      </div>

{{#if Servers.loading}}
      <p class="text-slate-500 text-sm">Loading servers…</p>
{{/if}}

{{#if not Servers.loading}}
{{#if Servers.data.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-center">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400/20 to-emerald-600/20 flex items-center justify-center mx-auto mb-4">
          <IconDatabase class="w-6 h-6 text-emerald-700 dark:text-emerald-500" />
        </div>
        <h3 class="text-slate-900 dark:text-slate-100 font-medium mb-1.5">No servers yet</h3>
        <p class="text-slate-500 text-sm max-w-sm mx-auto">
          Create one at your cloud provider, or add an existing server with its SSH details.
        </p>
      </div>
{{/if}}

{{#if Servers.data.length is not 0}}
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-5">
        <div class="flex flex-wrap items-center gap-2">
{{#each t in tabs}}
          <button onclick="{{ setFilter(t.key) }}" class="{{ t.cls }}">
            {{ t.label }}
            <span class="text-xs opacity-70">{{ t.count }}</span>
          </button>
{{/each}}
        </div>
        <div class="relative sm:w-64">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" />
          </svg>
          <input
            type="text"
            value="{{ query }}"
            oninput="{{ setQuery($event.target.value) }}"
            placeholder="Search servers"
            class="w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 text-sm pl-9 pr-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
          />
        </div>
      </div>

{{#if cards.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center">
        <p class="text-slate-500 text-sm">No servers match that filter.</p>
      </div>
{{/if}}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
{{#each s in cards}}
        <a href="{{ s.href }}" class="group block rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none hover:border-emerald-500/50 hover:-translate-y-0.5 hover:shadow-lg dark:hover:shadow-emerald-500/5 transition-all">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 shrink-0 rounded-xl bg-gradient-to-br from-emerald-400/20 to-emerald-600/20 flex items-center justify-center">
                <IconDatabase class="w-4 h-4 text-emerald-700 dark:text-emerald-500" />
              </div>
              <div class="min-w-0">
                <h3 class="text-slate-900 dark:text-slate-100 font-semibold truncate group-hover:text-emerald-700 dark:group-hover:text-emerald-500 transition-colors">{{ s.name }}</h3>
                <p class="text-slate-500 text-xs font-mono truncate">{{ s.host }}</p>
              </div>
            </div>
            <span class="{{ s.pillCls }}">
              <span class="{{ s.dotCls }}"></span> {{ s.label }}
            </span>
          </div>

          <div class="rounded-xl bg-slate-950 px-3 py-2 mb-4">
            <code class="block text-emerald-400 text-xs font-mono truncate">{{ s.ssh }}</code>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="min-w-0">
              <p class="text-slate-500 text-xs mb-0.5">Region</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono truncate">{{ s.region }}</p>
            </div>
            <div class="min-w-0">
              <p class="text-slate-500 text-xs mb-0.5">Plan</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono truncate">{{ s.plan }}</p>
            </div>
            <div class="min-w-0">
              <p class="text-slate-500 text-xs mb-0.5">Sites</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono">{{ s.sites }}</p>
            </div>
          </div>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

{{#if rows.length is not 0}}
      <div class="flex items-end justify-between mt-12 mb-4">
        <div>
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Provisioned servers</h2>
          <p class="text-slate-500 text-sm mt-1">Machines created from this app. Deleting one here destroys it at your cloud provider too.</p>
        </div>
      </div>

{{#if actionError}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ actionError }}</p>
{{/if}}

      <div class="space-y-3">
{{#each pr in rows}}
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
{{#if pr.server_id is not 0}}
              <a href="{{ '/servers/server-detail?id=' + pr.server_id }}" class="text-slate-900 dark:text-slate-100 font-semibold hover:text-emerald-700 dark:hover:text-emerald-500 hover:underline transition-colors">{{ pr.name }}</a>
{{/if}}
{{#if pr.server_id is 0}}
              <h3 class="text-slate-900 dark:text-slate-100 font-semibold">{{ pr.name }}</h3>
{{/if}}
              <p class="text-slate-500 text-xs font-mono mt-1">{{ pr.region }} / {{ pr.plan }} / {{ pr.template }}</p>
{{#if pr.ip}}
              <p class="text-slate-500 text-xs font-mono">{{ pr.ip }}</p>
{{/if}}
            </div>
            <div class="text-right shrink-0">
{{#if pr.status is "done"}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
              </span>
{{/if}}
{{#if pr.status is "failed"}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
              </span>
{{/if}}
{{#if pr.status is "running"}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Working
              </span>
{{/if}}
{{#if pr.status is "pending"}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Queued
              </span>
{{/if}}
              <p class="text-slate-500 text-xs mt-1.5">{{ pr.label }}</p>
{{#if pr.has_root_password}}
              <button onclick="{{ showRootPassword(pr.id, pr.name, pr.ip) }}" class="mt-2 text-xs text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Root password</button>
{{/if}}
            </div>
          </div>

{{#if pr.status is not "done"}}
          <div class="mt-4 h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
{{#if pr.status is "failed"}}
            <div class="h-1.5 rounded-full bg-rose-500" style="width: {{ pr.pct }}%"></div>
{{/if}}
{{#if pr.status is not "failed"}}
            <div class="h-1.5 rounded-full bg-emerald-500 transition-all duration-500" style="width: {{ pr.pct }}%"></div>
{{/if}}
          </div>
{{/if}}

{{#if pr.error}}
          <p class="text-rose-500 text-xs mt-3">{{ pr.error }}</p>
{{/if}}

{{#if pr.status is not "running"}}
          <div class="mt-4 flex flex-wrap items-center gap-3">
{{#if pr.status is "failed"}}
            <button onclick="{{ retryProvision(pr.id) }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Retry</button>
{{/if}}

{{#if confirmId is pr.id}}
{{#if pr.has_instance}}
            <input
              type="text"
              value="{{ confirmText }}"
              oninput="{{ confirmText = $event.target.value }}"
              class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
              placeholder="Type {{ pr.name }} to confirm"
            />
{{/if}}
            <button onclick="{{ deleteProvision(pr.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 py-2 transition">Delete for good</button>
            <button onclick="{{ cancelDelete() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">Cancel</button>
{{/if}}
{{#if confirmId is not pr.id}}
            <button onclick="{{ askDelete(pr.id) }}" class="text-sm text-rose-500 hover:text-rose-400 border border-rose-200 dark:border-rose-900/50 rounded-full px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">Delete</button>
{{/if}}
          </div>
{{/if}}
        </div>
{{/each}}
      </div>
{{/if}}

    </div>
    </div>
    {{#if pwOpen}}
      <div role="dialog" aria-modal="true" aria-labelledby="pw-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm px-6">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 id="pw-title" class="text-slate-900 dark:text-slate-100 font-medium">Root password for {{ pwName }}</h3>
            <button onclick="{{ closePassword() }}" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <IconX class="w-4 h-4" />
            </button>
          </div>
{{#if pwIp}}
          <p class="text-slate-500 text-xs mb-1">Connect with</p>
          <div class="rounded-xl bg-slate-950 px-4 py-3 mb-4">
            <code class="block text-emerald-400 text-sm font-mono break-all">ssh root@{{ pwIp }}</code>
          </div>
{{/if}}
{{#if not pwIp}}
          <p class="text-slate-500 text-xs mb-4">The IP address appears once the machine has booted.</p>
{{/if}}
          <p class="text-slate-500 text-xs mb-1">Password</p>
          <p class="text-slate-900 dark:text-slate-100 text-sm font-mono break-all mb-4">{{ pwValue }}</p>
          <p class="text-slate-500 text-xs mb-4">Anyone with this password and the server's IP can log in as root. Keep it private. Prefer an SSH key where you can.</p>
          <div class="flex items-center justify-between gap-3">
{{#if pwCopied}}
            <span class="text-emerald-700 dark:text-emerald-500 text-sm">Copied.</span>
{{/if}}
{{#if not pwCopied}}
            <span></span>
{{/if}}
            <button onclick="{{ copyPassword() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 transition-all">Copy password</button>
          </div>
        </div>
      </div>
{{/if}}
  </div>
{{/if}}