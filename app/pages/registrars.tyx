page RegistrarList

import { IconArrowUpRight, IconGlobe, IconTrash, IconSearch, IconCheck } from "tylix-icons"

title "Domain providers"

needs
  Auth

uses
  Registrars
  Logos

state
  checkedAuth: false
  items: []
  kindChips: []
  dnsCount: 0
  filter: "all"
  query: ""
  removing: 0
  removeError: ""

computed
  // Every registrar / DNS host Tylix Flux can manage, for the "Connect" gallery.
  catalog() {
    return ["cloudflare", "porkbun", "namecheap", "godaddy", "spaceship", "route53", "dynadot", "namecom"]
  }

  shown() {
    const q = this.query.trim().toLowerCase()
    return this.items.filter((r) => {
      if this.filter is not "all" and r.kind is not this.filter {
        return false
      }
      return not q or String(r.label or "").toLowerCase().includes(q) or r.kindName.toLowerCase().includes(q)
    })
  }

action
  plural(n, word) {
    return n is 1 ? "1 " + word : n + " " + word + "s"
  }

  // Display name for a registrar feature key. An if-chain instead of an object
  // lookup, because indexing a fixed-key object with an `any` key fails strict TS.
  labelFor(f) {
    if f is "domains" { return "Domains" }
    if f is "dns" { return "DNS" }
    if f is "nameservers" { return "Nameservers" }
    if f is "settings" { return "Renew & lock" }
    if f is "forwarding" { return "Email forwarding" }
    if f is "billing" { return "Billing" }
    return f
  }

  date(raw) {
    if not raw {
      return ""
    }
    const r = String(raw)
    const d = new Date(r.includes("T") ? r : r.replace(" ", "T") + "Z")
    if Number.isNaN(d.getTime()) {
      return r.slice(0, 10)
    }
    return d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })
  }

  statusCls(status) {
    const base = "inline-flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset "
    const s = String(status or "").toLowerCase()
    if s is "active" or s is "connected" or s is "ok" or s is "" {
      return base + "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 ring-emerald-500/20"
    }
    return base + "bg-amber-400/10 text-amber-600 dark:text-amber-300 ring-amber-400/25"
  }

  statusText(status) {
    const s = String(status or "active")
    return s.charAt(0).toUpperCase() + s.slice(1)
  }

  // Display fields: the provider's name, what it can do here and shortcuts
  // to the pages for those features.
  decorate(r) {
    const features = Array.isArray(r.features) ? r.features : []
    const base = "?id=" + r.id
    const links = [{ label: "Domains", href: "/registrars/registrar-domains" + base }]
    if features.includes("dns") {
      links.push({ label: "DNS", href: "/registrars/registrar-dns" + base })
    }
    if features.includes("forwarding") {
      links.push({ label: "Email", href: "/registrars/registrar-email" + base })
    }
    if features.includes("billing") {
      links.push({ label: "Billing", href: "/registrars/registrar-billing" + base })
    }
    return Object.assign({}, r, {
      kindName: Logos.name(r.kind) or r.kind,
      featureList: features.map((f) => this.labelFor(f)),
      links: links,
      since: this.date(r.created_at),
      href: "/registrars/registrar-domains" + base
    })
  }

  refresh() {
    const list = Registrars.data.map((r) => this.decorate(r))
    this.items = list
    this.dnsCount = list.filter((r) => (r.features or []).includes("dns")).length

    const kinds = Array.from(new Set(list.map((r) => r.kind)))
    this.kindChips = kinds.map((k) => ({ id: k, name: Logos.name(k) or k, count: list.filter((r) => r.kind is k).length }))
    if this.filter is not "all" and not kinds.includes(this.filter) {
      this.filter = "all"
    }
  }

  setFilter(k) {
    this.filter = k
  }

  setQuery(value) {
    this.query = String(value or "")
  }

  chipCls(k) {
    const base = "inline-flex items-center gap-2 h-8 pl-1.5 pr-3 rounded-full text-xs font-medium border transition-colors "
    if this.filter is k {
      return base + "border-transparent bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
    }
    return base + "border-line bg-panel text-zinc-600 dark:text-zinc-300 hover:border-line-strong"
  }

  isConnected(kind) {
    return this.items.some((r) => r.kind is kind)
  }

  addRegistrar(registrar) {
    Registrars.add(registrar)
    this.refresh()
  }

  async updateRegistrar(registrar) {
    await Registrars.replace(registrar)
    this.refresh()
  }

  askRemove(id) {
    this.removeError = ""
    this.removing = id
  }

  cancelRemove() {
    this.removing = 0
  }

  async confirmRemove(id) {
    const result = await Registrars.remove(id)
    if not result.ok {
      this.removeError = result.data?.error or "Couldn't remove that connection."
    }
    this.removing = 0
    this.refresh()
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Registrars.load()
    this.refresh()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
<div class="min-w-0 px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
  <div class="max-w-[1200px] mx-auto">

    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7">
      <div class="min-w-0">
        <p class="flux-eyebrow mb-2">Connections</p>
        <h1 class="text-[26px] sm:text-[30px] leading-tight font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">Domain providers</h1>
        <p class="text-zinc-500 text-sm mt-1.5 max-w-2xl">Registrars and DNS hosts whose domains, records and renewals you manage here.</p>
      </div>
      <div class="shrink-0">
        <RegistrarForm onSaved="{{ addRegistrar }}" />
      </div>
    </header>

{{#if items.length is not 0}}
    <section aria-label="Summary" class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 mb-6">
      <div class="rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4">
        <p class="flex items-center justify-between text-xs text-zinc-500"><span>Connected accounts</span><IconGlobe class="w-4 h-4 text-zinc-400" /></p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ items.length }}</p>
        <p class="mt-2 text-[11px] text-zinc-500">across {{ plural(kindChips.length, "provider") }}</p>
      </div>
      <div class="rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4">
        <p class="text-xs text-zinc-500">DNS editing</p>
        <p class="mt-2 text-[26px] leading-none font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{{ dnsCount }}<span class="text-base font-medium text-zinc-400"> / {{ items.length }}</span></p>
        <p class="mt-2 text-[11px] text-zinc-500">connections whose records you can change</p>
      </div>
      <div class="col-span-2 lg:col-span-1 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4">
        <p class="text-xs text-zinc-500">Providers in use</p>
        <div class="mt-2.5 flex items-center gap-1.5 flex-wrap">
{{#each k in kindChips}}
          <span title="{{ k.name + ' · ' + plural(k.count, 'account') }}"><BrandLogo kind="{{ k.id }}" size="sm" /></span>
{{/each}}
        </div>
        <p class="mt-2 text-[11px] text-zinc-500 truncate">{{ kindChips.map((k) => k.name).join(", ") }}</p>
      </div>
    </section>

{{#if removeError}}
    <p role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 text-rose-600 dark:text-rose-400 text-sm px-4 py-3 mb-4">{{ removeError }}</p>
{{/if}}

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar -mx-1 px-1">
        <button onclick="{{ setFilter('all') }}" aria-pressed="{{ filter is 'all' ? 'true' : 'false' }}" class="{{ chipCls('all') + ' pl-3' }}">All <span class="tabular-nums opacity-60">{{ items.length }}</span></button>
{{#each k in kindChips}}
        <button onclick="{{ setFilter(k.id) }}" aria-pressed="{{ filter is k.id ? 'true' : 'false' }}" class="{{ chipCls(k.id) }}"><BrandLogo kind="{{ k.id }}" size="xs" /> {{ k.name }} <span class="tabular-nums opacity-60">{{ k.count }}</span></button>
{{/each}}
      </div>
{{#if items.length > 4}}
      <label class="relative block md:w-64 shrink-0">
        <span class="sr-only">Find a connection</span>
        <IconSearch class="w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input type="search" value="{{ query }}" oninput="{{ setQuery(event.target.value) }}" placeholder="Find a connection" class="w-full rounded-xl border border-line bg-panel pl-9 pr-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20" />
      </label>
{{/if}}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-10">
{{#each r in shown}}
      <article class="group/card relative flex flex-col rounded-2xl border border-line bg-panel hover:border-line-strong transition-colors">
        <a href="{{ r.href }}" class="flex items-start gap-3.5 p-5 pb-4">
          <BrandLogo kind="{{ r.kind }}" size="lg" />
          <span class="min-w-0 flex-1">
            <span class="block text-[15px] font-semibold text-zinc-900 dark:text-zinc-100 truncate group-hover/card:underline underline-offset-4">{{ r.label }}</span>
            <span class="block text-xs text-zinc-500 truncate mt-0.5">{{ r.kindName }}{{ r.since ? " · since " + r.since : "" }}</span>
          </span>
          <span class="{{ statusCls(r.status) }}"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>{{ statusText(r.status) }}</span>
        </a>

        <ul class="flex flex-wrap gap-1.5 px-5 mb-3" aria-label="What you can manage">
{{#each f in r.featureList}}
          <li class="inline-flex items-center gap-1 rounded-full bg-zinc-100 dark:bg-white/[0.05] px-2 py-0.5 text-[11px] text-zinc-600 dark:text-zinc-300"><IconCheck class="w-3 h-3 text-emerald-500" /> {{ f }}</li>
{{/each}}
        </ul>

        <nav class="flex flex-wrap items-center gap-1 px-5 mt-3 text-xs" aria-label="{{ 'Shortcuts for ' + r.label }}">
          <span class="text-zinc-400 mr-1">Open</span>
{{#each l in r.links}}
          <a href="{{ l.href }}" class="rounded-md px-1.5 py-0.5 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">{{ l.label }}</a>
{{/each}}
        </nav>

        <div class="mt-auto flex items-center gap-2 px-5 py-4 border-t border-line">
{{#if removing is r.id}}
          <span class="text-xs text-zinc-500 mr-auto">Remove this connection?</span>
          <button onclick="{{ confirmRemove(r.id) }}" class="text-xs font-semibold text-white bg-rose-600 hover:bg-rose-500 rounded-full px-3 py-1.5 transition-colors">Remove</button>
          <button onclick="{{ cancelRemove() }}" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 px-2 py-1.5">Cancel</button>
{{/if}}
{{#if removing is not r.id}}
          <a href="{{ r.href }}" class="inline-flex items-center gap-1 text-sm bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 font-semibold rounded-full px-4 py-2 hover:opacity-90 transition-opacity">Manage <IconArrowUpRight class="w-3.5 h-3.5" /></a>
          <RegistrarForm registrar="{{ r }}" onSaved="{{ updateRegistrar }}" />
          <button onclick="{{ askRemove(r.id) }}" title="Remove connection" aria-label="{{ 'Remove ' + r.label }}" class="ml-auto w-9 h-9 flex items-center justify-center rounded-full text-zinc-400 hover:text-rose-600 hover:bg-rose-500/10 transition-colors"><IconTrash class="w-4 h-4" /></button>
{{/if}}
        </div>
      </article>
{{#else}}
      <p class="md:col-span-2 xl:col-span-3 rounded-2xl border border-dashed border-line px-5 py-10 text-center text-sm text-zinc-500">No connections match.</p>
{{/each}}
    </div>
{{/if}}

{{#if items.length is 0}}
    <section class="rounded-2xl border border-line bg-panel px-5 sm:px-10 py-10 sm:py-14 text-center mb-10">
      <div class="flex items-center justify-center -space-x-2 mb-5">
{{#each id in catalog}}
        <span class="rounded-xl ring-4 ring-[var(--panel)]"><BrandLogo kind="{{ id }}" size="lg" /></span>
{{/each}}
      </div>
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Connect your first domain provider</h2>
      <p class="text-zinc-500 text-sm max-w-md mx-auto mt-1.5 mb-6">Bring in Cloudflare, Porkbun, Namecheap, GoDaddy, Spaceship, Route 53, Dynadot or Name.com to manage domains, DNS records and renewals from here.</p>
      <RegistrarForm onSaved="{{ addRegistrar }}" />
    </section>
{{/if}}

    <section aria-label="Supported domain providers">
      <div class="mb-3">
        <h2 class="text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">{{ items.length is 0 ? "Supported domain providers" : "Connect another account" }}</h2>
        <p class="text-xs text-zinc-500 mt-0.5">Pick a provider to open its connection form. You can connect several accounts of the same one.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2.5">
{{#each id in catalog}}
        <RegistrarForm start="{{ id }}" variant="tile" note="{{ isConnected(id) ? 'Connected · add another' : '' }}" onSaved="{{ addRegistrar }}" />
{{/each}}
      </div>
    </section>

  </div>
</div>
{{/if}}
{{#if not checkedAuth}}
<PageLoader label="Loading domain providers…" />
{{/if}}
