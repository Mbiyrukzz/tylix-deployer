page Status

title "System status"

state
  loading: true
  level: "unknown"
  lastSeen: ""
  notices: []

computed
  headline() {
    if this.level is "operational" {
      return "All systems operational"
    }
    if this.level is "outage" {
      return "Service disruption"
    }
    return "Status unavailable"
  }

  detail() {
    if this.level is "operational" {
      return "Tylix Deploy is running normally."
    }
    if this.level is "outage" {
      return "We aren't receiving health reports from Tylix Deploy. We're looking into it."
    }
    return "We couldn't determine the current status. Check back in a minute."
  }

  bannerClass() {
    if this.level is "operational" {
      return "border-emerald-300 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/30"
    }
    if this.level is "outage" {
      return "border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30"
    }
    return "border-line bg-panel"
  }

  dotClass() {
    if this.level is "operational" {
      return "bg-emerald-500"
    }
    if this.level is "outage" {
      return "bg-rose-500"
    }
    return "bg-zinc-400"
  }

  checkedLabel() {
    if not this.lastSeen {
      return "Not reported yet"
    }
    const secs = Math.floor((Date.now() - new Date(this.lastSeen).getTime()) / 1000)
    if secs < 60 {
      return "Just now"
    }
    if secs < 3600 {
      return Math.floor(secs / 60) + " min ago"
    }
    if secs < 86400 {
      return Math.floor(secs / 3600) + " h ago"
    }
    return Math.floor(secs / 86400) + " d ago"
  }

action
  whenText(value) {
    if not value {
      return ""
    }
    const d = new Date(value)
    const day = d.toLocaleDateString("en-GB", { day: "numeric", month: "short" })
    const time = d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
    return day + ", " + time
  }

  rangeText(a) {
    const from = this.whenText(a.starts_at)
    const to = this.whenText(a.ends_at)
    if a.phase is "resolved" {
      return to ? "Resolved " + to : ""
    }
    if a.phase is "upcoming" {
      return to ? from + " to " + to : "From " + from
    }
    return to ? "Since " + from + " · expected to end " + to : "Since " + from
  }

  kindLabel(kind) {
    if kind is "incident" {
      return "Incident"
    }
    if kind is "maintenance" {
      return "Maintenance"
    }
    return "Notice"
  }

  kindChip(kind) {
    if kind is "incident" {
      return "bg-rose-500/10 text-rose-700 dark:text-rose-300"
    }
    if kind is "maintenance" {
      return "bg-amber-500/10 text-amber-700 dark:text-amber-300"
    }
    return "bg-sky-500/10 text-sky-700 dark:text-sky-300"
  }

  decorate(a) {
    return Object.assign({}, a, {
      label: this.kindLabel(a.kind),
      chipClass: this.kindChip(a.kind),
      range: this.rangeText(a)
    })
  }

  withHeading(items, heading) {
    return items.map((a, i) => Object.assign({}, a, { heading: i is 0 ? heading : "" }))
  }

  applyAnnouncements(list) {
    const rows = (Array.isArray(list) ? list : []).map((a) => this.decorate(a))
    const active = this.withHeading(rows.filter((a) => a.phase is "active"), "Happening now")
    const upcoming = this.withHeading(rows.filter((a) => a.phase is "upcoming"), "Upcoming")
    const resolved = this.withHeading(rows.filter((a) => a.phase is "resolved"), "Recently resolved")
    this.notices = active.concat(upcoming).concat(resolved)
  }

  async load() {
    const results = await Promise.all([
      useApi("/api/status"),
      useApi("/api/announcements")
    ])
    const res = results[0]
    const noteRes = results[1]

    if res.ok {
      this.level = res.data.state
      this.lastSeen = res.data.last_seen_at ?? ""
    } else {
      this.level = "unknown"
    }

    if noteRes.ok {
      this.applyAnnouncements(noteRes.data?.announcements)
    }
  }

  tick() {
    // Only keep refreshing while this page is the one on screen.
    if window.location.pathname is "/status" {
      this.load()
    }
  }

onMount
  async {
    await this.load()
    this.loading = false
    setInterval(() => this.tick(), 30000)
  }

template
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.2em] mb-3">Tylix Deploy</p>
    <h1 class="text-3xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-8">System status</h1>

{{#if loading}}
    <p class="text-sm text-zinc-500">Checking…</p>
{{/if}}

{{#if not loading}}
    <section class="rounded-2xl border p-6 sm:p-8 {{ bannerClass }}">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full shrink-0 {{ dotClass }}"></span>
        <h2 class="text-xl font-medium text-zinc-900 dark:text-zinc-100">{{ headline }}</h2>
      </div>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-3">{{ detail }}</p>
      <p class="text-xs text-zinc-500 mt-4">Last health report: {{ checkedLabel }}. This page refreshes automatically.</p>
    </section>

{{#each n in notices}}
{{#if n.heading}}
    <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zinc-500 mt-10 mb-4">{{ n.heading }}</h2>
{{/if}}
    <article class="rounded-2xl border border-line bg-panel p-5 mb-3">
      <div class="flex flex-wrap items-center gap-2 mb-1.5">
        <span class="rounded-md px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider {{ n.chipClass }}">{{ n.label }}</span>
        <span class="text-xs text-zinc-500">{{ n.range }}</span>
      </div>
      <h3 class="font-medium text-zinc-900 dark:text-zinc-100">{{ n.title }}</h3>
      <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 whitespace-pre-line mt-2">{{ n.body }}</p>
    </article>
{{/each}}
{{/if}}
  </main>