page TeamActivity

title "Team activity"

needs
  Auth

state
  loading: true
  paging: false
  scope: "team"
  members: []
  groups: []
  userId: ""
  selectedName: "Everyone"
  page: 1
  pages: 1
  total: 0
  totalText: "0"
  memberCount: "0"
  hasPrev: false
  hasNext: false
  rangeText: ""
  panelCls: "rounded-3xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden"

action
  ago(iso) {
    if not iso {
      return "Never"
    }
    const t = new Date(iso).getTime()
    if Number.isNaN(t) {
      return "Unknown"
    }
    const s = Math.floor((Date.now() - t) / 1000)
    if s < 60 {
      return "Just now"
    }
    const m = Math.floor(s / 60)
    if m < 60 {
      return m + "m ago"
    }
    const h = Math.floor(m / 60)
    if h < 24 {
      return h + "h ago"
    }
    const d = Math.floor(h / 24)
    if d < 30 {
      return d + "d ago"
    }
    return String(iso).slice(0, 10)
  }

  dayLabel(iso) {
    const d = new Date(iso)
    const today = new Date()
    const yesterday = new Date(Date.now() - 86400000)
    if d.toDateString() is today.toDateString() {
      return "Today"
    }
    if d.toDateString() is yesterday.toDateString() {
      return "Yesterday"
    }
    return d.toDateString()
  }

  groupEvents(list) {
    const groups = list.reduce((acc, e) => {
      const day = this.dayLabel(e.at)
      let g = acc.find((x) => x.day is day)
      if not g {
        g = { day: day, items: [] }
        acc.push(g)
      }
      g.items.push({
        id: e.id,
        who: e.user_name,
        initial: String(e.user_name).slice(0, 1).toUpperCase(),
        verb: e.verb,
        label: e.label,
        tag: e.kind_label or "",
        time: new Date(e.at).toTimeString().slice(0, 5),
        when: this.ago(e.at),
        href: "/team/member?id=" + e.user_id
      })
      return acc
    }, [])
    return groups
  }

  decorateMembers(list, active) {
    return list.map((m) => ({
      id: String(m.id),
      name: m.name,
      initial: String(m.name).slice(0, 1).toUpperCase(),
      rowCls: String(m.id) is active
        ? "w-full text-left flex items-center gap-3 rounded-xl px-3 py-2.5 bg-brand-500/10 ring-1 ring-brand-500/30 transition-colors"
        : "w-full text-left flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors"
    }))
  }

  async loadEvents(page) {
    let url = "/api/team/activity?per_page=25&page=" + page
    if this.userId {
      url = url + "&user=" + this.userId
    }

    const act = await useApi(url)

    if act.status is 401 {
      window.location.href = "/login"
      return null
    }

    if not act.ok {
      return null
    }

    const d = act.data
    this.scope = d.scope

    const panelBase = "rounded-3xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden"
    if d.scope is "self" {
      this.panelCls = panelBase + " lg:col-span-2"
    } else {
      this.panelCls = panelBase
    }

    this.groups = this.groupEvents(d.events)
    this.page = d.page
    this.pages = d.pages
    this.total = d.total
    this.totalText = String(d.total)
    this.hasPrev = d.page > 1
    this.hasNext = d.page < d.pages

    if d.total is 0 {
      this.rangeText = ""
    } else {
      const from = (d.page - 1) * d.per_page + 1
      const to = Math.min(d.page * d.per_page, d.total)
      this.rangeText = from + "–" + to + " of " + d.total
    }

    return d
  }

  async load() {
    const list = await useApi("/api/team/members")

    if list.status is 401 {
      window.location.href = "/login"
      return null
    }

    if list.ok {
      this.members = this.decorateMembers(list.data.members, this.userId)
      this.memberCount = String(list.data.members.length)
    }

    await this.loadEvents(1)

    if this.scope is "self" {
      this.selectedName = "You"
    }

    this.loading = false
  }

  async setMember(id) {
    this.userId = id
    this.members = this.decorateMembers(this.members, id)

    const found = this.members.find((m) => m.id is id)
    this.selectedName = found ? found.name : "Everyone"

    this.paging = true
    await this.loadEvents(1)
    this.paging = false
  }

  async pickMember(id) {
    if this.paging {
      return null
    }
    await this.setMember(this.userId is id ? "" : id)
  }

  async clearMember() {
    if this.paging {
      return null
    }
    await this.setMember("")
  }

  async prev() {
    if this.paging or not this.hasPrev {
      return null
    }
    this.paging = true
    await this.loadEvents(this.page - 1)
    this.paging = false
  }

  async next() {
    if this.paging or not this.hasNext {
      return null
    }
    this.paging = true
    await this.loadEvents(this.page + 1)
    this.paging = false
  }

onMount
  async {
    await this.load()
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_1fr] bg-page transition-colors">
    <Sidebar active="team" />
    <TeamSidebar active="activity" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

{{#if loading}}
      <div class="space-y-4">
        <div class="h-40 rounded-3xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
          <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
          <div class="h-24 rounded-2xl bg-slate-200/60 dark:bg-slate-900/60 animate-pulse"></div>
        </div>
      </div>
{{/if}}

{{#if not loading}}

      <div class="rounded-3xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden mb-5">
        <div class="h-20 bg-gradient-to-r from-brand-500/25 via-brand-500/10 to-transparent"></div>
        <div class="px-6 sm:px-8 pb-6 -mt-10">
          <div class="flex flex-col sm:flex-row sm:items-end gap-4">
            <span class="w-20 h-20 shrink-0 rounded-2xl bg-brand-500 text-white flex items-center justify-center ring-4 ring-white dark:ring-slate-900 shadow-lg">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-9 h-9">
                <circle cx="10" cy="10" r="7.25" />
                <path d="M10 5.5V10l3 2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div class="min-w-0 flex-1 sm:pb-1">
{{#if scope is "team"}}
              <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">Team activity</h1>
              <p class="text-slate-500 text-sm mt-0.5">Everything members have added to the team.</p>
{{/if}}
{{#if scope is "self"}}
              <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">Your activity</h1>
              <p class="text-slate-500 text-sm mt-0.5">Everything you've added to the team.</p>
{{/if}}
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Total actions</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{{ totalText }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Viewing</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ selectedName }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Members</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{{ memberCount }}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-6 items-start">

{{#if scope is "team"}}
        <div class="rounded-3xl border border-line bg-panel p-4 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between px-3 pt-2 pb-3">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold text-sm">Filter by member</h2>
{{#if userId}}
            <button onclick="{{ clearMember() }}" class="text-xs text-brand-700 dark:text-brand-400 font-semibold hover:underline">Show all</button>
{{/if}}
          </div>
{{#if members.length is 0}}
          <p class="px-3 pb-3 text-slate-500 text-sm">No members yet.</p>
{{/if}}
          <div class="space-y-1">
{{#each m in members}}
            <button onclick="{{ pickMember(m.id) }}" class="{{ m.rowCls }}">
              <span class="w-8 h-8 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-400 text-xs font-semibold flex items-center justify-center">{{ m.initial }}</span>
              <span class="min-w-0 flex-1 text-sm text-slate-700 dark:text-slate-300 truncate">{{ m.name }}</span>
            </button>
{{/each}}
          </div>
        </div>
{{/if}}

        <div class="{{ panelCls }}">
          <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-line">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Activity</h2>
{{#if userId}}
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-700 dark:text-brand-400">
              {{ selectedName }}
              <button onclick="{{ clearMember() }}" aria-label="Clear filter" class="hover:text-brand-900 dark:hover:text-brand-200">&times;</button>
            </span>
{{/if}}
          </div>

{{#if groups.length is 0}}
          <p class="px-6 py-12 text-slate-500 text-sm text-center">No activity found.</p>
{{/if}}

          <div class="px-6 py-2">
{{#each g in groups}}
            <p class="text-slate-500 text-[11px] font-semibold uppercase tracking-wider pt-4 pb-2">{{ g.day }}</p>
            <div class="relative pl-6 border-l border-slate-200 dark:border-slate-800 ml-1.5 space-y-4 pb-2">
{{#each e in g.items}}
              <div class="relative">
                <span class="absolute -left-[1.78rem] top-1.5 w-2.5 h-2.5 rounded-full bg-brand-500 ring-4 ring-white dark:ring-slate-900"></span>
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                      <a href="{{ e.href }}" class="font-medium text-slate-900 dark:text-slate-100 hover:underline">{{ e.who }}</a>
                      {{ e.verb }}
                      <span class="font-mono font-medium text-slate-900 dark:text-slate-100">{{ e.label }}</span>
                    </p>
{{#if e.tag}}
                    <span class="inline-flex mt-1 rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] text-slate-500">{{ e.tag }}</span>
{{/if}}
                  </div>
                  <div class="text-right shrink-0">
                    <p class="text-slate-700 dark:text-slate-300 text-xs font-medium">{{ e.time }}</p>
                    <p class="text-slate-500 text-[11px]">{{ e.when }}</p>
                  </div>
                </div>
              </div>
{{/each}}
            </div>
{{/each}}
          </div>

{{#if total is not 0}}
          <div class="flex items-center justify-between gap-4 px-6 py-3 border-t border-line">
            <p class="text-slate-500 text-xs">{{ rangeText }}</p>
            <div class="flex items-center gap-2">
{{#if hasPrev}}
              <button onclick="{{ prev() }}" class="text-xs text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">Previous</button>
{{/if}}
{{#if not hasPrev}}
              <button disabled class="text-xs text-slate-400 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 opacity-50">Previous</button>
{{/if}}
              <span class="text-slate-500 text-xs px-1">Page {{ page }} of {{ pages }}</span>
{{#if hasNext}}
              <button onclick="{{ next() }}" class="text-xs text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">Next</button>
{{/if}}
{{#if not hasNext}}
              <button disabled class="text-xs text-slate-400 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 opacity-50">Next</button>
{{/if}}
            </div>
          </div>
{{/if}}
        </div>

      </div>
{{/if}}

    </div>
    </div>
  </div>