page Register

title "Create account"

needs
  Auth

state
  ready: false
  signedIn: false
  signedInEmail: ""
  showForm: false
  name: ""
  email: ""
  password: ""
  confirmPassword: ""
  website: ""
  agreedToTerms: false
  showPassword: false
  passwordType: "password"
  pwLength: false
  pwLetter: false
  pwNumber: false
  pwSymbol: false
  pwLabel: ""
  pwPct: 0
  pwColor: "#f43f5e"
  pwTouched: false
  matchYes: false
  matchNo: false
  captchaOn: false
  captchaToken: ""
  error: ""
  submitting: false
  submitLabel: "Create account"
  submitDim: ""
  registered: false
  emailSent: true
  registerMessage: ""

action
  setField(field, value) {
    this[field] = value
  }

  setCaptchaToken(token) {
    this.captchaToken = token
  }

  toggleTerms() {
    this.agreedToTerms = not this.agreedToTerms
  }

  togglePassword() {
    this.showPassword = not this.showPassword
    if this.showPassword {
      this.passwordType = "text"
    } else {
      this.passwordType = "password"
    }
  }

  updateMatch() {
    if not this.confirmPassword {
      this.matchYes = false
      this.matchNo = false
    } else if this.password is this.confirmPassword {
      this.matchYes = true
      this.matchNo = false
    } else {
      this.matchYes = false
      this.matchNo = true
    }
  }

  updatePassword(value) {
    this.password = value
    this.pwTouched = true
    const c = authUi.passwordChecks(value)
    this.pwLength = c.length
    this.pwLetter = c.letter
    this.pwNumber = c.number
    this.pwSymbol = c.symbol
    this.pwLabel = c.label
    this.pwPct = c.pct
    this.pwColor = c.color
    this.updateMatch()
  }

  updateConfirm(value) {
    this.confirmPassword = value
    this.updateMatch()
  }

   onKey(event) {
    if event.key is "Enter" and event.target.tagName is "INPUT" {
      this.submit()
    }
  }

  async submit() {
    if not this.submitting {
      if not this.name or not this.email {
        this.error = "Enter your name and email."
        return null
      }

      const c = authUi.passwordChecks(this.password)
      if not c.ok {
        this.pwTouched = true
        this.error = "Password must be 10 or more characters with a letter, a number and a symbol."
        return null
      }

      if this.password is not this.confirmPassword {
        this.error = "Passwords don't match."
        return null
      }

      if not this.agreedToTerms {
        this.error = "Please agree to the Terms of Service to continue."
        return null
      }

      if this.captchaOn and not this.captchaToken {
        this.error = "Please complete the verification challenge."
        return null
      }

      this.submitting = true
      this.submitLabel = "Creating account…"
      this.submitDim = "opacity-50 pointer-events-none"
      this.error = ""

      const result = await useApi("/api/register", {
        method: "POST",
        body: {
          name: this.name,
          email: this.email,
          password: this.password,
          website: this.website,
          captcha_token: this.captchaToken
        }
      })

      this.submitting = false
      this.submitLabel = "Create account"
      this.submitDim = ""

      if result.ok {
        this.emailSent = result.data?.email_sent is not false
        this.registerMessage = result.data?.message or ""
        this.showForm = false
        this.registered = true
        authUi.unmountCaptcha("register-captcha")
      } else {
        if result.status is 422 and result.data.errors {
          const firstField = Object.keys(result.data.errors)[0]
          this.error = result.data.errors[firstField][0]
        } else {
          this.error = result.error or "Could not create account. Check your details and try again."
        }

        if this.captchaOn {
          this.captchaToken = ""
          authUi.resetCaptcha("register-captcha")
        }
      }
    }
  }

onMount
  async {
    document.addEventListener("keydown", (event) => this.onKey(event))
    if Auth.user {
      this.signedInEmail = Auth.user.email
      this.signedIn = true
    } else {
      this.showForm = true
      this.captchaOn = authUi.captchaEnabled()
      if this.captchaOn {
        authUi.mountCaptcha("register-captcha", (token) => this.setCaptchaToken(token), () => this.setCaptchaToken(""))
      }
    }
    this.ready = true
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-page transition-colors px-6 py-16">
    <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] rounded-3xl border border-line bg-panel shadow-xl shadow-slate-300/40 dark:shadow-none overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between bg-slate-950 p-10 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-brand-500/10 blur-3xl"></div>

        <a href="/" class="relative flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="text-white font-semibold tracking-tight">Tylix Deploy</span>
        </a>

        <div class="relative">
          <p class="text-brand-400 text-xs font-semibold uppercase tracking-wider mb-3">Zero to deployed</p>
          <h2 class="text-white text-3xl font-bold leading-tight tracking-tight mb-8">Your first deploy is four steps away.</h2>

          <div class="space-y-3">
            <div class="flex items-start gap-4 rounded-2xl border border-slate-800 bg-slate-900/80 p-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/15 text-brand-400 text-xs font-semibold flex items-center justify-center">1</span>
              <div>
                <p class="text-slate-200 text-sm font-medium">Add a server</p>
                <p class="text-slate-500 text-xs mt-0.5">Provision on Linode, Hetzner, DigitalOcean or Vultr, or connect your own over SSH.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 rounded-2xl border border-slate-800 bg-slate-900/80 p-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/15 text-brand-400 text-xs font-semibold flex items-center justify-center">2</span>
              <div>
                <p class="text-slate-200 text-sm font-medium">Create a site</p>
                <p class="text-slate-500 text-xs mt-0.5">Tylix, Laravel, Node.js, WordPress, MERN and more.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 rounded-2xl border border-slate-800 bg-slate-900/80 p-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/15 text-brand-400 text-xs font-semibold flex items-center justify-center">3</span>
              <div>
                <p class="text-slate-200 text-sm font-medium">Connect your repo</p>
                <p class="text-slate-500 text-xs mt-0.5">Pick a repository and branch, set your env and script.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 rounded-2xl border border-slate-800 bg-slate-900/80 p-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/15 text-brand-400 text-xs font-semibold flex items-center justify-center">4</span>
              <div>
                <p class="text-slate-200 text-sm font-medium">Hit Deploy</p>
                <p class="text-slate-500 text-xs mt-0.5">Watch the log live, then add SSL in one click.</p>
              </div>
            </div>
          </div>
        </div>

        <p class="relative text-slate-600 text-xs">© 2026 Tylix</p>
      </div>

      <div class="flex items-center justify-center px-6 py-12 lg:px-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
            <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
          </a>

{{#if not ready}}
          <p class="text-slate-500 text-sm text-center">Loading…</p>
{{/if}}

{{#if signedIn}}
          <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center text-lg mb-5 text-brand-700 dark:text-brand-400">✓</div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">You're already signed in</h1>
          <p class="text-slate-500 text-sm mb-8">
            Signed in as <span class="text-slate-800 dark:text-slate-300 font-medium">{{ signedInEmail }}</span>.
          </p>
          <a href="/dashboard" class="inline-block w-full text-center bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all mb-3">
            Go to Dashboard
          </a>
          <a href="/pricing" class="inline-block w-full text-center border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl py-2.5 font-medium hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
            See pricing
          </a>
{{/if}}

{{#if registered}}
{{#if emailSent}}
          <div class="w-11 h-11 rounded-xl bg-brand-500/10 flex items-center justify-center text-lg mb-5 text-brand-700 dark:text-brand-400">✓</div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Check your email</h1>
          <p class="text-slate-500 text-sm mb-3">
            We sent a verification link to <span class="text-slate-800 dark:text-slate-300 font-medium">{{ email }}</span>.
            Click it, then log in.
          </p>
          <p class="text-slate-400 dark:text-slate-600 text-xs mb-8">The link is valid for 24 hours. Check your spam folder if you don't see it.</p>
{{/if}}
{{#if not emailSent}}
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 flex items-center justify-center text-lg mb-5 text-amber-600 dark:text-amber-400">!</div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Account created</h1>
          <p class="text-slate-500 text-sm mb-8">{{ registerMessage }}</p>
{{/if}}
          <a href="/login" class="inline-block w-full text-center bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
            Go to login
          </a>
{{/if}}

{{#if showForm}}
          <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-1">Get started</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Create your account</h1>
          <p class="text-slate-500 text-sm mb-8">Deploy your first app in minutes.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="flex items-start gap-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <span class="mt-0.5 text-rose-600 dark:text-rose-400 text-sm font-bold" aria-hidden="true">!</span>
            <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="name" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Name</label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            autofocus
            placeholder="Jane Doe"
            value="{{ name }}"
            oninput="{{ setField('name', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
          />

          <label for="email" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
          />

          <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden opacity-0" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input
              id="website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              value="{{ website }}"
              oninput="{{ setField('website', event.target.value) }}"
            />
          </div>

          <label for="password" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Password</label>
          <div class="relative mb-3">
            <input
              id="password"
              name="password"
              type="{{ passwordType }}"
              autocomplete="new-password"
              placeholder="At least 10 characters"
              value="{{ password }}"
              oninput="{{ updatePassword(event.target.value) }}"
              class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl pl-4 pr-16 py-2.5 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
            />
            <button type="button" onclick="{{ togglePassword() }}" class="absolute inset-y-0 right-0 px-4 text-xs font-medium text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
              {{#if showPassword}}Hide{{/if}}{{#if not showPassword}}Show{{/if}}
            </button>
          </div>

{{#if pwTouched}}
          <div class="mb-3">
            <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
              <div class="h-full rounded-full transition-all duration-300" style="width: {{ pwPct }}%; background: {{ pwColor }}"></div>
            </div>
            <p class="text-xs text-slate-500 mt-1.5">{{ pwLabel }}</p>
          </div>

          <ul class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs mb-4">
            <li class="flex items-center gap-1.5">
{{#if pwLength}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">10+ characters</span>{{/if}}
{{#if not pwLength}}<span class="text-slate-400">○</span><span class="text-slate-500">10+ characters</span>{{/if}}
            </li>
            <li class="flex items-center gap-1.5">
{{#if pwLetter}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A letter</span>{{/if}}
{{#if not pwLetter}}<span class="text-slate-400">○</span><span class="text-slate-500">A letter</span>{{/if}}
            </li>
            <li class="flex items-center gap-1.5">
{{#if pwNumber}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A number</span>{{/if}}
{{#if not pwNumber}}<span class="text-slate-400">○</span><span class="text-slate-500">A number</span>{{/if}}
            </li>
            <li class="flex items-center gap-1.5">
{{#if pwSymbol}}<span class="text-brand-600 dark:text-brand-400">✓</span><span class="text-slate-600 dark:text-slate-300">A symbol</span>{{/if}}
{{#if not pwSymbol}}<span class="text-slate-400">○</span><span class="text-slate-500">A symbol</span>{{/if}}
            </li>
          </ul>
{{/if}}
{{#if not pwTouched}}
          <p class="text-slate-400 dark:text-slate-600 text-xs mb-4">At least 10 characters, with a letter, a number and a symbol.</p>
{{/if}}

          <label for="confirmPassword" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Confirm password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="{{ passwordType }}"
            autocomplete="new-password"
            placeholder="Repeat your password"
            value="{{ confirmPassword }}"
            oninput="{{ updateConfirm(event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-1.5 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
          />
{{#if matchYes}}
          <p class="text-brand-600 dark:text-brand-400 text-xs mb-5">Passwords match.</p>
{{/if}}
{{#if matchNo}}
          <p class="text-rose-600 dark:text-rose-400 text-xs mb-5">Passwords don't match yet.</p>
{{/if}}
{{#if not matchYes}}
{{#if not matchNo}}
          <div class="mb-5"></div>
{{/if}}
{{/if}}

          <label class="flex items-start gap-2.5 text-sm text-slate-500 dark:text-slate-400 mb-5">
{{#if agreedToTerms}}
            <input type="checkbox" checked onclick="{{ toggleTerms() }}" class="mt-0.5 rounded border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-brand-500 focus:ring-brand-500" />
{{/if}}
{{#if not agreedToTerms}}
            <input type="checkbox" onclick="{{ toggleTerms() }}" class="mt-0.5 rounded border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-brand-500 focus:ring-brand-500" />
{{/if}}
            <span>
              I agree to the
              <a href="/terms" target="_blank" class="text-brand-700 dark:text-brand-400 hover:underline">Terms of Service</a>
              and
              <a href="/privacy" target="_blank" class="text-brand-700 dark:text-brand-400 hover:underline">Privacy Policy</a>.
            </span>
          </label>

{{#if captchaOn}}
          <div id="register-captcha" class="mb-5 min-h-[78px]"></div>
{{/if}}

          <button onclick="{{ submit() }}" class="w-full bg-brand-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all {{ submitDim }}">
            {{ submitLabel }}
          </button>

          <p class="text-sm text-slate-500 text-center mt-6">
            Already have an account? <a href="/login" class="text-brand-700 dark:text-brand-400 hover:underline">Log in</a>
          </p>
{{/if}}
        </div>
      </div>
    </div>
  </div>