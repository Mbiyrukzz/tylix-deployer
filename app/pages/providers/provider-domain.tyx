page ProviderDomain

import { IconArrowLeft } from "tylix-icons"

title "DNS records"

needs
  Auth

state
  checkedAuth: false
  providerId: ""
  domainId: ""
  domainName: ""
  domainEmail: ""
  domainTtl: 0
  domainTtlText: ""
  kind: ""
  locked: false
  error: ""
  records: []
  shown: []
  tabs: []
  filter: "ALL"
  typeButtons: []
  ttlButtons: []
  protocolButtons: []
  tagButtons: []
  chips: []
  valueLabel: "IPv4 address"
  valuePlaceholder: "203.0.113.10"
  formOpen: false
  editingId: ""
  fType: "A"
  fName: ""
  fValue: ""
  fPriority: "10"
  fWeight: "0"
  fPort: "0"
  fService: ""
  fProtocol: "tcp"
  fTag: "issue"
  fTtl: 0
  saving: false
  nameError: ""
  valueError: ""
  priorityError: ""
  weightError: ""
  portError: ""
  serviceError: ""
  tagError: ""
  ttlError: ""
  formError: ""
  removing: ""
  removeBusy: false
  settingsOpen: false
  sEmail: ""
  sTtl: 0
  sTtlButtons: []
  sSaving: false
  sEmailError: ""
  sTtlError: ""
  sFormError: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  ttlLabel(n) {
    const known = [[0, "Default"], [300, "5 min"], [3600, "1 hour"], [14400, "4 hours"], [86400, "1 day"], [604800, "1 week"]]
    const hit = known.find((k) => k[0] is n)
    if hit {
      return hit[1]
    }
    return n + " s"
  }

  clearErrors() {
    this.nameError = ""
    this.valueError = ""
    this.priorityError = ""
    this.weightError = ""
    this.portError = ""
    this.serviceError = ""
    this.tagError = ""
    this.ttlError = ""
    this.formError = ""
  }

  badgeCls(type) {
    let tone = "bg-slate-500/10 text-slate-600 dark:text-slate-300"
    if type is "A" {
      tone = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-500"
    }
    if type is "AAAA" {
      tone = "bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    if type is "CNAME" {
      tone = "bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    if type is "MX" {
      tone = "bg-amber-500/10 text-amber-600 dark:text-amber-500"
    }
    if type is "NS" {
      tone = "bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    if type is "SRV" {
      tone = "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400"
    }
    if type is "CAA" {
      tone = "bg-fuchsia-500/10 text-fuchsia-600 dark:text-fuchsia-400"
    }
    return "inline-flex w-16 shrink-0 justify-center rounded-md px-2 py-1 text-xs font-semibold font-mono " + tone
  }

  decorate(r) {
    let valueText = r.value
    if r.type is "MX" {
      valueText = r.priority + " " + r.value
    }
    if r.type is "SRV" {
      valueText = r.priority + " " + r.weight + " " + r.port + " " + r.value
    }
    if r.type is "CAA" {
      valueText = r.tag + " " + r.value
    }

    return Object.assign({}, r, {
      badgeCls: this.badgeCls(r.type),
      ttlText: this.ttlLabel(r.ttl),
      valueText: valueText
    })
  }

  applyFilter() {
    const types = ["ALL", "A", "AAAA", "CNAME", "MX", "TXT", "NS", "SRV", "CAA"]
    const activeCls = "inline-flex items-center gap-2 rounded-full bg-emerald-500 text-white dark:text-slate-950 text-sm font-semibold px-4 py-1.5 shadow-sm transition-all"
    const idleCls = "inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 text-sm font-medium px-4 py-1.5 hover:border-emerald-500/50 transition-all"

    this.shown = this.filter is "ALL" ? this.records : this.records.filter((r) => r.type is this.filter)
    this.tabs = types.map((t) => ({
      key: t,
      label: t is "ALL" ? "All" : t,
      count: t is "ALL" ? this.records.length : this.records.filter((r) => r.type is t).length,
      cls: t is this.filter ? activeCls : idleCls
    }))
  }

  setFilter(key) {
    this.filter = key
    this.applyFilter()
  }

  buildButtons() {
    const activeCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200"
    const idleCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40"

    const types = ["A", "AAAA", "CNAME", "MX", "TXT", "NS", "SRV", "CAA"]
    this.typeButtons = types.map((t) => ({ key: t, cls: t is this.fType ? activeCls : idleCls }))

    const ttls = [[0, "Default"], [300, "5 min"], [3600, "1 hour"], [14400, "4 hours"], [86400, "1 day"]]
    this.ttlButtons = ttls.map((t) => ({ key: t[0], label: t[1], cls: t[0] is this.fTtl ? activeCls : idleCls }))

    const protocols = ["tcp", "udp", "tls"]
    this.protocolButtons = protocols.map((p) => ({ key: p, cls: p is this.fProtocol ? activeCls : idleCls }))

    const tags = ["issue", "issuewild", "iodef"]
    this.tagButtons = tags.map((t) => ({ key: t, cls: t is this.fTag ? activeCls : idleCls }))

    let label = "IPv4 address"
    let ph = "203.0.113.10"
    if this.fType is "AAAA" {
      label = "IPv6 address"
      ph = "2001:db8::1"
    }
    if this.fType is "CNAME" {
      label = "Points to"
      ph = "target.example.com"
    }
    if this.fType is "MX" {
      label = "Mail server"
      ph = "mail.example.com"
    }
    if this.fType is "TXT" {
      label = "Text"
      ph = "v=spf1 include:_spf.example.com ~all"
    }
    if this.fType is "NS" {
      label = "Name server"
      ph = "ns1.example.com"
    }
    if this.fType is "SRV" {
      label = "Target host"
      ph = "sip.example.com"
    }
    if this.fType is "CAA" {
      label = "CA domain"
      ph = "letsencrypt.org"
    }
    this.valueLabel = label
    this.valuePlaceholder = ph
  }

  buildSettingsButtons() {
    const activeCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200"
    const idleCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40"

    const ttls = [[0, "Default"], [300, "5 min"], [3600, "1 hour"], [14400, "4 hours"], [86400, "1 day"], [604800, "1 week"]]
    this.sTtlButtons = ttls.map((t) => ({ key: t[0], label: t[1], cls: t[0] is this.sTtl ? activeCls : idleCls }))
  }

  async loadRecords() {
    const result = await useApi("/api/providers/" + this.providerId + "/domains/" + this.domainId + "/records")

    if result.ok {
      this.domainName = result.data.domain.name
      this.domainEmail = result.data.domain.email or ""
      this.domainTtl = result.data.domain.ttl or 0
      this.domainTtlText = this.ttlLabel(this.domainTtl)
      this.records = result.data.records.map((r) => this.decorate(r))
      this.locked = false
      this.error = ""
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 {
      this.locked = true
      this.error = result.data?.error or ""
    } else {
      this.error = result.data?.error or "Couldn't load the records. Try again."
    }

    this.applyFilter()
  }

  openAdd() {
    this.clearErrors()
    this.editingId = ""
    this.fType = "A"
    this.fName = ""
    this.fValue = ""
    this.fPriority = "10"
    this.fWeight = "0"
    this.fPort = "0"
    this.fService = ""
    this.fProtocol = "tcp"
    this.fTag = "issue"
    this.fTtl = 0
    this.buildButtons()
    this.formOpen = true
  }

  openEdit(id) {
    const r = this.records.find((x) => x.id is id)
    if not r {
      return null
    }

    this.clearErrors()
    this.editingId = id
    this.fType = r.type
    this.fName = r.name
    this.fValue = r.value
    this.fPriority = "10"
    if r.priority is not null {
      this.fPriority = String(r.priority)
    }
    this.fWeight = "0"
    if r.weight is not null {
      this.fWeight = String(r.weight)
    }
    this.fPort = "0"
    if r.port is not null {
      this.fPort = String(r.port)
    }
    this.fService = r.service or ""
    this.fProtocol = r.protocol or "tcp"
    this.fTag = r.tag or "issue"
    this.fTtl = r.ttl
    this.buildButtons()
    this.formOpen = true
  }

  closeForm() {
    this.formOpen = false
    this.editingId = ""
  }

  pickType(t) {
    this.fType = t
    this.buildButtons()
  }

  pickTtl(v) {
    this.fTtl = v
    this.buildButtons()
  }

  pickProtocol(p) {
    this.fProtocol = p
    this.buildButtons()
  }

  pickTag(t) {
    this.fTag = t
    this.buildButtons()
  }

  pickChip(ip) {
    this.fValue = ip
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()
    this.saving = true

    const payload = {
      type: this.fType,
      name: this.fName,
      value: this.fValue,
      ttl: this.fTtl,
      priority: this.fPriority,
      weight: this.fWeight,
      port: this.fPort,
      service: this.fService,
      protocol: this.fProtocol,
      tag: this.fTag
    }

    let url = "/api/providers/" + this.providerId + "/domains/" + this.domainId + "/records"
    let method = "POST"
    if this.editingId is not "" {
      url = url + "/" + this.editingId
      method = "PUT"
    }

    const result = await useApi(url, { method: method, body: payload })
    this.saving = false

    if result.ok {
      this.closeForm()
      await this.loadRecords()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.nameError = this.firstError(errors, "name")
      this.valueError = this.firstError(errors, "value")
      this.priorityError = this.firstError(errors, "priority")
      this.weightError = this.firstError(errors, "weight")
      this.portError = this.firstError(errors, "port")
      this.serviceError = this.firstError(errors, "service")
      this.tagError = this.firstError(errors, "tag")
      this.ttlError = this.firstError(errors, "ttl")
      this.formError = this.firstError(errors, "type") or this.firstError(errors, "protocol") or result.data?.error or ""
      if not errors and this.formError is "" {
        this.formError = "Couldn't save the record. Try again."
      }
    }
  }

  askRemove(id) {
    this.error = ""
    this.removing = id
  }

  cancelRemove() {
    this.removing = ""
  }

  async confirmRemove(id) {
    if this.removeBusy {
      return null
    }

    this.removeBusy = true
    const result = await useApi("/api/providers/" + this.providerId + "/domains/" + this.domainId + "/records/" + id, { method: "DELETE" })
    this.removeBusy = false
    this.removing = ""

    if not result.ok {
      this.error = result.data?.error or "Couldn't delete that record."
    }

    await this.loadRecords()
  }

  openSettings() {
    this.sEmailError = ""
    this.sTtlError = ""
    this.sFormError = ""
    this.sEmail = this.domainEmail
    this.sTtl = this.domainTtl
    this.buildSettingsButtons()
    this.settingsOpen = true
  }

  closeSettings() {
    this.settingsOpen = false
  }

  pickSettingsTtl(v) {
    this.sTtl = v
    this.buildSettingsButtons()
  }

  async saveSettings() {
    if this.sSaving {
      return null
    }

    this.sEmailError = ""
    this.sTtlError = ""
    this.sFormError = ""
    this.sSaving = true

    const result = await useApi("/api/providers/" + this.providerId + "/domains/" + this.domainId, {
      method: "PUT",
      body: { email: this.sEmail, ttl: this.sTtl }
    })

    this.sSaving = false

    if result.ok {
      this.closeSettings()
      await this.loadRecords()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.sEmailError = this.firstError(errors, "email")
      this.sTtlError = this.firstError(errors, "ttl")
      this.sFormError = result.data?.error or ""
      if not errors and this.sFormError is "" {
        this.sFormError = "Couldn't save the settings. Try again."
      }
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    const domain = params.get("domain")

    if not id or not domain {
      window.location.href = "/providers"
      return null
    }

    this.providerId = id
    this.domainId = domain

    const p = await useApi("/api/providers/" + id)
    if not p.ok {
      window.location.href = "/providers"
      return null
    }
    this.kind = p.data.kind

    this.buildButtons()
    await this.loadRecords()

    // Quick-fill chips for A records: the IPs of servers created through this connection.
    const prov = await useApi("/api/provisions")
    if prov.ok and Array.isArray(prov.data) {
      const mine = prov.data.filter((r) => r.provider_id is Number(id) and r.ip)
      this.chips = mine.map((r) => ({ label: r.name + " · " + r.ip, ip: r.ip }))
    }

    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
<div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_230px_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
  <Sidebar active="providers" />
  <ProviderSidebar active="domains" providerId="{{ providerId }}" />
  <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

      <a href="{{ '/providers/provider-domains?id=' + providerId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Domains
      </a>

      <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1 truncate">{{ domainName }}</h1>
          <p class="text-slate-500 text-sm">DNS records</p>
        </div>
{{#if not locked}}
        <button onclick="{{ openAdd() }}" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Add record</button>
{{/if}}
      </div>

{{#if locked}}
      <div role="alert" class="rounded-xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 mb-4">
        <p class="text-amber-800 dark:text-amber-400 text-sm">{{ error }}</p>
      </div>
{{/if}}

{{#if not locked}}
{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}
{{/if}}

{{#if not locked}}
{{#if kind is "linode"}}
{{#if not settingsOpen}}
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-5 py-3 mb-6 shadow-sm dark:shadow-none">
        <p class="text-slate-500 text-xs">
          SOA email <span class="text-slate-900 dark:text-slate-100 font-mono">{{ domainEmail }}</span>
          <span class="mx-2">·</span>
          Default TTL <span class="text-slate-900 dark:text-slate-100 font-mono">{{ domainTtlText }}</span>
        </p>
        <button onclick="{{ openSettings() }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Edit settings</button>
      </div>
{{/if}}

{{#if settingsOpen}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 mb-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Domain settings</h2>

        <label for="set-email" class="block text-slate-500 text-xs font-medium mb-1.5">SOA email</label>
        <input
          id="set-email"
          type="text"
          value="{{ sEmail }}"
          oninput="{{ sEmail = $event.target.value }}"
          class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          placeholder="admin@example.com"
        />
{{#if sEmailError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ sEmailError }}</p>
{{/if}}

        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mt-5 mb-2">Default TTL</p>
        <div class="flex flex-wrap gap-2">
{{#each t in sTtlButtons}}
          <button onclick="{{ pickSettingsTtl(t.key) }}" class="{{ t.cls }}">{{ t.label }}</button>
{{/each}}
        </div>
{{#if sTtlError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ sTtlError }}</p>
{{/if}}

{{#if sFormError}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ sFormError }}</p>
{{/if}}

        <div class="flex items-center justify-end gap-3 mt-6">
          <button onclick="{{ closeSettings() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">Cancel</button>
{{#if sSaving}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">Saving…</button>
{{/if}}
{{#if not sSaving}}
          <button onclick="{{ saveSettings() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Save settings</button>
{{/if}}
        </div>
      </div>
{{/if}}
{{/if}}
{{/if}}

{{#if formOpen}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 mb-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">
{{#if editingId}}
          Edit {{ fType }} record
{{/if}}
{{#if not editingId}}
          Add a record
{{/if}}
        </h2>

{{#if not editingId}}
        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Type</p>
        <div class="flex flex-wrap gap-2 mb-5">
{{#each t in typeButtons}}
          <button onclick="{{ pickType(t.key) }}" class="{{ t.cls }}">{{ t.key }}</button>
{{/each}}
        </div>
{{/if}}

{{#if fType is "SRV"}}
        <label for="rec-service" class="block text-slate-500 text-xs font-medium mb-1.5">Service</label>
        <input
          id="rec-service"
          type="text"
          value="{{ fService }}"
          oninput="{{ fService = $event.target.value }}"
          class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          placeholder="sip"
        />
{{#if serviceError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ serviceError }}</p>
{{/if}}

        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mt-4 mb-2">Protocol</p>
        <div class="flex flex-wrap gap-2">
{{#each p in protocolButtons}}
          <button onclick="{{ pickProtocol(p.key) }}" class="{{ p.cls }}">{{ p.key }}</button>
{{/each}}
        </div>
{{/if}}

{{#if fType is not "SRV"}}
        <label for="rec-name" class="block text-slate-500 text-xs font-medium mb-1.5">Name</label>
        <input
          id="rec-name"
          type="text"
          value="{{ fName }}"
          oninput="{{ fName = $event.target.value }}"
          class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          placeholder="@ for the root, or www"
        />
{{#if nameError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ nameError }}</p>
{{/if}}
{{/if}}

{{#if fType is "CAA"}}
        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mt-4 mb-2">Tag</p>
        <div class="flex flex-wrap gap-2">
{{#each t in tagButtons}}
          <button onclick="{{ pickTag(t.key) }}" class="{{ t.cls }}">{{ t.key }}</button>
{{/each}}
        </div>
{{#if tagError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ tagError }}</p>
{{/if}}
{{/if}}

        <label for="rec-value" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">{{ valueLabel }}</label>
        <input
          id="rec-value"
          type="text"
          value="{{ fValue }}"
          oninput="{{ fValue = $event.target.value }}"
          class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          placeholder="{{ valuePlaceholder }}"
        />
{{#if valueError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ valueError }}</p>
{{/if}}

{{#if fType is "A"}}
{{#if chips.length is not 0}}
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <span class="text-slate-500 text-xs">Use a server:</span>
{{#each c in chips}}
          <button onclick="{{ pickChip(c.ip) }}" class="text-xs font-mono text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">{{ c.label }}</button>
{{/each}}
        </div>
{{/if}}
{{/if}}

{{#if fType is "MX"}}
        <label for="rec-priority" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">Priority</label>
        <input
          id="rec-priority"
          type="text"
          inputmode="numeric"
          value="{{ fPriority }}"
          oninput="{{ fPriority = $event.target.value }}"
          class="w-32 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        />
{{#if priorityError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ priorityError }}</p>
{{/if}}
{{/if}}

{{#if fType is "SRV"}}
        <div class="flex flex-wrap gap-4 mt-4">
          <div>
            <label for="rec-srv-priority" class="block text-slate-500 text-xs font-medium mb-1.5">Priority</label>
            <input
              id="rec-srv-priority"
              type="text"
              inputmode="numeric"
              value="{{ fPriority }}"
              oninput="{{ fPriority = $event.target.value }}"
              class="w-28 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
            />
{{#if priorityError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ priorityError }}</p>
{{/if}}
          </div>
          <div>
            <label for="rec-weight" class="block text-slate-500 text-xs font-medium mb-1.5">Weight</label>
            <input
              id="rec-weight"
              type="text"
              inputmode="numeric"
              value="{{ fWeight }}"
              oninput="{{ fWeight = $event.target.value }}"
              class="w-28 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
            />
{{#if weightError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ weightError }}</p>
{{/if}}
          </div>
          <div>
            <label for="rec-port" class="block text-slate-500 text-xs font-medium mb-1.5">Port</label>
            <input
              id="rec-port"
              type="text"
              inputmode="numeric"
              value="{{ fPort }}"
              oninput="{{ fPort = $event.target.value }}"
              class="w-28 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
            />
{{#if portError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ portError }}</p>
{{/if}}
          </div>
        </div>
{{/if}}

        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mt-5 mb-2">TTL</p>
        <div class="flex flex-wrap gap-2">
{{#each t in ttlButtons}}
          <button onclick="{{ pickTtl(t.key) }}" class="{{ t.cls }}">{{ t.label }}</button>
{{/each}}
        </div>
{{#if ttlError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ ttlError }}</p>
{{/if}}
{{#if kind is "hetzner"}}
        <p class="text-slate-500 text-xs mt-2">At Hetzner the TTL applies to every record with the same name and type.</p>
{{/if}}

{{#if formError}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ formError }}</p>
{{/if}}

        <div class="flex items-center justify-end gap-3 mt-6">
          <button onclick="{{ closeForm() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">Cancel</button>
{{#if saving}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">Saving…</button>
{{/if}}
{{#if not saving}}
          <button onclick="{{ submit() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Save record</button>
{{/if}}
        </div>
      </div>
{{/if}}

{{#if not locked}}
      <div class="flex flex-wrap items-center gap-2 mb-5">
{{#each t in tabs}}
        <button onclick="{{ setFilter(t.key) }}" class="{{ t.cls }}">
          {{ t.label }}
          <span class="text-xs opacity-70">{{ t.count }}</span>
        </button>
{{/each}}
      </div>

{{#if shown.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center">
        <p class="text-slate-500 text-sm">No records to show.</p>
      </div>
{{/if}}

      <div class="space-y-2">
{{#each r in shown}}
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 shadow-sm dark:shadow-none">
          <div class="flex flex-wrap items-center gap-3">
            <span class="{{ r.badgeCls }}">{{ r.type }}</span>
            <div class="min-w-0 flex-1 basis-48">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono font-medium truncate">{{ r.name }}</p>
              <p class="text-slate-500 text-xs font-mono break-all">{{ r.valueText }}</p>
            </div>
            <span class="text-slate-500 text-xs shrink-0">{{ r.ttlText }}</span>

{{#if r.locked}}
            <span class="text-slate-400 text-xs shrink-0">Managed by {{ kind }}</span>
{{/if}}

{{#if not r.locked}}
{{#if removing is r.id}}
            <button onclick="{{ confirmRemove(r.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 py-1.5 transition">Yes, delete</button>
            <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-1.5 transition-colors">Cancel</button>
{{/if}}
{{#if removing is not r.id}}
            <button onclick="{{ openEdit(r.id) }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Edit</button>
            <button onclick="{{ askRemove(r.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-full px-4 py-1.5 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">Delete</button>
{{/if}}
{{/if}}
          </div>
        </div>
{{/each}}
      </div>
{{/if}}

    </div>
  </div>
</div>
{{/if}}