page ProviderDomain

import { IconArrowLeft } from "tylix-icons"

title "DNS records"

needs
  Auth

uses
  Billing

background
  Billing

state
  checkedAuth: false
  providerId: ""
  domainId: ""
  domainName: ""
  domainEmail: ""
  domainTtl: 0
  domainTtlText: ""
  kind: ""
  locked: false
  error: ""
  records: []
  shown: []
  tabs: []
  filter: "ALL"
  chips: []
  formOpen: false
  editingRecord: null
  removing: ""
  removeBusy: false
  removeCode: ""
  removeCodeError: ""
  twoFactorOn: false
  tfTotp: false
  tfSms: false
  smsHint: ""
  smsSending: false
  smsNotice: ""
  settingsOpen: false
  sEmail: ""
  sTtl: 0
  sTtlButtons: []
  sSaving: false
  sEmailError: ""
  sTtlError: ""
  sFormError: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  // Which second factors this account has on. Used to decide whether to ask for a code.
  async loadTwoFactor() {
    const result = await useApi("/api/account")
    if result.ok and result.data and result.data.two_factor {
      const tf = result.data.two_factor
      const sms = tf.sms
      this.tfTotp = Boolean(tf.enabled)
      this.tfSms = Boolean(sms and sms.enabled)
      this.smsHint = (sms and sms.phone_hint) or ""
      this.twoFactorOn = this.tfTotp or this.tfSms
    }
  }

  clearRemoveState() {
    this.removeCode = ""
    this.removeCodeError = ""
    this.smsNotice = ""
  }

  async sendRemoveCode() {
    if this.smsSending {
      return null
    }

    this.smsSending = true
    this.removeCodeError = ""
    this.smsNotice = ""

    const result = await useApi("/api/account/two-factor/sms/send-code", { method: "POST" })

    this.smsSending = false

    if result.ok {
      this.smsNotice = "Code sent to " + this.smsHint + "."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.removeCodeError = result.data?.error or "Couldn't send the code."
    }
  }

  ttlLabel(n) {
    const known = [[0, "Default"], [300, "5 min"], [3600, "1 hour"], [14400, "4 hours"], [86400, "1 day"], [604800, "1 week"]]
    const hit = known.find((k) => k[0] is n)
    if hit {
      return hit[1]
    }
    return n + " s"
  }

  badgeCls(type) {
    let tone = "bg-slate-500/10 text-slate-600 dark:text-slate-300"
    if type is "A" {
      tone = "bg-emerald-500/10 text-emerald-700 dark:text-emerald-500"
    }
    if type is "AAAA" {
      tone = "bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    if type is "CNAME" {
      tone = "bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    if type is "MX" {
      tone = "bg-amber-500/10 text-amber-600 dark:text-amber-500"
    }
    if type is "NS" {
      tone = "bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    if type is "SRV" {
      tone = "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400"
    }
    if type is "CAA" {
      tone = "bg-fuchsia-500/10 text-fuchsia-600 dark:text-fuchsia-400"
    }
    return "inline-flex w-16 shrink-0 justify-center rounded-md px-2 py-1 text-xs font-semibold font-mono " + tone
  }

  decorate(r) {
    let valueText = r.value
    if r.type is "MX" {
      valueText = r.priority + " " + r.value
    }
    if r.type is "SRV" {
      valueText = r.priority + " " + r.weight + " " + r.port + " " + r.value
    }
    if r.type is "CAA" {
      valueText = r.tag + " " + r.value
    }

    return Object.assign({}, r, {
      badgeCls: this.badgeCls(r.type),
      ttlText: this.ttlLabel(r.ttl),
      valueText: valueText
    })
  }

  applyFilter() {
    const types = ["ALL", "A", "AAAA", "CNAME", "MX", "TXT", "NS", "SRV", "CAA"]
    const activeCls = "inline-flex items-center gap-2 rounded-full bg-emerald-500 text-white dark:text-slate-950 text-sm font-semibold px-4 py-1.5 shadow-sm transition-all"
    const idleCls = "inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 text-sm font-medium px-4 py-1.5 hover:border-emerald-500/50 transition-all"

    this.shown = this.filter is "ALL" ? this.records : this.records.filter((r) => r.type is this.filter)
    this.tabs = types.map((t) => ({
      key: t,
      label: t is "ALL" ? "All" : t,
      count: t is "ALL" ? this.records.length : this.records.filter((r) => r.type is t).length,
      cls: t is this.filter ? activeCls : idleCls
    }))
  }

  setFilter(key) {
    this.filter = key
    this.applyFilter()
  }

  buildSettingsButtons() {
    const activeCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200"
    const idleCls = "text-left rounded-xl border px-4 py-2 text-sm font-mono transition-colors border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40"

    const ttls = [[0, "Default"], [300, "5 min"], [3600, "1 hour"], [14400, "4 hours"], [86400, "1 day"], [604800, "1 week"]]
    this.sTtlButtons = ttls.map((t) => ({ key: t[0], label: t[1], cls: t[0] is this.sTtl ? activeCls : idleCls }))
  }

  async loadRecords() {
    const result = await useApi("/api/providers/" + this.providerId + "/domains/" + this.domainId + "/records")

    if result.ok {
      this.domainName = result.data.domain.name
      this.domainEmail = result.data.domain.email or ""
      this.domainTtl = result.data.domain.ttl or 0
      this.domainTtlText = this.ttlLabel(this.domainTtl)
      this.records = result.data.records.map((r) => this.decorate(r))
      this.locked = false
      this.error = ""
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 {
      this.locked = true
      this.error = result.data?.error or ""
    } else {
      this.error = result.data?.error or "Couldn't load the records. Try again."
    }

    this.applyFilter()
  }

  openAdd() {
    if Billing.locked {
      return null
    }

    this.editingRecord = null
    this.formOpen = true
  }

  openEdit(id) {
    if Billing.locked {
      return null
    }

    const r = this.records.find((x) => x.id is id)
    if not r {
      return null
    }

    this.editingRecord = r
    this.formOpen = true
  }

  closeForm() {
    this.formOpen = false
    this.editingRecord = null
  }

  async recordSaved() {
    this.closeForm()
    await this.loadRecords()
  }

  async askRemove(id) {
    if Billing.locked {
      return null
    }

    this.error = ""
    this.clearRemoveState()
    this.removing = id

    // SMS is the only method: text the code right away.
    if this.tfSms and not this.tfTotp {
      await this.sendRemoveCode()
    }
  }

  cancelRemove() {
    this.removing = ""
    this.clearRemoveState()
  }

  async confirmRemove(id) {
    if Billing.locked {
      return null
    }

    if this.removeBusy {
      return null
    }

    this.removeCodeError = ""

    const code = this.removeCode.trim()

    if this.twoFactorOn and code is "" {
      this.removeCodeError = "Enter a verification code to delete this record."
      return null
    }

    let url = "/api/providers/" + this.providerId + "/domains/" + this.domainId + "/records/" + id
    if code is not "" {
      url = url + "?code=" + encodeURIComponent(code)
    }

    this.removeBusy = true
    const result = await useApi(url, { method: "DELETE" })
    this.removeBusy = false

    if result.ok {
      this.removing = ""
      this.clearRemoveState()
      await this.loadRecords()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data and result.data.two_factor_required {
      // The status call failed or was stale: the server says a code is needed.
      const methods = result.data.methods or []
      this.twoFactorOn = true
      this.tfTotp = methods.includes("totp")
      this.tfSms = methods.includes("sms")
      this.removeCodeError = result.data.error or "Enter a verification code to delete this record."
    } else if result.status is 422 and result.data and result.data.errors and result.data.errors.code {
      this.removeCodeError = result.data.errors.code[0]
    } else {
      this.removing = ""
      this.clearRemoveState()
      this.error = result.data?.error or "Couldn't delete that record."
      await this.loadRecords()
    }
  }

  openSettings() {
    if Billing.locked {
      return null
    }

    this.sEmailError = ""
    this.sTtlError = ""
    this.sFormError = ""
    this.sEmail = this.domainEmail
    this.sTtl = this.domainTtl
    this.buildSettingsButtons()
    this.settingsOpen = true
  }

  closeSettings() {
    this.settingsOpen = false
  }

  pickSettingsTtl(v) {
    this.sTtl = v
    this.buildSettingsButtons()
  }

  async saveSettings() {
    if Billing.locked {
      return null
    }

    if this.sSaving {
      return null
    }

    this.sEmailError = ""
    this.sTtlError = ""
    this.sFormError = ""
    this.sSaving = true

    const result = await useApi("/api/providers/" + this.providerId + "/domains/" + this.domainId, {
      method: "PUT",
      body: { email: this.sEmail, ttl: this.sTtl }
    })

    this.sSaving = false

    if result.ok {
      this.closeSettings()
      await this.loadRecords()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.sEmailError = this.firstError(errors, "email")
      this.sTtlError = this.firstError(errors, "ttl")
      this.sFormError = result.data?.error or ""
      if not errors and this.sFormError is "" {
        this.sFormError = "Couldn't save the settings. Try again."
      }
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    const domain = params.get("domain")

    if not id or not domain {
      window.location.href = "/providers"
      return null
    }

    this.providerId = id
    this.domainId = domain

    const p = await useApi("/api/providers/" + id)
    if not p.ok {
      window.location.href = "/providers"
      return null
    }
    this.kind = p.data.kind

    await this.loadTwoFactor()
    await this.loadRecords()

    // Quick-fill chips for A records: the IPs of servers created through this connection.
    const prov = await useApi("/api/provisions")
    if prov.ok and Array.isArray(prov.data) {
      const mine = prov.data.filter((r) => r.provider_id is Number(id) and r.ip)
      this.chips = mine.map((r) => ({ label: r.name + " · " + r.ip, ip: r.ip }))
    }

    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
<div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
  <Sidebar active="providers" />
  <ProviderSidebar active="domains" providerId="{{ providerId }}" />
  <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

      <a href="{{ '/providers/provider-domains?id=' + providerId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Domains
      </a>

      <LockedBanner />

      <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1 truncate">{{ domainName }}</h1>
          <p class="text-slate-500 text-sm">DNS records</p>
        </div>
{{#if not locked}}
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Add record
        </button>
{{/if}}
{{#if not Billing.locked}}
        <button onclick="{{ openAdd() }}" class="inline-flex items-center text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Add record</button>
{{/if}}
{{/if}}
      </div>

{{#if locked}}
      <div role="alert" class="rounded-xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 mb-4">
        <p class="text-amber-800 dark:text-amber-400 text-sm">{{ error }}</p>
      </div>
{{/if}}

{{#if not locked}}
{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}
{{/if}}

{{#if not locked}}
{{#if kind is "linode"}}
{{#if not settingsOpen}}
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-5 py-3 mb-6 shadow-sm dark:shadow-none">
        <p class="text-slate-500 text-xs">
          SOA email <span class="text-slate-900 dark:text-slate-100 font-mono">{{ domainEmail }}</span>
          <span class="mx-2">·</span>
          Default TTL <span class="text-slate-900 dark:text-slate-100 font-mono">{{ domainTtlText }}</span>
        </p>
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Edit settings
        </button>
{{/if}}
{{#if not Billing.locked}}
        <button onclick="{{ openSettings() }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Edit settings</button>
{{/if}}
      </div>
{{/if}}

{{#if settingsOpen}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 mb-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Domain settings</h2>

        <label for="set-email" class="block text-slate-500 text-xs font-medium mb-1.5">SOA email</label>
        <input
          id="set-email"
          type="text"
          value="{{ sEmail }}"
          oninput="{{ sEmail = $event.target.value }}"
          class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          placeholder="admin@example.com"
        />
{{#if sEmailError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ sEmailError }}</p>
{{/if}}

        <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mt-5 mb-2">Default TTL</p>
        <div class="flex flex-wrap gap-2">
{{#each t in sTtlButtons}}
          <button onclick="{{ pickSettingsTtl(t.key) }}" class="{{ t.cls }}">{{ t.label }}</button>
{{/each}}
        </div>
{{#if sTtlError}}
        <p class="text-rose-500 text-xs mt-1.5">{{ sTtlError }}</p>
{{/if}}

{{#if sFormError}}
        <p role="alert" class="text-rose-500 text-sm mt-4">{{ sFormError }}</p>
{{/if}}

        <div class="flex items-center justify-end gap-3 mt-6">
          <button onclick="{{ closeSettings() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-2 transition-colors">Cancel</button>
{{#if sSaving}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">Saving…</button>
{{/if}}
{{#if not sSaving}}
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            Save settings
          </button>
{{/if}}
{{#if not Billing.locked}}
          <button onclick="{{ saveSettings() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Save settings</button>
{{/if}}
{{/if}}
        </div>
      </div>
{{/if}}
{{/if}}
{{/if}}

{{#if formOpen}}
      <RecordForm
        providerId="{{ providerId }}"
        domainId="{{ domainId }}"
        kind="{{ kind }}"
        record="{{ editingRecord }}"
        chips="{{ chips }}"
        onClose="{{ closeForm }}"
        onSaved="{{ recordSaved }}"
      />
{{/if}}

{{#if not locked}}
      <div class="flex flex-wrap items-center gap-2 mb-5">
{{#each t in tabs}}
        <button onclick="{{ setFilter(t.key) }}" class="{{ t.cls }}">
          {{ t.label }}
          <span class="text-xs opacity-70">{{ t.count }}</span>
        </button>
{{/each}}
      </div>

{{#if shown.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-8 text-center">
        <p class="text-slate-500 text-sm">No records to show.</p>
      </div>
{{/if}}

      <div class="space-y-2">
{{#each r in shown}}
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3 shadow-sm dark:shadow-none">
          <div class="flex flex-wrap items-center gap-3">
            <span class="{{ r.badgeCls }}">{{ r.type }}</span>
            <div class="min-w-0 flex-1 basis-48">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono font-medium truncate">{{ r.name }}</p>
              <p class="text-slate-500 text-xs font-mono break-all">{{ r.valueText }}</p>
            </div>
            <span class="text-slate-500 text-xs shrink-0">{{ r.ttlText }}</span>

{{#if r.locked}}
            <span class="text-slate-400 text-xs shrink-0">Managed by {{ kind }}</span>
{{/if}}

{{#if not r.locked}}
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Edit
            </button>
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Delete
            </button>
{{/if}}
{{#if not Billing.locked}}
{{#if removing is r.id}}
{{#if twoFactorOn}}
            <div class="w-full basis-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950/50 p-4">
              <label for="remove-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Verification code</label>
              <input
                id="remove-code"
                type="text"
                inputmode="text"
                autocomplete="one-time-code"
                maxlength="12"
                value="{{ removeCode }}"
                oninput="{{ removeCode = $event.target.value }}"
                class="w-full sm:w-56 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
              />
{{#if tfTotp}}
              <p class="text-slate-500 text-xs mt-2">Enter a code from your authenticator app, or a recovery code.</p>
{{/if}}
{{#if not tfTotp}}
              <p class="text-slate-500 text-xs mt-2">Enter the code texted to {{ smsHint }}.</p>
{{/if}}
{{#if smsNotice}}
              <p role="status" class="text-emerald-700 dark:text-emerald-500 text-xs mt-2">{{ smsNotice }}</p>
{{/if}}
{{#if removeCodeError}}
              <p role="alert" class="text-rose-500 text-xs mt-2">{{ removeCodeError }}</p>
{{/if}}
{{#if tfSms}}
{{#if smsSending}}
              <button disabled class="mt-3 text-xs text-slate-500 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 opacity-50">Sending…</button>
{{/if}}
{{#if not smsSending}}
              <button onclick="{{ sendRemoveCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Text me a code</button>
{{/if}}
{{/if}}
            </div>
{{/if}}
            <button onclick="{{ confirmRemove(r.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 py-1.5 transition">Yes, delete</button>
            <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 px-3 py-1.5 transition-colors">Cancel</button>
{{/if}}
{{#if removing is not r.id}}
            <button onclick="{{ openEdit(r.id) }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Edit</button>
            <button onclick="{{ askRemove(r.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-full px-4 py-1.5 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">Delete</button>
{{/if}}
{{/if}}
{{/if}}
          </div>
        </div>
{{/each}}
      </div>
{{/if}}

    </div>
  </div>
</div>
{{/if}}