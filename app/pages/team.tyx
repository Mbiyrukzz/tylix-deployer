page Team

title "Team"

needs
  Auth

state
  loading: true
  teamName: ""
  role: ""
  scope: "team"
  members: []
  events: []
  page: 1
  pages: 1
  total: 0
  hasPrev: false
  hasNext: false
  rangeText: ""
  paging: false

action
  ago(iso) {
    if not iso {
      return "Never"
    }
    const t = new Date(iso).getTime()
    if Number.isNaN(t) {
      return "Unknown"
    }
    const s = Math.floor((Date.now() - t) / 1000)
    if s < 60 {
      return "Just now"
    }
    const m = Math.floor(s / 60)
    if m < 60 {
      return m + "m ago"
    }
    const h = Math.floor(m / 60)
    if h < 24 {
      return h + "h ago"
    }
    const d = Math.floor(h / 24)
    if d < 30 {
      return d + "d ago"
    }
    return String(iso).slice(0, 10)
  }

  decorateMember(m, summary, seesAll) {
    const s = summary[String(m.id)]
    return {
      id: m.id,
      name: m.name,
      email: m.email,
      role: m.role,
      joined: m.joined,
      isMe: m.is_me,
      initial: String(m.name).slice(0, 1).toUpperCase(),
      href: "/team/member?id=" + m.id,
      canView: seesAll or m.is_me,
      total: s ? String(s.total) : (seesAll or m.is_me ? "0" : "—"),
      last: s ? this.ago(s.last_at) : (seesAll or m.is_me ? "No activity" : "—")
    }
  }

  decorateEvent(e) {
    return {
      id: e.id,
      who: e.user_name,
      initial: String(e.user_name).slice(0, 1).toUpperCase(),
      verb: e.verb,
      label: e.label,
      when: this.ago(e.at),
      href: "/team/member?id=" + e.user_id
    }
  }

  async loadEvents(page) {
    const act = await useApi("/api/team/activity?per_page=10&page=" + page)

    if act.status is 401 {
      window.location.href = "/login"
      return null
    }

    if not act.ok {
      return null
    }

    const d = act.data
    this.scope = d.scope
    this.events = d.events.map((e) => this.decorateEvent(e))
    this.page = d.page
    this.pages = d.pages
    this.total = d.total
    this.hasPrev = d.page > 1
    this.hasNext = d.page < d.pages

    if d.total is 0 {
      this.rangeText = ""
    } else {
      const from = (d.page - 1) * d.per_page + 1
      const to = Math.min(d.page * d.per_page, d.total)
      this.rangeText = from + "–" + to + " of " + d.total
    }

    return d
  }

  async load() {
    const team = await useApi("/api/team")

    if team.status is 401 {
      window.location.href = "/login"
      return null
    }

    if team.ok {
      this.teamName = team.data.team.name
      this.role = team.data.role
    }

    const d = await this.loadEvents(1)
    const list = await useApi("/api/team/members")

    if list.ok {
      const summary = d ? d.summary : {}
      const seesAll = d ? d.scope is "team" : false
      this.members = list.data.members.map((m) => this.decorateMember(m, summary, seesAll))
    }

    this.loading = false
  }

  async prev() {
    if this.paging or not this.hasPrev {
      return null
    }
    this.paging = true
    await this.loadEvents(this.page - 1)
    this.paging = false
  }

  async next() {
    if this.paging or not this.hasNext {
      return null
    }
    this.paging = true
    await this.loadEvents(this.page + 1)
    this.paging = false
  }

onMount
  async {
    await this.load()
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_1fr] bg-page transition-colors">
    <Sidebar active="team" />
    <TeamSidebar active="members" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Team</h1>
          <p class="text-slate-500 text-sm">{{ teamName }} · your role: <span class="font-semibold text-slate-700 dark:text-slate-300">{{ role }}</span></p>
        </div>
        <a href="/settings/team" class="text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 hover:bg-white dark:hover:bg-slate-900 transition-colors text-center">Invites and roles</a>
      </div>

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if not loading}}
      <div class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none mb-6 overflow-hidden">
        <div class="px-6 py-4 border-b border-line">
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Members</h2>
        </div>
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each m in members}}
          <div class="flex items-center gap-4 px-6 py-4">
            <span class="w-10 h-10 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-400 text-sm font-semibold flex items-center justify-center">{{ m.initial }}</span>
            <div class="min-w-0 flex-1">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ m.name }}</p>
              <p class="text-slate-500 text-xs font-mono truncate">{{ m.email }}</p>
            </div>
            <span class="hidden sm:inline-flex items-center rounded-full bg-brand-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500">{{ m.role }}</span>
            <div class="hidden md:block w-24 text-right">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-semibold">{{ m.total }}</p>
              <p class="text-slate-500 text-xs">actions</p>
            </div>
            <div class="hidden md:block w-28 text-right">
              <p class="text-slate-900 dark:text-slate-100 text-sm">{{ m.last }}</p>
              <p class="text-slate-500 text-xs">last active</p>
            </div>
{{#if m.canView}}
            <a href="{{ m.href }}" class="text-xs text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition shrink-0">View</a>
{{/if}}
{{#if not m.canView}}
            <span class="w-[3.25rem] shrink-0"></span>
{{/if}}
          </div>
{{/each}}
        </div>
      </div>

      <div class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
        <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-line">
{{#if scope is "team"}}
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Recent team activity</h2>
{{/if}}
{{#if scope is "self"}}
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Your recent activity</h2>
{{/if}}
          <a href="/team/activity" class="text-xs text-brand-700 dark:text-brand-400 font-semibold hover:underline shrink-0">View all</a>
        </div>
{{#if events.length is 0}}
        <p class="px-6 py-8 text-slate-500 text-sm text-center">No activity yet.</p>
{{/if}}
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
{{#each e in events}}
          <div class="flex items-center gap-3 px-6 py-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-400 text-xs font-semibold flex items-center justify-center">{{ e.initial }}</span>
            <p class="min-w-0 flex-1 text-sm text-slate-600 dark:text-slate-400 truncate">
              <a href="{{ e.href }}" class="font-medium text-slate-900 dark:text-slate-100 hover:underline">{{ e.who }}</a>
              {{ e.verb }}
              <span class="font-mono text-slate-900 dark:text-slate-100">{{ e.label }}</span>
            </p>
            <span class="text-slate-500 text-xs shrink-0">{{ e.when }}</span>
          </div>
{{/each}}
        </div>

{{#if total is not 0}}
        <div class="flex items-center justify-between gap-4 px-6 py-3 border-t border-line">
          <p class="text-slate-500 text-xs">{{ rangeText }}</p>
          <div class="flex items-center gap-2">
{{#if hasPrev}}
            <button onclick="{{ prev() }}" class="text-xs text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">Previous</button>
{{/if}}
{{#if not hasPrev}}
            <button disabled class="text-xs text-slate-400 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 opacity-50">Previous</button>
{{/if}}
{{#if hasNext}}
            <button onclick="{{ next() }}" class="text-xs text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-1.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">Next</button>
{{/if}}
{{#if not hasNext}}
            <button disabled class="text-xs text-slate-400 border border-slate-200 dark:border-slate-800 rounded-lg px-3 py-1.5 opacity-50">Next</button>
{{/if}}
          </div>
        </div>
{{/if}}
      </div>
{{/if}}

    </div>
    </div>
  </div>