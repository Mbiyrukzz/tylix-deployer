page ServerSettings

import { IconChevronRight, IconKey, IconCpuChip, IconTerminal, IconCopy, IconCheck, IconSignal, IconLink, IconShieldCheck, IconPower, IconTrash, IconExclamationTriangle, IconArrowPath, IconEye, IconRefresh } from "tylix-icons"

title "Server settings"

needs
  Auth

state
  serverId: ""
  server: null
  key: null
  hostKey: null
  hostKeyDate: ""
  revealed: false
  revealTimer: 0
  deployFp: ""
  hostFp: ""
  provision: null
  loading: true
  isMissing: false
  flash: ""
  flashError: ""
  flashTimer: 0
  copied: ""
  copiedTimer: 0
  working: ""
  statusClass: ""
  pingClass: "hidden"
  checkedText: ""
  createdText: ""
  keyDate: ""
  sshCmd: ""
  fName: ""
  fHost: ""
  fPort: ""
  fUser: ""
  fKey: ""
  showKeyForm: false
  sys: null
  sysLoading: false
  sysError: ""
  rawServices: []
  services: []
  memStyle: ""
  diskStyle: ""
  memText: ""
  diskText: ""
  memPct: 0
  diskPct: 0
  memBar: "bg-brand-500"
  diskBar: "bg-sky-500"
  uptimeText: ""
  fZone: ""
  fHostname: ""
  blockers: []
  canDelete: false
  provisioned: false
  codeOpen: false
  codeValue: ""
  codeError: ""
  codeTitle: ""
  codeBusy: false
  pending: null
  lastError: ""
  confirmOpen: false
  confirmKind: ""
  confirmArg: ""
  confirmTitle: ""
  confirmText: ""
  confirmLabel: ""
  confirmIconCls: ""
  confirmBtnCls: ""

action
  say(message, isError) {
    this.flash = isError ? "" : message
    this.flashError = isError ? message : ""
    window.clearTimeout(this.flashTimer)
    this.flashTimer = window.setTimeout(() => {
      this.flash = ""
      this.flashError = ""
    }, 8000)
  }

  clearFlash() {
    window.clearTimeout(this.flashTimer)
    this.flash = ""
    this.flashError = ""
  }

  markCopied(id) {
    this.copied = id
    window.clearTimeout(this.copiedTimer)
    this.copiedTimer = window.setTimeout(() => {
      this.copied = ""
    }, 2000)
  }

  copyFallback(text, id) {
    const ta = document.createElement("textarea")
    ta.value = text
    ta.setAttribute("readonly", "")
    ta.style.position = "fixed"
    ta.style.opacity = "0"
    document.body.appendChild(ta)
    ta.select()
    const ok = document.execCommand("copy")
    document.body.removeChild(ta)

    if ok {
      this.markCopied(id)
    } else {
      this.say("Couldn't copy. Select the text and copy it by hand.", true)
    }
  }

  copy(text, id) {
    if not text {
      return null
    }

    if navigator.clipboard and window.isSecureContext {
      navigator.clipboard.writeText(text).then(() => {
        this.markCopied(id)
      }).catch(() => {
        this.copyFallback(text, id)
      })
    } else {
      this.copyFallback(text, id)
    }
  }

  pill(status) {
    const base = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider ring-1 "
    if status is "online" {
      return base + "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 ring-emerald-500/25"
    }
    if status is "offline" {
      return base + "bg-rose-500/10 text-rose-600 dark:text-rose-400 ring-rose-500/25"
    }
    return base + "bg-amber-500/10 text-amber-700 dark:text-amber-400 ring-amber-500/25"
  }

  ping(status) {
    if status is "online" {
      return "absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping"
    }
    return "hidden"
  }

  fmtDate(value) {
    if not value {
      return ""
    }
    return new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value))
  }

  fmtUptime(s) {
    const d = Math.floor(s / 86400)
    const h = Math.floor((s % 86400) / 3600)
    const m = Math.floor((s % 3600) / 60)
    if d > 0 {
      return d + "d " + h + "h"
    }
    if h > 0 {
      return h + "h " + m + "m"
    }
    return m + "m"
  }

  fmtSize(mb) {
    return mb >= 1024 ? (mb / 1024).toFixed(1) + " GB" : mb + " MB"
  }

  pct(used, total) {
    return total > 0 ? Math.min(100, Math.round(used * 100 / total)) : 0
  }

  barStyle(used, total) {
    return "width: " + this.pct(used, total) + "%"
  }

  barColor(p, base) {
    if p >= 90 {
      return "bg-rose-500"
    }
    if p >= 75 {
      return "bg-amber-500"
    }
    return base
  }

  needsCode(result) {
    if result.status is not 403 {
      return false
    }

    const d = result.data or {}
    const text = ("" + (d.error or "") + " " + (d.code or "")).toLowerCase()
    return d.two_factor_required is true or d.code is "two_factor_required" or text.includes("two_factor") or text.includes("two-factor")
  }

  firstError(result, fallback) {
    const errors = result.data?.errors
    if errors {
      const lists = Object.values(errors)
      const first = lists[0]
      if Array.isArray(first) and first.length > 0 {
        return first[0]
      }
    }
    return result.data?.error or fallback
  }

  hideKey() {
    window.clearTimeout(this.revealTimer)
    this.revealTimer = 0
    this.revealed = false
    this.deployFp = ""
    this.hostFp = ""
  }

  applySettings(data) {
    const s = data.server
    this.key = data.key
    this.hostKey = data.host_key or null
    this.hostKeyDate = data.host_key?.pinned_at ? this.fmtDate(data.host_key.pinned_at) : ""
    this.provision = data.provision
    this.fName = s.name
    this.fHost = s.host
    this.fPort = "" + s.port
    this.fUser = s.ssh_user
    this.statusClass = this.pill(s.status)
    this.pingClass = this.ping(s.status)
    this.checkedText = s.last_checked_at ? this.fmtDate(s.last_checked_at) : "Never"
    this.createdText = s.created_at ? this.fmtDate(s.created_at) : ""
    this.keyDate = data.key.rotated_at ? this.fmtDate(data.key.rotated_at) : "Not replaced since it was added"

    let cmd = "ssh " + s.ssh_user + "@" + s.host
    if Number(s.port) is not 22 {
      cmd = cmd + " -p " + s.port
    }
    this.sshCmd = cmd

    this.server = s
  }

  async loadSettings() {
    const result = await useApi("/api/servers/" + this.serverId + "/settings")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.applySettings(result.data)
    } else {
      this.isMissing = true
    }
  }

  decorateServices() {
    return this.rawServices.map((s) => Object.assign({}, s, {
      running: s.state is "active",
      busy: this.working is ("restart:" + s.id),
      dot: s.state is "active" ? "bg-emerald-500" : "bg-rose-500",
      badge: s.state is "active"
        ? "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 ring-emerald-500/25"
        : "bg-rose-500/10 text-rose-600 dark:text-rose-400 ring-rose-500/25"
    }))
  }

  setWorking(value) {
    this.working = value
    this.services = this.decorateServices()
  }

  async loadSystem() {
    this.sysLoading = true
    this.sysError = ""

    const result = await useApi("/api/servers/" + this.serverId + "/system")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      const i = result.data.info
      this.sys = i
      this.rawServices = result.data.services
      this.services = this.decorateServices()
      this.uptimeText = this.fmtUptime(i.uptime_seconds)
      this.memText = this.fmtSize(i.mem_used_mb) + " of " + this.fmtSize(i.mem_total_mb)
      this.diskText = this.fmtSize(i.disk_used_mb) + " of " + this.fmtSize(i.disk_total_mb)
      this.memPct = this.pct(i.mem_used_mb, i.mem_total_mb)
      this.diskPct = this.pct(i.disk_used_mb, i.disk_total_mb)
      this.memStyle = this.barStyle(i.mem_used_mb, i.mem_total_mb)
      this.diskStyle = this.barStyle(i.disk_used_mb, i.disk_total_mb)
      this.memBar = this.barColor(this.memPct, "bg-brand-500")
      this.diskBar = this.barColor(this.diskPct, "bg-sky-500")
      this.fZone = i.timezone
      this.fHostname = i.hostname
    } else {
      this.sysError = result.data?.error or "Couldn't read the server's details."
    }

    this.sysLoading = false
  }

  async loadDeleteCheck() {
    const result = await useApi("/api/servers/" + this.serverId + "/delete-check")

    if result.ok {
      this.blockers = result.data.blockers
      this.canDelete = result.data.can_delete
      this.provisioned = result.data.provisioned
    }
  }

  async saveGeneral() {
    if this.working is not "" {
      return null
    }

    this.setWorking("general")
    const body = { name: this.fName, host: this.fHost, port: this.fPort, ssh_user: this.fUser }
    const result = await useApi("/api/servers/" + this.serverId, { method: "PUT", body: body })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      await this.loadSettings()
      this.say("Saved. If you changed the connection details, press Test connection to check them.", false)
    } else {
      this.say(this.firstError(result, "Couldn't save the server."), true)
    }

    this.setWorking("")
  }

  async testConnection() {
    if this.working is not "" {
      return null
    }

    this.setWorking("test")
    const result = await useApi("/api/servers/" + this.serverId + "/test", { method: "POST", body: {} })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      await this.loadSettings()
      if result.data.ok {
        this.say("Connected. The server is online.", false)
      } else {
        this.say("Couldn't connect: " + result.data.error, true)
      }
    } else {
      this.say(this.firstError(result, "Couldn't run the test."), true)
    }

    this.setWorking("")
  }

  async savePastedKey() {
    if this.working is not "" {
      return null
    }

    if this.fKey.trim() is "" {
      this.say("Paste the private key first.", true)
      return null
    }

    this.setWorking("pastekey")
    const body = { name: this.fName, host: this.fHost, port: this.fPort, ssh_user: this.fUser, ssh_key: this.fKey }
    const result = await useApi("/api/servers/" + this.serverId, { method: "PUT", body: body })

    if result.ok {
      this.fKey = ""
      this.showKeyForm = false
      this.hideKey()
      await this.loadSettings()
      this.say("Key saved. Press Test connection to check that it works.", false)
    } else {
      this.say(this.firstError(result, "Couldn't save the key."), true)
    }

    this.setWorking("")
  }

  toggleKeyForm() {
    this.showKeyForm = not this.showKeyForm
  }

  askConfirm(kind, arg, title, text, label, tone) {
    this.confirmKind = kind
    this.confirmArg = arg
    this.confirmTitle = title
    this.confirmText = text
    this.confirmLabel = label

    if tone is "danger" {
      this.confirmIconCls = "bg-rose-500/10 text-rose-600 dark:text-rose-400 ring-rose-500/20"
      this.confirmBtnCls = "bg-rose-500 text-white hover:bg-rose-400"
    } else if tone is "warn" {
      this.confirmIconCls = "bg-amber-500/10 text-amber-600 dark:text-amber-400 ring-amber-500/20"
      this.confirmBtnCls = "bg-amber-500 text-white dark:text-slate-950 hover:bg-amber-400"
    } else {
      this.confirmIconCls = "bg-brand-500/10 text-brand-600 dark:text-brand-400 ring-brand-500/20"
      this.confirmBtnCls = "bg-brand-500 text-white hover:bg-brand-400"
    }

    this.confirmOpen = true
  }

  closeConfirm() {
    this.confirmOpen = false
    this.confirmKind = ""
    this.confirmArg = ""
  }

  acceptConfirm() {
    const kind = this.confirmKind
    const arg = this.confirmArg
    this.closeConfirm()

    if kind is "rotate" {
      this.doRotate()
    } else if kind is "reboot" {
      this.doReboot()
    } else if kind is "delete" {
      this.doRemove()
    } else if kind is "restart" {
      this.doRestart(arg)
    } else if kind is "trustkey" {
      this.doTrustKey()
    }
  }

  askCode(kind, title) {
    this.pending = { kind: kind }
    this.codeTitle = title
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
    this.codeOpen = true
    window.setTimeout(() => {
      const el = document.getElementById("step-up-code")
      if el {
        el.focus()
      }
    }, 80)
  }

  closeCode() {
    this.codeOpen = false
    this.pending = null
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
  }

  async submitCode() {
    if this.codeBusy or not this.pending {
      return null
    }

    const code = this.codeValue.trim()
    if code is "" {
      this.codeError = "Enter your code."
      return null
    }

    this.codeBusy = true
    this.codeError = ""
    const kind = this.pending.kind
    let outcome = "failed"

    if kind is "rotate" {
      outcome = await this.runRotate(code)
    } else if kind is "reboot" {
      outcome = await this.runReboot(code)
    } else if kind is "delete" {
      outcome = await this.runDelete(code)
    } else if kind is "hostkey" {
      outcome = await this.runPinKey(code, true)
    } else if kind is "reveal" {
      outcome = await this.runReveal(code)
    }

    if outcome is "done" {
      this.closeCode()
      return null
    }

    this.codeError = this.lastError or "That code didn't work. Try again."
    this.codeValue = ""
    this.codeBusy = false
  }

  async runReveal(code) {
    const result = await useApi("/api/servers/" + this.serverId + "/key/reveal", { method: "POST", body: code ? { code: code } : {} })

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    if result.ok {
      this.deployFp = result.data.fingerprint or ""
      this.hostFp = result.data.host_fingerprint or ""
      this.revealed = true
      window.clearTimeout(this.revealTimer)
      this.revealTimer = window.setTimeout(() => this.hideKey(), 60000)
      return "done"
    }

    this.lastError = this.firstError(result, "Couldn't load the fingerprints.")
    return this.needsCode(result) ? "code" : "failed"
  }

  async reveal() {
    if this.working is not "" {
      return null
    }

    this.setWorking("reveal")
    const outcome = await this.runReveal("")

    if outcome is "code" {
      this.askCode("reveal", "Confirm to view the key fingerprints")
    } else if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  async runRotate(code) {
    const result = await useApi("/api/servers/" + this.serverId + "/key/rotate", { method: "POST", body: code ? { code: code } : {} })

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    if result.ok {
      this.hideKey()
      await this.loadSettings()
      if result.data.warning {
        this.say("Key replaced. " + result.data.warning, true)
      } else {
        this.say("Key replaced. The old key was removed from the server.", false)
      }
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't replace the key."
    return this.needsCode(result) ? "code" : "failed"
  }

  rotate() {
    if this.working is not "" {
      return null
    }
    this.askConfirm(
      "rotate",
      "",
      "Replace the deploy key?",
      "A new key is installed and tested before the old one is removed, so the deployer can't lock itself out.",
      "Replace key",
      "ok"
    )
  }

  async doRotate() {
    this.setWorking("rotate")
    const outcome = await this.runRotate("")

    if outcome is "code" {
      this.askCode("rotate", "Confirm to replace the SSH key")
    } else if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  async runPinKey(code, replace) {
    const body = Object.assign({}, replace ? { replace: true } : {}, code ? { code: code } : {})

    const result = await useApi("/api/servers/" + this.serverId + "/host-key/pin", { method: "POST", body: body })

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    if result.ok {
      this.hideKey()
      await this.loadSettings()
      if replace {
        this.say("New host key trusted. Press Test connection to check it.", false)
      } else {
        this.say("Host key pinned. The deployer now refuses any other key for this server.", false)
      }
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't read the host key."
    return this.needsCode(result) ? "code" : "failed"
  }

  async pinHostKey() {
    if this.working is not "" {
      return null
    }

    this.setWorking("pinkey")
    const outcome = await this.runPinKey("", false)

    if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  trustNewKey() {
    if this.working is not "" {
      return null
    }
    this.askConfirm(
      "trustkey",
      "",
      "Trust a new host key?",
      "Only do this if you know why the server's key changed, for example after a reinstall or rebuild. If you didn't expect a change, someone may be intercepting the connection.",
      "Trust new key",
      "warn"
    )
  }

  async doTrustKey() {
    this.setWorking("trustkey")
    const outcome = await this.runPinKey("", true)

    if outcome is "code" {
      this.askCode("hostkey", "Confirm to trust a new host key")
    } else if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  async runReboot(code) {
    const result = await useApi("/api/servers/" + this.serverId + "/reboot", { method: "POST", body: code ? { code: code } : {} })

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    if result.ok {
      this.say(result.data.message + " Press Test connection in a minute or two.", false)
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't schedule the reboot."
    return this.needsCode(result) ? "code" : "failed"
  }

  reboot() {
    if this.working is not "" {
      return null
    }
    this.askConfirm(
      "reboot",
      "",
      "Reboot this server?",
      "Every site on it will be offline for a minute or two.",
      "Reboot now",
      "warn"
    )
  }

  async doReboot() {
    this.setWorking("reboot")
    const outcome = await this.runReboot("")

    if outcome is "code" {
      this.askCode("reboot", "Confirm to reboot this server")
    } else if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  async runDelete(code) {
    const result = await useApi("/api/servers/" + this.serverId + "?code=" + encodeURIComponent(code), { method: "DELETE" })

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    if result.ok {
      window.location.href = "/servers"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't delete the server."
    return this.needsCode(result) ? "code" : "failed"
  }

  remove() {
    if this.working is not "" or not this.canDelete {
      return null
    }
    this.askConfirm(
      "delete",
      "",
      "Remove " + this.server.name + "?",
      "This only deletes its record and saved details in the deployer. The machine itself isn't touched.",
      "Delete server",
      "danger"
    )
  }

  async doRemove() {
    this.setWorking("delete")
    const outcome = await this.runDelete("")

    if outcome is "code" {
      this.askCode("delete", "Confirm to delete this server")
    } else if outcome is "failed" {
      this.say(this.lastError, true)
    }

    this.setWorking("")
  }

  async changeSystem(path, method, body, doneText) {
    const result = await useApi("/api/servers/" + this.serverId + path, { method: method, body: body })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.say(result.data.message or doneText, false)
      await this.loadSystem()
    } else {
      this.say(this.firstError(result, "That change didn't work."), true)
    }
  }

  async saveZone() {
    if this.working is not "" {
      return null
    }
    this.setWorking("zone")
    await this.changeSystem("/system/timezone", "PUT", { timezone: this.fZone }, "Timezone changed.")
    this.setWorking("")
  }

  useBrowserZone() {
    this.fZone = Intl.DateTimeFormat().resolvedOptions().timeZone
  }

  async saveHostname() {
    if this.working is not "" {
      return null
    }
    this.setWorking("hostname")
    await this.changeSystem("/system/hostname", "PUT", { hostname: this.fHostname }, "Hostname changed.")
    this.setWorking("")
  }

  async toggleUpdates() {
    if this.working is not "" or not this.sys {
      return null
    }
    this.setWorking("updates")
    await this.changeSystem("/system/updates", "PUT", { enabled: this.sys.auto_updates is not "on" }, "Updated.")
    this.setWorking("")
  }

  restart(id) {
    if this.working is not "" {
      return null
    }
    this.askConfirm(
      "restart",
      id,
      "Restart " + id + "?",
      "Sites that use it may drop connections for a moment.",
      "Restart",
      "warn"
    )
  }

  async doRestart(id) {
    this.setWorking("restart:" + id)
    await this.changeSystem("/services/" + id + "/restart", "POST", {}, "Restarted.")
    this.setWorking("")
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.serverId = id or ""

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      await this.loadSettings()
      this.loading = false

      if this.server {
        this.loadDeleteCheck()
        await this.loadSystem()
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="settings" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div class="animate-pulse space-y-4 sm:space-y-6">
        <div class="h-4 w-24 rounded bg-slate-200 dark:bg-slate-800"></div>
        <div class="h-40 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          <div class="h-20 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
          <div class="h-20 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
          <div class="h-20 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
          <div class="h-20 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
        </div>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 sm:gap-6">
          <div class="h-72 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
          <div class="h-72 rounded-2xl bg-slate-200 dark:bg-slate-800/70"></div>
        </div>
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if server}}

{{#if flash}}
      <div role="status" class="fixed top-20 left-4 right-4 sm:left-auto sm:right-6 sm:w-96 z-[60] flex items-start gap-3 rounded-xl border border-brand-500/30 bg-panel px-4 py-3 shadow-xl">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 shrink-0 mt-0.5 text-brand-500">
          <path d="M5 10.5l3.5 3.5L15 6.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="flex-1 min-w-0 text-slate-800 dark:text-slate-200 text-sm break-words">{{ flash }}</p>
        <button onclick="{{ clearFlash() }}" aria-label="Dismiss" class="shrink-0 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
          </svg>
        </button>
      </div>
{{/if}}
{{#if flashError}}
      <div role="alert" class="fixed top-20 left-4 right-4 sm:left-auto sm:right-6 sm:w-96 z-[60] flex items-start gap-3 rounded-xl border border-rose-500/30 bg-panel px-4 py-3 shadow-xl shadow-rose-500/10">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 shrink-0 mt-0.5 text-rose-500">
          <circle cx="10" cy="10" r="7.5" />
          <path d="M10 6.5v4M10 13.5h.01" stroke-linecap="round" />
        </svg>
        <p class="flex-1 min-w-0 text-slate-800 dark:text-slate-200 text-sm break-words whitespace-pre-wrap">{{ flashError }}</p>
        <button onclick="{{ clearFlash() }}" aria-label="Dismiss" class="shrink-0 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
            <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
          </svg>
        </button>
      </div>
{{/if}}

      <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
        <div class="min-w-0">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1 min-w-0 text-[13px] text-zinc-500 mb-2">
            <a href="/servers" class="shrink-0 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Servers</a>
            <IconChevronRight class="w-3.5 h-3.5 shrink-0 text-zinc-400 dark:text-zinc-600" />
            <a href="{{ '/servers/server-detail?id=' + serverId }}" class="min-w-0 truncate rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">{{ server.name }}</a>
          </nav>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">Settings</h1>
            <span class="{{ statusClass }}">
              <span class="relative flex w-1.5 h-1.5">
                <span class="{{ pingClass }}"></span>
                <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-current"></span>
              </span>
              {{ server.status }}
            </span>
          </div>
          <div class="mt-3 inline-flex max-w-full items-center gap-2 rounded-xl border border-line bg-panel pl-3 pr-1 py-1">
            <IconTerminal class="w-4 h-4 shrink-0 text-zinc-400" />
            <code class="min-w-0 truncate text-zinc-700 dark:text-zinc-300 text-[13px] font-mono select-all">{{ sshCmd }}</code>
            <button type="button" onclick="{{ copy(sshCmd, 'ssh') }}" title="Copy the SSH command" aria-label="Copy the SSH command" class="shrink-0 w-8 h-8 inline-flex items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-colors">
{{#if copied is "ssh"}}
              <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
{{#else}}
              <IconCopy class="w-4 h-4" />
{{/if}}
            </button>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <a href="{{ '/servers/server-terminal?id=' + serverId }}" class="inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconTerminal class="w-4 h-4" /> Terminal
          </a>
          <button type="button" disabled="{{ working is 'test' }}" onclick="{{ testConnection() }}" class="inline-flex items-center gap-2 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-4 shadow-sm transition-colors disabled:opacity-60">
            <IconSignal class="w-4 h-4" /> {{ working is "test" ? "Testing…" : "Test connection" }}
          </button>
        </div>
      </header>

      <nav aria-label="On this page" class="lg:sticky lg:top-16 z-20 -mx-4 sm:mx-0 px-4 sm:px-0 py-2.5 mb-4 sm:mb-6 bg-page overflow-x-auto no-scrollbar">
        <div class="inline-flex items-center gap-1 rounded-full border border-line bg-panel p-1 shadow-sm dark:shadow-none">
          <a href="#connection" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconLink class="hidden sm:block w-4 h-4" /> Connection</a>
          <a href="#security" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconShieldCheck class="hidden sm:block w-4 h-4" /> Keys</a>
          <a href="#system" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconCpuChip class="hidden sm:block w-4 h-4" /> System</a>
          <a href="#services" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconPower class="hidden sm:block w-4 h-4" /> Services</a>
          <a href="#danger" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-500/[0.06] transition-colors"><IconTrash class="hidden sm:block w-4 h-4" /> Delete</a>
        </div>
      </nav>

      <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 mb-4 sm:mb-6">
        <div class="min-w-0 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 shadow-sm dark:shadow-none">
          <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Last checked</p>
          <p class="mt-1.5 text-zinc-900 dark:text-zinc-50 text-[15px] font-semibold tracking-tight truncate">{{ checkedText }}</p>
          <p class="mt-0.5 text-zinc-500 text-xs truncate">Added {{ createdText }}</p>
        </div>
{{#if sys}}
        <div class="min-w-0 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 shadow-sm dark:shadow-none">
          <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Uptime</p>
          <p class="mt-1.5 text-zinc-900 dark:text-zinc-50 text-[15px] sm:text-base font-semibold tracking-tight">{{ uptimeText }}</p>
          <p class="mt-0.5 text-zinc-500 text-xs font-mono truncate">load {{ sys.load }}</p>
        </div>
        <div class="min-w-0 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 shadow-sm dark:shadow-none">
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Memory</p>
            <p class="text-zinc-900 dark:text-zinc-50 text-[15px] font-semibold tabular-nums">{{ memPct }}%</p>
          </div>
          <div class="mt-3 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden"><div class="h-full rounded-full transition-all duration-500 {{ memBar }}" style="{{ memStyle }}"></div></div>
          <p class="mt-2 text-zinc-500 text-xs font-mono truncate">{{ memText }}</p>
        </div>
        <div class="min-w-0 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 shadow-sm dark:shadow-none">
          <div class="flex items-baseline justify-between gap-2">
            <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Disk</p>
            <p class="text-zinc-900 dark:text-zinc-50 text-[15px] font-semibold tabular-nums">{{ diskPct }}%</p>
          </div>
          <div class="mt-3 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden"><div class="h-full rounded-full transition-all duration-500 {{ diskBar }}" style="{{ diskStyle }}"></div></div>
          <p class="mt-2 text-zinc-500 text-xs font-mono truncate">{{ diskText }}</p>
        </div>
{{/if}}
{{#if not sys}}
{{#if sysLoading}}
        <div class="h-[92px] rounded-2xl bg-zinc-200/70 dark:bg-zinc-800/60 animate-pulse"></div>
        <div class="h-[92px] rounded-2xl bg-zinc-200/70 dark:bg-zinc-800/60 animate-pulse"></div>
        <div class="h-[92px] rounded-2xl bg-zinc-200/70 dark:bg-zinc-800/60 animate-pulse"></div>
{{/if}}
{{/if}}
      </div>

{{#if hostKey}}
{{#if hostKey.changed}}
      <div role="alert" class="mb-4 sm:mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-2xl border border-rose-500/30 bg-rose-500/[0.06] p-4 sm:p-5">
        <div class="flex items-start gap-3 min-w-0">
          <IconExclamationTriangle class="w-5 h-5 shrink-0 mt-0.5 text-rose-500" />
          <div class="min-w-0">
            <p class="text-rose-600 dark:text-rose-400 text-sm font-semibold mb-0.5">This server's host key changed</p>
            <p class="text-zinc-600 dark:text-zinc-300 text-[13px] leading-relaxed">The deployer refused to connect because the server presented a different key than the one pinned. If you rebuilt or reinstalled the server, trust the new key. If you didn't, don't: someone may be intercepting the connection.</p>
          </div>
        </div>
        <button type="button" onclick="{{ trustNewKey() }}" class="shrink-0 h-9 text-sm font-medium text-rose-600 dark:text-rose-400 border border-rose-500/40 rounded-full px-4 hover:bg-rose-500/10 transition-colors">Review and trust new key</button>
      </div>
{{/if}}
{{/if}}

      <div class="space-y-6">

        <section id="connection" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="px-5 sm:px-6 pt-5 pb-4 border-b border-line">
            <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Connection</h2>
            <p class="text-zinc-500 text-[13px] mt-0.5">How the deployer reaches this server over SSH.</p>
          </div>

          <div class="px-5 sm:px-6 py-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-[1.2fr_1.4fr_0.6fr_1fr] gap-4">
              <div>
                <label for="f-name" class="block text-zinc-600 dark:text-zinc-400 text-[13px] font-medium mb-1.5">Name</label>
                <input id="f-name" type="text" value="{{ fName }}" oninput="{{ fName = $event.target.value }}" class="w-full rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm px-3.5 py-2.5 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
              </div>
              <div>
                <label for="f-host" class="block text-zinc-600 dark:text-zinc-400 text-[13px] font-medium mb-1.5">Host</label>
                <input id="f-host" type="text" autocapitalize="none" spellcheck="false" value="{{ fHost }}" oninput="{{ fHost = $event.target.value }}" class="w-full rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
              </div>
              <div>
                <label for="f-port" class="block text-zinc-600 dark:text-zinc-400 text-[13px] font-medium mb-1.5">Port</label>
                <input id="f-port" type="text" inputmode="numeric" value="{{ fPort }}" oninput="{{ fPort = $event.target.value }}" class="w-full rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
              </div>
              <div>
                <label for="f-user" class="block text-zinc-600 dark:text-zinc-400 text-[13px] font-medium mb-1.5">SSH user</label>
                <input id="f-user" type="text" autocapitalize="none" spellcheck="false" value="{{ fUser }}" oninput="{{ fUser = $event.target.value }}" class="w-full rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm font-mono px-3.5 py-2.5 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
              </div>
            </div>

{{#if server.last_error}}
            <div class="mt-4 flex gap-3 rounded-xl border border-rose-500/25 bg-rose-500/[0.05] px-4 py-3">
              <IconExclamationTriangle class="w-4 h-4 shrink-0 mt-0.5 text-rose-500" />
              <div class="min-w-0">
                <p class="text-rose-600 dark:text-rose-400 text-xs font-semibold mb-0.5">Last connection error</p>
                <p class="text-rose-600 dark:text-rose-400 text-[13px] font-mono break-words">{{ server.last_error }}</p>
              </div>
            </div>
{{/if}}
          </div>

{{#if provision}}
          <dl class="border-t border-line divide-y divide-line">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
              <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Provider</dt>
              <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm capitalize">{{ provision.provider }}</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
              <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Region and plan</dt>
              <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ provision.region }} / {{ provision.plan }}</dd>
            </div>
          </dl>
{{/if}}

          <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 py-3.5 border-t border-line bg-sunken">
            <p class="text-zinc-500 text-xs">After changing the connection, test it to make sure the deployer can still log in.</p>
            <div class="flex items-center gap-2 shrink-0">
              <button type="button" onclick="{{ testConnection() }}" class="flex-1 sm:flex-none h-10 sm:h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">{{ working is "test" ? "Testing…" : "Test" }}</button>
              <button type="button" onclick="{{ saveGeneral() }}" class="flex-1 sm:flex-none h-10 sm:h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-5 shadow-sm transition-colors">{{ working is "general" ? "Saving…" : "Save changes" }}</button>
            </div>
          </div>
        </section>

        <div id="security" class="scroll-mt-24 lg:scroll-mt-32 grid grid-cols-1 xl:grid-cols-2 gap-6 items-start">

          <section class="min-w-0 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex items-start justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <div class="min-w-0">
                <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Deploy key</h2>
                <p class="text-zinc-500 text-[13px] mt-0.5">The key the deployer logs in with. Stored encrypted, never shown.</p>
              </div>
              <span class="shrink-0 w-9 h-9 rounded-xl border border-line bg-sunken flex items-center justify-center text-zinc-500"><IconKey class="w-[18px] h-[18px]" /></span>
            </div>

            <div class="px-5 sm:px-6 py-5">
              <div class="rounded-xl border border-line bg-sunken p-3.5">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <span class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">SHA256 fingerprint</span>
{{#if key.readable}}
                  <div class="shrink-0 flex items-center gap-1">
{{#if revealed}}
                    <button type="button" onclick="{{ copy(deployFp, 'fp') }}" title="Copy the fingerprint" aria-label="Copy the fingerprint" class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">
{{#if copied is "fp"}}
                      <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
{{#else}}
                      <IconCopy class="w-4 h-4" />
{{/if}}
                    </button>
                    <button type="button" onclick="{{ hideKey() }}" class="h-8 rounded-lg px-2.5 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">Hide</button>
{{/if}}
{{#if not revealed}}
                    <button type="button" onclick="{{ reveal() }}" class="inline-flex items-center gap-1.5 h-8 rounded-lg px-2.5 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors"><IconEye class="w-3.5 h-3.5" /> {{ working is "reveal" ? "Checking…" : "Reveal" }}</button>
{{/if}}
                  </div>
{{/if}}
                </div>
{{#if key.readable}}
                <p class="text-zinc-900 dark:text-zinc-100 text-[13px] font-mono break-all leading-relaxed select-all">{{ revealed ? deployFp : "SHA256:••••••••••••••••••••••••••••••••••••" }}</p>
{{/if}}
{{#if not key.readable}}
                <p class="text-amber-700 dark:text-amber-400 text-sm">The stored key couldn't be read. Replace it.</p>
{{/if}}
              </div>

              <div class="flex items-center justify-between gap-3 mt-4 text-[13px]">
                <span class="text-zinc-500">Last replaced</span>
                <span class="text-zinc-900 dark:text-zinc-100 text-right">{{ keyDate }}</span>
              </div>

              <p class="text-zinc-500 text-xs mt-4 leading-relaxed">Rotating installs a new key, checks that it can log in, saves it, and only then removes the old one, so the deployer can't lock itself out. Fingerprints hide again after a minute.</p>

{{#if showKeyForm}}
              <div class="mt-5 pt-5 border-t border-line">
                <label for="f-key" class="block text-zinc-600 dark:text-zinc-400 text-[13px] font-medium mb-1.5">Private key (no passphrase)</label>
                <textarea id="f-key" rows="6" spellcheck="false" autocapitalize="off" value="{{ fKey }}" oninput="{{ fKey = $event.target.value }}" placeholder="-----BEGIN OPENSSH PRIVATE KEY-----" class="w-full rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-xs font-mono px-3.5 py-2.5 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow"></textarea>
                <p class="text-zinc-500 text-xs mt-2">For servers you added yourself. The matching public key must already be on the server.</p>
                <button type="button" onclick="{{ savePastedKey() }}" class="mt-3 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-4 shadow-sm transition-colors">{{ working is "pastekey" ? "Saving…" : "Save key" }}</button>
              </div>
{{/if}}
            </div>

            <div class="flex flex-wrap items-center justify-end gap-2 px-5 sm:px-6 py-3.5 border-t border-line bg-sunken">
              <button type="button" onclick="{{ toggleKeyForm() }}" class="h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 rounded-full px-4 hover:bg-zinc-200/60 dark:hover:bg-white/[0.05] transition-colors">{{ showKeyForm ? "Cancel" : "Paste my own key" }}</button>
              <button type="button" onclick="{{ rotate() }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-4 shadow-sm transition-colors"><IconArrowPath class="w-4 h-4" /> {{ working is "rotate" ? "Replacing…" : "Rotate key" }}</button>
            </div>
          </section>

{{#if hostKey}}
          <section class="min-w-0 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex items-start justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Host key</h2>
{{#if hostKey.pinned}}
{{#if hostKey.changed}}
                  <span class="inline-flex items-center rounded-full bg-rose-500/10 px-2 py-0.5 text-[11px] font-semibold text-rose-600 dark:text-rose-400">Changed</span>
{{#else}}
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400"><IconCheck class="w-3 h-3" /> Pinned</span>
{{/if}}
{{#else}}
                  <span class="inline-flex items-center rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:text-amber-400">Not pinned</span>
{{/if}}
                </div>
                <p class="text-zinc-500 text-[13px] mt-0.5">Proves the deployer is talking to this server and not an impostor.</p>
              </div>
              <span class="shrink-0 w-9 h-9 rounded-xl border border-line bg-sunken flex items-center justify-center text-zinc-500"><IconShieldCheck class="w-[18px] h-[18px]" /></span>
            </div>

            <div class="px-5 sm:px-6 py-5">
{{#if hostKey.pinned}}
              <div class="rounded-xl border border-line bg-sunken p-3.5">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <span class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Fingerprint <span class="normal-case tracking-normal font-mono text-zinc-400">{{ hostKey.type }}</span></span>
                  <div class="shrink-0 flex items-center gap-1">
{{#if revealed}}
                    <button type="button" onclick="{{ copy(hostFp, 'hfp') }}" title="Copy the fingerprint" aria-label="Copy the fingerprint" class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">
{{#if copied is "hfp"}}
                      <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
{{#else}}
                      <IconCopy class="w-4 h-4" />
{{/if}}
                    </button>
                    <button type="button" onclick="{{ hideKey() }}" class="h-8 rounded-lg px-2.5 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">Hide</button>
{{/if}}
{{#if not revealed}}
                    <button type="button" onclick="{{ reveal() }}" class="inline-flex items-center gap-1.5 h-8 rounded-lg px-2.5 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors"><IconEye class="w-3.5 h-3.5" /> {{ working is "reveal" ? "Checking…" : "Reveal" }}</button>
{{/if}}
                  </div>
                </div>
                <p class="text-zinc-900 dark:text-zinc-100 text-[13px] font-mono break-all leading-relaxed select-all">{{ revealed ? hostFp : "SHA256:••••••••••••••••••••••••••••••••••••" }}</p>
              </div>
{{#if hostKeyDate}}
              <div class="flex items-center justify-between gap-3 mt-4 text-[13px]">
                <span class="text-zinc-500">Pinned on</span>
                <span class="text-zinc-900 dark:text-zinc-100 text-right">{{ hostKeyDate }}</span>
              </div>
{{/if}}
              <p class="text-zinc-500 text-xs mt-4 leading-relaxed">Every connection, including the terminal, is checked against this key and refused if it differs. Replacing it needs your two-factor code when two-factor is on.</p>
{{/if}}
{{#if not hostKey.pinned}}
              <p class="text-zinc-600 dark:text-zinc-300 text-sm leading-relaxed">No host key is pinned yet, so the deployer trusts whatever key the server shows on first contact. Pin it so every later connection fails if the key ever differs.</p>
              <p class="text-zinc-500 text-xs mt-3 leading-relaxed">The deployer connects once, reads the key from the same session that logs in, and saves it. Then reveal the fingerprint and compare it with your provider's console if you want to be sure.</p>
{{/if}}
            </div>

            <div class="flex flex-wrap items-center justify-end gap-2 px-5 sm:px-6 py-3.5 border-t border-line bg-sunken">
{{#if hostKey.pinned}}
              <button type="button" onclick="{{ trustNewKey() }}" class="h-9 text-sm font-medium text-amber-700 dark:text-amber-400 border border-amber-500/40 rounded-full px-4 hover:bg-amber-500/10 transition-colors">{{ working is "trustkey" ? "Reading key…" : "Trust new key" }}</button>
{{#else}}
              <button type="button" onclick="{{ pinHostKey() }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-4 shadow-sm transition-colors"><IconShieldCheck class="w-4 h-4" /> {{ working is "pinkey" ? "Reading key…" : "Pin host key" }}</button>
{{/if}}
            </div>
          </section>
{{/if}}
        </div>

        <section id="system" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="flex items-center justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
            <div class="min-w-0">
              <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">System</h2>
              <p class="text-zinc-500 text-[13px] mt-0.5">Read live over SSH. Changes here apply to the machine itself.</p>
            </div>
            <button type="button" disabled="{{ sysLoading }}" onclick="{{ loadSystem() }}" class="shrink-0 inline-flex items-center gap-1.5 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors disabled:opacity-60">
              <IconRefresh class="{{ sysLoading ? 'w-4 h-4 animate-spin' : 'w-4 h-4' }}" /> <span class="hidden sm:inline">Refresh</span>
            </button>
          </div>

{{#if sysError}}
          <div role="alert" class="mx-5 sm:mx-6 my-5 rounded-xl border border-rose-500/30 bg-rose-500/[0.05] px-4 py-3">
            <p class="text-rose-600 dark:text-rose-400 text-sm break-words">{{ sysError }}</p>
          </div>
{{/if}}

{{#if sysLoading}}
{{#if not sys}}
          <div class="px-5 sm:px-6 py-5 animate-pulse space-y-3">
            <div class="h-4 w-2/3 rounded bg-zinc-200 dark:bg-zinc-800"></div>
            <div class="h-4 w-1/2 rounded bg-zinc-200 dark:bg-zinc-800"></div>
            <div class="h-4 w-3/5 rounded bg-zinc-200 dark:bg-zinc-800"></div>
          </div>
{{/if}}
{{/if}}

{{#if sys}}
          <div class="grid grid-cols-1 lg:grid-cols-2 lg:divide-x divide-line">
            <dl class="divide-y divide-line">
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
                <dt class="sm:w-36 shrink-0 text-zinc-500 text-[13px]">Operating system</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm break-words">{{ sys.os }}</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
                <dt class="sm:w-36 shrink-0 text-zinc-500 text-[13px]">Kernel</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ sys.kernel }}</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
                <dt class="sm:w-36 shrink-0 text-zinc-500 text-[13px]">Uptime</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm">{{ uptimeText }}</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3">
                <dt class="sm:w-36 shrink-0 text-zinc-500 text-[13px]">Load (1, 5, 15 min)</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono">{{ sys.load }}</dd>
              </div>
            </dl>

            <div class="divide-y divide-line border-t lg:border-t-0 border-line">
              <div class="px-5 sm:px-6 py-4">
                <label for="f-hostname" class="block text-zinc-900 dark:text-zinc-100 text-sm font-medium">Hostname</label>
                <p class="text-zinc-500 text-xs mt-0.5 mb-2.5">The machine's own name, shown in the shell prompt.</p>
                <div class="flex gap-2">
                  <input id="f-hostname" type="text" autocapitalize="none" spellcheck="false" value="{{ fHostname }}" oninput="{{ fHostname = $event.target.value }}" class="flex-1 min-w-0 rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm font-mono px-3.5 py-2 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
                  <button type="button" onclick="{{ saveHostname() }}" class="shrink-0 h-10 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">{{ working is "hostname" ? "Saving…" : "Save" }}</button>
                </div>
              </div>

              <div class="px-5 sm:px-6 py-4">
                <label for="f-zone" class="block text-zinc-900 dark:text-zinc-100 text-sm font-medium">Timezone</label>
                <p class="text-zinc-500 text-xs mt-0.5 mb-2.5">Cron jobs run on this clock.</p>
                <div class="flex flex-wrap gap-2">
                  <input id="f-zone" type="text" autocapitalize="none" spellcheck="false" value="{{ fZone }}" oninput="{{ fZone = $event.target.value }}" placeholder="Africa/Nairobi" class="flex-1 min-w-[10rem] rounded-xl border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm font-mono px-3.5 py-2 focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10 transition-shadow" />
                  <button type="button" onclick="{{ useBrowserZone() }}" class="shrink-0 h-10 text-sm font-medium text-zinc-600 dark:text-zinc-300 rounded-full px-3 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors">Use mine</button>
                  <button type="button" onclick="{{ saveZone() }}" class="shrink-0 h-10 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">{{ working is "zone" ? "Saving…" : "Save" }}</button>
                </div>
              </div>

              <div class="flex items-center justify-between gap-4 px-5 sm:px-6 py-4">
                <div class="min-w-0">
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">Automatic security updates</p>
{{#if sys.auto_updates is "on"}}
                  <p class="text-zinc-500 text-xs mt-0.5">On. The server installs security patches by itself.</p>
{{/if}}
{{#if sys.auto_updates is "off"}}
                  <p class="text-zinc-500 text-xs mt-0.5">Off. Turning on installs unattended-upgrades if it's missing.</p>
{{/if}}
{{#if sys.auto_updates is "unavailable"}}
                  <p class="text-zinc-500 text-xs mt-0.5">Only available on Debian and Ubuntu servers.</p>
{{/if}}
                </div>
{{#if sys.auto_updates is not "unavailable"}}
                <button type="button" role="switch" aria-checked="{{ sys.auto_updates is 'on' ? 'true' : 'false' }}" aria-label="Automatic security updates" disabled="{{ working is 'updates' }}" onclick="{{ toggleUpdates() }}" class="{{ sys.auto_updates is 'on' ? 'relative shrink-0 w-11 h-6 rounded-full bg-brand-500 transition-colors disabled:opacity-60' : 'relative shrink-0 w-11 h-6 rounded-full bg-zinc-300 dark:bg-zinc-700 transition-colors disabled:opacity-60' }}">
                  <span class="{{ sys.auto_updates is 'on' ? 'absolute top-0.5 left-[22px] w-5 h-5 rounded-full bg-white shadow transition-all' : 'absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow transition-all' }}"></span>
                </button>
{{/if}}
              </div>
            </div>
          </div>

{{#if sys.reboot_required}}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 py-3.5 border-t border-amber-500/25 bg-amber-500/[0.06]">
            <p class="text-amber-800 dark:text-amber-300 text-sm">Updates were installed that need a reboot to finish.</p>
            <a href="#services" class="shrink-0 text-sm font-medium text-amber-800 dark:text-amber-300 hover:underline">Go to reboot</a>
          </div>
{{/if}}
{{/if}}
        </section>

        <section id="services" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="px-5 sm:px-6 pt-5 pb-4 border-b border-line">
            <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Services and power</h2>
            <p class="text-zinc-500 text-[13px] mt-0.5">Restart a service, or reboot the whole machine.</p>
          </div>

{{#if services.length is 0}}
          <p class="px-5 sm:px-6 py-5 text-zinc-500 text-sm">{{ sysLoading ? "Reading from the server…" : "No known services were found on this server." }}</p>
{{/if}}

{{#if services.length is not 0}}
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 -mr-px -mb-px">
{{#each s in services}}
            <div class="flex items-center justify-between gap-3 border-r border-b border-line px-5 sm:px-6 py-3.5">
              <div class="min-w-0 flex items-center gap-3">
                <span class="w-2 h-2 shrink-0 rounded-full {{ s.dot }}"></span>
                <div class="min-w-0">
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ s.label }}</p>
                  <p class="text-zinc-500 text-xs font-mono">{{ s.state }}</p>
                </div>
              </div>
              <button type="button" onclick="{{ restart(s.id) }}" class="shrink-0 inline-flex items-center gap-1.5 h-8 text-xs font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong rounded-full px-3 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
                <IconArrowPath class="{{ s.busy ? 'w-3.5 h-3.5 animate-spin' : 'w-3.5 h-3.5' }}" /> {{ s.busy ? "Restarting…" : "Restart" }}
              </button>
            </div>
{{/each}}
          </div>
{{/if}}

          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 py-4 border-t border-line bg-sunken">
            <div class="flex items-start gap-3 min-w-0">
              <span class="w-9 h-9 shrink-0 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center"><IconPower class="w-[18px] h-[18px]" /></span>
              <div class="min-w-0">
                <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">Reboot server</p>
                <p class="text-zinc-500 text-xs mt-0.5">Every site on it is offline for a minute or two.</p>
              </div>
            </div>
            <button type="button" onclick="{{ reboot() }}" class="shrink-0 h-9 text-sm font-medium text-amber-700 dark:text-amber-400 border border-amber-500/40 rounded-full px-4 hover:bg-amber-500/10 transition-colors">{{ working is "reboot" ? "Scheduling…" : "Reboot" }}</button>
          </div>
        </section>

        <section id="danger" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-rose-500/30 bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="px-5 sm:px-6 pt-5 pb-4 border-b border-rose-500/20">
            <h2 class="text-rose-600 dark:text-rose-400 text-[15px] font-semibold">Delete server</h2>
            <p class="text-zinc-500 text-[13px] mt-0.5">Removes the server and its saved details from the deployer. The machine itself isn't touched.</p>
          </div>

{{#if canDelete}}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 py-4">
            <p class="text-zinc-500 text-sm">This can't be undone.</p>
            <button type="button" onclick="{{ remove() }}" class="shrink-0 inline-flex items-center justify-center gap-1.5 h-9 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-500 rounded-full px-4 transition-colors"><IconTrash class="w-4 h-4" /> {{ working is "delete" ? "Deleting…" : "Delete server" }}</button>
          </div>
{{/if}}

{{#if not canDelete}}
          <div class="px-5 sm:px-6 py-4">
            <p class="text-zinc-600 dark:text-zinc-300 text-sm mb-3">This server can't be deleted yet:</p>
            <div class="space-y-2">
{{#each b in blockers}}
              <div class="rounded-xl border border-line bg-sunken px-4 py-3">
                <p class="text-zinc-900 dark:text-zinc-100 text-sm">{{ b.message }}</p>
{{#each site in (b.sites or [])}}
                <a href="{{ '/servers/site-detail?id=' + site.id }}" class="inline-block mt-2 mr-3 text-brand-700 dark:text-brand-400 text-[13px] font-mono hover:underline">{{ site.domain }}</a>
{{/each}}
              </div>
{{/each}}
            </div>
          </div>
{{/if}}
        </section>

      </div>

{{#if confirmOpen}}
      <div class="fixed inset-0 z-[70] flex items-end sm:items-center justify-center p-0 sm:p-6">
        <div onclick="{{ closeConfirm() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

        <div role="alertdialog" aria-modal="true" aria-label="{{ confirmTitle }}" class="relative w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-11 h-11 shrink-0 rounded-xl ring-1 {{ confirmIconCls }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5">
                <path d="M12 4l9 16H3L12 4z" stroke-linejoin="round" />
                <path d="M12 10v4M12 17h.01" stroke-linecap="round" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="text-slate-900 dark:text-slate-100 font-semibold leading-tight mb-1.5 break-words">{{ confirmTitle }}</h3>
              <p class="text-slate-500 text-sm leading-relaxed break-words">{{ confirmText }}</p>
            </div>
          </div>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-6">
            <button onclick="{{ closeConfirm() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
            <button onclick="{{ acceptConfirm() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm font-semibold rounded-full px-5 py-2.5 shadow-sm transition-all {{ confirmBtnCls }}">{{ confirmLabel }}</button>
          </div>
        </div>
      </div>
{{/if}}

{{#if codeOpen}}
      <div class="fixed inset-0 z-[70] flex items-end sm:items-center justify-center p-0 sm:p-6">
        <div onclick="{{ closeCode() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

        <div role="dialog" aria-modal="true" aria-label="Two-factor code" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
          <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 dark:text-brand-400 ring-1 ring-brand-500/20 mb-3">
            <IconKey class="w-5 h-5" />
          </span>
          <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">{{ codeTitle }}</h3>
          <p class="text-slate-500 text-sm mb-4">Enter the code from your authenticator app or the SMS we sent you.</p>

          <input
            id="step-up-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            autocapitalize="none"
            spellcheck="false"
            maxlength="12"
            value="{{ codeValue }}"
            oninput="{{ codeValue = $event.target.value }}"
            placeholder="123456"
            class="w-full rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-base tracking-widest font-mono px-4 py-3 transition-shadow focus:outline-none focus:border-brand-500/60 focus:ring-4 focus:ring-brand-500/10"
          />

{{#if codeError}}
          <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ codeError }}</p>
{{/if}}

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
            <button onclick="{{ closeCode() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
{{#if codeBusy}}
            <button disabled class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 opacity-50">Checking…</button>
{{/if}}
{{#if not codeBusy}}
            <button onclick="{{ submitCode() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">Confirm</button>
{{/if}}
          </div>
        </div>
      </div>
{{/if}}
{{/if}}

    </div>
    </div>
  </div>