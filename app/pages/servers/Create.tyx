page CreateServer

import { IconArrowLeft } from "tylix-icons"

title "Create server"

needs
  Auth

uses
  Providers

state
  checkedAuth: false
  custom: false
  providerCards: []
  providerId: 0
  providerKind: "linode"
  region: ""
  plan: ""
  regionLabel: ""
  planLabel: ""
  regionOpen: false
  planOpen: false
  image: ""
  tpl: "tylix"
  name: ""
  host: ""
  port: "22"
  sshUser: "root"
  sshKey: ""
  regions: []
  images: []
  plans: []
  shownPlans: []
  catalogError: ""
  saving: false
  error: ""
  providerError: ""
  regionError: ""
  planError: ""
  imageError: ""
  nameError: ""
  tplError: ""
  hostError: ""
  portError: ""
  userError: ""
  keyError: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  clearErrors() {
    this.error = ""
    this.providerError = ""
    this.regionError = ""
    this.planError = ""
    this.imageError = ""
    this.nameError = ""
    this.tplError = ""
    this.hostError = ""
    this.portError = ""
    this.userError = ""
    this.keyError = ""
  }

  // Adds the display name for a connection's provider.
  decorateProvider(p) {
    let kindName = "Linode (Akamai)"
    if p.kind is "hetzner" {
      kindName = "Hetzner Cloud"
    }
    if p.kind is "digitalocean" {
      kindName = "DigitalOcean"
    }
    // VULTR
    if p.kind is "vultr" {
      kindName = "Vultr"
    }
    // AWS
    if p.kind is "aws" {
      kindName = "Amazon Web Services"
    }
    return { id: p.id, label: p.label, kind: p.kind, kindName: kindName }
  }

  // Forgets everything that came from the previously chosen provider.
  resetCatalog() {
    this.region = ""
    this.regionLabel = ""
    this.regionOpen = false
    this.plan = ""
    this.planLabel = ""
    this.planOpen = false
    this.image = ""
    this.regions = []
    this.images = []
    this.plans = []
    this.shownPlans = []
    this.catalogError = ""
  }

  // The price line of a plan. A price of 0 means the provider's catalog has no
  // prices (AWS), so say so instead of showing "USD 0".
  decoratePlan(p) {
    let priceText = "pricing in the provider console"
    if p.monthly > 0 {
      priceText = p.currency + " " + p.monthly + " per month"
    }
    return Object.assign({}, p, { priceText: priceText })
  }

  applyPlanFilter() {
    let list = this.plans
    if this.tpl is "tylix" {
      list = this.plans.filter((p) => p.memory_mb > 4095)
    }
    this.shownPlans = list.map((p) => this.decoratePlan(p))
  }

  async loadCatalog() {
    this.catalogError = ""

    if this.providerId is 0 {
      return null
    }

    let url = "/api/catalog/" + this.providerKind

    // Linode's catalog is public. Every other provider needs the connection's credentials.
    if this.providerKind is "linode" {
      if this.region is not "" {
        url = url + "?region=" + this.region
      }
    } else {
      url = url + "?provider=" + this.providerId
      if this.region is not "" {
        url = url + "&region=" + this.region
      }
    }

    const result = await useApi(url)

    if result.ok {
      if this.regions.length is 0 {
        this.regions = result.data.regions
      }
      if this.images.length is 0 {
        this.images = result.data.images
      }
      this.plans = result.data.plans
      if this.image is "" and this.images.length > 0 {
        this.image = this.images[0].id
      }
      this.applyPlanFilter()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.catalogError = result.data?.error or "Couldn't load regions and plans from the provider. Try again."
    }
  }

  async pickProvider(id, kind) {
    if this.providerId is id {
      return null
    }

    this.custom = false
    this.providerId = id
    this.providerKind = kind
    this.providerError = ""
    this.resetCatalog()

    await this.loadCatalog()
  }

  pickCustom() {
    if this.custom {
      return null
    }

    this.clearErrors()
    this.custom = true
    this.providerId = 0
    this.providerKind = "linode"
    this.resetCatalog()
  }

  toggleRegion() {
    this.planOpen = false
    if this.regionOpen {
      this.regionOpen = false
    } else {
      this.regionOpen = true
    }
  }

  togglePlan() {
    this.regionOpen = false
    if this.planOpen {
      this.planOpen = false
    } else {
      this.planOpen = true
    }
  }

  async pickRegion(id, label) {
    this.region = id
    this.regionLabel = label
    this.regionOpen = false
    this.plan = ""
    this.planLabel = ""
    await this.loadCatalog()
  }

  pickPlan(id, label) {
    this.plan = id
    this.planLabel = label
    this.planOpen = false
  }

  pickImage(id) {
    this.image = id
  }

  pickTpl(t) {
    this.tpl = t
    this.plan = ""
    this.planLabel = ""
    this.planOpen = false
    this.applyPlanFilter()
  }

  async submit() {
    if this.saving {
      return null
    }

    this.clearErrors()
    this.saving = true

    const payload = {
      provider_id: this.providerId,
      name: this.name,
      region: this.region,
      plan: this.plan,
      image: this.image,
      "template": this.tpl
    }

    const result = await useApi("/api/provisions", { method: "POST", body: payload })

    if result.ok {
      window.location.href = "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.providerError = this.firstError(errors, "provider_id")
      this.regionError = this.firstError(errors, "region")
      this.planError = this.firstError(errors, "plan")
      this.imageError = this.firstError(errors, "image")
      this.nameError = this.firstError(errors, "name")
      this.tplError = this.firstError(errors, "template")
      this.error = result.data?.error or result.error or ""
      if this.error is "" and not errors {
        this.error = "Couldn't create the server. Check the form and try again."
      }
      this.saving = false
    }
  }

  // A machine that already exists somewhere else: saved through the normal Servers API.
  async submitCustom() {
    if this.saving {
      return null
    }

    this.clearErrors()
    this.saving = true

    const payload = {
      name: this.name,
      host: this.host,
      port: this.port,
      ssh_user: this.sshUser,
      ssh_key: this.sshKey
    }

    const result = await useApi("/api/servers", { method: "POST", body: payload })

    if result.ok {
      window.location.href = "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      this.nameError = this.firstError(errors, "name")
      this.hostError = this.firstError(errors, "host")
      this.portError = this.firstError(errors, "port")
      this.userError = this.firstError(errors, "ssh_user")
      this.keyError = this.firstError(errors, "ssh_key")
      this.error = result.data?.error or result.error or ""
      if this.error is "" and not errors {
        this.error = "Couldn't add the server. Check the form and try again."
      }
      this.saving = false
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Providers.load()
    this.providerCards = Providers.data.map((p) => this.decorateProvider(p))

    const params = new URLSearchParams(window.location.search)
    const wanted = Number(params.get("provider"))
    const match = Providers.data.find((p) => p.id is wanted)

    if match {
      this.providerId = match.id
      this.providerKind = match.kind or "linode"
    } else if Providers.data.length is 1 {
      this.providerId = Providers.data[0].id
      this.providerKind = Providers.data[0].kind or "linode"
    }

    await this.loadCatalog()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <div class="min-w-0">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 py-10">

      <a href="/servers" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 mb-1">Create server</h1>
      <p class="text-slate-500 text-sm mb-8">Provision a new machine at your cloud provider, or add one you already have.</p>

{{#if catalogError}}
      <p role="alert" class="text-rose-500 text-sm mb-6">{{ catalogError }}</p>
{{/if}}

      <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-3">1. Where is the server?</h2>
{{#if Providers.data.length is 0}}
      <div class="rounded-xl border border-dashed border-slate-400 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 mb-3 text-sm text-slate-500">
        No provider connected yet. <a href="/providers" class="text-emerald-700 dark:text-emerald-500 hover:underline">Connect a provider</a> to create a machine from here, or add a server you already have below.
      </div>
{{/if}}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-2">
{{#each p in providerCards}}
{{#if providerId is p.id}}
        <button onclick="{{ pickProvider(p.id, p.kind) }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">{{ p.label }}</span>
          <span class="block text-xs text-slate-500">{{ p.kindName }}</span>
        </button>
{{/if}}
{{#if providerId is not p.id}}
        <button onclick="{{ pickProvider(p.id, p.kind) }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">{{ p.label }}</span>
          <span class="block text-xs text-slate-500">{{ p.kindName }}</span>
        </button>
{{/if}}
{{/each}}
{{#if custom}}
        <button onclick="{{ pickCustom() }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">Custom server</span>
          <span class="block text-xs text-slate-500">Already created somewhere else. Add it with its SSH details.</span>
        </button>
{{/if}}
{{#if not custom}}
        <button onclick="{{ pickCustom() }}" class="text-left rounded-xl border border-dashed px-4 py-3 text-sm transition-colors border-slate-400 dark:border-slate-700 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">Custom server</span>
          <span class="block text-xs text-slate-500">Already created somewhere else. Add it with its SSH details.</span>
        </button>
{{/if}}
      </div>
{{#if providerError}}
      <p class="text-rose-500 text-xs mb-2">{{ providerError }}</p>
{{/if}}

{{#if custom}}
      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">2. Connection details</h2>

      <label for="custom-name" class="block text-slate-500 text-xs mb-1.5">Name</label>
      <input
        id="custom-name"
        type="text"
        value="{{ name }}"
        oninput="{{ name = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="e.g. production-web"
      />
{{#if nameError}}
      <p class="text-rose-500 text-xs mb-2">{{ nameError }}</p>
{{/if}}

      <div class="grid grid-cols-1 sm:grid-cols-[1fr_120px] gap-3 mt-4">
        <div>
          <label for="custom-host" class="block text-slate-500 text-xs mb-1.5">Host or IP address</label>
          <input
            id="custom-host"
            type="text"
            value="{{ host }}"
            oninput="{{ host = $event.target.value }}"
            class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
            placeholder="203.0.113.10"
          />
{{#if hostError}}
          <p class="text-rose-500 text-xs mb-2">{{ hostError }}</p>
{{/if}}
        </div>
        <div>
          <label for="custom-port" class="block text-slate-500 text-xs mb-1.5">SSH port</label>
          <input
            id="custom-port"
            type="text"
            inputmode="numeric"
            value="{{ port }}"
            oninput="{{ port = $event.target.value }}"
            class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
          />
{{#if portError}}
          <p class="text-rose-500 text-xs mb-2">{{ portError }}</p>
{{/if}}
        </div>
      </div>

      <label for="custom-user" class="block text-slate-500 text-xs mb-1.5 mt-4">SSH user</label>
      <input
        id="custom-user"
        type="text"
        value="{{ sshUser }}"
        oninput="{{ sshUser = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="root"
      />
{{#if userError}}
      <p class="text-rose-500 text-xs mb-2">{{ userError }}</p>
{{/if}}

      <label for="custom-key" class="block text-slate-500 text-xs mb-1.5 mt-4">SSH private key</label>
      <textarea
        id="custom-key"
        rows="8"
        value="{{ sshKey }}"
        oninput="{{ sshKey = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-xs font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
      ></textarea>
      <p class="text-slate-500 text-xs mb-2">Use a dedicated key without a passphrase. It is stored encrypted and never shown again.</p>
{{#if keyError}}
      <p class="text-rose-500 text-xs mb-2">{{ keyError }}</p>
{{/if}}
{{/if}}

{{#if not custom}}
      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">2. Region</h2>
      <div class="relative mb-1">
        <button onclick="{{ toggleRegion() }}" class="w-full flex items-center justify-between text-left rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 transition-colors">
{{#if regionLabel}}
          <span>{{ regionLabel }}</span>
{{/if}}
{{#if not regionLabel}}
          <span class="text-slate-500">Select a region</span>
{{/if}}
          <span class="text-slate-500 text-xs">&#9662;</span>
        </button>
{{#if regionOpen}}
        <div class="absolute z-20 mt-1 w-full max-h-64 overflow-y-auto rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-900 shadow-lg">
{{#each r in regions}}
          <button onclick="{{ pickRegion(r.id, r.label) }}" class="block w-full text-left px-3 py-2 text-sm text-slate-800 dark:text-slate-200 hover:bg-emerald-500/10 transition-colors">
            {{ r.label }} <span class="text-xs text-slate-500 font-mono">{{ r.id }}</span>
          </button>
{{/each}}
        </div>
{{/if}}
      </div>
{{#if regionError}}
      <p class="text-rose-500 text-xs mb-2">{{ regionError }}</p>
{{/if}}

      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">3. Template</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-2">
{{#if tpl is "tylix"}}
        <button onclick="{{ pickTpl('tylix') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">Tylix</span>
          <span class="block text-xs text-slate-500">Everything Standard has, plus PostgreSQL, MongoDB, Node.js 22 LTS, git and build tools. Needs 4 GB RAM or more.</span>
        </button>
{{/if}}
{{#if tpl is not "tylix"}}
        <button onclick="{{ pickTpl('tylix') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">Tylix</span>
          <span class="block text-xs text-slate-500">Everything Standard has, plus PostgreSQL, MongoDB, Node.js 22 LTS, git and build tools. Needs 4 GB RAM or more.</span>
        </button>
{{/if}}
{{#if tpl is "standard"}}
        <button onclick="{{ pickTpl('standard') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">Standard</span>
          <span class="block text-xs text-slate-500">nginx, MySQL 8.4, Redis, Supervisor, UFW, remote-monitor. No Node.js.</span>
        </button>
{{/if}}
{{#if tpl is not "standard"}}
        <button onclick="{{ pickTpl('standard') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">Standard</span>
          <span class="block text-xs text-slate-500">nginx, MySQL 8.4, Redis, Supervisor, UFW, remote-monitor. No Node.js.</span>
        </button>
{{/if}}
{{#if tpl is "bare"}}
        <button onclick="{{ pickTpl('bare') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">Bare</span>
          <span class="block text-xs text-slate-500">Just the OS and SSH access. Nothing installed. Add packages later from the server's Packages page.</span>
        </button>
{{/if}}
{{#if tpl is not "bare"}}
        <button onclick="{{ pickTpl('bare') }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">Bare</span>
          <span class="block text-xs text-slate-500">Just the OS and SSH access. Nothing installed. Add packages later from the server's Packages page.</span>
        </button>
{{/if}}
      </div>
{{#if tplError}}
      <p class="text-rose-500 text-xs mb-2">{{ tplError }}</p>
{{/if}}

      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">4. Plan</h2>
{{#if not region}}
      <p class="text-slate-500 text-sm mb-2">Choose a region first. Prices depend on the region.</p>
{{/if}}
{{#if region}}
      <div class="relative mb-1">
        <button onclick="{{ togglePlan() }}" class="w-full flex items-center justify-between text-left rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 transition-colors">
{{#if planLabel}}
          <span>{{ planLabel }}</span>
{{/if}}
{{#if not planLabel}}
          <span class="text-slate-500">Select a plan</span>
{{/if}}
          <span class="text-slate-500 text-xs">&#9662;</span>
        </button>
{{#if planOpen}}
        <div class="absolute z-20 mt-1 w-full max-h-72 overflow-y-auto rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-900 shadow-lg">
{{#each p in shownPlans}}
          <button onclick="{{ pickPlan(p.id, p.label) }}" class="block w-full text-left px-3 py-2 text-sm text-slate-800 dark:text-slate-200 hover:bg-emerald-500/10 transition-colors">
            <span class="block font-medium">{{ p.label }}</span>
            <span class="block text-xs text-slate-500">{{ p.memory_mb }} MB / {{ p.vcpus }} vCPU / {{ p.disk_gb }} GB / {{ p.priceText }}</span>
          </button>
{{/each}}
        </div>
{{/if}}
      </div>
{{/if}}
{{#if planError}}
      <p class="text-rose-500 text-xs mb-2">{{ planError }}</p>
{{/if}}

      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">5. Operating system</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-2">
{{#each i in images}}
{{#if image is i.id}}
        <button onclick="{{ pickImage(i.id) }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
          <span class="block font-medium">{{ i.label }}</span>
        </button>
{{/if}}
{{#if image is not i.id}}
        <button onclick="{{ pickImage(i.id) }}" class="text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
          <span class="block font-medium">{{ i.label }}</span>
        </button>
{{/if}}
{{/each}}
      </div>
{{#if imageError}}
      <p class="text-rose-500 text-xs mb-2">{{ imageError }}</p>
{{/if}}

      <h2 class="text-slate-800 dark:text-slate-200 font-medium mt-8 mb-3">6. Server name</h2>
      <label for="server-name" class="block text-slate-500 text-xs mb-1.5">Lowercase letters, numbers and hyphens</label>
      <input
        id="server-name"
        type="text"
        value="{{ name }}"
        oninput="{{ name = $event.target.value }}"
        class="w-full mb-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-colors"
        placeholder="e.g. web-1"
      />
{{#if nameError}}
      <p class="text-rose-500 text-xs mb-2">{{ nameError }}</p>
{{/if}}
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mt-6">{{ error }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3 mt-8">
        <a href="/servers" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">Cancel</a>
{{#if custom}}
{{#if saving}}
        <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 opacity-50">Adding…</button>
{{/if}}
{{#if not saving}}
        <button onclick="{{ submitCustom() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Add server</button>
{{/if}}
{{/if}}
{{#if not custom}}
{{#if saving}}
        <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 opacity-50">Creating…</button>
{{/if}}
{{#if not saving}}
        <button onclick="{{ submit() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Create server</button>
{{/if}}
{{/if}}
      </div>

    </div>
    </div>
  </div>
{{/if}}