page CreateServer

import { IconArrowLeft } from "tylix-icons"

title "Create server"

needs
  Auth

uses
  Providers
  Billing

background
  Billing

state
  checkedAuth: false
  custom: false
  providerCards: []
  providerId: 0
  providerKind: "linode"
  providerLabel: ""
  region: ""
  plan: ""
  regionLabel: ""
  planLabel: ""
  regionOpen: false
  planOpen: false
  image: ""
  tpl: "tylix"
  name: ""
  host: ""
  port: "22"
  sshUser: "root"
  sshKey: ""
  regions: []
  images: []
  plans: []
  shownPlans: []
  catalogError: ""
  saving: false
  error: ""
  providerError: ""
  regionError: ""
  planError: ""
  imageError: ""
  nameError: ""
  tplError: ""
  hostError: ""
  portError: ""
  userError: ""
  keyError: ""
  twoFactorOn: false
  tfTotp: false
  tfSms: false
  smsHint: ""
  codeOpen: false
  code: ""
  codeError: ""
  smsSending: false
  smsNotice: ""

action
  firstError(errors, field) {
    if errors and errors[field] and errors[field].length > 0 {
      return errors[field][0]
    }
    return ""
  }

  clearErrors() {
    this.error = ""
    this.providerError = ""
    this.regionError = ""
    this.planError = ""
    this.imageError = ""
    this.nameError = ""
    this.tplError = ""
    this.hostError = ""
    this.portError = ""
    this.userError = ""
    this.keyError = ""
    this.codeError = ""
  }

  // Name of the chosen connection, shown in the summary card.
  syncProviderLabel() {
    if this.custom {
      this.providerLabel = "Custom server"
      return null
    }

    const hit = this.providerCards.find((p) => p.id is this.providerId)
    this.providerLabel = hit ? hit.label + " (" + hit.kindName + ")" : ""
  }

  // Which second factors this account has on. Used to decide whether to ask for a code.
  async loadTwoFactor() {
    const result = await useApi("/api/account")
    if result.ok and result.data and result.data.two_factor {
      const tf = result.data.two_factor
      const sms = tf.sms
      this.tfTotp = Boolean(tf.enabled)
      this.tfSms = Boolean(sms and sms.enabled)
      this.smsHint = (sms and sms.phone_hint) or ""
      this.twoFactorOn = this.tfTotp or this.tfSms
    }
  }

  async sendCode() {
    if this.smsSending {
      return null
    }

    this.smsSending = true
    this.codeError = ""
    this.smsNotice = ""

    const result = await useApi("/api/account/two-factor/sms/send-code", { method: "POST" })

    this.smsSending = false

    if result.ok {
      this.smsNotice = "Code sent to " + this.smsHint + "."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.codeError = result.data?.error or "Couldn't send the code."
    }
  }

  // Shows the code box. When SMS is the only method, the code is texted right away.
  async openCodeStep() {
    this.codeOpen = true
    this.codeError = ""
    this.smsNotice = ""

    if this.tfSms and not this.tfTotp {
      await this.sendCode()
    }
  }

  // Returns true when the form must NOT be sent yet (the code box was just opened,
  // or the code is still empty).
  async needsCode() {
    if not this.twoFactorOn {
      return false
    }

    if not this.codeOpen {
      await this.openCodeStep()
      return true
    }

    if this.code.trim() is "" {
      this.codeError = "Enter a verification code to continue."
      return true
    }

    return false
  }

  // The server says a code is needed (status call failed or was stale).
  applyTwoFactorRequired(data) {
    const methods = data.methods or []
    this.twoFactorOn = true
    this.tfTotp = methods.includes("totp")
    this.tfSms = methods.includes("sms")
    this.codeOpen = true
    this.codeError = data.error or "Enter a verification code to continue."
  }

  // Adds the display name for a connection's provider.
  decorateProvider(p) {
    let kindName = "Linode (Akamai)"
    if p.kind is "hetzner" {
      kindName = "Hetzner Cloud"
    }
    if p.kind is "digitalocean" {
      kindName = "DigitalOcean"
    }
    // VULTR
    if p.kind is "vultr" {
      kindName = "Vultr"
    }
    // AWS
    if p.kind is "aws" {
      kindName = "Amazon Web Services"
    }
    // UPCLOUD
    if p.kind is "upcloud" {
      kindName = "UpCloud"
    }
    // CONTABO
    if p.kind is "contabo" {
      kindName = "Contabo"
    }
    return { id: p.id, label: p.label, kind: p.kind, kindName: kindName }
  }

  // Forgets everything that came from the previously chosen provider.
  resetCatalog() {
    this.region = ""
    this.regionLabel = ""
    this.regionOpen = false
    this.plan = ""
    this.planLabel = ""
    this.planOpen = false
    this.image = ""
    this.regions = []
    this.images = []
    this.plans = []
    this.shownPlans = []
    this.catalogError = ""
  }

  // The price line of a plan. A price of 0 means the provider's catalog has no
  // prices (AWS), so say so instead of showing "USD 0".
  decoratePlan(p) {
    let priceText = "pricing in the provider console"
    if p.monthly > 0 {
      priceText = p.currency + " " + p.monthly + " per month"
    }
    return Object.assign({}, p, { priceText: priceText })
  }

  applyPlanFilter() {
    let list = this.plans
    if this.tpl is "tylix" {
      list = this.plans.filter((p) => p.memory_mb > 4095)
    }
    this.shownPlans = list.map((p) => this.decoratePlan(p))
  }

  async loadCatalog() {
    this.catalogError = ""

    if this.providerId is 0 {
      return null
    }

    let url = "/api/catalog/" + this.providerKind

    // Linode's catalog is public. Every other provider needs the connection's credentials.
    if this.providerKind is "linode" {
      if this.region is not "" {
        url = url + "?region=" + this.region
      }
    } else {
      url = url + "?provider=" + this.providerId
      if this.region is not "" {
        url = url + "&region=" + this.region
      }
    }

    const result = await useApi(url)

    if result.ok {
      if this.regions.length is 0 {
        this.regions = result.data.regions
      }
      if this.images.length is 0 {
        this.images = result.data.images
      }
      this.plans = result.data.plans
      if this.image is "" and this.images.length > 0 {
        this.image = this.images[0].id
      }
      this.applyPlanFilter()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.catalogError = result.data?.error or "Couldn't load regions and plans from the provider. Try again."
    }
  }

  async pickProvider(id, kind) {
    if this.providerId is id {
      return null
    }

    this.custom = false
    this.providerId = id
    this.providerKind = kind
    this.providerError = ""
    this.syncProviderLabel()
    this.resetCatalog()

    await this.loadCatalog()
  }

  pickCustom() {
    if this.custom {
      return null
    }

    this.clearErrors()
    this.custom = true
    this.providerId = 0
    this.providerKind = "linode"
    this.syncProviderLabel()
    this.resetCatalog()
  }

  toggleRegion() {
    this.planOpen = false
    if this.regionOpen {
      this.regionOpen = false
    } else {
      this.regionOpen = true
    }
  }

  togglePlan() {
    this.regionOpen = false
    if this.planOpen {
      this.planOpen = false
    } else {
      this.planOpen = true
    }
  }

  async pickRegion(id, label) {
    this.region = id
    this.regionLabel = label
    this.regionOpen = false
    this.plan = ""
    this.planLabel = ""
    await this.loadCatalog()
  }

  pickPlan(id, label) {
    this.plan = id
    this.planLabel = label
    this.planOpen = false
  }

  pickImage(id) {
    this.image = id
  }

  pickTpl(t) {
    this.tpl = t
    this.plan = ""
    this.planLabel = ""
    this.planOpen = false
    this.applyPlanFilter()
  }

  async submit() {
    if Billing.locked or this.saving {
      return null
    }

    this.clearErrors()

    const stop = await this.needsCode()
    if stop {
      return null
    }

    this.saving = true

    const payload = {
      provider_id: this.providerId,
      name: this.name,
      region: this.region,
      plan: this.plan,
      image: this.image,
      "template": this.tpl,
      code: this.code.trim()
    }

    const result = await useApi("/api/provisions", { method: "POST", body: payload })

    if result.ok {
      // Straight to the progress view. Falls back to the list if no id came back.
      const created = result.data?.id or result.data?.provision?.id
      window.location.href = created ? "/servers/server-detail?provision=" + created : "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data and result.data.two_factor_required {
      this.applyTwoFactorRequired(result.data)
      this.saving = false
    } else {
      const errors = result.data?.errors
      this.providerError = this.firstError(errors, "provider_id")
      this.regionError = this.firstError(errors, "region")
      this.planError = this.firstError(errors, "plan")
      this.imageError = this.firstError(errors, "image")
      this.nameError = this.firstError(errors, "name")
      this.tplError = this.firstError(errors, "template")
      this.codeError = this.firstError(errors, "code")
      this.error = result.data?.error or result.error or ""
      if this.error is "" and not errors {
        this.error = "Couldn't create the server. Check the form and try again."
      }
      this.saving = false
    }
  }

  // A machine that already exists somewhere else: saved through the normal Servers API.
  async submitCustom() {
    if Billing.locked or this.saving {
      return null
    }

    this.clearErrors()

    const stop = await this.needsCode()
    if stop {
      return null
    }

    this.saving = true

    const payload = {
      name: this.name,
      host: this.host,
      port: this.port,
      ssh_user: this.sshUser,
      ssh_key: this.sshKey,
      code: this.code.trim()
    }

    const result = await useApi("/api/servers", { method: "POST", body: payload })

    if result.ok {
      window.location.href = "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data and result.data.two_factor_required {
      this.applyTwoFactorRequired(result.data)
      this.saving = false
    } else {
      const errors = result.data?.errors
      this.nameError = this.firstError(errors, "name")
      this.hostError = this.firstError(errors, "host")
      this.portError = this.firstError(errors, "port")
      this.userError = this.firstError(errors, "ssh_user")
      this.keyError = this.firstError(errors, "ssh_key")
      this.codeError = this.firstError(errors, "code")
      this.error = result.data?.error or result.error or ""
      if this.error is "" and not errors {
        this.error = "Couldn't add the server. Check the form and try again."
      }
      this.saving = false
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Providers.load()
    await this.loadTwoFactor()
    this.providerCards = Providers.data.map((p) => this.decorateProvider(p))

    const params = new URLSearchParams(window.location.search)
    const wanted = Number(params.get("provider"))
    const match = Providers.data.find((p) => p.id is wanted)

    if match {
      this.providerId = match.id
      this.providerKind = match.kind or "linode"
    } else if Providers.data.length is 1 {
      this.providerId = Providers.data[0].id
      this.providerKind = Providers.data[0].kind or "linode"
    }

    this.syncProviderLabel()
    await this.loadCatalog()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_1fr] bg-page transition-colors">
    <Sidebar active="servers" />
    <div class="min-w-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 pt-6 sm:pt-10 pb-4">

      <a href="/servers" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-5">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <LockedBanner />

      <div class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Create server</h1>
        <p class="text-slate-500 text-sm">Provision a new machine at your cloud provider, or add one you already have.</p>
      </div>

{{#if catalogError}}
      <div role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 px-4 py-3 mb-6">
        <p class="text-rose-600 dark:text-rose-400 text-sm">{{ catalogError }}</p>
      </div>
{{/if}}

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-6 items-start">

        <div class="min-w-0 space-y-4 sm:space-y-5">

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">1</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Where is the server?</h2>
            </div>

{{#if Providers.data.length is 0}}
            <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-4 mb-3 text-sm text-slate-500">
              No provider connected yet. <a href="/providers" class="text-brand-700 dark:text-brand-500 hover:underline">Connect a provider</a> to create a machine from here, or add a server you already have below.
            </div>
{{/if}}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each p in providerCards}}
{{#if providerId is p.id}}
              <button onclick="{{ pickProvider(p.id, p.kind) }}" aria-pressed="true" class="min-h-[56px] text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100 truncate">{{ p.label }}</span>
                <span class="block text-xs text-slate-500 truncate">{{ p.kindName }}</span>
              </button>
{{/if}}
{{#if providerId is not p.id}}
              <button onclick="{{ pickProvider(p.id, p.kind) }}" aria-pressed="false" class="min-h-[56px] text-left rounded-xl border-2 border-line px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100 truncate">{{ p.label }}</span>
                <span class="block text-xs text-slate-500 truncate">{{ p.kindName }}</span>
              </button>
{{/if}}
{{/each}}
{{#if custom}}
              <button onclick="{{ pickCustom() }}" aria-pressed="true" class="min-h-[56px] text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Custom server</span>
                <span class="block text-xs text-slate-500">Already created somewhere else. Add it with its SSH details.</span>
              </button>
{{/if}}
{{#if not custom}}
              <button onclick="{{ pickCustom() }}" aria-pressed="false" class="min-h-[56px] text-left rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Custom server</span>
                <span class="block text-xs text-slate-500">Already created somewhere else. Add it with its SSH details.</span>
              </button>
{{/if}}
            </div>
{{#if providerError}}
            <p class="text-rose-500 text-xs mt-2">{{ providerError }}</p>
{{/if}}
          </section>

{{#if custom}}
          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">2</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Connection details</h2>
            </div>

            <label for="custom-name" class="block text-slate-500 text-xs font-medium mb-1.5">Name</label>
            <input
              id="custom-name"
              type="text"
              value="{{ name }}"
              oninput="{{ name = $event.target.value }}"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
              placeholder="e.g. production-web"
            />
{{#if nameError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ nameError }}</p>
{{/if}}

            <div class="grid grid-cols-1 sm:grid-cols-[1fr_120px] gap-4 mt-4">
              <div>
                <label for="custom-host" class="block text-slate-500 text-xs font-medium mb-1.5">Host or IP address</label>
                <input
                  id="custom-host"
                  type="text"
                  inputmode="url"
                  autocapitalize="off"
                  value="{{ host }}"
                  oninput="{{ host = $event.target.value }}"
                  class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm font-mono px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
                  placeholder="203.0.113.10"
                />
{{#if hostError}}
                <p class="text-rose-500 text-xs mt-1.5">{{ hostError }}</p>
{{/if}}
              </div>
              <div>
                <label for="custom-port" class="block text-slate-500 text-xs font-medium mb-1.5">SSH port</label>
                <input
                  id="custom-port"
                  type="text"
                  inputmode="numeric"
                  value="{{ port }}"
                  oninput="{{ port = $event.target.value }}"
                  class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm font-mono px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
                />
{{#if portError}}
                <p class="text-rose-500 text-xs mt-1.5">{{ portError }}</p>
{{/if}}
              </div>
            </div>

            <label for="custom-user" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">SSH user</label>
            <input
              id="custom-user"
              type="text"
              autocapitalize="off"
              value="{{ sshUser }}"
              oninput="{{ sshUser = $event.target.value }}"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm font-mono px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
              placeholder="root"
            />
{{#if userError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ userError }}</p>
{{/if}}

            <label for="custom-key" class="block text-slate-500 text-xs font-medium mt-4 mb-1.5">SSH private key</label>
            <textarea
              id="custom-key"
              rows="8"
              spellcheck="false"
              value="{{ sshKey }}"
              oninput="{{ sshKey = $event.target.value }}"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs font-mono px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
              placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"
            ></textarea>
            <p class="text-slate-500 text-xs mt-1.5">Use a dedicated key without a passphrase. It is stored encrypted and never shown again.</p>
{{#if keyError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ keyError }}</p>
{{/if}}
          </section>
{{/if}}

{{#if not custom}}
          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">2</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Region</h2>
            </div>

            <button onclick="{{ toggleRegion() }}" aria-expanded="{{ regionOpen }}" class="w-full min-h-[48px] flex items-center justify-between gap-3 text-left rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40 transition-colors">
{{#if regionLabel}}
              <span class="truncate">{{ regionLabel }}</span>
{{/if}}
{{#if not regionLabel}}
              <span class="text-slate-500">Select a region</span>
{{/if}}
              <span class="text-slate-500 text-xs shrink-0">&#9662;</span>
            </button>
{{#if regionOpen}}
            <div class="mt-2 max-h-72 overflow-y-auto overscroll-contain rounded-xl border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
{{#each r in regions}}
              <button onclick="{{ pickRegion(r.id, r.label) }}" class="block w-full min-h-[44px] text-left px-3.5 py-3 text-sm text-slate-800 dark:text-slate-200 hover:bg-brand-500/10 transition-colors">
                {{ r.label }} <span class="text-xs text-slate-500 font-mono break-all">{{ r.id }}</span>
              </button>
{{/each}}
            </div>
{{/if}}
{{#if regionError}}
            <p class="text-rose-500 text-xs mt-2">{{ regionError }}</p>
{{/if}}
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">3</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Template</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
{{#if tpl is "tylix"}}
              <button onclick="{{ pickTpl('tylix') }}" aria-pressed="true" class="text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Tylix</span>
                <span class="block text-xs text-slate-500 mt-1">Standard plus PostgreSQL, MongoDB, Node.js 22 LTS, git and build tools. Needs 4 GB RAM or more.</span>
              </button>
{{/if}}
{{#if tpl is not "tylix"}}
              <button onclick="{{ pickTpl('tylix') }}" aria-pressed="false" class="text-left rounded-xl border-2 border-line px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Tylix</span>
                <span class="block text-xs text-slate-500 mt-1">Standard plus PostgreSQL, MongoDB, Node.js 22 LTS, git and build tools. Needs 4 GB RAM or more.</span>
              </button>
{{/if}}
{{#if tpl is "standard"}}
              <button onclick="{{ pickTpl('standard') }}" aria-pressed="true" class="text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Standard</span>
                <span class="block text-xs text-slate-500 mt-1">nginx, MySQL 8.4, Redis, Supervisor, UFW, remote-monitor. No Node.js.</span>
              </button>
{{/if}}
{{#if tpl is not "standard"}}
              <button onclick="{{ pickTpl('standard') }}" aria-pressed="false" class="text-left rounded-xl border-2 border-line px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Standard</span>
                <span class="block text-xs text-slate-500 mt-1">nginx, MySQL 8.4, Redis, Supervisor, UFW, remote-monitor. No Node.js.</span>
              </button>
{{/if}}
{{#if tpl is "bare"}}
              <button onclick="{{ pickTpl('bare') }}" aria-pressed="true" class="text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Bare</span>
                <span class="block text-xs text-slate-500 mt-1">Just the OS and SSH access. Add packages later from the server's Packages page.</span>
              </button>
{{/if}}
{{#if tpl is not "bare"}}
              <button onclick="{{ pickTpl('bare') }}" aria-pressed="false" class="text-left rounded-xl border-2 border-line px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">Bare</span>
                <span class="block text-xs text-slate-500 mt-1">Just the OS and SSH access. Add packages later from the server's Packages page.</span>
              </button>
{{/if}}
            </div>
{{#if tplError}}
            <p class="text-rose-500 text-xs mt-2">{{ tplError }}</p>
{{/if}}
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">4</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Plan</h2>
            </div>

{{#if not region}}
            <p class="text-slate-500 text-sm">Choose a region first. Prices depend on the region.</p>
{{/if}}
{{#if region}}
            <button onclick="{{ togglePlan() }}" aria-expanded="{{ planOpen }}" class="w-full min-h-[48px] flex items-center justify-between gap-3 text-left rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40 transition-colors">
{{#if planLabel}}
              <span class="truncate">{{ planLabel }}</span>
{{/if}}
{{#if not planLabel}}
              <span class="text-slate-500">Select a plan</span>
{{/if}}
              <span class="text-slate-500 text-xs shrink-0">&#9662;</span>
            </button>
{{#if planOpen}}
            <div class="mt-2 max-h-80 overflow-y-auto overscroll-contain rounded-xl border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
{{#each p in shownPlans}}
              <button onclick="{{ pickPlan(p.id, p.label) }}" class="block w-full min-h-[44px] text-left px-3.5 py-3 text-sm text-slate-800 dark:text-slate-200 hover:bg-brand-500/10 transition-colors">
                <span class="block font-medium">{{ p.label }}</span>
                <span class="block text-xs text-slate-500">{{ p.memory_mb }} MB / {{ p.vcpus }} vCPU / {{ p.disk_gb }} GB / {{ p.priceText }}</span>
              </button>
{{/each}}
            </div>
{{/if}}
{{/if}}
{{#if planError}}
            <p class="text-rose-500 text-xs mt-2">{{ planError }}</p>
{{/if}}
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">5</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Operating system</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
{{#each i in images}}
{{#if image is i.id}}
              <button onclick="{{ pickImage(i.id) }}" aria-pressed="true" class="min-h-[48px] text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-4 py-3 text-sm transition-colors">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">{{ i.label }}</span>
              </button>
{{/if}}
{{#if image is not i.id}}
              <button onclick="{{ pickImage(i.id) }}" aria-pressed="false" class="min-h-[48px] text-left rounded-xl border-2 border-line px-4 py-3 text-sm transition-colors hover:border-brand-500/40">
                <span class="block font-semibold text-slate-900 dark:text-slate-100">{{ i.label }}</span>
              </button>
{{/if}}
{{/each}}
            </div>
{{#if imageError}}
            <p class="text-rose-500 text-xs mt-2">{{ imageError }}</p>
{{/if}}
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">6</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Server name</h2>
            </div>

            <label for="server-name" class="block text-slate-500 text-xs font-medium mb-1.5">Lowercase letters, numbers and hyphens</label>
            <input
              id="server-name"
              type="text"
              autocapitalize="off"
              value="{{ name }}"
              oninput="{{ name = $event.target.value }}"
              class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
              placeholder="e.g. web-1"
            />
{{#if nameError}}
            <p class="text-rose-500 text-xs mt-1.5">{{ nameError }}</p>
{{/if}}
          </section>
{{/if}}

{{#if codeOpen}}
          <section class="rounded-2xl border border-brand-500/30 bg-brand-500/5 p-4 sm:p-6">
            <label for="create-code" class="block text-slate-900 dark:text-slate-100 text-sm font-semibold mb-1.5">Verification code</label>
            <input
              id="create-code"
              type="text"
              inputmode="text"
              autocomplete="one-time-code"
              maxlength="12"
              value="{{ code }}"
              oninput="{{ code = $event.target.value }}"
              class="w-full sm:w-64 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm font-mono px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
            />
{{#if tfTotp}}
            <p class="text-slate-500 text-xs mt-2">Enter a code from your authenticator app, or a recovery code.</p>
{{/if}}
{{#if not tfTotp}}
            <p class="text-slate-500 text-xs mt-2">Enter the code texted to {{ smsHint }}.</p>
{{/if}}
{{#if smsNotice}}
            <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ smsNotice }}</p>
{{/if}}
{{#if codeError}}
            <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if tfSms}}
{{#if smsSending}}
            <button disabled class="mt-3 min-h-[36px] text-xs text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 opacity-50">Sending…</button>
{{/if}}
{{#if not smsSending}}
            <button onclick="{{ sendCode() }}" class="mt-3 min-h-[36px] text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Text me a code</button>
{{/if}}
{{/if}}
          </section>
{{/if}}

{{#if error}}
          <div role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 px-4 py-3">
            <p class="text-rose-600 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>
{{/if}}

          <div class="sticky bottom-0 z-30 -mx-4 sm:-mx-6 lg:mx-0 px-4 sm:px-6 lg:px-0 py-3 bg-slate-100/90 dark:bg-slate-950/90 backdrop-blur border-t border-line lg:border-0 lg:bg-transparent lg:dark:bg-transparent lg:backdrop-blur-none flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 sm:gap-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
            <a href="/servers" class="text-center text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-4 py-2.5 transition-colors">Cancel</a>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center justify-center gap-1.5 min-h-[48px] text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-6 py-2.5 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
{{#if custom}}
              Add server
{{/if}}
{{#if not custom}}
              Create server
{{/if}}
            </button>
{{/if}}
{{#if not Billing.locked}}
{{#if custom}}
{{#if saving}}
            <button disabled class="min-h-[48px] text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-6 py-2.5 opacity-50">Adding…</button>
{{/if}}
{{#if not saving}}
            <button onclick="{{ submitCustom() }}" class="min-h-[48px] text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-6 py-2.5 shadow-sm hover:bg-brand-400 hover:shadow transition-all">Add server</button>
{{/if}}
{{/if}}
{{#if not custom}}
{{#if saving}}
            <button disabled class="min-h-[48px] text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-6 py-2.5 opacity-50">Creating…</button>
{{/if}}
{{#if not saving}}
            <button onclick="{{ submit() }}" class="min-h-[48px] text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-6 py-2.5 shadow-sm hover:bg-brand-400 hover:shadow transition-all">Create server</button>
{{/if}}
{{/if}}
{{/if}}
          </div>

        </div>

        <aside class="hidden lg:block lg:sticky lg:top-6">
          <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Your server</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-slate-500 text-xs">Provider</dt>
{{#if providerLabel}}
                <dd class="text-slate-900 dark:text-slate-100 break-words">{{ providerLabel }}</dd>
{{/if}}
{{#if not providerLabel}}
                <dd class="text-slate-400">Not chosen</dd>
{{/if}}
              </div>
{{#if custom}}
              <div>
                <dt class="text-slate-500 text-xs">Host</dt>
{{#if host}}
                <dd class="text-slate-900 dark:text-slate-100 font-mono break-all">{{ sshUser }}@{{ host }}:{{ port }}</dd>
{{/if}}
{{#if not host}}
                <dd class="text-slate-400">Not entered</dd>
{{/if}}
              </div>
{{/if}}
{{#if not custom}}
              <div>
                <dt class="text-slate-500 text-xs">Region</dt>
{{#if regionLabel}}
                <dd class="text-slate-900 dark:text-slate-100 break-words">{{ regionLabel }}</dd>
{{/if}}
{{#if not regionLabel}}
                <dd class="text-slate-400">Not chosen</dd>
{{/if}}
              </div>
              <div>
                <dt class="text-slate-500 text-xs">Template</dt>
                <dd class="text-slate-900 dark:text-slate-100 capitalize">{{ tpl }}</dd>
              </div>
              <div>
                <dt class="text-slate-500 text-xs">Plan</dt>
{{#if planLabel}}
                <dd class="text-slate-900 dark:text-slate-100 break-words">{{ planLabel }}</dd>
{{/if}}
{{#if not planLabel}}
                <dd class="text-slate-400">Not chosen</dd>
{{/if}}
              </div>
{{/if}}
              <div>
                <dt class="text-slate-500 text-xs">Name</dt>
{{#if name}}
                <dd class="text-slate-900 dark:text-slate-100 font-mono break-all">{{ name }}</dd>
{{/if}}
{{#if not name}}
                <dd class="text-slate-400">Not entered</dd>
{{/if}}
              </div>
            </dl>
{{#if twoFactorOn}}
            <p class="text-slate-500 text-xs mt-5 pt-4 border-t border-line">You'll be asked for a verification code before this is created.</p>
{{/if}}
          </div>
        </aside>

      </div>

    </div>
    </div>
  </div>
{{/if}}