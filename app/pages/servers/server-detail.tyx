page ServerDetail

import { IconArrowLeft, IconArrowRight, IconCheck, IconChevronRight, IconCog, IconCopy, IconExclamationTriangle, IconGlobe, IconLockClosed, IconPlus, IconPower, IconRefresh, IconServer, IconX } from "tylix-icons"

title "Server"

needs
  Auth

uses
  Billing
  Provisioning
  TwoFactor

background
  Billing

state
  server: null
  serverId: ""
  status: ""
  region: ""
  plan: ""
  loading: true
  isMissing: false
  provisioning: false
  statsBusy: false
  statsError: ""
  hasStats: false
  live: false
  streaming: false
  reconnectTimer: null
  copied: false
  sshCommand: ""
  lastChecked: ""
  alertText: ""
  sites: []
  cpuHistory: []
  memHistory: []
  cpuBars: []
  memBars: []
  cpuNow: 0
  memNow: 0
  cpuTone: ""
  memTone: ""
  diskTone: ""
  cpuScale: ""
  cpuCores: 0
  cpuSub: ""
  memText: ""
  memAvailText: ""
  diskPct: 0
  diskText: ""
  diskUsedText: ""
  diskFreeText: ""
  diskTotalText: ""
  diskBar: "width: 0%"
  diskBarCls: "bg-brand-500"
  load1: ""
  load5: ""
  load15: ""
  uptimeText: ""
  sinceText: ""
  specText: ""
  regionCity: ""
  rebootConfirm: false
  rebootBusy: false
  rebooting: false
  rebootStartedAt: 0
  rebootError: ""
  pwDismissed: false
  newPw: ""
  newPwConfirm: ""
  newPwShown: false
  newPwCopied: false
  newPwError: ""
  newPwCode: ""
  newPwAskCode: false
  newPwCodeError: ""

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  updated(server) {
    this.server = server
    this.status = server.status
    this.sshCommand = this.buildSsh(server)
  }

  buildSsh(server) {
    let cmd = "ssh " + server.ssh_user + "@" + server.host
    if server.port is not 22 {
      cmd = cmd + " -p " + server.port
    }
    return cmd
  }

  // ---------- expired root password (Hetzner) ----------

  dismissPassword() {
    this.pwDismissed = true
  }

  reopenPassword() {
    this.pwDismissed = false
    this.newPwError = ""
  }

  toggleNewPw() {
    this.newPwShown = this.newPwShown ? false : true
  }

  setNewPw(value) {
    this.newPw = value
    this.newPwCopied = false
    this.newPwError = ""
  }

  setNewPwConfirm(value) {
    this.newPwConfirm = value
    this.newPwError = ""
  }

  // 20 characters from an alphabet without look-alikes (0/O, 1/l/I).
  generatePassword() {
    const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#%^*-_=+"
    const bytes = new Uint32Array(20)
    window.crypto.getRandomValues(bytes)
    const value = Array.from(bytes).map((b) => chars[b % chars.length]).join("")
    this.newPw = value
    this.newPwConfirm = value
    this.newPwShown = true
    this.newPwCopied = false
    this.newPwError = ""
  }

  async copyNewPw() {
    if not this.newPw {
      return null
    }
    await navigator.clipboard.writeText(this.newPw)
    this.newPwCopied = true
  }

  // Same rules as the server, so most mistakes never leave the page.
  newPwProblem() {
    const value = this.newPw
    if value is "" {
      return "Enter a new password."
    }
    if value.length < 12 {
      return "Use at least 12 characters."
    }
    if value.length > 128 {
      return "Use at most 128 characters."
    }
    if not /^[\x20-\x7e]+$/.test(value) {
      return "Use letters, numbers, spaces and symbols only (no accents or emoji)."
    }
    if value is not value.trim() {
      return "The password can't start or end with a space."
    }
    if value is not this.newPwConfirm {
      return "The two passwords don't match."
    }
    return ""
  }

  async sendPwCode() {
    this.newPwCodeError = ""
    const result = await TwoFactor.sendCode()

    if result.status is 401 {
      window.location.href = "/login"
    } else if not result.ok {
      this.newPwCodeError = result.data?.error or "Couldn't send the code."
    }
  }

  async submitPassword() {
    if Provisioning.passwordBusy or Billing.locked {
      return null
    }

    this.newPwError = this.newPwProblem()
    this.newPwCodeError = ""
    if this.newPwError {
      return null
    }

    const code = this.newPwCode.trim()
    if this.newPwAskCode and code is "" {
      this.newPwCodeError = "Enter a verification code to set the password."
      return null
    }

    const result = await Provisioning.changePassword(this.newPw, code)
    const data = result.data

    if result.ok {
      this.newPw = ""
      this.newPwConfirm = ""
      this.newPwCode = ""
      this.newPwShown = false
      this.newPwCopied = false
      this.newPwAskCode = false
      this.pwDismissed = false
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and data?.two_factor_required {
      TwoFactor.apply(data.methods or [])
      this.newPwAskCode = true
      this.newPwCodeError = data.error or "Enter a verification code to continue."
    } else if result.status is 422 and data?.errors?.code {
      this.newPwAskCode = true
      this.newPwCodeError = data.errors.code[0]
    } else if not result.skipped {
      this.newPwError = data?.error or "Couldn't set the password. Try again."
    }
  }

  askReboot() {
    if Billing.locked {
      return null
    }
    this.rebootError = ""
    this.rebootConfirm = true
  }

  cancelReboot() {
    this.rebootConfirm = false
  }

  async rebootServer() {
    if Billing.locked or not this.server or this.rebootBusy {
      return null
    }

    this.rebootBusy = true
    this.rebootError = ""

    const result = await useApi("/api/servers/" + this.server.id + "/reboot", { method: "POST" })

    this.rebootBusy = false
    this.rebootConfirm = false

    if result.ok {
      this.rebooting = true
      this.rebootStartedAt = Date.now()
      this.statsError = ""
      this.status = "rebooting"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.rebootError = result.data?.error or "Couldn't reboot that server."
    }
  }

  async copySsh() {
    await navigator.clipboard.writeText(this.sshCommand)
    this.copied = true
    window.setTimeout(() => this.resetCopied(), 1800)
  }

  resetCopied() {
    this.copied = false
  }

  // Big-number colour: neutral until a resource is close to full.
  toneCls(p) {
    if p >= 90 {
      return "text-rose-600 dark:text-rose-500"
    }
    if p >= 75 {
      return "text-amber-600 dark:text-amber-500"
    }
    return "text-slate-900 dark:text-slate-100"
  }

  decorateSite(site) {
    return Object.assign({}, site, { href: "/servers/site-detail?id=" + site.id })
  }

  // The CPU chart zooms to the smallest scale that fits the last 15 minutes,
  // so a mostly idle server still shows its shape.
  cpuTop(values) {
    const peak = values.reduce((m, v) => Math.max(m, v), 0)
    return [10, 25, 50, 100].find((t) => peak <= t) or 100
  }

  // 30 slots, oldest first. Slots without a sample yet stay as a flat track.
  buildBars(values, top) {
    const pad = Math.max(0, 30 - values.length)
    const slots = Array.from({ length: pad }, () => null).concat(values)
    const last = slots.length - 1
    return slots.map((v, i) => this.barFor(v, top, i is last))
  }

  barFor(v, top, isNow) {
    if v is null {
      return { style: "height: 3px", cls: "bg-slate-200 dark:bg-white/[0.06]", title: "No sample yet" }
    }
    const pct = Math.max(4, Math.min(100, Math.round((v / top) * 100)))
    const cls = isNow ? "bg-brand-500" : "bg-brand-500/25 dark:bg-brand-400/25"
    return { style: "height: " + pct + "%", cls: cls, title: v + "%" }
  }

  formatBytes(n) {
    if n >= 1073741824 {
      return (n / 1073741824).toFixed(1) + " GB"
    }
    return Math.round(n / 1048576) + " MB"
  }

  formatGb(n) {
    return (n / 1073741824).toFixed(1)
  }

  formatUptime(sec) {
    const days = Math.floor(sec / 86400)
    const hours = Math.floor((sec % 86400) / 3600)
    if days > 0 {
      return days + "d " + hours + "h"
    }
    return hours + "h " + Math.floor((sec % 3600) / 60) + "m"
  }

  formatSince(sec) {
    const started = new Date(Date.now() - sec * 1000)
    if sec < 86400 {
      return "since " + started.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })
    }
    return "since " + started.toLocaleDateString([], { month: "short", day: "numeric" })
  }

  // Provider location codes to city names; anything unknown shows the code only.
  cityFor(code) {
    const cities = {
      fsn1: "Falkenstein",
      nbg1: "Nuremberg",
      hel1: "Helsinki",
      ash: "Ashburn",
      hil: "Hillsboro",
      sin: "Singapore",
      "us-east-1": "N. Virginia",
      "us-east-2": "Ohio",
      "us-west-1": "N. California",
      "us-west-2": "Oregon",
      "eu-west-1": "Ireland",
      "eu-west-2": "London",
      "eu-west-3": "Paris",
      "eu-central-1": "Frankfurt",
      "eu-north-1": "Stockholm",
      "ap-south-1": "Mumbai",
      "ap-southeast-1": "Singapore",
      "ap-southeast-2": "Sydney",
      "ap-northeast-1": "Tokyo",
      "ca-central-1": "Canada",
      "sa-east-1": "São Paulo",
    }
    return Reflect.get(cities, String(code or "").toLowerCase()) or ""
  }

  applyStats(s) {
    if this.rebooting and Date.now() - this.rebootStartedAt < 15000 {
      return null
    }

    this.rebooting = false

    const cpu = this.cpuHistory.concat([s.cpu_pct]).slice(-30)
    const mem = this.memHistory.concat([s.mem_pct]).slice(-30)
    const top = this.cpuTop(cpu)
    const cores = Number(s.cpus) or 0
    const load = Array.isArray(s.load) ? s.load : []

    this.cpuHistory = cpu
    this.memHistory = mem
    this.cpuBars = this.buildBars(cpu, top)
    this.memBars = this.buildBars(mem, 100)
    this.cpuScale = "scale 0–" + top + "%"
    this.cpuNow = s.cpu_pct
    this.memNow = s.mem_pct
    this.cpuTone = this.toneCls(s.cpu_pct)
    this.memTone = this.toneCls(s.mem_pct)
    this.diskTone = this.toneCls(s.disk_pct)
    this.cpuCores = cores
    this.load1 = load[0] is undefined ? "—" : Number(load[0]).toFixed(2)
    this.load5 = load[1] is undefined ? "—" : Number(load[1]).toFixed(2)
    this.load15 = load[2] is undefined ? "—" : Number(load[2]).toFixed(2)
    this.cpuSub = cores > 0 ? "Load " + this.load1 + " across " + cores + (cores is 1 ? " core" : " cores") : "Load " + this.load1 + " (1 min)"
    this.memText = this.formatGb(s.mem_used) + " of " + this.formatBytes(s.mem_total)
    this.memAvailText = this.formatBytes(Math.max(0, s.mem_total - s.mem_used)) + " available"
    this.diskPct = s.disk_pct
    this.diskText = this.formatGb(s.disk_used) + " of " + this.formatBytes(s.disk_total)
    this.diskUsedText = this.formatBytes(s.disk_used)
    this.diskFreeText = this.formatBytes(Math.max(0, s.disk_total - s.disk_used))
    this.diskTotalText = this.formatBytes(s.disk_total)
    this.diskBar = "width: " + Math.min(100, Math.max(0, s.disk_pct)) + "%"
    this.diskBarCls = s.disk_pct >= 90 ? "bg-rose-500" : s.disk_pct >= 75 ? "bg-amber-500" : "bg-brand-500"
    this.uptimeText = this.formatUptime(s.uptime)
    this.sinceText = this.formatSince(s.uptime)
    const memGb = Math.round(s.mem_total / 1073741824)
    this.specText = (cores > 0 ? cores + " vCPU · " : "") + (memGb > 0 ? memGb + " GB" : this.formatBytes(s.mem_total))
    this.lastChecked = new Date().toLocaleTimeString()

    const warn = []
    if s.cpu_pct >= 85 {
      warn.push("CPU is at " + s.cpu_pct + "%")
    }
    if s.mem_pct >= 90 {
      warn.push("memory is at " + s.mem_pct + "%")
    }
    if s.disk_pct >= 90 {
      warn.push("disk is at " + s.disk_pct + "%")
    }
    this.alertText = warn.join(" · ")

    this.statsError = ""
    this.hasStats = true
    this.status = "online"
  }

  applyStatsError(message) {
    if this.rebooting and Date.now() - this.rebootStartedAt < 180000 {
      this.status = "rebooting"
    } else {
      this.rebooting = false
      this.statsError = message or "Couldn't load stats."
      this.status = "offline"
    }
  }

  async loadStats() {
    if not this.server or this.statsBusy {
      return null
    }

    this.statsBusy = true
    const result = await useApi("/api/servers/" + this.server.id + "/stats")

    if result.ok {
      this.applyStats(result.data)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.applyStatsError(result.data?.error)
    }

    this.statsBusy = false
  }

  dropStream() {
    const ws = this.global("tylixStatsSocket")
    if ws {
      ws.onopen = null
      ws.onmessage = null
      ws.onclose = null
      ws.close()
      this.setGlobal("tylixStatsSocket", null)
    }
    this.streaming = false
    this.live = false
  }

  scheduleReconnect() {
    if this.reconnectTimer {
      return null
    }
    this.reconnectTimer = window.setTimeout(() => this.reconnectNow(), 4000)
  }

  async reconnectNow() {
    this.reconnectTimer = null
    if not this.server {
      return null
    }

    await this.loadStats()
    await this.openStream()
  }

  onStreamMessage(raw) {
    const msg = JSON.parse(raw)

    if msg.t is "ready" {
      this.live = true
    } else if msg.t is "stats" {
      this.applyStats(msg.d)
    } else if msg.t is "error" {
      this.applyStatsError(msg.m)
    }
  }

  onStreamClosed() {
    this.setGlobal("tylixStatsSocket", null)
    this.streaming = false
    this.live = false
    this.scheduleReconnect()
  }

  async openStream() {
    if not this.server or this.streaming {
      return null
    }

    this.streaming = true
    const result = await useApi("/api/servers/" + this.server.id + "/stats-ticket", { method: "POST" })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.status is 404 {
      this.streaming = false
      this.server = null
      this.isMissing = true
      return null
    }

    if not result.ok {
      this.streaming = false
      this.scheduleReconnect()
      return null
    }

    let url = result.data.url
    if not url {
      const hostname = window.location.hostname
      if hostname is "localhost" or hostname is "127.0.0.1" {
        const port = this.global("__TYLIX_CHANNELS_PORT__") or 6001
        url = "ws://" + hostname + ":" + port + "/serverstats"
      } else {
        url = (window.location.protocol is "https:" ? "wss://" : "ws://") + window.location.host + "/channels/serverstats"
      }
    }

    const ticket = result.data.ticket
    const ws = new WebSocket(url)
    ws.onopen = () => ws.send(JSON.stringify({ t: "auth", ticket: ticket }))
    ws.onmessage = (e) => this.onStreamMessage(e.data)
    ws.onclose = () => this.onStreamClosed()
    this.setGlobal("tylixStatsSocket", ws)
  }

onMount
  async {
    this.dropStream()

    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    const provisionParam = params.get("provision")
    this.serverId = serverId or ""

    if provisionParam {
      // A server that is still being created: show its steps and percentage.
      this.provisioning = true
      this.loading = false

      await Promise.all([Provisioning.connect(Number(provisionParam)), TwoFactor.load()])
      this.newPwAskCode = TwoFactor.enabled

      if Provisioning.notFound {
        this.provisioning = false
        this.isMissing = true
      }
    } else if not serverId {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        const sid = result.data.id
        this.server = result.data
        this.status = result.data.status
        this.sshCommand = this.buildSsh(result.data)
        this.loading = false


        const prov = await useApi("/api/provisions")
        if prov.ok and Array.isArray(prov.data) {
          const match = prov.data.find((p) => p.server_id is sid)
          if match {
            this.region = match.region
            this.plan = match.plan
            this.regionCity = this.cityFor(match.region)
          }
        }

        const siteRes = await useApi("/api/sites")
        if siteRes.ok and Array.isArray(siteRes.data) {
          const mine = siteRes.data.filter((x) => x.server_id is sid)
          this.sites = mine.map((x) => this.decorateSite(x))
        }

        await this.openStream()
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
    {{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="server" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
{{#if provisioning}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-6 sm:py-10">

{{#if loading}}
      <LoaderMark label="Loading server…" />
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if provisioning}}
      <a href="/servers" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <div class="mb-6">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ Provisioning.name }}</h1>
{{#if Provisioning.failed}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
          </span>
{{/if}}
{{#if Provisioning.finished}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
          </span>
{{/if}}
{{#if Provisioning.needsPassword}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Needs your input
          </span>
{{/if}}
{{#if not Provisioning.failed}}
{{#if not Provisioning.finished}}
{{#if not Provisioning.needsPassword}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span> Setting up
          </span>
{{/if}}
{{/if}}
{{/if}}
        </div>
{{#if Provisioning.ip}}
        <p class="text-slate-500 text-sm font-mono">{{ Provisioning.ip }}</p>
{{/if}}
{{#if not Provisioning.ip}}
        <p class="text-slate-500 text-sm">Creating your server. This page updates by itself.</p>
{{/if}}
      </div>

{{#if Provisioning.error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ Provisioning.error }}</p>
{{/if}}

{{#if Provisioning.needsPassword}}
      <div role="status" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 sm:px-5 mb-4">
        <div class="min-w-0">
          <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">Choose a root password to finish setup</p>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-0.5">The provider created this server with a temporary root password. Setup continues as soon as you set your own.</p>
        </div>
        <button onclick="{{ reopenPassword() }}" class="self-start sm:self-auto shrink-0 h-9 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-500 rounded-full px-4 transition">Set password</button>
      </div>
{{/if}}

      <div class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none mb-2">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ Provisioning.headline }}</p>
          <p class="text-brand-600 dark:text-brand-400 text-xs font-mono tabular-nums shrink-0">{{ Provisioning.shown }}%</p>
        </div>

        <div class="flex items-center gap-[2px] mb-6">
{{#each seg in Provisioning.segments}}
{{#if seg.k is 0}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-slate-500/20"></span>
{{/if}}
{{#if seg.k is 1}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-brand-500"></span>
{{/if}}
{{#if seg.k is 2}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-brand-100"></span>
{{/if}}
{{#if seg.k is 3}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-brand-200"></span>
{{/if}}
{{#if seg.k is 4}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-brand-300"></span>
{{/if}}
{{#if seg.k is 5}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-brand-400"></span>
{{/if}}
{{#if seg.k is 6}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-rose-500"></span>
{{/if}}
{{/each}}
        </div>

{{#each s in Provisioning.steps}}
        <div class="flex items-center justify-between gap-4 rounded-xl border border-line px-4 py-3 mb-2">
          <div class="flex items-center gap-3 min-w-0">
{{#if s.state is "done"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-emerald-500"></span>
{{/if}}
{{#if s.state is "running"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-sky-500 animate-pulse"></span>
{{/if}}
{{#if s.state is "failed"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-rose-500"></span>
{{/if}}
{{#if s.state is "action"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-amber-500"></span>
{{/if}}
{{#if s.state is "pending"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-slate-500"></span>
            <p class="text-sm font-medium truncate text-slate-900 dark:text-slate-100 opacity-60">{{ s.label }}</p>
{{/if}}
{{#if s.state is not "pending"}}
            <p class="text-sm font-medium truncate text-slate-900 dark:text-slate-100">{{ s.label }}</p>
{{/if}}
          </div>
          <p class="text-slate-500 text-xs shrink-0">{{ s.stateText }}</p>
        </div>
{{/each}}
      </div>

{{#if Provisioning.finished}}
      <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mb-6">Your server is ready. Opening it…</p>
{{/if}}
{{#if not Provisioning.finished}}
{{#if Provisioning.live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
        Live
      </p>
{{/if}}
{{#if not Provisioning.live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Reconnecting…
      </p>
{{/if}}
{{/if}}

{{#if Provisioning.needsPassword}}
{{#if not pwDismissed}}
      <div role="dialog" aria-modal="true" aria-labelledby="pw-modal-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm px-4 py-6">
        <div class="w-full max-w-md max-h-full overflow-y-auto rounded-2xl border border-line bg-panel shadow-2xl">

          <div class="flex items-start justify-between gap-4 p-6 pb-4">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 shrink-0 rounded-xl flex items-center justify-center bg-brand-500/10 text-brand-700 dark:text-brand-500">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                  <circle cx="8" cy="15" r="4" />
                  <path d="M10.85 12.15L19 4M18 5l2 2M15 8l2 2" />
                </svg>
              </div>
              <div class="min-w-0">
                <h3 id="pw-modal-title" class="text-slate-900 dark:text-slate-100 font-semibold">Set a root password</h3>
                <p class="text-slate-500 text-xs font-mono truncate">{{ Provisioning.name }}{{ Provisioning.ip ? " · " + Provisioning.ip : "" }}</p>
              </div>
            </div>
            <button onclick="{{ dismissPassword() }}" disabled="{{ Provisioning.passwordBusy }}" aria-label="Close" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-50">
              <IconX class="w-4 h-4" />
            </button>
          </div>

          <div class="px-6 pb-6">
            <p class="text-slate-600 dark:text-slate-300 text-sm mb-4">Your server is up. The provider gave it a temporary root password that has to be replaced before setup can continue. Choose a new one and the rest of the setup runs by itself.</p>

            <div class="flex items-center justify-between gap-3 mb-1.5">
              <label for="new-root-pw" class="text-slate-700 dark:text-slate-300 text-sm font-medium">New password</label>
              <button onclick="{{ generatePassword() }}" disabled="{{ Provisioning.passwordBusy }}" class="text-xs font-medium text-brand-700 dark:text-brand-500 hover:underline disabled:opacity-50">Generate one</button>
            </div>
            <div class="relative mb-3">
              <input
                id="new-root-pw"
                type="{{ newPwShown ? 'text' : 'password' }}"
                value="{{ newPw }}"
                oninput="{{ setNewPw($event.target.value) }}"
                autocomplete="new-password"
                spellcheck="false"
                maxlength="128"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono pl-3 pr-28 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500"
              />
              <div class="absolute right-1.5 top-1/2 -translate-y-1/2 flex items-center gap-0.5">
                <button onclick="{{ toggleNewPw() }}" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 px-2 py-1 rounded-md transition-colors">{{ newPwShown ? "Hide" : "Show" }}</button>
{{#if newPw}}
                <button onclick="{{ copyNewPw() }}" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 px-2 py-1 rounded-md transition-colors">{{ newPwCopied ? "Copied" : "Copy" }}</button>
{{/if}}
              </div>
            </div>

            <label for="new-root-pw-confirm" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-1.5">Confirm password</label>
            <input
              id="new-root-pw-confirm"
              type="{{ newPwShown ? 'text' : 'password' }}"
              value="{{ newPwConfirm }}"
              oninput="{{ setNewPwConfirm($event.target.value) }}"
              autocomplete="new-password"
              spellcheck="false"
              maxlength="128"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500"
            />
            <p class="text-slate-500 text-xs mt-2">At least 12 characters. It's stored encrypted, and you can view it later with the Root password button.</p>

{{#if newPwAskCode}}
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950/50 p-4 mt-4">
              <label for="new-root-pw-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Verification code</label>
              <input
                id="new-root-pw-code"
                type="text"
                inputmode="text"
                autocomplete="one-time-code"
                maxlength="12"
                value="{{ newPwCode }}"
                oninput="{{ newPwCode = $event.target.value }}"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-center text-lg font-mono tracking-[0.3em] px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500"
              />
              <p class="text-slate-500 text-xs mt-2">{{ TwoFactor.totp ? "Enter a code from your authenticator app, or a recovery code." : "Enter the code texted to " + TwoFactor.smsHint + "." }}</p>
{{#if TwoFactor.notice}}
              <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ TwoFactor.notice }}</p>
{{/if}}
{{#if newPwCodeError}}
              <p role="alert" class="text-rose-500 text-xs mt-2">{{ newPwCodeError }}</p>
{{/if}}
{{#if TwoFactor.sms}}
              <button disabled="{{ TwoFactor.sending }}" onclick="{{ sendPwCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-50">{{ TwoFactor.sending ? "Sending…" : "Text me a code" }}</button>
{{/if}}
            </div>
{{/if}}

{{#if newPwError}}
            <p role="alert" class="text-rose-500 text-sm mt-4">{{ newPwError }}</p>
{{/if}}
{{#if Provisioning.passwordBusy}}
            <p role="status" class="text-slate-500 text-sm mt-4">Setting the password on the server. This takes a few seconds…</p>
{{/if}}
          </div>

          <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-line bg-slate-50 dark:bg-slate-950/40">
            <button onclick="{{ dismissPassword() }}" disabled="{{ Provisioning.passwordBusy }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors disabled:opacity-50">Later</button>
            <button onclick="{{ submitPassword() }}" disabled="{{ Provisioning.passwordBusy or Billing.locked }}" title="{{ Billing.locked ? 'Pay to continue' : '' }}" class="text-sm bg-brand-500 text-white font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-brand-400 transition-all disabled:opacity-50 disabled:cursor-not-allowed">{{ Provisioning.passwordBusy ? "Setting password…" : "Set password and continue" }}</button>
          </div>

        </div>
      </div>
{{/if}}
{{/if}}
{{/if}}

{{#if server}}
      <a href="/servers" class="lg:hidden inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <LockedBanner />

{{#if rebooting}}
      <div role="status" class="flex items-start gap-3 rounded-xl border border-sky-200 dark:border-sky-900/50 bg-sky-50 dark:bg-sky-950/30 px-4 py-3 mb-4">
        <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-sky-500 animate-pulse"></span>
        <p class="text-sky-800 dark:text-sky-300 text-sm"><span class="font-semibold">Rebooting.</span> The server will be unreachable for a minute or so. This page picks it up again by itself.</p>
      </div>
{{/if}}

{{#if alertText}}
      <div role="alert" class="flex items-start gap-3 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 mb-4">
        <IconExclamationTriangle class="mt-0.5 w-4 h-4 shrink-0 text-amber-600 dark:text-amber-500" />
        <p class="text-amber-800 dark:text-amber-300 text-sm"><span class="font-semibold">High usage:</span> {{ alertText }}</p>
      </div>
{{/if}}

{{#if statsError}}
      <div role="alert" class="flex items-start gap-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-4">
        <IconExclamationTriangle class="mt-0.5 w-4 h-4 shrink-0 text-rose-600 dark:text-rose-500" />
        <p class="text-rose-800 dark:text-rose-300 text-sm"><span class="font-semibold">Can't reach the server.</span> {{ statsError }}</p>
      </div>
{{/if}}

      <section aria-label="Server overview" class="rounded-2xl border border-line bg-panel shadow-card overflow-hidden mb-6">

        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 px-5 sm:px-8 py-5 sm:py-6">
          <div class="flex items-center gap-4 min-w-0">
            <div class="w-12 h-12 shrink-0 rounded-xl flex items-center justify-center bg-brand-500/10 text-brand-600 dark:text-brand-400">
              <IconServer class="w-5 h-5" />
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-3 min-w-0">
                <h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ server.name }}</h1>
{{#if status is "online"}}
                <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 dark:text-emerald-500">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Online
                </span>
{{/if}}
{{#if status is "pending"}}
                <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 dark:text-amber-500">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Not tested
                </span>
{{/if}}
{{#if status is "offline"}}
                <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-rose-600 dark:text-rose-500">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> Offline
                </span>
{{/if}}
{{#if status is "rebooting"}}
                <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-sky-600 dark:text-sky-400">
                  <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span> Rebooting
                </span>
{{/if}}
              </div>
              <p class="mt-1 text-slate-500 text-[13px] font-mono truncate">{{ server.ssh_user }}@{{ server.host }}:{{ server.port }}</p>
            </div>
          </div>

          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <p class="mr-auto md:mr-1 inline-flex items-center gap-2 text-sm text-slate-500 tabular-nums whitespace-nowrap" aria-live="polite">
{{#if live}}
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" title="Live"></span>
{{#if lastChecked}}
              <span><span class="hidden sm:inline">Updated </span>{{ lastChecked }}</span>
{{#else}}
              Live
{{/if}}
{{#else}}
{{#if hasStats}}
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Reconnecting…
{{#else}}
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-pulse"></span>
              Connecting…
{{/if}}
{{/if}}
            </p>
            <button onclick="{{ copySsh() }}" title="{{ copied ? 'Copied' : 'Copy SSH command' }}" aria-label="Copy SSH command" class="w-10 h-10 shrink-0 inline-flex items-center justify-center rounded-lg border border-line bg-panel text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/[0.04] hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
{{#if copied}}
              <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-500" />
{{#else}}
              <IconCopy class="w-4 h-4" />
{{/if}}
            </button>
            <button onclick="{{ loadStats() }}" disabled="{{ statsBusy or rebooting }}" title="Refresh stats" aria-label="Refresh stats" class="w-10 h-10 shrink-0 inline-flex items-center justify-center rounded-lg border border-line bg-panel text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/[0.04] hover:text-slate-900 dark:hover:text-slate-100 transition-colors disabled:opacity-60 disabled:cursor-default">
              <IconRefresh class="{{ statsBusy ? 'w-4 h-4 animate-spin' : 'w-4 h-4' }}" />
            </button>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="shrink-0 inline-flex items-center gap-2 h-10 text-sm font-semibold text-slate-500 bg-slate-100 dark:bg-white/[0.04] border border-line rounded-lg px-4 cursor-not-allowed select-none">
              <IconLockClosed class="w-4 h-4" /> Edit server
            </button>
{{#else}}
            <ServerForm server="{{ server }}" onSaved="{{ updated }}" />
{{/if}}
          </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line border-t border-line">

          <div class="bg-panel flex flex-col px-5 sm:px-8 py-6 sm:py-7">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-slate-500">CPU</h2>
{{#if cpuCores}}
              <p class="text-[13px] text-slate-500 tabular-nums">{{ cpuCores }} vCPU</p>
{{/if}}
            </div>
{{#if hasStats}}
            <p class="mt-4 flex items-baseline gap-1.5 {{ cpuTone }}">
              <span class="text-6xl sm:text-7xl font-medium tracking-tight tabular-nums leading-none">{{ cpuNow }}</span>
              <span class="text-2xl text-slate-500">%</span>
            </p>
            <p class="mt-3 text-sm text-slate-500 tabular-nums">{{ cpuSub }}</p>
            <div class="mt-auto pt-10">
              <div class="h-16 flex items-end gap-[3px]" role="img" aria-label="{{ 'CPU over the last 15 minutes, now ' + cpuNow + '%' }}">
{{#each b in cpuBars}}
                <span class="{{ 'flex-1 min-w-0 rounded-[2px] transition-[height] duration-500 ' + b.cls }}" style="{{ b.style }}" title="{{ b.title }}"></span>
{{/each}}
              </div>
              <div class="mt-2 flex justify-between text-[11px] text-slate-500 tabular-nums">
                <span>15 min ago</span><span>{{ cpuScale }}</span><span>now</span>
              </div>
            </div>
{{#else}}
            <div class="mt-4 h-[72px] w-28 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-3 h-4 w-40 rounded bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-10 h-16 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
{{/if}}
          </div>

          <div class="bg-panel flex flex-col px-5 sm:px-8 py-6 sm:py-7">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-slate-500">Memory</h2>
{{#if hasStats}}
              <p class="text-[13px] text-slate-500 tabular-nums">{{ memText }}</p>
{{/if}}
            </div>
{{#if hasStats}}
            <p class="mt-4 flex items-baseline gap-1.5 {{ memTone }}">
              <span class="text-6xl sm:text-7xl font-medium tracking-tight tabular-nums leading-none">{{ memNow }}</span>
              <span class="text-2xl text-slate-500">%</span>
            </p>
            <p class="mt-3 text-sm text-slate-500 tabular-nums">{{ memAvailText }}</p>
            <div class="mt-auto pt-10">
              <div class="h-16 flex items-end gap-[3px]" role="img" aria-label="{{ 'Memory over the last 15 minutes, now ' + memNow + '%' }}">
{{#each b in memBars}}
                <span class="{{ 'flex-1 min-w-0 rounded-[2px] transition-[height] duration-500 ' + b.cls }}" style="{{ b.style }}" title="{{ b.title }}"></span>
{{/each}}
              </div>
              <div class="mt-2 flex justify-between text-[11px] text-slate-500 tabular-nums">
                <span>15 min ago</span><span>scale 0–100%</span><span>now</span>
              </div>
            </div>
{{#else}}
            <div class="mt-4 h-[72px] w-36 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-3 h-4 w-32 rounded bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-10 h-16 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
{{/if}}
          </div>

          <div class="bg-panel flex flex-col px-5 sm:px-8 py-6 sm:py-7">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-slate-500">Disk</h2>
{{#if hasStats}}
              <p class="text-[13px] text-slate-500 tabular-nums">{{ diskText }}</p>
{{/if}}
            </div>
{{#if hasStats}}
            <p class="mt-4 flex items-baseline gap-1.5 {{ diskTone }}">
              <span class="text-6xl sm:text-7xl font-medium tracking-tight tabular-nums leading-none">{{ diskPct }}</span>
              <span class="text-2xl text-slate-500">%</span>
            </p>
            <p class="mt-3 text-sm text-slate-500">Root volume</p>
            <div class="mt-auto pt-10">
              <div class="grid grid-cols-2 gap-4 mb-3">
                <div>
                  <p class="text-[13px] text-slate-500">Used</p>
                  <p class="text-base font-semibold text-slate-900 dark:text-slate-100 tabular-nums">{{ diskUsedText }}</p>
                </div>
                <div>
                  <p class="text-[13px] text-slate-500">Free</p>
                  <p class="text-base font-semibold text-slate-900 dark:text-slate-100 tabular-nums">{{ diskFreeText }}</p>
                </div>
              </div>
              <div class="h-2.5 rounded-full bg-brand-500/10 dark:bg-white/[0.06] overflow-hidden" role="progressbar" aria-label="Disk used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ diskPct }}">
                <div class="{{ 'h-full rounded-full transition-all duration-500 ' + diskBarCls }}" style="{{ diskBar }}"></div>
              </div>
              <div class="relative mt-2 h-4 text-[11px] text-slate-500 tabular-nums" aria-hidden="true">
                <span class="absolute left-0">0</span>
                <span class="absolute left-1/4 -translate-x-1/2 md:hidden 2xl:block">25%</span>
                <span class="absolute left-1/2 -translate-x-1/2">50%</span>
                <span class="absolute left-3/4 -translate-x-1/2 md:hidden 2xl:block">75%</span>
                <span class="absolute right-0">{{ diskTotalText }}</span>
              </div>
            </div>
{{#else}}
            <div class="mt-4 h-[72px] w-36 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-3 h-4 w-24 rounded bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
            <div class="mt-10 h-16 rounded-lg bg-slate-100 dark:bg-white/[0.04] animate-pulse"></div>
{{/if}}
          </div>

        </div>

        <dl class="grid grid-cols-2 md:grid-cols-4 gap-px bg-line border-t border-line">
          <div class="bg-slate-50 dark:bg-white/[0.015] px-5 sm:px-8 py-4 min-w-0">
            <dt class="text-[13px] text-slate-500">Uptime</dt>
{{#if hasStats}}
            <dd class="mt-0.5 text-sm truncate tabular-nums"><span class="font-semibold text-slate-900 dark:text-slate-100">{{ uptimeText }}</span> <span class="text-slate-500">{{ sinceText }}</span></dd>
{{#else}}
            <dd class="mt-0.5 text-sm font-semibold text-slate-400">—</dd>
{{/if}}
          </div>
          <div class="bg-slate-50 dark:bg-white/[0.015] px-5 sm:px-8 py-4 min-w-0">
            <dt class="text-[13px] text-slate-500">Load average</dt>
{{#if hasStats}}
            <dd class="mt-0.5 text-sm truncate tabular-nums"><span class="font-semibold text-slate-900 dark:text-slate-100">{{ load1 }} {{ load5 }} {{ load15 }}</span> <span class="hidden sm:inline text-slate-500">1/5/15m</span></dd>
{{#else}}
            <dd class="mt-0.5 text-sm font-semibold text-slate-400">—</dd>
{{/if}}
          </div>
          <div class="bg-slate-50 dark:bg-white/[0.015] px-5 sm:px-8 py-4 min-w-0">
            <dt class="text-[13px] text-slate-500">Region</dt>
{{#if region}}
            <dd class="mt-0.5 text-sm truncate"><span class="font-semibold text-slate-900 dark:text-slate-100">{{ region }}</span> <span class="text-slate-500">{{ regionCity }}</span></dd>
{{#else}}
            <dd class="mt-0.5 text-sm truncate"><span class="font-semibold text-slate-900 dark:text-slate-100">Custom</span> <span class="text-slate-500">your own server</span></dd>
{{/if}}
          </div>
          <div class="bg-slate-50 dark:bg-white/[0.015] px-5 sm:px-8 py-4 min-w-0">
            <dt class="text-[13px] text-slate-500">Plan</dt>
            <dd class="mt-0.5 text-sm truncate tabular-nums"><span class="font-semibold text-slate-900 dark:text-slate-100">{{ plan ? plan.toUpperCase() : "—" }}</span> <span class="text-slate-500">{{ specText }}</span></dd>
          </div>
        </dl>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-6">

        <section aria-labelledby="sites-heading" class="lg:col-span-3 rounded-2xl border border-line bg-panel shadow-card overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-5 sm:px-6 py-4 border-b border-line">
            <div class="flex items-center gap-2 min-w-0">
              <h2 id="sites-heading" class="text-slate-900 dark:text-slate-100 font-semibold">Sites</h2>
{{#if sites.length}}
              <span class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1.5 rounded-full bg-slate-100 dark:bg-white/[0.06] text-xs font-medium text-slate-600 dark:text-slate-300 tabular-nums">{{ sites.length }}</span>
{{/if}}
            </div>
{{#if Billing.locked}}
            <span title="Pay to continue" class="inline-flex items-center gap-1.5 h-8 text-sm text-slate-400 border border-line rounded-lg px-3 select-none cursor-not-allowed">
              <IconLockClosed class="w-3.5 h-3.5" /> New site
            </span>
{{#else}}
            <a href="{{ '/servers/site-create?id=' + serverId }}" class="inline-flex items-center gap-1.5 h-8 text-sm font-medium text-slate-700 dark:text-slate-200 border border-line rounded-lg px-3 hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors">
              <IconPlus class="w-3.5 h-3.5" /> New site
            </a>
{{/if}}
          </div>

{{#if sites.length is 0}}
          <div class="flex flex-col items-center text-center px-6 py-12">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-white/[0.05] text-slate-500 mb-3">
              <IconGlobe class="w-5 h-5" />
            </div>
            <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">Nothing deployed here yet</p>
            <p class="text-slate-500 text-sm mt-1 mb-4 max-w-xs">Create a site to deploy an app from a repository onto this server.</p>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 h-9 text-sm text-slate-500 bg-slate-100 dark:bg-white/[0.04] border border-line rounded-lg px-4 cursor-not-allowed select-none">
              <IconLockClosed class="w-4 h-4" /> Create a site
            </button>
{{#else}}
            <a href="{{ '/servers/site-create?id=' + serverId }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-600 rounded-lg px-4 shadow-sm transition-colors">
              <IconPlus class="w-4 h-4" /> Create a site
            </a>
{{/if}}
          </div>
{{/if}}

{{#if sites.length}}
          <ul class="divide-y divide-line">
{{#each site in sites}}
            <li>
              <a href="{{ site.href }}" class="group flex items-center gap-3 px-5 sm:px-6 py-3.5 hover:bg-slate-50 dark:hover:bg-white/[0.03] transition-colors">
                <span class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center bg-brand-500/10 text-brand-600 dark:text-brand-400">
                  <IconGlobe class="w-4 h-4" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-slate-900 dark:text-slate-100 text-sm font-medium truncate group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">{{ site.name }}</span>
                  <span class="block text-slate-500 text-xs font-mono truncate">{{ site.domain }}</span>
                </span>
                <IconChevronRight class="w-4 h-4 shrink-0 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300 group-hover:translate-x-0.5 transition" />
              </a>
            </li>
{{/each}}
          </ul>
{{/if}}
        </section>

        <section aria-labelledby="connect-heading" class="lg:col-span-2 rounded-2xl border border-line bg-panel shadow-card overflow-hidden">
          <div class="px-5 sm:px-6 py-4 border-b border-line">
            <h2 id="connect-heading" class="text-slate-900 dark:text-slate-100 font-semibold">Connect</h2>
          </div>
          <div class="px-5 sm:px-6 py-5">
            <p class="text-slate-500 text-sm mb-3">Open a shell on this server from your machine.</p>
            <div class="flex items-center gap-2 rounded-xl bg-slate-950 dark:bg-black/40 border border-transparent dark:border-line pl-4 pr-1.5 py-1.5">
              <span class="text-slate-500 text-sm font-mono select-none">$</span>
              <code class="flex-1 min-w-0 text-slate-100 text-sm font-mono truncate">{{ sshCommand }}</code>
              <button onclick="{{ copySsh() }}" aria-label="Copy SSH command" class="shrink-0 inline-flex items-center gap-1.5 h-8 text-xs font-medium rounded-lg px-2.5 text-slate-300 hover:text-white hover:bg-white/10 transition-colors">
{{#if copied}}
                <IconCheck class="w-3.5 h-3.5 text-emerald-400" /> Copied
{{#else}}
                <IconCopy class="w-3.5 h-3.5" /> Copy
{{/if}}
              </button>
            </div>

            <dl class="mt-5 divide-y divide-line text-sm">
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Host</dt>
                <dd class="text-slate-900 dark:text-slate-100 font-mono text-[13px] truncate">{{ server.host }}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">SSH port</dt>
                <dd class="text-slate-900 dark:text-slate-100 font-mono text-[13px]">{{ server.port }}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">SSH user</dt>
                <dd class="text-slate-900 dark:text-slate-100 font-mono text-[13px]">{{ server.ssh_user }}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">SSH key</dt>
                <dd class="inline-flex items-center gap-1.5 text-slate-900 dark:text-slate-100"><IconLockClosed class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-500" /> Stored encrypted</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Added</dt>
                <dd class="text-slate-900 dark:text-slate-100 tabular-nums">{{ server.created_at.slice(0, 10) }}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 pt-2.5">
                <dt class="text-slate-500">Last changed</dt>
                <dd class="text-slate-900 dark:text-slate-100 tabular-nums">{{ server.updated_at.slice(0, 10) }}</dd>
              </div>
            </dl>
          </div>
        </section>
      </div>

      <section aria-label="Server actions" class="rounded-2xl border border-line bg-panel shadow-card divide-y divide-line">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 sm:px-6 py-4 sm:py-5">
          <div class="flex items-start gap-4 min-w-0">
            <span class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center bg-amber-500/10 text-amber-600 dark:text-amber-500">
              <IconPower class="w-4 h-4" />
            </span>
            <div class="min-w-0">
              <h2 class="text-slate-900 dark:text-slate-100 text-sm font-semibold">Reboot server</h2>
              <p class="text-slate-500 text-sm mt-0.5">Restarts the machine over SSH. Sites on it go offline for about a minute. Needs root or passwordless sudo.</p>
{{#if rebootError}}
              <p role="alert" class="text-rose-500 text-sm mt-2">{{ rebootError }}</p>
{{/if}}
            </div>
          </div>
          <div class="shrink-0 flex items-center gap-2 sm:pl-0 pl-[52px]">
{{#if Billing.locked}}
            <button disabled title="View only. Pay to continue." class="inline-flex items-center gap-1.5 h-9 text-sm text-slate-400 border border-line rounded-lg px-4 cursor-not-allowed select-none">
              <IconLockClosed class="w-4 h-4" /> Reboot
            </button>
{{#else}}
{{#if rebooting}}
            <button disabled class="h-9 text-sm text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-900/50 rounded-lg px-4 opacity-70">Rebooting…</button>
{{#else}}
{{#if rebootConfirm}}
            <button onclick="{{ cancelReboot() }}" disabled="{{ rebootBusy }}" class="h-9 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 transition-colors disabled:opacity-50">Cancel</button>
            <button onclick="{{ rebootServer() }}" disabled="{{ rebootBusy }}" class="h-9 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-500 rounded-lg px-4 transition disabled:opacity-60">{{ rebootBusy ? "Sending…" : "Yes, reboot now" }}</button>
{{#else}}
            <button onclick="{{ askReboot() }}" class="h-9 text-sm font-medium text-amber-700 dark:text-amber-500 border border-amber-200 dark:border-amber-900/50 rounded-lg px-4 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition">Reboot</button>
{{/if}}
{{/if}}
{{/if}}
          </div>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 sm:px-6 py-4 sm:py-5">
          <div class="flex items-start gap-4 min-w-0">
            <span class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center bg-slate-100 dark:bg-white/[0.05] text-slate-600 dark:text-slate-300">
              <IconCog class="w-4 h-4" />
            </span>
            <div class="min-w-0">
              <h2 class="text-slate-900 dark:text-slate-100 text-sm font-semibold">Settings and danger zone</h2>
              <p class="text-slate-500 text-sm mt-0.5">Updates, services, host keys, and deleting this server.</p>
            </div>
          </div>
          <a href="{{ '/servers/server-settings?id=' + serverId }}" class="self-start sm:self-auto ml-[52px] sm:ml-0 shrink-0 inline-flex items-center justify-center gap-1.5 h-9 text-sm font-medium text-slate-700 dark:text-slate-200 border border-line rounded-lg px-4 hover:bg-slate-50 dark:hover:bg-white/[0.04] transition-colors">Open settings <IconArrowRight class="w-3.5 h-3.5" /></a>
        </div>
      </section>
{{/if}}

    </div>
    </div>
  </div>
 