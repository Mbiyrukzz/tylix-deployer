page ServerDetail

import { IconArrowLeft } from "tylix-icons"

title "Server"

needs
  Auth

uses
  Billing
  Provisioning
  TwoFactor

background
  Billing

state
  server: null
  serverId: ""
  status: ""
  region: ""
  plan: ""
  loading: true
  notFound: false
  provisioning: false
  confirmDelete: false
  deleting: false
  error: ""
  askCode: false
  code: ""
  codeError: ""
  statsBusy: false
  statsError: ""
  hasStats: false
  live: false
  streaming: false
  reconnectTimer: null
  copied: false
  sshCommand: ""
  lastChecked: ""
  alertText: ""
  sites: []
  cpuHistory: []
  memHistory: []
  cpuPoints: ""
  memPoints: ""
  cpuArea: ""
  memArea: ""
  cpuNow: 0
  memNow: 0
  cpuColor: "#10b981"
  memColor: "#38bdf8"
  diskColor: "#10b981"
  cpuBar: "width: 0%"
  memBar: "width: 0%"
  memText: ""
  diskPct: 0
  diskText: ""
  diskDash: "0 226.2"
  loadText: ""
  uptimeText: ""
  rebootConfirm: false
  rebootBusy: false
  rebooting: false
  rebootStartedAt: 0
  rebootError: ""

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  updated(server) {
    this.server = server
    this.status = server.status
    this.sshCommand = this.buildSsh(server)
  }

  buildSsh(server) {
    let cmd = "ssh " + server.ssh_user + "@" + server.host
    if server.port is not 22 {
      cmd = cmd + " -p " + server.port
    }
    return cmd
  }

  async askDelete() {
    if Billing.locked {
      return null
    }
    this.error = ""
    this.codeError = ""
    this.code = ""
    this.askCode = TwoFactor.enabled
    this.confirmDelete = true

    if TwoFactor.sms and not TwoFactor.totp {
      await this.sendCode()
    }
  }

  cancelDelete() {
    this.confirmDelete = false
    this.askCode = false
    this.code = ""
    this.codeError = ""
    TwoFactor.reset()
  }

  async sendCode() {
    this.codeError = ""
    const result = await TwoFactor.sendCode()

    if result.status is 401 {
      window.location.href = "/login"
    } else if not result.ok {
      this.codeError = result.data?.error or "Couldn't send the code."
    }
  }

  askReboot() {
    if Billing.locked {
      return null
    }
    this.rebootError = ""
    this.rebootConfirm = true
  }

  cancelReboot() {
    this.rebootConfirm = false
  }

  async rebootServer() {
    if Billing.locked or not this.server or this.rebootBusy {
      return null
    }

    this.rebootBusy = true
    this.rebootError = ""

    const result = await useApi("/api/servers/" + this.server.id + "/reboot", { method: "POST" })

    this.rebootBusy = false
    this.rebootConfirm = false

    if result.ok {
      this.rebooting = true
      this.rebootStartedAt = Date.now()
      this.statsError = ""
      this.status = "rebooting"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.rebootError = result.data?.error or "Couldn't reboot that server."
    }
  }

  async copySsh() {
    await navigator.clipboard.writeText(this.sshCommand)
    this.copied = true
    window.setTimeout(() => this.resetCopied(), 1800)
  }

  resetCopied() {
    this.copied = false
  }

  toneColor(p, fallback) {
    if p >= 90 {
      return "#f43f5e"
    }
    if p >= 75 {
      return "#f59e0b"
    }
    return fallback
  }

  decorateSite(site) {
    return Object.assign({}, site, { href: "/servers/site-detail?id=" + site.id })
  }

  chartPoints(values) {
    const step = 300 / 29
    const offset = 29 - (values.length - 1)
    return values.map((v, i) => Math.round((offset + i) * step) + "," + Math.round(78 - v * 0.76)).join(" ")
  }

  chartArea(values) {
    const step = 300 / 29
    const x0 = Math.round((29 - (values.length - 1)) * step)
    return x0 + ",80 " + this.chartPoints(values) + " 300,80"
  }

  formatBytes(n) {
    if n >= 1073741824 {
      return (n / 1073741824).toFixed(1) + " GB"
    }
    return Math.round(n / 1048576) + " MB"
  }

  formatUptime(sec) {
    const days = Math.floor(sec / 86400)
    const hours = Math.floor((sec % 86400) / 3600)
    if days > 0 {
      return days + "d " + hours + "h"
    }
    return hours + "h " + Math.floor((sec % 3600) / 60) + "m"
  }

  applyStats(s) {
    if this.rebooting and Date.now() - this.rebootStartedAt < 15000 {
      return null
    }

    this.rebooting = false

    const cpu = this.cpuHistory.concat([s.cpu_pct]).slice(-30)
    const mem = this.memHistory.concat([s.mem_pct]).slice(-30)

    this.cpuHistory = cpu
    this.memHistory = mem
    this.cpuPoints = this.chartPoints(cpu)
    this.memPoints = this.chartPoints(mem)
    this.cpuArea = this.chartArea(cpu)
    this.memArea = this.chartArea(mem)
    this.cpuNow = s.cpu_pct
    this.memNow = s.mem_pct
    this.cpuColor = this.toneColor(s.cpu_pct, "#10b981")
    this.memColor = this.toneColor(s.mem_pct, "#38bdf8")
    this.diskColor = this.toneColor(s.disk_pct, "#10b981")
    this.cpuBar = "width: " + Math.min(100, s.cpu_pct) + "%"
    this.memBar = "width: " + Math.min(100, s.mem_pct) + "%"
    this.memText = this.formatBytes(s.mem_used) + " of " + this.formatBytes(s.mem_total)
    this.diskPct = s.disk_pct
    this.diskText = this.formatBytes(s.disk_used) + " of " + this.formatBytes(s.disk_total)
    this.diskDash = Math.min(226.2, Math.round(s.disk_pct * 2.262 * 10) / 10) + " 226.2"
    this.loadText = s.load.join("  ")
    this.uptimeText = this.formatUptime(s.uptime)
    this.lastChecked = new Date().toLocaleTimeString()

    const warn = []
    if s.cpu_pct >= 85 {
      warn.push("CPU is at " + s.cpu_pct + "%")
    }
    if s.mem_pct >= 90 {
      warn.push("memory is at " + s.mem_pct + "%")
    }
    if s.disk_pct >= 90 {
      warn.push("disk is at " + s.disk_pct + "%")
    }
    this.alertText = warn.join(" · ")

    this.statsError = ""
    this.hasStats = true
    this.status = "online"
  }

  applyStatsError(message) {
    if this.rebooting and Date.now() - this.rebootStartedAt < 180000 {
      this.status = "rebooting"
    } else {
      this.rebooting = false
      this.statsError = message or "Couldn't load stats."
      this.status = "offline"
    }
  }

  async loadStats() {
    if not this.server or this.statsBusy {
      return null
    }

    this.statsBusy = true
    const result = await useApi("/api/servers/" + this.server.id + "/stats")

    if result.ok {
      this.applyStats(result.data)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.applyStatsError(result.data?.error)
    }

    this.statsBusy = false
  }

  dropStream() {
    const ws = this.global("tylixStatsSocket")
    if ws {
      ws.onopen = null
      ws.onmessage = null
      ws.onclose = null
      ws.close()
      this.setGlobal("tylixStatsSocket", null)
    }
    this.streaming = false
    this.live = false
  }

  scheduleReconnect() {
    if this.reconnectTimer {
      return null
    }
    this.reconnectTimer = window.setTimeout(() => this.reconnectNow(), 4000)
  }

  async reconnectNow() {
    this.reconnectTimer = null
    if not this.server {
      return null
    }

    await this.loadStats()
    await this.openStream()
  }

  onStreamMessage(raw) {
    const msg = JSON.parse(raw)

    if msg.t is "ready" {
      this.live = true
    } else if msg.t is "stats" {
      this.applyStats(msg.d)
    } else if msg.t is "error" {
      this.applyStatsError(msg.m)
    }
  }

  onStreamClosed() {
    this.setGlobal("tylixStatsSocket", null)
    this.streaming = false
    this.live = false
    this.scheduleReconnect()
  }

  async openStream() {
    if not this.server or this.streaming {
      return null
    }

    this.streaming = true
    const result = await useApi("/api/servers/" + this.server.id + "/stats-ticket", { method: "POST" })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.status is 404 {
      this.streaming = false
      this.server = null
      this.notFound = true
      return null
    }

    if not result.ok {
      this.streaming = false
      this.scheduleReconnect()
      return null
    }

    let url = result.data.url
    if not url {
      const hostname = window.location.hostname
      if hostname is "localhost" or hostname is "127.0.0.1" {
        const port = this.global("__TYLIX_CHANNELS_PORT__") or 6001
        url = "ws://" + hostname + ":" + port + "/serverstats"
      } else {
        url = (window.location.protocol is "https:" ? "wss://" : "ws://") + window.location.host + "/channels/serverstats"
      }
    }

    const ticket = result.data.ticket
    const ws = new WebSocket(url)
    ws.onopen = () => ws.send(JSON.stringify({ t: "auth", ticket: ticket }))
    ws.onmessage = (e) => this.onStreamMessage(e.data)
    ws.onclose = () => this.onStreamClosed()
    this.setGlobal("tylixStatsSocket", ws)
  }

  async deleteServer() {
    if Billing.locked or not this.server or this.deleting {
      return null
    }

    const code = this.code.trim()
    this.error = ""
    this.codeError = ""

    if this.askCode and code is "" {
      this.codeError = "Enter a verification code to delete this server."
      return null
    }

    this.deleting = true

    // DELETE requests carry the second-factor code in the query string.
    let url = "/api/servers/" + this.server.id
    if code {
      url = url + "?code=" + encodeURIComponent(code)
    }

    const result = await useApi(url, { method: "DELETE" })

    if result.ok {
      this.dropStream()
      window.location.href = "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data?.two_factor_required {
      TwoFactor.apply(result.data.methods or [])
      this.askCode = true
      this.codeError = result.data.error or "Enter a verification code to continue."
      this.deleting = false
    } else if result.status is 422 and result.data?.errors?.code {
      this.askCode = true
      this.codeError = result.data.errors.code[0]
      this.deleting = false
    } else {
      this.error = result.data?.error or "Something went wrong deleting this server."
      this.deleting = false
      this.cancelDelete()
    }
  }

onMount
  async {
    this.dropStream()

    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    const provisionParam = params.get("provision")
    this.serverId = serverId or ""

    if provisionParam {
      // A server that is still being created: show its steps and percentage.
      this.provisioning = true
      this.loading = false

      await Provisioning.connect(Number(provisionParam))

      if Provisioning.missing {
        this.provisioning = false
        this.notFound = true
      }
    } else if not serverId {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        const sid = result.data.id
        this.server = result.data
        this.status = result.data.status
        this.sshCommand = this.buildSsh(result.data)
        this.loading = false

        await TwoFactor.load()

        const prov = await useApi("/api/provisions")
        if prov.ok and Array.isArray(prov.data) {
          const match = prov.data.find((p) => p.server_id is sid)
          if match {
            this.region = match.region
            this.plan = match.plan
          }
        }

        const siteRes = await useApi("/api/sites")
        if siteRes.ok and Array.isArray(siteRes.data) {
          const mine = siteRes.data.filter((x) => x.server_id is sid)
          this.sites = mine.map((x) => this.decorateSite(x))
        }

        await this.openStream()
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    {{#if serverId}}
    <ServerSidebar active="server" serverId="{{ serverId }}" />
{{/if}}
{{#if provisioning}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-12 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading server…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-900 dark:text-slate-100 font-medium mb-2">Server not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been deleted, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if provisioning}}
      <a href="/servers" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <div class="mb-6">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ Provisioning.name }}</h1>
{{#if Provisioning.failed}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
          </span>
{{/if}}
{{#if Provisioning.finished}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
          </span>
{{/if}}
{{#if not Provisioning.failed}}
{{#if not Provisioning.finished}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span> Setting up
          </span>
{{/if}}
{{/if}}
        </div>
{{#if Provisioning.ip}}
        <p class="text-slate-500 text-sm font-mono">{{ Provisioning.ip }}</p>
{{/if}}
{{#if not Provisioning.ip}}
        <p class="text-slate-500 text-sm">Creating your server. This page updates by itself.</p>
{{/if}}
      </div>

{{#if Provisioning.error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ Provisioning.error }}</p>
{{/if}}

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-2">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ Provisioning.headline }}</p>
          <p class="text-emerald-600 dark:text-emerald-400 text-xs font-mono tabular-nums shrink-0">{{ Provisioning.shown }}%</p>
        </div>

        <div class="flex items-center gap-[2px] mb-6">
{{#each seg in Provisioning.segments}}
{{#if seg.k is 0}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-slate-500/20"></span>
{{/if}}
{{#if seg.k is 1}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-emerald-500"></span>
{{/if}}
{{#if seg.k is 2}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-emerald-100"></span>
{{/if}}
{{#if seg.k is 3}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-emerald-200"></span>
{{/if}}
{{#if seg.k is 4}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-emerald-300"></span>
{{/if}}
{{#if seg.k is 5}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-emerald-400"></span>
{{/if}}
{{#if seg.k is 6}}
          <span class="flex-1 min-w-0 h-5 rounded-[2px] bg-rose-500"></span>
{{/if}}
{{/each}}
        </div>

{{#each s in Provisioning.steps}}
        <div class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 mb-2">
          <div class="flex items-center gap-3 min-w-0">
{{#if s.state is "done"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-emerald-500"></span>
{{/if}}
{{#if s.state is "running"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-sky-500 animate-pulse"></span>
{{/if}}
{{#if s.state is "failed"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-rose-500"></span>
{{/if}}
{{#if s.state is "pending"}}
            <span class="w-2 h-2 shrink-0 rounded-full bg-slate-500"></span>
            <p class="text-sm font-medium truncate text-slate-900 dark:text-slate-100 opacity-60">{{ s.label }}</p>
{{/if}}
{{#if s.state is not "pending"}}
            <p class="text-sm font-medium truncate text-slate-900 dark:text-slate-100">{{ s.label }}</p>
{{/if}}
          </div>
          <p class="text-slate-500 text-xs shrink-0">{{ s.stateText }}</p>
        </div>
{{/each}}
      </div>

{{#if Provisioning.finished}}
      <p role="status" class="text-emerald-700 dark:text-emerald-500 text-xs mb-6">Your server is ready. Opening it…</p>
{{/if}}
{{#if not Provisioning.finished}}
{{#if Provisioning.live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Live
      </p>
{{/if}}
{{#if not Provisioning.live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Reconnecting…
      </p>
{{/if}}
{{/if}}
{{/if}}

{{#if server}}
      <a href="/servers" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <LockedBanner />

      <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ server.name }}</h1>
{{#if status is "online"}}
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online
            </span>
{{/if}}
{{#if status is "pending"}}
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Not tested
            </span>
{{/if}}
{{#if status is "offline"}}
            <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Offline
            </span>
{{/if}}
{{#if status is "rebooting"}}
            <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span> Rebooting
            </span>
{{/if}}
          </div>
          <p class="text-slate-500 text-sm font-mono">{{ server.ssh_user }}@{{ server.host }}:{{ server.port }}</p>
        </div>
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="shrink-0 inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Edit
        </button>
{{/if}}
{{#if not Billing.locked}}
        <ServerForm server="{{ server }}" onSaved="{{ updated }}" />
{{/if}}
      </div>

{{#if rebooting}}
      <div role="status" class="rounded-xl border border-sky-300 dark:border-sky-900/50 bg-sky-50 dark:bg-sky-950/30 px-4 py-3 mb-4">
        <p class="text-sky-800 dark:text-sky-400 text-sm"><span class="font-semibold">Rebooting:</span> the server will be unreachable for a minute or so. This page will pick it up again automatically.</p>
      </div>
{{/if}}

{{#if alertText}}
      <div role="alert" class="rounded-xl border border-amber-300 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 mb-4">
        <p class="text-amber-800 dark:text-amber-400 text-sm"><span class="font-semibold">High usage:</span> {{ alertText }}</p>
      </div>
{{/if}}

{{#if statsError}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ statsError }}</p>
{{/if}}

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Uptime</p>
{{#if hasStats}}
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold">{{ uptimeText }}</p>
{{/if}}
{{#if not hasStats}}
          <p class="text-slate-400 text-lg font-semibold">—</p>
{{/if}}
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Load average</p>
{{#if hasStats}}
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold font-mono">{{ loadText }}</p>
{{/if}}
{{#if not hasStats}}
          <p class="text-slate-400 text-lg font-semibold">—</p>
{{/if}}
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Region</p>
{{#if region}}
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold font-mono">{{ region }}</p>
{{/if}}
{{#if not region}}
          <p class="text-slate-400 text-lg font-semibold">Custom</p>
{{/if}}
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Plan</p>
{{#if plan}}
          <p class="text-slate-900 dark:text-slate-100 text-lg font-semibold font-mono">{{ plan }}</p>
{{/if}}
{{#if not plan}}
          <p class="text-slate-400 text-lg font-semibold">—</p>
{{/if}}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-2">

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">CPU</p>
          </div>
{{#if hasStats}}
          <p class="text-3xl font-semibold text-slate-900 dark:text-slate-100">{{ cpuNow }}<span class="text-lg text-slate-500">%</span></p>
          <div class="h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 mt-3 overflow-hidden">
            <div class="h-full rounded-full transition-all" style="{{ cpuBar }}; background: {{ cpuColor }}"></div>
          </div>
          <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="w-full h-20 mt-3">
            <line x1="0" y1="40" x2="300" y2="40" stroke="#64748b" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
            <polygon points="{{ cpuArea }}" fill="{{ cpuColor }}" fill-opacity="0.15" />
            <polyline points="{{ cpuPoints }}" fill="none" stroke="{{ cpuColor }}" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-200/60 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Memory</p>
{{#if hasStats}}
            <p class="text-slate-500 text-xs font-mono">{{ memText }}</p>
{{/if}}
          </div>
{{#if hasStats}}
          <p class="text-3xl font-semibold text-slate-900 dark:text-slate-100">{{ memNow }}<span class="text-lg text-slate-500">%</span></p>
          <div class="h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 mt-3 overflow-hidden">
            <div class="h-full rounded-full transition-all" style="{{ memBar }}; background: {{ memColor }}"></div>
          </div>
          <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="w-full h-20 mt-3">
            <line x1="0" y1="40" x2="300" y2="40" stroke="#64748b" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
            <polygon points="{{ memArea }}" fill="{{ memColor }}" fill-opacity="0.15" />
            <polyline points="{{ memPoints }}" fill="none" stroke="{{ memColor }}" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-200/60 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Disk</p>
{{#if hasStats}}
            <p class="text-slate-500 text-xs font-mono">{{ diskText }}</p>
{{/if}}
          </div>
{{#if hasStats}}
          <div class="relative w-28 h-28 mx-auto mt-3">
            <svg viewBox="0 0 100 100" class="w-28 h-28">
              <circle cx="50" cy="50" r="36" fill="none" stroke="#64748b" stroke-opacity="0.2" stroke-width="10" />
              <circle cx="50" cy="50" r="36" fill="none" stroke="{{ diskColor }}" stroke-width="10" stroke-linecap="round" stroke-dasharray="{{ diskDash }}" transform="rotate(-90 50 50)" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-xl font-semibold text-slate-900 dark:text-slate-100">{{ diskPct }}%</span>
            </div>
          </div>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-200/60 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

      </div>

{{#if hasStats}}
{{#if live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Live · last update {{ lastChecked }}
      </p>
{{/if}}
{{#if not live}}
      <p class="flex items-center gap-1.5 text-slate-400 text-xs mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Reconnecting… · last checked {{ lastChecked }}
      </p>
{{/if}}
{{/if}}
{{#if not hasStats}}
      <div class="mb-6"></div>
{{/if}}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Connect</h2>
          <p class="text-slate-500 text-sm mb-4">Open a shell on this server from your machine.</p>
          <div class="flex items-center gap-2 rounded-xl bg-slate-950 px-4 py-3">
            <code class="flex-1 text-emerald-400 text-sm font-mono truncate">{{ sshCommand }}</code>
{{#if copied}}
            <button class="text-xs text-emerald-400 font-medium">Copied</button>
{{/if}}
{{#if not copied}}
            <button onclick="{{ copySsh() }}" class="text-xs text-slate-400 hover:text-white font-medium transition-colors">Copy</button>
{{/if}}
          </div>
          <div class="grid grid-cols-2 gap-4 mt-5">
            <div>
              <p class="text-slate-500 text-xs mb-1">Host</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono break-all">{{ server.host }}</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">SSH port</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono">{{ server.port }}</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">SSH user</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm font-mono">{{ server.ssh_user }}</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">SSH key</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm">Stored encrypted</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">Added</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm">{{ server.created_at.slice(0, 10) }}</p>
            </div>
            <div>
              <p class="text-slate-500 text-xs mb-1">Last updated</p>
              <p class="text-slate-900 dark:text-slate-100 text-sm">{{ server.updated_at.slice(0, 10) }}</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-1">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Sites</h2>
{{#if Billing.locked}}
            <span title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm text-slate-400 select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              New site
            </span>
{{/if}}
{{#if not Billing.locked}}
            <a href="{{ '/servers/site-create?id=' + serverId }}" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium">New site</a>
{{/if}}
          </div>
          <p class="text-slate-500 text-sm mb-4">Apps deployed on this server.</p>

{{#if sites.length is 0}}
          <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center">
            <p class="text-slate-500 text-sm mb-3">Nothing deployed here yet.</p>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Create a site
            </button>
{{/if}}
{{#if not Billing.locked}}
            <a href="{{ '/servers/site-create?id=' + serverId }}" class="inline-flex text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">
              Create a site
            </a>
{{/if}}
          </div>
{{/if}}

{{#each site in sites}}
          <a href="{{ site.href }}" class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 px-4 py-3 mb-2 hover:border-emerald-500/50 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ site.name }}</p>
              <p class="text-slate-500 text-xs font-mono truncate">{{ site.domain }}</p>
            </div>
            <span class="text-slate-400 text-sm">&rarr;</span>
          </a>
{{/each}}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Reboot server</h2>
        <p class="text-slate-500 text-sm mb-4">Restarts the machine over SSH. Sites and services on it will be offline for about a minute. The SSH user needs to be root or have passwordless sudo.</p>

{{#if rebootError}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ rebootError }}</p>
{{/if}}

{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Reboot server
        </button>
        <p class="text-slate-500 text-xs mt-2">View only. Pay to continue.</p>
{{/if}}

{{#if not Billing.locked}}
{{#if rebooting}}
        <button disabled class="text-sm text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-900/50 rounded-lg px-4 py-2 opacity-60">
          Rebooting…
        </button>
{{/if}}

{{#if not rebooting}}
{{#if not rebootConfirm}}
        <button onclick="{{ askReboot() }}" class="text-sm text-amber-700 dark:text-amber-500 border border-amber-200 dark:border-amber-900/50 rounded-lg px-4 py-2 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition">
          Reboot server
        </button>
{{/if}}

{{#if rebootConfirm}}
        <div class="flex items-center gap-3">
{{#if rebootBusy}}
          <button disabled class="text-sm text-white bg-amber-600 rounded-lg px-4 py-2 opacity-50">
            Sending…
          </button>
{{/if}}
{{#if not rebootBusy}}
          <button onclick="{{ rebootServer() }}" class="text-sm text-white bg-amber-600 hover:bg-amber-500 rounded-lg px-4 py-2 transition">
            Yes, reboot now
          </button>
          <button onclick="{{ cancelReboot() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
            Cancel
          </button>
{{/if}}
        </div>
{{/if}}
{{/if}}
{{/if}}
      </div>

      <div class="rounded-2xl border border-rose-200 dark:border-rose-900/30 bg-white dark:bg-slate-900 p-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-medium mb-1">Delete server</h2>
        <p class="text-slate-500 text-sm mb-4">This removes the server and its stored SSH key. Your machine itself is not touched.</p>

{{#if error}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-lg px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Delete server
        </button>
        <p class="text-slate-500 text-xs mt-2">View only. Pay to continue.</p>
{{/if}}

{{#if not Billing.locked}}
{{#if not confirmDelete}}
        <button onclick="{{ askDelete() }}" class="text-sm text-rose-600 dark:text-rose-500 hover:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-lg px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">
          Delete server
        </button>
{{/if}}

{{#if confirmDelete}}
{{#if askCode}}
        <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950/50 p-4 mb-4 max-w-sm">
          <label for="delete-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Verification code</label>
          <input
            id="delete-code"
            type="text"
            inputmode="text"
            autocomplete="one-time-code"
            maxlength="12"
            value="{{ code }}"
            oninput="{{ code = $event.target.value }}"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-center text-lg font-mono tracking-[0.3em] px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500"
          />
          <p class="text-slate-500 text-xs mt-2">{{ TwoFactor.totp ? "Enter a code from your authenticator app, or a recovery code." : "Enter the code texted to " + TwoFactor.smsHint + "." }}</p>
{{#if TwoFactor.notice}}
          <p role="status" class="text-emerald-700 dark:text-emerald-500 text-xs mt-2">{{ TwoFactor.notice }}</p>
{{/if}}
{{#if codeError}}
          <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if TwoFactor.sms}}
          <button disabled="{{ TwoFactor.sending }}" onclick="{{ sendCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-50">{{ TwoFactor.sending ? "Sending…" : "Text me a code" }}</button>
{{/if}}
        </div>
{{/if}}
        <div class="flex items-center gap-3">
{{#if deleting}}
          <button disabled class="text-sm text-white bg-rose-600 rounded-lg px-4 py-2 opacity-50">
            Deleting…
          </button>
{{/if}}
{{#if not deleting}}
          <button onclick="{{ deleteServer() }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-2 transition">
            Yes, delete it
          </button>
          <button onclick="{{ cancelDelete() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
            Cancel
          </button>
{{/if}}
        </div>
{{/if}}
{{/if}}
      </div>
{{/if}}

    </div>
    </div>
  </div>
 