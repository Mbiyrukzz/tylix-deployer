page ServerDetail

import { IconArrowLeft } from "tylix-icons"

title "Server"

state
  server: null
  serverId: ""
  status: ""
  region: ""
  plan: ""
  loading: true
  notFound: false
  confirmDelete: false
  deleting: false
  error: ""
  statsBusy: false
  statsError: ""
  hasStats: false
  cpuHistory: []
  memHistory: []
  cpuPoints: ""
  memPoints: ""
  cpuArea: ""
  memArea: ""
  cpuNow: 0
  memNow: 0
  memText: ""
  diskPct: 0
  diskText: ""
  diskDash: "0 226.2"
  loadText: ""
  uptimeText: ""

action
  updated(server) {
    this.server = server
    this.status = server.status
  }

  askDelete() {
    this.error = ""
    this.confirmDelete = true
  }

  cancelDelete() {
    this.confirmDelete = false
  }

  chartPoints(values) {
    const step = 300 / 29
    const offset = 29 - (values.length - 1)
    return values.map((v, i) => Math.round((offset + i) * step) + "," + Math.round(78 - v * 0.76)).join(" ")
  }

  chartArea(values) {
    const step = 300 / 29
    const x0 = Math.round((29 - (values.length - 1)) * step)
    return x0 + ",80 " + this.chartPoints(values) + " 300,80"
  }

  formatBytes(n) {
    if n >= 1073741824 {
      return (n / 1073741824).toFixed(1) + " GB"
    }
    return Math.round(n / 1048576) + " MB"
  }

  formatUptime(sec) {
    const days = Math.floor(sec / 86400)
    const hours = Math.floor((sec % 86400) / 3600)
    if days > 0 {
      return days + "d " + hours + "h"
    }
    return hours + "h " + Math.floor((sec % 3600) / 60) + "m"
  }

  async loadStats() {
    if not this.server or this.statsBusy {
      return null
    }

    this.statsBusy = true
    const result = await useApi("/api/servers/" + this.server.id + "/stats")

    if result.ok {
      const s = result.data
      const cpu = this.cpuHistory.concat([s.cpu_pct]).slice(-30)
      const mem = this.memHistory.concat([s.mem_pct]).slice(-30)

      this.cpuHistory = cpu
      this.memHistory = mem
      this.cpuPoints = this.chartPoints(cpu)
      this.memPoints = this.chartPoints(mem)
      this.cpuArea = this.chartArea(cpu)
      this.memArea = this.chartArea(mem)
      this.cpuNow = s.cpu_pct
      this.memNow = s.mem_pct
      this.memText = this.formatBytes(s.mem_used) + " of " + this.formatBytes(s.mem_total)
      this.diskPct = s.disk_pct
      this.diskText = this.formatBytes(s.disk_used) + " of " + this.formatBytes(s.disk_total)
      this.diskDash = Math.min(226.2, Math.round(s.disk_pct * 2.262 * 10) / 10) + " 226.2"
      this.loadText = s.load.join("  ")
      this.uptimeText = this.formatUptime(s.uptime)
      this.statsError = ""
      this.hasStats = true
      this.status = "online"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.statsError = result.data?.error or "Couldn't load stats."
      this.status = "offline"
    }

    this.statsBusy = false
  }

  async deleteServer() {
    if not this.server or this.deleting {
      return null
    }

    this.deleting = true
    this.error = ""

    const result = await useApi("/api/servers/" + this.server.id, { method: "DELETE" })

    if result.ok {
      window.location.href = "/servers"
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Something went wrong deleting this server."
      this.deleting = false
      this.confirmDelete = false
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        const sid = result.data.id
        this.server = result.data
        this.status = result.data.status
        this.loading = false

        const prov = await useApi("/api/provisions")
        if prov.ok and Array.isArray(prov.data) {
          const match = prov.data.find((p) => p.server_id is sid)
          if match {
            this.region = match.region
            this.plan = match.plan
          }
        }

        await this.loadStats()
        window.setInterval(() => this.loadStats(), 10000)
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_230px_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <ServerSidebar active="server" serverId="{{ serverId }}" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-12 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading server…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-2">Server not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been deleted, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if server}}
      <a href="/servers" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <div class="flex items-start justify-between gap-4 mb-8">
        <div class="min-w-0">
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate">{{ server.name }}</h1>
{{#if status is "online"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online
            </span>
{{/if}}
{{#if status is "pending"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Not tested
            </span>
{{/if}}
{{#if status is "offline"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Offline
            </span>
{{/if}}
          </div>
          <p class="text-slate-500 text-sm font-mono">
            {{ server.ssh_user }}@{{ server.host }}:{{ server.port }}
{{#if region}}
            / {{ region }} / {{ plan }}
{{/if}}
{{#if hasStats}}
            / up {{ uptimeText }}
{{/if}}
          </p>
        </div>
        <ServerForm server="{{ server }}" onSaved="{{ updated }}" />
      </div>

{{#if statsError}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ statsError }}</p>
{{/if}}

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

        <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">CPU</p>
{{#if hasStats}}
            <p class="text-slate-500 text-xs font-mono">load {{ loadText }}</p>
{{/if}}
          </div>
{{#if hasStats}}
          <p class="text-3xl font-semibold text-slate-800 dark:text-slate-200">{{ cpuNow }}<span class="text-lg text-slate-500">%</span></p>
          <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="w-full h-20 mt-3">
            <line x1="0" y1="40" x2="300" y2="40" stroke="#64748b" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
            <polygon points="{{ cpuArea }}" fill="#10b981" fill-opacity="0.15" />
            <polyline points="{{ cpuPoints }}" fill="none" stroke="#10b981" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-300/40 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

        <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Memory</p>
{{#if hasStats}}
            <p class="text-slate-500 text-xs font-mono">{{ memText }}</p>
{{/if}}
          </div>
{{#if hasStats}}
          <p class="text-3xl font-semibold text-slate-800 dark:text-slate-200">{{ memNow }}<span class="text-lg text-slate-500">%</span></p>
          <svg viewBox="0 0 300 80" preserveAspectRatio="none" class="w-full h-20 mt-3">
            <line x1="0" y1="40" x2="300" y2="40" stroke="#64748b" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
            <polygon points="{{ memArea }}" fill="#38bdf8" fill-opacity="0.15" />
            <polyline points="{{ memPoints }}" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-300/40 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

        <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Disk</p>
{{#if hasStats}}
            <p class="text-slate-500 text-xs font-mono">{{ diskText }}</p>
{{/if}}
          </div>
{{#if hasStats}}
          <div class="relative w-28 h-28 mx-auto mt-1">
            <svg viewBox="0 0 100 100" class="w-28 h-28">
              <circle cx="50" cy="50" r="36" fill="none" stroke="#64748b" stroke-opacity="0.2" stroke-width="10" />
              <circle cx="50" cy="50" r="36" fill="none" stroke="#10b981" stroke-width="10" stroke-linecap="round" stroke-dasharray="{{ diskDash }}" transform="rotate(-90 50 50)" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-xl font-semibold text-slate-800 dark:text-slate-200">{{ diskPct }}%</span>
            </div>
          </div>
{{/if}}
{{#if not hasStats}}
          <div class="h-28 rounded-lg bg-slate-300/40 dark:bg-slate-950/60 animate-pulse"></div>
{{/if}}
        </div>

      </div>

      <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-5">Details</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div>
            <p class="text-slate-500 text-xs mb-1">Host</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ server.host }}</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">SSH port</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ server.port }}</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">SSH user</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ server.ssh_user }}</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">SSH key</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm">Stored encrypted</p>
          </div>
{{#if region}}
          <div>
            <p class="text-slate-500 text-xs mb-1">Region</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ region }}</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">Plan</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ plan }}</p>
          </div>
{{/if}}
          <div>
            <p class="text-slate-500 text-xs mb-1">Added</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm">{{ server.created_at.slice(0, 10) }}</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">Last updated</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm">{{ server.updated_at.slice(0, 10) }}</p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-rose-900/30 bg-slate-200 dark:bg-slate-900 p-6">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Delete server</h2>
        <p class="text-slate-500 text-sm mb-4">This removes the server and its stored SSH key. Your machine itself is not touched.</p>

{{#if error}}
        <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

{{#if not confirmDelete}}
        <button onclick="{{ askDelete() }}" class="text-sm text-rose-500 hover:text-rose-400 border border-rose-900/50 rounded-lg px-4 py-2 hover:bg-rose-950/30 transition">
          Delete server
        </button>
{{/if}}

{{#if confirmDelete}}
        <div class="flex items-center gap-3">
{{#if deleting}}
          <button disabled class="text-sm text-white bg-rose-600 rounded-lg px-4 py-2 opacity-50">
            Deleting…
          </button>
{{/if}}
{{#if not deleting}}
          <button onclick="{{ deleteServer() }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-2 transition">
            Yes, delete it
          </button>
          <button onclick="{{ cancelDelete() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
            Cancel
          </button>
{{/if}}
        </div>
{{/if}}
      </div>
{{/if}}

    </div>
    </div>
  </div>
