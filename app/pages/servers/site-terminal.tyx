page SiteTerminal

import { IconExternalLink } from "tylix-icons"

title "Terminal"

needs
  Auth

uses
  Billing

background
  Billing

// The terminal itself is the ConsoleDock (app/pages/components), which pops
// over any page. Arriving here opens it; this page is what's behind it.

state
  siteId: ""
  serverId: ""
  site: null
  siteUrl: ""
  loading: true
  isMissing: false
  commands: [
    { label: "List files", cmd: "ls -la" },
    { label: "Git status", cmd: "git status" },
    { label: "Recent commits", cmd: "git log --oneline -n 10" },
    { label: "Folder sizes", cmd: "du -sh * 2>/dev/null | sort -h" },
    { label: "Disk space", cmd: "df -h ." },
    { label: "Node version", cmd: "node -v && npm -v" },
    { label: "PHP version", cmd: "php -v" }
  ]

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        const secure = result.data.ssl_mode is "letsencrypt" or result.data.ssl_mode is "custom"
        this.site = result.data
        this.serverId = "" + result.data.server_id
        this.siteUrl = (secure ? "https://" : "http://") + result.data.domain
        this.loading = false
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="terminal" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading terminal…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Terminal" description="A shell inside this site's folder, in a console that opens over the page." domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}">
        <div slot="actions" class="flex items-center gap-2 shrink-0">
          <a href="{{ siteUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconExternalLink class="w-4 h-4" /> Visit site
          </a>
        </div>
      </SiteHeader>

      <LockedBanner />

{{#if site.status is "ready"}}
      <ConsoleLauncher href="{{ '/servers/site-terminal?id=' + siteId }}" kind="terminal" heading="{{ 'Open a shell for ' + site.domain }}" body="{{ 'You start in /home/' + site.isolated_user + '/' + site.domain + ' as ' + site.isolated_user + '. Minimise the console and it keeps running while you deploy, edit settings or read logs.' }}" host="{{ site.isolated_user + '@' + site.domain }}" cmd="git status" label="Open terminal" locked="{{ Billing.locked }}" />

      <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 mt-6 shadow-sm dark:shadow-none">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-1.5 h-5 shrink-0 rounded-full bg-brand-500"></span>
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Quick commands</h2>
          <p class="text-slate-500 text-xs ml-auto">One click from the console's side panel</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2">
{{#each c in commands}}
          <div class="rounded-xl border border-line bg-sunken px-3.5 py-2.5">
            <p class="text-sm font-medium text-slate-900 dark:text-slate-100">{{ c.label }}</p>
            <p class="text-xs font-mono text-slate-500 truncate">{{ c.cmd }}</p>
          </div>
{{/each}}
        </div>
      </section>
{{#else}}
      <section class="rounded-2xl border border-line bg-panel p-6 text-center shadow-sm dark:shadow-none">
        <p class="text-slate-500 text-sm">The terminal opens once the site has finished creating.</p>
      </section>
{{/if}}
{{/if}}

    </div>
    </div>
  </div>
