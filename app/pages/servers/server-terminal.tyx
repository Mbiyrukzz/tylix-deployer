page ServerTerminal

import { IconArrowLeft, IconServer } from "tylix-icons"

title "Server terminal"

needs
  Auth

uses
  Servers
  Billing

background
  Billing

// The terminal itself is the ConsoleDock (app/pages/components), which pops
// over any page. Arriving here opens it; this page is what's behind it: the
// server it opened on, and every other server to open one on.

state
  loading: true
  serverId: ""
  server: null
  tiles: []

action
  dotClass(status) {
    if status is "online" {
      return "w-2 h-2 shrink-0 rounded-full bg-emerald-500"
    }
    if status is "offline" {
      return "w-2 h-2 shrink-0 rounded-full bg-rose-500"
    }
    return "w-2 h-2 shrink-0 rounded-full bg-amber-500"
  }

  buildTiles() {
    const on = "group flex items-center gap-3 rounded-2xl border border-brand-500/50 bg-brand-500/[0.06] px-4 py-3 shadow-sm dark:shadow-none transition-colors"
    const off = "group flex items-center gap-3 rounded-2xl border border-line bg-panel px-4 py-3 shadow-sm dark:shadow-none hover:border-brand-500/40 transition-colors"
    this.tiles = Servers.data.map((s) => ({
      id: s.id,
      name: s.name,
      host: (s.ssh_user or "root") + "@" + s.host,
      dot: this.dotClass(s.status),
      href: "/servers/server-terminal?id=" + s.id,
      cls: ("" + s.id) is this.serverId ? on : off
    }))
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const params = new URLSearchParams(window.location.search)
    this.serverId = params.get("id") or ""

    await Servers.load()
    if this.serverId {
      this.server = Servers.data.find((s) => ("" + s.id) is this.serverId) or null
    }
    this.buildTiles()
    this.loading = false
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
    <ServerSidebar active="terminal" serverId="{{ serverId }}" />
{{#else}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>
{{#else}}
      <a href="/servers" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>
{{/if}}

      <LockedBanner />

      <div class="mb-6">
        <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Terminal</h1>
        <p class="text-slate-500 text-sm">A shell on your server, in a console that opens over the page. Minimise it and it keeps running while you work elsewhere in the app.</p>
      </div>

{{#if loading}}
      <div data-page-loader="true" class="min-h-[40vh] flex items-center justify-center">
        <LoaderMark label="Loading servers…" />
      </div>
{{/if}}

{{#if not loading}}
{{#if server}}
      <div class="mb-8">
        <ConsoleLauncher href="{{ '/servers/server-terminal?id=' + serverId }}" kind="terminal" heading="{{ 'Open a shell on ' + server.name }}" body="{{ 'You connect as ' + (server.ssh_user or 'root') + '. Sessions close after 15 minutes without typing, and you can switch servers from the console header.' }}" host="{{ (server.ssh_user or 'root') + '@' + server.host }}" cmd="uptime" label="Open terminal" locked="{{ Billing.locked }}" />
      </div>
{{/if}}

{{#if tiles.length is 0}}
      <div class="rounded-2xl border border-dashed border-line-strong bg-panel p-8 text-center">
        <p class="text-slate-500 text-sm mb-3">No servers yet. Add one to open a terminal on it.</p>
        <a href="/servers" class="inline-flex text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-brand-400 transition-all">Add a server</a>
      </div>
{{#else}}
      <div class="flex items-center gap-3 mb-3">
        <span class="w-1.5 h-5 shrink-0 rounded-full bg-brand-500"></span>
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold">{{ server ? "Or open one on another server" : "Choose a server" }}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
{{#each t in tiles}}
        <a href="{{ t.href }}" class="{{ t.cls }}">
          <span class="w-9 h-9 shrink-0 rounded-xl border border-line bg-sunken flex items-center justify-center text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
            <IconServer class="w-4 h-4" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-slate-900 dark:text-slate-100 truncate">{{ t.name }}</span>
            <span class="block text-xs font-mono text-slate-500 truncate">{{ t.host }}</span>
          </span>
          <span class="{{ t.dot }}"></span>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

    </div>
    </div>
  </div>
