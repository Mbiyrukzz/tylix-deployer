page ServerTerminal

import { IconArrowLeft } from "tylix-icons"

title "Server terminal"

needs
  Auth

uses
  Servers

state
  checkedAuth: false
  serverId: ""
  server: null
  chips: []
  phase: "idle"
  error: ""

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  loadScript(src, done) {
    const el = document.createElement("script")
    el.src = src
    el.onload = () => done(true)
    el.onerror = () => done(false)
    document.head.appendChild(el)
  }

  loadAsync(src) {
    return new Promise((resolve) => this.loadScript(src, resolve))
  }

  async ensureXterm() {
    if this.global("Terminal") and this.global("FitAddon") {
      return true
    }

    const css = document.createElement("link")
    css.rel = "stylesheet"
    css.href = "https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css"
    document.head.appendChild(css)

    const core = await this.loadAsync("https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js")
    const fit = await this.loadAsync("https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js")

    if core and fit {
      return true
    }

    this.error = "Couldn't load the terminal library. Check your internet connection."
    return false
  }

  buildChips() {
    const activeCls = "inline-flex items-center gap-2 rounded-full bg-emerald-500 text-white dark:text-slate-950 text-sm font-semibold px-4 py-1.5 shadow-sm transition-all"
    const idleCls = "inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-300 text-sm font-medium px-4 py-1.5 hover:border-emerald-500/50 transition-all"

    this.chips = Servers.data.map((s) => ({
      id: s.id,
      name: s.name,
      cls: ("" + s.id) is this.serverId ? activeCls : idleCls
    }))
  }

  dropSocket() {
    const ws = this.global("tylixSocket")
    if ws {
      ws.onopen = null
      ws.onmessage = null
      ws.onclose = null
      ws.close()
      this.setGlobal("tylixSocket", null)
    }
  }

  clearTerminal() {
    const term = this.global("tylixTerm")
    if term {
      term.dispose()
      this.setGlobal("tylixTerm", null)
    }
    const host = document.getElementById("terminal-host")
    if host {
      host.innerHTML = ""
    }
  }

  pick(id) {
    this.dropSocket()
    this.clearTerminal()

    this.error = ""
    this.phase = "idle"
    this.serverId = "" + id
    this.server = Servers.data.find((s) => s.id is id) or null
    this.buildChips()

    window.history.replaceState(null, "", "?id=" + id)
  }

  sendInput(d) {
    const ws = this.global("tylixSocket")
    if ws and ws.readyState is 1 {
      ws.send(JSON.stringify({ t: "i", d: d }))
    }
  }

  onMessage(raw) {
    const msg = JSON.parse(raw)
    const term = this.global("tylixTerm")
    if not term {
      return null
    }

    if msg.t is "out" {
      term.write(Uint8Array.from(atob(msg.d), (c) => c.charCodeAt(0)))
    } else if msg.t is "ready" {
      this.phase = "connected"
      term.focus()
    } else if msg.t is "exit" {
      term.write("\r\n[" + msg.m + "]\r\n")
    }
  }

  onClosed() {
    this.phase = "closed"
  }

  async connect() {
    if not this.server {
      return null
    }

    if this.phase is "connecting" or this.phase is "connected" {
      return null
    }

    this.error = ""
    this.phase = "connecting"

    const ready = await this.ensureXterm()
    if not ready {
      this.phase = "idle"
      return null
    }

    this.dropSocket()
    this.clearTerminal()

    const host = document.getElementById("terminal-host")
    if not host {
      this.error = "The terminal area isn't on the page yet. Reload and try again."
      this.phase = "idle"
      return null
    }

    const TerminalClass = this.global("Terminal")
    const fitModule = this.global("FitAddon")

    const term = new TerminalClass({
      cursorBlink: true,
      fontSize: 13,
      fontFamily: "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      theme: { background: "#020617" }
    })
    const fit = new fitModule.FitAddon()
    term.loadAddon(fit)
    term.open(host)
    fit.fit()
    this.setGlobal("tylixTerm", term)

    const result = await useApi("/api/servers/" + this.serverId + "/terminal", {
      method: "POST",
      body: { cols: term.cols, rows: term.rows }
    })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if not result.ok {
      this.error = result.data?.error or "Couldn't open a terminal."
      this.phase = "idle"
      return null
    }

       let url = result.data.url
    if not url {
      const host = window.location.hostname
      if host is "localhost" or host is "127.0.0.1" {
        const port = this.global("__TYLIX_CHANNELS_PORT__") or 6001
        url = "ws://" + host + ":" + port + "/terminal"
      } else {
        url = (window.location.protocol is "https:" ? "wss://" : "ws://") + window.location.host + "/channels/terminal"
      }
    }

    const ticket = result.data.ticket
    const ws = new WebSocket(url)
    ws.onopen = () => ws.send(JSON.stringify({ t: "auth", ticket: ticket }))
    ws.onmessage = (e) => this.onMessage(e.data)
    ws.onclose = () => this.onClosed()
    this.setGlobal("tylixSocket", ws)

    term.onData((d) => this.sendInput(d))
  }

  disconnect() {
    const ws = this.global("tylixSocket")
    if ws {
      ws.close()
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    await Servers.load()

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")

    if id {
      this.serverId = id
      this.server = Servers.data.find((s) => ("" + s.id) is id) or null
    }

    this.buildChips()
    this.checkedAuth = true
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_230px_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <ServerSidebar active="terminal" serverId="{{ serverId }}" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-10">

      <a href="/servers" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Servers
      </a>

      <div class="mb-6">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate">Terminal</h1>
{{#if phase is "connecting"}}
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Connecting
          </span>
{{/if}}
{{#if phase is "connected"}}
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Connected
          </span>
{{/if}}
{{#if phase is "closed"}}
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Closed</span>
{{/if}}
        </div>
        <p class="text-slate-500 text-sm">Pick a server, then connect. Switching servers closes the current session.</p>
      </div>

{{#if chips.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center mb-6">
        <p class="text-slate-500 text-sm">No servers yet. Add one from the Servers page first.</p>
      </div>
{{/if}}

      <div class="flex flex-wrap items-center gap-2 mb-6">
{{#each c in chips}}
        <button onclick="{{ pick(c.id) }}" class="{{ c.cls }}">{{ c.name }}</button>
{{/each}}
      </div>

{{#if error}}
      <div role="alert" class="rounded-2xl border border-rose-500/30 bg-rose-500/5 p-5 mb-6">
        <p class="text-rose-500 text-sm break-words">{{ error }}</p>
      </div>
{{/if}}

      <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
          <h2 class="text-slate-800 dark:text-slate-200 font-medium">Web terminal</h2>
          <div class="flex items-center gap-3">
{{#if not server}}
            <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">Connect</button>
{{/if}}
{{#if server}}
{{#if phase is "connecting"}}
            <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 opacity-50">Connecting…</button>
{{/if}}
{{#if phase is "connected"}}
            <button onclick="{{ disconnect() }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-2 hover:bg-rose-500/5 transition-colors">Disconnect</button>
{{/if}}
{{#if phase is "idle"}}
            <button onclick="{{ connect() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 transition-all">Connect</button>
{{/if}}
{{#if phase is "closed"}}
            <button onclick="{{ connect() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 transition-all">Reconnect</button>
{{/if}}
{{/if}}
          </div>
        </div>

{{#if server}}
        <p class="text-slate-500 text-xs mb-4">A shell as <span class="font-mono">{{ server.ssh_user }}</span> on <span class="font-mono">{{ server.name }}</span> (<span class="font-mono">{{ server.host }}</span>). Sessions close after 15 minutes without typing. The terminal size is set when you connect.</p>
{{/if}}
{{#if not server}}
        <p class="text-slate-500 text-xs mb-4">Choose a server above to open a shell on it.</p>
{{/if}}

        <div id="terminal-host" class="h-[480px] w-full overflow-hidden rounded-xl bg-slate-950 p-2"></div>
      </div>

    </div>
    </div>
  </div>
{{/if}}