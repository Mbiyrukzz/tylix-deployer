page ServerCronJobs

import { IconArrowLeft, IconClock, IconDocumentText, IconPlay, IconLockClosed } from "tylix-icons"

title "Cron jobs"

needs
  Auth

uses
  Billing

background
  Billing

state
  server: null
  serverId: ""
  loading: true
  isMissing: false
  busy: false
  error: ""
  jobs: []
  users: []
  usersError: ""
  busyId: null
  confirmId: null
  logId: null
  logJob: null
  logInfo: null
  logNow: 0
  logText: ""
  logLines: []
  logShown: []
  logTabs: []
  logFilter: "all"
  logErrors: 0
  logWarns: 0
  logLoading: false
  logError: ""
  logLive: true
  logTimer: 0
  logFetching: false
  logAtBottom: true
  logCopied: false
  runBusy: false
  runOutput: ""
  runCode: null

action
  fail(result, fallback) {
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    this.error = result.data?.error or fallback
  }

  fieldValue(id) {
    const el = document.getElementById(id)
    if not el {
      return ""
    }
    return String(Reflect.get(el, "value") or "")
  }

  setField(id, value) {
    const el = document.getElementById(id)
    if el {
      Reflect.set(el, "value", value)
    }
  }

  schedulePreset(value) {
    this.setField("cSchedule", value)
  }

  preset(kind) {
    if kind is "laravel" {
      this.setField("cName", "Laravel scheduler")
      this.setField("cSchedule", "* * * * *")
      this.setField("cCommand", "cd /home/tylix/example.com/current && php artisan schedule:run")
    }
  }

  async loadJobs() {
    const r = await useApi("/api/servers/" + this.serverId + "/cron-jobs")
    if r.ok and Array.isArray(r.data) {
      this.jobs = r.data
    }
  }

  async loadUsers() {
    const r = await useApi("/api/servers/" + this.serverId + "/ssh-users")
    if r.ok and Array.isArray(r.data) {
      this.users = r.data
      this.usersError = ""
    } else {
      this.users = [this.server.ssh_user]
      this.usersError = r.data?.error or "Couldn't list users on the server."
    }
  }

  async create() {
    if Billing.locked {
      return null
    }
    if this.busy {
      return null
    }
    this.busy = true
    this.error = ""

    const body = {
      name: this.fieldValue("cName"),
      command: this.fieldValue("cCommand"),
      schedule: this.fieldValue("cSchedule"),
      user: this.fieldValue("cUser")
    }

    const result = await useApi("/api/servers/" + this.serverId + "/cron-jobs", { method: "POST", body: body })

    if result.ok {
      this.setField("cName", "")
      this.setField("cCommand", "")
      await this.loadJobs()
    } else {
      this.fail(result, "Couldn't create the cron job.")
    }
    this.busy = false
  }

  // ---- log console --------------------------------------------------------

  // Colours one log line: errors, warnings and "done" lines stand out, and a
  // leading [timestamp] is greyed. Same rules as the worker log.
  classify(line, n) {
    const t = line.trim()

    let body = t
    let ts = ""
    if t.startsWith("[") {
      const close = t.indexOf("]")
      if close > 1 and close < 32 {
        const inner = t.slice(1, close)
        const looksLikeTime = "0123456789".includes(inner.charAt(0)) and (inner.includes(":") or inner.includes("-"))
        if looksLikeTime {
          ts = t.slice(0, close + 1)
          body = t.slice(close + 1).trim()
        }
      }
    }

    const lower = body.toLowerCase()
    const quiet = lower.includes("0 error") or lower.includes("no error") or lower.includes("without error")
    const isErr = (lower.startsWith("failed") or lower.includes(" fail") or lower.includes("error") or lower.includes("fatal") or lower.includes("exception") or lower.includes("uncaught") or lower.startsWith("at ")) and not quiet
    const isWarn = lower.includes("warning") or lower.includes("warn ") or lower.includes("deprecat") or lower.includes("retry") or lower.includes("timed out")
    const isOk = lower.includes(" done") or lower.startsWith("done") or lower.includes("success") or lower.includes("processed") or lower.includes("finished") or lower.includes("completed")
    const isRun = lower.includes("running") or lower.includes("processing")

    let kind = "text"
    let cls = "text-slate-300"
    let rowCls = "border-transparent"
    let icon = ""

    if isErr {
      kind = "error"
      cls = "text-rose-300"
      rowCls = "border-rose-500 bg-rose-500/10"
      icon = "✕"
    } else if isWarn {
      kind = "warn"
      cls = "text-amber-300"
      rowCls = "border-amber-500/60"
      icon = "!"
    } else if isOk {
      kind = "ok"
      cls = "text-brand-400"
      icon = "✓"
    } else if isRun {
      kind = "run"
      cls = "text-sky-300"
      icon = "›"
    }

    return { n: n, kind: kind, text: ts is "" ? (line is "" ? " " : line) : body, ts: ts, cls: cls, rowCls: rowCls, icon: icon }
  }

  parseLog(raw) {
    if not raw {
      return []
    }
    const nl = String.fromCharCode(10)
    const cr = String.fromCharCode(13)
    return raw.split(cr + nl).join(nl).split(cr).join(nl).split(nl).map((line, i) => this.classify(line, i + 1))
  }

  applyLogFilter() {
    const f = this.logFilter
    this.logShown = f is "all" ? this.logLines : this.logLines.filter((l) => l.kind is f)
    this.logTabs = [
      { key: "all", label: "All", count: this.logLines.length },
      { key: "error", label: "Errors", count: this.logErrors },
      { key: "warn", label: "Warnings", count: this.logWarns },
      { key: "ok", label: "Done", count: this.logLines.filter((l) => l.kind is "ok").length }
    ]
  }

  setLogFilter(key) {
    this.logFilter = key
    this.applyLogFilter()
    window.setTimeout(() => this.scrollLogEnd(), 40)
  }

  scrollLogEnd() {
    const el = document.getElementById("cron-log-scroll")
    if el {
      el.scrollTop = el.scrollHeight
    }
  }

  onLogScroll() {
    if not this.logId {
      return null
    }
    const el = document.getElementById("cron-log-scroll")
    if el {
      this.logAtBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 48
    }
  }

  jumpLogBottom() {
    this.scrollLogEnd()
    this.logAtBottom = true
  }

  // One read at a time; a reply for a job that is no longer open is dropped.
  async fetchLog() {
    const id = this.logId
    if not id or this.logFetching {
      return null
    }
    this.logFetching = true
    const result = await useApi("/api/servers/" + this.serverId + "/cron-jobs/" + id + "/log?lines=500")
    this.logFetching = false
    if this.logId is not id {
      return null
    }
    this.logLoading = false
    this.logNow = Date.now()

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    if not result.ok {
      this.logError = result.data?.error or "Couldn't read the log. Retrying…"
      return null
    }

    this.logError = ""
    const data = result.data
    this.logInfo = {
      server_time: data.server_time,
      timezone: data.timezone,
      last_output_at: data.last_output_at,
      size: data.size,
      cron: data.cron,
      schedule: data.schedule
    }

    const raw = String(data.log or "")
    if raw is this.logText and this.logLines.length > 0 {
      return null
    }
    this.logText = raw
    this.logLines = this.parseLog(raw)
    this.logErrors = this.logLines.filter((l) => l.kind is "error").length
    this.logWarns = this.logLines.filter((l) => l.kind is "warn").length
    this.applyLogFilter()
    if this.logAtBottom {
      window.setTimeout(() => this.scrollLogEnd(), 40)
    }
  }

  startLogTimer() {
    window.clearInterval(this.logTimer)
    this.logTimer = window.setInterval(() => this.fetchLog(), 5000)
  }

  toggleLogLive() {
    this.logLive = not this.logLive
    if this.logLive {
      this.logAtBottom = true
      this.fetchLog()
      this.startLogTimer()
    } else {
      window.clearInterval(this.logTimer)
      // Keep "in 4 min" honest while paused.
      this.logTimer = window.setInterval(() => this.tickNow(), 15000)
    }
  }

  tickNow() {
    this.logNow = Date.now()
  }

  async viewLog(id) {
    const job = this.jobs.find((x) => x.id is id)
    if not job {
      return null
    }
    this.logId = id
    this.logJob = job
    this.logInfo = null
    this.logNow = Date.now()
    this.logText = ""
    this.logLines = []
    this.logFilter = "all"
    this.logErrors = 0
    this.logWarns = 0
    this.logError = ""
    this.logLoading = true
    this.logLive = true
    this.logAtBottom = true
    this.logCopied = false
    this.runOutput = ""
    this.runCode = null
    this.applyLogFilter()

    const flux = Reflect.get(window, "__flux")
    if flux {
      // Leaving the page with the log open must stop the polling and give
      // the next page its scrolling back.
      flux.on(window, "flux:navigated", () => this.closeLog(), { once: true })
    }
    document.body.style.overflow = "hidden"

    this.startLogTimer()
    await this.fetchLog()
  }

  closeLog() {
    window.clearInterval(this.logTimer)
    this.logId = null
    this.logJob = null
    this.logInfo = null
    document.body.style.overflow = ""
  }

  clearLogCopied() {
    this.logCopied = false
  }

  async copyLog() {
    try {
      await navigator.clipboard.writeText(this.logText)
      this.logCopied = true
      window.setTimeout(() => this.clearLogCopied(), 1800)
    } catch (err) {
      this.logError = "Couldn't copy: the browser blocked the clipboard."
    }
  }

  // Runs the command once (its output isn't added to the job's log, so the
  // console shows it on its own above the log).
  async runFromLog() {
    const id = this.logId
    if Billing.locked or not id or this.runBusy {
      return null
    }
    this.runBusy = true
    this.runOutput = ""
    this.runCode = null

    const result = await useApi("/api/servers/" + this.serverId + "/cron-jobs/" + id + "/run", { method: "POST" })
    this.runBusy = false
    if this.logId is not id {
      return null
    }
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      const nl = String.fromCharCode(10)
      const lines = String(result.data.output or "").split(nl)
      const last = lines.length > 0 ? lines[lines.length - 1] : ""
      const marker = "--- exit code "
      if last.startsWith(marker) {
        this.runCode = Number(last.slice(marker.length))
        lines.pop()
      }
      this.runOutput = lines.join(nl).trim() or "No output."
    } else {
      this.runCode = 1
      this.runOutput = result.data?.error or "Couldn't run the command."
    }
  }

  clearRun() {
    this.runOutput = ""
    this.runCode = null
  }

  async runNow(id) {
    if Billing.locked or this.runBusy {
      return null
    }
    await this.viewLog(id)
    await this.runFromLog()
  }

  onKey(e) {
    if e.key is "Escape" and this.logId {
      this.closeLog()
    }
  }

  askRemove(id) {
    if Billing.locked {
      return null
    }
    this.confirmId = id
  }

  cancelRemove() {
    this.confirmId = null
  }

  async remove(id) {
    if Billing.locked {
      return null
    }
    if this.busyId {
      return null
    }
    this.busyId = id
    this.error = ""
    const result = await useApi("/api/servers/" + this.serverId + "/cron-jobs/" + id, { method: "DELETE" })

    if result.ok {
      this.confirmId = null
      if this.logId is id {
        this.closeLog()
      }
      await this.loadJobs()
    } else {
      this.fail(result, "Couldn't remove the cron job.")
    }
    this.busyId = null
  }

onMount
  async {
    window.addEventListener("keydown", (e) => this.onKey(e))
    window.addEventListener("scroll", () => this.onLogScroll(), true)
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.server = result.data
        this.loading = false
        await this.loadJobs()
        await this.loadUsers()
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="cron" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-6 sm:py-10">

{{#if loading}}
      <LoaderMark label="Loading…" />
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>

      <LockedBanner />

      <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Cron jobs</h1>
      <p class="text-slate-500 text-sm mb-6">Commands that run on a schedule. Each job's output is appended to its own log on the server. Open a job to see its log and when it runs next.</p>

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

      <div class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">New cron job</h2>

        <p class="text-slate-500 text-xs mb-2">Start from a preset</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <button onclick="{{ preset('laravel') }}" class="text-sm rounded-lg border border-slate-300 dark:border-slate-700 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:border-brand-500/50">Laravel scheduler</button>
        </div>

        <label class="block text-slate-500 text-xs mb-1" for="cName">Name</label>
        <input id="cName" type="text" placeholder="e.g. Nightly cleanup" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3 py-2 mb-4" />

        <label class="block text-slate-500 text-xs mb-1" for="cCommand">Command</label>
        <input id="cCommand" type="text" placeholder="cd /home/tylix/example.com/current &amp;&amp; php artisan schedule:run" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 mb-1" />
        <p class="text-slate-400 text-xs mb-4">Cron has no working directory. Start with <span class="font-mono">cd /path &amp;&amp;</span> when the command needs one.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="cSchedule">Schedule</label>
            <input id="cSchedule" type="text" value="* * * * *" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 mb-2" />
            <div class="flex flex-wrap gap-1.5">
              <button onclick="{{ schedulePreset('* * * * *') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Every minute</button>
              <button onclick="{{ schedulePreset('*/5 * * * *') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Every 5 min</button>
              <button onclick="{{ schedulePreset('0 * * * *') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Hourly</button>
              <button onclick="{{ schedulePreset('0 0 * * *') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Nightly</button>
              <button onclick="{{ schedulePreset('0 0 * * 0') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Weekly</button>
              <button onclick="{{ schedulePreset('0 0 1 * *') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">Monthly</button>
              <button onclick="{{ schedulePreset('@reboot') }}" class="text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-2 py-1 text-slate-600 dark:text-slate-300 hover:border-brand-500/50">On reboot</button>
            </div>
          </div>
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="cUser">Run as user</label>
            <select id="cUser" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2">
{{#each u in users}}
              <option value="{{ u }}">{{ u }}</option>
{{/each}}
            </select>
{{#if usersError}}
            <p class="text-amber-600 dark:text-amber-500 text-xs mt-1">{{ usersError }}</p>
{{/if}}
          </div>
        </div>

        <div class="mt-5">
{{#if busy}}
          <button disabled class="text-sm bg-brand-500 text-white font-semibold rounded-xl px-4 py-2 opacity-50">Creating…</button>
{{/if}}
{{#if not busy}}
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            Create cron job
          </button>
{{/if}}
{{#if not Billing.locked}}
          <button onclick="{{ create() }}" class="text-sm bg-brand-500 text-white font-semibold rounded-xl px-4 py-2 hover:bg-brand-400 transition-all">Create cron job</button>
{{/if}}
{{/if}}
        </div>
      </div>

      <div class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Active cron jobs</h2>

{{#if jobs.length is 0}}
        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center">
          <p class="text-slate-500 text-sm">No cron jobs yet.</p>
        </div>
{{/if}}

{{#each c in jobs}}
        <div class="rounded-xl border border-line px-4 py-3 mb-2">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="min-w-0 flex items-start gap-3">
              <span class="mt-0.5 w-9 h-9 shrink-0 rounded-lg border border-line bg-sunken flex items-center justify-center text-zinc-600 dark:text-zinc-300">
                <IconClock class="w-[18px] h-[18px]" />
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium truncate">{{ c.name }}</p>
                  <span class="inline-flex items-center rounded-md bg-brand-500/10 px-1.5 py-0.5 text-[11px] font-mono text-brand-700 dark:text-brand-400">{{ c.schedule }}</span>
{{#if c.schedule_text}}
                  <span class="text-zinc-500 text-xs">{{ c.schedule_text }}</span>
{{/if}}
                </div>
                <p class="text-zinc-500 text-xs font-mono truncate mt-0.5" title="{{ c.command }}">{{ c.command }}</p>
                <p class="text-zinc-400 text-[11px] font-mono truncate">as {{ c.ssh_user }}</p>
              </div>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-1.5 sm:justify-end">
              <button type="button" onclick="{{ viewLog(c.id) }}" class="inline-flex items-center gap-1.5 h-8 text-xs font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-3.5 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
                <IconDocumentText class="w-3.5 h-3.5" /> Log and schedule
              </button>
{{#if Billing.locked}}
              <span title="Pay to continue" class="inline-flex items-center gap-1 h-8 text-xs text-zinc-400 select-none px-2">
                <IconLockClosed class="w-3.5 h-3.5" /> Run now
              </span>
              <span title="Pay to continue" class="inline-flex items-center gap-1 h-8 text-xs text-zinc-400 select-none px-2">
                <IconLockClosed class="w-3.5 h-3.5" /> Delete
              </span>
{{/if}}
{{#if not Billing.locked}}
              <button type="button" onclick="{{ runNow(c.id) }}" class="inline-flex items-center gap-1.5 h-8 text-xs font-medium text-zinc-700 dark:text-zinc-200 rounded-full px-3 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors">
                <IconPlay class="w-3.5 h-3.5" /> Run now
              </button>
              <button type="button" onclick="{{ askRemove(c.id) }}" class="h-8 text-xs font-medium text-rose-600 dark:text-rose-400 rounded-full px-3 hover:bg-rose-500/[0.06] transition-colors">Delete</button>
{{/if}}
            </div>
          </div>

{{#if confirmId is c.id}}
          <div class="flex items-center gap-3 mt-3">
            <button onclick="{{ remove(c.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-1.5 transition">Yes, delete it</button>
            <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-1.5">Cancel</button>
          </div>
{{/if}}
        </div>
{{/each}}
      </div>
{{/if}}

    </div>
    </div>

{{#if logJob}}
    <CronLogConsole
      job="{{ logJob }}"
      host="{{ server ? server.name : '' }}"
      info="{{ logInfo }}"
      now="{{ logNow }}"
      lines="{{ logLines }}"
      shown="{{ logShown }}"
      tabs="{{ logTabs }}"
      filter="{{ logFilter }}"
      loading="{{ logLoading }}"
      error="{{ logError }}"
      live="{{ logLive }}"
      atBottom="{{ logAtBottom }}"
      copied="{{ logCopied }}"
      errors="{{ logErrors }}"
      warns="{{ logWarns }}"
      running="{{ runBusy }}"
      runOutput="{{ runOutput }}"
      runCode="{{ runCode }}"
      onClose="{{ closeLog }}"
      onCopy="{{ copyLog }}"
      onFilter="{{ setLogFilter }}"
      onToggleLive="{{ toggleLogLive }}"
      onJumpBottom="{{ jumpLogBottom }}"
      onRun="{{ runFromLog }}"
      onClearRun="{{ clearRun }}"
    />
{{/if}}
  </div>
