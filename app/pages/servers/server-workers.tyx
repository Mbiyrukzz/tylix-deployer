page ServerWorkers

import { IconArrowLeft } from "tylix-icons"

title "Workers"

needs
  Auth

uses
  Billing

background
  Billing

state
  server: null
  serverId: ""
  loading: true
  isMissing: false
  busy: false
  error: ""
  workers: []
  users: []
  usersError: ""
  statusError: ""
  statuses: {}
  busyId: null
  logId: null
  logWorker: null
  logText: ""
  logLines: []
  logShown: []
  logTabs: []
  logFilter: "all"
  logErrors: 0
  logWarns: 0
  logLoading: false
  logError: ""
  logLive: true
  logTimer: 0
  logFetching: false
  logProcs: []
  logRunning: 0
  logTotal: 0
  logReadAt: ""
  logAtBottom: true
  logCopied: false
  logRestarting: false
  confirmId: null
  poller: null

action
  fail(result, fallback) {
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    this.error = result.data?.error or fallback
  }

  fieldValue(id) {
    const el = document.getElementById(id)
    if not el {
      return ""
    }
    return String(Reflect.get(el, "value") or "")
  }

  setField(id, value) {
    const el = document.getElementById(id)
    if el {
      Reflect.set(el, "value", value)
    }
  }

  preset(kind) {
    if kind is "laravel" {
      this.setField("wName", "Laravel queue")
      this.setField("wCommand", "php artisan queue:work --sleep=3 --tries=3 --max-time=3600")
    }
    if kind is "reverb" {
      this.setField("wName", "Laravel Reverb")
      this.setField("wCommand", "php artisan reverb:start")
    }
    if kind is "tylix" {
      this.setField("wName", "Tylix queue")
      this.setField("wCommand", "npx tylix queue:work")
    }
  }

  badge(w) {
    const s = this.statuses[String(w.id)]
    if not s {
      return { text: "Not loaded", color: "#94a3b8" }
    }
    if s.running is s.total {
      return { text: "Running " + s.running + "/" + s.total, color: "#e0393f" }
    }
    if s.running is 0 {
      return { text: s.states[0].toLowerCase(), color: "#f43f5e" }
    }
    return { text: "Running " + s.running + "/" + s.total, color: "#f59e0b" }
  }

  decorate(list) {
    return list.map((w) => Object.assign({}, w, { badgeText: this.badge(w).text, badgeColor: this.badge(w).color }))
  }

  async loadWorkers() {
    const r = await useApi("/api/servers/" + this.serverId + "/workers")
    if r.ok and Array.isArray(r.data) {
      this.workers = this.decorate(r.data)
    }
  }

  async loadStatus() {
    const r = await useApi("/api/servers/" + this.serverId + "/workers/status")
    if r.ok {
      this.statuses = r.data
      this.statusError = ""
      this.workers = this.decorate(this.workers)
    } else if r.status is 401 {
      window.location.href = "/login"
    } else {
      this.statusError = r.data?.error or "Couldn't read worker status."
    }
  }

  async loadUsers() {
    const r = await useApi("/api/servers/" + this.serverId + "/ssh-users")
    if r.ok and Array.isArray(r.data) {
      this.users = r.data
      this.usersError = ""
    } else {
      this.users = [this.server.ssh_user]
      this.usersError = r.data?.error or "Couldn't list users on the server."
    }
  }

  async create() {
    if Billing.locked {
      return null
    }
    if this.busy {
      return null
    }
    this.busy = true
    this.error = ""

    const body = {
      name: this.fieldValue("wName"),
      command: this.fieldValue("wCommand"),
      directory: this.fieldValue("wDirectory"),
      user: this.fieldValue("wUser"),
      processes: this.fieldValue("wProcesses")
    }

    const result = await useApi("/api/servers/" + this.serverId + "/workers", { method: "POST", body: body })

    if result.ok {
      this.setField("wName", "")
      this.setField("wCommand", "")
      await this.loadWorkers()
      await this.loadStatus()
    } else {
      this.fail(result, "Couldn't create the worker.")
    }
    this.busy = false
  }

  async act(id, what) {
    if Billing.locked {
      return null
    }
    if this.busyId {
      return null
    }
    this.busyId = id
    this.error = ""
    const result = await useApi("/api/servers/" + this.serverId + "/workers/" + id + "/" + what, { method: "POST" })

    if not result.ok {
      this.fail(result, "Couldn't " + what + " the worker.")
    }
    await this.loadStatus()
    this.busyId = null
  }

  // ---- log console --------------------------------------------------------

  // Colours one log line: errors, warnings and "done" lines stand out, and a
  // leading [timestamp] is greyed. Same rules as the deployment log.
  classify(line, n) {
    const t = line.trim()

    let body = t
    let ts = ""
    if t.startsWith("[") {
      const close = t.indexOf("]")
      if close > 1 and close < 32 {
        const inner = t.slice(1, close)
        const looksLikeTime = "0123456789".includes(inner.charAt(0)) and (inner.includes(":") or inner.includes("-"))
        if looksLikeTime {
          ts = t.slice(0, close + 1)
          body = t.slice(close + 1).trim()
        }
      }
    }

    const lower = body.toLowerCase()
    const quiet = lower.includes("0 error") or lower.includes("no error") or lower.includes("without error")
    const isErr = (lower.startsWith("failed") or lower.includes(" fail") or lower.includes("error") or lower.includes("fatal") or lower.includes("exception") or lower.includes("uncaught") or lower.startsWith("at ")) and not quiet
    const isWarn = lower.includes("warning") or lower.includes("warn ") or lower.includes("deprecat") or lower.includes("retry") or lower.includes("timed out")
    const isOk = lower.includes(" done") or lower.startsWith("done") or lower.includes("success") or lower.includes("processed") or lower.includes("started") or lower.includes("listening") or lower.includes("ready")
    const isRun = lower.includes("running") or lower.includes("processing")

    let kind = "text"
    let cls = "text-slate-300"
    let rowCls = "border-transparent"
    let icon = ""

    if isErr {
      kind = "error"
      cls = "text-rose-300"
      rowCls = "border-rose-500 bg-rose-500/10"
      icon = "✕"
    } else if isWarn {
      kind = "warn"
      cls = "text-amber-300"
      rowCls = "border-amber-500/60"
      icon = "!"
    } else if isOk {
      kind = "ok"
      cls = "text-brand-400"
      icon = "✓"
    } else if isRun {
      kind = "run"
      cls = "text-sky-300"
      icon = "›"
    }

    return { n: n, kind: kind, text: ts is "" ? (line is "" ? " " : line) : body, ts: ts, cls: cls, rowCls: rowCls, icon: icon }
  }

  parseLog(raw) {
    if not raw {
      return []
    }
    const nl = String.fromCharCode(10)
    const cr = String.fromCharCode(13)
    return raw.split(cr + nl).join(nl).split(cr).join(nl).split(nl).map((line, i) => this.classify(line, i + 1))
  }

  applyLogFilter() {
    const f = this.logFilter
    this.logShown = f is "all" ? this.logLines : this.logLines.filter((l) => l.kind is f)
    this.logTabs = [
      { key: "all", label: "All", count: this.logLines.length },
      { key: "error", label: "Errors", count: this.logErrors },
      { key: "warn", label: "Warnings", count: this.logWarns },
      { key: "ok", label: "Done", count: this.logLines.filter((l) => l.kind is "ok").length }
    ]
  }

  setLogFilter(key) {
    this.logFilter = key
    this.applyLogFilter()
    window.setTimeout(() => this.scrollLogEnd(), 40)
  }

  scrollLogEnd() {
    const el = document.getElementById("worker-log-scroll")
    if el {
      el.scrollTop = el.scrollHeight
    }
  }

  onLogScroll() {
    if not this.logId {
      return null
    }
    const el = document.getElementById("worker-log-scroll")
    if el {
      this.logAtBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 48
    }
  }

  jumpLogBottom() {
    this.scrollLogEnd()
    this.logAtBottom = true
  }

  // One read at a time; a reply for a worker that is no longer open is dropped.
  async fetchLog() {
    const id = this.logId
    if not id or this.logFetching {
      return null
    }
    this.logFetching = true
    const result = await useApi("/api/servers/" + this.serverId + "/workers/" + id + "/log?lines=500")
    this.logFetching = false
    if this.logId is not id {
      return null
    }
    this.logLoading = false

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    if not result.ok {
      this.logError = result.data?.error or "Couldn't read the log. Retrying…"
      return null
    }

    this.logError = ""
    this.logProcs = Array.isArray(result.data.processes) ? result.data.processes : []
    this.logRunning = result.data.running or 0
    this.logTotal = result.data.total or 0
    this.logReadAt = result.data.read_at or ""

    const raw = String(result.data.log or "")
    if raw is this.logText and this.logLines.length > 0 {
      return null
    }
    this.logText = raw
    this.logLines = this.parseLog(raw)
    this.logErrors = this.logLines.filter((l) => l.kind is "error").length
    this.logWarns = this.logLines.filter((l) => l.kind is "warn").length
    this.applyLogFilter()
    if this.logAtBottom {
      window.setTimeout(() => this.scrollLogEnd(), 40)
    }
  }

  startLogTimer() {
    window.clearInterval(this.logTimer)
    this.logTimer = window.setInterval(() => this.fetchLog(), 3000)
  }

  toggleLogLive() {
    this.logLive = not this.logLive
    if this.logLive {
      this.logAtBottom = true
      this.fetchLog()
      this.startLogTimer()
    } else {
      window.clearInterval(this.logTimer)
    }
  }

  async viewLog(id) {
    const w = this.workers.find((x) => x.id is id)
    if not w {
      return null
    }
    this.logId = id
    this.logWorker = w
    this.logText = ""
    this.logLines = []
    this.logFilter = "all"
    this.logErrors = 0
    this.logWarns = 0
    this.logProcs = []
    this.logRunning = 0
    this.logTotal = 0
    this.logReadAt = ""
    this.logError = ""
    this.logLoading = true
    this.logLive = true
    this.logAtBottom = true
    this.applyLogFilter()

    const flux = Reflect.get(window, "__flux")
    if flux {
      // Leaving the page with the log open must stop the polling and give
      // the next page its scrolling back.
      flux.on(window, "flux:navigated", () => this.closeLog(), { once: true })
    }
    document.body.style.overflow = "hidden"

    this.startLogTimer()
    await this.fetchLog()
  }

  closeLog() {
    window.clearInterval(this.logTimer)
    this.logId = null
    this.logWorker = null
    document.body.style.overflow = ""
  }

  clearLogCopied() {
    this.logCopied = false
  }

  async copyLog() {
    try {
      await navigator.clipboard.writeText(this.logText)
      this.logCopied = true
      window.setTimeout(() => this.clearLogCopied(), 1800)
    } catch (err) {
      this.logError = "Couldn't copy: the browser blocked the clipboard."
    }
  }

  async restartFromLog() {
    if not this.logId or this.logRestarting {
      return null
    }
    this.logRestarting = true
    this.logAtBottom = true
    await this.act(this.logId, "restart")
    this.logRestarting = false
    await this.fetchLog()
  }

  onKey(e) {
    if e.key is "Escape" and this.logId {
      this.closeLog()
    }
  }

  askRemove(id) {
    if Billing.locked {
      return null
    }
    this.confirmId = id
  }

  cancelRemove() {
    this.confirmId = null
  }

  async remove(id) {
    if Billing.locked {
      return null
    }
    if this.busyId {
      return null
    }
    this.busyId = id
    this.error = ""
    const result = await useApi("/api/servers/" + this.serverId + "/workers/" + id, { method: "DELETE" })

    if result.ok {
      this.confirmId = null
      if this.logId is id {
        this.closeLog()
      }
      await this.loadWorkers()
    } else {
      this.fail(result, "Couldn't remove the worker.")
    }
    this.busyId = null
  }

onMount
  async {
    window.addEventListener("keydown", (e) => this.onKey(e))
    window.addEventListener("scroll", () => this.onLogScroll(), true)
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.server = result.data
        this.loading = false
        await this.loadWorkers()
        await this.loadUsers()
        await this.loadStatus()
        if not this.poller {
          this.poller = window.setInterval(() => this.loadStatus(), 15000)
          const flux = Reflect.get(window, "__flux")
          if flux {
            flux.on(window, "flux:navigated", () => window.clearInterval(this.poller), { once: true })
          }
        }
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="workers" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-6 sm:py-10">

{{#if loading}}
      <LoaderMark label="Loading…" />
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>

      <LockedBanner />

      <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Workers</h1>
      <p class="text-slate-500 text-sm mb-6">Long-running processes kept alive by Supervisor: queue workers, Reverb, or any command.</p>

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

      <div class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none mb-6">
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">New worker</h2>

        <p class="text-slate-500 text-xs mb-2">Start from a preset</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <button onclick="{{ preset('laravel') }}" class="text-sm rounded-lg border border-slate-300 dark:border-slate-700 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:border-brand-500/50">Laravel queue</button>
          <button onclick="{{ preset('reverb') }}" class="text-sm rounded-lg border border-slate-300 dark:border-slate-700 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:border-brand-500/50">Laravel Reverb</button>
          <button onclick="{{ preset('tylix') }}" class="text-sm rounded-lg border border-slate-300 dark:border-slate-700 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:border-brand-500/50">Tylix queue</button>
        </div>

        <label class="block text-slate-500 text-xs mb-1" for="wName">Name</label>
        <input id="wName" type="text" placeholder="e.g. Laravel queue" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3 py-2 mb-4" />

        <label class="block text-slate-500 text-xs mb-1" for="wCommand">Command</label>
        <input id="wCommand" type="text" placeholder="php artisan queue:work --sleep=3 --tries=3" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 mb-4" />

        <label class="block text-slate-500 text-xs mb-1" for="wDirectory">Directory</label>
        <input id="wDirectory" type="text" placeholder="/home/tylix/example.com/current" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2 mb-4" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="wUser">Run as user</label>
            <select id="wUser" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2">
{{#each u in users}}
              <option value="{{ u }}">{{ u }}</option>
{{/each}}
            </select>
{{#if usersError}}
            <p class="text-amber-600 dark:text-amber-500 text-xs mt-1">{{ usersError }}</p>
{{/if}}
          </div>
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="wProcesses">Processes</label>
            <input id="wProcesses" type="number" min="1" max="20" value="1" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3 py-2" />
          </div>
        </div>

        <div class="mt-5">
{{#if busy}}
          <button disabled class="text-sm bg-brand-500 text-white font-semibold rounded-xl px-4 py-2 opacity-50">Creating…</button>
{{/if}}
{{#if not busy}}
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-2 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            Create worker
          </button>
{{/if}}
{{#if not Billing.locked}}
          <button onclick="{{ create() }}" class="text-sm bg-brand-500 text-white font-semibold rounded-xl px-4 py-2 hover:bg-brand-400 transition-all">Create worker</button>
{{/if}}
{{/if}}
        </div>
      </div>

      <div class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
        <div class="flex items-center justify-between mb-1">
          <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Active workers</h2>
          <button onclick="{{ loadStatus() }}" class="text-sm text-brand-700 dark:text-brand-500 hover:underline font-medium">Refresh</button>
        </div>
        <p class="text-slate-500 text-sm mb-4">Status refreshes every 15 seconds.</p>

{{#if statusError}}
        <p role="alert" class="text-amber-600 dark:text-amber-500 text-sm mb-4">{{ statusError }}</p>
{{/if}}

{{#if workers.length is 0}}
        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center">
          <p class="text-slate-500 text-sm">No workers yet.</p>
        </div>
{{/if}}

{{#each w in workers}}
        <div class="rounded-xl border border-line px-4 py-3 mb-2">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium truncate">{{ w.name }}
                <span class="text-xs font-semibold ml-2" style="color: {{ w.badgeColor }}">{{ w.badgeText }}</span>
              </p>
              <p class="text-slate-500 text-xs font-mono truncate">{{ w.command }}</p>
              <p class="text-slate-400 text-xs font-mono truncate">{{ w.ssh_user }} · {{ w.directory }} · {{ w.processes }} process(es)</p>
            </div>
            <div class="flex shrink-0 items-center gap-1">
              <button onclick="{{ act(w.id, 'restart') }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-brand-600 px-2 py-1">Restart</button>
              <button onclick="{{ act(w.id, 'stop') }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600 px-2 py-1">Stop</button>
              <button onclick="{{ act(w.id, 'start') }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-brand-600 px-2 py-1">Start</button>
              <button onclick="{{ viewLog(w.id) }}" class="text-sm text-slate-600 dark:text-slate-300 hover:text-sky-600 px-2 py-1">Log</button>
{{#if Billing.locked}}
              <span title="Pay to continue" class="inline-flex items-center gap-1 text-sm text-slate-400 select-none px-2 py-1">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
                Delete
              </span>
{{/if}}
{{#if not Billing.locked}}
              <button onclick="{{ askRemove(w.id) }}" class="text-sm text-rose-600 dark:text-rose-500 hover:text-rose-500 px-2 py-1">Delete</button>
{{/if}}
            </div>
          </div>

{{#if confirmId is w.id}}
          <div class="flex items-center gap-3 mt-3">
            <button onclick="{{ remove(w.id) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-1.5 transition">Yes, delete it</button>
            <button onclick="{{ cancelRemove() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-1.5">Cancel</button>
          </div>
{{/if}}

        </div>
{{/each}}
      </div>
{{/if}}

    </div>
    </div>

{{#if logWorker}}
    <WorkerLogConsole
      worker="{{ logWorker }}"
      host="{{ server ? server.name : '' }}"
      lines="{{ logLines }}"
      shown="{{ logShown }}"
      tabs="{{ logTabs }}"
      filter="{{ logFilter }}"
      loading="{{ logLoading }}"
      error="{{ logError }}"
      live="{{ logLive }}"
      atBottom="{{ logAtBottom }}"
      copied="{{ logCopied }}"
      errors="{{ logErrors }}"
      warns="{{ logWarns }}"
      processes="{{ logProcs }}"
      running="{{ logRunning }}"
      total="{{ logTotal }}"
      readAt="{{ logReadAt }}"
      restarting="{{ logRestarting }}"
      onClose="{{ closeLog }}"
      onCopy="{{ copyLog }}"
      onFilter="{{ setLogFilter }}"
      onToggleLive="{{ toggleLogLive }}"
      onJumpBottom="{{ jumpLogBottom }}"
      onRestart="{{ restartFromLog }}"
    />
{{/if}}
  </div>