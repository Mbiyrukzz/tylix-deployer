page SiteDetail

import { IconExternalLink, IconTerminal, IconChevronRight } from "tylix-icons"

title "Site"

needs
  Auth

uses
  Billing
  TwoFactor

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  isMissing: false
  timer: 0
  typeLabel: ""
  stepText: ""
  rootPath: ""
  aliasText: ""
  canDelete: false
  deleting: false
  confirmDelete: false
  confirmText: ""
  deleteError: ""
  askCode: false
  code: ""
  codeError: ""

action
  describe(site) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["static", "Static"]
    ]

    const steps = [
      ["pending", "Queued"],
      ["user", "Creating user and folders"],
      ["clone", "Cloning repository"],
      ["wordpress", "Downloading WordPress"],
      ["database", "Creating the database"],
      ["install", "Installing dependencies"],
      ["build", "Building the app"],
      ["service", "Starting the app"],
      ["webserver", "Configuring nginx"],
      ["ready", "Done"],
      ["del_services", "Stopping the app"],
      ["del_webserver", "Removing the nginx site"],
      ["del_php", "Removing the PHP pool"],
      ["del_ssl", "Removing the certificate"],
      ["del_database", "Removing the database"],
      ["del_user", "Removing the user and files"],
      ["del_files", "Removing the site folder"]
    ]

    const typeHit = labels.find((l) => l[0] is site.type)
    const stepHit = steps.find((s) => s[0] is site.step)

    this.site = site
    this.serverId = "" + site.server_id
    this.typeLabel = typeHit ? typeHit[1] : site.type
    this.stepText = stepHit ? stepHit[1] : site.step
    this.rootPath = "/home/" + site.isolated_user + "/" + site.domain
    this.aliasText = site.aliases.join(", ")
    this.canDelete = ["ready", "failed", "delete_failed"].includes(site.status)
    this.deleting = site.status is "deleting"
  }

  async load() {
    const result = await useApi("/api/sites/" + this.siteId)

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.status is 404 and this.deleting {
      window.clearInterval(this.timer)
      window.location.href = "/servers/server-sites?id=" + this.serverId
      return null
    }

    if result.ok {
      this.describe(result.data)

      const status = result.data.status
      if status is "ready" {
        window.clearInterval(this.timer)
      }
      if status is "failed" {
        window.clearInterval(this.timer)
      }
      if status is "delete_failed" {
        window.clearInterval(this.timer)
      }
    }
  }

  startPolling() {
    window.clearInterval(this.timer)
    this.timer = window.setInterval(() => this.load(), 3000)
  }

  async askDelete() {
    if Billing.locked {
      return null
    }
    this.deleteError = ""
    this.confirmText = ""
    this.codeError = ""
    this.code = ""
    this.askCode = TwoFactor.enabled
    this.confirmDelete = true

    if TwoFactor.sms and not TwoFactor.totp {
      await this.sendCode()
    }
  }

  cancelDelete() {
    this.confirmDelete = false
    this.confirmText = ""
    this.deleteError = ""
    this.askCode = false
    this.code = ""
    this.codeError = ""
    TwoFactor.reset()
  }

  async sendCode() {
    this.codeError = ""
    const result = await TwoFactor.sendCode()

    if result.status is 401 {
      window.location.href = "/login"
    } else if not result.ok {
      this.codeError = result.data?.error or "Couldn't send the code."
    }
  }

  async deleteSite(force) {
    if Billing.locked or this.deleting or not this.site {
      return null
    }

    if this.confirmText is not this.site.domain {
      this.deleteError = "Type the domain exactly to confirm."
      return null
    }

    const code = this.code.trim()
    this.deleteError = ""
    this.codeError = ""

    if this.askCode and code is "" {
      this.codeError = "Enter a verification code to delete this site."
      return null
    }

    // DELETE requests carry the second-factor code in the query string.
    let url = "/api/sites/" + this.siteId + "?confirm=" + encodeURIComponent(this.confirmText)
    if force {
      url = url + "&force=1"
    }
    if code {
      url = url + "&code=" + encodeURIComponent(code)
    }

    const result = await useApi(url, { method: "DELETE" })

    if result.ok {
      this.deleting = true
      this.canDelete = false
      this.confirmDelete = false
      this.confirmText = ""
      this.askCode = false
      this.code = ""
      TwoFactor.reset()
      this.startPolling()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else if result.status is 403 and result.data?.two_factor_required {
      TwoFactor.apply(result.data.methods or [])
      this.askCode = true
      this.codeError = result.data.error or "Enter a verification code to continue."
    } else if result.status is 422 and result.data?.errors?.code {
      this.askCode = true
      this.codeError = result.data.errors.code[0]
    } else {
      this.deleteError = result.data?.error or "Couldn't delete that site."
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false

        await TwoFactor.load()

        const status = result.data.status
        if status is "pending" {
          this.startPolling()
        }
        if status is "creating" {
          this.startPolling()
        }
        if status is "deleting" {
          this.startPolling()
        }
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="application" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading site…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Overview" description="{{ typeLabel + ' app, running as ' + site.isolated_user + ' in its own folder.' }}" domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}">
        <SiteStatus slot="badge" status="{{ site.status }}" />
        <div slot="actions" class="flex flex-wrap items-center gap-2 shrink-0">
          <a href="{{ 'https://' + site.domain }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconExternalLink class="w-4 h-4" /> Visit site
          </a>
{{#if site.status is "ready"}}
{{#if Billing.locked}}
          <span title="Pay to continue" class="inline-flex items-center gap-2 h-9 text-sm bg-zinc-200 dark:bg-zinc-800 text-zinc-500 rounded-full px-4 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4"><rect x="4" y="9" width="12" height="8" rx="2" /><path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" /></svg>
            Terminal
          </span>
{{/if}}
{{#if not Billing.locked}}
          <a href="{{ '/servers/site-terminal?id=' + siteId }}" class="inline-flex items-center gap-2 h-9 text-sm bg-brand-500 text-white font-semibold rounded-full px-4 shadow-sm hover:bg-brand-400 transition-colors">
            <IconTerminal class="w-4 h-4" /> Terminal
          </a>
{{/if}}
{{/if}}
        </div>
      </SiteHeader>

      <LockedBanner />

      <div class="min-w-0">
        <div class="min-w-0 space-y-6">

{{#if site.status is "failed"}}
          <div role="alert" class="flex gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/[0.06] p-4 sm:p-5">
            <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-rose-500"></span>
            <div class="min-w-0">
              <p class="text-rose-600 dark:text-rose-400 text-sm font-semibold mb-1">Failed at: {{ stepText }}</p>
              <p class="text-rose-600/90 dark:text-rose-300/90 text-sm font-mono break-words">{{ site.error }}</p>
            </div>
          </div>
{{/if}}

{{#if site.status is "delete_failed"}}
          <div role="alert" class="flex gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/[0.06] p-4 sm:p-5">
            <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-rose-500"></span>
            <div class="min-w-0">
              <p class="text-rose-600 dark:text-rose-400 text-sm font-semibold mb-1">Couldn't finish deleting (stopped at: {{ stepText }})</p>
              <p class="text-rose-600/90 dark:text-rose-300/90 text-sm font-mono break-words">{{ site.error }}</p>
            </div>
          </div>
{{/if}}

{{#if deleting}}
          <div role="status" class="flex gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/[0.06] p-4 sm:p-5">
            <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-rose-500 animate-pulse"></span>
            <div class="min-w-0">
              <p class="text-rose-600 dark:text-rose-400 text-sm font-semibold mb-0.5">Deleting this site</p>
              <p class="text-zinc-600 dark:text-zinc-300 text-sm">{{ stepText }}…</p>
            </div>
          </div>
{{/if}}

{{#if site.status is "creating"}}
          <div role="status" class="flex gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/[0.06] p-4 sm:p-5">
            <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-amber-500 animate-pulse"></span>
            <div class="min-w-0">
              <p class="text-amber-700 dark:text-amber-400 text-sm font-semibold mb-0.5">Setting up the site</p>
              <p class="text-zinc-600 dark:text-zinc-300 text-sm">{{ stepText }}… This page updates by itself.</p>
            </div>
          </div>
{{/if}}

{{#if site.status is "pending"}}
          <div role="status" class="flex gap-3 rounded-2xl border border-amber-500/30 bg-amber-500/[0.06] p-4 sm:p-5">
            <span class="mt-1.5 w-2 h-2 shrink-0 rounded-full bg-amber-500 animate-pulse"></span>
            <p class="text-zinc-700 dark:text-zinc-200 text-sm">Queued, starting shortly…</p>
          </div>
{{/if}}

          <section class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Application</h2>
              <p class="text-zinc-500 text-[13px] mt-0.5">How this site is set up on the server.</p>
            </div>
            <dl class="divide-y divide-line">
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Type</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm ">{{ typeLabel }}</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Isolated user</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono">{{ site.isolated_user }}</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Site folder</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ rootPath }}</dd>
              </div>
{{#if aliasText}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Aliases</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ aliasText }}</dd>
              </div>
{{/if}}
{{#if site.php_version}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">PHP version</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono">{{ site.php_version }}</dd>
              </div>
{{/if}}
{{#if site.port}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">App port</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono">{{ site.port }}</dd>
              </div>
{{/if}}
{{#if site.web_directory}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Web directory</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ site.web_directory }}</dd>
              </div>
{{/if}}
{{#if site.app_directory}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">App folder</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ site.app_directory }}</dd>
              </div>
{{/if}}
{{#if site.backend_directory}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">API folder</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ site.backend_directory }}</dd>
              </div>
{{/if}}
{{#if site.build_command}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Build command</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ site.build_command }}</dd>
              </div>
{{/if}}
{{#if site.start_command}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Start command</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ site.start_command }}</dd>
              </div>
{{/if}}
{{#if site.repository}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Repository</dt>
                <dd class="min-w-0 flex-1 flex flex-wrap items-center gap-2 text-zinc-900 dark:text-zinc-100 text-sm">
                  <span class="font-mono break-all">{{ site.repository }}</span>
                  <span class="inline-flex items-center rounded-md bg-sunken border border-line px-1.5 py-px text-xs font-mono text-zinc-600 dark:text-zinc-300">{{ site.branch }}</span>
                  <a href="{{ '/servers/site-deploy?id=' + siteId }}" class="ml-auto inline-flex items-center gap-1 text-[13px] font-medium text-brand-700 dark:text-brand-400 hover:underline">Deployments <IconChevronRight class="w-3.5 h-3.5" /></a>
                </dd>
              </div>
{{/if}}
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-5 sm:px-6 py-3.5">
                <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">Created</dt>
                <dd class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm tabular-nums">{{ site.created_at.slice(0, 10) }}</dd>
              </div>
            </dl>
          </section>


          <section class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex items-center justify-between gap-4 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <div>
                <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Setup log</h2>
                <p class="text-zinc-500 text-[13px] mt-0.5">Output from creating this site.</p>
              </div>
            </div>
{{#if site.log}}
            <div class="max-h-[28rem] overflow-y-auto bg-zinc-950 px-5 sm:px-6 py-4 text-[12.5px] leading-6 font-mono text-zinc-300 whitespace-pre-wrap [overflow-wrap:anywhere]">{{ site.log }}</div>
{{/if}}
{{#if not site.log}}
            <p class="px-5 sm:px-6 py-6 text-zinc-500 text-sm">Nothing logged yet.</p>
{{/if}}
          </section>

{{#if canDelete}}
          <section class="rounded-2xl border border-rose-500/25 bg-panel p-5 sm:p-6">
            <h2 class="text-rose-600 dark:text-rose-400 text-[15px] font-semibold mb-1">Delete site</h2>
{{#if site.origin is "import"}}
            <p class="text-zinc-500 text-sm mb-4 max-w-3xl leading-relaxed">This site was imported, so deleting it removes only what is its own: its nginx site, its SSL certificate and the folder <span class="font-mono">{{ rootPath }}</span>. The user {{ site.isolated_user }}, its PHP pool, databases and any other sites it runs stay. This can't be undone.</p>
{{/if}}
{{#if site.origin is not "import"}}
            <p class="text-zinc-500 text-sm mb-4 max-w-3xl leading-relaxed">Permanently removes this site and everything it created on the server: the app service, the nginx site, the PHP pool, the SSL certificate, any WordPress database, the isolated user and every file under <span class="font-mono">/home/{{ site.isolated_user }}</span>. This can't be undone.</p>
{{/if}}

{{#if deleteError}}
            <p role="alert" class="text-rose-500 text-sm mb-4">{{ deleteError }}</p>
{{/if}}

{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-lg px-4 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Delete site
            </button>
            <p class="text-slate-500 text-xs mt-2">View only. Pay to continue.</p>
{{/if}}

{{#if not Billing.locked}}
{{#if not confirmDelete}}
            <button onclick="{{ askDelete() }}" class="text-sm text-rose-600 dark:text-rose-500 hover:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-lg px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">
              Delete site
            </button>
{{/if}}

{{#if confirmDelete}}
{{#if askCode}}
            <div class="rounded-xl border border-line bg-sunken p-4 mb-4 max-w-sm">
              <label for="delete-code" class="block text-slate-700 dark:text-slate-300 text-sm font-medium mb-2">Verification code</label>
              <input
                id="delete-code"
                type="text"
                inputmode="text"
                autocomplete="one-time-code"
                maxlength="12"
                value="{{ code }}"
                oninput="{{ code = $event.target.value }}"
                class="w-full rounded-lg border border-line-strong bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-center text-lg font-mono tracking-[0.3em] px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500"
              />
              <p class="text-slate-500 text-xs mt-2">{{ TwoFactor.totp ? "Enter a code from your authenticator app, or a recovery code." : "Enter the code texted to " + TwoFactor.smsHint + "." }}</p>
{{#if TwoFactor.notice}}
              <p role="status" class="text-brand-700 dark:text-brand-500 text-xs mt-2">{{ TwoFactor.notice }}</p>
{{/if}}
{{#if codeError}}
              <p role="alert" class="text-rose-500 text-xs mt-2">{{ codeError }}</p>
{{/if}}
{{#if TwoFactor.sms}}
              <button disabled="{{ TwoFactor.sending }}" onclick="{{ sendCode() }}" class="mt-3 text-xs text-slate-600 dark:text-slate-300 border border-line rounded-full px-3 py-1 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors disabled:opacity-50">{{ TwoFactor.sending ? "Sending…" : "Text me a code" }}</button>
{{/if}}
            </div>
{{/if}}
            <div class="flex flex-wrap items-center gap-3">
              <input
                type="text"
                value="{{ confirmText }}"
                oninput="{{ confirmText = $event.target.value }}"
                class="rounded-lg border border-line-strong bg-sunken text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-rose-500/40"
                placeholder="Type {{ site.domain }} to confirm"
              />
              <button onclick="{{ deleteSite(false) }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-lg px-4 py-2 transition">
                Delete for good
              </button>
{{#if site.status is "delete_failed"}}
              <button onclick="{{ deleteSite(true) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-200 dark:border-rose-900/50 rounded-lg px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition">
                Delete anyway (skip server cleanup)
              </button>
{{/if}}
              <button onclick="{{ cancelDelete() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2 transition-colors">
                Cancel
              </button>
            </div>
{{/if}}
{{/if}}
          </section>
{{/if}}

        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>