page SiteDetail

import { IconArrowLeft } from "tylix-icons"

title "Site"

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  notFound: false
  timer: 0
  typeLabel: ""
  stepText: ""
  rootPath: ""
  aliasText: ""

action
  describe(site) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["static", "Static"]
    ]

    const steps = [
      ["pending", "Queued"],
      ["user", "Creating user and folders"],
      ["clone", "Cloning repository"],
      ["wordpress", "Downloading WordPress"],
      ["database", "Creating the database"],
      ["install", "Installing dependencies"],
      ["build", "Building the app"],
      ["service", "Starting the app"],
      ["webserver", "Configuring nginx"],
      ["ready", "Done"]
    ]

    const typeHit = labels.find((l) => l[0] is site.type)
    const stepHit = steps.find((s) => s[0] is site.step)

    this.site = site
    this.serverId = "" + site.server_id
    this.typeLabel = typeHit ? typeHit[1] : site.type
    this.stepText = stepHit ? stepHit[1] : site.step
    this.rootPath = "/home/" + site.isolated_user + "/" + site.domain
    this.aliasText = site.aliases.join(", ")
  }

  async load() {
    const result = await useApi("/api/sites/" + this.siteId)

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.describe(result.data)

      const status = result.data.status
      if status is "ready" {
        window.clearInterval(this.timer)
      }
      if status is "failed" {
        window.clearInterval(this.timer)
      }
    }
  }

  startPolling() {
    this.timer = window.setInterval(() => this.load(), 3000)
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    if not id {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false

        const status = result.data.status
        if status is "pending" {
          this.startPolling()
        }
        if status is "creating" {
          this.startPolling()
        }
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_230px_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading site…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-2">Site not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been removed, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if site}}
      <a href="{{ '/servers/server-sites?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Sites
      </a>

      <div class="flex items-start justify-between gap-4 mb-8">
        <div class="min-w-0">
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate">{{ site.domain }}</h1>
{{#if site.status is "ready"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
            </span>
{{/if}}
{{#if site.status is "failed"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
            </span>
{{/if}}
{{#if site.status is "creating"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Creating
            </span>
{{/if}}
{{#if site.status is "pending"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Queued
            </span>
{{/if}}
          </div>
          <p class="text-slate-500 text-sm font-mono">{{ typeLabel }} / {{ site.isolated_user }}</p>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <SiteSidebar active="application" siteId="{{ siteId }}" />

        <div class="min-w-0 flex-1">

{{#if site.status is "failed"}}
          <div role="alert" class="rounded-2xl border border-rose-500/30 bg-rose-500/5 p-5 mb-6">
            <p class="text-rose-500 text-sm font-medium mb-1">Failed at: {{ stepText }}</p>
            <p class="text-rose-500 text-sm break-words">{{ site.error }}</p>
          </div>
{{/if}}

{{#if site.status is "creating"}}
          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 mb-6">
            <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-1">Current step</p>
            <p class="text-slate-800 dark:text-slate-200 text-sm">{{ stepText }}…</p>
          </div>
{{/if}}

{{#if site.status is "pending"}}
          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 mb-6">
            <p class="text-slate-800 dark:text-slate-200 text-sm">Queued, starting shortly…</p>
          </div>
{{/if}}

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-5">Application</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
              <div>
                <p class="text-slate-500 text-xs mb-1">Type</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm">{{ typeLabel }}</p>
              </div>
              <div>
                <p class="text-slate-500 text-xs mb-1">Isolated user</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.isolated_user }}</p>
              </div>
              <div>
                <p class="text-slate-500 text-xs mb-1">Site folder</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ rootPath }}</p>
              </div>
{{#if aliasText}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Aliases</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ aliasText }}</p>
              </div>
{{/if}}
{{#if site.php_version}}
              <div>
                <p class="text-slate-500 text-xs mb-1">PHP version</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.php_version }}</p>
              </div>
{{/if}}
{{#if site.port}}
              <div>
                <p class="text-slate-500 text-xs mb-1">App port</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.port }}</p>
              </div>
{{/if}}
{{#if site.repository}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Repository</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ site.repository }}</p>
              </div>
              <div>
                <p class="text-slate-500 text-xs mb-1">Branch</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.branch }}</p>
              </div>
{{/if}}
{{#if site.web_directory}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Web directory</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.web_directory }}</p>
              </div>
{{/if}}
{{#if site.app_directory}}
              <div>
                <p class="text-slate-500 text-xs mb-1">App folder</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.app_directory }}</p>
              </div>
{{/if}}
{{#if site.backend_directory}}
              <div>
                <p class="text-slate-500 text-xs mb-1">API folder</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono">{{ site.backend_directory }}</p>
              </div>
{{/if}}
{{#if site.build_command}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Build command</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ site.build_command }}</p>
              </div>
{{/if}}
{{#if site.start_command}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Start command</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ site.start_command }}</p>
              </div>
{{/if}}
              <div>
                <p class="text-slate-500 text-xs mb-1">Created</p>
                <p class="text-slate-800 dark:text-slate-200 text-sm">{{ site.created_at.slice(0, 10) }}</p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-4">Deployment log</h2>
{{#if site.log}}
            <div class="max-h-96 overflow-y-auto rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 p-4 text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-words">{{ site.log }}</div>
{{/if}}
{{#if not site.log}}
            <p class="text-slate-500 text-sm">Nothing logged yet.</p>
{{/if}}
          </div>

        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>