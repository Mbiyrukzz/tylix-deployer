page ServerFirewall

import { IconArrowLeft } from "tylix-icons"

title "Firewall"

needs
  Auth

state
  server: null
  serverId: ""
  loading: true
  notFound: false
  busy: false
  syncing: false
  error: ""
  note: ""
  rules: []
  showForm: false
  editId: 0
  name: ""
  ruleType: "allow"
  protocol: "tcp"
  source: "any"
  port: ""
  formError: ""
  confirmId: null
  confirmReset: false
  resetting: false

action
  fail(result, fallback) {
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    this.error = result.data?.error or fallback
  }

  pickType(t) {
    this.ruleType = t
  }

  pickProtocol(p) {
    this.protocol = p
  }

  resetForm() {
    this.editId = 0
    this.name = ""
    this.ruleType = "allow"
    this.protocol = "tcp"
    this.source = "any"
    this.port = ""
    this.formError = ""
  }

  newRule() {
    this.resetForm()
    this.showForm = true
  }

  cancelForm() {
    this.showForm = false
    this.resetForm()
  }

  startEdit(id) {
    const r = this.rules.find((x) => x.id is id)
    if not r {
      return null
    }
    this.editId = r.id
    this.name = r.name
    this.ruleType = r.type
    this.protocol = r.protocol
    this.source = r.source
    this.port = String(r.port)
    this.formError = ""
    this.confirmId = null
    this.showForm = true
  }

  async loadRules() {
    const r = await useApi("/api/servers/" + this.serverId + "/firewall")
    if r.ok and Array.isArray(r.data) {
      this.rules = r.data
    }
  }

  async sync() {
    if this.syncing {
      return null
    }
    this.syncing = true
    this.error = ""
    this.note = ""
    const result = await useApi("/api/servers/" + this.serverId + "/firewall/sync", { method: "POST" })
    if result.ok {
      this.note = "Firewall synced and enabled."
    } else {
      this.fail(result, "Couldn't sync the firewall.")
    }
    await this.loadRules()
    this.syncing = false
  }

  async save() {
    if this.busy {
      return null
    }
    this.busy = true
    this.error = ""
    this.note = ""
    this.formError = ""

    const body = {
      name: this.name,
      type: this.ruleType,
      source: this.source,
      protocol: this.protocol,
      port: this.port
    }

    const editing = this.editId is not 0
    let url = "/api/servers/" + this.serverId + "/firewall"
    let method = "POST"
    if editing {
      url = url + "/" + this.editId
      method = "PUT"
    }

    const result = await useApi(url, { method: method, body: body })

    if result.ok {
      if editing {
        this.note = "Rule updated."
      } else {
        this.note = "Rule added."
      }
      this.showForm = false
      this.resetForm()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      const errors = result.data?.errors
      let first = ""
      if errors {
        const keys = Object.keys(errors)
        if keys.length > 0 {
          first = errors[keys[0]][0]
        }
      }
      this.formError = first or result.data?.error or "Couldn't save the rule."
    }
    await this.loadRules()
    this.busy = false
  }

  askRemove(id) {
    this.confirmId = id
  }

  cancelRemove() {
    this.confirmId = null
  }

  askReset() {
    this.confirmReset = true
  }

  cancelReset() {
    this.confirmReset = false
  }

  async reset() {
    if this.resetting {
      return null
    }
    this.resetting = true
    this.error = ""
    this.note = ""

    const result = await useApi("/api/servers/" + this.serverId + "/firewall/reset", { method: "POST" })
    this.confirmReset = false

    if result.ok {
      this.showForm = false
      this.resetForm()
      if result.data.failed > 0 {
        this.note = "Reset, but " + result.data.failed + " rule(s) couldn't be removed. See the failed rows."
      } else {
        this.note = "Firewall reset to SSH, HTTP and HTTPS."
      }
    } else {
      this.fail(result, "Couldn't reset the firewall.")
    }

    await this.loadRules()
    this.resetting = false
  }

  async remove(id) {
    this.error = ""
    this.note = ""
    const result = await useApi("/api/servers/" + this.serverId + "/firewall/" + id, { method: "DELETE" })
    if result.ok {
      this.confirmId = null
      this.note = "Rule removed."
      await this.loadRules()
    } else {
      this.confirmId = null
      this.fail(result, "Couldn't remove the rule.")
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.server = result.data
        this.loading = false
        await this.loadRules()
        // Servers added by hand (not provisioned here) get their defaults on first visit.
        if this.rules.length is 0 {
          await this.sync()
        }
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-100 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
{{#if serverId}}
    <ServerSidebar active="firewall" serverId="{{ serverId }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-12 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-900 dark:text-slate-100 font-medium mb-2">Server not found</h2>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>

      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Firewall</h1>
          <p class="text-slate-500 text-sm">Here you can manage this server's firewall rules. Rules are applied with UFW over SSH.</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
{{#if resetting}}
          <button disabled class="text-sm border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl px-4 py-2 opacity-50">Resetting…</button>
{{/if}}
{{#if not resetting}}
{{#if confirmReset}}
          <button onclick="{{ reset() }}" class="text-sm text-white bg-rose-600 hover:bg-rose-500 rounded-xl px-4 py-2">Yes, reset</button>
          <button onclick="{{ cancelReset() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2">Cancel</button>
{{/if}}
{{#if not confirmReset}}
          <button onclick="{{ askReset() }}" class="text-sm border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl px-4 py-2 hover:border-rose-500/50">Reset to defaults</button>
{{/if}}
{{/if}}
{{#if syncing}}
          <button disabled class="text-sm border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl px-4 py-2 opacity-50">Syncing…</button>
{{/if}}
{{#if not syncing}}
          <button onclick="{{ sync() }}" class="text-sm border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 rounded-xl px-4 py-2 hover:border-emerald-500/50">Sync</button>
{{/if}}
          <button onclick="{{ newRule() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">Create</button>
        </div>
      </div>

{{#if confirmReset}}
      <p class="text-amber-600 dark:text-amber-500 text-sm mb-4">This removes every rule except SSH, HTTP and HTTPS. Only rules listed on this page are removed.</p>
{{/if}}

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4 break-words">{{ error }}</p>
{{/if}}
{{#if note}}
      <p class="text-emerald-700 dark:text-emerald-500 text-sm mb-4">{{ note }}</p>
{{/if}}

{{#if showForm}}
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
{{#if editId is 0}}
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">New rule</h2>
{{/if}}
{{#if editId is not 0}}
        <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Edit rule</h2>
{{/if}}

        <label class="block text-slate-500 text-xs mb-1" for="fName">Name</label>
        <input id="fName" type="text" value="{{ name }}" oninput="{{ name = $event.target.value }}" placeholder="e.g. Postgres from office" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-3 py-2 mb-4" />

        <p class="text-slate-500 text-xs mb-2">Type</p>
        <div class="grid grid-cols-2 gap-2 mb-4 max-w-xs">
{{#if ruleType is "allow"}}
          <button onclick="{{ pickType('allow') }}" class="rounded-xl border px-4 py-2 text-sm border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">Allow</button>
{{/if}}
{{#if ruleType is not "allow"}}
          <button onclick="{{ pickType('allow') }}" class="rounded-xl border px-4 py-2 text-sm border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">Allow</button>
{{/if}}
{{#if ruleType is "deny"}}
          <button onclick="{{ pickType('deny') }}" class="rounded-xl border px-4 py-2 text-sm border-rose-500 bg-rose-500/10 text-slate-800 dark:text-slate-200">Deny</button>
{{/if}}
{{#if ruleType is not "deny"}}
          <button onclick="{{ pickType('deny') }}" class="rounded-xl border px-4 py-2 text-sm border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-rose-500/40">Deny</button>
{{/if}}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="fSource">Source</label>
            <input id="fSource" type="text" value="{{ source }}" oninput="{{ source = $event.target.value }}" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2" />
            <p class="text-slate-400 text-xs mt-1">"any", an IP, or a CIDR.</p>
          </div>
          <div>
            <p class="text-slate-500 text-xs mb-1">Protocol</p>
            <div class="grid grid-cols-2 gap-2">
{{#if protocol is "tcp"}}
              <button onclick="{{ pickProtocol('tcp') }}" class="rounded-xl border px-3 py-2 text-sm font-mono border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">tcp</button>
{{/if}}
{{#if protocol is not "tcp"}}
              <button onclick="{{ pickProtocol('tcp') }}" class="rounded-xl border px-3 py-2 text-sm font-mono border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">tcp</button>
{{/if}}
{{#if protocol is "udp"}}
              <button onclick="{{ pickProtocol('udp') }}" class="rounded-xl border px-3 py-2 text-sm font-mono border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">udp</button>
{{/if}}
{{#if protocol is not "udp"}}
              <button onclick="{{ pickProtocol('udp') }}" class="rounded-xl border px-3 py-2 text-sm font-mono border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">udp</button>
{{/if}}
            </div>
          </div>
          <div>
            <label class="block text-slate-500 text-xs mb-1" for="fPort">Port</label>
            <input id="fPort" type="text" value="{{ port }}" oninput="{{ port = $event.target.value }}" placeholder="5432 or 6000:6010" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm font-mono px-3 py-2" />
          </div>
        </div>

{{#if formError}}
        <p role="alert" class="text-rose-500 text-sm mb-3 break-words">{{ formError }}</p>
{{/if}}
        <div class="flex items-center gap-3">
{{#if busy}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 opacity-50">Applying…</button>
{{/if}}
{{#if not busy}}
{{#if editId is 0}}
          <button onclick="{{ save() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">Add rule</button>
{{/if}}
{{#if editId is not 0}}
          <button onclick="{{ save() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-xl px-4 py-2 hover:bg-emerald-400 transition-all">Save changes</button>
{{/if}}
{{/if}}
          <button onclick="{{ cancelForm() }}" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 px-3 py-2">Cancel</button>
        </div>
      </div>
{{/if}}

      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm dark:shadow-none overflow-x-auto">
{{#if rules.length is 0}}
        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-6 text-center">
          <p class="text-slate-500 text-sm">No rules yet.</p>
        </div>
{{/if}}
{{#if rules.length is not 0}}
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="text-slate-500 text-xs uppercase tracking-wider">
              <th class="py-2 pr-4 font-semibold">Name</th>
              <th class="py-2 pr-4 font-semibold">Type</th>
              <th class="py-2 pr-4 font-semibold">Source</th>
              <th class="py-2 pr-4 font-semibold">Protocol</th>
              <th class="py-2 pr-4 font-semibold">Port</th>
              <th class="py-2 pr-4 font-semibold">Status</th>
              <th class="py-2 font-semibold"></th>
            </tr>
          </thead>
          <tbody>
{{#each r in rules}}
            <tr class="border-t border-slate-200 dark:border-slate-800">
              <td class="py-3 pr-4 text-slate-900 dark:text-slate-100 font-medium">{{ r.name }}</td>
              <td class="py-3 pr-4">
{{#if r.type is "allow"}}
                <span class="text-emerald-700 dark:text-emerald-500">allow</span>
{{/if}}
{{#if r.type is "deny"}}
                <span class="text-rose-600 dark:text-rose-500">deny</span>
{{/if}}
              </td>
              <td class="py-3 pr-4 font-mono text-slate-600 dark:text-slate-400">{{ r.source }}</td>
              <td class="py-3 pr-4 font-mono text-slate-600 dark:text-slate-400">{{ r.protocol }}</td>
              <td class="py-3 pr-4 font-mono text-slate-600 dark:text-slate-400">{{ r.port }}</td>
              <td class="py-3 pr-4">
{{#if r.status is "ready"}}
                <span class="text-xs rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 px-2 py-0.5">ready</span>
{{/if}}
{{#if r.status is "pending"}}
                <span class="text-xs rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-400 px-2 py-0.5">pending</span>
{{/if}}
{{#if r.status is "failed"}}
                <span class="text-xs rounded-full bg-rose-500/15 text-rose-700 dark:text-rose-400 px-2 py-0.5" title="{{ r.error }}">failed</span>
{{/if}}
              </td>
              <td class="py-3 text-right whitespace-nowrap">
{{#if confirmId is r.id}}
                <button onclick="{{ remove(r.id) }}" class="text-xs text-white bg-rose-600 hover:bg-rose-500 rounded-md px-2 py-1">Yes, delete</button>
                <button onclick="{{ cancelRemove() }}" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 px-2 py-1">Cancel</button>
{{/if}}
{{#if confirmId is not r.id}}
                <button onclick="{{ startEdit(r.id) }}" class="text-xs text-slate-600 dark:text-slate-300 hover:text-emerald-600 px-2 py-1">Edit</button>
                <button onclick="{{ askRemove(r.id) }}" class="text-xs text-rose-600 dark:text-rose-500 hover:underline px-2 py-1">Delete</button>
{{/if}}
              </td>
            </tr>
{{#if r.error}}
            <tr>
              <td colspan="7" class="pb-3 text-rose-500 text-xs break-words">{{ r.error }}</td>
            </tr>
{{/if}}
{{/each}}
          </tbody>
        </table>
        <p class="text-slate-500 text-xs mt-4">Showing {{ rules.length }} rules</p>
{{/if}}
      </div>
{{/if}}

    </div>
    </div>
  </div>