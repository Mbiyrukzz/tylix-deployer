page ServerLogs

import { IconArrowLeft } from "tylix-icons"

title "Logs"

needs
  Auth

uses
  Billing

background
  Billing

// The full log viewer is the ConsoleDock (app/pages/components), which pops
// over any page; arriving here opens it. This page is the summary behind it.

state
  server: null
  serverId: ""
  loading: true
  isMissing: false
  busy: false
  error: ""
  logs: []
  counts: { error: 0, warning: 0, success: 0, info: 0 }

action
  fail(result, fallback) {
    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    this.error = result.data?.error or fallback
  }

  fmtDate(value) {
    const d = new Date(value)
    if isNaN(d.getTime()) {
      return String(value or "")
    }
    return d.toISOString().slice(0, 19).replace("T", " ") + " UTC"
  }

  dotClass(level) {
    if level is "success" {
      return "mt-1.5 w-2 h-2 rounded-full shrink-0 bg-emerald-500"
    }
    if level is "warning" {
      return "mt-1.5 w-2 h-2 rounded-full shrink-0 bg-amber-500"
    }
    if level is "error" {
      return "mt-1.5 w-2 h-2 rounded-full shrink-0 bg-rose-500"
    }
    return "mt-1.5 w-2 h-2 rounded-full shrink-0 bg-sky-500"
  }

  badgeClass(level) {
    if level is "success" {
      return "text-[10px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400"
    }
    if level is "warning" {
      return "text-[10px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500"
    }
    if level is "error" {
      return "text-[10px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500"
    }
    return "text-[10px] font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400"
  }

  // Opens the console's log view, optionally on one event.
  openConsole(entry) {
    const flux = Reflect.get(window, "__flux")
    if flux {
      flux.emit("flux:console", { kind: "server", id: this.serverId, tab: "logs", entry: entry ? "" + entry : "" })
    }
  }

  async load() {
    this.busy = true
    this.error = ""
    const result = await useApi("/api/servers/" + this.serverId + "/logs?limit=200")

    if result.ok and Array.isArray(result.data) {
      const tally = { error: 0, warning: 0, success: 0, info: 0 }
      result.data.forEach((l) => {
        const k = l.level is "error" or l.level is "warning" or l.level is "success" ? l.level : "info"
        Reflect.set(tally, k, Reflect.get(tally, k) + 1)
      })
      this.counts = tally
      this.logs = result.data.slice(0, 8).map((l) => Object.assign({}, l, {
        dateText: this.fmtDate(l.created_at),
        dotCls: this.dotClass(l.level),
        badgeCls: this.badgeClass(l.level)
      }))
    } else {
      this.fail(result, "Couldn't load the logs.")
    }
    this.busy = false
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.server = result.data
        this.loading = false
        await this.load()
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="logs" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <LoaderMark label="Loading…" />
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>

      <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 mb-1">Logs</h1>
      <p class="text-slate-500 text-sm mb-6">Everything that happened to this server, newest first: creation, edits, reboots and blocked actions. Keys and passwords are never recorded.</p>

{{#if error}}
      <p role="alert" class="text-rose-500 text-sm mb-4 break-words">{{ error }}</p>
{{/if}}

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
        <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Errors</p>
          <p class="text-2xl font-bold {{ counts.error > 0 ? 'text-rose-600 dark:text-rose-400' : 'text-slate-900 dark:text-slate-100' }}">{{ counts.error }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Warnings</p>
          <p class="text-2xl font-bold {{ counts.warning > 0 ? 'text-amber-600 dark:text-amber-400' : 'text-slate-900 dark:text-slate-100' }}">{{ counts.warning }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Succeeded</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ counts.success }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs mb-1">Info</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ counts.info }}</p>
        </div>
      </div>

      <div class="mb-6">
        <ConsoleLauncher href="{{ '/servers/server-logs?id=' + serverId }}" kind="logs" heading="Read the full log" body="Filter by level or area, grep the messages, expand any event's details, and follow new ones live." host="{{ server.name }}" cmd="" label="Open logs" locked="{{ false }}" />
      </div>

      <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-1.5 h-5 shrink-0 rounded-full bg-brand-500"></span>
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Latest events</h2>
          </div>
          <button onclick="{{ load() }}" class="shrink-0 text-sm text-slate-600 dark:text-slate-300 hover:text-brand-600 px-2 py-1">{{ busy ? "Loading…" : "Refresh" }}</button>
        </div>

{{#each l in logs}}
        <div class="flex items-start gap-3 rounded-xl border border-line px-4 py-3 mb-2">
          <span class="{{ l.dotCls }}"></span>
          <div class="min-w-0 flex-1">
            <p class="text-slate-900 dark:text-slate-100 text-sm break-words">{{ l.message }}</p>
            <p class="text-slate-500 text-xs mt-0.5">
              <span class="{{ l.badgeCls }}">{{ l.level }}</span>
              <span class="font-mono ml-2">{{ l.event }}</span>
              <span class="ml-2">{{ l.dateText }}</span>
            </p>
          </div>
          <button onclick="{{ openConsole(l.id) }}" class="shrink-0 text-xs text-slate-600 dark:text-slate-300 border border-line-strong rounded-full px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">View</button>
        </div>
{{#else}}
        <div class="rounded-xl border border-dashed border-line-strong p-6 text-center">
          <p class="text-slate-500 text-sm">{{ busy ? "Loading…" : "No events yet." }}</p>
        </div>
{{/each}}
      </section>
{{/if}}

    </div>
    </div>
  </div>
