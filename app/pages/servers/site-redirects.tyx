page SiteRedirects


title "Site redirects"

needs
  Auth

uses
  Billing

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  isMissing: false
  canEdit: false
  redirects: []
  limit: 100
  listLoading: false
  listError: ""
  matchType: "exact"
  fromPath: ""
  toTarget: ""
  codeText: "301"
  error: ""
  message: ""
  saving: false

action
  decorate(list) {
    return list.map((r) => Object.assign({}, r, {
      kind: r.match is "prefix" ? "Path and everything under it" : "Exact path",
      fromText: r.match is "prefix" ? r.from + "/…" : r.from
    }))
  }

  async loadRedirects() {
    this.listLoading = true
    this.listError = ""

    const result = await useApi("/api/sites/" + this.siteId + "/redirects")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.redirects = this.decorate(result.data.redirects)
      this.limit = result.data.limit
    } else {
      this.listError = result.data?.error or "Couldn't load the redirects."
    }

    this.listLoading = false
  }

  async add() {
    if Billing.locked {
      return null
    }
    if this.saving {
      return null
    }

    this.error = ""
    this.message = ""

    if this.fromPath.trim() is "" or this.toTarget.trim() is "" {
      this.error = "Fill in both the old address and where it should go."
      return null
    }

    this.saving = true

    const result = await useApi("/api/sites/" + this.siteId + "/redirects", {
      method: "POST",
      body: {
        from: this.fromPath,
        to: this.toTarget,
        code: Number(this.codeText),
        match: this.matchType
      }
    })

    if result.ok {
      this.redirects = this.decorate(result.data.redirects)
      this.fromPath = ""
      this.toTarget = ""
      this.message = "Added. nginx accepted the change and was reloaded."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't save the redirect."
    }

    this.saving = false
  }

  async remove(id, label) {
    if Billing.locked {
      return null
    }
    if not window.confirm("Remove the redirect for " + label + "?") {
      return null
    }

    this.error = ""
    this.message = ""

    const result = await useApi("/api/sites/" + this.siteId + "/redirects/" + id, { method: "DELETE" })

    if result.ok {
      this.redirects = this.decorate(result.data.redirects)
      this.message = "Removed. nginx was reloaded."
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't remove the redirect."
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.site = result.data
        this.serverId = "" + result.data.server_id
        this.canEdit = result.data.status is "ready"

        if this.canEdit {
          await this.loadRedirects()
        }
        this.loading = false
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="redirects" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading redirects…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Redirects" description="Send visitors from old addresses on this site to new ones." domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}" />

      <LockedBanner />

      <div class="min-w-0">
        <div class="min-w-0 flex-1">

          <div class="rounded-2xl border border-line bg-panel p-6 shadow-sm dark:shadow-none mb-6">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Add a redirect</h2>
            <p class="text-slate-500 text-sm mb-5">Send visitors from an old address on this site to a new one. The query string is kept. Every change is tested with <span class="font-mono">nginx -t</span> before nginx reloads, and rolled back if the test fails.</p>

{{#if not canEdit}}
            <p class="text-slate-500 text-sm">Redirects can be added once the site has finished creating.</p>
{{/if}}

{{#if canEdit}}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="min-w-0">
                <p class="text-slate-500 text-xs mb-1">Old address (on this site)</p>
                <input
                  type="text"
                  value="{{ fromPath }}"
                  oninput="{{ fromPath = $event.target.value }}"
                  spellcheck="false"
                  class="w-full rounded-lg border border-line bg-sunken text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
                  placeholder="/old-page"
                />
              </div>
              <div class="min-w-0">
                <p class="text-slate-500 text-xs mb-1">Send to</p>
                <input
                  type="text"
                  value="{{ toTarget }}"
                  oninput="{{ toTarget = $event.target.value }}"
                  spellcheck="false"
                  class="w-full rounded-lg border border-line bg-sunken text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
                  placeholder="/new-page or https://example.com/page"
                />
              </div>
              <div class="min-w-0">
                <p class="text-slate-500 text-xs mb-1">Matches</p>
                <select
                  value="{{ matchType }}"
                  onchange="{{ matchType = $event.target.value }}"
                  class="w-full rounded-lg border border-line bg-sunken text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
                >
                  <option value="exact">Exact path only</option>
                  <option value="prefix">This path and everything under it</option>
                </select>
              </div>
              <div class="min-w-0">
                <p class="text-slate-500 text-xs mb-1">Type</p>
                <select
                  value="{{ codeText }}"
                  onchange="{{ codeText = $event.target.value }}"
                  class="w-full rounded-lg border border-line bg-sunken text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
                >
                  <option value="301">301 Permanent</option>
                  <option value="302">302 Temporary</option>
                  <option value="308">308 Permanent (keeps the request method)</option>
                  <option value="307">307 Temporary (keeps the request method)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-3 mt-5">
{{#if Billing.locked}}
              <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-5 py-2 cursor-not-allowed select-none">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
                Add redirect
              </button>
{{/if}}
{{#if not Billing.locked}}
              <button onclick="{{ add() }}" class="text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-brand-400 transition-all">
                {{#if saving}}Testing and saving…{{/if}}{{#if not saving}}Add redirect{{/if}}
              </button>
{{/if}}
            </div>

{{#if error}}
            <div role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 mt-4">
              <p class="text-rose-500 text-xs font-mono whitespace-pre-wrap break-words">{{ error }}</p>
            </div>
{{/if}}

{{#if message}}
            <p role="status" class="text-brand-700 dark:text-brand-500 text-sm mt-4">{{ message }}</p>
{{/if}}
{{/if}}
          </div>

          <div class="rounded-2xl border border-line bg-panel p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Active redirects</h2>
            <p class="text-slate-500 text-sm mb-5">{{ redirects.length }} of {{ limit }} used.</p>

{{#if listLoading}}
{{#if not loading}}
            <LoaderMark label="Loading the redirects…" size="sm" />
{{/if}}
{{/if}}

{{#if listError}}
            <p role="alert" class="text-rose-500 text-sm mb-4">{{ listError }}</p>
{{/if}}

{{#if canEdit}}
{{#if redirects.length is 0}}
{{#if not listLoading}}
            <p class="text-slate-500 text-sm">No redirects yet.</p>
{{/if}}
{{/if}}
{{/if}}

{{#each r in redirects}}
            <div class="rounded-xl border border-line bg-sunken p-4 mb-3">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="text-[11px] font-semibold font-mono text-brand-700 dark:text-brand-500">{{ r.code }}</span>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">{{ r.kind }}</span>
                  </div>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ r.fromText }}</p>
                  <p class="text-slate-500 text-sm font-mono break-all mt-1">&rarr; {{ r.to }}</p>
                </div>
{{#if Billing.locked}}
                <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-4 py-1.5 cursor-not-allowed select-none">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                    <rect x="4" y="9" width="12" height="8" rx="2" />
                    <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                  </svg>
                  Remove
                </button>
{{/if}}
{{#if not Billing.locked}}
                <button onclick="{{ remove(r.id, r.from) }}" class="shrink-0 text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-1.5 hover:bg-rose-500/5 transition-colors">Remove</button>
{{/if}}
              </div>
            </div>
{{/each}}
          </div>

        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>