page ServerPackages

import { IconArrowLeft } from "tylix-icons"

title "Packages"

needs
  Auth

uses
  Billing

background
  Billing

state
  checkedAuth: false
  loading: true
  serverId: ""
  serverName: ""
  loadError: ""
  actionError: ""
  catalog: []
  groups: []
  presetRows: []
  selected: []
  picked: []
  pickedText: "Nothing yet"
  query: ""
  noMatch: false
  task: null
  taskText: ""
  taskStep: ""
  taskFailed: false
  taskLabel: "None yet"
  taskCls: ""
  taskDot: ""
  busy: false
  installing: false
  confirmUpgrade: false
  installedCount: 0
  totalCount: 0
  percent: 0
  installLabel: "Install selected"
  installCls: ""
  installBarCls: ""
  upgradeLabel: "Update packages"
  upgradeCls: ""
  lastError: ""
  codeOpen: false
  codeValue: ""
  codeError: ""
  codeTitle: ""
  codeBusy: false
  pending: null

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  // Ids match the catalog in services/Installers.ts. Only what is missing gets selected.
  presetDefs() {
    return [
      { id: "laravel", label: "Laravel", note: "PHP 8.4, Composer, Node.js, git", ids: ["php8.4", "composer", "node", "tools"] },
      { id: "node", label: "Node, Next, Nuxt, Vue", note: "Node.js 22, git and build tools", ids: ["node", "tools"] },
      { id: "python", label: "FastAPI and Django", note: "Python 3, git and build tools", ids: ["python", "tools"] },
      { id: "java", label: "Java API", note: "Java 21 and Maven", ids: ["java", "tools"] },
      { id: "go", label: "Go", note: "Go, git and build tools", ids: ["go", "tools"] },
      { id: "ruby", label: "Ruby and Rails", note: "Ruby, Bundler, git", ids: ["ruby", "tools"] },
      { id: "dotnet", label: ".NET", note: ".NET 8 SDK, git", ids: ["dotnet", "tools"] },
      { id: "rust", label: "Rust", note: "rustup and cargo, git", ids: ["rust", "tools"] }
    ]
  }

  tone(enabled) {
    const on = "text-sm font-semibold rounded-full py-2.5 transition-all bg-brand-500 text-white dark:text-slate-950 shadow-sm hover:bg-brand-400"
    const off = "text-sm font-semibold rounded-full py-2.5 transition-all bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 cursor-not-allowed"
    return enabled ? on : off
  }

  // One label and one class string per button, so each button is a single element.
  refreshActions() {
    const locked = Billing.locked
    const count = this.selected.length
    const canInstall = not locked and not this.busy and not this.installing and count > 0
    const canUpgrade = not locked and not this.busy and not this.installing

    let label = "Install selected"
    if locked {
      label = "Pay to continue"
    } else if this.busy {
      label = "Install running…"
    } else if this.installing {
      label = "Starting…"
    } else if count > 0 {
      label = count is 1 ? "Install 1 package" : "Install " + count + " packages"
    }

    let upLabel = "Update packages"
    if locked {
      upLabel = "Pay to continue"
    } else if this.busy or this.installing {
      upLabel = "Working…"
    }

    this.installLabel = label
    this.installCls = "w-full px-5 " + this.tone(canInstall)
    this.installBarCls = "min-h-[48px] px-6 " + this.tone(canInstall)
    this.upgradeLabel = upLabel
    this.upgradeCls = "shrink-0 w-full sm:w-auto px-5 " + this.tone(canUpgrade)
  }

  itemFor(p, checked) {
    const base = "min-h-[52px] w-full flex items-center justify-between gap-3 text-left rounded-xl border px-3.5 py-2.5 text-sm transition-colors "
    const brandTag = "shrink-0 text-[11px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500"
    let cls = base + "border-line text-slate-700 dark:text-slate-300 hover:border-brand-500/40"
    let tag = "Add"
    let tagCls = "shrink-0 text-[11px] uppercase tracking-wider text-slate-500"
    let dot = "w-2 h-2 shrink-0 rounded-full bg-slate-300 dark:bg-slate-700"

    if p.installed {
      cls = base + "border-line text-slate-900 dark:text-slate-100 cursor-default"
      tag = "Installed"
      tagCls = brandTag
      dot = "w-2 h-2 shrink-0 rounded-full bg-brand-500"
    } else if checked {
      cls = base + "border-brand-500 bg-brand-500/5 text-slate-900 dark:text-slate-100"
      tag = "Selected"
      tagCls = brandTag
      dot = "w-2 h-2 shrink-0 rounded-full bg-brand-500"
    }

    return { id: p.id, label: p.label, cls: cls, tag: tag, tagCls: tagCls, dot: dot }
  }

  rebuild() {
    const q = this.query.trim().toLowerCase()
    const visible = this.catalog.filter((p) => q is "" or (p.label + " " + p.group).toLowerCase().includes(q))

    const list = visible.reduce((acc, p) => {
      let g = acc.find((x) => x.name is p.group)
      if not g {
        g = { name: p.group, done: 0, items: [] }
        acc.push(g)
      }
      g.items.push(this.itemFor(p, this.selected.indexOf(p.id) >= 0))
      if p.installed {
        g.done = g.done + 1
      }
      return acc
    }, [])

    this.groups = list.map((g) => Object.assign({}, g, { meta: g.done + " of " + g.items.length + " installed" }))
    this.noMatch = visible.length is 0 and this.catalog.length > 0

    this.picked = this.catalog.filter((p) => this.selected.indexOf(p.id) >= 0)
    this.pickedText = this.picked.length is 0 ? "Nothing yet" : this.picked.map((p) => p.label).join(", ")
    this.totalCount = this.catalog.length
    this.installedCount = this.catalog.filter((p) => p.installed).length
    this.percent = this.totalCount is 0 ? 0 : Math.round((this.installedCount / this.totalCount) * 100)

    const presetBase = "block w-full text-left rounded-xl border px-4 py-3.5 transition-colors "
    const brandTag = "shrink-0 text-[11px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500"

    this.presetRows = this.presetDefs().map((d) => {
      const known = d.ids.filter((id) => this.catalog.some((c) => c.id is id))
      const missing = known.filter((id) => this.catalog.some((c) => c.id is id and not c.installed))
      const done = known.length > 0 and missing.length is 0
      const chosen = missing.length > 0 and missing.every((id) => this.selected.indexOf(id) >= 0)
      const pct = known.length is 0 ? 0 : Math.round(((known.length - missing.length) / known.length) * 100)

      let cls = presetBase + "border-line hover:border-brand-500/40"
      let tag = missing.length + " to add"
      let tagCls = "shrink-0 text-[11px] uppercase tracking-wider text-slate-500"

      if done {
        cls = presetBase + "border-line cursor-default"
        tag = "Ready"
        tagCls = brandTag
      } else if chosen {
        cls = presetBase + "border-brand-500 bg-brand-500/5"
        tag = "Selected"
        tagCls = brandTag
      }

      return Object.assign({}, d, { cls: cls, tag: tag, tagCls: tagCls, bar: "width: " + pct + "%" })
    })

    this.refreshActions()
  }

  setQuery(v) {
    this.query = v
    this.rebuild()
  }

  setTask(t) {
    this.task = t
    this.taskText = ""
    this.taskStep = ""
    this.taskFailed = false
    this.taskLabel = "None yet"
    this.taskCls = ""
    this.taskDot = ""

    if t {
      this.taskText = t.packages.indexOf("upgrade") >= 0 ? "Update of installed packages" : t.packages.join(", ")
      this.taskStep = t.step or ""
      this.taskFailed = t.status is "failed"

      const base = "inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider "
      const dot = "w-1.5 h-1.5 rounded-full "

      if t.status is "done" {
        this.taskLabel = "Done"
        this.taskCls = base + "text-brand-700 dark:text-brand-500"
        this.taskDot = dot + "bg-brand-500"
      } else if t.status is "failed" {
        this.taskLabel = "Failed"
        this.taskCls = base + "text-rose-600 dark:text-rose-500"
        this.taskDot = dot + "bg-rose-500"
      } else if t.status is "running" {
        this.taskLabel = "Working"
        this.taskCls = base + "text-amber-600 dark:text-amber-500"
        this.taskDot = dot + "bg-amber-500 animate-pulse"
      } else {
        this.taskLabel = "Queued"
        this.taskCls = base + "text-amber-600 dark:text-amber-500"
        this.taskDot = dot + "bg-amber-500 animate-pulse"
      }
    }

    if t and (t.status is "running" or t.status is "pending") {
      this.busy = true
    } else {
      this.busy = false
    }

    this.refreshActions()
  }

  toggle(id) {
    if this.catalog.some((c) => c.id is id and c.installed) {
      return null
    }

    if this.selected.indexOf(id) >= 0 {
      this.selected = this.selected.filter((x) => x is not id)
    } else {
      this.selected = this.selected.concat([id])
    }
    this.rebuild()
  }

  applyPreset(id) {
    const def = this.presetDefs().find((d) => d.id is id)
    if not def {
      return null
    }

    const missing = def.ids.filter((x) => this.catalog.some((c) => c.id is x and not c.installed))
    if missing.length is 0 {
      return null
    }

    const allChosen = missing.every((x) => this.selected.indexOf(x) >= 0)
    if allChosen {
      this.selected = this.selected.filter((x) => missing.indexOf(x) < 0)
    } else {
      const keep = this.selected.filter((x) => missing.indexOf(x) < 0)
      this.selected = keep.concat(missing)
    }
    this.rebuild()
  }

  clearSelection() {
    this.selected = []
    this.rebuild()
  }

  askUpgrade() {
    if Billing.locked or this.busy or this.installing {
      return null
    }
    this.actionError = ""
    this.confirmUpgrade = true
  }

  cancelUpgrade() {
    this.confirmUpgrade = false
  }

  needsCode(result) {
    if result.status is not 403 {
      return false
    }

    const d = result.data or {}
    const text = ("" + (d.error or "") + " " + (d.code or "")).toLowerCase()
    return d.two_factor_required is true or d.code is "two_factor_required" or text.includes("two_factor") or text.includes("two-factor")
  }

  askCode(kind, title) {
    this.pending = { kind: kind }
    this.codeTitle = title
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
    this.codeOpen = true
    window.setTimeout(() => {
      const el = document.getElementById("step-up-code")
      if el {
        el.focus()
      }
    }, 80)
  }

  closeCode() {
    this.codeOpen = false
    this.pending = null
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
  }

  async submitCode() {
    if this.codeBusy or not this.pending {
      return null
    }

    const code = this.codeValue.trim()
    if code is "" {
      this.codeError = "Enter your code."
      return null
    }

    this.codeBusy = true
    this.codeError = ""
    const kind = this.pending.kind
    let outcome = "failed"

    if kind is "upgrade" {
      outcome = await this.runUpgrade(code)
    } else {
      outcome = await this.runInstall(code)
    }

    if outcome is "done" {
      this.closeCode()
      return null
    }

    this.codeError = this.lastError or "That code didn't work. Try again."
    this.codeValue = ""
    this.codeBusy = false
  }

  async loadCatalog() {
    this.loadError = ""
    const result = await useApi("/api/servers/" + this.serverId + "/packages")

    if result.ok {
      this.catalog = result.data.packages
      this.setTask(result.data.task)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.loadError = result.data?.error or "Couldn't check this server."
    }

    this.rebuild()
  }

  async pollTask() {
    if not this.busy {
      return null
    }

    const result = await useApi("/api/servers/" + this.serverId + "/packages/task")

    if result.ok and result.data.task {
      this.setTask(result.data.task)
      if not this.busy {
        await this.loadCatalog()
      }
    }
  }

  async runInstall(code) {
    const payload = code ? { packages: this.selected, code: code } : { packages: this.selected }
    const result = await useApi("/api/servers/" + this.serverId + "/packages", { method: "POST", body: payload })

    if result.ok {
      this.selected = []
      this.setTask(result.data.task)
      this.rebuild()
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't start the install."
    return this.needsCode(result) ? "code" : "failed"
  }

  async runUpgrade(code) {
    const payload = code ? { code: code } : {}
    const result = await useApi("/api/servers/" + this.serverId + "/packages/upgrade", { method: "POST", body: payload })

    if result.ok {
      this.setTask(result.data.task)
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't start the update."
    return this.needsCode(result) ? "code" : "failed"
  }

  async install() {
    if Billing.locked {
      this.actionError = "Pay to continue installing packages."
      return null
    }
    if this.installing or this.busy or this.selected.length is 0 {
      return null
    }

    this.installing = true
    this.actionError = ""
    this.refreshActions()

    const outcome = await this.runInstall("")

    if outcome is "code" {
      this.askCode("install", "Confirm to install these packages")
    } else if outcome is "failed" {
      this.actionError = this.lastError
    }

    this.installing = false
    this.refreshActions()
  }

  // Updates everything already installed on the server to the latest version.
  async upgrade() {
    if Billing.locked {
      this.actionError = "Pay to continue updating packages."
      this.confirmUpgrade = false
      return null
    }
    if this.installing or this.busy {
      return null
    }

    this.installing = true
    this.confirmUpgrade = false
    this.actionError = ""
    this.refreshActions()

    const outcome = await this.runUpgrade("")

    if outcome is "code" {
      this.askCode("upgrade", "Confirm to update packages")
    } else if outcome is "failed" {
      this.actionError = this.lastError
    }

    this.installing = false
    this.refreshActions()
  }

  async retryTask() {
    if Billing.locked {
      this.actionError = "Pay to continue."
      return null
    }
    if not this.task {
      return null
    }

    // A failed update is retried as an update, not as a list of packages.
    if this.task.packages.indexOf("upgrade") >= 0 {
      await this.upgrade()
      return null
    }

    this.selected = this.task.packages.filter((id) => this.catalog.filter((c) => c.id is id and c.installed).length is 0)
    this.rebuild()
    await this.install()
  }

  onKey(e) {
    if e.key is "Escape" {
      if this.codeOpen {
        this.closeCode()
      } else if this.confirmUpgrade {
        this.cancelUpgrade()
      }
      return null
    }

    if e.key is "Enter" and this.codeOpen {
      e.preventDefault()
      this.submitCode()
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const old = this.global("tylixPackagesKey")
    if old {
      document.removeEventListener("keydown", old)
    }
    const keyHandler = (e) => this.onKey(e)
    document.addEventListener("keydown", keyHandler)
    this.setGlobal("tylixPackagesKey", keyHandler)

    const params = new URLSearchParams(window.location.search)
    const sid = params.get("id")

    if not sid {
      window.location.href = "/servers"
      return null
    }

    this.serverId = sid

    const server = await useApi("/api/servers/" + sid)
    if server.ok {
      this.serverName = server.data.name
    }

    await this.loadCatalog()
    this.loading = false
    this.checkedAuth = true

    const oldTimer = this.global("tylixPackagesTimer")
    if oldTimer {
      window.clearInterval(oldTimer)
    }
    this.setGlobal("tylixPackagesTimer", window.setInterval(() => this.pollTask(), 3000))
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-page transition-colors">
    <Sidebar active="servers" />
    <ServerSidebar active="packages" serverId="{{ serverId }}" />
    <div class="min-w-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 pt-6 sm:pt-10 pb-4">

      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-5 py-1">
        <IconArrowLeft class="w-4 h-4" /> {{ serverName }}
      </a>

      <LockedBanner />

      <div class="rounded-2xl border border-line bg-panel px-5 sm:px-8 py-8 sm:py-10 mb-5">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-700 dark:text-brand-400 mb-4 max-w-full">
          <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-brand-500 animate-pulse"></span>
          <span class="truncate">Packages on {{ serverName }}</span>
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.05] text-slate-900 dark:text-slate-100 mb-3">
          Get the server
          <br class="hidden sm:block" />
          <span class="text-brand-500">ready for any stack</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base max-w-xl leading-relaxed">Pick a stack or choose packages one by one. Anything already on the server is marked installed, and installs run over SSH one step at a time.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Installed</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{{ installedCount }} <span class="text-base font-medium text-slate-500">of {{ totalCount }}</span></p>
          <div class="mt-3 h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
            <div class="h-1.5 rounded-full bg-brand-500 transition-all" style="width: {{ percent }}%"></div>
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none min-w-0">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Selected</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{{ selected.length }}</p>
          <p class="text-slate-500 text-xs mt-3 truncate">{{ pickedText }}</p>
        </div>
        <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none min-w-0">
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2">Last install</p>
          <p class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 truncate">{{ taskLabel }}</p>
          <p class="text-slate-500 text-xs mt-3 truncate">{{ taskText }}</p>
        </div>
      </div>

{{#if loadError}}
      <div role="alert" class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-rose-500/30 bg-rose-500/5 px-4 py-3 mb-6">
        <p class="text-rose-600 dark:text-rose-400 text-sm break-words">{{ loadError }}</p>
        <button onclick="{{ loadCatalog() }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3.5 py-2 sm:py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Try again</button>
      </div>
{{/if}}

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-6 items-start">

        <div class="min-w-0 space-y-4 sm:space-y-5">

{{#if task}}
          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Last install</h2>
                <p class="text-slate-500 text-xs font-mono mt-1 break-words">{{ taskText }}</p>
              </div>
              <span class="{{ taskCls }}">
                <span class="{{ taskDot }}"></span> {{ taskLabel }}
              </span>
            </div>

{{#if busy}}
            <div class="mt-4 h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
              <div class="h-1.5 w-1/3 rounded-full bg-brand-500 animate-pulse"></div>
            </div>
            <p class="text-slate-500 text-xs mt-3 break-words">{{ taskStep }}</p>
            <p class="text-slate-500 text-xs mt-1">This can take several minutes. You can leave this page; the install keeps running.</p>
{{/if}}

{{#if taskFailed}}
            <pre class="mt-4 max-h-40 overflow-auto rounded-lg bg-slate-100 dark:bg-slate-950 border border-line p-3 text-xs text-rose-600 dark:text-rose-400 font-mono whitespace-pre-wrap break-words">{{ task.error }}</pre>
            <div class="mt-4">
              <button onclick="{{ retryTask() }}" class="w-full sm:w-auto text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Retry</button>
            </div>
{{/if}}
          </section>
{{/if}}

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-1">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">1</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">What will you host?</h2>
            </div>
            <p class="text-slate-500 text-sm mb-4 sm:pl-10">Tap a stack to select everything it needs that isn't on the server yet.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each pr in presetRows}}
              <button onclick="{{ applyPreset(pr.id) }}" class="{{ pr.cls }}">
                <span class="flex items-center justify-between gap-3">
                  <span class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate">{{ pr.label }}</span>
                  <span class="{{ pr.tagCls }}">{{ pr.tag }}</span>
                </span>
                <span class="block text-xs text-slate-500 truncate mt-0.5">{{ pr.note }}</span>
                <span class="block h-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden mt-3">
                  <span class="block h-full rounded-full bg-brand-500 transition-all" style="{{ pr.bar }}"></span>
                </span>
              </button>
{{/each}}
            </div>
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">2</span>
                <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Or pick packages</h2>
              </div>
              <input
                type="text"
                autocomplete="off"
                spellcheck="false"
                value="{{ query }}"
                oninput="{{ setQuery($event.target.value) }}"
                placeholder="Search packages"
                class="w-full sm:w-56 rounded-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
              />
            </div>

{{#each g in groups}}
            <div class="mb-5 last:mb-0">
              <div class="flex items-center justify-between mb-2.5">
                <h3 class="text-slate-500 text-xs font-semibold uppercase tracking-wider">{{ g.name }}</h3>
                <span class="text-slate-500 text-[11px]">{{ g.meta }}</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each r in g.items}}
                <button onclick="{{ toggle(r.id) }}" class="{{ r.cls }}">
                  <span class="flex items-center gap-2.5 min-w-0">
                    <span class="{{ r.dot }}"></span>
                    <span class="break-words min-w-0">{{ r.label }}</span>
                  </span>
                  <span class="{{ r.tagCls }}">{{ r.tag }}</span>
                </button>
{{/each}}
              </div>
            </div>
{{/each}}

{{#if noMatch}}
            <p class="py-8 text-center text-slate-500 text-sm">No packages match your search.</p>
{{/if}}
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-7 h-7 shrink-0 rounded-full bg-brand-500/10 text-brand-700 dark:text-brand-500 flex items-center justify-center text-xs font-bold">3</span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Keep it up to date</h2>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <p class="text-slate-500 text-sm min-w-0">Brings everything installed on this server up to the latest version. Services restart briefly while they update.</p>
              <button onclick="{{ askUpgrade() }}" class="{{ upgradeCls }}">{{ upgradeLabel }}</button>
            </div>
          </section>

{{#if actionError}}
          <div role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 px-4 py-3">
            <p class="text-rose-600 dark:text-rose-400 text-sm break-words">{{ actionError }}</p>
          </div>
{{/if}}

          <div class="lg:hidden sticky bottom-0 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 bg-slate-100/90 dark:bg-slate-950/90 backdrop-blur border-t border-line flex items-center justify-between gap-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
            <div class="flex items-center gap-3 min-w-0">
              <p class="text-slate-600 dark:text-slate-300 text-sm whitespace-nowrap">{{ selected.length }} selected</p>
{{#if selected.length is not 0}}
              <button onclick="{{ clearSelection() }}" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 py-2 transition-colors">Clear</button>
{{/if}}
            </div>
            <button onclick="{{ install() }}" class="{{ installBarCls }}">{{ installLabel }}</button>
          </div>

        </div>

        <aside class="hidden lg:block lg:sticky lg:top-6 space-y-4">
          <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-4">Your install</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-slate-500 text-xs">Server</dt>
                <dd class="text-slate-900 dark:text-slate-100 break-words">{{ serverName }}</dd>
              </div>
              <div>
                <dt class="text-slate-500 text-xs">Installed</dt>
                <dd class="text-slate-900 dark:text-slate-100">{{ installedCount }} of {{ totalCount }}</dd>
              </div>
              <div>
                <dt class="text-slate-500 text-xs">Selected</dt>
                <dd class="text-slate-900 dark:text-slate-100 break-words">{{ pickedText }}</dd>
              </div>
            </dl>

            <div class="mt-5">
              <button onclick="{{ install() }}" class="{{ installCls }}">{{ installLabel }}</button>
{{#if selected.length is not 0}}
              <button onclick="{{ clearSelection() }}" class="w-full mt-2 text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 py-2 transition-colors">Clear selection</button>
{{/if}}
            </div>
          </div>

          <div class="rounded-2xl border border-line bg-panel p-5 shadow-sm dark:shadow-none">
            <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3">What happens next</h2>
            <ol class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              <li class="flex gap-2"><span class="text-brand-600 dark:text-brand-500">&#10003;</span> Runs over SSH, one step at a time</li>
              <li class="flex gap-2"><span class="text-brand-600 dark:text-brand-500">&#10003;</span> Skips anything already installed</li>
              <li class="flex gap-2"><span class="text-brand-600 dark:text-brand-500">&#10003;</span> Keeps going if you leave the page</li>
            </ol>
            <p class="text-slate-500 text-xs mt-4 pt-3 border-t border-line">Installing needs the admin role. If you use two-factor, you'll be asked for a code.</p>
          </div>
        </aside>

      </div>

    </div>
    </div>
  </div>

{{#if confirmUpgrade}}
  <div class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-6">
    <div onclick="{{ cancelUpgrade() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <div role="dialog" aria-modal="true" aria-label="Update packages" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
      <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Update all installed packages?</h3>
      <p class="text-slate-500 text-sm">Everything installed on this server is brought up to the latest version. Services restart briefly while they update.</p>

      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
        <button onclick="{{ cancelUpgrade() }}" class="w-full sm:w-auto text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
        <button onclick="{{ upgrade() }}" class="w-full sm:w-auto text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">Yes, update now</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if codeOpen}}
  <div class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-6">
    <div onclick="{{ closeCode() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <div role="dialog" aria-modal="true" aria-label="Two-factor code" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
      <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">{{ codeTitle }}</h3>
      <p class="text-slate-500 text-sm mb-4">Enter the code from your authenticator app or the SMS we sent you.</p>

      <input
        id="step-up-code"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        autocapitalize="none"
        spellcheck="false"
        maxlength="12"
        value="{{ codeValue }}"
        oninput="{{ codeValue = $event.target.value }}"
        placeholder="123456"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base tracking-widest font-mono px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
      />

{{#if codeError}}
      <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ codeError }}</p>
{{/if}}

      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
        <button onclick="{{ closeCode() }}" class="w-full sm:w-auto text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
        <button onclick="{{ submitCode() }}" class="w-full sm:w-auto text-sm bg-brand-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">{{ codeBusy ? "Checking…" : "Confirm" }}</button>
      </div>
    </div>
  </div>
{{/if}}
{{/if}}

{{#if not checkedAuth}}
<PageLoader label="Loading packages..." />
{{/if}}