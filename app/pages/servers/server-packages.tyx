page ServerPackages

import { IconChevronRight, IconRefresh, IconArrowPath, IconExclamationTriangle, IconXCircle, IconCheckCircle, IconInformationCircle, IconTerminal, IconCheck, IconCopy, IconSearch, IconX } from "tylix-icons"

title "Packages"

needs
  Auth

uses
  Billing

background
  Billing

state
  checkedAuth: false
  loading: true
  serverId: ""
  serverName: ""
  loadError: ""
  actionError: ""
  catalog: []
  groups: []
  presetRows: []
  selected: []
  picked: []
  pickedText: "Nothing yet"
  query: ""
  noMatch: false
  task: null
  taskText: ""
  taskStep: ""
  taskFailed: false
  taskLabel: "None yet"
  taskCls: ""
  taskDot: ""
  busy: false
  installing: false
  confirmUpgrade: false
  installedCount: 0
  totalCount: 0
  percent: 0
  installLabel: "Install selected"
  installCls: ""
  installBarCls: ""
  upgradeLabel: "Update packages"
  upgradeCls: ""
  lastError: ""
  codeOpen: false
  codeValue: ""
  codeError: ""
  codeTitle: ""
  codeBusy: false
  pending: null
  showLog: false
  logCopied: false
  logLines: []
  logAtBottom: true
  taskTitle: ""
  taskReason: ""
  taskHint: ""
  taskWaiting: false
  taskDone: false
  progressStyle: "width: 0%"
  stepText: ""
  extrasText: ""

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  // Ids match the catalog in services/Installers.ts. Only what is missing gets selected.
  presetDefs() {
    return [
      { id: "laravel", label: "Laravel", note: "PHP 8.4, Composer, Node.js, git", ids: ["php8.4", "composer", "node", "tools"] },
      { id: "node", label: "Node, Next, Nuxt, Vue", note: "Node.js 22, git and build tools", ids: ["node", "tools"] },
      { id: "python", label: "FastAPI and Django", note: "Python 3, git and build tools", ids: ["python", "tools"] },
      { id: "java", label: "Java API", note: "Java 21 and Maven", ids: ["java", "tools"] },
      { id: "go", label: "Go", note: "Go, git and build tools", ids: ["go", "tools"] },
      { id: "ruby", label: "Ruby and Rails", note: "Ruby, Bundler, git", ids: ["ruby", "tools"] },
      { id: "dotnet", label: ".NET", note: ".NET 8 SDK, git", ids: ["dotnet", "tools"] },
      { id: "rust", label: "Rust", note: "rustup and cargo, git", ids: ["rust", "tools"] }
    ]
  }

  tone(enabled) {
    const on = "text-sm font-semibold rounded-full py-2.5 transition-all bg-brand-500 text-white shadow-sm hover:bg-brand-400"
    const off = "text-sm font-semibold rounded-full py-2.5 transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-500 cursor-not-allowed"
    return enabled ? on : off
  }

  // One label and one class string per button, so each button is a single element.
  refreshActions() {
    const locked = Billing.locked
    const count = this.selected.length
    const canInstall = not locked and not this.busy and not this.installing and count > 0
    const canUpgrade = not locked and not this.busy and not this.installing

    let label = "Install selected"
    if locked {
      label = "Pay to continue"
    } else if this.busy {
      label = "Install running…"
    } else if this.installing {
      label = "Starting…"
    } else if count > 0 {
      label = count is 1 ? "Install 1 package" : "Install " + count + " packages"
    }

    let upLabel = "Update packages"
    if locked {
      upLabel = "Pay to continue"
    } else if this.busy or this.installing {
      upLabel = "Working…"
    }

    this.installLabel = label
    this.installCls = "w-full h-11 px-5 " + this.tone(canInstall)
    this.installBarCls = "h-11 px-5 " + this.tone(canInstall)
    this.upgradeLabel = upLabel
    this.upgradeCls = canUpgrade
      ? "inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
      : "inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-400 border border-line rounded-full px-4 cursor-not-allowed"
  }

  // One package row: a checkbox look, its state tag, and what it pulls in.
  itemFor(p, checked) {
    const base = "group w-full min-h-[52px] flex items-center gap-3 text-left px-4 py-3 transition-colors "
    let cls = base + "hover:bg-zinc-50 dark:hover:bg-white/[0.03]"
    let box = "w-[18px] h-[18px] shrink-0 rounded-[5px] border-2 border-zinc-300 dark:border-zinc-600 flex items-center justify-center text-white text-[11px] font-bold group-hover:border-brand-500/60"
    let mark = ""
    let tag = ""
    let tagCls = ""

    if p.installed {
      cls = base + "cursor-default"
      box = "w-[18px] h-[18px] shrink-0 rounded-[5px] bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[11px] font-bold"
      mark = "✓"
      tag = "Installed"
      tagCls = "shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400"
    } else if checked {
      cls = base + "bg-brand-500/[0.05]"
      box = "w-[18px] h-[18px] shrink-0 rounded-[5px] bg-brand-500 border-2 border-brand-500 flex items-center justify-center text-white text-[11px] font-bold"
      mark = "✓"
      tag = "Selected"
      tagCls = "shrink-0 rounded-full bg-brand-500/10 px-2 py-0.5 text-[11px] font-semibold text-brand-700 dark:text-brand-400"
    }

    const needs = (p.needs or []).map((id) => this.labelOf(id)).filter((x) => x)
    return { id: p.id, label: p.label, installed: p.installed, cls: cls, box: box, mark: mark, tag: tag, tagCls: tagCls, note: needs.length > 0 ? "Needs " + needs.join(", ") : "" }
  }

  labelOf(id) {
    const hit = this.catalog.find((c) => c.id is id)
    return hit ? hit.label : ""
  }

  rebuild() {
    const q = this.query.trim().toLowerCase()
    const visible = this.catalog.filter((p) => q is "" or (p.label + " " + p.group).toLowerCase().includes(q))

    const list = visible.reduce((acc, p) => {
      let g = acc.find((x) => x.name is p.group)
      if not g {
        g = { name: p.group, done: 0, items: [] }
        acc.push(g)
      }
      g.items.push(this.itemFor(p, this.selected.indexOf(p.id) >= 0))
      if p.installed {
        g.done = g.done + 1
      }
      return acc
    }, [])

    this.groups = list.map((g) => Object.assign({}, g, { meta: g.done + " of " + g.items.length + " installed" }))
    this.noMatch = visible.length is 0 and this.catalog.length > 0

    this.picked = this.catalog.filter((p) => this.selected.indexOf(p.id) >= 0)
    this.pickedText = this.picked.length is 0 ? "Nothing yet" : this.picked.map((p) => p.label).join(", ")
    this.totalCount = this.catalog.length
    this.installedCount = this.catalog.filter((p) => p.installed).length
    this.percent = this.totalCount is 0 ? 0 : Math.round((this.installedCount / this.totalCount) * 100)

    const presetBase = "group relative block w-full text-left rounded-xl border px-4 py-3.5 transition-colors "

    this.presetRows = this.presetDefs().map((d) => {
      const known = d.ids.filter((id) => this.catalog.some((c) => c.id is id))
      const missing = known.filter((id) => this.catalog.some((c) => c.id is id and not c.installed))
      const done = known.length > 0 and missing.length is 0
      const chosen = missing.length > 0 and missing.every((id) => this.selected.indexOf(id) >= 0)
      const pct = known.length is 0 ? 0 : Math.round(((known.length - missing.length) / known.length) * 100)

      let cls = presetBase + "border-line bg-panel hover:border-zinc-400 dark:hover:border-zinc-600"
      let tag = missing.length + " to add"
      let tagCls = "shrink-0 text-[11px] font-medium text-zinc-500"
      let barCls = "block h-full rounded-full bg-zinc-400 dark:bg-zinc-500 transition-all"

      if done {
        cls = presetBase + "border-line bg-panel cursor-default"
        tag = "✓ Ready"
        tagCls = "shrink-0 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400"
        barCls = "block h-full rounded-full bg-emerald-500 transition-all"
      } else if chosen {
        cls = presetBase + "border-brand-500 bg-brand-500/[0.05] ring-1 ring-brand-500/40"
        tag = "Selected"
        tagCls = "shrink-0 text-[11px] font-semibold text-brand-700 dark:text-brand-400"
        barCls = "block h-full rounded-full bg-brand-500 transition-all"
      }

      return Object.assign({}, d, { cls: cls, tag: tag, tagCls: tagCls, barCls: barCls, bar: "width: " + pct + "%" })
    })

    // Prerequisites the install adds on its own (pm2 needs Node.js, ...).
    const depIds = this.picked.flatMap((p) => p.needs or [])
    const extra = this.catalog
      .filter((c) => depIds.indexOf(c.id) >= 0 and not c.installed and this.selected.indexOf(c.id) < 0)
      .map((c) => c.label)
    this.extrasText = extra.length > 0 ? "Also installs " + extra.join(", ") + "." : ""

    this.refreshActions()
  }

  setQuery(v) {
    this.query = v
    this.rebuild()
  }

  setTask(t) {
    const wasBusy = this.busy
    this.task = t
    this.taskText = ""
    this.taskStep = ""
    this.taskFailed = false
    this.taskDone = false
    this.taskWaiting = false
    this.taskLabel = "None yet"
    this.taskTitle = ""
    this.taskReason = ""
    this.taskHint = ""
    this.taskCls = ""
    this.taskDot = ""
    this.stepText = ""
    this.progressStyle = "width: 0%"

    if t {
      const upgrading = t.packages.indexOf("upgrade") >= 0
      const names = t.packages.map((id) => this.labelOf(id) or id).join(", ")
      this.taskText = upgrading ? "Update of installed packages" : names
      this.taskStep = t.step or ""
      this.taskFailed = t.status is "failed"
      this.taskDone = t.status is "done"
      this.taskWaiting = Boolean(t.waiting_for_worker)

      const total = Number(t.step_total or 0)
      const no = Number(t.step_no or 0)
      if total > 0 {
        const shown = this.taskDone ? total : Math.max(0, this.taskFailed ? no - 1 : no - 0.5)
        this.progressStyle = "width: " + Math.max(4, Math.round((shown / total) * 100)) + "%"
        this.stepText = this.taskDone ? total + " of " + total + " steps" : "Step " + Math.max(no, 1) + " of " + total + (t.step ? " · " + t.step : "")
      } else if t.step {
        this.stepText = t.step
      }

      // The reason is the first line; a hint for common causes may follow.
      const nl = String.fromCharCode(10)
      const parts = String(t.error or "").split(nl)
      this.taskReason = parts[0] or ""
      this.taskHint = parts.slice(1).join(" ").trim()

      const base = "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold "
      const dot = "w-1.5 h-1.5 rounded-full "

      if t.status is "done" {
        this.taskLabel = "Done"
        this.taskTitle = upgrading ? "Packages updated" : "Installed " + names
        this.taskCls = base + "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
        this.taskDot = dot + "bg-emerald-500"
      } else if t.status is "failed" {
        this.taskLabel = "Failed"
        this.taskTitle = upgrading ? "The update failed" : "Couldn't install " + names
        this.taskCls = base + "bg-rose-500/10 text-rose-600 dark:text-rose-400"
        this.taskDot = dot + "bg-rose-500"
      } else if t.status is "running" {
        this.taskLabel = "Installing"
        this.taskTitle = upgrading ? "Updating installed packages" : "Installing " + names
        this.taskCls = base + "bg-amber-500/10 text-amber-700 dark:text-amber-400"
        this.taskDot = dot + "bg-amber-500 animate-pulse"
      } else {
        this.taskLabel = "Queued"
        this.taskTitle = upgrading ? "Update queued" : "Queued: " + names
        this.taskCls = base + "bg-sky-500/10 text-sky-700 dark:text-sky-400"
        this.taskDot = dot + "bg-sky-500 animate-pulse"
      }

      this.setLog(String(t.log or ""))
    } else {
      this.logLines = []
    }

    this.busy = Boolean(t and (t.status is "running" or t.status is "pending"))

    // Follow the output while it runs; open it on a failure so the cause is in view.
    if this.busy and not wasBusy {
      this.showLog = true
      this.logAtBottom = true
    }
    if this.taskFailed and wasBusy {
      this.showLog = true
    }

    this.refreshActions()
  }

  // The output, one coloured row per line (the last 600 lines).
  setLog(raw) {
    const nl = String.fromCharCode(10)
    const all = raw ? raw.split(nl) : []
    const start = Math.max(0, all.length - 600)
    this.logLines = all.slice(start).map((line, i) => {
      const t = line.trim()
      let cls = "text-zinc-300"
      if t.startsWith("==>") {
        cls = "text-sky-300 font-semibold pt-2"
      } else if t.startsWith("✓") {
        cls = "text-emerald-300"
      } else if t.startsWith("✕") or t.startsWith("E:") or t.toLowerCase().startsWith("error") {
        cls = "text-rose-300 bg-rose-500/10"
      } else if t.startsWith("W:") or t.toLowerCase().includes("warning") {
        cls = "text-amber-300"
      } else if t.startsWith("$") or t.startsWith("Already installed") {
        cls = "text-zinc-400"
      }
      return { n: start + i + 1, text: line is "" ? " " : line, cls: cls }
    })
    if this.showLog and this.logAtBottom {
      window.setTimeout(() => this.scrollLogEnd(), 30)
    }
  }

  clearCopied() {
    this.logCopied = false
  }

  toggleLog() {
    this.showLog = not this.showLog
    if this.showLog {
      this.logAtBottom = true
      window.setTimeout(() => this.scrollLogEnd(), 30)
    }
  }

  scrollLogEnd() {
    const el = document.getElementById("pkg-log")
    if el {
      el.scrollTop = el.scrollHeight
    }
  }

  onLogScroll() {
    const el = document.getElementById("pkg-log")
    if el {
      this.logAtBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 40
    }
  }

  async copyLog() {
    if not this.task {
      return null
    }
    try {
      await navigator.clipboard.writeText(String(this.task.log or "") + (this.task.error ? String.fromCharCode(10) + this.task.error : ""))
      this.logCopied = true
      window.setTimeout(() => this.clearCopied(), 1600)
    } catch (err) {
      return null
    }
  }

  toggle(id) {
    if this.catalog.some((c) => c.id is id and c.installed) {
      return null
    }

    if this.selected.indexOf(id) >= 0 {
      this.selected = this.selected.filter((x) => x is not id)
    } else {
      this.selected = this.selected.concat([id])
    }
    this.rebuild()
  }

  applyPreset(id) {
    const def = this.presetDefs().find((d) => d.id is id)
    if not def {
      return null
    }

    const missing = def.ids.filter((x) => this.catalog.some((c) => c.id is x and not c.installed))
    if missing.length is 0 {
      return null
    }

    const allChosen = missing.every((x) => this.selected.indexOf(x) >= 0)
    if allChosen {
      this.selected = this.selected.filter((x) => missing.indexOf(x) < 0)
    } else {
      const keep = this.selected.filter((x) => missing.indexOf(x) < 0)
      this.selected = keep.concat(missing)
    }
    this.rebuild()
  }

  clearSelection() {
    this.selected = []
    this.rebuild()
  }

  askUpgrade() {
    if Billing.locked or this.busy or this.installing {
      return null
    }
    this.actionError = ""
    this.confirmUpgrade = true
  }

  cancelUpgrade() {
    this.confirmUpgrade = false
  }

  needsCode(result) {
    if result.status is not 403 {
      return false
    }

    const d = result.data or {}
    const text = ("" + (d.error or "") + " " + (d.code or "")).toLowerCase()
    return d.two_factor_required is true or d.code is "two_factor_required" or text.includes("two_factor") or text.includes("two-factor")
  }

  askCode(kind, title) {
    this.pending = { kind: kind }
    this.codeTitle = title
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
    this.codeOpen = true
    window.setTimeout(() => {
      const el = document.getElementById("step-up-code")
      if el {
        el.focus()
      }
    }, 80)
  }

  closeCode() {
    this.codeOpen = false
    this.pending = null
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
  }

  async submitCode() {
    if this.codeBusy or not this.pending {
      return null
    }

    const code = this.codeValue.trim()
    if code is "" {
      this.codeError = "Enter your code."
      return null
    }

    this.codeBusy = true
    this.codeError = ""
    const kind = this.pending.kind
    let outcome = "failed"

    if kind is "upgrade" {
      outcome = await this.runUpgrade(code)
    } else {
      outcome = await this.runInstall(code)
    }

    if outcome is "done" {
      this.closeCode()
      return null
    }

    this.codeError = this.lastError or "That code didn't work. Try again."
    this.codeValue = ""
    this.codeBusy = false
  }

  async loadCatalog() {
    this.loadError = ""
    const result = await useApi("/api/servers/" + this.serverId + "/packages")

    if result.ok {
      this.catalog = result.data.packages
      this.setTask(result.data.task)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.loadError = result.data?.error or "Couldn't check this server."
    }

    this.rebuild()
  }

  async pollTask() {
    if not this.busy {
      return null
    }

    const result = await useApi("/api/servers/" + this.serverId + "/packages/task")

    if result.ok and result.data.task {
      this.setTask(result.data.task)
      if not this.busy {
        await this.loadCatalog()
      }
    }
  }

  async runInstall(code) {
    const payload = code ? { packages: this.selected, code: code } : { packages: this.selected }
    const result = await useApi("/api/servers/" + this.serverId + "/packages", { method: "POST", body: payload })

    if result.ok {
      this.selected = []
      this.setTask(result.data.task)
      this.rebuild()
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't start the install."
    return this.needsCode(result) ? "code" : "failed"
  }

  async runUpgrade(code) {
    const payload = code ? { code: code } : {}
    const result = await useApi("/api/servers/" + this.serverId + "/packages/upgrade", { method: "POST", body: payload })

    if result.ok {
      this.setTask(result.data.task)
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't start the update."
    return this.needsCode(result) ? "code" : "failed"
  }

  async install() {
    if Billing.locked {
      this.actionError = "Pay to continue installing packages."
      return null
    }
    if this.installing or this.busy or this.selected.length is 0 {
      return null
    }

    this.installing = true
    this.actionError = ""
    this.refreshActions()

    const outcome = await this.runInstall("")

    if outcome is "code" {
      this.askCode("install", "Confirm to install these packages")
    } else if outcome is "failed" {
      this.actionError = this.lastError
    }

    this.installing = false
    this.refreshActions()
  }

  // Updates everything already installed on the server to the latest version.
  async upgrade() {
    if Billing.locked {
      this.actionError = "Pay to continue updating packages."
      this.confirmUpgrade = false
      return null
    }
    if this.installing or this.busy {
      return null
    }

    this.installing = true
    this.confirmUpgrade = false
    this.actionError = ""
    this.refreshActions()

    const outcome = await this.runUpgrade("")

    if outcome is "code" {
      this.askCode("upgrade", "Confirm to update packages")
    } else if outcome is "failed" {
      this.actionError = this.lastError
    }

    this.installing = false
    this.refreshActions()
  }

  async retryTask() {
    if Billing.locked {
      this.actionError = "Pay to continue."
      return null
    }
    if not this.task {
      return null
    }

    // A failed update is retried as an update, not as a list of packages.
    if this.task.packages.indexOf("upgrade") >= 0 {
      await this.upgrade()
      return null
    }

    this.selected = this.task.packages.filter((id) => this.catalog.filter((c) => c.id is id and c.installed).length is 0)
    this.rebuild()
    await this.install()
  }

  onKey(e) {
    if e.key is "Escape" {
      if this.codeOpen {
        this.closeCode()
      } else if this.confirmUpgrade {
        this.cancelUpgrade()
      }
      return null
    }

    if e.key is "Enter" and this.codeOpen {
      e.preventDefault()
      this.submitCode()
    }
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const old = this.global("tylixPackagesKey")
    if old {
      document.removeEventListener("keydown", old)
    }
    const keyHandler = (e) => this.onKey(e)
    document.addEventListener("keydown", keyHandler)
    this.setGlobal("tylixPackagesKey", keyHandler)

    const params = new URLSearchParams(window.location.search)
    const sid = params.get("id")

    if not sid {
      window.location.href = "/servers"
      return null
    }

    this.serverId = sid

    const server = await useApi("/api/servers/" + sid)
    if server.ok {
      this.serverName = server.data.name
    }

    await this.loadCatalog()
    this.loading = false
    this.checkedAuth = true

    const oldTimer = this.global("tylixPackagesTimer")
    if oldTimer {
      window.clearInterval(oldTimer)
    }
    this.setGlobal("tylixPackagesTimer", window.setInterval(() => this.pollTask(), 2000))
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
    <ServerSidebar active="packages" serverId="{{ serverId }}" />
    <div class="min-w-0">
    <div class="{{ selected.length > 0 ? 'max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 pt-6 sm:pt-10 pb-28 lg:pb-10' : 'max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10' }}">

      <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
        <div class="min-w-0">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1 min-w-0 text-[13px] text-zinc-500 mb-2">
            <a href="/servers" class="shrink-0 rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Servers</a>
            <IconChevronRight class="w-3.5 h-3.5 shrink-0 text-zinc-400 dark:text-zinc-600" />
            <a href="{{ '/servers/server-detail?id=' + serverId }}" class="min-w-0 truncate rounded-md hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">{{ serverName }}</a>
          </nav>
          <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">Packages</h1>
          <p class="text-zinc-500 text-sm mt-1.5 max-w-2xl leading-relaxed">Install runtimes, databases and tools over SSH. Anything already on the server is detected and marked installed.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button type="button" onclick="{{ loadCatalog() }}" title="Check the server again" class="inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconRefresh class="w-4 h-4" /> <span class="hidden sm:inline">Re-check</span>
          </button>
          <button type="button" onclick="{{ askUpgrade() }}" class="{{ upgradeCls }}">
            <IconArrowPath class="w-4 h-4" /> {{ upgradeLabel }}
          </button>
        </div>
      </header>

      <LockedBanner />

{{#if loadError}}
      <div role="alert" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/[0.06] px-4 sm:px-5 py-3.5 mb-6">
        <div class="flex items-start gap-3 min-w-0">
          <IconExclamationTriangle class="w-5 h-5 shrink-0 mt-0.5 text-rose-500" />
          <div class="min-w-0">
            <p class="text-rose-600 dark:text-rose-400 text-sm font-semibold">Couldn't check what's installed</p>
            <p class="text-zinc-600 dark:text-zinc-300 text-[13px] break-words">{{ loadError }}</p>
          </div>
        </div>
        <button type="button" onclick="{{ loadCatalog() }}" class="shrink-0 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">Try again</button>
      </div>
{{/if}}

{{#if task}}
      <section aria-live="polite" class="{{ taskFailed ? 'rounded-2xl border border-rose-500/40 bg-panel shadow-sm dark:shadow-none overflow-hidden mb-6' : 'rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden mb-6' }}">
        <div class="px-5 sm:px-6 pt-5 pb-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex items-start gap-3">
              <span class="{{ taskFailed ? 'w-10 h-10 shrink-0 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center' : (taskDone ? 'w-10 h-10 shrink-0 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center' : 'w-10 h-10 shrink-0 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center') }}">
{{#if taskFailed}}
                <IconXCircle class="w-5 h-5" />
{{/if}}
{{#if taskDone}}
                <IconCheckCircle class="w-5 h-5" />
{{/if}}
{{#if busy}}
                <span class="w-4 h-4 rounded-full border-2 border-current border-t-transparent animate-spin"></span>
{{/if}}
              </span>
              <div class="min-w-0">
                <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">Last install</p>
                <h2 class="text-zinc-900 dark:text-zinc-50 text-[15px] sm:text-base font-semibold leading-snug break-words">{{ taskTitle }}</h2>
              </div>
            </div>
            <span class="{{ taskCls }}"><span class="{{ taskDot }}"></span> {{ taskLabel }}</span>
          </div>

{{#if stepText}}
          <div class="mt-4">
            <div class="h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden">
              <div class="{{ taskFailed ? 'h-full rounded-full bg-rose-500 transition-all duration-500' : (taskDone ? 'h-full rounded-full bg-emerald-500 transition-all duration-500' : 'h-full rounded-full bg-brand-500 transition-all duration-500') }}" style="{{ progressStyle }}"></div>
            </div>
            <p class="text-zinc-500 text-xs mt-2 break-words">{{ stepText }}</p>
          </div>
{{/if}}

{{#if busy}}
{{#if taskWaiting}}
          <div class="mt-4 flex gap-3 rounded-xl border border-amber-500/30 bg-amber-500/[0.06] px-4 py-3">
            <IconExclamationTriangle class="w-4 h-4 shrink-0 mt-0.5 text-amber-600 dark:text-amber-400" />
            <p class="text-amber-800 dark:text-amber-300 text-[13px] leading-relaxed">Queued for over a minute and nothing has started. The job worker that runs installs (<span class="font-mono">tylix queue:work</span>) may not be running.</p>
          </div>
{{/if}}
{{#if not taskWaiting}}
          <p class="text-zinc-500 text-xs mt-2">This can take several minutes. You can leave this page; the install keeps running.</p>
{{/if}}
{{/if}}

{{#if taskFailed}}
          <div role="alert" class="mt-4 rounded-xl border border-rose-500/30 bg-rose-500/[0.06] px-4 py-3.5">
            <p class="text-rose-700 dark:text-rose-300 text-sm font-medium font-mono break-words leading-relaxed">{{ taskReason or "The install failed without a message." }}</p>
{{#if taskHint}}
            <p class="mt-2 flex gap-2 text-zinc-700 dark:text-zinc-300 text-[13px] leading-relaxed"><IconInformationCircle class="w-4 h-4 shrink-0 mt-0.5 text-zinc-400" /> <span>{{ taskHint }}</span></p>
{{/if}}
          </div>
{{/if}}
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 px-5 sm:px-6 py-3 border-t border-line bg-sunken">
          <button type="button" onclick="{{ toggleLog() }}" aria-expanded="{{ showLog ? 'true' : 'false' }}" class="inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 rounded-full px-3 hover:bg-zinc-200/60 dark:hover:bg-white/[0.05] transition-colors">
            <IconTerminal class="w-4 h-4" /> {{ showLog ? "Hide output" : "Show output" }}
            <span class="text-zinc-400 text-xs tabular-nums">{{ logLines.length }} lines</span>
          </button>
          <div class="flex items-center gap-2">
{{#if taskFailed}}
            <button type="button" onclick="{{ retryTask() }}" class="inline-flex items-center gap-1.5 h-9 text-sm font-semibold text-white bg-brand-500 hover:bg-brand-400 rounded-full px-4 shadow-sm transition-colors"><IconArrowPath class="w-4 h-4" /> Retry</button>
{{/if}}
          </div>
        </div>

{{#if showLog}}
        <div class="relative bg-[#0b0b0c] border-t border-line">
          <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-white/[0.06]">
            <span class="text-zinc-400 text-[11px] font-mono truncate">root@{{ serverName }} · install output</span>
            <button type="button" onclick="{{ copyLog() }}" class="shrink-0 inline-flex items-center gap-1.5 h-7 rounded-md px-2 text-[11px] font-medium text-zinc-300 hover:text-white hover:bg-white/[0.08] transition-colors">
{{#if logCopied}}
              <IconCheck class="w-3.5 h-3.5 text-emerald-400" /> Copied
{{#else}}
              <IconCopy class="w-3.5 h-3.5" /> Copy
{{/if}}
            </button>
          </div>
          <div id="pkg-log" onscroll="{{ onLogScroll() }}" class="max-h-[420px] overflow-auto overscroll-contain py-2 font-mono text-[12px] leading-5">
{{#if logLines.length is 0}}
            <p class="px-4 py-2 text-zinc-500">{{ busy ? "Waiting for output…" : "No output was recorded for this install." }}</p>
{{/if}}
{{#each l in logLines}}
            <div class="flex hover:bg-white/[0.03] {{ l.cls }}">
              <span class="w-12 shrink-0 pr-3 text-right text-zinc-600 tabular-nums select-none">{{ l.n }}</span>
              <span class="min-w-0 flex-1 pr-4 whitespace-pre-wrap [overflow-wrap:anywhere]">{{ l.text }}</span>
            </div>
{{/each}}
{{#if busy}}
            <p class="px-4 pt-1 pl-[60px]"><span class="inline-block w-[7px] h-[13px] -mb-[2px] bg-brand-400/80 animate-pulse"></span></p>
{{/if}}
          </div>
        </div>
{{/if}}
      </section>
{{/if}}

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-6 items-start">

        <div class="min-w-0 space-y-6">

          <section class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex flex-wrap items-end justify-between gap-2 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <div class="min-w-0">
                <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Start from a stack</h2>
                <p class="text-zinc-500 text-[13px] mt-0.5">Selects everything a stack needs that isn't on the server yet.</p>
              </div>
              <span class="text-zinc-500 text-xs tabular-nums">{{ installedCount }} of {{ totalCount }} packages installed</span>
            </div>
            <div class="p-4 sm:p-5 grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 gap-3">
{{#each pr in presetRows}}
              <button type="button" onclick="{{ applyPreset(pr.id) }}" class="{{ pr.cls }}">
                <span class="flex items-center justify-between gap-3">
                  <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 truncate">{{ pr.label }}</span>
                  <span class="{{ pr.tagCls }}">{{ pr.tag }}</span>
                </span>
                <span class="block text-xs text-zinc-500 truncate mt-0.5">{{ pr.note }}</span>
                <span class="block h-1 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden mt-3">
                  <span class="{{ pr.barCls }}" style="{{ pr.bar }}"></span>
                </span>
              </button>
{{/each}}
            </div>
          </section>

          <section class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
              <div class="min-w-0">
                <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">All packages</h2>
                <p class="text-zinc-500 text-[13px] mt-0.5">Pick any you need. What they depend on is installed too.</p>
              </div>
              <div class="relative w-full sm:w-64">
                <IconSearch class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none" />
                <input type="search" autocomplete="off" spellcheck="false" value="{{ query }}" oninput="{{ setQuery($event.target.value) }}" placeholder="Search packages" aria-label="Search packages" class="w-full rounded-full border border-line-strong bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 text-base sm:text-sm pl-9 pr-4 py-2 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2">
{{#each g in groups}}
              <div class="min-w-0 border-b border-line xl:odd:border-r">
                <div class="flex items-center justify-between gap-2 px-4 sm:px-5 pt-4 pb-1.5">
                  <h3 class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">{{ g.name }}</h3>
                  <span class="text-zinc-400 text-[11px] tabular-nums">{{ g.meta }}</span>
                </div>
                <div class="pb-2">
{{#each r in g.items}}
                  <button type="button" role="checkbox" aria-checked="{{ r.mark ? 'true' : 'false' }}" aria-disabled="{{ r.installed ? 'true' : 'false' }}" onclick="{{ toggle(r.id) }}" class="{{ r.cls }}">
                    <span class="{{ r.box }}">{{ r.mark }}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm text-zinc-900 dark:text-zinc-100 break-words">{{ r.label }}</span>
{{#if r.note}}
                      <span class="block text-[11px] text-zinc-500 truncate">{{ r.note }}</span>
{{/if}}
                    </span>
{{#if r.tag}}
                    <span class="{{ r.tagCls }}">{{ r.tag }}</span>
{{/if}}
                  </button>
{{/each}}
                </div>
              </div>
{{/each}}
            </div>

{{#if noMatch}}
            <p class="py-10 text-center text-zinc-500 text-sm">No packages match “{{ query }}”.</p>
{{/if}}
          </section>

{{#if actionError}}
          <div role="alert" class="flex gap-3 rounded-xl border border-rose-500/30 bg-rose-500/[0.06] px-4 py-3">
            <IconExclamationTriangle class="w-4 h-4 shrink-0 mt-0.5 text-rose-500" />
            <p class="text-rose-600 dark:text-rose-400 text-sm break-words">{{ actionError }}</p>
          </div>
{{/if}}
        </div>

        <aside class="hidden lg:block lg:sticky lg:top-24 space-y-4">
          <div class="rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
            <div class="px-5 pt-5 pb-4 border-b border-line">
              <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">To install</h2>
              <p class="text-zinc-500 text-[13px] mt-0.5">{{ selected.length is 0 ? "Pick a stack or packages." : selected.length + (selected.length is 1 ? " package" : " packages") + " selected" }}</p>
            </div>
            <div class="px-5 py-4">
{{#if picked.length is 0}}
              <p class="text-zinc-400 text-sm">Nothing selected yet.</p>
{{/if}}
{{#if picked.length is not 0}}
              <div class="flex flex-wrap gap-1.5">
{{#each p in picked}}
                <button type="button" onclick="{{ toggle(p.id) }}" title="Remove" class="inline-flex items-center gap-1 rounded-full border border-line-strong pl-2.5 pr-1.5 py-1 text-xs text-zinc-800 dark:text-zinc-200 hover:border-rose-500/50 hover:text-rose-600 dark:hover:text-rose-400 transition-colors">
                  {{ p.label }} <IconX class="w-3 h-3 opacity-60" />
                </button>
{{/each}}
              </div>
{{#if extrasText}}
              <p class="text-zinc-500 text-xs mt-3">{{ extrasText }}</p>
{{/if}}
{{/if}}
            </div>
            <div class="px-5 pb-5">
              <button type="button" onclick="{{ install() }}" class="{{ installCls }}">{{ installLabel }}</button>
{{#if selected.length is not 0}}
              <button type="button" onclick="{{ clearSelection() }}" class="w-full mt-2 text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 py-1.5 transition-colors">Clear selection</button>
{{/if}}
            </div>
          </div>

          <div class="rounded-2xl border border-line bg-panel px-5 py-4 shadow-sm dark:shadow-none">
            <ul class="space-y-2 text-[13px] text-zinc-600 dark:text-zinc-400">
              <li class="flex gap-2"><IconCheck class="w-4 h-4 shrink-0 mt-0.5 text-emerald-500" /> Runs over SSH, one step at a time</li>
              <li class="flex gap-2"><IconCheck class="w-4 h-4 shrink-0 mt-0.5 text-emerald-500" /> Stops at the first error and shows why</li>
              <li class="flex gap-2"><IconCheck class="w-4 h-4 shrink-0 mt-0.5 text-emerald-500" /> Keeps going if you leave the page</li>
            </ul>
            <p class="text-zinc-500 text-xs mt-3 pt-3 border-t border-line">Needs the admin role. With two-factor on, you'll be asked for a code.</p>
          </div>
        </aside>

      </div>

    </div>
    </div>
  </div>

{{#if selected.length is not 0}}
  <div class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-line bg-panel shadow-[0_-8px_24px_-12px_rgb(0_0_0/0.35)] px-4 pt-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium">{{ selected.length }} selected</p>
        <p class="text-zinc-500 text-xs truncate">{{ extrasText or pickedText }}</p>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button type="button" onclick="{{ clearSelection() }}" class="h-11 text-sm text-zinc-500 px-3">Clear</button>
        <button type="button" onclick="{{ install() }}" class="{{ installBarCls }}">{{ installLabel }}</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if confirmUpgrade}}
  <div class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-6">
    <div onclick="{{ cancelUpgrade() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <div role="dialog" aria-modal="true" aria-label="Update packages" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
      <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">Update all installed packages?</h3>
      <p class="text-slate-500 text-sm">Everything installed on this server is brought up to the latest version. Services restart briefly while they update.</p>

      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
        <button onclick="{{ cancelUpgrade() }}" class="w-full sm:w-auto text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
        <button onclick="{{ upgrade() }}" class="w-full sm:w-auto text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">Yes, update now</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if codeOpen}}
  <div class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-6">
    <div onclick="{{ closeCode() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

    <div role="dialog" aria-modal="true" aria-label="Two-factor code" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
      <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">{{ codeTitle }}</h3>
      <p class="text-slate-500 text-sm mb-4">Enter the code from your authenticator app or the SMS we sent you.</p>

      <input
        id="step-up-code"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        autocapitalize="none"
        spellcheck="false"
        maxlength="12"
        value="{{ codeValue }}"
        oninput="{{ codeValue = $event.target.value }}"
        placeholder="123456"
        class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base tracking-widest font-mono px-3.5 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors"
      />

{{#if codeError}}
      <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ codeError }}</p>
{{/if}}

      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
        <button onclick="{{ closeCode() }}" class="w-full sm:w-auto text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
        <button onclick="{{ submitCode() }}" class="w-full sm:w-auto text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">{{ codeBusy ? "Checking…" : "Confirm" }}</button>
      </div>
    </div>
  </div>
{{/if}}
{{/if}}

{{#if not checkedAuth}}
<PageLoader label="Loading packages..." />
{{/if}}