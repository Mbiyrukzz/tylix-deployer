page ServerPackages

import { IconArrowLeft } from "tylix-icons"

title "Packages"

needs
  Auth

uses
  Billing

background
  Billing

state
  checkedAuth: false
  loading: true
  serverId: ""
  serverName: ""
  loadError: ""
  actionError: ""
  catalog: []
  rows: []
  selected: []
  task: null
  busy: false
  installing: false
  installedCount: 0
  totalCount: 0

action
  rebuild() {
    this.rows = this.catalog.map((p, i) => ({
      id: p.id,
      label: p.label,
      group: p.group,
      installed: p.installed,
      checked: this.selected.indexOf(p.id) >= 0,
      header: i is 0 or this.catalog[i - 1].group is not p.group
    }))
    this.totalCount = this.catalog.length
    this.installedCount = this.catalog.filter((p) => p.installed).length
  }

  setTask(t) {
    this.task = t
    if t and (t.status is "running" or t.status is "pending") {
      this.busy = true
    } else {
      this.busy = false
    }
  }

  toggle(id) {
    if this.selected.indexOf(id) >= 0 {
      this.selected = this.selected.filter((x) => x is not id)
    } else {
      this.selected = this.selected.concat([id])
    }
    this.rebuild()
  }

  clearSelection() {
    this.selected = []
    this.rebuild()
  }

  async loadCatalog() {
    this.loadError = ""
    const result = await useApi("/api/servers/" + this.serverId + "/packages")

    if result.ok {
      this.catalog = result.data.packages
      this.setTask(result.data.task)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.loadError = result.data?.error or "Couldn't check this server."
    }

    this.rebuild()
  }

  async pollTask() {
    if not this.busy {
      return null
    }

    const result = await useApi("/api/servers/" + this.serverId + "/packages/task")

    if result.ok and result.data.task {
      this.setTask(result.data.task)
      if not this.busy {
        await this.loadCatalog()
      }
    }
  }

  async install() {
    if Billing.locked {
      return null
    }
    if this.installing or this.busy or this.selected.length is 0 {
      return null
    }

    this.installing = true
    this.actionError = ""

    const payload = { packages: this.selected }
    const result = await useApi("/api/servers/" + this.serverId + "/packages", { method: "POST", body: payload })

    if result.ok {
      this.selected = []
      this.setTask(result.data.task)
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.actionError = result.data?.error or "Couldn't start the install."
    }

    this.installing = false
    this.rebuild()
  }

  async retryTask() {
    if Billing.locked {
      return null
    }
    if not this.task {
      return null
    }

    this.selected = this.task.packages.filter((id) => this.rows.filter((r) => r.id is id and r.installed).length is 0)
    await this.install()
  }

onMount
  async {
    if not Auth.user {
      window.location.href = "/login"
      return null
    }

    const params = new URLSearchParams(window.location.search)
    const sid = params.get("id")

    if not sid {
      window.location.href = "/servers"
      return null
    }

    this.serverId = sid

    const server = await useApi("/api/servers/" + sid)
    if server.ok {
      this.serverName = server.data.name
    }

    await this.loadCatalog()
    this.loading = false
    this.checkedAuth = true
    window.setInterval(() => this.pollTask(), 3000)
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
    <ServerSidebar active="packages" serverId="{{ serverId }}" />
    <div class="min-w-0">
      <div class="max-w-4xl mx-auto px-6 lg:px-12 py-10">

        <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
          <IconArrowLeft class="w-4 h-4" /> {{ serverName }}
        </a>

        <LockedBanner />

        <div class="flex items-end justify-between gap-4 mb-8">
          <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 mb-1">Packages</h1>
            <p class="text-slate-500 text-sm">Install software on this server. Anything already there is marked installed.</p>
          </div>
{{#if not loading}}
          <p class="text-slate-500 text-sm shrink-0">{{ installedCount }} of {{ totalCount }} installed</p>
{{/if}}
        </div>

{{#if loadError}}
        <div class="rounded-xl border border-rose-900/30 bg-slate-200 dark:bg-slate-900 p-5 mb-6">
          <p role="alert" class="text-rose-500 text-sm mb-3">{{ loadError }}</p>
          <button onclick="{{ loadCatalog() }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Try again</button>
        </div>
{{/if}}

{{#if task}}
        <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5 mb-6 shadow-sm dark:shadow-none">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="text-slate-800 dark:text-slate-200 text-sm font-medium">Last install</p>
              <p class="text-slate-500 text-xs font-mono mt-1 break-words">{{ task.packages.join(", ") }}</p>
            </div>
            <div class="text-right shrink-0">
{{#if task.status is "done"}}
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Done
              </span>
{{/if}}
{{#if task.status is "failed"}}
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
              </span>
{{/if}}
{{#if task.status is "running"}}
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Working
              </span>
{{/if}}
{{#if task.status is "pending"}}
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Queued
              </span>
{{/if}}
            </div>
          </div>

{{#if busy}}
          <div class="mt-4 h-1.5 rounded-full bg-slate-300 dark:bg-slate-800 overflow-hidden">
            <div class="h-1.5 w-1/3 rounded-full bg-emerald-500 animate-pulse"></div>
          </div>
{{#if task.step}}
          <p class="text-slate-500 text-xs mt-3">{{ task.step }}</p>
{{/if}}
          <p class="text-slate-500 text-xs mt-1">This can take several minutes. You can leave this page; the install keeps running.</p>
{{/if}}

{{#if task.status is "failed"}}
{{#if task.error}}
          <pre class="mt-4 max-h-40 overflow-auto rounded-lg bg-slate-300/50 dark:bg-slate-950 p-3 text-xs text-rose-600 dark:text-rose-400 font-mono whitespace-pre-wrap">{{ task.error }}</pre>
{{/if}}
          <div class="mt-4">
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                <rect x="4" y="9" width="12" height="8" rx="2" />
                <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
              </svg>
              Retry
            </button>
{{/if}}
{{#if not Billing.locked}}
            <button onclick="{{ retryTask() }}" class="text-sm text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Retry</button>
{{/if}}
          </div>
{{/if}}
        </div>
{{/if}}

{{#if loading}}
        <p class="text-slate-500 text-sm">Checking what is installed…</p>
{{/if}}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each r in rows}}
{{#if r.header}}
          <h2 class="col-span-full text-slate-800 dark:text-slate-200 font-medium mt-6 first:mt-0">{{ r.group }}</h2>
{{/if}}
{{#if r.installed}}
          <div class="flex items-center justify-between rounded-xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 px-4 py-3">
            <span class="text-sm text-slate-800 dark:text-slate-200">{{ r.label }}</span>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Installed
            </span>
          </div>
{{/if}}
{{#if not r.installed}}
{{#if r.checked}}
          <button onclick="{{ toggle(r.id) }}" class="flex items-center justify-between text-left rounded-xl border px-4 py-3 text-sm transition-colors border-emerald-500 bg-emerald-500/10 text-slate-800 dark:text-slate-200">
            <span>{{ r.label }}</span>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">Selected</span>
          </button>
{{/if}}
{{#if not r.checked}}
          <button onclick="{{ toggle(r.id) }}" class="flex items-center justify-between text-left rounded-xl border px-4 py-3 text-sm transition-colors border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:border-emerald-500/40">
            <span>{{ r.label }}</span>
            <span class="text-[11px] uppercase tracking-wider text-slate-500">Not installed</span>
          </button>
{{/if}}
{{/if}}
{{/each}}
        </div>

{{#if actionError}}
        <p role="alert" class="text-rose-500 text-sm mt-6">{{ actionError }}</p>
{{/if}}

        <div class="sticky bottom-4 mt-8 flex items-center justify-between gap-4 rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200/95 dark:bg-slate-900/95 backdrop-blur px-5 py-3 shadow-lg">
          <div class="flex items-center gap-3">
            <p class="text-slate-600 dark:text-slate-300 text-sm">{{ selected.length }} selected</p>
{{#if selected.length is not 0}}
            <button onclick="{{ clearSelection() }}" class="text-xs text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Clear</button>
{{/if}}
          </div>
{{#if busy}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 opacity-50">Install running…</button>
{{/if}}
{{#if not busy}}
{{#if selected.length is 0}}
          <button disabled class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 opacity-50">Install selected</button>
{{/if}}
{{#if selected.length is not 0}}
{{#if Billing.locked}}
          <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2.5 cursor-not-allowed select-none">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
              <rect x="4" y="9" width="12" height="8" rx="2" />
              <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
            </svg>
            Install selected
          </button>
{{/if}}
{{#if not Billing.locked}}
          <button onclick="{{ install() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-emerald-400 hover:shadow transition-all">Install selected</button>
{{/if}}
{{/if}}
{{/if}}
        </div>

      </div>
    </div>
  </div>
{{/if}}
