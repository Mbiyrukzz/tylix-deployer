page SiteDeploy

import { IconExternalLink } from "tylix-icons"

title "Deployment"

needs
  Auth

uses
  Billing

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  isMissing: false
  canDeploy: false
  scriptText: ""
  defaultScript: ""
  envText: ""
  envPath: ""
  deployStatus: "idle"
  deployLog: ""
  deployedText: ""
  deployedRaw: ""
  statusTitle: "Not deployed yet"
  statusSub: ""
  hasProgress: false
  modal: ""
  busy: false
  saving: false
  saved: false
  error: ""
  timer: 0
  lastPolled: ""
  polling: false
  doneTicks: 0
  history: []
  histFilter: "all"
  histTabs: []
  histLoading: false
  histBodyCls: "transition-opacity"
  page: 1
  perPage: 10
  total: 0
  totalPages: 1
  rangeText: ""
  hasPrev: false
  hasNext: false
  pageNumbers: []
  deleteTarget: null
  deleting: false
  deleteError: ""
  cancelTarget: null
  cancelBusy: false
  cancelError: ""
  runId: 0
  cancelling: false
  queuePos: 0
  queuedText: ""
  activeStartedAt: ""
  idleText: ""
  elapsedText: ""
  sourceKind: ""
  latestCommit: null
  viewId: ""
  logPage: false
  savedScroll: 0
  logText: ""
  logStatus: "idle"
  logLoading: false
  logLines: []
  shownLogLines: []
  logFilter: "all"
  logTabs: []
  logErrors: 0
  logWarns: 0
  logStages: 0
  latestLines: []
  stageList: []
  tailLines: []
  currentStage: ""
  lastErrorText: ""
  latestErrors: 0
  latestWarns: 0
  latestStages: 0
  atBottom: true
  copied: false
  histAll: 0
  successCount: 0
  failedCount: 0
  cancelledCount: 0
  successRate: 0
  rateStyle: "width: 0%"
  heroCls: "bg-slate-400"
  lastDuration: ""

action
  classify(line, n) {
    const t = line.trim()

    let body = t
    let ts = ""
    if t.startsWith("[") {
      const close = t.indexOf("]")
      if close > 1 and close < 32 {
        const inner = t.slice(1, close)
        const looksLikeTime = "0123456789".includes(inner.charAt(0)) and (inner.includes(":") or inner.includes("-"))
        if looksLikeTime {
          ts = t.slice(0, close + 1)
          body = t.slice(close + 1).trim()
        }
      }
    }

    const lower = body.toLowerCase()
    const quiet = lower.includes("0 error") or lower.includes("no error") or lower.includes("without error")
    const isCancel = body.startsWith("CANCELLED") or lower.startsWith("cancelled")
    const isErr = (body.startsWith("FAILED") or lower.startsWith("failed") or lower.includes("error") or lower.includes("fatal") or lower.includes("exception")) and not quiet and not isCancel
    const isWarn = lower.includes("warning") or lower.includes("deprecat") or body.startsWith("NOTE") or isCancel
    const isOk = lower.startsWith("done") or lower.includes("success") or lower.includes("is running") or lower.includes("reloaded") or lower.startsWith("ok")
    const isGit = lower.startsWith("from ") or lower.startsWith("remote:") or lower.startsWith("already up to date") or lower.startsWith("head is now") or lower.startsWith("updating ") or lower.startsWith("fast-forward") or lower.startsWith("cloning") or lower.startsWith("git ")
    const isTool = lower.includes("composer") or lower.includes("npm ") or lower.includes("yarn") or lower.includes("pnpm") or lower.includes("artisan") or lower.includes("pm2") or lower.includes("systemctl") or lower.includes("nginx") or lower.includes("migrat")

    let kind = "text"
    let text = ts is "" ? line : body
    let cls = "text-slate-300"
    let rowCls = "border-transparent"
    let icon = ""

    if body.startsWith("==>") {
      kind = "stage"
      text = body.slice(3).trim()
    } else if body.startsWith("---") {
      kind = "step"
      text = body.slice(3).trim()
      cls = "text-sky-300 font-medium"
      icon = "›"
    } else if isErr {
      kind = "error"
      cls = "text-rose-300"
      rowCls = "border-rose-500 bg-rose-500/10"
      icon = "✕"
    } else if isWarn {
      kind = "warn"
      cls = "text-amber-300"
      rowCls = "border-amber-500/60"
      icon = "!"
    } else if isOk {
      kind = "ok"
      cls = "text-brand-400"
      icon = "✓"
    } else if body.startsWith("$ ") or body.startsWith("+ ") {
      kind = "cmd"
      cls = "text-violet-300"
      icon = "$"
    } else if isGit {
      kind = "git"
      cls = "text-fuchsia-300/90"
    } else if isTool {
      kind = "tool"
      cls = "text-cyan-300/90"
    } else if body is "" {
      text = " "
    }

    return {
      n: n,
      kind: kind,
      text: text,
      ts: ts,
      cls: cls,
      rowCls: rowCls,
      icon: icon,
      isStage: kind is "stage"
    }
  }

  parseLog(raw) {
    const nl = String.fromCharCode(10)
    const cr = String.fromCharCode(13)
    const all = (raw or "").split(cr + nl).join(nl).split(cr).join(nl).split(nl)
    const cut = all.length > 3000 ? all.length - 3000 : 0
    return all.slice(cut).map((line, i) => this.classify(line, cut + i + 1))
  }

  matches(l, f) {
    if f is "all" {
      return true
    }
    if f is "stage" {
      return l.kind is "stage" or l.kind is "step"
    }
    return l.kind is f
  }

  applyLogFilter() {
    const activeCls = "inline-flex items-center gap-1.5 rounded-md bg-slate-700 text-white text-xs font-medium px-3 py-1.5 transition-colors"
    const idleCls = "inline-flex items-center gap-1.5 rounded-md text-slate-400 hover:text-slate-200 text-xs font-medium px-3 py-1.5 transition-colors"
    const keys = [["all", "All"], ["error", "Errors"], ["warn", "Warnings"], ["stage", "Steps"]]
    const f = this.logFilter

    this.shownLogLines = this.logLines.filter((l) => this.matches(l, f))
    this.logTabs = keys.map((k) => ({
      key: k[0],
      label: k[1],
      count: this.logLines.filter((l) => this.matches(l, k[0])).length,
      cls: k[0] is f ? activeCls : idleCls
    }))
  }

  setLogFilter(key) {
    this.logFilter = key
    this.applyLogFilter()
    window.setTimeout(() => this.scrollPageEnd(), 40)
  }

  scrollToLine(n) {
    const el = document.getElementById("log-line-" + n)
    if el {
      el.scrollIntoView({ block: "center" })
    }
  }

  jumpToError() {
    const first = this.logLines.find((l) => l.kind is "error")
    if not first {
      return null
    }

    this.logFilter = "all"
    this.applyLogFilter()
    this.atBottom = false
    window.setTimeout(() => this.scrollToLine(first.n), 60)
  }

  heroFor(status) {
    if status is "success" {
      return "bg-emerald-500"
    }
    if status is "failed" {
      return "bg-rose-500"
    }
    if status is "cancelled" {
      return "bg-orange-400"
    }
    if status is "queued" {
      return "bg-sky-400 animate-pulse"
    }
    if status is "deploying" {
      return "bg-amber-400 animate-pulse"
    }
    return "bg-slate-400"
  }

  decorateStage(text, isLast) {
    let icon = "✓"
    let iconCls = "bg-brand-500/15 text-brand-700 dark:text-brand-400"
    let textCls = "text-slate-600 dark:text-slate-400"
    let running = false
    let note = ""

    if isLast and this.deployStatus is "deploying" {
      running = true
      textCls = "text-slate-900 dark:text-slate-100 font-medium"
      note = "in progress"
    }
    if isLast and this.deployStatus is "failed" {
      icon = "✕"
      iconCls = "bg-rose-500/15 text-rose-600 dark:text-rose-400"
      textCls = "text-slate-900 dark:text-slate-100 font-medium"
    }
    if isLast and this.deployStatus is "cancelled" {
      icon = "■"
      iconCls = "bg-orange-500/15 text-orange-600 dark:text-orange-400"
      textCls = "text-slate-900 dark:text-slate-100 font-medium"
    }

    return {
      text: text.length > 80 ? text.slice(0, 80) + "…" : text,
      icon: icon,
      iconCls: "w-5 h-5 shrink-0 inline-flex items-center justify-center rounded-full text-[10px] " + iconCls,
      textCls: "min-w-0 flex-1 truncate text-sm " + textCls,
      running: running,
      note: note
    }
  }

  // The log scrolls inside the popup's well, not the window.
  scrollPageEnd() {
    const el = document.getElementById("deploy-log-scroll")
    if el {
      el.scrollTop = el.scrollHeight
    }
  }

  onPageScroll() {
    if not this.logPage {
      return null
    }
    const el = document.getElementById("deploy-log-scroll")
    if el {
      this.atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 48
    }
  }

  jumpToLine(n) {
    this.logFilter = "all"
    this.applyLogFilter()
    this.atBottom = false
    window.setTimeout(() => this.scrollToLine(n), 60)
  }

  setScript() {
    const el = document.getElementById("script-input")
    if el {
      this.scriptText = Reflect.get(el, "value")
    }
  }

  setEnv() {
    const el = document.getElementById("env-input")
    if el {
      this.envText = Reflect.get(el, "value")
    }
  }

  onKey(e) {
    if e.key is not "Escape" {
      return null
    }
    if this.modal is not "" {
      this.closeModal()
    } else if this.logPage {
      this.closeLog()
    }
  }

  jumpBottom() {
    this.scrollPageEnd()
    this.atBottom = true
  }

  showLog(raw) {
    this.logText = raw
    this.logLines = this.parseLog(raw)
    this.logErrors = this.logLines.filter((l) => l.kind is "error").length
    this.logWarns = this.logLines.filter((l) => l.kind is "warn").length
    this.logStages = this.logLines.filter((l) => l.kind is "stage").length
    this.applyLogFilter()

    if this.logPage and this.atBottom {
      window.setTimeout(() => this.scrollPageEnd(), 40)
    }
  }

  setLatest(raw) {
    this.deployLog = raw
    this.latestLines = this.parseLog(raw)
    this.latestErrors = this.latestLines.filter((l) => l.kind is "error").length
    this.latestWarns = this.latestLines.filter((l) => l.kind is "warn").length
    this.latestStages = this.latestLines.filter((l) => l.kind is "stage").length

    const stages = this.latestLines.filter((l) => l.isStage)
    const last = stages.length - 1
    this.stageList = stages.map((s, i) => this.decorateStage(s.text, i is last))

    const rawStage = stages.length > 0 ? stages[last].text : ""
    this.currentStage = ""
    if this.deployStatus is "deploying" {
      this.currentStage = rawStage.length > 80 ? rawStage.slice(0, 80) + "…" : rawStage
    }

    const errs = this.latestLines.filter((l) => l.kind is "error")
    let lastErr = ""
    if errs.length > 0 {
      lastErr = errs[errs.length - 1].text.trim()
    }
    this.lastErrorText = lastErr

    let tail = []
    if this.deployStatus is "deploying" or this.deployStatus is "failed" or this.deployStatus is "cancelled" {
      tail = this.latestLines.filter((l) => not l.isStage and l.text.trim() is not "").slice(-6)
    }
    this.tailLines = tail
  }

  clearCopied() {
    this.copied = false
  }

  async copyLog() {
    await navigator.clipboard.writeText(this.logText)
    this.copied = true
    window.setTimeout(() => this.clearCopied(), 1800)
  }

  parseUtc(v) {
    if not v {
      return 0
    }
    const t = ("" + v).trim()
    const plain = t.length is 19 and t.charAt(10) is " "
    return new Date(plain ? t.replace(" ", "T") + "Z" : t).getTime()
  }

  fmtSecs(secs) {
    if secs >= 60 {
      return Math.floor(secs / 60) + "m " + (secs % 60) + "s"
    }
    return Math.max(0, secs) + "s"
  }

  agoText(v) {
    if not v {
      return ""
    }
    const secs = Math.round((Date.now() - this.parseUtc(v)) / 1000)
    if secs < 45 {
      return "just now"
    }
    if secs < 3600 {
      return Math.round(secs / 60) + " min ago"
    }
    if secs < 86400 {
      return Math.round(secs / 3600) + " h ago"
    }
    return Math.round(secs / 86400) + " d ago"
  }

  elapsedFor() {
    if this.deployStatus is not "deploying" or this.activeStartedAt is "" {
      return ""
    }
    const secs = Math.round((Date.now() - this.parseUtc(this.activeStartedAt)) / 1000)
    return secs >= 0 ? this.fmtSecs(secs) : ""
  }

  commitLink(given, sha) {
    if given is not "" {
      return given
    }
    const repo = this.site ? (this.site.repository or "").trim() : ""
    if sha is "" or repo is "" or repo.includes("@") {
      return ""
    }
    const clean = repo.endsWith(".git") ? repo.slice(0, repo.length - 4) : repo
    const gitlab = this.sourceKind is "gitlab"
    const path = gitlab ? "/-/commit/" : "/commit/"
    if clean.startsWith("http") {
      return clean + path + sha
    }
    if clean.includes(":") {
      return ""
    }
    return (gitlab ? "https://gitlab.com/" : "https://github.com/") + clean + path + sha
  }

  describeStatus() {
    const st = this.deployStatus
    let title = "Not deployed yet"
    let sub = "Press Deploy now to run the first deployment."

    if st is "success" {
      title = "Deployed"
      sub = "Last deployed " + this.agoText(this.deployedRaw)
      if this.lastDuration is not "" {
        sub = sub + ", took " + this.lastDuration
      }
    }
    if st is "failed" {
      title = "Last deployment failed"
      sub = this.lastErrorText is not "" ? this.lastErrorText : "See the log for details."
    }
    if st is "cancelled" {
      title = "Last deployment cancelled"
      sub = "The running commands were stopped. The code on the server may be partially updated, so deploy again before relying on it."
    }
    if st is "queued" {
      title = "Queued"
      sub = this.queuedText
    }
    if st is "deploying" {
      title = this.cancelling ? "Cancelling" : "Deploying"
      sub = this.currentStage is not "" ? this.currentStage : "Starting…"
    }

    this.statusTitle = title
    this.statusSub = sub
  }

  applyStatus(data) {
    this.deployStatus = data.deploy_status
    this.heroCls = this.heroFor(data.deploy_status)
    this.setLatest(data.deploy_log)
    if this.viewId is "" {
      this.logStatus = data.deploy_status
      this.showLog(data.deploy_log)
    }
    this.deployedRaw = data.deployed_at or ""
    this.deployedText = data.deployed_at ? data.deployed_at.slice(0, 16).replace("T", " ") : ""

    const act = data.active or null
    this.runId = 0
    this.cancelling = false
    this.queuePos = 0
    this.activeStartedAt = ""
    if act {
      this.runId = act.id
      this.cancelling = act.cancelling is true
      this.queuePos = act.position or 0
      this.activeStartedAt = act.started_at or ""
    }

    this.queuedText = ""
    if data.deploy_status is "queued" {
      this.queuedText = this.queuePos > 1 ? "Waiting in the queue, position " + this.queuePos : "Waiting to start, you are next in the queue"
      if (data.queued_seconds or 0) > 20 {
        this.queuedText = this.queuedText + " (" + this.fmtSecs(data.queued_seconds) + "). Another deploy on this server may be running; if nothing starts, check the app logs for 'Deploy queue'."
      }
    }

    this.idleText = ""
    if data.deploy_status is "deploying" and (data.idle_seconds or 0) > 45 {
      this.idleText = this.fmtSecs(data.idle_seconds)
    }
    this.elapsedText = this.elapsedFor()

    this.hasProgress = this.latestStages > 0 or data.deploy_status is "queued" or data.deploy_status is "deploying"
    this.describeStatus()

    this.busy = false
    if data.deploy_status is "deploying" or data.deploy_status is "queued" {
      this.busy = true
    }
  }

  openModal(name) {
    this.error = ""
    this.saved = false
    this.modal = name
  }

  openScript() {
    this.openModal("script")
  }

  openEnv() {
    this.openModal("env")
  }

  closeModal() {
    this.modal = ""
    this.error = ""
    this.deleteError = ""
    this.cancelError = ""
  }

  // The log pops over the page like the console: the page stays put
  // behind it and doesn't scroll while it's open.
  openLogPage() {
    if not this.logPage {
      const flux = Reflect.get(window, "__flux")
      if flux {
        // Leaving the page with the log open must not leave the next page
        // unscrollable (this page's own listeners are gone by then).
        flux.on(window, "flux:navigated", () => this.releaseScroll(), { once: true })
      }
    }
    this.error = ""
    this.saved = false
    this.logPage = true
    document.body.style.overflow = "hidden"
  }

  releaseScroll() {
    document.body.style.overflow = ""
  }

  closeLog() {
    this.logPage = false
    this.releaseScroll()
  }

  openLive() {
    this.viewId = ""
    this.logLoading = false
    this.logStatus = this.deployStatus
    this.atBottom = true
    this.showLog(this.deployLog)
    this.openLogPage()
    window.setTimeout(() => this.scrollPageEnd(), 80)
  }

  async openDeployLog(id) {
    const d = this.history.find((x) => x.id is id)
    if not d {
      return null
    }

    if d.status is "deploying" or d.status is "queued" {
      this.openLive()
      return null
    }

    this.viewId = id
    this.logStatus = d.status
    this.logLoading = true
    this.atBottom = true
    this.showLog("")
    this.openLogPage()

    const result = await useApi("/api/sites/" + this.siteId + "/deployments/" + id)

    if this.viewId is id {
      this.logLoading = false
      if result.ok {
        this.logStatus = result.data.status
        this.showLog(result.data.log or "")
        window.setTimeout(() => this.scrollPageEnd(), 80)
      } else if result.status is 401 {
        window.location.href = "/login"
      } else {
        this.showLog("Couldn't load this log.")
      }
    }
  }

  decorateDeploy(d, activeId) {
    let label = "Previous"
    let tone = "bg-slate-500/10 border-slate-500/20 text-slate-500"
    let dot = "bg-slate-400"

    if d.status is "success" and d.id is activeId {
      label = "Active"
      tone = "bg-emerald-500/10 border-emerald-500/20 text-emerald-700 dark:text-emerald-500"
      dot = "bg-emerald-500"
    }
    if d.status is "success" and d.id is not activeId {
      label = "Success"
      tone = "bg-emerald-500/10 border-emerald-500/20 text-emerald-700 dark:text-emerald-500"
      dot = "bg-emerald-500/60"
    }
    if d.status is "failed" {
      label = "Failed"
      tone = "bg-rose-500/10 border-rose-500/20 text-rose-600 dark:text-rose-500"
      dot = "bg-rose-500"
    }
    if d.status is "cancelled" {
      label = "Cancelled"
      tone = "bg-orange-500/10 border-orange-500/20 text-orange-600 dark:text-orange-400"
      dot = "bg-orange-500"
    }
    if d.status is "queued" {
      label = "Queued"
      tone = "bg-sky-500/10 border-sky-500/20 text-sky-600 dark:text-sky-400"
      dot = "bg-sky-500 animate-pulse"
    }
    if d.status is "deploying" {
      label = "Deploying"
      tone = "bg-amber-500/10 border-amber-500/20 text-amber-600 dark:text-amber-500"
      dot = "bg-amber-500 animate-pulse"
    }
    if d.cancelling is true and (d.status is "queued" or d.status is "deploying") {
      label = "Cancelling"
      tone = "bg-orange-500/10 border-orange-500/20 text-orange-600 dark:text-orange-400"
      dot = "bg-orange-500 animate-pulse"
    }

    let duration = ""
    if d.finished_at and d.started_at {
      const secs = Math.round((this.parseUtc(d.finished_at) - this.parseUtc(d.started_at)) / 1000)
      if secs >= 60 {
        duration = Math.floor(secs / 60) + "m " + (secs % 60) + "s"
      } else {
        duration = Math.max(0, secs) + "s"
      }
    }

    const when = d.started_at or d.queued_at or ""
    const commit = d.commit or ""
    const message = d.commit_message or ""
    const link = this.commitLink(d.commit_url or "", commit)
    const host = this.sourceKind is "gitlab" ? "GitLab" : "GitHub"

    let queueText = ""
    if d.status is "queued" {
      queueText = (d.position or 0) > 1 ? "Position " + d.position + " in the queue" : "Next in the queue"
    }

    return Object.assign({}, d, {
      label: label,
      dotCls: "w-2.5 h-2.5 rounded-full shrink-0 " + dot,
      badgeCls: "inline-flex shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider " + tone,
      title: message is not "" ? (message.length > 90 ? message.slice(0, 90) + "…" : message) : "Deployment #" + d.id,
      whenText: when ? when.slice(0, 16).replace("T", " ") : "",
      agoText: this.agoText(when),
      duration: duration,
      queueText: queueText,
      shortCommit: commit.slice(0, 7),
      commitUrl: link,
      commitTitle: "Open commit on " + host,
      canCancel: (d.status is "queued" or d.status is "deploying") and d.cancelling is not true,
      canDelete: d.status is not "deploying" and d.status is not "queued"
    })
  }

  buildTabs(counts) {
    const activeCls = "inline-flex items-center gap-1.5 rounded-md bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium px-3 py-1.5 transition-all"
    const idleCls = "inline-flex items-center gap-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:hover:text-slate-100 text-xs font-medium px-3 py-1.5 transition-colors"
    let keys = [["all", "All", counts.all], ["success", "Successful", counts.success], ["failed", "Failed", counts.failed]]
    if (counts.cancelled or 0) > 0 or this.histFilter is "cancelled" {
      keys = keys.concat([["cancelled", "Cancelled", counts.cancelled or 0]])
    }

    this.histTabs = keys.map((k) => ({
      key: k[0],
      label: k[1],
      count: k[2],
      cls: k[0] is this.histFilter ? activeCls : idleCls
    }))
  }

  buildPages() {
    const total = this.totalPages
    const cur = this.page
    const end = Math.min(total, Math.max(1, cur - 2) + 4)
    const start = Math.max(1, end - 4)
    const activeCls = "w-8 h-8 inline-flex items-center justify-center rounded-md bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-semibold"
    const idleCls = "w-8 h-8 inline-flex items-center justify-center rounded-md text-slate-600 dark:text-slate-300 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"

    this.pageNumbers = Array.from({ length: end - start + 1 }, (x, i) => start + i).map((n) => ({
      n: n,
      cls: n is cur ? activeCls : idleCls
    }))
    this.hasPrev = cur > 1
    this.hasNext = cur < total
  }

  setHistFilter(key) {
    if key is this.histFilter {
      return null
    }
    this.histFilter = key
    this.page = 1
    this.loadHistory()
  }

  goPage(n) {
    if n < 1 or n > this.totalPages or n is this.page {
      return null
    }
    this.page = n
    this.loadHistory()
  }

  prevPage() {
    this.goPage(this.page - 1)
  }

  nextPage() {
    this.goPage(this.page + 1)
  }

  async loadHistory() {
    this.histLoading = true
    this.histBodyCls = "opacity-50 pointer-events-none transition-opacity"

    const query = "?page=" + this.page + "&per_page=" + this.perPage + "&status=" + this.histFilter
    const result = await useApi("/api/sites/" + this.siteId + "/deployments" + query)

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and result.data and Array.isArray(result.data.data) {
      const body = result.data

      // The page we asked for no longer exists (rows were deleted): step back.
      if body.total_pages > 0 and this.page > body.total_pages {
        this.page = body.total_pages
        await this.loadHistory()
        return null
      }

      this.sourceKind = body.source or ""

      const activeId = body.active_id or null
      this.history = body.data.map((d) => this.decorateDeploy(d, activeId))
      this.latestCommit = this.history.find((d) => d.id is activeId and d.shortCommit is not "") or null
      this.total = body.total
      this.totalPages = Math.max(1, body.total_pages)

      const counts = body.counts or { all: body.total, success: 0, failed: 0, cancelled: 0 }
      this.histAll = counts.all
      this.successCount = counts.success
      this.failedCount = counts.failed
      this.cancelledCount = counts.cancelled or 0

      const finishedTotal = counts.success + counts.failed
      this.successRate = finishedTotal > 0 ? Math.round(counts.success / finishedTotal * 100) : 0
      this.rateStyle = "width: " + this.successRate + "%"

      if this.page is 1 and this.histFilter is "all" {
        const finished = this.history.find((d) => d.duration is not "" and d.status is not "cancelled")
        this.lastDuration = finished ? finished.duration : ""
      }

      const from = body.total > 0 ? (this.page - 1) * this.perPage + 1 : 0
      const to = body.total > 0 ? from + this.history.length - 1 : 0
      this.rangeText = body.total > 0 ? "Showing " + from + "–" + to + " of " + body.total : ""

      this.buildTabs(counts)
      this.buildPages()
      this.describeStatus()
    }

    this.histLoading = false
    this.histBodyCls = "transition-opacity"
  }

  openDelete(id) {
    const d = this.history.find((x) => x.id is id)
    if not d {
      return null
    }
    this.deleteTarget = d
    this.deleteError = ""
    this.openModal("delete")
  }

  async confirmDelete() {
    if Billing.locked {
      return null
    }
    if this.deleting or not this.deleteTarget {
      return null
    }

    this.deleting = true
    this.deleteError = ""

    const result = await useApi("/api/sites/" + this.siteId + "/deployments/" + this.deleteTarget.id, { method: "DELETE" })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.modal = ""
      this.deleteTarget = null
      await this.loadHistory()
    } else {
      this.deleteError = result.data?.error or "Couldn't delete this deployment."
    }

    this.deleting = false
  }

  openCancel(id) {
    const d = this.history.find((x) => x.id is id)
    this.cancelTarget = d or { id: id, status: this.deployStatus, whenText: "", shortCommit: "" }
    this.cancelError = ""
    this.openModal("cancel")
  }

  openCancelActive() {
    if this.runId is 0 {
      return null
    }
    this.openCancel(this.runId)
  }

  async confirmCancel() {
    if this.cancelBusy or not this.cancelTarget {
      return null
    }

    this.cancelBusy = true
    this.cancelError = ""

    const result = await useApi("/api/sites/" + this.siteId + "/deployments/" + this.cancelTarget.id + "/cancel", { method: "POST" })

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.modal = ""
      this.cancelTarget = null
      this.cancelling = true
      this.describeStatus()
      this.startPolling()
      await this.poll()
      await this.loadHistory()
    } else {
      this.cancelError = result.data?.error or "Couldn't cancel this deployment."
    }

    this.cancelBusy = false
  }

  // One request at a time: a slow reply that lands after a newer one would
  // put an older, shorter log back on screen.
  async poll() {
    if this.polling {
      return null
    }
    this.polling = true
    const result = await useApi("/api/sites/" + this.siteId + "/deployment")
    this.polling = false

    if result.ok {
      const st = result.data.deploy_status
      const running = st is "deploying" or st is "queued"
      const sameLog = String(result.data.deploy_log or "") is this.deployLog
      const changed = st is not this.lastPolled
      this.lastPolled = st
      this.applyStatus(result.data)

      if running {
        this.doneTicks = 0
        if changed {
          await this.loadHistory()
        }
        return null
      }

      if changed {
        await this.loadHistory()
      }

      // Finished, but keep reading a little longer: the last lines can be
      // saved just after the status (the deployer restarting itself records
      // success first), so stop once the log has stopped growing.
      this.doneTicks = this.doneTicks + 1
      if (this.doneTicks >= 2 and sameLog) or this.doneTicks >= 8 {
        window.clearInterval(this.timer)
        this.doneTicks = 0
      }
    }
  }

  startPolling() {
    window.clearInterval(this.timer)
    this.doneTicks = 0
    this.timer = window.setInterval(() => this.poll(), 2000)
  }

  resetScript() {
    this.scriptText = this.defaultScript
  }

  async persist() {
    const result = await useApi("/api/sites/" + this.siteId + "/deployment", {
      method: "PUT",
      body: {
        deploy_script: this.scriptText,
        env: this.envText
      }
    })

    if result.status is 401 {
      window.location.href = "/login"
      return false
    }

    if result.ok {
      return true
    }

    if result.data?.errors {
      this.error = Object.values(result.data.errors).map((m) => m[0]).join(" ")
    } else {
      this.error = result.data?.error or "Couldn't save."
    }

    return false
  }

  async save() {
    if Billing.locked {
      return null
    }
    if this.saving {
      return null
    }

    this.error = ""
    this.saved = false
    this.saving = true

    const ok = await this.persist()
    if ok {
      this.saved = true
      this.modal = ""
    }

    this.saving = false
  }

  async deploy() {
    if Billing.locked {
      return null
    }
    if this.busy {
      return null
    }

    this.error = ""
    this.saved = false
    this.busy = true

    const ok = await this.persist()
    if not ok {
      this.busy = false
      return null
    }

    const result = await useApi("/api/sites/" + this.siteId + "/deploy", { method: "POST" })

    if result.ok {
      const st = result.data?.deploy_status or "queued"
      this.deployStatus = st
      this.lastPolled = st
      this.runId = result.data?.deployment_id or 0
      this.cancelling = false
      this.heroCls = this.heroFor(st)
      this.viewId = ""
      this.logLoading = false
      this.logStatus = st
      this.atBottom = true
      this.queuedText = "Waiting to start"
      this.setLatest("")
      this.showLog("")
      this.hasProgress = true
      this.describeStatus()
      this.startPolling()
      this.page = 1
      await this.loadHistory()
      return null
    }

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    this.error = result.data?.error or "Couldn't start the deployment."
    this.busy = false
  }

onMount
  async {
    window.addEventListener("keydown", (e) => this.onKey(e))
    window.addEventListener("scroll", () => this.onPageScroll(), true)

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.site = result.data
        this.serverId = "" + result.data.server_id

        // The settings and the history don't depend on each other.
        const both = await Promise.all([useApi("/api/sites/" + id + "/deployment"), this.loadHistory()])
        const config = both[0]
        if config.ok {
          this.canDeploy = config.data.can_deploy
          this.scriptText = config.data.deploy_script
          this.defaultScript = config.data.default_script
          this.envText = config.data.env
          this.envPath = config.data.env_path
          this.applyStatus(config.data)
          this.lastPolled = config.data.deploy_status

          if config.data.deploy_status is "deploying" or config.data.deploy_status is "queued" {
            this.startPolling()
          }
        }

        this.loading = false
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="deployment" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading deployment…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Deployment" description="Push to deploy, or deploy by hand, and follow every release." domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}">
        <div slot="actions" class="flex items-center gap-2 shrink-0">
          <a href="{{ 'https://' + site.domain }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconExternalLink class="w-4 h-4" /> Visit site
          </a>
        </div>
      </SiteHeader>

      <LockedBanner />

      <div class="min-w-0">
        <div class="min-w-0 flex-1 max-w-5xl space-y-6">

{{#if error}}
{{#if modal is ""}}
          <div role="alert" class="rounded-2xl border border-rose-500/30 bg-rose-500/5 p-5">
            <p class="text-rose-500 text-sm break-words">{{ error }}</p>
          </div>
{{/if}}
{{/if}}

{{#if not canDeploy}}
          <div class="rounded-2xl border border-line bg-panel p-8 shadow-sm dark:shadow-none">
            <p class="text-slate-900 dark:text-slate-100 text-sm">This site has no repository, so there is nothing to deploy.</p>
{{#if site.type is not "wordpress"}}
            <a href="{{ '/servers/site-settings?id=' + siteId + '#repository' }}" class="inline-flex mt-4 text-sm bg-brand-500 text-white font-semibold rounded-full px-4 py-2 hover:bg-brand-400 transition-colors">Connect a repository</a>
{{/if}}
          </div>
{{/if}}

{{#if canDeploy}}
          <DeployStatusCard
            title="{{ statusTitle }}"
            sub="{{ statusSub }}"
            dotCls="{{ heroCls }}"
            elapsed="{{ elapsedText }}"
            idle="{{ idleText }}"
            busy="{{ busy }}"
            cancelling="{{ cancelling }}"
            locked="{{ Billing.locked }}"
            saved="{{ saved }}"
            branch="{{ site.branch }}"
            commit="{{ latestCommit }}"
            runs="{{ histAll }}"
            successRate="{{ successRate }}"
            rateStyle="{{ rateStyle }}"
            hasEnv="{{ envPath is not '' }}"
            onDeploy="{{ deploy }}"
            onCancel="{{ openCancelActive }}"
            onScript="{{ openScript }}"
            onEnv="{{ openEnv }}"
          />

{{#if hasProgress}}
          <DeployProgressCard
            deployStatus="{{ deployStatus }}"
            queuedText="{{ queuedText }}"
            stages="{{ stageList }}"
            stageCount="{{ latestStages }}"
            tail="{{ tailLines }}"
            domain="{{ site.domain }}"
            onOpenLog="{{ openLive }}"
          />
{{/if}}

          <DeployHistory
            rows="{{ history }}"
            tabs="{{ histTabs }}"
            rangeText="{{ rangeText }}"
            loading="{{ histLoading }}"
            bodyCls="{{ histBodyCls }}"
            page="{{ page }}"
            totalPages="{{ totalPages }}"
            pageNumbers="{{ pageNumbers }}"
            hasPrev="{{ hasPrev }}"
            hasNext="{{ hasNext }}"
            onFilter="{{ setHistFilter }}"
            onPage="{{ goPage }}"
            onViewLog="{{ openDeployLog }}"
            onCancel="{{ openCancel }}"
            onDelete="{{ openDelete }}"
          />
{{/if}}

        </div>
      </div>
{{/if}}

{{#if logPage}}
{{#if site}}
      <DeployLogConsole
        site="{{ site }}"
        viewId="{{ viewId }}"
        logStatus="{{ logStatus }}"
        lines="{{ logLines }}"
        shown="{{ shownLogLines }}"
        tabs="{{ logTabs }}"
        filter="{{ logFilter }}"
        text="{{ logText }}"
        loading="{{ logLoading }}"
        atBottom="{{ atBottom }}"
        copied="{{ copied }}"
        errors="{{ logErrors }}"
        warns="{{ logWarns }}"
        stages="{{ logStages }}"
        queuedText="{{ queuedText }}"
        elapsed="{{ elapsedText }}"
        deployedText="{{ deployedText }}"
        canCancel="{{ viewId is '' and busy and runId is not 0 }}"
        cancelling="{{ cancelling }}"
        onClose="{{ closeLog }}"
        onCopy="{{ copyLog }}"
        onFilter="{{ setLogFilter }}"
        onJumpLine="{{ jumpToLine }}"
        onJumpError="{{ jumpToError }}"
        onJumpBottom="{{ jumpBottom }}"
        onCancel="{{ openCancelActive }}"
      />
{{/if}}
{{/if}}

{{#if modal is "script"}}
      <DeployEditorModal kind="script" value="{{ scriptText }}" error="{{ error }}" saving="{{ saving }}" locked="{{ Billing.locked }}" onInput="{{ setScript }}" onSave="{{ save }}" onReset="{{ resetScript }}" onClose="{{ closeModal }}" />
{{/if}}

{{#if modal is "env"}}
      <DeployEditorModal kind="env" value="{{ envText }}" envPath="{{ envPath }}" error="{{ error }}" saving="{{ saving }}" locked="{{ Billing.locked }}" onInput="{{ setEnv }}" onSave="{{ save }}" onClose="{{ closeModal }}" />
{{/if}}

{{#if modal is "delete"}}
      <DeployConfirmModal kind="delete" target="{{ deleteTarget }}" error="{{ deleteError }}" busy="{{ deleting }}" locked="{{ Billing.locked }}" onConfirm="{{ confirmDelete }}" onClose="{{ closeModal }}" />
{{/if}}

{{#if modal is "cancel"}}
      <DeployConfirmModal kind="cancel" target="{{ cancelTarget }}" error="{{ cancelError }}" busy="{{ cancelBusy }}" onConfirm="{{ confirmCancel }}" onClose="{{ closeModal }}" />
{{/if}}

    </div>
    </div>
  </div>