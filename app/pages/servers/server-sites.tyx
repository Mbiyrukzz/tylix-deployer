page ServerSites

import { IconArrowLeft, IconDatabase } from "tylix-icons"

title "Sites"

needs
  Auth

uses
  Billing

background
  Billing

state
  serverId: ""
  server: null
  sites: []
  loading: true
  isMissing: false

action
  async load() {
    const result = await useApi("/api/sites")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and Array.isArray(result.data) {
      const sid = Number(this.serverId)
      this.sites = result.data.filter((s) => Number(s.server_id) is sid)
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const serverId = params.get("id")
    this.serverId = serverId or ""

    if not serverId {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/servers/" + serverId)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.server = result.data
        await this.load()
        this.loading = false
        window.setInterval(() => this.load(), 5000)
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_1fr] bg-page transition-colors">
{{#if serverId}}
{{#if not isMissing}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{/if}}
{{#if isMissing}}
    <div></div>
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-6 sm:py-10">

{{#if loading}}
      <LoaderMark label="Loading sites…" />
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Server not found" body="It may have been deleted, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if server}}
      <a href="{{ '/servers/server-detail?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> {{ server.name }}
      </a>

      <LockedBanner />

      <div class="flex items-start justify-between gap-4 mb-8">
        <div>
          <h1 class="text-2xl sm:text-[28px] font-semibold tracking-tight text-slate-800 dark:text-slate-200">Sites</h1>
          <p class="text-slate-500 text-sm mt-1">Websites and apps running on this server</p>
        </div>
{{#if Billing.locked}}
        <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 cursor-not-allowed select-none">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
            <rect x="4" y="9" width="12" height="8" rx="2" />
            <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
          </svg>
          Create site
        </button>
{{/if}}
{{#if not Billing.locked}}
        <div class="flex flex-wrap justify-end gap-2">
          <a href="{{ '/servers/server-import?id=' + serverId }}" class="inline-flex items-center text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Import from server</a>
          <a href="{{ '/servers/site-create?id=' + serverId }}" class="inline-flex items-center text-sm bg-brand-500 text-white font-semibold rounded-full px-4 py-2 shadow-sm hover:bg-brand-400 hover:shadow transition-all">Create site</a>
        </div>
{{/if}}
      </div>

{{#if sites.length is 0}}
      <div class="rounded-2xl border border-dashed border-slate-400 dark:border-slate-800 bg-panel p-10 text-center">
        <div class="w-14 h-14 rounded-2xl bg-brand-500/10 flex items-center justify-center mx-auto mb-4">
          <IconDatabase class="w-6 h-6 text-brand-700 dark:text-brand-500" />
        </div>
        <h3 class="text-slate-800 dark:text-slate-200 font-medium mb-1.5">No sites yet</h3>
        <p class="text-slate-500 text-sm max-w-sm mx-auto">Create a site to set up a domain, clone your code and serve it with nginx.</p>
{{#if not Billing.locked}}
        <p class="text-slate-500 text-sm max-w-sm mx-auto mt-2">Sites already running on this server (from Vito, for example)? <a href="{{ '/servers/server-import?id=' + serverId }}" class="text-brand-700 dark:text-brand-500 font-medium hover:underline">Import them</a>.</p>
{{/if}}
      </div>
{{/if}}

{{#if sites.length is not 0}}
      <div class="space-y-3">
{{#each s in sites}}
        <a href="{{ '/servers/site-detail?id=' + s.id }}" class="group block rounded-2xl border border-slate-300 dark:border-slate-800 bg-panel p-5 shadow-sm dark:shadow-none hover:border-brand-500/40 transition-all">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h3 class="text-slate-800 dark:text-slate-200 font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-500 transition-colors truncate">{{ s.domain }}</h3>
              <p class="text-slate-500 text-xs font-mono mt-1">{{ s.type }} / {{ s.isolated_user }}{{ s.origin is "import" ? " · imported" : "" }}</p>
            </div>
{{#if s.status is "ready"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
            </span>
{{/if}}
{{#if s.status is "failed"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
            </span>
{{/if}}
{{#if s.status is "creating"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Creating
            </span>
{{/if}}
{{#if s.status is "pending"}}
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Queued
            </span>
{{/if}}
          </div>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

    </div>
    </div>
  </div>