page SiteCommands

import { IconArrowLeft } from "tylix-icons"

title "Site commands"

needs
  Auth

uses
  Billing

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  notFound: false
  canRun: false
  command: ""
  directory: ""
  presets: []
  runs: []
  openRun: ""
  error: ""
  starting: false
  timer: 0

action
    describe(site) {
    const php = site.php_version ? "php" + site.php_version : "php"
    const composer = php + " $(command -v composer) install --no-dev --no-interaction"
    const isNode = ["tylix", "nodejs", "nextjs", "mern", "react", "angular"].includes(site.type)

    const laravel = [
      ["Migrate", php + " artisan migrate --force"],
      ["Clear caches", php + " artisan optimize:clear"],
      ["Cache config and routes", php + " artisan optimize"],
      ["Restart queue workers", php + " artisan queue:restart"],
      ["Link storage", php + " artisan storage:link"],
      ["Install Composer packages", composer]
    ]

    const node = [
      ["Install dependencies", "npm install"],
      ["Build", "npm run build"]
    ]

    const common = [
      ["List files", "ls -la"],
      ["Disk usage", "du -sh ."]
    ]

    let specific = common.slice(0, 0)
    if site.type is "laravel" {
      specific = laravel
    } else if isNode {
      specific = node
    }

    this.site = site
    this.serverId = "" + site.server_id
    this.canRun = site.status is "ready"
    this.presets = specific.concat(common).map((p) => ({ label: p[0], command: p[1] }))
  }

  decorate(list) {
    return list.map((r) => Object.assign({}, r, {
      isRunning: r.status is "running",
      isSuccess: r.status is "success",
      isFailed: r.status is "failed",
      when: (r.started_at or "").slice(0, 19).replace("T", " "),
      codeText: r.status is "running" ? "" : "exit " + r.code
    }))
  }

  async loadRuns() {
    const result = await useApi("/api/sites/" + this.siteId + "/commands")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and Array.isArray(result.data) {
      this.runs = this.decorate(result.data)

      const anyRunning = this.runs.some((r) => r.isRunning)
      if anyRunning {
        if not this.timer {
          this.timer = window.setInterval(() => this.loadRuns(), 2000)
        }
      } else {
        window.clearInterval(this.timer)
        this.timer = 0
      }
    }
  }

  pick(command) {
    this.command = command
    this.error = ""
  }

  toggleRun(id) {
    if this.openRun is id {
      this.openRun = ""
    } else {
      this.openRun = id
    }
  }

  reuse(command, directory) {
    this.command = command
    this.directory = directory or ""
    this.error = ""
  }

  async run() {
    if Billing.locked {
      return null
    }
    if this.starting {
      return null
    }

    this.error = ""

    if this.command.trim() is "" {
      this.error = "Type a command first."
      return null
    }

    this.starting = true

    const result = await useApi("/api/sites/" + this.siteId + "/commands", {
      method: "POST",
      body: { command: this.command, directory: this.directory }
    })

    if result.ok {
      this.openRun = result.data.id
      await this.loadRuns()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't run that command."
    }

    this.starting = false
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    if not id {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false
        await this.loadRuns()
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-10 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-2">Site not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been removed, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if site}}
      <a href="{{ '/servers/server-sites?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Sites
      </a>

      <LockedBanner />

      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate mb-2">{{ site.domain }}</h1>
        <p class="text-slate-500 text-sm">Commands</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <SiteSidebar active="commands" siteId="{{ siteId }}" />

        <div class="min-w-0 flex-1">

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Run a command</h2>
            <p class="text-slate-500 text-sm mb-5">Runs on the server in the site folder as <span class="font-mono">{{ site.isolated_user }}</span>, never as root. One command at a time, stopped after 10 minutes.</p>

{{#if not canRun}}
            <p class="text-slate-500 text-sm">Commands can be run once the site has finished creating.</p>
{{/if}}

{{#if canRun}}
            <div class="flex flex-wrap gap-2 mb-4">
{{#each c in presets}}
              <button onclick="{{ pick(c.command) }}" title="{{ c.command }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1.5 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">{{ c.label }}</button>
{{/each}}
            </div>

            <div class="flex flex-col gap-3">
              <input
                type="text"
                value="{{ command }}"
                oninput="{{ command = $event.target.value }}"
                spellcheck="false"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
                placeholder="Command, for example: npm run build"
              />
              <div class="flex flex-wrap items-center gap-3">
                <input
                  type="text"
                  value="{{ directory }}"
                  oninput="{{ directory = $event.target.value }}"
                  spellcheck="false"
                  class="min-w-0 flex-1 sm:flex-none sm:w-64 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm font-mono px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
                  placeholder="Folder (optional), e.g. client"
                />
{{#if Billing.locked}}
                <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2 cursor-not-allowed select-none">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                    <rect x="4" y="9" width="12" height="8" rx="2" />
                    <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                  </svg>
                  Run
                </button>
{{/if}}
{{#if not Billing.locked}}
                <button onclick="{{ run() }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 transition-all">
                  {{#if starting}}Starting…{{/if}}{{#if not starting}}Run{{/if}}
                </button>
{{/if}}
              </div>
            </div>

{{#if error}}
            <p role="alert" class="text-rose-500 text-sm mt-4">{{ error }}</p>
{{/if}}
{{/if}}
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Recent runs</h2>
            <p class="text-slate-500 text-sm mb-5">The last 20 runs for this site. History is cleared when the app restarts.</p>

{{#if runs.length is 0}}
            <p class="text-slate-500 text-sm">Nothing has been run yet.</p>
{{/if}}

{{#each r in runs}}
            <div class="rounded-xl border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950/40 p-5 mb-3">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
{{#if r.isSuccess}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Done
                    </span>
{{/if}}
{{#if r.isRunning}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Running
                    </span>
{{/if}}
{{#if r.isFailed}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
                    </span>
{{/if}}
                    <span class="text-slate-500 text-xs">{{ r.when }}</span>
{{#if r.codeText}}
                    <span class="text-slate-500 text-xs font-mono">{{ r.codeText }}</span>
{{/if}}
                  </div>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ r.command }}</p>
{{#if r.directory}}
                  <p class="text-slate-500 text-xs mt-1">in <span class="font-mono">{{ r.directory }}</span></p>
{{/if}}
                </div>

                <div class="shrink-0 flex items-center gap-2">
                  <button onclick="{{ toggleRun(r.id) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1.5 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Output</button>
                  <button onclick="{{ reuse(r.command, r.directory) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1.5 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Use again</button>
                </div>
              </div>

{{#if openRun is r.id}}
{{#if r.output}}
              <div class="mt-4 max-h-96 overflow-y-auto rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 p-4 text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-words">{{ r.output }}</div>
{{/if}}
{{#if not r.output}}
{{#if r.isRunning}}
              <p class="text-slate-500 text-xs mt-4">Running. Output appears when the command finishes.</p>
{{/if}}
{{#if not r.isRunning}}
              <p class="text-slate-500 text-xs mt-4">The command printed nothing.</p>
{{/if}}
{{/if}}
{{/if}}
            </div>
{{/each}}
          </div>

        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>