page SiteLogs


title "Site logs"

needs
  Auth

// The full log viewer is the ConsoleDock (app/pages/components), which pops
// over any page; arriving here opens it. This page is the summary behind it:
// how many errors, which logs there are, and the newest errors.

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  isMissing: false
  siteReady: true
  busy: false
  seq: 0
  error: ""
  sources: []
  source: ""
  tiles: []
  lines: 1000
  entries: []
  preview: []
  errorCount: 0
  scanned: 0
  logsMissing: false
  loaded: false
  copied: ""
  fetchedAt: ""

action
  describeSource(id) {
    if id is "app" {
      return "Output from the app's systemd service: crashes, unhandled errors and anything it prints."
    }
    if id is "laravel" {
      return "The newest storage/logs/laravel log, with each stack trace kept together."
    }
    if id is "nginx" {
      return "Errors nginx recorded for this domain: upstream failures, permissions, bad configs."
    }
    if id is "phpfpm" {
      return "Warnings and errors from this site's PHP-FPM pool."
    }
    return "Requests that were answered with a 5xx status."
  }

  tileTone(id) {
    const base = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold "
    if id is "app" {
      return base + "bg-brand-500/10 text-brand-700 dark:text-brand-500"
    }
    if id is "laravel" {
      return base + "bg-rose-500/10 text-rose-600 dark:text-rose-400"
    }
    if id is "nginx" {
      return base + "bg-sky-500/10 text-sky-600 dark:text-sky-400"
    }
    if id is "phpfpm" {
      return base + "bg-violet-500/10 text-violet-600 dark:text-violet-400"
    }
    return base + "bg-amber-500/10 text-amber-600 dark:text-amber-400"
  }

  refreshTiles() {
    this.tiles = this.sources.map((s) => ({
      id: s.id,
      label: s.label,
      desc: this.describeSource(s.id),
      letter: s.label.charAt(0).toUpperCase(),
      tile: this.tileTone(s.id)
    }))
  }

  decorate(list) {
    return list.map((e) => {
      const warn = e.level is "warn" or e.level is "warning"
      let toneCls = "shrink-0 inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider bg-slate-500/10 text-slate-600 dark:text-slate-400"
      if e.error {
        toneCls = "shrink-0 inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider bg-rose-500/10 text-rose-600 dark:text-rose-400"
      } else if warn {
        toneCls = "shrink-0 inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-400"
      }
      return Object.assign({}, e, {
        toneCls: toneCls,
        levelText: e.level or "log",
        timeText: e.time or "",
        moreText: e.line_count > 1 ? ("+" + (e.line_count - 1) + " lines") : ""
      })
    })
  }

  sourceLabel() {
    const hit = this.sources.find((s) => s.id is this.source)
    return hit ? hit.label : this.source
  }

  async loadLogs() {
    this.seq = this.seq + 1
    const ticket = this.seq
    this.busy = true
    this.error = ""

    const query = "?source=" + encodeURIComponent(this.source) + "&lines=" + this.lines + "&errors=1"
    const result = await useApi("/api/sites/" + this.siteId + "/logs" + query)

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }
    if ticket is not this.seq {
      return null
    }

    if result.ok {
      this.sources = result.data.sources
      this.source = result.data.source
      this.entries = result.data.entries
      this.scanned = result.data.scanned
      this.logsMissing = result.data.missing
      this.fetchedAt = new Date().toLocaleTimeString()
      this.loaded = true
      this.errorCount = this.entries.filter((e) => e.error).length
      this.preview = this.decorate(this.entries.filter((e) => e.error).slice(0, 5))
      this.refreshTiles()
    } else if result.status is 403 {
      this.error = "Only team admins can view site logs."
    } else {
      this.error = result.data?.error or "Couldn't load the logs."
    }

    this.busy = false
  }

  // Opens the console's log view on a source, optionally on one entry.
  openConsole(source, entry) {
    const flux = Reflect.get(window, "__flux")
    if flux {
      flux.emit("flux:console", { kind: "site", id: this.siteId, tab: "logs", source: source or this.source, entry: entry or "" })
    }
  }

  fallbackCopy(text, done) {
    const ta = document.createElement("textarea")
    ta.value = text
    ta.style.position = "fixed"
    ta.style.opacity = "0"
    document.body.appendChild(ta)
    ta.select()
    document.execCommand("copy")
    document.body.removeChild(ta)
    done()
  }

  copyText(text, label) {
    const done = () => {
      this.copied = label
      window.setTimeout(() => {
        this.copied = ""
      }, 1800)
    }

    if window.navigator.clipboard and window.navigator.clipboard.writeText {
      window.navigator.clipboard.writeText(text).then(done).catch(() => this.fallbackCopy(text, done))
    } else {
      this.fallbackCopy(text, done)
    }
  }

  copyOne(id) {
    const hit = this.entries.find((e) => e.id is id)
    if hit {
      const nl = String.fromCharCode(10)
      this.copyText("[" + hit.level + "] " + (hit.time or "") + nl + hit.detail, id)
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.site = result.data
        this.serverId = "" + result.data.server_id
        this.siteReady = result.data.status is "ready"
        this.loading = false

        if this.siteReady {
          await this.loadLogs()
        }
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div id="site-logs-root" class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="logs" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading logs…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Logs" description="Find out why a site is failing: open the logs, expand an error to see its full trace, and copy it." domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}">
        <div slot="actions" class="shrink-0">
{{#if siteReady}}
          <button onclick="{{ openConsole('', '') }}" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 h-10 sm:h-9 text-sm bg-zinc-950 text-brand-400 border border-zinc-700 font-mono font-semibold rounded-full px-5 shadow-sm hover:border-brand-500/60 transition-colors">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4"><path d="M4 6l4 4-4 4M10 15h6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Open logs
          </button>
{{/if}}
        </div>
      </SiteHeader>

      <div class="min-w-0">
        <div class="min-w-0 flex-1 space-y-4 sm:space-y-6">

{{#if not siteReady}}
          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 text-center shadow-sm dark:shadow-none">
            <p class="text-slate-500 text-sm">Logs are available once the site has finished creating.</p>
          </section>
{{/if}}

{{#if siteReady}}

{{#if error}}
          <p role="alert" class="rounded-xl border border-rose-500/30 bg-rose-500/5 px-4 py-3 text-rose-500 text-sm break-words">{{ error }}</p>
{{/if}}

{{#if loaded}}
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
            <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
              <p class="text-slate-500 text-xs mb-1">Errors found</p>
{{#if errorCount is 0}}
              <p class="text-brand-700 dark:text-brand-400 text-2xl font-bold">0</p>
{{/if}}
{{#if errorCount is not 0}}
              <p class="text-rose-600 dark:text-rose-400 text-2xl font-bold">{{ errorCount }}</p>
{{/if}}
              <p class="text-slate-500 text-xs mt-1">in {{ sourceLabel() }}</p>
            </div>
            <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
              <p class="text-slate-500 text-xs mb-1">Lines scanned</p>
              <p class="text-slate-900 dark:text-slate-100 text-2xl font-bold">{{ scanned }}</p>
              <p class="text-slate-500 text-xs mt-1">newest first</p>
            </div>
            <div class="rounded-2xl border border-line bg-panel p-4 sm:p-5 shadow-sm dark:shadow-none">
              <p class="text-slate-500 text-xs mb-1">Last checked</p>
              <p class="text-slate-900 dark:text-slate-100 text-2xl font-bold">{{ fetchedAt }}</p>
              <p class="text-slate-500 text-xs mt-1">read from the server</p>
            </div>
          </div>
{{/if}}

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center gap-3 mb-4 sm:mb-5">
              <span class="w-1.5 h-5 shrink-0 rounded-full bg-brand-500"></span>
              <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Log sources</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each t in tiles}}
              <button onclick="{{ openConsole(t.id, '') }}" class="min-h-[72px] flex items-start gap-3 text-left rounded-xl border-2 border-line px-3.5 py-3 transition-colors hover:border-brand-500/40">
                <span class="{{ t.tile }}">{{ t.letter }}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-slate-100">{{ t.label }}</span>
                  <span class="block text-xs text-slate-500 leading-relaxed">{{ t.desc }}</span>
                </span>
              </button>
{{/each}}
            </div>
          </section>

          <section class="rounded-2xl border border-line bg-panel p-4 sm:p-6 shadow-sm dark:shadow-none">
            <div class="flex items-center justify-between gap-3 mb-4 sm:mb-5">
              <div class="flex items-center gap-3 min-w-0">
                <span class="w-1.5 h-5 shrink-0 rounded-full bg-rose-500"></span>
                <h2 class="text-slate-900 dark:text-slate-100 font-semibold">Latest errors</h2>
              </div>
              <button onclick="{{ openConsole('', '') }}" class="shrink-0 text-sm text-brand-700 dark:text-brand-500 hover:underline font-medium">See all</button>
            </div>

{{#if not loaded}}
            <p class="text-slate-500 text-sm">Reading the log from the server…</p>
{{/if}}

{{#if loaded}}
{{#if logsMissing}}
            <div class="rounded-xl border border-dashed border-line-strong px-4 py-8 text-center">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1">No log file yet</p>
              <p class="text-slate-500 text-sm">It hasn't been created on the server, which usually means nothing has been written to it.</p>
            </div>
{{/if}}
{{#if not logsMissing}}
{{#if preview.length is 0}}
            <div class="rounded-xl border border-dashed border-line-strong px-4 py-8 text-center">
              <p class="text-slate-900 dark:text-slate-100 text-sm font-medium mb-1">No recent errors</p>
              <p class="text-slate-500 text-sm">Nothing was logged at error level in the last {{ lines }} lines.</p>
            </div>
{{/if}}
{{/if}}
{{/if}}

{{#each e in preview}}
            <div class="flex items-start gap-3 rounded-xl border border-line bg-slate-50 dark:bg-slate-950/40 p-3 sm:p-4 mb-2">
              <span class="{{ e.toneCls }}">{{ e.levelText }}</span>
              <div class="min-w-0 flex-1">
                <p class="text-slate-900 dark:text-slate-100 text-sm font-mono break-words line-clamp-2">{{ e.message }}</p>
                <p class="text-slate-500 text-xs mt-1">{{ e.timeText }} {{ e.moreText }}</p>
              </div>
              <div class="shrink-0 flex items-center gap-2">
                <button onclick="{{ openConsole('', e.id) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-line-strong rounded-full px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">View</button>
                <button onclick="{{ copyOne(e.id) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-line-strong rounded-full px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  {{#if copied is e.id}}Copied{{/if}}{{#if copied is not e.id}}Copy{{/if}}
                </button>
              </div>
            </div>
{{/each}}

            <p class="text-slate-500 text-xs mt-4 leading-relaxed">Passwords, tokens and keys are masked on a best-effort basis. Read an entry before pasting it somewhere public.</p>
          </section>

{{/if}}

        </div>
      </div>

{{/if}}

    </div>
    </div>
  </div>