page SiteSettings

import { IconArrowLeft } from "tylix-icons"

title "Site settings"

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  notFound: false
  typeLabel: ""
  groups: []
  plugins: []
  openLog: ""
  error: ""
  timer: 0
  selected: ""
  choices: []
  activeCount: 0

action
  describe(site) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["react", "React"],
      ["static", "Static"]
    ]

    const typeHit = labels.find((l) => l[0] is site.type)
    const typeLabel = typeHit ? typeHit[1] : site.type

    const row = (label, value, mono) => ({ label: label, value: (value or "") + "", mono: mono })
    const keep = (rows) => rows.filter((r) => r.value is not "")

    const sslLabel = site.ssl_mode is "letsencrypt" ? "Let's Encrypt" : (site.ssl_mode is "custom" ? "Custom certificate" : "None")
    const deps = site.repository ? (site.install_deps ? "Yes" : "No") : ""
    const aliases = Array.isArray(site.aliases) ? site.aliases.join(", ") : ""

    this.site = site
    this.serverId = "" + site.server_id
    this.typeLabel = typeLabel

    this.groups = [
      {
        title: "General",
        rows: keep([
          row("Type", typeLabel, false),
          row("Status", site.status, false),
          row("Domain", site.domain, true),
          row("Aliases", aliases, true),
          row("Isolated user", site.isolated_user, true),
          row("Site folder", "/home/" + site.isolated_user + "/" + site.domain, true),
          row("PHP version", site.php_version, true),
          row("App port", site.port, true),
          row("Created", (site.created_at or "").slice(0, 10), false),
          row("Last updated", (site.updated_at or "").slice(0, 10), false)
        ])
      },
      {
        title: "Source",
        rows: keep([
          row("Repository", site.repository, true),
          row("Branch", site.branch, true),
          row("Install dependencies", deps, false)
        ])
      },
      {
        title: "Directories and commands",
        rows: keep([
          row("Web directory", site.web_directory, true),
          row("App folder", site.app_directory, true),
          row("API folder", site.backend_directory, true),
          row("Build command", site.build_command, true),
          row("Start command", site.start_command, true)
        ])
      },
      {
        title: "Deployment",
        rows: keep([
          row("Deploy status", site.deploy_status, false),
          row("Last deployed", (site.deployed_at or "").slice(0, 19).replace("T", " "), false)
        ])
      },
      {
        title: "HTTPS",
        rows: keep([
          row("Method", sslLabel, false),
          row("Status", site.ssl_status, false),
          row("Expires", (site.ssl_expires_at or "").slice(0, 10), false)
        ])
      }
    ].filter((g) => g.rows.length > 0)
  }

   decorate(list) {
    return list.map((p) => Object.assign({}, p, {
      busy: p.status is "installing" or p.status is "removing",
      isInstalled: p.status is "installed",
      isFailed: p.status is "failed" or p.status is "remove_failed",
      isAvailable: p.status is "available",
      shown: p.status is not "available",
      label: p.group + " · " + p.name + (p.blocked ? " (unavailable)" : ""),
      portText: p.port ? "" + p.port : ""
    }))
  }

  async loadPlugins() {
    const result = await useApi("/api/sites/" + this.siteId + "/plugins")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and Array.isArray(result.data) {
      this.plugins = this.decorate(result.data)
      this.choices = this.plugins.filter((p) => p.isAvailable)
      this.activeCount = this.plugins.filter((p) => p.shown).length

      const anyBusy = this.plugins.some((p) => p.busy)
      if anyBusy {
        if not this.timer {
          this.timer = window.setInterval(() => this.loadPlugins(), 3000)
        }
      } else {
        window.clearInterval(this.timer)
        this.timer = 0
      }
    }
  }

  toggleLog(id) {
    if this.openLog is id {
      this.openLog = ""
    } else {
      this.openLog = id
    }
  }

    async install(id) {
    this.error = ""

    if not id {
      this.error = "Choose a plugin first."
      return null
    }

    const picked = this.plugins.find((p) => p.id is id)
    if picked and picked.isAvailable and picked.blocked {
      this.error = picked.blocked
      return null
    }

    const result = await useApi("/api/sites/" + this.siteId + "/plugins", { method: "POST", body: { plugin: id } })

    if result.ok {
      this.openLog = id
      this.selected = ""
      await this.loadPlugins()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't install that plugin."
    }
  }

  async remove(id) {
    if not window.confirm("Remove this plugin from the site? Its service and nginx settings will be taken off the server.") {
      return null
    }

    this.error = ""
    const result = await useApi("/api/sites/" + this.siteId + "/plugins/" + id, { method: "DELETE" })

    if result.ok {
      this.openLog = id
      await this.loadPlugins()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't remove that plugin."
    }
  }

onMount
  async {
    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    if not id {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false
        await this.loadPlugins()
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_230px_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-2">Site not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been removed, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if site}}
      <a href="{{ '/servers/server-sites?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Sites
      </a>

      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate mb-2">{{ site.domain }}</h1>
        <p class="text-slate-500 text-sm">Settings</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <SiteSidebar active="settings" siteId="{{ siteId }}" />

        <div class="min-w-0 flex-1">

{{#each group in groups}}
          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-5">{{ group.title }}</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
{{#each row in group.rows}}
              <div class="min-w-0">
                <p class="text-slate-500 text-xs mb-1">{{ row.label }}</p>
{{#if row.mono}}
                <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ row.value }}</p>
{{/if}}
{{#if not row.mono}}
                <p class="text-slate-800 dark:text-slate-200 text-sm break-words">{{ row.value }}</p>
{{/if}}
              </div>
{{/each}}
            </div>
          </div>
{{/each}}

                    <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Plugins</h2>
            <p class="text-slate-500 text-sm mb-5">Extras you can add to this {{ typeLabel }} site. Each one installs over SSH, and you can remove it again.</p>

            <div class="flex flex-wrap items-center gap-3 mb-6">
{{#if choices.length is 0}}
              <p class="text-slate-500 text-sm">Every plugin for this site type has been added.</p>
{{/if}}
{{#if choices.length is not 0}}
              <select
                value="{{ selected }}"
                onchange="{{ selected = $event.target.value }}"
                class="min-w-0 flex-1 sm:flex-none sm:w-80 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
              >
                <option value="">Add a plugin…</option>
{{#each c in choices}}
                <option value="{{ c.id }}">{{ c.label }}</option>
{{/each}}
              </select>
              <button onclick="{{ install(selected) }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 transition-all">Install</button>
{{/if}}
            </div>

{{#if error}}
            <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

{{#if activeCount is 0}}
            <p class="text-slate-500 text-sm">Nothing added yet.</p>
{{/if}}

{{#each p in plugins}}
{{#if p.shown}}
            <div class="rounded-xl border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950/40 p-5 mb-3">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <h3 class="text-slate-800 dark:text-slate-200 text-sm font-semibold">{{ p.name }}</h3>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">{{ p.group }}</span>
{{#if p.isInstalled}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Installed
                    </span>
{{/if}}
{{#if p.busy}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Working
                    </span>
{{/if}}
{{#if p.isFailed}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
                    </span>
{{/if}}
                  </div>
                  <p class="text-slate-500 text-sm">{{ p.description }}</p>
{{#if p.portText}}
                  <p class="text-slate-500 text-xs mt-1">Local port <span class="font-mono">{{ p.portText }}</span></p>
{{/if}}
                </div>

                <div class="shrink-0 flex items-center gap-2">
                  <button onclick="{{ toggleLog(p.id) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1.5 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Details</button>
{{#if p.isInstalled}}
                  <button onclick="{{ remove(p.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-1.5 hover:bg-rose-500/5 transition-colors">Remove</button>
{{/if}}
{{#if p.isFailed}}
                  <button onclick="{{ install(p.id) }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-1.5 shadow-sm hover:bg-emerald-400 transition-all">Retry</button>
                  <button onclick="{{ remove(p.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-1.5 hover:bg-rose-500/5 transition-colors">Remove</button>
{{/if}}
                </div>
              </div>

{{#if p.error}}
              <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ p.error }}</p>
{{/if}}

{{#if openLog is p.id}}
{{#each n in p.notes}}
              <p class="text-slate-500 text-xs mt-3">&bull; {{ n }}</p>
{{/each}}
{{#if p.log}}
              <div class="mt-4 max-h-80 overflow-y-auto rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 p-4 text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-words">{{ p.log }}</div>
{{/if}}
{{/if}}
            </div>
{{/if}}
{{/each}}
          </div>

        </div>
      </div>
{{/if}}

    </div>
    </div>
  </div>