page SiteSettings

import { IconArrowLeft } from "tylix-icons"

title "Site settings"

needs
  Auth

uses
  Billing

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  notFound: false
  typeLabel: ""
  groups: []
  plugins: []
  openLog: ""
  error: ""
  timer: 0
  selected: ""
  choices: []
  activeCount: 0
  nginxReady: false
  nginxOpen: false
  nginxFile: ""
  nginxLoading: false
  nginxSaving: false
  nginxLoaded: false
  nginxPath: ""
  nginxText: ""
  nginxOriginal: ""
  nginxError: ""
  nginxMessage: ""
  nginxLineNums: "1"
  nginxLineCount: 1

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  describe(site) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["react", "React"],
      ["static", "Static"]
    ]

    const typeHit = labels.find((l) => l[0] is site.type)
    const typeLabel = typeHit ? typeHit[1] : site.type

    const row = (label, value, mono) => ({ label: label, value: (value or "") + "", mono: mono })
    const keep = (rows) => rows.filter((r) => r.value is not "")

    const sslLabel = site.ssl_mode is "letsencrypt" ? "Let's Encrypt" : (site.ssl_mode is "custom" ? "Custom certificate" : "None")
    const deps = site.repository ? (site.install_deps ? "Yes" : "No") : ""
    const aliases = Array.isArray(site.aliases) ? site.aliases.join(", ") : ""

    this.site = site
    this.serverId = "" + site.server_id
    this.typeLabel = typeLabel
    this.nginxReady = site.status is "ready"
    this.nginxFile = "/etc/nginx/sites-available/" + site.domain + ".conf"

    this.groups = [
      {
        title: "General",
        rows: keep([
          row("Type", typeLabel, false),
          row("Status", site.status, false),
          row("Domain", site.domain, true),
          row("Aliases", aliases, true),
          row("Isolated user", site.isolated_user, true),
          row("Site folder", "/home/" + site.isolated_user + "/" + site.domain, true),
          row("PHP version", site.php_version, true),
          row("App port", site.port, true),
          row("Created", (site.created_at or "").slice(0, 10), false),
          row("Last updated", (site.updated_at or "").slice(0, 10), false)
        ])
      },
      {
        title: "Source",
        rows: keep([
          row("Repository", site.repository, true),
          row("Branch", site.branch, true),
          row("Install dependencies", deps, false)
        ])
      },
      {
        title: "Directories and commands",
        rows: keep([
          row("Web directory", site.web_directory, true),
          row("App folder", site.app_directory, true),
          row("API folder", site.backend_directory, true),
          row("Build command", site.build_command, true),
          row("Start command", site.start_command, true)
        ])
      },
      {
        title: "Deployment",
        rows: keep([
          row("Deploy status", site.deploy_status, false),
          row("Last deployed", (site.deployed_at or "").slice(0, 19).replace("T", " "), false)
        ])
      },
      {
        title: "HTTPS",
        rows: keep([
          row("Method", sslLabel, false),
          row("Status", site.ssl_status, false),
          row("Expires", (site.ssl_expires_at or "").slice(0, 10), false)
        ])
      }
    ].filter((g) => g.rows.length > 0)
  }

  decorate(list) {
    return list.map((p) => Object.assign({}, p, {
      busy: p.status is "installing" or p.status is "removing",
      isInstalled: p.status is "installed",
      isFailed: p.status is "failed" or p.status is "remove_failed",
      isAvailable: p.status is "available",
      shown: p.status is not "available",
      label: p.group + " · " + p.name + (p.blocked ? " (unavailable)" : ""),
      portText: p.port ? "" + p.port : ""
    }))
  }

  async loadPlugins() {
    const result = await useApi("/api/sites/" + this.siteId + "/plugins")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and Array.isArray(result.data) {
      this.plugins = this.decorate(result.data)
      this.choices = this.plugins.filter((p) => p.isAvailable)
      this.activeCount = this.plugins.filter((p) => p.shown).length

      const anyBusy = this.plugins.some((p) => p.busy)
      if anyBusy {
        if not this.timer {
          this.timer = window.setInterval(() => this.loadPlugins(), 3000)
        }
      } else {
        window.clearInterval(this.timer)
        this.timer = 0
      }
    }
  }

  toggleLog(id) {
    if this.openLog is id {
      this.openLog = ""
    } else {
      this.openLog = id
    }
  }

  async install(id) {
    if Billing.locked {
      return null
    }
    this.error = ""

    if not id {
      this.error = "Choose a plugin first."
      return null
    }

    const picked = this.plugins.find((p) => p.id is id)
    if picked and picked.isAvailable and picked.blocked {
      this.error = picked.blocked
      return null
    }

    const result = await useApi("/api/sites/" + this.siteId + "/plugins", { method: "POST", body: { plugin: id } })

    if result.ok {
      this.openLog = id
      this.selected = ""
      await this.loadPlugins()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't install that plugin."
    }
  }

  async remove(id) {
    if Billing.locked {
      return null
    }
    if not window.confirm("Remove this plugin from the site? Its service and nginx settings will be taken off the server.") {
      return null
    }

    this.error = ""
    const result = await useApi("/api/sites/" + this.siteId + "/plugins/" + id, { method: "DELETE" })

    if result.ok {
      this.openLog = id
      await this.loadPlugins()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.error = result.data?.error or "Couldn't remove that plugin."
    }
  }

  refreshLines() {
    const nl = String.fromCharCode(10)
    const count = this.nginxText.split(nl).length
    this.nginxLineCount = count
    this.nginxLineNums = Array.from({ length: count }, (_, i) => i + 1).join(nl)
  }

  focusEditor() {
    const el = document.getElementById("nginx-editor")
    if el {
      el.focus()
    }
  }

  async loadNginx() {
    this.nginxLoading = true
    this.nginxError = ""
    this.nginxMessage = ""

    const result = await useApi("/api/sites/" + this.siteId + "/nginx")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.nginxPath = result.data.path
      this.nginxText = result.data.content
      this.nginxOriginal = result.data.content
      this.nginxLoaded = true
      this.refreshLines()
    } else {
      this.nginxError = result.data?.error or "Couldn't load the nginx config."
    }

    this.nginxLoading = false
  }

  async reloadNginx() {
    if this.nginxText is not this.nginxOriginal {
      if not window.confirm("Reloading replaces your unsaved changes with the version on the server. Continue?") {
        return null
      }
    }

    await this.loadNginx()
    window.setTimeout(() => this.focusEditor(), 80)
  }

  async openNginx() {
    this.nginxOpen = true
    document.body.style.overflow = "hidden"

    if not this.nginxLoaded {
      await this.loadNginx()
    }

    window.setTimeout(() => this.focusEditor(), 120)
  }

  closeNginx() {
    if not this.nginxOpen {
      return null
    }

    if this.nginxText is not this.nginxOriginal {
      if not window.confirm("Discard your unsaved nginx changes?") {
        return null
      }
      this.nginxText = this.nginxOriginal
      this.refreshLines()
    }

    this.nginxOpen = false
    this.nginxError = ""
    this.nginxMessage = ""
    document.body.style.overflow = ""
  }

  async saveNginx() {
    if Billing.locked {
      return null
    }
    if this.nginxSaving or this.nginxLoading {
      return null
    }

    this.nginxSaving = true
    this.nginxError = ""
    this.nginxMessage = ""

    const result = await useApi("/api/sites/" + this.siteId + "/nginx", { method: "PUT", body: { content: this.nginxText } })

    if result.ok {
      this.nginxText = result.data.content
      this.nginxOriginal = result.data.content
      this.nginxMessage = "Saved. nginx accepted the config and was reloaded."
      this.refreshLines()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.nginxError = result.data?.error or "Couldn't save the nginx config."
    }

    this.nginxSaving = false
  }

  discardNginx() {
    this.nginxText = this.nginxOriginal
    this.nginxError = ""
    this.nginxMessage = ""
    this.refreshLines()
    this.focusEditor()
  }

  onNginxKey(e) {
    if not this.nginxOpen {
      return null
    }

    if e.key is "Escape" {
      this.closeNginx()
      return null
    }

    const modifier = e.ctrlKey or e.metaKey
    const pressed = e.key.toLowerCase()

    if modifier and pressed is "s" {
      e.preventDefault()
      this.saveNginx()
      return null
    }

    const inEditor = e.target and e.target.id is "nginx-editor"

    if e.key is "Tab" and inEditor and not e.shiftKey {
      e.preventDefault()
      const ta = e.target
      const start = ta.selectionStart
      const end = ta.selectionEnd
      const pad = "    "
      ta.value = ta.value.slice(0, start) + pad + ta.value.slice(end)
      ta.selectionStart = start + pad.length
      ta.selectionEnd = start + pad.length
      this.nginxText = ta.value
      this.refreshLines()
    }
  }

  onNginxInput(e) {
    if e.target and e.target.id is "nginx-editor" {
      this.nginxText = e.target.value
      this.refreshLines()
    }
  }

  onNginxScroll(e) {
    if e.target and e.target.id is "nginx-editor" {
      const gutter = document.getElementById("nginx-gutter")
      if gutter {
        gutter.scrollTop = e.target.scrollTop
      }
    }
  }

onMount
  async {
    document.body.style.overflow = ""

    const old = this.global("tylixNginxHandlers")
    if old {
      document.removeEventListener("keydown", old.key)
      document.removeEventListener("input", old.input)
      document.removeEventListener("scroll", old.scroll, true)
    }

    const keyHandler = (e) => this.onNginxKey(e)
    const inputHandler = (e) => this.onNginxInput(e)
    const scrollHandler = (e) => this.onNginxScroll(e)
    document.addEventListener("keydown", keyHandler)
    document.addEventListener("input", inputHandler)
    document.addEventListener("scroll", scrollHandler, true)
    this.setGlobal("tylixNginxHandlers", { key: keyHandler, input: inputHandler, scroll: scrollHandler })

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    if not id {
      this.notFound = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false
        await this.loadPlugins()
      } else {
        this.notFound = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[260px_auto_1fr] bg-slate-200 dark:bg-slate-950 transition-colors">
    <Sidebar active="servers" />
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1600px] mx-auto px-6 lg:px-10 py-10">

{{#if loading}}
      <p class="text-slate-500 text-sm">Loading…</p>
{{/if}}

{{#if notFound}}
      <div class="max-w-2xl mx-auto rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-8 text-center">
        <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-2">Site not found</h2>
        <p class="text-slate-500 text-sm mb-6">It may have been removed, or the link is wrong.</p>
        <a href="/servers" class="text-emerald-700 dark:text-emerald-500 text-sm hover:underline">&larr; Back to servers</a>
      </div>
{{/if}}

{{#if site}}
      <a href="{{ '/servers/server-sites?id=' + serverId }}" class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-500 text-sm hover:underline font-medium mb-6">
        <IconArrowLeft class="w-4 h-4" /> Sites
      </a>

      <LockedBanner />

      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-200 truncate mb-2">{{ site.domain }}</h1>
        <p class="text-slate-500 text-sm">Settings</p>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <SiteSidebar active="settings" siteId="{{ siteId }}" />

        <div class="min-w-0 flex-1">

          <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-6">
{{#each group in groups}}
            <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
              <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-5">{{ group.title }}</h2>
              <div class="grid grid-cols-2 gap-5">
{{#each row in group.rows}}
                <div class="min-w-0">
                  <p class="text-slate-500 text-xs mb-1">{{ row.label }}</p>
{{#if row.mono}}
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-mono break-all">{{ row.value }}</p>
{{/if}}
{{#if not row.mono}}
                  <p class="text-slate-800 dark:text-slate-200 text-sm break-words">{{ row.value }}</p>
{{/if}}
                </div>
{{/each}}
              </div>
            </div>
{{/each}}
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none mb-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">nginx configuration</h2>
                <p class="text-slate-500 text-sm">This site's nginx config. It opens in a full-size editor so it isn't changed by accident.</p>
              </div>
{{#if nginxReady}}
              <button onclick="{{ openNginx() }}" class="shrink-0 inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2 hover:border-emerald-500/60 hover:bg-slate-300/50 dark:hover:bg-slate-800 transition-colors">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-3.5 h-3.5">
                  <path d="M3 8V3h5M17 12v5h-5M3 3l5 5M17 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Edit
              </button>
{{/if}}
            </div>

{{#if not nginxReady}}
            <p class="text-slate-500 text-sm mt-5">The config can be edited once the site has finished creating.</p>
{{/if}}

{{#if nginxReady}}
            <p class="text-slate-500 text-xs font-mono mt-5 break-all">{{ nginxFile }}</p>
            <p class="text-slate-500 text-xs mt-2">Just need to send an old address somewhere else? Use <a href="{{ '/servers/site-redirects?id=' + siteId }}" class="text-emerald-700 dark:text-emerald-500 hover:underline">Redirects</a> instead of editing the config.</p>
{{/if}}
          </div>

          <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-6 shadow-sm dark:shadow-none">
            <h2 class="text-slate-800 dark:text-slate-200 font-medium mb-1">Plugins</h2>
            <p class="text-slate-500 text-sm mb-5">Extras you can add to this {{ typeLabel }} site. Each one installs over SSH, and you can remove it again.</p>

            <div class="flex flex-wrap items-center gap-3 mb-6">
{{#if choices.length is 0}}
              <p class="text-slate-500 text-sm">Every plugin for this site type has been added.</p>
{{/if}}
{{#if choices.length is not 0}}
              <select
                value="{{ selected }}"
                onchange="{{ selected = $event.target.value }}"
                class="min-w-0 flex-1 sm:flex-none sm:w-80 rounded-lg border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500/40"
              >
                <option value="">Add a plugin…</option>
{{#each c in choices}}
                <option value="{{ c.id }}">{{ c.label }}</option>
{{/each}}
              </select>
{{#if Billing.locked}}
              <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-5 py-2 cursor-not-allowed select-none">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                  <rect x="4" y="9" width="12" height="8" rx="2" />
                  <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                </svg>
                Install
              </button>
{{/if}}
{{#if not Billing.locked}}
              <button onclick="{{ install(selected) }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-5 py-2 shadow-sm hover:bg-emerald-400 transition-all">Install</button>
{{/if}}
{{/if}}
            </div>

{{#if error}}
            <p role="alert" class="text-rose-500 text-sm mb-4">{{ error }}</p>
{{/if}}

{{#if activeCount is 0}}
            <p class="text-slate-500 text-sm">Nothing added yet.</p>
{{/if}}

{{#each p in plugins}}
{{#if p.shown}}
            <div class="rounded-xl border border-slate-300 dark:border-slate-800 bg-slate-100 dark:bg-slate-950/40 p-5 mb-3">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <h3 class="text-slate-800 dark:text-slate-200 text-sm font-semibold">{{ p.name }}</h3>
                    <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">{{ p.group }}</span>
{{#if p.isInstalled}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Installed
                    </span>
{{/if}}
{{#if p.busy}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Working
                    </span>
{{/if}}
{{#if p.isFailed}}
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
                    </span>
{{/if}}
                  </div>
                  <p class="text-slate-500 text-sm">{{ p.description }}</p>
{{#if p.portText}}
                  <p class="text-slate-500 text-xs mt-1">Local port <span class="font-mono">{{ p.portText }}</span></p>
{{/if}}
                </div>

                <div class="shrink-0 flex items-center gap-2">
                  <button onclick="{{ toggleLog(p.id) }}" class="text-xs text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-full px-3 py-1.5 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">Details</button>
{{#if p.isInstalled}}
{{#if Billing.locked}}
                  <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                      <rect x="4" y="9" width="12" height="8" rx="2" />
                      <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                    </svg>
                    Remove
                  </button>
{{/if}}
{{#if not Billing.locked}}
                  <button onclick="{{ remove(p.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-1.5 hover:bg-rose-500/5 transition-colors">Remove</button>
{{/if}}
{{/if}}
{{#if p.isFailed}}
{{#if Billing.locked}}
                  <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                      <rect x="4" y="9" width="12" height="8" rx="2" />
                      <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                    </svg>
                    Retry
                  </button>
{{/if}}
{{#if not Billing.locked}}
                  <button onclick="{{ install(p.id) }}" class="text-sm bg-emerald-500 text-white dark:text-slate-950 font-semibold rounded-full px-4 py-1.5 shadow-sm hover:bg-emerald-400 transition-all">Retry</button>
{{/if}}
{{#if Billing.locked}}
                  <button disabled title="Pay to continue" class="inline-flex items-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-slate-300 dark:border-slate-700 rounded-full px-4 py-1.5 cursor-not-allowed select-none">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="w-4 h-4">
                      <rect x="4" y="9" width="12" height="8" rx="2" />
                      <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round" />
                    </svg>
                    Remove
                  </button>
{{/if}}
{{#if not Billing.locked}}
                  <button onclick="{{ remove(p.id) }}" class="text-sm text-rose-600 dark:text-rose-500 border border-rose-500/30 rounded-full px-4 py-1.5 hover:bg-rose-500/5 transition-colors">Remove</button>
{{/if}}
{{/if}}
                </div>
              </div>

{{#if p.error}}
              <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ p.error }}</p>
{{/if}}

{{#if openLog is p.id}}
{{#each n in p.notes}}
              <p class="text-slate-500 text-xs mt-3">&bull; {{ n }}</p>
{{/each}}
{{#if p.log}}
              <div class="mt-4 max-h-80 overflow-y-auto rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 p-4 text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-words">{{ p.log }}</div>
{{/if}}
{{/if}}
            </div>
{{/if}}
{{/each}}
          </div>

        </div>
      </div>

{{#if nginxReady}}
{{#if nginxOpen}}
      <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-8">
        <div onclick="{{ closeNginx() }}" class="absolute inset-0 bg-slate-950/60 backdrop-blur-md"></div>

        <div class="relative flex flex-col w-full max-w-[1100px] h-full max-h-[92vh] rounded-2xl border border-slate-700/60 bg-slate-950/90 backdrop-blur-xl overflow-hidden shadow-2xl">

          <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5 border-b border-slate-800 bg-slate-900/80">
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-800 bg-slate-950 text-emerald-400">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4.5 h-4.5">
                  <path d="M6 3h6l4 4v10H6V3zM12 3v4h4M8.5 11h5M8.5 14h3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-slate-200 text-sm font-medium truncate">nginx configuration</p>
                <p class="text-slate-500 text-xs font-mono truncate">{{ nginxFile }}</p>
              </div>
{{#if nginxText is not nginxOriginal}}
              <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-medium px-2.5 py-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Unsaved changes
              </span>
{{/if}}
{{#if nginxText is nginxOriginal}}
{{#if nginxLoaded}}
              <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-medium px-2.5 py-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> In sync with server
              </span>
{{/if}}
{{/if}}
            </div>

            <div class="flex items-center gap-2">
              <button onclick="{{ reloadNginx() }}" class="text-xs text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700 rounded-full px-3 py-1.5 transition-colors">Reload from server</button>
              <button onclick="{{ closeNginx() }}" title="Close (Esc)" aria-label="Close the nginx editor" class="flex items-center gap-1.5 text-xs text-slate-300 hover:text-white border border-slate-700 hover:border-emerald-500/60 rounded-full px-3 py-1.5 transition-colors">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-3.5 h-3.5">
                  <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Close
                <span class="hidden sm:inline font-mono text-[10px] text-slate-500 border border-slate-700 rounded px-1">Esc</span>
              </button>
            </div>
          </div>

{{#if nginxError}}
          <div role="alert" class="mx-5 mt-4 rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 max-h-44 overflow-y-auto">
            <p class="text-rose-400 text-xs font-medium uppercase tracking-wider mb-1">Not saved</p>
            <p class="text-rose-400 text-xs font-mono whitespace-pre-wrap break-words">{{ nginxError }}</p>
          </div>
{{/if}}

{{#if nginxMessage}}
          <div role="status" class="mx-5 mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5 px-4 py-3">
            <p class="text-emerald-400 text-sm">{{ nginxMessage }}</p>
          </div>
{{/if}}

{{#if nginxLoading}}
          <div class="flex-1 flex items-center justify-center">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
              <p class="text-slate-300 text-sm">Loading the config…</p>
            </div>
          </div>
{{/if}}

{{#if nginxLoaded}}
{{#if not nginxLoading}}
          <div class="flex-1 min-h-0 flex flex-col px-5 pt-4 pb-4">
            <div class="flex-1 min-h-0 flex rounded-xl border border-slate-800 bg-slate-950 overflow-hidden focus-within:border-emerald-500/50 transition-colors">
              <div
                id="nginx-gutter"
                aria-hidden="true"
                class="shrink-0 w-14 overflow-hidden select-none text-right pr-3 pl-2 pt-3 pb-10 bg-slate-900/60 border-r border-slate-800 text-slate-600 text-[13px] leading-6 font-mono whitespace-pre"
              >{{ nginxLineNums }}</div>
              <textarea
                id="nginx-editor"
                value="{{ nginxText }}"
                spellcheck="false"
                autocapitalize="off"
                autocomplete="off"
                wrap="off"
                aria-label="nginx configuration"
                class="flex-1 min-w-0 h-full resize-none bg-transparent text-slate-200 text-[13px] leading-6 font-mono pl-4 pr-4 pt-3 pb-10 overflow-auto whitespace-pre focus:outline-none"
              ></textarea>
            </div>

            <p class="text-slate-500 text-xs mt-3 leading-relaxed">Keep the <span class="font-mono text-slate-400">include</span> line in place. Plugins and redirects keep their settings in separate files that this config pulls in, and they stop working without it. Certificates added by HTTPS also live here, and recreating the site or changing its HTTPS settings can rewrite this file.</p>
          </div>
{{/if}}
{{/if}}

          <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-t border-slate-800 bg-slate-900/80">
            <p class="text-slate-500 text-xs">
              <span class="font-mono text-slate-300">{{ nginxLineCount }}</span> lines
              <span class="mx-1.5 text-slate-700">&bull;</span>
              Ctrl+S to test and save
              <span class="mx-1.5 text-slate-700">&bull;</span>
              Tested with <span class="font-mono text-slate-400">nginx -t</span> first, and restored if the test fails
            </p>

            <div class="flex items-center gap-2">
{{#if nginxText is not nginxOriginal}}
              <button onclick="{{ discardNginx() }}" class="text-sm text-slate-300 border border-slate-700 rounded-full px-4 py-2 hover:bg-slate-800 transition-colors">Discard changes</button>
{{/if}}
              <button onclick="{{ saveNginx() }}" class="text-sm bg-emerald-500 text-slate-950 font-semibold rounded-full px-6 py-2 shadow-sm hover:bg-emerald-400 transition-all">
                {{#if nginxSaving}}Testing and saving…{{/if}}{{#if not nginxSaving}}Test and save{{/if}}
              </button>
            </div>
          </div>

        </div>
      </div>
{{/if}}
{{/if}}
{{/if}}

    </div>
    </div>
  </div>