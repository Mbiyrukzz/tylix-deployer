page SiteSettings

import { IconExternalLink, IconAdjustments, IconGitBranch, IconFileCode, IconPuzzlePiece, IconCopy, IconCheck, IconPencilSquare, IconLockClosed, IconPlus } from "tylix-icons"

title "Site settings"

needs
  Auth

uses
  Billing
  Syntax

background
  Billing

state
  siteId: ""
  serverId: ""
  site: null
  loading: true
  isMissing: false
  typeLabel: ""
  groups: []
  plugins: []
  openLog: ""
  error: ""
  timer: 0
  selected: ""
  picked: null
  choices: []
  activeCount: 0
  installerOpen: false
  installerFilter: ""
  installerGroups: []
  installerCount: 0
  installerError: ""
  installBusy: false
  lastError: ""
  codeOpen: false
  codeValue: ""
  codeError: ""
  codeTitle: ""
  codeBusy: false
  pending: null
  nginxReady: false
  nginxOpen: false
  nginxFile: ""
  nginxLoading: false
  nginxSaving: false
  nginxLoaded: false
  nginxPath: ""
  nginxText: ""
  nginxOriginal: ""
  nginxError: ""
  nginxMessage: ""
  nginxLineNums: "1"
  nginxLineCount: 1
  repoMessage: ""
  tiles: []
  showRepo: false
  copied: ""
  copyTimer: 0

action
  global(name) {
    return Reflect.get(window, name)
  }

  setGlobal(name, value) {
    Reflect.set(window, name, value)
  }

  describe(site) {
    const labels = [
      ["tylix", "Tylix"],
      ["laravel", "Laravel"],
      ["php", "PHP"],
      ["nodejs", "Node.js"],
      ["nextjs", "Next.js"],
      ["nuxt", "Nuxt"],
      ["vue", "Vue"],
      ["fastapi", "FastAPI"],
      ["django", "Django"],
      ["java", "Java API"],
      ["go", "Go"],
      ["ruby", "Ruby"],
      ["dotnet", ".NET"],
      ["rust", "Rust"],
      ["wordpress", "WordPress"],
      ["mern", "MERN"],
      ["angular", "Angular"],
      ["react", "React"],
      ["static", "Static"]
    ]

    const typeHit = labels.find((l) => l[0] is site.type)
    const typeLabel = typeHit ? typeHit[1] : site.type

    const row = (label, value, mono) => ({ key: label, label: label, value: (value or "") + "", mono: mono })
    const keep = (rows) => rows.filter((r) => r.value is not "")
    const cap = (s) => s ? String(s).charAt(0).toUpperCase() + String(s).slice(1).replace(/_/g, " ") : ""

    const sslLabel = site.ssl_mode is "letsencrypt" ? "Let's Encrypt" : (site.ssl_mode is "custom" ? "Custom certificate" : "Off")
    const deps = site.repository ? (site.install_deps ? "Yes" : "No") : ""
    const aliases = Array.isArray(site.aliases) ? site.aliases.join(", ") : ""
    const runtimeSub = site.php_version ? "PHP " + site.php_version : (site.port ? "Port " + site.port : "")
    const expires = site.ssl_expires_at ? "Expires " + this.shortDate(site.ssl_expires_at) : ""
    const httpsSub = [cap(site.ssl_status), expires].filter((s) => s).join(" · ")

    this.site = site
    this.serverId = "" + site.server_id
    this.typeLabel = typeLabel
    this.nginxReady = site.status is "ready"
    this.nginxFile = "/etc/nginx/sites-available/" + site.domain + ".conf"
    this.showRepo = site.status is "ready" and site.type is not "wordpress"

    this.tiles = [
      { label: "Runtime", value: typeLabel, sub: runtimeSub, title: "" },
      { label: "HTTPS", value: sslLabel, sub: httpsSub, title: site.ssl_expires_at or "" },
      { label: "Last deploy", value: site.deployed_at ? this.ago(site.deployed_at) : "Never", sub: cap(site.deploy_status), title: site.deployed_at or "" },
      { label: "Created", value: this.shortDate(site.created_at), sub: site.updated_at ? "Updated " + this.ago(site.updated_at) : "", title: site.created_at or "" }
    ]

    this.groups = [
      {
        title: "General",
        rows: keep([
          row("Domain", site.domain, true),
          row("Aliases", aliases, true),
          row("Isolated user", site.isolated_user, true),
          row("Site folder", "/home/" + site.isolated_user + "/" + site.domain, true),
          row("PHP version", site.php_version, true),
          row("App port", site.port, true)
        ])
      },
      {
        title: "Build and run",
        rows: keep([
          row("Web directory", site.web_directory, true),
          row("App folder", site.app_directory, true),
          row("API folder", site.backend_directory, true),
          row("Build command", site.build_command, true),
          row("Start command", site.start_command, true),
          row("Install dependencies", deps, false)
        ])
      }
    ].filter((g) => g.rows.length > 0)
  }

  stamp(iso) {
    if not iso {
      return NaN
    }
    const text = String(iso)
    const zoned = text.includes("T") ? text : text.replace(" ", "T") + "Z"
    return Date.parse(zoned)
  }

  shortDate(iso) {
    const t = this.stamp(iso)
    if Number.isNaN(t) {
      return iso ? String(iso).slice(0, 10) : ""
    }
    return new Date(t).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })
  }

  ago(iso) {
    const t = this.stamp(iso)
    if Number.isNaN(t) {
      return iso ? String(iso).slice(0, 10) : ""
    }
    const secs = Math.round((Date.now() - t) / 1000)
    if secs < 60 {
      return "Just now"
    }
    const mins = Math.round(secs / 60)
    if mins < 60 {
      return mins + " min ago"
    }
    const hours = Math.round(mins / 60)
    if hours < 24 {
      return hours + (hours is 1 ? " hour ago" : " hours ago")
    }
    const days = Math.round(hours / 24)
    if days < 30 {
      return days + (days is 1 ? " day ago" : " days ago")
    }
    return this.shortDate(iso)
  }

  async copy(text, key) {
    try {
      await navigator.clipboard.writeText(text)
    } catch (err) {
      return null
    }
    this.copied = key
    window.clearTimeout(this.copyTimer)
    this.copyTimer = window.setTimeout(() => {
      this.copied = ""
    }, 1600)
  }

  // SiteRepository changed (or removed) the repository: refresh the details.
  // Updated in place: a new site object would remount SiteRepository and lose its message.
  sourceChanged(data) {
    this.repoMessage = data.notice or ""
    const site = this.site
    site.source_control_id = data.source_control_id
    site.repository = data.repository
    site.branch = data.branch
    this.describe(site)
  }

  tileFor(group) {
    const base = "w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-bold "
    const tones = [
      ["Laravel", "bg-rose-500/10 text-rose-600 dark:text-rose-400"],
      ["Tylix", "bg-brand-500/10 text-brand-700 dark:text-brand-500"],
      ["Web server", "bg-sky-500/10 text-sky-600 dark:text-sky-400"],
      ["App services", "bg-amber-500/10 text-amber-600 dark:text-amber-400"],
      ["Next.js", "bg-violet-500/10 text-violet-600 dark:text-violet-400"],
      ["Nuxt", "bg-brand-500/10 text-brand-700 dark:text-brand-500"]
    ]
    const hit = tones.find((t) => t[0] is group)
    return base + (hit ? hit[1] : "bg-slate-500/10 text-slate-600 dark:text-slate-400")
  }

  decorate(list) {
    return list.map((p) => Object.assign({}, p, {
      busy: p.status is "installing" or p.status is "removing",
      isInstalled: p.status is "installed",
      isFailed: p.status is "failed" or p.status is "remove_failed",
      canAct: p.status is "installed" or p.status is "failed" or p.status is "remove_failed",
      isAvailable: p.status is "available",
      shown: p.status is not "available",
      letter: String(p.name).charAt(0).toUpperCase(),
      tile: this.tileFor(p.group),
      portText: p.port ? "" + p.port : ""
    }))
  }

  refreshInstaller() {
    const needle = this.installerFilter.trim().toLowerCase()
    const list = this.choices.filter((p) => needle is "" or (p.name + " " + p.group + " " + p.description).toLowerCase().includes(needle))

    const buckets = new Map()
    list.forEach((p) => {
      if not buckets.has(p.group) {
        buckets.set(p.group, [])
      }
      buckets.get(p.group).push(p)
    })

    this.installerGroups = Array.from(buckets.entries()).map((e) => ({ title: e[0], items: e[1] }))
    this.installerCount = list.length
    this.picked = this.selected ? (this.plugins.find((p) => p.id is this.selected) or null) : null
  }

  async loadPlugins() {
    const result = await useApi("/api/sites/" + this.siteId + "/plugins")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok and Array.isArray(result.data) {
      this.plugins = this.decorate(result.data)
      this.choices = this.plugins.filter((p) => p.isAvailable)
      this.activeCount = this.plugins.filter((p) => p.shown).length
      this.refreshInstaller()

      const anyBusy = this.plugins.some((p) => p.busy)
      if anyBusy {
        if not this.timer {
          this.timer = window.setInterval(() => this.loadPlugins(), 3000)
        }
      } else {
        window.clearInterval(this.timer)
        this.timer = 0
      }
    }
  }

  toggleLog(id) {
    if this.openLog is id {
      this.openLog = ""
    } else {
      this.openLog = id
    }
  }

  openInstaller() {
    if Billing.locked {
      return null
    }
    this.installerFilter = ""
    this.installerError = ""
    this.selected = ""
    this.refreshInstaller()
    this.installerOpen = true
    document.body.style.overflow = "hidden"

    window.setTimeout(() => {
      const el = document.getElementById("installer-filter")
      if el and window.innerWidth >= 640 {
        el.focus()
      }
    }, 120)
  }

   closeInstaller() {
    if this.installBusy {
      return null
    }
    this.installerOpen = false
    this.installerError = ""
    document.body.style.overflow = ""
    this.selected = ""
    this.picked = null
  }

  applyInstallerFilter(value) {
    this.installerFilter = value
    this.refreshInstaller()
  }

  pickPlugin(id) {
    this.selected = id
    this.installerError = ""
    this.picked = this.plugins.find((p) => p.id is id) or null
  }

  needsCode(result) {
    if result.status is not 403 {
      return false
    }

    const d = result.data or {}
    const text = ("" + (d.error or "") + " " + (d.code or "")).toLowerCase()
    return d.two_factor_required is true or d.code is "two_factor_required" or text.includes("two_factor") or text.includes("two-factor")
  }

  askCode(kind, id, title) {
    this.pending = { kind: kind, id: id }
    this.codeTitle = title
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
    this.codeOpen = true
    window.setTimeout(() => {
      const el = document.getElementById("step-up-code")
      if el {
        el.focus()
      }
    }, 80)
  }

  closeCode() {
    this.codeOpen = false
    this.pending = null
    this.codeValue = ""
    this.codeError = ""
    this.codeBusy = false
  }

  async submitCode() {
    if this.codeBusy or not this.pending {
      return null
    }

    const code = this.codeValue.trim()
    if code is "" {
      this.codeError = "Enter your code."
      return null
    }

    this.codeBusy = true
    this.codeError = ""
    const p = this.pending
    let outcome = "failed"

    if p.kind is "install" {
      outcome = await this.runInstall(p.id, code)
    } else if p.kind is "remove" {
      outcome = await this.runRemove(p.id, code)
    } else if p.kind is "nginx" {
      outcome = await this.runSaveNginx(code)
    }

    if outcome is "done" {
      this.closeCode()
      return null
    }

    this.codeError = this.lastError or "That code didn't work. Try again."
    this.codeValue = ""
    this.codeBusy = false
  }

  async runInstall(id, code) {
    const body = code ? { plugin: id, code: code } : { plugin: id }
    const result = await useApi("/api/sites/" + this.siteId + "/plugins", { method: "POST", body: body })

      if result.ok {
      this.openLog = id
      this.installerOpen = false
      this.installerError = ""
      document.body.style.overflow = ""
      this.selected = ""
      this.picked = null
      await this.loadPlugins()
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't install that plugin."
    return this.needsCode(result) ? "code" : "failed"
  }

  async runRemove(id, code) {
    const query = code ? "?code=" + encodeURIComponent(code) : ""
    const result = await useApi("/api/sites/" + this.siteId + "/plugins/" + id + query, { method: "DELETE" })

    if result.ok {
      this.openLog = id
      await this.loadPlugins()
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't remove that plugin."
    return this.needsCode(result) ? "code" : "failed"
  }

  async installPicked() {
    if Billing.locked or this.installBusy {
      return null
    }

    this.installerError = ""

    if not this.picked {
      this.installerError = "Choose a plugin first."
      return null
    }

    if this.picked.blocked {
      this.installerError = this.picked.blocked
      return null
    }

    const id = this.picked.id
    this.installBusy = true
    const outcome = await this.runInstall(id, "")

    if outcome is "code" {
      this.askCode("install", id, "Confirm to install this plugin")
    } else if outcome is "failed" {
      this.installerError = this.lastError
    }

    this.installBusy = false
  }

  async retry(id, status) {
    if Billing.locked {
      return null
    }

    this.error = ""
    const removing = status is "remove_failed"
    let outcome = "failed"

    if removing {
      outcome = await this.runRemove(id, "")
    } else {
      outcome = await this.runInstall(id, "")
    }

    if outcome is "code" {
      this.askCode(removing ? "remove" : "install", id, removing ? "Confirm to remove this plugin" : "Confirm to install this plugin")
    } else if outcome is "failed" {
      this.error = this.lastError
    }
  }

  async remove(id) {
    if Billing.locked {
      return null
    }
    if not window.confirm("Remove this plugin from the site? Its service and nginx settings will be taken off the server.") {
      return null
    }

    this.error = ""
    const outcome = await this.runRemove(id, "")

    if outcome is "code" {
      this.askCode("remove", id, "Confirm to remove this plugin")
    } else if outcome is "failed" {
      this.error = this.lastError
    }
  }

  refreshLines() {
    const nl = String.fromCharCode(10)
    const count = this.nginxText.split(nl).length
    this.nginxLineCount = count
    this.nginxLineNums = Array.from({ length: count }, (_, i) => i + 1).join(nl)
  }

  focusEditor() {
    const el = document.getElementById("nginx-editor")
    if el {
      el.focus()
    }
  }

  async loadNginx() {
    this.nginxLoading = true
    this.nginxError = ""
    this.nginxMessage = ""

    const result = await useApi("/api/sites/" + this.siteId + "/nginx")

    if result.status is 401 {
      window.location.href = "/login"
      return null
    }

    if result.ok {
      this.nginxPath = result.data.path
      this.nginxText = result.data.content
      this.nginxOriginal = result.data.content
      this.nginxLoaded = true
      this.refreshLines()
    } else {
      this.nginxError = result.data?.error or "Couldn't load the nginx config."
    }

    this.nginxLoading = false
  }

  async reloadNginx() {
    if this.nginxText is not this.nginxOriginal {
      if not window.confirm("Reloading replaces your unsaved changes with the version on the server. Continue?") {
        return null
      }
    }

    await this.loadNginx()
    window.setTimeout(() => this.focusEditor(), 80)
  }

  async openNginx() {
    this.nginxOpen = true
    document.body.style.overflow = "hidden"

    if not this.nginxLoaded {
      await this.loadNginx()
    }

    window.setTimeout(() => this.focusEditor(), 120)
  }

  closeNginx() {
    if not this.nginxOpen {
      return null
    }

    if this.nginxText is not this.nginxOriginal {
      if not window.confirm("Discard your unsaved nginx changes?") {
        return null
      }
      this.nginxText = this.nginxOriginal
      this.refreshLines()
    }

    this.nginxOpen = false
    this.nginxError = ""
    this.nginxMessage = ""
    document.body.style.overflow = ""
  }

  async runSaveNginx(code) {
    const body = code ? { content: this.nginxText, code: code } : { content: this.nginxText }
    const result = await useApi("/api/sites/" + this.siteId + "/nginx", { method: "PUT", body: body })

    if result.ok {
      this.nginxText = result.data.content
      this.nginxOriginal = result.data.content
      this.nginxMessage = "Saved. nginx accepted the config and was reloaded."
      this.refreshLines()
      return "done"
    }

    if result.status is 401 {
      window.location.href = "/login"
      return "done"
    }

    this.lastError = result.data?.error or "Couldn't save the nginx config."
    return this.needsCode(result) ? "code" : "failed"
  }

  async saveNginx() {
    if Billing.locked {
      return null
    }
    if this.nginxSaving or this.nginxLoading {
      return null
    }

    this.nginxSaving = true
    this.nginxError = ""
    this.nginxMessage = ""

    const outcome = await this.runSaveNginx("")

    if outcome is "code" {
      this.askCode("nginx", "", "Confirm to save the nginx config")
    } else if outcome is "failed" {
      this.nginxError = this.lastError
    }

    this.nginxSaving = false
  }

  discardNginx() {
    this.nginxText = this.nginxOriginal
    this.nginxError = ""
    this.nginxMessage = ""
    this.refreshLines()
    this.focusEditor()
  }

  onNginxKey(e) {
    if this.codeOpen {
      if e.key is "Escape" {
        this.closeCode()
      } else if e.key is "Enter" {
        e.preventDefault()
        this.submitCode()
      }
      return null
    }

    if this.installerOpen {
      if e.key is "Escape" {
        this.closeInstaller()
      }
      return null
    }

    if not this.nginxOpen {
      return null
    }

    if e.key is "Escape" {
      this.closeNginx()
      return null
    }

    const modifier = e.ctrlKey or e.metaKey
    const pressed = e.key.toLowerCase()

    if modifier and pressed is "s" {
      e.preventDefault()
      this.saveNginx()
      return null
    }

    const inEditor = e.target and e.target.id is "nginx-editor"

    if e.key is "Tab" and inEditor and not e.shiftKey {
      e.preventDefault()
      const ta = e.target
      const start = ta.selectionStart
      const end = ta.selectionEnd
      const pad = "    "
      ta.value = ta.value.slice(0, start) + pad + ta.value.slice(end)
      ta.selectionStart = start + pad.length
      ta.selectionEnd = start + pad.length
      this.nginxText = ta.value
      this.refreshLines()
    }
  }

  onNginxInput(e) {
    if e.target and e.target.id is "nginx-editor" {
      this.nginxText = e.target.value
      this.refreshLines()
    }
  }

  onNginxScroll(e) {
    if e.target and e.target.id is "nginx-editor" {
      const gutter = document.getElementById("nginx-gutter")
      if gutter {
        gutter.scrollTop = e.target.scrollTop
      }
      const colours = document.getElementById("nginx-hl")
      if colours {
        colours.scrollTop = e.target.scrollTop
        colours.scrollLeft = e.target.scrollLeft
      }
    }
  }

onMount
  async {
    document.body.style.overflow = ""

    const old = this.global("tylixNginxHandlers")
    if old {
      document.removeEventListener("keydown", old.key)
      document.removeEventListener("input", old.input)
      document.removeEventListener("scroll", old.scroll, true)
    }

    const keyHandler = (e) => this.onNginxKey(e)
    const inputHandler = (e) => this.onNginxInput(e)
    const scrollHandler = (e) => this.onNginxScroll(e)
    document.addEventListener("keydown", keyHandler)
    document.addEventListener("input", inputHandler)
    document.addEventListener("scroll", scrollHandler, true)
    this.setGlobal("tylixNginxHandlers", { key: keyHandler, input: inputHandler, scroll: scrollHandler })

    const params = new URLSearchParams(window.location.search)
    const id = params.get("id")
    this.siteId = id or ""

    // The site sidebar remembers each site's server, so the server sidebar
    // can render before this page's first request comes back.
    const cached = id ? window.localStorage.getItem("flux-site:" + id) : null
    if cached {
      const saved = JSON.parse(cached)
      if saved and saved.server_id {
        this.serverId = "" + saved.server_id
      }
    }

    if not id {
      this.isMissing = true
      this.loading = false
    } else {
      const result = await useApi("/api/sites/" + id)

      if result.status is 401 {
        window.location.href = "/login"
      } else if result.ok {
        this.describe(result.data)
        this.loading = false
        await this.loadPlugins()
      } else {
        this.isMissing = true
        this.loading = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[auto_auto_minmax(0,1fr)] bg-page transition-colors">
{{#if isMissing}}
    <div></div>
    <div></div>
{{/if}}
{{#if not isMissing}}
{{#if serverId}}
    <ServerSidebar active="sites" serverId="{{ serverId }}" />
{{/if}}
{{#if not serverId}}
    <div aria-hidden="true" class="hidden lg:block lg:w-[240px] lg:h-[calc(100vh-4rem)] lg:sticky lg:top-16 border-r border-line"></div>
{{/if}}
    <SiteSidebar active="settings" siteId="{{ siteId }}" site="{{ site }}" />
{{/if}}
    <div class="min-w-0">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">

{{#if loading}}
      <div data-page-loader="true" class="min-h-[60vh] flex items-center justify-center">
        <LoaderMark label="Loading settings…" />
      </div>
{{/if}}

{{#if isMissing}}
      <NotFoundCard heading="Site not found" body="It may have been removed, or the link is wrong." link="/servers" linkLabel="Back to servers" />
{{/if}}

{{#if site}}
      <SiteHeader title="Settings" description="{{ typeLabel + ' site details, its repository, the nginx config and plugins.' }}" domain="{{ site.domain }}" serverId="{{ serverId }}" siteId="{{ siteId }}">
        <SiteStatus slot="badge" status="{{ site.status }}" />
        <div slot="actions" class="flex flex-wrap items-center gap-2 shrink-0">
          <a href="{{ 'https://' + site.domain }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <IconExternalLink class="w-4 h-4" /> Visit site
          </a>
        </div>
      </SiteHeader>

      <LockedBanner />

      <nav aria-label="On this page" class="lg:sticky lg:top-16 z-20 -mx-4 sm:mx-0 px-4 sm:px-0 py-2.5 mb-4 sm:mb-6 bg-page overflow-x-auto no-scrollbar">
        <div class="inline-flex items-center gap-1 rounded-full border border-line bg-panel p-1 shadow-sm dark:shadow-none">
          <a href="#overview" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconAdjustments class="hidden sm:block w-4 h-4" /> Overview</a>
{{#if showRepo}}
          <a href="#repository" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconGitBranch class="hidden sm:block w-4 h-4" /> Repository</a>
{{/if}}
          <a href="#nginx" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconFileCode class="hidden sm:block w-4 h-4" /> nginx</a>
          <a href="#plugins" class="shrink-0 inline-flex items-center gap-1.5 h-8 rounded-full px-3 sm:px-3.5 text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors"><IconPuzzlePiece class="hidden sm:block w-4 h-4" /> Plugins{{ activeCount ? " · " + activeCount : "" }}</a>
        </div>
      </nav>

      <div class="min-w-0 space-y-6">

        <section id="overview" class="scroll-mt-24 lg:scroll-mt-32 space-y-4 sm:space-y-6">
          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
{{#each t in tiles}}
            <div title="{{ t.title }}" class="min-w-0 rounded-2xl border border-line bg-panel px-4 sm:px-5 py-4 shadow-sm dark:shadow-none">
              <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.12em]">{{ t.label }}</p>
              <p class="mt-1.5 text-zinc-900 dark:text-zinc-50 text-[15px] sm:text-base font-semibold tracking-tight truncate">{{ t.value }}</p>
{{#if t.sub}}
              <p class="mt-0.5 text-zinc-500 text-xs truncate">{{ t.sub }}</p>
{{/if}}
            </div>
{{/each}}
          </div>

          <div class="grid grid-cols-1 2xl:grid-cols-2 gap-4 sm:gap-6 items-start">
{{#each group in groups}}
            <div class="min-w-0 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
              <div class="px-5 sm:px-6 pt-5 pb-4 border-b border-line">
                <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">{{ group.title }}</h2>
              </div>
              <dl class="divide-y divide-line">
{{#each row in group.rows}}
                <div class="group/row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 px-5 sm:px-6 py-3">
                  <dt class="sm:w-40 shrink-0 text-zinc-500 text-[13px]">{{ row.label }}</dt>
                  <dd class="min-w-0 flex-1 flex items-center gap-2">
{{#if row.mono}}
                    <span class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm font-mono break-all">{{ row.value }}</span>
                    <button type="button" onclick="{{ copy(row.value, row.key) }}" title="Copy" aria-label="{{ 'Copy ' + row.label }}" class="shrink-0 w-8 h-8 -my-1 inline-flex items-center justify-center rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-white/[0.06] sm:opacity-0 sm:group-hover/row:opacity-100 focus:opacity-100 transition">
{{#if copied is row.key}}
                      <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
{{/if}}
{{#if copied is not row.key}}
                      <IconCopy class="w-4 h-4" />
{{/if}}
                    </button>
{{/if}}
{{#if not row.mono}}
                    <span class="min-w-0 flex-1 text-zinc-900 dark:text-zinc-100 text-sm break-words">{{ row.value }}</span>
{{/if}}
                  </dd>
                </div>
{{/each}}
              </dl>
            </div>
{{/each}}
          </div>
        </section>

{{#if showRepo}}
        <SiteRepository site="{{ site }}" message="{{ repoMessage }}" onChanged="{{ sourceChanged }}" />
{{/if}}

        <section id="nginx" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
            <div class="min-w-0">
              <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">nginx configuration</h2>
              <p class="text-zinc-500 text-[13px] mt-0.5">Opens in a full-size editor, tested with <span class="font-mono">nginx -t</span> before it's saved.</p>
            </div>
{{#if nginxReady}}
            <button type="button" onclick="{{ openNginx() }}" class="shrink-0 inline-flex items-center justify-center gap-1.5 h-9 text-sm font-medium text-zinc-700 dark:text-zinc-200 border border-line-strong bg-panel rounded-full px-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <IconPencilSquare class="w-4 h-4" /> Edit config
            </button>
{{/if}}
          </div>

          <div class="px-5 sm:px-6 py-4">
{{#if not nginxReady}}
            <p class="text-zinc-500 text-sm">The config can be edited once the site has finished creating.</p>
{{/if}}
{{#if nginxReady}}
            <div class="flex items-center gap-2 rounded-xl border border-line bg-sunken pl-3.5 pr-1.5 py-1.5">
              <IconFileCode class="w-4 h-4 shrink-0 text-zinc-400" />
              <span class="min-w-0 flex-1 text-zinc-700 dark:text-zinc-300 text-[13px] font-mono truncate">{{ nginxFile }}</span>
              <button type="button" onclick="{{ copy(nginxFile, 'nginx-file') }}" title="Copy path" aria-label="Copy the config path" class="shrink-0 w-8 h-8 inline-flex items-center justify-center rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-200/60 dark:hover:bg-white/[0.06] transition-colors">
{{#if copied is "nginx-file"}}
                <IconCheck class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
{{/if}}
{{#if copied is not "nginx-file"}}
                <IconCopy class="w-4 h-4" />
{{/if}}
              </button>
            </div>
            <p class="text-zinc-500 text-xs mt-3">Just need to send an old address somewhere else? Use <a href="{{ '/servers/site-redirects?id=' + siteId }}" class="text-brand-700 dark:text-brand-400 font-medium hover:underline">Redirects</a> instead of editing the config.</p>
{{/if}}
          </div>
        </section>

        <section id="plugins" class="scroll-mt-24 lg:scroll-mt-32 rounded-2xl border border-line bg-panel shadow-sm dark:shadow-none overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-5 sm:px-6 pt-5 pb-4 border-b border-line">
            <div class="min-w-0">
              <h2 class="text-zinc-900 dark:text-zinc-100 text-[15px] font-semibold">Plugins</h2>
              <p class="text-zinc-500 text-[13px] mt-0.5">Extras for this {{ typeLabel }} site. Each one installs over SSH, and you can remove it again.</p>
            </div>
{{#if Billing.locked}}
            <button type="button" disabled title="Pay to continue" class="shrink-0 inline-flex items-center justify-center gap-1.5 h-9 text-sm bg-zinc-200 dark:bg-zinc-800 text-zinc-500 rounded-full px-4 cursor-not-allowed select-none">
              <IconLockClosed class="w-4 h-4" /> Add plugin
            </button>
{{/if}}
{{#if not Billing.locked}}
            <button type="button" onclick="{{ openInstaller() }}" class="shrink-0 inline-flex items-center justify-center gap-1.5 h-9 text-sm bg-brand-500 text-white font-semibold rounded-full px-4 shadow-sm hover:bg-brand-400 transition-colors">
              <IconPlus class="w-4 h-4" /> Add plugin
            </button>
{{/if}}
          </div>

          <div class="px-5 sm:px-6 py-5">
{{#if error}}
            <p role="alert" class="text-rose-600 dark:text-rose-400 text-sm mb-4 break-words">{{ error }}</p>
{{/if}}

{{#if activeCount is 0}}
            <div class="rounded-xl border border-dashed border-line-strong px-4 py-8 text-center">
              <span class="mx-auto mb-3 w-11 h-11 rounded-2xl border border-line bg-sunken flex items-center justify-center text-zinc-500">
                <IconPuzzlePiece class="w-5 h-5" />
              </span>
              <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium mb-1">Nothing added yet</p>
{{#if choices.length is 0}}
              <p class="text-zinc-500 text-[13px]">There are no plugins for this site type.</p>
{{/if}}
{{#if choices.length is not 0}}
              <p class="text-zinc-500 text-[13px]">{{ choices.length }} available for this site. Use Add plugin to pick one.</p>
{{/if}}
            </div>
{{/if}}

{{#if activeCount is not 0}}
            <div class="space-y-3">
{{#each p in plugins}}
{{#if p.shown}}
              <div class="rounded-xl border border-line bg-sunken p-4">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4">
                  <div class="min-w-0 flex items-start gap-3">
                    <span class="{{ p.tile }}">{{ p.letter }}</span>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1">
                        <h3 class="text-zinc-900 dark:text-zinc-100 text-sm font-semibold">{{ p.name }}</h3>
                        <span class="text-[10px] font-semibold uppercase tracking-wider text-zinc-500">{{ p.group }}</span>
{{#if p.isInstalled}}
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Installed
                        </span>
{{/if}}
{{#if p.busy}}
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:text-amber-400">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Working
                        </span>
{{/if}}
{{#if p.isFailed}}
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 px-2 py-0.5 text-[11px] font-semibold text-rose-600 dark:text-rose-400">
                          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Failed
                        </span>
{{/if}}
                      </div>
                      <p class="text-zinc-500 text-[13px] break-words">{{ p.description }}</p>
{{#if p.portText}}
                      <p class="text-zinc-500 text-xs mt-1">Local port <span class="font-mono">{{ p.portText }}</span></p>
{{/if}}
                    </div>
                  </div>

                  <div class="shrink-0 flex flex-wrap items-center gap-2 sm:justify-end">
                    <button type="button" onclick="{{ toggleLog(p.id) }}" aria-expanded="{{ openLog is p.id ? 'true' : 'false' }}" class="h-8 text-xs font-medium text-zinc-600 dark:text-zinc-300 border border-line-strong bg-panel rounded-full px-3.5 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">{{ openLog is p.id ? "Hide details" : "Details" }}</button>
{{#if p.canAct}}
{{#if Billing.locked}}
                    <button type="button" disabled title="Pay to continue" class="inline-flex items-center gap-1.5 h-8 text-xs bg-zinc-200 dark:bg-zinc-800 text-zinc-500 rounded-full px-3.5 cursor-not-allowed select-none">
                      <IconLockClosed class="w-3.5 h-3.5" /> Locked
                    </button>
{{/if}}
{{#if not Billing.locked}}
{{#if p.isFailed}}
                    <button type="button" onclick="{{ retry(p.id, p.status) }}" class="h-8 text-xs bg-brand-500 text-white font-semibold rounded-full px-3.5 shadow-sm hover:bg-brand-400 transition-colors">Retry</button>
{{/if}}
                    <button type="button" onclick="{{ remove(p.id) }}" class="h-8 text-xs font-medium text-rose-600 dark:text-rose-400 border border-rose-500/30 rounded-full px-3.5 hover:bg-rose-500/[0.06] transition-colors">Remove</button>
{{/if}}
{{/if}}
                  </div>
                </div>

{{#if p.error}}
                <p role="alert" class="text-rose-600 dark:text-rose-400 text-sm mt-3 break-words">{{ p.error }}</p>
{{/if}}

{{#if openLog is p.id}}
{{#each n in p.notes}}
                <p class="text-zinc-500 text-xs mt-3 break-words">&bull; {{ n }}</p>
{{/each}}
{{#if p.log}}
                <div class="mt-4 max-h-72 sm:max-h-80 overflow-y-auto rounded-lg bg-white dark:bg-zinc-950 border border-line p-3 sm:p-4 text-xs font-mono text-zinc-700 dark:text-zinc-300 whitespace-pre-wrap break-words">{{ p.log }}</div>
{{/if}}
{{/if}}
              </div>
{{/if}}
{{/each}}
            </div>
{{/if}}
          </div>
        </section>

      </div>

{{#if installerOpen}}
      <div class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-6">
        <div onclick="{{ closeInstaller() }}" class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm"></div>

        <div role="dialog" aria-modal="true" aria-label="Add a plugin" class="relative flex flex-col w-full sm:max-w-3xl h-[92vh] sm:h-auto sm:max-h-[85vh] rounded-t-2xl sm:rounded-2xl border border-line bg-panel shadow-2xl overflow-hidden">

          <div class="flex items-start justify-between gap-3 px-4 sm:px-6 pt-4 sm:pt-5 pb-3">
            <div class="min-w-0">
              <h3 class="text-slate-900 dark:text-slate-100 font-semibold text-base sm:text-lg">Add a plugin</h3>
              <p class="text-slate-500 text-xs sm:text-sm mt-0.5">For this {{ typeLabel }} site. It installs over SSH and you can remove it again.</p>
            </div>
            <button onclick="{{ closeInstaller() }}" title="Close (Esc)" aria-label="Close" class="shrink-0 w-10 h-10 sm:w-9 sm:h-9 flex items-center justify-center rounded-full text-slate-500 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4">
                <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>

          <div class="px-4 sm:px-6 pb-3">
            <input id="installer-filter" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" value="{{ installerFilter }}" oninput="{{ applyInstallerFilter($event.target.value) }}" placeholder="Search plugins…" class="w-full rounded-xl border border-line-strong bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-base sm:text-sm px-3.5 py-3 sm:py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition-colors" />
          </div>

          <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 sm:px-6 pb-4">
{{#if installerCount is 0}}
{{#if choices.length is 0}}
            <p class="text-slate-500 text-sm py-6 text-center">Every plugin for this site type has been added.</p>
{{/if}}
{{#if choices.length is not 0}}
            <p class="text-slate-500 text-sm py-6 text-center">No plugins match your search.</p>
{{/if}}
{{/if}}

{{#each g in installerGroups}}
            <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mt-3 mb-2">{{ g.title }}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
{{#each i in g.items}}
{{#if selected is i.id}}
              <button onclick="{{ pickPlugin(i.id) }}" aria-pressed="true" class="min-h-[64px] flex items-start gap-3 text-left rounded-xl border-2 border-brand-500 bg-brand-500/5 px-3 py-2.5 transition-colors">
                <span class="{{ i.tile }}">{{ i.letter }}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-slate-100">{{ i.name }}</span>
                  <span class="block text-xs text-slate-500 line-clamp-2 break-words">{{ i.description }}</span>
{{#if i.blocked}}
                  <span class="block text-[11px] font-semibold text-amber-700 dark:text-amber-500 mt-1">Unavailable</span>
{{/if}}
                </span>
              </button>
{{/if}}
{{#if selected is not i.id}}
              <button onclick="{{ pickPlugin(i.id) }}" aria-pressed="false" class="min-h-[64px] flex items-start gap-3 text-left rounded-xl border-2 border-line px-3 py-2.5 transition-colors hover:border-brand-500/40">
                <span class="{{ i.tile }}">{{ i.letter }}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-slate-100">{{ i.name }}</span>
                  <span class="block text-xs text-slate-500 line-clamp-2 break-words">{{ i.description }}</span>
{{#if i.blocked}}
                  <span class="block text-[11px] font-semibold text-amber-700 dark:text-amber-500 mt-1">Unavailable</span>
{{/if}}
                </span>
              </button>
{{/if}}
{{/each}}
            </div>
{{/each}}
          </div>

{{#if picked}}
          <div class="shrink-0 max-h-[34vh] overflow-y-auto overscroll-contain border-t border-line bg-sunken px-4 sm:px-6 py-3">
            <p class="text-slate-900 dark:text-slate-100 text-sm font-medium">{{ picked?.name }}</p>
            <p class="text-slate-500 text-sm mt-0.5 break-words">{{ picked?.description }}</p>
{{#if picked?.blocked}}
            <p class="text-amber-700 dark:text-amber-500 text-xs mt-2 break-words">{{ picked?.blocked }}</p>
{{/if}}
{{#each n in (picked?.notes or [])}}
            <p class="text-slate-500 text-xs mt-2 break-words">&bull; {{ n }}</p>
{{/each}}
          </div>
{{/if}}

{{#if installerError}}
          <p role="alert" class="shrink-0 px-4 sm:px-6 py-2 text-rose-500 text-sm break-words border-t border-line">{{ installerError }}</p>
{{/if}}

          <div class="shrink-0 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-2 sm:gap-3 px-4 sm:px-6 py-3 border-t border-line" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
            <button onclick="{{ closeInstaller() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm text-slate-600 dark:text-slate-300 border border-line-strong rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
{{#if Billing.locked}}
            <button disabled title="Pay to continue" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 inline-flex items-center justify-center gap-1.5 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-6 py-2.5 cursor-not-allowed select-none">Install</button>
{{/if}}
{{#if not Billing.locked}}
{{#if installBusy}}
            <button disabled class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-6 py-2.5 opacity-50">Installing…</button>
{{/if}}
{{#if not installBusy}}
{{#if picked}}
{{#if picked?.blocked}}
              <button disabled class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-6 py-2.5 cursor-not-allowed select-none">Unavailable</button>
{{/if}}
{{#if not picked?.blocked}}
              <button onclick="{{ installPicked() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-6 py-2.5 shadow-sm hover:bg-brand-400 hover:shadow transition-all">Install {{ picked?.name }}</button>
{{/if}}
{{/if}}
{{#if not picked}}
              <button disabled class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-slate-200 dark:bg-slate-800 text-slate-500 border border-line-strong rounded-full px-6 py-2.5 cursor-not-allowed select-none">Choose a plugin</button>
{{/if}}
{{/if}}
{{/if}}
          </div>
        </div>
      </div>
{{/if}}

{{#if nginxReady}}
{{#if nginxOpen}}
      <div class="fixed inset-0 z-50 flex items-center justify-center p-0 sm:p-8">
        <div onclick="{{ closeNginx() }}" class="absolute inset-0 bg-slate-950/60 backdrop-blur-md"></div>

        <div class="relative flex flex-col w-full max-w-[1100px] h-full sm:max-h-[92vh] rounded-none sm:rounded-2xl border-0 sm:border border-slate-700/60 bg-slate-950/95 sm:bg-slate-950/90 backdrop-blur-xl overflow-hidden shadow-2xl">

          <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-5 py-3 sm:py-3.5 border-b border-slate-800 bg-slate-900/80">
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-800 bg-slate-950 text-brand-400">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4.5 h-4.5">
                  <path d="M6 3h6l4 4v10H6V3zM12 3v4h4M8.5 11h5M8.5 14h3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-slate-200 text-sm font-medium truncate">nginx configuration</p>
                <p class="text-slate-500 text-xs font-mono truncate">{{ nginxFile }}</p>
              </div>
              <span class="hidden sm:inline-flex shrink-0 items-center rounded-md bg-sky-400/10 text-sky-300 text-[10.5px] font-semibold uppercase tracking-[0.12em] px-2 py-0.5 shadow-[inset_0_0_0_1px_rgb(56_189_248/0.25)]">nginx</span>
{{#if nginxText is not nginxOriginal}}
              <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-medium px-2.5 py-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Unsaved changes
              </span>
{{/if}}
{{#if nginxText is nginxOriginal}}
{{#if nginxLoaded}}
              <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 text-brand-400 text-xs font-medium px-2.5 py-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> In sync with server
              </span>
{{/if}}
{{/if}}
            </div>

            <div class="flex items-center gap-2">
              <button onclick="{{ reloadNginx() }}" class="text-xs text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700 rounded-full px-3 py-2 sm:py-1.5 transition-colors">Reload<span class="hidden sm:inline"> from server</span></button>
              <button onclick="{{ closeNginx() }}" title="Close (Esc)" aria-label="Close the nginx editor" class="flex items-center gap-1.5 text-xs text-slate-300 hover:text-white border border-slate-700 hover:border-brand-500/60 rounded-full px-3 py-2 sm:py-1.5 transition-colors">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="w-3.5 h-3.5">
                  <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Close
                <span class="hidden sm:inline font-mono text-[10px] text-slate-500 border border-slate-700 rounded px-1">Esc</span>
              </button>
            </div>
          </div>

{{#if nginxError}}
          <div role="alert" class="mx-4 sm:mx-5 mt-4 rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 max-h-44 overflow-y-auto">
            <p class="text-rose-400 text-xs font-medium uppercase tracking-wider mb-1">Not saved</p>
            <p class="text-rose-400 text-xs font-mono whitespace-pre-wrap break-words">{{ nginxError }}</p>
          </div>
{{/if}}

{{#if nginxMessage}}
          <div role="status" class="mx-4 sm:mx-5 mt-4 rounded-xl border border-brand-500/30 bg-brand-500/5 px-4 py-3">
            <p class="text-brand-400 text-sm">{{ nginxMessage }}</p>
          </div>
{{/if}}

{{#if nginxLoading}}
          <div class="flex-1 flex items-center justify-center">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
              <p class="text-slate-300 text-sm">Loading the config…</p>
            </div>
          </div>
{{/if}}

{{#if nginxLoaded}}
{{#if not nginxLoading}}
          <div class="flex-1 min-h-0 flex flex-col px-3 sm:px-5 pt-4 pb-4">
            <div class="flex-1 min-h-0 flex rounded-xl border border-slate-800 bg-slate-950 overflow-hidden focus-within:border-brand-500/50 transition-colors">
              <div
                id="nginx-gutter"
                aria-hidden="true"
                class="shrink-0 w-10 sm:w-14 overflow-hidden select-none text-right pr-2 sm:pr-3 pl-1 sm:pl-2 pt-3 pb-10 bg-slate-900/60 border-r border-slate-800 text-slate-600 text-base sm:text-[13px] leading-6 font-mono whitespace-pre"
              >{{ nginxLineNums }}</div>
              <!-- The coloured copy (a div, since Tylix shows a pre element's content
                   as plain text) sits under a see-through textarea that keeps
                   the typing, Tab and Ctrl+S; both share the same metrics and
                   scroll together (onNginxScroll). -->
              <div class="relative flex-1 min-w-0 h-full">
                <div
                  id="nginx-hl"
                  aria-hidden="true"
                  class="absolute inset-0 overflow-hidden pointer-events-none text-slate-200 text-base sm:text-[13px] leading-6 font-mono font-normal pl-3 sm:pl-4 pr-4 pt-3 pb-10 whitespace-pre [tab-size:4]"
                >{{@html Syntax.html(nginxText, "nginx") }}</div>
                <textarea
                  id="nginx-editor"
                  value="{{ nginxText }}"
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="off"
                  wrap="off"
                  aria-label="nginx configuration"
                  style="color: transparent; -webkit-text-fill-color: transparent; caret-color: #f6a8a6"
                  class="absolute inset-0 w-full h-full resize-none bg-transparent text-transparent caret-brand-300 selection:bg-brand-500/30 text-base sm:text-[13px] leading-6 font-mono font-normal pl-3 sm:pl-4 pr-4 pt-3 pb-10 overflow-auto whitespace-pre [tab-size:4] focus:outline-none"
                ></textarea>
              </div>
            </div>

            <p class="text-slate-500 text-xs mt-3 leading-relaxed">Keep the <span class="font-mono text-slate-400">include</span> line in place. Plugins and redirects keep their settings in separate files that this config pulls in, and they stop working without it. Certificates added by HTTPS also live here, and recreating the site or changing its HTTPS settings can rewrite this file.</p>
          </div>
{{/if}}
{{/if}}

          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-5 py-3 border-t border-slate-800 bg-slate-900/80">
            <p class="text-slate-500 text-xs">
              <span class="font-mono text-slate-300">{{ nginxLineCount }}</span> lines
              <span class="hidden sm:inline">
                <span class="mx-1.5 text-slate-700">&bull;</span>
                Ctrl+S to test and save
                <span class="mx-1.5 text-slate-700">&bull;</span>
                Tested with <span class="font-mono text-slate-400">nginx -t</span> first, and restored if the test fails
              </span>
            </p>

            <div class="flex items-center gap-2">
{{#if nginxText is not nginxOriginal}}
              <button onclick="{{ discardNginx() }}" class="flex-1 sm:flex-none text-sm text-slate-300 border border-slate-700 rounded-full px-4 py-2.5 sm:py-2 hover:bg-slate-800 transition-colors">Discard</button>
{{/if}}
              <button onclick="{{ saveNginx() }}" class="flex-1 sm:flex-none text-sm bg-brand-500 text-white font-semibold rounded-full px-6 py-2.5 sm:py-2 shadow-sm hover:bg-brand-400 transition-all">
                {{#if nginxSaving}}Testing and saving…{{/if}}{{#if not nginxSaving}}Test and save{{/if}}
              </button>
            </div>
          </div>

        </div>
      </div>
{{/if}}
{{/if}}

{{#if codeOpen}}
      <div class="fixed inset-0 z-[70] flex items-end sm:items-center justify-center p-0 sm:p-6">
        <div onclick="{{ closeCode() }}" class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>

        <div role="dialog" aria-modal="true" aria-label="Two-factor code" class="relative w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl border border-line bg-panel p-5 sm:p-6 shadow-2xl" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom))">
          <h3 class="text-slate-900 dark:text-slate-100 font-semibold mb-1">{{ codeTitle }}</h3>
          <p class="text-slate-500 text-sm mb-4">Enter the code from your authenticator app or the SMS we sent you.</p>

          <input
            id="step-up-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            autocapitalize="none"
            spellcheck="false"
            maxlength="12"
            value="{{ codeValue }}"
            oninput="{{ codeValue = $event.target.value }}"
            placeholder="123456"
            class="w-full rounded-xl border border-line bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-200 text-base tracking-widest font-mono px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500/40"
          />

{{#if codeError}}
          <p role="alert" class="text-rose-500 text-sm mt-3 break-words">{{ codeError }}</p>
{{/if}}

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-5">
            <button onclick="{{ closeCode() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm text-slate-600 dark:text-slate-300 border border-line-strong rounded-full px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Cancel</button>
{{#if codeBusy}}
            <button disabled class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 opacity-50">Checking…</button>
{{/if}}
{{#if not codeBusy}}
            <button onclick="{{ submitCode() }}" class="w-full sm:w-auto min-h-[44px] sm:min-h-0 text-sm bg-brand-500 text-white font-semibold rounded-full px-5 py-2.5 shadow-sm hover:bg-brand-400 transition-all">Confirm</button>
{{/if}}
          </div>
        </div>
      </div>
{{/if}}
{{/if}}

    </div>
    </div>
  </div>
  