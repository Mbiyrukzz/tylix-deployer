page Login

import { IconFingerprint } from "tylix-icons"

title "Log in"

uses
  Auth

state
  goAfter: ""
  email: ""
  password: ""
  code: ""
  showPassword: false
  passwordType: "password"
  needsCode: false
  error: ""
  submitting: false
  canText: false
  smsSent: false
  phoneHint: ""
  smsNotice: ""
  codeHelp: ""
  sending: false
  needsCaptcha: false
  captchaToken: ""
  unverified: false
  resendText: ""
  providers: []
  pkSupported: false
  pkBusy: false

action
  // Where to go after signing in: ?next=/servers/... when given, otherwise
  // the app page that sent you here (an expired session on any page lands
  // on /login with that page as the referrer). Only same-site app paths.
  safePath(raw) {
    const path = String(raw or "")
    if not path.startsWith("/") or path.startsWith("//") or path.startsWith("/login") or path.startsWith("/api/") {
      return ""
    }
    const sections = ["/dashboard", "/servers", "/settings", "/team", "/providers", "/registrars", "/source-control"]
    return sections.some((p) => path is p or path.startsWith(p + "/") or path.startsWith(p + "?")) ? path : ""
  }

  nextUrl() {
    const fromQuery = this.safePath(new URLSearchParams(window.location.search).get("next"))
    if fromQuery {
      return fromQuery
    }
    try {
      const ref = new URL(document.referrer)
      if ref.origin is window.location.origin {
        const fromRef = this.safePath(ref.pathname + ref.search)
        if fromRef {
          return fromRef
        }
      }
    } catch (err) {
      // No referrer: go to the dashboard.
    }
    return "/dashboard"
  }

  setField(field, value) {
    this[field] = value
  }

  setCode(value) {
    this.code = value.trim()
  }

  setCaptchaToken(token) {
    this.captchaToken = token
  }

  togglePassword() {
    this.showPassword = not this.showPassword
    if this.showPassword {
      this.passwordType = "text"
    } else {
      this.passwordType = "password"
    }
  }

   onKey(event) {
    if event.key is "Enter" and event.target.tagName is "INPUT" {
      this.submit()
    }
  }

  requireCaptcha() {
    if not this.needsCaptcha {
      this.needsCaptcha = true
      this.captchaToken = ""
      authUi.mountCaptcha("login-captcha", (token) => this.setCaptchaToken(token), () => this.setCaptchaToken(""))
    }
  }

  afterAttempt(result) {
    const data = result?.data
    if data?.captcha_required or data?.code is "CAPTCHA_REQUIRED" or data?.code is "CAPTCHA_INVALID" {
      this.requireCaptcha()
    }
    if this.needsCaptcha {
      this.captchaToken = ""
      authUi.resetCaptcha("login-captcha")
    }
  }

  async callLogin(sendSms) {
    const code = sendSms ? "" : this.code
    return useApi("/api/login", {
      method: "POST",
      body: {
        email: this.email,
        password: this.password,
        code: code,
        send_sms: sendSms,
        captcha_token: this.captchaToken
      }
    })
  }

  loginFailed(err) {
    console.error("login failed:", err)
    return { ok: false, status: 0, data: null, error: "Something went wrong. Please try again." }
  }

  applyChallenge(data) {
    const methods = Array.isArray(data?.methods) ? data.methods : []
    const hasTotp = methods.includes("totp")
    const hasSms = methods.includes("sms")

    this.canText = hasSms
    this.phoneHint = data?.phone_hint or ""
    this.smsNotice = data?.sms_error or ""
    if data?.sms_sent {
      this.smsSent = true
    }

    if hasSms and hasTotp {
      this.codeHelp = "Enter the code from your authenticator app, or get one by text message."
    } else if hasSms {
      this.codeHelp = "Enter the 6-digit code we texted you."
    } else {
      this.codeHelp = "Open your authenticator app and enter the 6-digit code, or use one of your recovery codes."
    }

    this.needsCode = true
  }

  backToCredentials() {
    this.needsCode = false
    this.code = ""
    this.error = ""
    this.canText = false
    this.smsSent = false
    this.smsNotice = ""
  }

  async textMeCode() {
    if this.sending or this.submitting {
      return null
    }

    if this.needsCaptcha and not this.captchaToken {
      this.error = "Please complete the verification challenge first."
      return null
    }

    this.sending = true
    this.error = ""
    this.smsNotice = ""

    const result = await this.callLogin(true).catch((err) => this.loginFailed(err))
    const failCode = result?.data?.code
    this.unverified = failCode is "EMAIL_NOT_VERIFIED"

    this.afterAttempt(result)

    if failCode is "TWO_FACTOR_REQUIRED" {
      this.applyChallenge(result.data)
    } else {
      this.error = result?.error or result?.data?.error or "Couldn't send the code."
    }

    this.sending = false
  }

  async submit() {
    if this.submitting {
      return null
    }

    if this.needsCode and not this.code {
      this.error = "Enter your code."
      return null
    }

    if not this.needsCode and (not this.email or not this.password) {
      this.error = "Enter your email and password."
      return null
    }

    if this.needsCaptcha and not this.captchaToken {
      this.error = "Please complete the verification challenge."
      return null
    }

    this.submitting = true
    this.error = ""

    const result = await this.callLogin(false).catch((err) => this.loginFailed(err))

    if result and result.ok {
      window.location.replace(this.goAfter or this.nextUrl())
      return null
    }

    this.afterAttempt(result)

    const failCode = result?.data?.code

    if failCode is "TWO_FACTOR_REQUIRED" {
      this.applyChallenge(result.data)
      this.submitting = false
      return null
    }

    if result and result.status is 422 and result.data?.errors {
      const firstField = Object.keys(result.data.errors)[0]
      this.error = result.data.errors[firstField][0]
    } else {
      this.error = result?.error or result?.data?.error or "Invalid email or password."
    }

    this.submitting = false
  }

  // Sends a fresh verification link (the old one may have expired).
  async resendVerification() {
    this.resendText = "Sending…"
    const result = await useApi("/api/auth/resend-verification", { method: "POST", body: { email: this.email } })
    this.resendText = result.ok ? "Sent. Check your inbox (and spam folder)." : (result.data?.error or "Couldn't send it. Try again in a minute.")
  }

  // Passkey sign-in: the browser lists the passkeys saved for this site,
  // the person picks one and unlocks it (fingerprint, face or PIN). That is
  // two factors already, so no code is asked for.
  async passkeyLogin() {
    if this.pkBusy or this.submitting {
      return null
    }
    this.pkBusy = true
    this.error = ""
    this.unverified = false

    const opts = await useApi("/api/auth/passkey/options", { method: "POST" })
    if not opts.ok {
      this.pkBusy = false
      this.error = opts.data?.error or "Passkey sign-in isn't available right now."
      return null
    }

    const made = await passkey.get(opts.data.options)
    if not made.ok {
      this.pkBusy = false
      if not made.cancelled {
        this.error = made.error or "The passkey didn't work. Try again."
      }
      return null
    }

    const result = await useApi("/api/auth/passkey/login", {
      method: "POST",
      body: { request_id: opts.data.request_id, credential: made.credential, remember: true }
    })

    if result.ok {
      window.location.replace(this.goAfter or this.nextUrl())
      return null
    }

    this.unverified = result.data?.code is "EMAIL_NOT_VERIFIED"
    this.error = result.data?.error or "That passkey didn't work. Try again or use your password."
    this.pkBusy = false
  }

  oauthHref(id) {
    return "/api/auth/oauth/" + id + "?returnTo=/dashboard"
  }

  // Google / GitHub sign-in sends people back here with ?error=<code>.
  oauthMessage(code) {
    const messages = {
      oauth_cancelled: "Sign-in was cancelled.",
      oauth_failed: "That sign-in didn't work. Try again.",
      oauth_unavailable: "That sign-in option isn't set up yet.",
      oauth_unknown: "That sign-in option isn't available.",
      oauth_no_email: "Your account there has no email address we can use.",
      oauth_email_unverified: "Verify your email with that provider first, then try again.",
      oauth_rate_limited: "Too many sign-in attempts. Try again in a few minutes.",
      oauth_two_factor: "Your account has two-factor sign-in on. Log in with a passkey, or with your email, password and code."
    }
    const hit = Object.entries(messages).find((m) => m[0] is code)
    return hit ? hit[1] : ""
  }

onMount
  async {
    document.addEventListener("keydown", (event) => this.onKey(event))

    // Remember the destination now: the referrer is gone once the URL changes.
    this.goAfter = this.nextUrl()

    const params = new URLSearchParams(window.location.search)
    const code = params.get("error")
    if code {
      this.error = this.oauthMessage(code)
      const keep = params.get("next")
      window.history.replaceState({}, "", keep ? "/login?next=" + encodeURIComponent(keep) : "/login")
    }

    this.pkSupported = passkey.supported()

    const list = await useApi("/api/auth/providers")
    if list.ok and Array.isArray(list.data?.providers) {
      this.providers = list.data.providers.filter((p) => p.enabled)
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-page transition-colors px-3 sm:px-6 py-6 sm:py-16">
    <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] rounded-2xl border border-line bg-panel shadow-xl shadow-slate-300/40 dark:shadow-none overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between bg-slate-950 p-10 relative overflow-hidden">

        <a href="/" class="relative flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="text-white font-semibold tracking-tight">Tylix Flux</span>
        </a>

        <div class="relative">
          <p class="text-brand-400 text-xs font-semibold uppercase tracking-wider mb-3">Ship without the SSH dance</p>
          <h2 class="text-white text-3xl font-bold leading-tight tracking-tight mb-8">Push to your branch.<br />We handle the rest.</h2>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/80 overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-slate-800">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-brand-500/70"></span>
              <span class="ml-3 text-slate-500 text-xs font-mono">deploy.log</span>
            </div>
            <div class="p-4 font-mono text-xs leading-relaxed space-y-1">
              <p><span class="text-slate-500">$</span> <span class="text-slate-300">git pull origin main</span></p>
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">Pulled 14 commits</span></p>
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">npm ci &amp;&amp; npm run build</span></p>
              <p><span class="text-brand-400">✓</span> <span class="text-slate-400">Ran 2 migrations</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Reloaded process, health check passed</span></p>
              <p class="text-emerald-400">Deployed in 38s</p>
            </div>
          </div>
        </div>

        <div class="relative flex items-center gap-6 text-xs text-slate-500">
          <span>Provision servers</span>
          <span>Deploy sites</span>
          <span>Free SSL</span>
          <span>Live stats</span>
        </div>
      </div>

      <div class="flex items-center justify-center px-5 py-10 sm:px-8 sm:py-12 lg:px-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
            <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Flux</span>
          </a>

{{#if not needsCode}}
          <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-1">Welcome back</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Log in to your account</h1>
          <p class="text-slate-500 text-sm mb-8">Pick up where your last deploy left off.</p>
{{/if}}

{{#if needsCode}}
          <p class="text-brand-700 dark:text-brand-500 text-xs font-semibold uppercase tracking-wider mb-1">Two-factor</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Enter your code</h1>
          <p class="text-slate-500 text-sm mb-8">{{ codeHelp }}</p>
{{/if}}

{{#if error}}
          <div role="alert" aria-live="polite" class="flex items-start gap-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <span class="mt-0.5 text-rose-600 dark:text-rose-400 text-sm font-bold" aria-hidden="true">!</span>
            <div class="min-w-0">
              <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
{{#if unverified}}
              <button type="button" onclick="{{ resendVerification() }}" class="mt-1 text-sm font-semibold text-rose-700 dark:text-rose-300 underline underline-offset-2">Resend verification email</button>
{{#if resendText}}
              <p class="text-rose-700/80 dark:text-rose-300/80 text-xs mt-1">{{ resendText }}</p>
{{/if}}
{{/if}}
            </div>
          </div>
{{/if}}

{{#if smsSent}}
          <p class="text-brand-700 dark:text-brand-500 text-sm mb-4">We texted a code to <span class="font-mono">{{ phoneHint }}</span>. It expires in 5 minutes.</p>
{{/if}}
{{#if smsNotice}}
          <p role="alert" class="text-amber-600 dark:text-amber-500 text-sm mb-4">{{ smsNotice }}</p>
{{/if}}

{{#if not needsCode}}
          <label for="email" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
          />

          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-slate-600 dark:text-slate-400 text-xs font-medium">Password</label>
            <a href="/forgot-password" class="text-xs text-brand-700 dark:text-brand-400 hover:underline">Forgot password?</a>
          </div>
          <div class="relative mb-6">
            <input
              id="password"
              name="password"
              type="{{ passwordType }}"
              autocomplete="current-password"
              placeholder="••••••••"
              value="{{ password }}"
              oninput="{{ setField('password', event.target.value) }}"
              class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl pl-4 pr-16 py-2.5 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
            />
            <button type="button" onclick="{{ togglePassword() }}" class="absolute inset-y-0 right-0 px-4 text-xs font-medium text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
              {{#if showPassword}}Hide{{/if}}{{#if not showPassword}}Show{{/if}}
            </button>
          </div>
{{/if}}

{{#if needsCode}}
          <label for="code" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Verification code</label>
          <input
            id="code"
            name="code"
            type="text"
            inputmode="text"
            autocomplete="one-time-code"
            autofocus
            maxlength="12"
            placeholder="123456"
            value="{{ code }}"
            oninput="{{ setCode(event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-mono text-center text-lg tracking-[0.4em] rounded-xl px-4 py-3 mb-6 outline-none focus:ring-2 focus:ring-brand-500/40 focus:border-brand-500 transition"
          />
{{/if}}

{{#if needsCaptcha}}
          <p class="text-slate-500 text-xs mb-2">A few failed attempts. Please confirm you're human.</p>
          <div id="login-captcha" class="mb-6 min-h-[78px]"></div>
{{/if}}

{{#if submitting}}
          <button disabled class="w-full inline-flex items-center justify-center gap-2 bg-brand-500 text-white rounded-xl py-2.5 font-semibold opacity-70 cursor-not-allowed transition">
            <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            Logging in…
          </button>
{{/if}}
{{#if not submitting}}
          <button onclick="{{ submit() }}" class="w-full bg-brand-500 text-white rounded-xl py-2.5 font-semibold shadow-sm hover:bg-brand-400 hover:shadow transition-all">
            {{#if needsCode}}Verify and log in{{/if}}{{#if not needsCode}}Log in{{/if}}
          </button>
{{/if}}

{{#if needsCode}}
{{#if canText}}
{{#if sending}}
          <button disabled class="w-full text-sm text-slate-400 mt-3 py-2">Sending…</button>
{{/if}}
{{#if not sending}}
          <button onclick="{{ textMeCode() }}" class="w-full text-sm text-brand-700 dark:text-brand-400 hover:underline mt-3 py-2 transition-colors">
            {{#if smsSent}}Resend code{{/if}}{{#if not smsSent}}Text me a code{{/if}}
          </button>
{{/if}}
{{/if}}
          <button onclick="{{ backToCredentials() }}" class="w-full text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 mt-1 py-2 transition-colors">
            Back
          </button>
{{/if}}

{{#if not needsCode}}
{{#if pkSupported or providers.length is not 0}}
          <div class="flex items-center gap-3 my-6" aria-hidden="true">
            <span class="h-px flex-1 bg-line"></span>
            <span class="text-slate-400 text-xs uppercase tracking-wider">or</span>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <div class="grid gap-2">
{{#if pkSupported}}
            <button type="button" onclick="{{ passkeyLogin() }}" disabled="{{ pkBusy }}" class="w-full inline-flex items-center justify-center gap-2.5 h-11 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm font-semibold text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:bg-stone-50 dark:hover:bg-white/[0.03] disabled:opacity-60 transition-colors">
              <IconFingerprint class="w-4 h-4" />
              {{ pkBusy ? "Waiting for your passkey…" : "Sign in with a passkey" }}
            </button>
{{/if}}
{{#each p in providers}}
            <a href="{{ oauthHref(p.id) }}" data-no-prerender class="w-full inline-flex items-center justify-center gap-2.5 h-11 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm font-semibold text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:bg-stone-50 dark:hover:bg-white/[0.03] transition-colors">
{{#if p.id is "google"}}
              <svg viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 01-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0012 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 010-4.6V6.6H1.3a12 12 0 000 10.8l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 001.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>
{{/if}}
{{#if p.id is "github"}}
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .5z"/></svg>
{{/if}}
              Continue with {{ p.name }}
            </a>
{{/each}}
          </div>
{{/if}}
          <p class="text-sm text-slate-500 text-center mt-6">
            New to Tylix Flux? <a href="/register" class="text-brand-700 dark:text-brand-400 hover:underline">Create an account</a>
          </p>
{{/if}}
        </div>
      </div>
    </div>
  </div>