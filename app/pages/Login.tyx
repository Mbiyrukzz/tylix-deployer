page Login

title "Log in"

uses
  Auth

state
  email: ""
  password: ""
  code: ""
  needsCode: false
  error: ""
  submitting: false
  canText: false
  smsSent: false
  phoneHint: ""
  smsNotice: ""
  codeHelp: ""
  sending: false

action
  setField(field, value) {
    this[field] = value
  }

  async callLogin(sendSms) {
    const code = sendSms ? "" : this.code
    return Auth.login(this.email, this.password, code, sendSms)
  }

  loginFailed(err) {
    console.error("login failed:", err)
    return { ok: false, error: "Something went wrong. Please try again." }
  }

  applyChallenge(data) {
    const methods = Array.isArray(data?.methods) ? data.methods : []
    const hasTotp = methods.includes("totp")
    const hasSms = methods.includes("sms")

    this.canText = hasSms
    this.phoneHint = data?.phone_hint or ""
    this.smsNotice = data?.sms_error or ""
    if data?.sms_sent {
      this.smsSent = true
    }

    if hasSms and hasTotp {
      this.codeHelp = "Enter the code from your authenticator app, or get one by text message."
    } else if hasSms {
      this.codeHelp = "Enter the 6-digit code we texted you."
    } else {
      this.codeHelp = "Open your authenticator app and enter the 6-digit code, or use one of your recovery codes."
    }

    this.needsCode = true
  }

  backToCredentials() {
    this.needsCode = false
    this.code = ""
    this.error = ""
    this.canText = false
    this.smsSent = false
    this.smsNotice = ""
  }

  async textMeCode() {
    if this.sending or this.submitting {
      return null
    }

    this.sending = true
    this.error = ""
    this.smsNotice = ""

    const result = await this.callLogin(true).catch((err) => this.loginFailed(err))
    const failCode = result?.data?.code or result?.code

    if failCode is "TWO_FACTOR_REQUIRED" {
      this.applyChallenge(result.data)
    } else {
      this.error = result?.error or result?.data?.error or "Couldn't send the code."
    }

    this.sending = false
  }

  async submit() {
    if this.submitting {
      return null
    }

    if this.needsCode and not this.code {
      this.error = "Enter your code."
      return null
    }

    this.submitting = true
    this.error = ""

    const result = await this.callLogin(false).catch((err) => this.loginFailed(err))

    if result and result.ok {
      window.location.replace("/dashboard")
      return null
    }

    const failCode = result?.data?.code or result?.code

    if failCode is "TWO_FACTOR_REQUIRED" {
      this.applyChallenge(result.data)
      this.submitting = false
      return null
    }

    if result and result.status is 422 and result.data?.errors {
      const firstField = Object.keys(result.data.errors)[0]
      this.error = result.data.errors[firstField][0]
    } else {
      this.error = result?.error or result?.data?.error or "Invalid email or password."
    }

    this.submitting = false
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-slate-100 dark:bg-slate-950 transition-colors px-6 py-16">
    <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl shadow-slate-300/40 dark:shadow-none overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between bg-slate-950 p-10 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-emerald-500/5 blur-3xl"></div>

        <a href="/" class="relative flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="text-white font-semibold tracking-tight">Tylix Deploy</span>
        </a>

        <div class="relative">
          <p class="text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">Ship without the SSH dance</p>
          <h2 class="text-white text-3xl font-bold leading-tight tracking-tight mb-8">Push to your branch.<br />We handle the rest.</h2>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/80 overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-slate-800">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/70"></span>
              <span class="ml-3 text-slate-500 text-xs font-mono">deploy.log</span>
            </div>
            <div class="p-4 font-mono text-xs leading-relaxed space-y-1">
              <p><span class="text-slate-500">$</span> <span class="text-slate-300">git pull origin main</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Pulled 14 commits</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">npm ci &amp;&amp; npm run build</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Ran 2 migrations</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Reloaded process, health check passed</span></p>
              <p class="text-emerald-400">Deployed in 38s</p>
            </div>
          </div>
        </div>

        <div class="relative flex items-center gap-6 text-xs text-slate-500">
          <span>Provision servers</span>
          <span>Deploy sites</span>
          <span>Free SSL</span>
          <span>Live stats</span>
        </div>
      </div>

      <div class="flex items-center justify-center px-6 py-12 lg:px-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
            <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
          </a>

{{#if not needsCode}}
          <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Welcome back</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Log in to your account</h1>
          <p class="text-slate-500 text-sm mb-8">Pick up where your last deploy left off.</p>
{{/if}}

{{#if needsCode}}
          <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Two-factor</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Enter your code</h1>
          <p class="text-slate-500 text-sm mb-8">{{ codeHelp }}</p>
{{/if}}

{{#if error}}
          <div role="alert" aria-live="polite" class="rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>
{{/if}}

{{#if smsSent}}
          <p class="text-emerald-700 dark:text-emerald-500 text-sm mb-4">We texted a code to <span class="font-mono">{{ phoneHint }}</span>. It expires in 5 minutes.</p>
{{/if}}
{{#if smsNotice}}
          <p role="alert" class="text-amber-600 dark:text-amber-500 text-sm mb-4">{{ smsNotice }}</p>
{{/if}}

{{#if not needsCode}}
          <label for="email" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-slate-600 dark:text-slate-400 text-xs font-medium">Password</label>
            <a href="/forgot-password" class="text-xs text-emerald-700 dark:text-emerald-400 hover:underline">Forgot password?</a>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-6 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />
{{/if}}

{{#if needsCode}}
          <label for="code" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Verification code</label>
          <input
            id="code"
            name="code"
            type="text"
            inputmode="text"
            autocomplete="one-time-code"
            autofocus
            maxlength="12"
            placeholder="123456"
            value="{{ code }}"
            oninput="{{ setField('code', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-mono tracking-widest rounded-xl px-4 py-2.5 mb-6 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />
{{/if}}

{{#if submitting}}
          <button disabled class="w-full inline-flex items-center justify-center gap-2 bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold opacity-70 cursor-not-allowed transition">
            <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            Logging in…
          </button>
{{/if}}
{{#if not submitting}}
          <button onclick="{{ submit() }}" class="w-full bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
            {{#if needsCode}}Verify and log in{{/if}}{{#if not needsCode}}Log in{{/if}}
          </button>
{{/if}}

{{#if needsCode}}
{{#if canText}}
{{#if sending}}
          <button disabled class="w-full text-sm text-slate-400 mt-3 py-2">Sending…</button>
{{/if}}
{{#if not sending}}
          <button onclick="{{ textMeCode() }}" class="w-full text-sm text-emerald-700 dark:text-emerald-400 hover:underline mt-3 py-2 transition-colors">
            {{#if smsSent}}Resend code{{/if}}{{#if not smsSent}}Text me a code{{/if}}
          </button>
{{/if}}
{{/if}}
          <button onclick="{{ backToCredentials() }}" class="w-full text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 mt-1 py-2 transition-colors">
            Back
          </button>
{{/if}}

{{#if not needsCode}}
          <p class="text-sm text-slate-500 text-center mt-6">
            New to Tylix Deploy? <a href="/register" class="text-emerald-700 dark:text-emerald-400 hover:underline">Create an account</a>
          </p>
{{/if}}
        </div>
      </div>
    </div>
  </div>