page Login

title "Log in"

uses
  Auth

state
  email: ""
  password: ""
  error: ""
  submitting: false

action
  setField(field, value) {
    this[field] = value
  }

  async submit() {
    if not this.submitting {
      this.submitting = true
      this.error = ""

      const result = await Auth.login(this.email, this.password)

      if result.ok {
        window.location.href = "/dashboard"
      } else if result.status is 422 and result.data.errors {
        const firstField = Object.keys(result.data.errors)[0]
        this.error = result.data.errors[firstField][0]
        this.submitting = false
      } else {
        this.error = result.error or "Invalid email or password."
        this.submitting = false
      }
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-slate-100 dark:bg-slate-950 transition-colors px-6 py-16">
    <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl shadow-slate-300/40 dark:shadow-none overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between bg-slate-950 p-10 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-emerald-500/5 blur-3xl"></div>

        <a href="/" class="relative flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="text-white font-semibold tracking-tight">Tylix Deploy</span>
        </a>

        <div class="relative">
          <p class="text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">Ship without the SSH dance</p>
          <h2 class="text-white text-3xl font-bold leading-tight tracking-tight mb-8">Push to your branch.<br />We handle the rest.</h2>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/80 overflow-hidden">
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-slate-800">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/70"></span>
              <span class="ml-3 text-slate-500 text-xs font-mono">deploy.log</span>
            </div>
            <div class="p-4 font-mono text-xs leading-relaxed space-y-1">
              <p><span class="text-slate-500">$</span> <span class="text-slate-300">git pull origin main</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Pulled 14 commits</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">npm ci &amp;&amp; npm run build</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Ran 2 migrations</span></p>
              <p><span class="text-emerald-400">✓</span> <span class="text-slate-400">Reloaded process, health check passed</span></p>
              <p class="text-emerald-400">Deployed in 38s</p>
            </div>
          </div>
        </div>

        <div class="relative flex items-center gap-6 text-xs text-slate-500">
          <span>Provision servers</span>
          <span>Deploy sites</span>
          <span>Free SSL</span>
          <span>Live stats</span>
        </div>
      </div>

      <div class="flex items-center justify-center px-6 py-12 lg:px-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
            <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
          </a>

          <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Welcome back</p>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Log in to your account</h1>
          <p class="text-slate-500 text-sm mb-8">Pick up where your last deploy left off.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="email" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-slate-600 dark:text-slate-400 text-xs font-medium">Password</label>
            <a href="/forgot-password" class="text-xs text-emerald-700 dark:text-emerald-400 hover:underline">Forgot password?</a>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-6 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

{{#if submitting}}
          <button disabled class="w-full bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold opacity-50 transition">
            Logging in…
          </button>
{{/if}}
{{#if not submitting}}
          <button onclick="{{ submit() }}" class="w-full bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
            Log in
          </button>
{{/if}}

          <p class="text-sm text-slate-500 text-center mt-6">
            New to Tylix Deploy? <a href="/register" class="text-emerald-700 dark:text-emerald-400 hover:underline">Create an account</a>
          </p>
        </div>
      </div>
    </div>
  </div>