page Changelog

title "Changelog"

state
  loading: true
  error: ""
  stale: false
  entries: []

action
  whenText(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
  }

onMount
  async {
    const res = await useApi("/api/releases")
    if res.ok {
      this.stale = res.data.stale
      this.entries = res.data.entries.map((e) => Object.assign({}, e, { whenLabel: this.whenText(e.published_at) }))
    } else {
      this.error = res.data?.error ?? "Could not load the changelog."
    }
    this.loading = false
  }

template
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <p class="text-zinc-500 text-[11px] font-semibold uppercase tracking-[0.2em] mb-3">Tylix Deploy</p>
    <h1 class="text-3xl font-light uppercase tracking-wide text-zinc-900 dark:text-zinc-100 mb-2">Changelog</h1>
    <p class="text-sm text-zinc-500 mb-10">New features, improvements and fixes.</p>

{{#if loading}}
    <p class="text-sm text-zinc-500">Loading…</p>
{{/if}}

{{#if error}}
    <p role="alert" class="text-sm text-rose-600 dark:text-rose-400">{{ error }}</p>
{{/if}}

{{#if stale}}
    <p class="text-xs text-amber-600 mb-6">Showing the last saved copy.</p>
{{/if}}

{{#if not loading}}
{{#if entries.length is 0}}
{{#if not error}}
    <p class="text-sm text-zinc-500">No releases published yet.</p>
{{/if}}
{{/if}}
{{/if}}

{{#each e in entries}}
    <article class="mb-10 border-l border-line pl-6">
      <div class="flex flex-wrap items-center gap-2 mb-1.5">
        <span class="font-mono text-xs text-zinc-500">v{{ e.version }}</span>
        <span class="rounded-md bg-brand-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-500">{{ e.category }}</span>
        <span class="text-xs text-zinc-400">{{ e.whenLabel }}</span>
      </div>
      <h2 class="font-medium text-zinc-900 dark:text-zinc-100 mb-2">{{ e.title }}</h2>
      <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 whitespace-pre-line">{{ e.body }}</p>
    </article>
{{/each}}
  </main>