page ResetPassword

title "Reset password"

state
  ready: false
  invalidLink: false
  showForm: false
  done: false
  token: ""
  email: ""
  password: ""
  confirmPassword: ""
  showPassword: false
  passwordType: "password"
  pwLength: false
  pwLetter: false
  pwNumber: false
  pwSymbol: false
  pwLabel: ""
  pwPct: 0
  pwColor: "#f43f5e"
  pwTouched: false
  matchYes: false
  matchNo: false
  error: ""
  linkExpired: false
  submitting: false
  submitLabel: "Reset password"
  submitDim: ""

action
  getParam(name) {
    const query = window.location.search
    if not query {
      return ""
    }
    const pairs = query.slice(1).split("&")
    const hit = pairs.find((p) => p.split("=")[0] is name)
    if not hit {
      return ""
    }
    return decodeURIComponent(hit.slice(name.length + 1).split("+").join(" "))
  }

  togglePassword() {
    this.showPassword = not this.showPassword
    if this.showPassword {
      this.passwordType = "text"
    } else {
      this.passwordType = "password"
    }
  }

  updateMatch() {
    if not this.confirmPassword {
      this.matchYes = false
      this.matchNo = false
    } else if this.password is this.confirmPassword {
      this.matchYes = true
      this.matchNo = false
    } else {
      this.matchYes = false
      this.matchNo = true
    }
  }

  updatePassword(value) {
    this.password = value
    this.pwTouched = true
    const c = authUi.passwordChecks(value)
    this.pwLength = c.length
    this.pwLetter = c.letter
    this.pwNumber = c.number
    this.pwSymbol = c.symbol
    this.pwLabel = c.label
    this.pwPct = c.pct
    this.pwColor = c.color
    this.updateMatch()
  }

  updateConfirm(value) {
    this.confirmPassword = value
    this.updateMatch()
  }

  onKey(event) {
    if event.key is "Enter" and event.target.tagName is "INPUT" {
      this.submit()
    }
  }

  async submit() {
    if not this.submitting {
      const c = authUi.passwordChecks(this.password)
      if not c.ok {
        this.pwTouched = true
        this.error = "Password must be 10 or more characters with a letter, a number and a symbol."
        return null
      }

      if this.password is not this.confirmPassword {
        this.error = "Passwords don't match."
        return null
      }

      this.submitting = true
      this.submitLabel = "Updating…"
      this.submitDim = "opacity-50 pointer-events-none"
      this.error = ""
      this.linkExpired = false

      const result = await useApi("/api/auth/reset-password", {
        method: "POST",
        body: {
          email: this.email,
          token: this.token,
          password: this.password
        }
      })

      this.submitting = false
      this.submitLabel = "Reset password"
      this.submitDim = ""

      if result.ok {
        this.showForm = false
        this.done = true
      } else if result.status is 400 {
        this.error = result.data?.error or "Invalid or expired reset link."
        this.linkExpired = true
      } else if result.status is 422 and result.data.errors {
        const firstField = Object.keys(result.data.errors)[0]
        this.error = result.data.errors[firstField][0]
      } else {
        this.error = result.data?.error or result.error or "Could not reset your password. Try again."
      }
    }
  }

onMount
  async {
    document.addEventListener("keydown", (event) => this.onKey(event))
    this.token = this.getParam("token")
    this.email = this.getParam("email")
    if not this.token or not this.email {
      this.invalidLink = true
    } else {
      this.showForm = true
    }
    this.ready = true
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-slate-100 dark:bg-slate-950 transition-colors px-6 py-16">
    <div class="w-full max-w-md rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl shadow-slate-300/40 dark:shadow-none px-8 py-10">

      <a href="/" class="flex items-center gap-2.5 justify-center mb-8">
        <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
        <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix Deploy</span>
      </a>

{{#if not ready}}
      <p class="text-slate-500 text-sm text-center">Loading…</p>
{{/if}}

{{#if invalidLink}}
      <div class="w-11 h-11 rounded-xl bg-amber-500/10 flex items-center justify-center text-lg mb-5 text-amber-600 dark:text-amber-400">!</div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">This link isn't valid</h1>
      <p class="text-slate-500 text-sm mb-8">The reset link is incomplete. Request a new one and use the link from the latest email.</p>
      <a href="/forgot-password" class="inline-block w-full text-center bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
        Request a new link
      </a>
{{/if}}

{{#if done}}
      <div class="w-11 h-11 rounded-xl bg-emerald-500/10 flex items-center justify-center text-lg mb-5 text-emerald-700 dark:text-emerald-400">✓</div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Password updated</h1>
      <p class="text-slate-500 text-sm mb-8">You've been signed out everywhere. Log in with your new password.</p>
      <a href="/login" class="inline-block w-full text-center bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
        Go to login
      </a>
{{/if}}

{{#if showForm}}
      <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Account recovery</p>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Choose a new password</h1>
      <p class="text-slate-500 text-sm mb-8">For <span class="text-slate-800 dark:text-slate-300 font-medium">{{ email }}</span></p>

{{#if error}}
      <div role="alert" aria-live="polite" class="flex items-start gap-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
        <span class="mt-0.5 text-rose-600 dark:text-rose-400 text-sm font-bold" aria-hidden="true">!</span>
        <div>
          <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
{{#if linkExpired}}
          <a href="/forgot-password" class="text-rose-700 dark:text-rose-400 text-sm font-medium underline">Request a new link</a>
{{/if}}
        </div>
      </div>
{{/if}}

      <label for="password" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">New password</label>
      <div class="relative mb-3">
        <input
          id="password"
          name="password"
          type="{{ passwordType }}"
          autocomplete="new-password"
          autofocus
          placeholder="At least 10 characters"
          value="{{ password }}"
          oninput="{{ updatePassword(event.target.value) }}"
          class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl pl-4 pr-16 py-2.5 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
        />
        <button type="button" onclick="{{ togglePassword() }}" class="absolute inset-y-0 right-0 px-4 text-xs font-medium text-slate-500 hover:text-slate-900 dark:hover:text-slate-200 transition-colors">
          {{#if showPassword}}Hide{{/if}}{{#if not showPassword}}Show{{/if}}
        </button>
      </div>

{{#if pwTouched}}
      <div class="mb-3">
        <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
          <div class="h-full rounded-full transition-all duration-300" style="width: {{ pwPct }}%; background: {{ pwColor }}"></div>
        </div>
        <p class="text-xs text-slate-500 mt-1.5">{{ pwLabel }}</p>
      </div>

      <ul class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs mb-4">
        <li class="flex items-center gap-1.5">
{{#if pwLength}}<span class="text-emerald-600 dark:text-emerald-400">✓</span><span class="text-slate-600 dark:text-slate-300">10+ characters</span>{{/if}}
{{#if not pwLength}}<span class="text-slate-400">○</span><span class="text-slate-500">10+ characters</span>{{/if}}
        </li>
        <li class="flex items-center gap-1.5">
{{#if pwLetter}}<span class="text-emerald-600 dark:text-emerald-400">✓</span><span class="text-slate-600 dark:text-slate-300">A letter</span>{{/if}}
{{#if not pwLetter}}<span class="text-slate-400">○</span><span class="text-slate-500">A letter</span>{{/if}}
        </li>
        <li class="flex items-center gap-1.5">
{{#if pwNumber}}<span class="text-emerald-600 dark:text-emerald-400">✓</span><span class="text-slate-600 dark:text-slate-300">A number</span>{{/if}}
{{#if not pwNumber}}<span class="text-slate-400">○</span><span class="text-slate-500">A number</span>{{/if}}
        </li>
        <li class="flex items-center gap-1.5">
{{#if pwSymbol}}<span class="text-emerald-600 dark:text-emerald-400">✓</span><span class="text-slate-600 dark:text-slate-300">A symbol</span>{{/if}}
{{#if not pwSymbol}}<span class="text-slate-400">○</span><span class="text-slate-500">A symbol</span>{{/if}}
        </li>
      </ul>
{{/if}}
{{#if not pwTouched}}
      <p class="text-slate-400 dark:text-slate-600 text-xs mb-4">At least 10 characters, with a letter, a number and a symbol.</p>
{{/if}}

      <label for="confirmPassword" class="block text-slate-600 dark:text-slate-400 text-xs font-medium mb-2">Confirm new password</label>
      <input
        id="confirmPassword"
        name="confirmPassword"
        type="{{ passwordType }}"
        autocomplete="new-password"
        placeholder="Repeat your new password"
        value="{{ confirmPassword }}"
        oninput="{{ updateConfirm(event.target.value) }}"
        class="w-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 rounded-xl px-4 py-2.5 mb-1.5 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
      />
{{#if matchYes}}
      <p class="text-emerald-600 dark:text-emerald-400 text-xs mb-5">Passwords match.</p>
{{/if}}
{{#if matchNo}}
      <p class="text-rose-600 dark:text-rose-400 text-xs mb-5">Passwords don't match yet.</p>
{{/if}}
{{#if not matchYes}}
{{#if not matchNo}}
      <div class="mb-5"></div>
{{/if}}
{{/if}}

      <button onclick="{{ submit() }}" class="w-full bg-emerald-500 text-white dark:text-slate-950 rounded-xl py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all {{ submitDim }}">
        {{ submitLabel }}
      </button>

      <p class="text-sm text-slate-500 text-center mt-6">
        <a href="/login" class="text-emerald-700 dark:text-emerald-400 hover:underline">Back to login</a>
      </p>
{{/if}}

    </div>
  </div>