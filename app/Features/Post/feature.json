{
  "name": "Post",
  "version": "1.0.0",
  "table": "posts",
  "model": "Post",
  "controller": "PostController",
  "validator": "PostValidator",
  "language": "typescript",
  "fields": [
    {
      "name": "title",
      "type": "string"
    },
    {
      "name": "body",
      "type": "text"
    },
    {
      "name": "user_id",
      "type": "integer"
    }
  ],
  "relations": [
    {
      "type": "belongsTo",
      "model": "User",
      "foreignKey": "user_id"
    }
  ],
  "auth": true,
  "permissions": [
    "post.view",
    "post.create",
    "post.update",
    "post.delete"
  ]
}