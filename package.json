{
  "name": "tylix-deploy",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tylix dev",
    "build": "tylix build",
    "start": "tylix start",
    "migrate": "tylix migrate",
    "css:build": "tailwindcss -i ./app/tailwind-input.css -o ./public/tailwind.css",
    "css:watch": "tailwindcss -i ./app/tailwind-input.css -o ./public/tailwind.css --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1152.0",
    "@tylix/auth": "^0.4.0",
    "@tylix/cli": "^0.4.4",
    "@tylix/compiler": "^0.4.2",
    "@tylix/core": "^0.4.2",
    "@tylix/generator": "^0.4.0",
    "@tylix/mail": "^0.4.0",
    "@tylix/orm": "^0.4.1",
    "@tylix/shared": "^0.4.3",
    "tylix-icons": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
